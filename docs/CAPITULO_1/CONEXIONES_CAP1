# ============================================================
# INTERCONEXIONES PARA EL ESQUELETO DEL CAPITULO 1
# ============================================================
# Única función: encadenar el Capítulo 1 tal como está en
# docs/CAP1.md §2. NO contiene diálogo propio — solo call/jump a
# los labels que viven en el resto de los .rpy de este capítulo.
#
# Esqueleto:
# APERTURA → HUB 1 → evento → BEAT Itsuki → HUB 2 → evento
# → BEAT crisis de Nino → HUB 3 → evento → BEAT casa → EVENTO 6
#
# Antes de llegar a un hub o a un beat las interconexiones nos
# servirán para transicionar suavemente y con lógica estos
# main events, serán dialgos cortos y rápidos.

# ================================================================
# INTERCONEXIONES ENTRE FINAL DE LA APERTURA Y EL INICIO DEL HUB 1
# ================================================================

label interconexion 1:

  [BG bg_escuela] [SFX sfx_timbre] [MUS cotidiano fadein 2.5]
    
  narrador "Llegué al instituto temprano como siempre."
  mc_pensamiento "Ahora con un único objetivo en mente."
  mc_pensamiento "Ir de una en una. Para hacerlas estudiar."
  mc_pensamiento "Se que no será fácil, pero puedo logralo."
  
  [BG bg_aula_mañana]

  narrador "Terminado las clases intenté reunir a las 5 a la vez"
  mc_pensamiento "No para obligarlas a estudiar todas juntas esta noche."
  mc_pensamiento "Se que eso no va a funcionar."
  mc_pensamiento "Pero si tenía planeado comprobar que si esos lugares que mencionó Raiha, "
  mc_pensamiento " en verdad estaban relacionados a los que ellas saben frecuentar."
  mc_pensamiento "Así podría atacarlas de una en una, porque cada una solo es una quinta parte de lo que son."

  [SPR ichika neutral at pj(0.10)]
  [SPR nino neutral at pj(0.30)]
  [SPR miku neutral at pj(0.50)]
  [SPR yotsuba sorprendida at pj(0.70)]
  [SPR itsuki neutral at pj(0.90)]

  [MUS incomodo fadein 1.5 volume 1.0]

  mc "Buenos dias." 
  mc "Veo que siguen igual de desorganizadas que siempre." 
  mc "Tenemos mucho que repasar hoy."
  mc_pensamiento "Las saludé de la mejor manera posible"
  mc_pensamiento "Eso creo..."

  [SPR nino neutral at pj_habla(0.10)]

  nino "¿Otra vez tu con tus tontas creencias de que vamos a estudiar?"
  nino "Ni creas que hoy va a ser diferente."
  nino "Hoy tercer dia y tercer fracaso que vas a conseguir."

  mc_pensamiento "Nino, la misma de siempre, siempre es la que habla por las demas."
  mc_pensamiento "Las otras cuatro solo estaban calladas escuchandola."

  mc "No te voy a dar la razón, pero si es verdad que es dificil hacerlas estudiar..."
  mc "A las cinco, a la vez."

  nino "¿Y entonces?"

  mc "Tengo otro método, uno mas efectívo contra ustedes."

  yotsuba "¿Un método efectivo? ¡Guau!"
  yotsuba "¿Y qué es?"
  yotsuba "¡Quiero saberlo! ¡Quiero saberlo!"

  ichika "Vaya, con que despues de todo si eres un cerebrito fuera y dentro de clases."

  itsuki "Seguramente será explotarnos estudiando todos los dias y todas las noches."

  miku "..."

  nino "No se preocupen chicas, de seguro su gran método es renunciar y largarse de nuestras vidas."
  nino "Si, ya lo sabía, pero aunque no lo creas..."
  nino "Esta vez si te apoyaré"

  mc_pensamiento "Todas se quedaron atónitas por lo que dije."
  mc_pensamiento "Sin embargo no saben realmente de lo que estoy hablando."

  mc "Para poner en marcha este método, solo les haré una simple pregunta."

  quintillizas "¿Qué?"

  mc "¿En donde pasan despues de clases?"
  mc "Se que no pasan juntas siempre."
  mc "Aunque sean iguales, sus rutinas y pasatiempos son diferentes."

  mc_pensamiento "Me miraron con una cara de sorpresa mas risa"

  ichika "Hay mc"
  ichika "¿Porque quieres saber en donde pasamos?"
  ichika "¿Acaso planeas una cita con cada una?"
  ichika "No sabia ese lado de ti"

  mc "No es eso"
  mc "Pero..."

  nino "Y a ti que diablos te importa donde pasemos"
  nino "Ninguna de nosotras te lo va a decir"

  mc "Ya lo suponia."

  itsuki "Esperen."
  itsuki "Tengo una idea."

  mc "¿Eh?"

  itsuki "Hagamos un juego al estilo quintillizas."

  yotsuba "¿Estilo quintillizas? Hurra"
  yotsuba "¡Yo quiero jugar, quiero participar!"

  miku "¿Qué tienes planeado Itsuki?"

  itsuki "Bueno si mc es tan buen tutor y se preocupa por nosotras."
  itsuki "Y dice que nos conoce mejor que nadie."
  itsuki "Entonces que trate de adivinar donde pasamos"
  itsuki "Un juego de busca y encuentra"
  itsuki "Estilo quintillizas"

  mc "¿QUEEEE?"

  mc "Esto debe ser una broma."
  mc "Pero en parte es mi culpa."
  

  

  
    

  
  
  
  
label hub_1:
    call screen mapa_hub(1)
    $ destino = _return
    call expression (LABEL_EVENTO.get(destino, "evento_" + destino))
    $ hub_visitadas.append(destino)

    call beat_Itsuki
    jump hub_2

# ------------------------------------------------------------
label hub_2:
    call screen mapa_hub(2)
    $ destino = _return
    call expression (LABEL_EVENTO.get(destino, "evento_" + destino))
    $ hub_visitadas.append(destino)
    if desaires_cap1 >= 3:
        jump final_malo_temprano

    call beat_Nino
    jump hub_3

# ------------------------------------------------------------
label hub_3:
    call screen mapa_hub(3)
    $ destino = _return
    call expression (LABEL_EVENTO.get(destino, "evento_" + destino))
    $ hub_visitadas.append(destino)
    
    call beat_casa

    if desaires_cap1 >= 3:
        jump final_malo_temprano

    call evento_6
    jump capitulo2   
