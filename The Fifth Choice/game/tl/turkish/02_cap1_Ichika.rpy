translate turkish ichika_m5_b6cd774e:

    # ichika "Luego contesto. Ahora te acompaño a la salida, que van a cerrar el edificio."
    # english: ichika "I'll answer later. Right now I'm walking you out, they're about to lock up."
    ichika "Luego contesto. Ahora te acompaño a la salida, que van a cerrar el edificio."

# game/02_cap1_Ichika.rpy:560
translate turkish ichika_m5_2c52f71b:

    # mc_pensamiento "No contestó el mensaje. Ni siquiera lo volvió a mirar."
    # english: mc_pensamiento "She didn't answer the message. She didn't even look at it again."
    mc_pensamiento "No contestó el mensaje. Ni siquiera lo volvió a mirar."

# game/02_cap1_Ichika.rpy:562
translate turkish ichika_m5_fdae3d29:

    # mc_pensamiento "Solo lo guardó, como guarda todo lo demás."
    # english: mc_pensamiento "She just put it away, the way she puts away everything else."
    mc_pensamiento "Solo lo guardó, como guarda todo lo demás."

# game/02_cap1_Ichika.rpy:582
translate turkish ichika_m6_84f8fd7e:

    # narrador "Salimos cuando el conserje empezaba a apagar las luces del pasillo."
    # english: narrador "We left as the janitor started turning off the hallway lights."
    narrador "Salimos cuando el conserje empezaba a apagar las luces del pasillo."

# game/02_cap1_Ichika.rpy:584
translate turkish ichika_m6_ba763b7b:

    # mc_pensamiento "Una de cinco."
    # english: mc_pensamiento "One out of five."
    mc_pensamiento "Una de cinco."

# game/02_cap1_Ichika.rpy:586
translate turkish ichika_m6_193001f8:

    # mc_pensamiento "Y esta se durmió antes de que yo dijera nada."
    # english: mc_pensamiento "And this one fell asleep before I'd said anything."
    mc_pensamiento "Y esta se durmió antes de que yo dijera nada."

# game/02_cap1_Ichika.rpy:588
translate turkish ichika_m6_47430c21:

    # mc_pensamiento "Quedan [tiempo_restante!t]."
    # english: mc_pensamiento "[tiempo_restante!tc] left."
    mc_pensamiento "Quedan [tiempo_restante!t]."

# game/02_cap1_Ichika.rpy:593
translate turkish ichika_m6_2d141dd0:

    # mc_pensamiento "Dijo que no sabía cuánto más podía seguir así."
    # english: mc_pensamiento "She said she didn't know how much longer she could go on like this."
    mc_pensamiento "Dijo que no sabía cuánto más podía seguir así."

# game/02_cap1_Ichika.rpy:595
translate turkish ichika_m6_a4b1520e:

    # mc_pensamiento "No sé si me lo dijo a mí o si se le escapó."
    # english: mc_pensamiento "I don't know if she said it to me or if it just slipped out."
    mc_pensamiento "No sé si me lo dijo a mí o si se le escapó."

# game/02_cap1_Ichika.rpy:597
translate turkish ichika_m6_ab1257b8:

    # mc_pensamiento "Tampoco sé si hay diferencia."
    # english: mc_pensamiento "I don't know if there's a difference, either."
    mc_pensamiento "Tampoco sé si hay diferencia."

# game/02_cap1_Ichika.rpy:599
translate turkish ichika_m6_2d1f7225:

    # mc_pensamiento "Y aun así, en cuanto llegó el mensaje del papel nuevo, dijo que sí sin pensarlo dos veces."
    # english: mc_pensamiento "And even so, the moment the message about the new part came, she said yes without thinking twice."
    mc_pensamiento "Y aun así, en cuanto llegó el mensaje del papel nuevo, dijo que sí sin pensarlo dos veces."

# game/02_cap1_Ichika.rpy:601
translate turkish ichika_m6_39061e30:

    # mc_pensamiento "Admitirlo no le cambió nada. Mañana va a seguir igual."
    # english: mc_pensamiento "Admitting it didn't change a thing. Tomorrow she'll do the same."
    mc_pensamiento "Admitirlo no le cambió nada. Mañana va a seguir igual."

# game/02_cap1_Ichika.rpy:605
translate turkish ichika_m6_6580d73a:

    # mc_pensamiento "Hablamos de dragones durante diez minutos."
    # english: mc_pensamiento "We talked about dragons for ten minutes."
    mc_pensamiento "Hablamos de dragones durante diez minutos."

# game/02_cap1_Ichika.rpy:607
translate turkish ichika_m6_c537de5a:

    # mc_pensamiento "Fue divertido."
    # english: mc_pensamiento "It was fun."
    mc_pensamiento "Fue divertido."

# game/02_cap1_Ichika.rpy:609
translate turkish ichika_m6_58125b36:

    # mc_pensamiento "No estoy seguro de que haya sido nada más que eso."
    # english: mc_pensamiento "I'm not sure it was anything more than that."
    mc_pensamiento "No estoy seguro de que haya sido nada más que eso."

# game/02_cap1_Ichika.rpy:611
translate turkish ichika_m6_91814221:

    # mc_pensamiento "No hubo ningún cambio en ella."
    # english: mc_pensamiento "Nothing changed in her."
    mc_pensamiento "No hubo ningún cambio en ella."

# game/02_cap1_Ichika.rpy:613
translate turkish ichika_m6_58a2a0f3:

    # mc_pensamiento "No la ayudé en nada."
    # english: mc_pensamiento "I didn't help her at all."
    mc_pensamiento "No la ayudé en nada."

# game/02_cap1_Ichika.rpy:615
translate turkish ichika_m6_92cac049:

    # mc_pensamiento "Y cuando le ofrecieron el papel que quería, aceptó antes de que yo dijera nada."
    # english: mc_pensamiento "And when they offered her the part she wanted, she accepted before I'd said a word."
    mc_pensamiento "Y cuando le ofrecieron el papel que quería, aceptó antes de que yo dijera nada."

# game/02_cap1_Ichika.rpy:617
translate turkish ichika_m6_7385fe81:

    # mc_pensamiento "Ni una palabra sobre todo lo que ya tiene encima."
    # english: mc_pensamiento "Not a word about everything she already has on her plate."
    mc_pensamiento "Ni una palabra sobre todo lo que ya tiene encima."

# game/02_cap1_Ichika.rpy:621
translate turkish ichika_m6_eac03fa8:

    # mc_pensamiento "Tenía razón en lo que dije."
    # english: mc_pensamiento "I was right about what I said."
    mc_pensamiento "Tenía razón en lo que dije."

# game/02_cap1_Ichika.rpy:623
translate turkish ichika_m6_48c3d7fa:

    # mc_pensamiento "Pero no me hace sentir mejor."
    # english: mc_pensamiento "But it doesn't make me feel any better."
    mc_pensamiento "Pero no me hace sentir mejor."

# game/02_cap1_Ichika.rpy:625
translate turkish ichika_m6_c269bef2:

    # mc_pensamiento "Sostuvo la puerta el tiempo justo. Ni un segundo más."
    # english: mc_pensamiento "She held the door just long enough. Not a second more."
    mc_pensamiento "Sostuvo la puerta el tiempo justo. Ni un segundo más."

# game/02_cap1_Ichika.rpy:627
translate turkish ichika_m6_ae577c3e:

    # mc_pensamiento "Y aun con todo lo que le dije, aceptó un papel más antes de que llegáramos a la salida."
    # english: mc_pensamiento "And after everything I said to her, she took one more part before we even reached the exit."
    mc_pensamiento "Y aun con todo lo que le dije, aceptó un papel más antes de que llegáramos a la salida."

# game/02_cap1_Ichika.rpy:629
translate turkish ichika_m6_a024a020:

    # mc_pensamiento "Hoy solo le enseñé a disimular mejor."
    # english: mc_pensamiento "All I taught her today was to hide it better."
    mc_pensamiento "Hoy solo le enseñé a disimular mejor."

translate turkish strings:

    # game/02_cap1_Ichika.rpy:274
    old "¿Qué le dirás a Ichika?"
    # english: "What will you say to Ichika?"
    new "¿Qué le dirás a Ichika?"

    # game/02_cap1_Ichika.rpy:274
    old "Se durmió en el suelo del club, y ya está bromeando otra vez."
    # english: "She fell asleep on the club floor, and she's already joking again."
    new "Se durmió en el suelo del club, y ya está bromeando otra vez."

    # game/02_cap1_Ichika.rpy:280
    old "No seguirle la broma. Esperar a que hable ella."
    # english: "Don't play along. Wait for her to speak."
    new "No seguirle la broma. Esperar a que hable ella."

    # game/02_cap1_Ichika.rpy:283
    old "Seguirle la broma. Por hoy ya tuvo bastante."
    # english: "Play along. She's had enough for today."
    new "Seguirle la broma. Por hoy ya tuvo bastante."

    # game/02_cap1_Ichika.rpy:286
    old "Si tienes energía para hacer chistes, tienes energía\npara estudiar."
    # english: "If you have the energy to make jokes,\nyou have the energy to study."
    new "Si tienes energía para hacer chistes, tienes energía\npara estudiar."

