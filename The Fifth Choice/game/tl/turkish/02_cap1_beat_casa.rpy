    # mc_pensamiento "Treinta días después, la letra sigue siendo la misma."
    # english: mc_pensamiento "Thirty days later, the handwriting is still the same."
    mc_pensamiento "Treinta días después, la letra sigue siendo la misma."

# game/02_cap1_beat_casa.rpy:274
translate turkish beat_casa_682607f3:

    # mc_pensamiento "Solo que ahora sé quién es cada una."
    # english: mc_pensamiento "Only now I know who each of them is."
    mc_pensamiento "Solo que ahora sé quién es cada una."

# game/02_cap1_beat_casa.rpy:276
translate turkish beat_casa_ab99ffd4:

    # narrador "Dejé la vista quieta un momento antes de cerrarla."
    # english: narrador "I held my gaze there a moment before closing it."
    narrador "Dejé la vista quieta un momento antes de cerrarla."

# game/02_cap1_beat_casa.rpy:280
translate turkish beat_casa_1ee2fd11:

    # mc_pensamiento "No sé si mañana esto sigue siendo mi trabajo."
    # english: mc_pensamiento "I don't know if tomorrow this is still my job."
    mc_pensamiento "No sé si mañana esto sigue siendo mi trabajo."

# game/02_cap1_beat_casa.rpy:282
translate turkish beat_casa_196182ef:

    # mc_pensamiento "Ninguna aprobó todavía."
    # english: mc_pensamiento "None of them has passed yet."
    mc_pensamiento "Ninguna aprobó todavía."

# game/02_cap1_beat_casa.rpy:284
translate turkish beat_casa_f81e4341:

    # mc_pensamiento "Y las cinco llegan a este último tramo por caminos que yo elegí."
    # english: mc_pensamiento "And all five reach this last stretch by paths I chose."
    mc_pensamiento "Y las cinco llegan a este último tramo por caminos que yo elegí."

# game/02_cap1_beat_casa.rpy:286
translate turkish beat_casa_e75a638a:

    # mc_pensamiento "Uno a uno, sin preguntarles si querían que fuera así."
    # english: mc_pensamiento "One by one, without asking them if they wanted it this way."
    mc_pensamiento "Uno a uno, sin preguntarles si querían que fuera así."

# game/02_cap1_beat_casa.rpy:288
translate turkish beat_casa_d6898884:

    # mc_pensamiento "Si mañana me voy, me voy sabiendo exactamente por qué."
    # english: mc_pensamiento "If I go tomorrow, I'll go knowing exactly why."
    mc_pensamiento "Si mañana me voy, me voy sabiendo exactamente por qué."

# game/02_cap1_beat_casa.rpy:290
translate turkish beat_casa_f4d3f561:

    # mc_pensamiento "Mañana se verá si decidí bien."
    # english: mc_pensamiento "Tomorrow will show if I chose right."
    mc_pensamiento "Mañana se verá si decidí bien."

# game/02_cap1_beat_casa.rpy:318
translate turkish bcl_menu_6e7eb285:

    # mc_pensamiento "¿En qué nombre me detengo?" nointeract
    # english: mc_pensamiento "Which name do I stop on?" nointeract
    mc_pensamiento "¿En qué nombre me detengo?" nointeract

# game/02_cap1_beat_casa.rpy:367
translate turkish bcl_ichika_78006a06:

    # mc_pensamiento "Ichika fue la primera cara que vi en ese departamento."
    # english: mc_pensamiento "Ichika was the first face I saw in that apartment."
    mc_pensamiento "Ichika fue la primera cara que vi en ese departamento."

# game/02_cap1_beat_casa.rpy:369
translate turkish bcl_ichika_57dea60d:

    # mc_pensamiento "Me abrió la puerta con una sonrisa fácil, como si llevara un rato esperándome."
    # english: mc_pensamiento "She opened the door with an easy smile, as if she'd been waiting for me a while."
    mc_pensamiento "Me abrió la puerta con una sonrisa fácil, como si llevara un rato esperándome."

# game/02_cap1_beat_casa.rpy:371
translate turkish bcl_ichika_81179cc9:

    # mc_pensamiento "Pidió perdón por adelantado por el desorden, el ruido y todo lo que iba a ver."
    # english: mc_pensamiento "She apologized in advance for the mess, the noise, and everything I was about to see."
    mc_pensamiento "Pidió perdón por adelantado por el desorden, el ruido y todo lo que iba a ver."

# game/02_cap1_beat_casa.rpy:373
translate turkish bcl_ichika_e49073b3:

    # mc_pensamiento "Resultó que lo decía en serio."
    # english: mc_pensamiento "Turns out she meant it."
    mc_pensamiento "Resultó que lo decía en serio."

# game/02_cap1_beat_casa.rpy:375
translate turkish bcl_ichika_26a8d439:

    # mc_pensamiento "Al día siguiente fingió dormir para no contestar una hoja que ya habían decidido fallar."
    # english: mc_pensamiento "The next day she faked sleep to avoid a sheet they'd all agreed to fail."
    mc_pensamiento "Al día siguiente fingió dormir para no contestar una hoja que ya habían decidido fallar."

# game/02_cap1_beat_casa.rpy:377
translate turkish bcl_ichika_71e20d90:

    # mc_pensamiento "Dijo «coincidencia, somos hermanas» sin que le temblara nada."
    # english: mc_pensamiento "She said \"coincidence, we're sisters\" without a flicker."
    mc_pensamiento "Dijo «coincidencia, somos hermanas» sin que le temblara nada."

# game/02_cap1_beat_casa.rpy:379
translate turkish bcl_ichika_d4bcd53b:

    # mc_pensamiento "Mentía tan bien que casi daba gusto. Casi."
    # english: mc_pensamiento "She lied so well it was almost a pleasure. Almost."
    mc_pensamiento "Mentía tan bien que casi daba gusto. Casi."

# game/02_cap1_beat_casa.rpy:383
translate turkish bcl_ichika_6d8a9f80:

    # mc_pensamiento "Por eso, al entrar al club de teatro, ya no me fiaba de ninguna de sus sonrisas."
    # english: mc_pensamiento "So walking into the drama club, I no longer trusted any of her smiles."
    mc_pensamiento "Por eso, al entrar al club de teatro, ya no me fiaba de ninguna de sus sonrisas."

# game/02_cap1_beat_casa.rpy:385
translate turkish bcl_ichika_2338bdf6:

    # mc_pensamiento "La encontré dormida en el suelo, con el guion resbalándole de la mano."
    # english: mc_pensamiento "I found her asleep on the floor, the script slipping out of her hand."
    mc_pensamiento "La encontré dormida en el suelo, con el guion resbalándole de la mano."

# game/02_cap1_beat_casa.rpy:387
translate turkish bcl_ichika_a69bdbc7:

    # mc_pensamiento "A su lado, dos latas de energizante. Una de ellas, abollada."
    # english: mc_pensamiento "Next to her, two cans of energy drink. One of them dented."
    mc_pensamiento "A su lado, dos latas de energizante. Una de ellas, abollada."

# game/02_cap1_beat_casa.rpy:389
translate turkish bcl_ichika_d89b6a17:

    # mc_pensamiento "Y un horario con tres columnas superpuestas y algo tachado que no quiso que leyera."
    # english: mc_pensamiento "And a schedule with three overlapping columns and something crossed out she didn't want me to read."
    mc_pensamiento "Y un horario con tres columnas superpuestas y algo tachado que no quiso que leyera."

# game/02_cap1_beat_casa.rpy:391
translate turkish bcl_ichika_cc537d41:

    # mc_pensamiento "Al despertar, durante medio segundo, no hubo actuación."
    # english: mc_pensamiento "When she woke up, for half a second, there was no act."
    mc_pensamiento "Al despertar, durante medio segundo, no hubo actuación."

# game/02_cap1_beat_casa.rpy:393
translate turkish bcl_ichika_292e57fb:

    # mc_pensamiento "Dijo «perdí la tarde entera» sin nada de teatro en la voz."
    # english: mc_pensamiento "She said \"I lost the whole afternoon\" with no theater in her voice at all."
    mc_pensamiento "Dijo «perdí la tarde entera» sin nada de teatro en la voz."

# game/02_cap1_beat_casa.rpy:395
translate turkish bcl_ichika_6b06d1dd:

    # mc_pensamiento "Después volvió la sonrisa, y con ella el chiste del «descanso escénico»."
    # english: mc_pensamiento "Then the smile came back, and with it the \"stage rest\" joke."
    mc_pensamiento "Después volvió la sonrisa, y con ella el chiste del «descanso escénico»."

# game/02_cap1_beat_casa.rpy:399
translate turkish bcl_ichika_7a763a9c:

    # mc_pensamiento "No le seguí la broma. Me quedé callado, esperando."
    # english: mc_pensamiento "I didn't play along. I stayed quiet, waiting."
    mc_pensamiento "No le seguí la broma. Me quedé callado, esperando."

# game/02_cap1_beat_casa.rpy:401
translate turkish bcl_ichika_4bee358e:

    # mc_pensamiento "Fue ella quien rompió el silencio: dijo que no sabía cuánto más podía seguir así."
    # english: mc_pensamiento "She broke the silence herself: she said she didn't know how much longer she could go on like this."
    mc_pensamiento "Fue ella quien rompió el silencio: dijo que no sabía cuánto más podía seguir así."

# game/02_cap1_beat_casa.rpy:403
translate turkish bcl_ichika_c3252961:

    # mc_pensamiento "Las audiciones, las clases, fingir que puede con las dos."
    # english: mc_pensamiento "The auditions, the classes, pretending she can handle both."
    mc_pensamiento "Las audiciones, las clases, fingir que puede con las dos."

# game/02_cap1_beat_casa.rpy:405
translate turkish bcl_ichika_f4b089da:

    # mc_pensamiento "Y que a la audición del primer día no llegó. Se durmió en el tren."
    # english: mc_pensamiento "And that she never made it to the first day's audition. She fell asleep on the train."
    mc_pensamiento "Y que a la audición del primer día no llegó. Se durmió en el tren."

# game/02_cap1_beat_casa.rpy:407
translate turkish bcl_ichika_50e80e5a:

    # mc_pensamiento "No creo que me lo dijera a mí. Creo que se le escapó."
    # english: mc_pensamiento "I don't think she meant to tell me. I think it slipped out."
    mc_pensamiento "No creo que me lo dijera a mí. Creo que se le escapó."

# game/02_cap1_beat_casa.rpy:409
translate turkish bcl_ichika_44bca4e6:

    # mc_pensamiento "Al día siguiente me contó que había dormido siete horas y cuarto. Y que redondeaba hacia arriba."
    # english: mc_pensamiento "The next day she told me she'd slept seven and a quarter hours. And that she rounded up."
    mc_pensamiento "Al día siguiente me contó que había dormido siete horas y cuarto. Y que redondeaba hacia arriba."

# game/02_cap1_beat_casa.rpy:411
translate turkish bcl_ichika_028793da:

    # mc_pensamiento "Y que ya podía cuidarme ella a mí, si la dejaba."
    # english: mc_pensamiento "And that she could take care of me now, if I let her."
    mc_pensamiento "Y que ya podía cuidarme ella a mí, si la dejaba."

# game/02_cap1_beat_casa.rpy:413
translate turkish bcl_ichika_d6d5ac2b:

    # mc_pensamiento "Nadie me había preguntado por mi sueño en años."
    # english: mc_pensamiento "Nobody had asked about my sleep in years."
    mc_pensamiento "Nadie me había preguntado por mi sueño en años."

# game/02_cap1_beat_casa.rpy:417
translate turkish bcl_ichika_3471bf08:

    # mc_pensamiento "Le seguí la broma y acabamos inventando un dragón que lee contratos de audición."
    # english: mc_pensamiento "I played along, and we ended up inventing a dragon who reads audition contracts."
    mc_pensamiento "Le seguí la broma y acabamos inventando un dragón que lee contratos de audición."

# game/02_cap1_beat_casa.rpy:419
translate turkish bcl_ichika_e4fde5ac:

    # mc_pensamiento "Se rió de verdad. Fue un buen rato."
    # english: mc_pensamiento "She laughed for real. It was a good while."
    mc_pensamiento "Se rió de verdad. Fue un buen rato."

# game/02_cap1_beat_casa.rpy:421
translate turkish bcl_ichika_cc24bff4:

    # mc_pensamiento "Pero mientras hablábamos del dragón, las latas siguieron sin explicación."
    # english: mc_pensamiento "But while we talked about the dragon, the cans stayed unexplained."
    mc_pensamiento "Pero mientras hablábamos del dragón, las latas siguieron sin explicación."

# game/02_cap1_beat_casa.rpy:423
translate turkish bcl_ichika_51e5f224:

    # mc_pensamiento "Al día siguiente bautizó al dragón «Contrato». Dice que es su mejor material."
    # english: mc_pensamiento "The next day she named the dragon \"Contract.\" She says it's her best material."
    mc_pensamiento "Al día siguiente bautizó al dragón «Contrato». Dice que es su mejor material."

# game/02_cap1_beat_casa.rpy:427
translate turkish bcl_ichika_8b765788:

    # mc_pensamiento "Le dije que si tenía energía para chistes, la tenía para estudiar."
    # english: mc_pensamiento "I told her that if she had the energy for jokes, she had the energy to study."
    mc_pensamiento "Le dije que si tenía energía para chistes, la tenía para estudiar."

# game/02_cap1_beat_casa.rpy:429
translate turkish bcl_ichika_7df1aaf7:

    # mc_pensamiento "No se enfadó. Contestó «tienes razón» sonriendo y guardó el guion sin doblarlo."
    # english: mc_pensamiento "She didn't get angry. She said \"you're right,\" smiling, and put the script away without folding it."
    mc_pensamiento "No se enfadó. Contestó «tienes razón» sonriendo y guardó el guion sin doblarlo."

# game/02_cap1_beat_casa.rpy:431
translate turkish bcl_ichika_2caba786:

    # mc_pensamiento "Fue correcta conmigo. Solo... correcta."
    # english: mc_pensamiento "She was polite with me. Just... polite."
    mc_pensamiento "Fue correcta conmigo. Solo... correcta."

# game/02_cap1_beat_casa.rpy:433
translate turkish bcl_ichika_eb5a4ce9:

    # mc_pensamiento "Al día siguiente la sonrisa llegó medio segundo tarde."
    # english: mc_pensamiento "The next day the smile arrived half a second late."
    mc_pensamiento "Al día siguiente la sonrisa llegó medio segundo tarde."

# game/02_cap1_beat_casa.rpy:435
translate turkish bcl_ichika_77efec47:

    # mc_pensamiento "Me recibió con mi nombre y nada más."
    # english: mc_pensamiento "She greeted me by name and nothing more."
    mc_pensamiento "Me recibió con mi nombre y nada más."

# game/02_cap1_beat_casa.rpy:437
translate turkish bcl_ichika_0b47b198:

    # mc_pensamiento "Antes de irnos le llegó un mensaje: un papel nuevo en la obra de primavera."
    # english: mc_pensamiento "Before we left she got a message: a new part in the spring play."
    mc_pensamiento "Antes de irnos le llegó un mensaje: un papel nuevo en la obra de primavera."

# game/02_cap1_beat_casa.rpy:439
translate turkish bcl_ichika_413d1aae:

    # mc_pensamiento "Dijo que sí sin pensarlo, con una agenda que ya no le cabía."
    # english: mc_pensamiento "She said yes without thinking, with a schedule that no longer had room."
    mc_pensamiento "Dijo que sí sin pensarlo, con una agenda que ya no le cabía."

# game/02_cap1_beat_casa.rpy:441
translate turkish bcl_ichika_cb812c7a:

    # mc_pensamiento "Ni siquiera contestó el mensaje. Lo guardó, como guarda todo lo demás."
    # english: mc_pensamiento "She didn't even answer the message. She stored it away, like everything else."
    mc_pensamiento "Ni siquiera contestó el mensaje. Lo guardó, como guarda todo lo demás."

# game/02_cap1_beat_casa.rpy:445
translate turkish bcl_ichika_dbd63c04:

    # mc_pensamiento "Aun así, hay algo en ella que no encaja."
    # english: mc_pensamiento "Even so, something about her doesn't fit."
    mc_pensamiento "Aun así, hay algo en ella que no encaja."

# game/02_cap1_beat_casa.rpy:447
translate turkish bcl_ichika_e49d2560:

    # mc_pensamiento "No sabe cuántas horas durmió."
    # english: mc_pensamiento "She doesn't know how many hours she slept."
    mc_pensamiento "No sabe cuántas horas durmió."

# game/02_cap1_beat_casa.rpy:449
translate turkish bcl_ichika_efdf0a39:

    # mc_pensamiento "Pero sabe cuánto tarda un tren, cuánto la estación y cuánto cambiarse."
    # english: mc_pensamiento "But she knows how long the train takes, how long the station, and how long to change."
    mc_pensamiento "Pero sabe cuánto tarda un tren, cuánto la estación y cuánto cambiarse."

# game/02_cap1_beat_casa.rpy:451
translate turkish bcl_ichika_5dc84379:

    # mc_pensamiento "Lo dijo de corrido, sin contar con los dedos. Y después lo llamó «ser organizada»."
    # english: mc_pensamiento "She rattled it off, no counting on her fingers. And then called it \"being organized.\""
    mc_pensamiento "Lo dijo de corrido, sin contar con los dedos. Y después lo llamó «ser organizada»."

# game/02_cap1_beat_casa.rpy:453
translate turkish bcl_ichika_3a14f24f:

    # mc_pensamiento "Eso no le sale a cualquiera. Y ella ni siquiera lo considera un talento."
    # english: mc_pensamiento "Not just anyone can do that. And she doesn't even count it as a talent."
    mc_pensamiento "Eso no le sale a cualquiera. Y ella ni siquiera lo considera un talento."

# game/02_cap1_beat_casa.rpy:461
translate turkish bcl_ichika_39e0ffbc:

    # mc_pensamiento "A Ichika no fui a buscarla."
    # english: mc_pensamiento "I didn't go looking for Ichika."
    mc_pensamiento "A Ichika no fui a buscarla."

# game/02_cap1_beat_casa.rpy:463
translate turkish bcl_ichika_53f82ca3:

    # mc_pensamiento "La primera vez me abrió la puerta con una sonrisa fácil y una disculpa por adelantado."
    # english: mc_pensamiento "The first time, she opened the door with an easy smile and an apology in advance."
    mc_pensamiento "La primera vez me abrió la puerta con una sonrisa fácil y una disculpa por adelantado."

# game/02_cap1_beat_casa.rpy:465
translate turkish bcl_ichika_9aa32e06:

    # mc_pensamiento "Al día siguiente me dijo que su audición había sido un éxito. No dijo de qué."
    # english: mc_pensamiento "The next day she told me her audition had been a success. She didn't say for what."
    mc_pensamiento "Al día siguiente me dijo que su audición había sido un éxito. No dijo de qué."

# game/02_cap1_beat_casa.rpy:467
translate turkish bcl_ichika_f69b4bdc:

    # mc_pensamiento "Después fingió dormir para tapar una hoja que había contestado mal a propósito."
    # english: mc_pensamiento "Then she faked sleep to cover a sheet she'd answered wrong on purpose."
    mc_pensamiento "Después fingió dormir para tapar una hoja que había contestado mal a propósito."

# game/02_cap1_beat_casa.rpy:469
translate turkish bcl_ichika_694ec301:

    # mc_pensamiento "Desde entonces, cada vez que la veo, hay un chiste antes de que yo diga nada."
    # english: mc_pensamiento "Since then, every time I see her, there's a joke before I can say a word."
    mc_pensamiento "Desde entonces, cada vez que la veo, hay un chiste antes de que yo diga nada."

# game/02_cap1_beat_casa.rpy:471
translate turkish bcl_ichika_baa93128:

    # mc_pensamiento "Cuando se enteró de que no la había elegido, soltó que había ensayado tres reacciones."
    # english: mc_pensamiento "When she found out I hadn't picked her, she blurted out that she'd rehearsed three reactions."
    mc_pensamiento "Cuando se enteró de que no la había elegido, soltó que había ensayado tres reacciones."

# game/02_cap1_beat_casa.rpy:473
translate turkish bcl_ichika_35bbbdc5:

    # mc_pensamiento "Una graciosa, una dramática y una de «qué sorpresa, no te esperaba»."
    # english: mc_pensamiento "A funny one, a dramatic one, and a \"what a surprise, I wasn't expecting you.\""
    mc_pensamiento "Una graciosa, una dramática y una de «qué sorpresa, no te esperaba»."

# game/02_cap1_beat_casa.rpy:475
translate turkish bcl_ichika_d8ed80e0:

    # mc_pensamiento "Luego dijo que eran todas actuación, y que no sabía si habría podido con otra cosa."
    # english: mc_pensamiento "Then she said it was all acting, and that she didn't know if she could have handled anything else."
    mc_pensamiento "Luego dijo que eran todas actuación, y que no sabía si habría podido con otra cosa."

# game/02_cap1_beat_casa.rpy:477
translate turkish bcl_ichika_68584b70:

    # mc_pensamiento "Cuando sonríe, parece que se acomoda un disfraz."
    # english: mc_pensamiento "When she smiles, it looks like she's adjusting a costume."
    mc_pensamiento "Cuando sonríe, parece que se acomoda un disfraz."

# game/02_cap1_beat_casa.rpy:479
translate turkish bcl_ichika_ab238ef0:

    # mc_pensamiento "No sé si sigue actuando o si dejó de hacerlo."
    # english: mc_pensamiento "I can't tell if she's still acting or if she stopped."
    mc_pensamiento "No sé si sigue actuando o si dejó de hacerlo."

# game/02_cap1_beat_casa.rpy:500
translate turkish bcl_nino_f98af9d1:

    # mc_pensamiento "Nino fue la segunda, y la primera en dejarme claro que sobraba."
    # english: mc_pensamiento "Nino was the second, and the first to make it clear I was in the way."
    mc_pensamiento "Nino fue la segunda, y la primera en dejarme claro que sobraba."

# game/02_cap1_beat_casa.rpy:502
translate turkish bcl_nino_ed20ab6c:

    # mc_pensamiento "«¿A quién diablos le abriste la puerta?», dijo, sin saber siquiera mi nombre."
    # english: mc_pensamiento "\"Who the heck did you just open the door for?\" she said, not even knowing my name."
    mc_pensamiento "«¿A quién diablos le abriste la puerta?», dijo, sin saber siquiera mi nombre."

# game/02_cap1_beat_casa.rpy:504
translate turkish bcl_nino_ee82f6ed:

    # mc_pensamiento "Me dio una semana. Después dijo que el último tutor había durado cuatro días."
    # english: mc_pensamiento "She gave me a week. Then she said the last tutor had lasted four days."
    mc_pensamiento "Me dio una semana. Después dijo que el último tutor había durado cuatro días."

# game/02_cap1_beat_casa.rpy:506
translate turkish bcl_nino_c0dab4b1:

    # mc_pensamiento "Sin rabia. Como un dato que ya se sabe de memoria."
    # english: mc_pensamiento "No anger. Like a fact she already knows by heart."
    mc_pensamiento "Sin rabia. Como un dato que ya se sabe de memoria."

# game/02_cap1_beat_casa.rpy:508
translate turkish bcl_nino_970f2289:

    # mc_pensamiento "Al día siguiente organizó a las cinco para que contestaran igual de mal."
    # english: mc_pensamiento "The next day she got all five of them to answer equally badly."
    mc_pensamiento "Al día siguiente organizó a las cinco para que contestaran igual de mal."

# game/02_cap1_beat_casa.rpy:510
translate turkish bcl_nino_b69b5ff3:

    # mc_pensamiento "Cinco hojas, seis errores idénticos y un informe listo para su padre."
    # english: mc_pensamiento "Five sheets, six identical mistakes, and a report ready for her father."
    mc_pensamiento "Cinco hojas, seis errores idénticos y un informe listo para su padre."

# game/02_cap1_beat_casa.rpy:512
translate turkish bcl_nino_57493a12:

    # mc_pensamiento "Pero cuando leí una frase en inglés con mi peor acento, no pudo evitarlo."
    # english: mc_pensamiento "But when I read an English sentence in my worst accent, she couldn't help herself."
    mc_pensamiento "Pero cuando leí una frase en inglés con mi peor acento, no pudo evitarlo."

# game/02_cap1_beat_casa.rpy:514
translate turkish bcl_nino_8323ffaa:

    # mc_pensamiento "Me corrigió. Molesta, en mitad de la discusión, sin pensarlo."
    # english: mc_pensamiento "She corrected me. Annoyed, mid-argument, without thinking."
    mc_pensamiento "Me corrigió. Molesta, en mitad de la discusión, sin pensarlo."

# game/02_cap1_beat_casa.rpy:516
translate turkish bcl_nino_9331753d:

    # mc_pensamiento "«Se pega, no se separa.» Nadie corrige por reflejo algo que no domina."
    # english: mc_pensamiento "\"It links together, you don't chop it up.\" Nobody corrects by reflex what they haven't mastered."
    mc_pensamiento "«Se pega, no se separa.» Nadie corrige por reflejo algo que no domina."

# game/02_cap1_beat_casa.rpy:520
translate turkish bcl_nino_4bb0e332:

    # mc_pensamiento "La encontré en el pasillo de importados, comparando dos cajas de harina."
    # english: mc_pensamiento "I found her in the imports aisle, comparing two boxes of flour."
    mc_pensamiento "La encontré en el pasillo de importados, comparando dos cajas de harina."

# game/02_cap1_beat_casa.rpy:522
translate turkish bcl_nino_03467670:

    # mc_pensamiento "Leía las etiquetas de corrido, moviendo apenas los labios."
    # english: mc_pensamiento "She was reading the labels straight through, barely moving her lips."
    mc_pensamiento "Leía las etiquetas de corrido, moviendo apenas los labios."

# game/02_cap1_beat_casa.rpy:524
translate turkish bcl_nino_ad3e4e34:

    # mc_pensamiento "Llevaba una tarjeta de receta escrita a mano, vieja, de alguien que no era ella."
    # english: mc_pensamiento "She carried a handwritten recipe card, old, from someone who wasn't her."
    mc_pensamiento "Llevaba una tarjeta de receta escrita a mano, vieja, de alguien que no era ella."

# game/02_cap1_beat_casa.rpy:526
translate turkish bcl_nino_756c16d3:

    # mc_pensamiento "Lo leyó todo sin buscar una sola palabra. Y cuando intentó explicar cómo, se trabó."
    # english: mc_pensamiento "She read all of it without looking up a single word. And when she tried to explain how, she stalled."
    mc_pensamiento "Lo leyó todo sin buscar una sola palabra. Y cuando intentó explicar cómo, se trabó."

# game/02_cap1_beat_casa.rpy:528
translate turkish bcl_nino_c9c7bb09:

    # mc_pensamiento "«No es lo mismo leer que...» Y no terminó la frase."
    # english: mc_pensamiento "\"Reading isn't the same as...\" And she didn't finish the sentence."
    mc_pensamiento "«No es lo mismo leer que...» Y no terminó la frase."

# game/02_cap1_beat_casa.rpy:530
translate turkish bcl_nino_660cf7b1:

    # mc_pensamiento "Luego, por una vez, habló de más: dijo que los tutores anteriores también sonreían el primer día."
    # english: mc_pensamiento "Then, for once, she said too much: the earlier tutors smiled on the first day too."
    mc_pensamiento "Luego, por una vez, habló de más: dijo que los tutores anteriores también sonreían el primer día."

# game/02_cap1_beat_casa.rpy:532
translate turkish bcl_nino_0dafda5e:

    # mc_pensamiento "Que sus hermanas se ilusionan cada vez, y que después les toca ver a alguien irse."
    # english: mc_pensamiento "That her sisters get their hopes up every time, and then have to watch someone leave."
    mc_pensamiento "Que sus hermanas se ilusionan cada vez, y que después les toca ver a alguien irse."

# game/02_cap1_beat_casa.rpy:534
translate turkish bcl_nino_ab122f0f:

    # mc_pensamiento "Su desconfianza es con cualquiera que ocupe este puesto."
    # english: mc_pensamiento "Her distrust is for whoever holds this job."
    mc_pensamiento "Su desconfianza es con cualquiera que ocupe este puesto."

# game/02_cap1_beat_casa.rpy:538
translate turkish bcl_nino_a0c299e2:

    # mc_pensamiento "Le dije que tenía razón en desconfiar y que solo el tiempo lo demostraría."
    # english: mc_pensamiento "I told her she was right not to trust me, and that only time would prove it."
    mc_pensamiento "Le dije que tenía razón en desconfiar y que solo el tiempo lo demostraría."

# game/02_cap1_beat_casa.rpy:540
translate turkish bcl_nino_3e550729:

    # mc_pensamiento "Dijo que era la primera vez que alguien no le prometía nada."
    # english: mc_pensamiento "She said it was the first time anyone hadn't promised her anything."
    mc_pensamiento "Dijo que era la primera vez que alguien no le prometía nada."

# game/02_cap1_beat_casa.rpy:542
translate turkish bcl_nino_2e19c30e:

    # mc_pensamiento "Eso no significa que confíe en mí. Lo dejó bien claro."
    # english: mc_pensamiento "That doesn't mean she trusts me. She made that very clear."
    mc_pensamiento "Eso no significa que confíe en mí. Lo dejó bien claro."

# game/02_cap1_beat_casa.rpy:544
translate turkish bcl_nino_7352613b:

    # mc_pensamiento "Pero al día siguiente me ordenó comer algo antes de clases, y se le olvidó cruzar los brazos."
    # english: mc_pensamiento "But the next day she ordered me to eat something before class, and forgot to cross her arms."
    mc_pensamiento "Pero al día siguiente me ordenó comer algo antes de clases, y se le olvidó cruzar los brazos."

# game/02_cap1_beat_casa.rpy:548
translate turkish bcl_nino_00e01477:

    # mc_pensamiento "Le cargué una cesta sin decir nada y terminó caminando a mi lado sin discutirlo."
    # english: mc_pensamiento "I carried her basket without a word, and she ended up walking beside me without arguing."
    mc_pensamiento "Le cargué una cesta sin decir nada y terminó caminando a mi lado sin discutirlo."

# game/02_cap1_beat_casa.rpy:550
translate turkish bcl_nino_5a34f4cd:

    # mc_pensamiento "«Esto no significa nada», dijo. Fue lo más parecido a un gracias que iba a sacarle."
    # english: mc_pensamiento "\"This doesn't mean anything,\" she said. It was the closest thing to a thank-you I'd get out of her."
    mc_pensamiento "«Esto no significa nada», dijo. Fue lo más parecido a un gracias que iba a sacarle."

# game/02_cap1_beat_casa.rpy:554
translate turkish bcl_nino_a6bfa3c0:

    # mc_pensamiento "Le prometí que yo sí iba a durar."
    # english: mc_pensamiento "I promised her I would last."
    mc_pensamiento "Le prometí que yo sí iba a durar."

# game/02_cap1_beat_casa.rpy:556
translate turkish bcl_nino_94ba9a70:

    # mc_pensamiento "Se rió, pero no de gracia: eso mismo había dicho el que llegó antes que yo."
    # english: mc_pensamiento "She laughed, but not because it was funny: the one before me had said exactly that."
    mc_pensamiento "Se rió, pero no de gracia: eso mismo había dicho el que llegó antes que yo."

# game/02_cap1_beat_casa.rpy:558
translate turkish bcl_nino_80af353e:

    # mc_pensamiento "Me dijo que anotara la fecha. Que cuando me fuera, me la iba a recordar."
    # english: mc_pensamiento "She told me to write down the date. That when I left, she'd remind me of it."
    mc_pensamiento "Me dijo que anotara la fecha. Que cuando me fuera, me la iba a recordar."

# game/02_cap1_beat_casa.rpy:560
translate turkish bcl_nino_47259f82:

    # mc_pensamiento "Mientras la acompañaba a la salida, la llamó su padre."
    # english: mc_pensamiento "While I walked her to the exit, her father called."
    mc_pensamiento "Mientras la acompañaba a la salida, la llamó su padre."

# game/02_cap1_beat_casa.rpy:562
translate turkish bcl_nino_fcb7020b:

    # mc_pensamiento "Ella dijo que el tutor nuevo aún no la convencía, y que no quería explicar por qué."
    # english: mc_pensamiento "She said the new tutor hadn't convinced her yet, and that she didn't want to explain why."
    mc_pensamiento "Ella dijo que el tutor nuevo aún no la convencía, y que no quería explicar por qué."

# game/02_cap1_beat_casa.rpy:566
translate turkish bcl_nino_aca2d3b8:

    # mc_pensamiento "Y después llegó la cocina."
    # english: mc_pensamiento "And then came the kitchen."
    mc_pensamiento "Y después llegó la cocina."

# game/02_cap1_beat_casa.rpy:568
translate turkish bcl_nino_fa424f1e:

    # mc_pensamiento "Entré al departamento y la oí pedirle a Maruo que me despidiera."
    # english: mc_pensamiento "I walked into the apartment and heard her asking Maruo to fire me."
    mc_pensamiento "Entré al departamento y la oí pedirle a Maruo que me despidiera."

# game/02_cap1_beat_casa.rpy:570
translate turkish bcl_nino_bcbe8f8f:

    # mc_pensamiento "Es la única vez que la escuché gritarle a su padre."
    # english: mc_pensamiento "It's the only time I've heard her shout at her father."
    mc_pensamiento "Es la única vez que la escuché gritarle a su padre."

# game/02_cap1_beat_casa.rpy:572
translate turkish bcl_nino_a34cfc27:

    # mc_pensamiento "Dijo que no se trataba de mí, sino de que iba a durar lo mismo que los anteriores."
    # english: mc_pensamiento "She said it wasn't about me, but about how I'd last as long as the others."
    mc_pensamiento "Dijo que no se trataba de mí, sino de que iba a durar lo mismo que los anteriores."

# game/02_cap1_beat_casa.rpy:574
translate turkish bcl_nino_4cbdff67:

    # mc_pensamiento "Que Ichika finge y Yotsuba se esfuerza el doble."
    # english: mc_pensamiento "That Ichika pretends and Yotsuba works twice as hard."
    mc_pensamiento "Que Ichika finge y Yotsuba se esfuerza el doble."

# game/02_cap1_beat_casa.rpy:576
translate turkish bcl_nino_ecf40124:

    # mc_pensamiento "Que Miku se encierra más e Itsuki se lo toma personal."
    # english: mc_pensamiento "That Miku shuts herself in more and Itsuki takes it personally."
    mc_pensamiento "Que Miku se encierra más e Itsuki se lo toma personal."

# game/02_cap1_beat_casa.rpy:578
translate turkish bcl_nino_76d04cf5:

    # mc_pensamiento "Y que a ella le toca juntar los pedazos de las cuatro porque es la única que nunca se ilusionó."
    # english: mc_pensamiento "And that she's stuck picking up the pieces for all four, since she's the only one who never hoped."
    mc_pensamiento "Y que a ella le toca juntar los pedazos de las cuatro porque es la única que nunca se ilusionó."

# game/02_cap1_beat_casa.rpy:580
translate turkish bcl_nino_6bf45a0d:

    # mc_pensamiento "«Alguien tiene que quedarse con la cabeza fría.»"
    # english: mc_pensamiento "\"Someone has to keep a cool head.\""
    mc_pensamiento "«Alguien tiene que quedarse con la cabeza fría.»"

# game/02_cap1_beat_casa.rpy:582
translate turkish bcl_nino_637efb45:

    # mc_pensamiento "Se detuvo con la taza a medio camino y dijo que no había dicho nada de eso."
    # english: mc_pensamiento "She stopped with the cup halfway up and said she hadn't said any of that."
    mc_pensamiento "Se detuvo con la taza a medio camino y dijo que no había dicho nada de eso."

# game/02_cap1_beat_casa.rpy:584
translate turkish bcl_nino_169af1fa:

    # mc_pensamiento "Lo había dicho todo."
    # english: mc_pensamiento "She had said all of it."
    mc_pensamiento "Lo había dicho todo."

# game/02_cap1_beat_casa.rpy:588
translate turkish bcl_nino_3cf2b1d5:

    # mc_pensamiento "No fui a buscarla al centro comercial."
    # english: mc_pensamiento "I didn't go looking for her at the mall."
    mc_pensamiento "No fui a buscarla al centro comercial."

# game/02_cap1_beat_casa.rpy:590
translate turkish bcl_nino_4355ab4f:

    # mc_pensamiento "Pero a Nino la conozco desde la primera puerta: «no vas a durar ni una semana»."
    # english: mc_pensamiento "But I've known Nino since the first door: \"You won't last a week.\""
    mc_pensamiento "Pero a Nino la conozco desde la primera puerta: «no vas a durar ni una semana»."

# game/02_cap1_beat_casa.rpy:592
translate turkish bcl_nino_9dcdfbd0:

    # mc_pensamiento "Desde el segundo día: organizó a las cinco para que fallaran juntas."
    # english: mc_pensamiento "Since the second day: she got all five of them to fail together."
    mc_pensamiento "Desde el segundo día: organizó a las cinco para que fallaran juntas."

# game/02_cap1_beat_casa.rpy:594
translate turkish bcl_nino_a45df594:

    # mc_pensamiento "Aun así me corrigió un «had to» sin pensarlo, molesta, a mitad de discusión."
    # english: mc_pensamiento "Even so, she corrected my \"had to\" without thinking, annoyed, mid-argument."
    mc_pensamiento "Aun así me corrigió un «had to» sin pensarlo, molesta, a mitad de discusión."

# game/02_cap1_beat_casa.rpy:596
translate turkish bcl_nino_be3e8373:

    # mc_pensamiento "Nadie corrige por reflejo algo que no domina."
    # english: mc_pensamiento "Nobody corrects by reflex what they haven't mastered."
    mc_pensamiento "Nadie corrige por reflejo algo que no domina."

# game/02_cap1_beat_casa.rpy:598
translate turkish bcl_nino_4dff0169:

    # mc_pensamiento "Cuando supo que no la había buscado dijo que le daba igual."
    # english: mc_pensamiento "When she found out I hadn't gone looking for her, she said she didn't care."
    mc_pensamiento "Cuando supo que no la había buscado dijo que le daba igual."

# game/02_cap1_beat_casa.rpy:600
translate turkish bcl_nino_3de974e1:

    # mc_pensamiento "Que ya me había visto en su casa de sobra."
    # english: mc_pensamiento "That she'd seen more than enough of me at her house."
    mc_pensamiento "Que ya me había visto en su casa de sobra."

# game/02_cap1_beat_casa.rpy:602
translate turkish bcl_nino_513d9eee:

    # mc_pensamiento "Y que alguien tiene que ser la que no cambia, para que las demás tengan a dónde volver."
    # english: mc_pensamiento "And that someone has to be the one who doesn't change, so the others have somewhere to come back to."
    mc_pensamiento "Y que alguien tiene que ser la que no cambia, para que las demás tengan a dónde volver."

# game/02_cap1_beat_casa.rpy:604
translate turkish bcl_nino_9dac70af:

    # mc_pensamiento "Después vino la cocina. La oí pedirle a su padre que me echara."
    # english: mc_pensamiento "Then came the kitchen. I heard her ask her father to throw me out."
    mc_pensamiento "Después vino la cocina. La oí pedirle a su padre que me echara."

# game/02_cap1_beat_casa.rpy:606
translate turkish bcl_nino_6e6c5b92:

    # mc_pensamiento "Gritó. Y después, sentada en la cocina, me explicó por qué."
    # english: mc_pensamiento "She shouted. And afterward, sitting in the kitchen, she explained why."
    mc_pensamiento "Gritó. Y después, sentada en la cocina, me explicó por qué."

# game/02_cap1_beat_casa.rpy:608
translate turkish bcl_nino_55e0412d:

    # mc_pensamiento "Habló de sus hermanas una por una, y de sí misma como la única que nunca se ilusionó."
    # english: mc_pensamiento "She went through her sisters one by one, and herself as the only one who never got her hopes up."
    mc_pensamiento "Habló de sus hermanas una por una, y de sí misma como la única que nunca se ilusionó."

# game/02_cap1_beat_casa.rpy:614
translate turkish bcl_nino_f2439391:

    # mc_pensamiento "Le pregunté quién juntaba los pedazos de ella."
    # english: mc_pensamiento "I asked her who picks up her pieces."
    mc_pensamiento "Le pregunté quién juntaba los pedazos de ella."

# game/02_cap1_beat_casa.rpy:616
translate turkish bcl_nino_6c58d092:

    # mc_pensamiento "No supo qué contestar, y me puso a cortar cebollas."
    # english: mc_pensamiento "She didn't know what to say, and put me to work cutting onions."
    mc_pensamiento "No supo qué contestar, y me puso a cortar cebollas."

# game/02_cap1_beat_casa.rpy:618
translate turkish bcl_nino_66c5fd70:

    # mc_pensamiento "En toda la tarde no volvió a hablar de despedirme."
    # english: mc_pensamiento "For the rest of the afternoon she never brought up firing me again."
    mc_pensamiento "En toda la tarde no volvió a hablar de despedirme."

# game/02_cap1_beat_casa.rpy:622
translate turkish bcl_nino_e3eb6d2d:

    # mc_pensamiento "No dije nada. Recogí su taza y la lavé en silencio."
    # english: mc_pensamiento "I said nothing. I picked up her cup and washed it in silence."
    mc_pensamiento "No dije nada. Recogí su taza y la lavé en silencio."

# game/02_cap1_beat_casa.rpy:624
translate turkish bcl_nino_84b41d62:

    # mc_pensamiento "No me echó, pero tampoco me dejó quedarme de verdad."
    # english: mc_pensamiento "She didn't throw me out, but she didn't really let me stay either."
    mc_pensamiento "No me echó, pero tampoco me dejó quedarme de verdad."

# game/02_cap1_beat_casa.rpy:628
translate turkish bcl_nino_5a5ae598:

    # mc_pensamiento "Le dije que se ocupara de lo suyo y dejara de juntar los pedazos de las demás."
    # english: mc_pensamiento "I told her to take care of her own and stop picking up everyone else's pieces."
    mc_pensamiento "Le dije que se ocupara de lo suyo y dejara de juntar los pedazos de las demás."

# game/02_cap1_beat_casa.rpy:630
translate turkish bcl_nino_b183ea6c:

    # mc_pensamiento "Contestó que ahora entendía por qué su padre había firmado conmigo: hablamos el mismo idioma."
    # english: mc_pensamiento "She answered that now she understood why her father had signed me: we speak the same language."
    mc_pensamiento "Contestó que ahora entendía por qué su padre había firmado conmigo: hablamos el mismo idioma."

# game/02_cap1_beat_casa.rpy:632
translate turkish bcl_nino_576ad175:

    # mc_pensamiento "No supe si era un insulto o la descripción más exacta que me habían dado de esa casa."
    # english: mc_pensamiento "I couldn't tell if it was an insult or the most accurate thing anyone's said about that house."
    mc_pensamiento "No supe si era un insulto o la descripción más exacta que me habían dado de esa casa."

# game/02_cap1_beat_casa.rpy:634
translate turkish bcl_nino_f046863f:

    # mc_pensamiento "Entendí que no está enojada conmigo."
    # english: mc_pensamiento "I understood she isn't angry at me."
    mc_pensamiento "Entendí que no está enojada conmigo."

# game/02_cap1_beat_casa.rpy:640
translate turkish bcl_nino_1080b057:

    # mc_pensamiento "Aunque lo que más se me quedó fue otra cosa."
    # english: mc_pensamiento "Though what stuck with me most was something else."
    mc_pensamiento "Aunque lo que más se me quedó fue otra cosa."

# game/02_cap1_beat_casa.rpy:642
translate turkish bcl_nino_18973208:

    # mc_pensamiento "Lee de corrido un idioma que no es el suyo y corrige un error sin pensarlo."
    # english: mc_pensamiento "She reads a language that isn't hers fluently and corrects a mistake without thinking."
    mc_pensamiento "Lee de corrido un idioma que no es el suyo y corrige un error sin pensarlo."

# game/02_cap1_beat_casa.rpy:644
translate turkish bcl_nino_02d8974e:

    # mc_pensamiento "Lo único que no puede hacer es explicarlo en voz alta sin trabarse."
    # english: mc_pensamiento "The only thing she can't do is explain it out loud without stalling."
    mc_pensamiento "Lo único que no puede hacer es explicarlo en voz alta sin trabarse."

# game/02_cap1_beat_casa.rpy:646
translate turkish bcl_nino_7f8e6c10:

    # mc_pensamiento "Ahí dentro hay mucho más de lo que deja ver."
    # english: mc_pensamiento "There's a lot more in there than she lets on."
    mc_pensamiento "Ahí dentro hay mucho más de lo que deja ver."

# game/02_cap1_beat_casa.rpy:654
translate turkish bcl_nino_d901e075:

    # mc_pensamiento "Con ella el ruido es una forma de cuidar a las otras."
    # english: mc_pensamiento "With her, the noise is a way of looking after the others."
    mc_pensamiento "Con ella el ruido es una forma de cuidar a las otras."

# game/02_cap1_beat_casa.rpy:675
translate turkish bcl_miku_e3e3fadb:

    # mc_pensamiento "Miku fue la tercera, y la que menos ruido hizo."
    # english: mc_pensamiento "Miku was the third, and the one who made the least noise."
    mc_pensamiento "Miku fue la tercera, y la que menos ruido hizo."

# game/02_cap1_beat_casa.rpy:677
translate turkish bcl_miku_3f8a0ac6:

    # mc_pensamiento "Estaba en el sofá, con unos audífonos azules colgando del cuello."
    # english: mc_pensamiento "She was on the sofa, blue headphones hanging around her neck."
    mc_pensamiento "Estaba en el sofá, con unos audífonos azules colgando del cuello."

# game/02_cap1_beat_casa.rpy:679
translate turkish bcl_miku_c87a4f6c:

    # mc_pensamiento "Y un libro de estrategas del Sengoku."
    # english: mc_pensamiento "And a book on Sengoku strategists."
    mc_pensamiento "Y un libro de estrategas del Sengoku."

# game/02_cap1_beat_casa.rpy:681
translate turkish bcl_miku_d496b275:

    # mc_pensamiento "Le pregunté si eso eran samuráis y duelos. Dijo «no, es logística» sin levantar la vista."
    # english: mc_pensamiento "I asked if that meant samurai and duels. She said \"no, it's logistics\" without looking up."
    mc_pensamiento "Le pregunté si eso eran samuráis y duelos. Dijo «no, es logística» sin levantar la vista."

# game/02_cap1_beat_casa.rpy:683
translate turkish bcl_miku_791e0a76:

    # mc_pensamiento "«Las batallas las gana quien mueve el arroz.» Y se escondió detrás del libro al darse cuenta."
    # english: mc_pensamiento "\"Battles are won by whoever moves the rice.\" And she hid behind the book once she noticed."
    mc_pensamiento "«Las batallas las gana quien mueve el arroz.» Y se escondió detrás del libro al darse cuenta."

# game/02_cap1_beat_casa.rpy:685
translate turkish bcl_miku_d97c2f14:

    # mc_pensamiento "Esa misma tarde, en la mesa, se subió los audífonos en cuanto saqué las hojas."
    # english: mc_pensamiento "That same afternoon, at the table, she put her headphones on the moment I took out the sheets."
    mc_pensamiento "Esa misma tarde, en la mesa, se subió los audífonos en cuanto saqué las hojas."

# game/02_cap1_beat_casa.rpy:687
translate turkish bcl_miku_213c94d3:

    # mc_pensamiento "Me borró del mapa sin decir una palabra."
    # english: mc_pensamiento "She wiped me off the map without a word."
    mc_pensamiento "Me borró del mapa sin decir una palabra."

# game/02_cap1_beat_casa.rpy:689
translate turkish bcl_miku_36756f33:

    # mc_pensamiento "Al irse se detuvo en el pasillo y dijo «no fue idea mía». Y enseguida pidió perdón."
    # english: mc_pensamiento "On her way out she stopped in the hallway and said \"it wasn't my idea.\" And immediately apologized."
    mc_pensamiento "Al irse se detuvo en el pasillo y dijo «no fue idea mía». Y enseguida pidió perdón."

# game/02_cap1_beat_casa.rpy:691
translate turkish bcl_miku_ab2e9ef1:

    # mc_pensamiento "En su hoja había una marca de goma debajo de la respuesta equivocada."
    # english: mc_pensamiento "On her sheet there was an eraser mark under the wrong answer."
    mc_pensamiento "En su hoja había una marca de goma debajo de la respuesta equivocada."

# game/02_cap1_beat_casa.rpy:693
translate turkish bcl_miku_51da46b8:

    # mc_pensamiento "Escribió la correcta primero. Y la borró."
    # english: mc_pensamiento "She'd written the right one first. And erased it."
    mc_pensamiento "Escribió la correcta primero. Y la borró."

# game/02_cap1_beat_casa.rpy:695
translate turkish bcl_miku_05804292:

    # mc_pensamiento "Fue la única que entendió mi plan antes de que lo dijera: «quiere dividirnos»."
    # english: mc_pensamiento "She was the only one who understood my plan before I said it: \"he wants to divide us.\""
    mc_pensamiento "Fue la única que entendió mi plan antes de que lo dijera: «quiere dividirnos»."

# game/02_cap1_beat_casa.rpy:699
translate turkish bcl_miku_70606fec:

    # mc_pensamiento "En la biblioteca estaba al fondo, de espaldas a la puerta."
    # english: mc_pensamiento "In the library she was at the back, her back to the door."
    mc_pensamiento "En la biblioteca estaba al fondo, de espaldas a la puerta."

# game/02_cap1_beat_casa.rpy:701
translate turkish bcl_miku_5fc8045e:

    # mc_pensamiento "Cuatro libros que no eran del temario, apilados por tamaño y con los lomos alineados."
    # english: mc_pensamiento "Four books that weren't on the syllabus, stacked by size, spines lined up."
    mc_pensamiento "Cuatro libros que no eran del temario, apilados por tamaño y con los lomos alineados."

# game/02_cap1_beat_casa.rpy:703
translate turkish bcl_miku_93483ee4:

    # mc_pensamiento "Los audífonos colgando, apagados. No los lleva para escuchar música."
    # english: mc_pensamiento "Her headphones hanging there, off. She doesn't wear them to listen to music."
    mc_pensamiento "Los audífonos colgando, apagados. No los lleva para escuchar música."

# game/02_cap1_beat_casa.rpy:705
translate turkish bcl_miku_dea1e18f:

    # mc_pensamiento "Los lleva ahí, listos, para el momento en que alguien se acerque."
    # english: mc_pensamiento "She wears them there, ready, for the moment someone comes close."
    mc_pensamiento "Los lleva ahí, listos, para el momento en que alguien se acerque."

# game/02_cap1_beat_casa.rpy:707
translate turkish bcl_miku_2945c748:

    # mc_pensamiento "Esa noche me había leído su libro hasta la página noventa y dos."
    # english: mc_pensamiento "That night I'd read her book up to page ninety-two."
    mc_pensamiento "Esa noche me había leído su libro hasta la página noventa y dos."

# game/02_cap1_beat_casa.rpy:709
translate turkish bcl_miku_dc984030:

    # mc_pensamiento "Se quedó mirando el ejemplar sobre la mesa."
    # english: mc_pensamiento "She stared at the copy on the table."
    mc_pensamiento "Se quedó mirando el ejemplar sobre la mesa."

# game/02_cap1_beat_casa.rpy:711
translate turkish bcl_miku_6a34bf09:

    # mc_pensamiento "Y por fin miró fuera del libro."
    # english: mc_pensamiento "And she finally looked out past the book."
    mc_pensamiento "Y por fin miró fuera del libro."

# game/02_cap1_beat_casa.rpy:713
translate turkish bcl_miku_e08c3b47:

    # mc_pensamiento "Me contó lo de la sal de Takeda Shingen."
    # english: mc_pensamiento "She told me about Takeda Shingen's salt."
    mc_pensamiento "Me contó lo de la sal de Takeda Shingen."

# game/02_cap1_beat_casa.rpy:715
translate turkish bcl_miku_8417e017:

    # mc_pensamiento "Cómo los vecinos dejaron de vendérsela sin mover un soldado."
    # english: mc_pensamiento "How the neighbors stopped selling it to him without a single soldier moving."
    mc_pensamiento "Cómo los vecinos dejaron de vendérsela sin mover un soldado."

# game/02_cap1_beat_casa.rpy:717
translate turkish bcl_miku_4708f284:

    # mc_pensamiento "Hablaba más rápido, sin la pausa de siempre delante de cada frase."
    # english: mc_pensamiento "She spoke faster, without her usual pause before every sentence."
    mc_pensamiento "Hablaba más rápido, sin la pausa de siempre delante de cada frase."

# game/02_cap1_beat_casa.rpy:719
translate turkish bcl_miku_23088420:

    # mc_pensamiento "Y de golpe se oyó a sí misma y dijo «perdón, hablé mucho»."
    # english: mc_pensamiento "And suddenly she heard herself and said \"sorry, I talked a lot.\""
    mc_pensamiento "Y de golpe se oyó a sí misma y dijo «perdón, hablé mucho»."

# game/02_cap1_beat_casa.rpy:723
translate turkish bcl_miku_5dd6f352:

    # mc_pensamiento "Le hice una pregunta concreta y siguió contestando."
    # english: mc_pensamiento "I asked her a specific question and she kept answering."
    mc_pensamiento "Le hice una pregunta concreta y siguió contestando."

# game/02_cap1_beat_casa.rpy:725
translate turkish bcl_miku_f7d52c4b:

    # mc_pensamiento "Cuando fue a disculparse, la corté: eso no se disculpa."
    # english: mc_pensamiento "When she went to apologize, I cut her off: you don't apologize for that."
    mc_pensamiento "Cuando fue a disculparse, la corté: eso no se disculpa."

# game/02_cap1_beat_casa.rpy:727
translate turkish bcl_miku_3da30f2a:

    # mc_pensamiento "Me dijo que lo de la sal estaba en la página ciento veinte."
    # english: mc_pensamiento "She told me the salt part was on page one-twenty."
    mc_pensamiento "Me dijo que lo de la sal estaba en la página ciento veinte."

# game/02_cap1_beat_casa.rpy:729
translate turkish bcl_miku_30af61b2:

    # mc_pensamiento "Al día siguiente me pidió que le avisara al llegar a esa página. Quería ver mi cara."
    # english: mc_pensamiento "The next day she asked me to tell her when I reached that page. She wanted to see my face."
    mc_pensamiento "Al día siguiente me pidió que le avisara al llegar a esa página. Quería ver mi cara."

# game/02_cap1_beat_casa.rpy:733
translate turkish bcl_miku_4e1f443c:

    # mc_pensamiento "Le dije que se le daba bien. Contestó que solo lo había leído."
    # english: mc_pensamiento "I told her she was good at it. She said she'd only read it."
    mc_pensamiento "Le dije que se le daba bien. Contestó que solo lo había leído."

# game/02_cap1_beat_casa.rpy:735
translate turkish bcl_miku_7f630f98:

    # mc_pensamiento "Era un halago, pero sonó a otra etiqueta más."
    # english: mc_pensamiento "It was a compliment, but it sounded like one more label."
    mc_pensamiento "Era un halago, pero sonó a otra etiqueta más."

# game/02_cap1_beat_casa.rpy:737
translate turkish bcl_miku_f0871297:

    # mc_pensamiento "El libro le subió hasta media cara y ahí se quedó."
    # english: mc_pensamiento "The book rose to cover half her face and stayed there."
    mc_pensamiento "El libro le subió hasta media cara y ahí se quedó."

# game/02_cap1_beat_casa.rpy:741
translate turkish bcl_miku_e57ab66e:

    # mc_pensamiento "Le dije que lo de la sal no entraba en el examen."
    # english: mc_pensamiento "I told her the salt part wasn't on the exam."
    mc_pensamiento "Le dije que lo de la sal no entraba en el examen."

# game/02_cap1_beat_casa.rpy:743
translate turkish bcl_miku_e8184be6:

    # mc_pensamiento "No protestó. Recogió sus libros, se subió los audífonos y esta vez sí sonaba la música."
    # english: mc_pensamiento "She didn't protest. She gathered her books, put her headphones on, and this time there was music."
    mc_pensamiento "No protestó. Recogió sus libros, se subió los audífonos y esta vez sí sonaba la música."

# game/02_cap1_beat_casa.rpy:745
translate turkish bcl_miku_3fa98e88:

    # mc_pensamiento "Dijo «hoy no»."
    # english: mc_pensamiento "She said \"not today.\""
    mc_pensamiento "Dijo «hoy no»."

# game/02_cap1_beat_casa.rpy:747
translate turkish bcl_miku_d5cfd54e:

    # mc_pensamiento "Tenía razón en lo del examen, y aun así salí con la sensación de haber hecho algo mal."
    # english: mc_pensamiento "She was right about the exam, and I still left feeling like I'd done something wrong."
    mc_pensamiento "Tenía razón en lo del examen, y aun así salí con la sensación de haber hecho algo mal."

# game/02_cap1_beat_casa.rpy:751
translate turkish bcl_miku_de0f189f:

    # mc_pensamiento "No le falta saber. Eso lo tengo claro."
    # english: mc_pensamiento "She doesn't lack knowledge. That much is clear to me."
    mc_pensamiento "No le falta saber. Eso lo tengo claro."

# game/02_cap1_beat_casa.rpy:753
translate turkish bcl_miku_6691328c:

    # mc_pensamiento "Sabe cómo se sostiene un lugar entero y por qué se cae."
    # english: mc_pensamiento "She knows how a whole place holds together and why it falls."
    mc_pensamiento "Sabe cómo se sostiene un lugar entero y por qué se cae."

# game/02_cap1_beat_casa.rpy:755
translate turkish bcl_miku_f814695f:

    # mc_pensamiento "Lo cuenta como si lo hubiera vivido."
    # english: mc_pensamiento "She tells it like she lived it."
    mc_pensamiento "Lo cuenta como si lo hubiera vivido."

# game/02_cap1_beat_casa.rpy:757
translate turkish bcl_miku_5f9a09ee:

    # mc_pensamiento "Y después borra la respuesta antes de que alguien la lea."
    # english: mc_pensamiento "And then she erases the answer before anyone can read it."
    mc_pensamiento "Y después borra la respuesta antes de que alguien la lea."

# game/02_cap1_beat_casa.rpy:765
translate turkish bcl_miku_f85d060d:

    # mc_pensamiento "A Miku no fui a buscarla a la biblioteca."
    # english: mc_pensamiento "I didn't go looking for Miku at the library."
    mc_pensamiento "A Miku no fui a buscarla a la biblioteca."

# game/02_cap1_beat_casa.rpy:767
translate turkish bcl_miku_6e7a4e48:

    # mc_pensamiento "Pero la recuerdo desde el sofá: los audífonos al cuello y la frase del arroz."
    # english: mc_pensamiento "But I remember her from the sofa: headphones around her neck and the line about the rice."
    mc_pensamiento "Pero la recuerdo desde el sofá: los audífonos al cuello y la frase del arroz."

# game/02_cap1_beat_casa.rpy:769
translate turkish bcl_miku_15a301bb:

    # mc_pensamiento "«Las batallas las gana quien mueve el arroz.» Y detrás del libro."
    # english: mc_pensamiento "\"Battles are won by whoever moves the rice.\" And behind the book."
    mc_pensamiento "«Las batallas las gana quien mueve el arroz.» Y detrás del libro."

# game/02_cap1_beat_casa.rpy:771
translate turkish bcl_miku_97f0f9b7:

    # mc_pensamiento "En su hoja del segundo día, una respuesta correcta borrada a medias."
    # english: mc_pensamiento "On her second-day sheet, a correct answer half erased."
    mc_pensamiento "En su hoja del segundo día, una respuesta correcta borrada a medias."

# game/02_cap1_beat_casa.rpy:773
translate turkish bcl_miku_28a63fd7:

    # mc_pensamiento "Sabía la respuesta y no confió lo bastante en ella para dejarla ahí."
    # english: mc_pensamiento "She knew the answer and didn't trust it enough to leave it there."
    mc_pensamiento "Sabía la respuesta y no confió lo bastante en ella para dejarla ahí."

# game/02_cap1_beat_casa.rpy:775
translate turkish bcl_miku_787374f3:

    # mc_pensamiento "Fue la única que entendió mi plan antes de que lo dijera."
    # english: mc_pensamiento "She was the only one who understood my plan before I said it."
    mc_pensamiento "Fue la única que entendió mi plan antes de que lo dijera."

# game/02_cap1_beat_casa.rpy:777
translate turkish bcl_miku_a42337fd:

    # mc_pensamiento "Después me dijo que así estuvo bien. Pero que habría acertado con el sitio."
    # english: mc_pensamiento "Later she told me it had been fine that way. But that I'd have guessed the right place."
    mc_pensamiento "Después me dijo que así estuvo bien. Pero que habría acertado con el sitio."

# game/02_cap1_beat_casa.rpy:779
translate turkish bcl_miku_e78b5650:

    # mc_pensamiento "Que hay una silla vacía enfrente de la suya."
    # english: mc_pensamiento "That there's an empty chair across from hers."
    mc_pensamiento "Que hay una silla vacía enfrente de la suya."

# game/02_cap1_beat_casa.rpy:781
translate turkish bcl_miku_68edcc73:

    # mc_pensamiento "Y que dejó un libro abierto dos días, por si hacía falta una excusa."
    # english: mc_pensamiento "And that she left a book open for two days, in case someone needed an excuse."
    mc_pensamiento "Y que dejó un libro abierto dos días, por si hacía falta una excusa."

# game/02_cap1_beat_casa.rpy:783
translate turkish bcl_miku_d4ed348c:

    # mc_pensamiento "Dijo que no pasaba nada. Y pidió perdón por haber sonado triste."
    # english: mc_pensamiento "She said it was nothing. And apologized for sounding sad."
    mc_pensamiento "Dijo que no pasaba nada. Y pidió perdón por haber sonado triste."

# game/02_cap1_beat_casa.rpy:785
translate turkish bcl_miku_ea449114:

    # mc_pensamiento "Es todo un misterio. Y creo que es de las que saben esperar."
    # english: mc_pensamiento "She's a complete mystery. And I think she's the kind who knows how to wait."
    mc_pensamiento "Es todo un misterio. Y creo que es de las que saben esperar."

# game/02_cap1_beat_casa.rpy:806
translate turkish bcl_yotsuba_7da6879e:

    # mc_pensamiento "Yotsuba pasó por mi lado corriendo antes de que pudiera reaccionar."
    # english: mc_pensamiento "Yotsuba ran past me before I could react."
    mc_pensamiento "Yotsuba pasó por mi lado corriendo antes de que pudiera reaccionar."

# game/02_cap1_beat_casa.rpy:808
translate turkish bcl_yotsuba_21b9a470:

    # mc_pensamiento "Se frenó a medio metro, con una sonrisa que ocupaba media habitación."
    # english: mc_pensamiento "She stopped a few feet away, with a smile that filled half the room."
    mc_pensamiento "Se frenó a medio metro, con una sonrisa que ocupaba media habitación."

# game/02_cap1_beat_casa.rpy:810
translate turkish bcl_yotsuba_092764fb:

    # mc_pensamiento "«¡Vas a hacerlo genial! ...¿Verdad?» Esa última palabra le salió medio tono más baja."
    # english: mc_pensamiento "\"You're going to do great! ...Right?\" That last word came out half a tone lower."
    mc_pensamiento "«¡Vas a hacerlo genial! ...¿Verdad?» Esa última palabra le salió medio tono más baja."

# game/02_cap1_beat_casa.rpy:812
translate turkish bcl_yotsuba_44221391:

    # mc_pensamiento "Y se corrigió al instante: «¡Digo, claro que sí!»"
    # english: mc_pensamiento "And she corrected herself at once: \"I mean, of course you will!\""
    mc_pensamiento "Y se corrigió al instante: «¡Digo, claro que sí!»"

# game/02_cap1_beat_casa.rpy:814
translate turkish bcl_yotsuba_34b266d9:

    # mc_pensamiento "Esa primera tarde escribió su nombre en la hoja con un entusiasmo desmedido. Solo su nombre."
    # english: mc_pensamiento "That first afternoon she wrote her name on the sheet with outsized enthusiasm. Just her name."
    mc_pensamiento "Esa primera tarde escribió su nombre en la hoja con un entusiasmo desmedido. Solo su nombre."

# game/02_cap1_beat_casa.rpy:816
translate turkish bcl_yotsuba_0258d507:

    # mc_pensamiento "Después pidió perdón unas diez veces por ver cómo las demás se iban."
    # english: mc_pensamiento "Then she apologized about ten times for watching the others walk out."
    mc_pensamiento "Después pidió perdón unas diez veces por ver cómo las demás se iban."

# game/02_cap1_beat_casa.rpy:818
translate turkish bcl_yotsuba_f9b6ff1a:

    # mc_pensamiento "Al día siguiente intentó defenderme delante de Nino."
    # english: mc_pensamiento "The next day she tried to defend me in front of Nino."
    mc_pensamiento "Al día siguiente intentó defenderme delante de Nino."

# game/02_cap1_beat_casa.rpy:820
translate turkish bcl_yotsuba_d2e53809:

    # mc_pensamiento "«Él solo está...» «Yotsuba.» «...No dije nada.»"
    # english: mc_pensamiento "\"He's just...\" \"Yotsuba.\" \"...I didn't say anything.\""
    mc_pensamiento "«Él solo está...» «Yotsuba.» «...No dije nada.»"

# game/02_cap1_beat_casa.rpy:822
translate turkish bcl_yotsuba_6acb56f0:

    # mc_pensamiento "Se puso a alinear los bordes de su hoja, como si eso fuera una tarea."
    # english: mc_pensamiento "She started lining up the edges of her sheet, like that was a task."
    mc_pensamiento "Se puso a alinear los bordes de su hoja, como si eso fuera una tarea."

# game/02_cap1_beat_casa.rpy:826
translate turkish bcl_yotsuba_25a977ce:

    # mc_pensamiento "La encontré en la pista, mucho después de que el club se fuera a casa."
    # english: mc_pensamiento "I found her at the track, long after the club had gone home."
    mc_pensamiento "La encontré en la pista, mucho después de que el club se fuera a casa."

# game/02_cap1_beat_casa.rpy:828
translate turkish bcl_yotsuba_9a3eb768:

    # mc_pensamiento "Contaba las vueltas en voz alta y se animaba sola."
    # english: mc_pensamiento "She counted the laps out loud and cheered herself on."
    mc_pensamiento "Contaba las vueltas en voz alta y se animaba sola."

# game/02_cap1_beat_casa.rpy:830
translate turkish bcl_yotsuba_eb59a1cc:

    # mc_pensamiento "Llevaba la cuenta anotada en la muñeca con rotulador. Si no, pierde el número."
    # english: mc_pensamiento "She kept the count in marker on her wrist. Otherwise, she loses the number."
    mc_pensamiento "Llevaba la cuenta anotada en la muñeca con rotulador. Si no, pierde el número."

# game/02_cap1_beat_casa.rpy:832
translate turkish bcl_yotsuba_d6aa7145:

    # mc_pensamiento "Primero dijo 25 series. Después, 30."
    # english: mc_pensamiento "First she said 25 sets. Then 30."
    mc_pensamiento "Primero dijo 25 series. Después, 30."

# game/02_cap1_beat_casa.rpy:834
translate turkish bcl_yotsuba_0247550a:

    # mc_pensamiento "Dijo que sus hermanas son mejores que ella en casi todo."
    # english: mc_pensamiento "She said her sisters are better than her at almost everything."
    mc_pensamiento "Dijo que sus hermanas son mejores que ella en casi todo."

# game/02_cap1_beat_casa.rpy:836
translate turkish bcl_yotsuba_070a0416:

    # mc_pensamiento "«Yo corro y animo.» Lo dijo sonriendo, como quien dice que va a llover."
    # english: mc_pensamiento "\"I run and cheer.\" She said it smiling, like someone saying it's going to rain."
    mc_pensamiento "«Yo corro y animo.» Lo dijo sonriendo, como quien dice que va a llover."

# game/02_cap1_beat_casa.rpy:840
translate turkish bcl_yotsuba_9dfda34a:

    # mc_pensamiento "Le conté lo que yo había notado."
    # english: mc_pensamiento "I told her what I'd noticed."
    mc_pensamiento "Le conté lo que yo había notado."

# game/02_cap1_beat_casa.rpy:842
translate turkish bcl_yotsuba_821a3b62:

    # mc_pensamiento "Que supo que Nino no había dormido antes de que Nino dijera nada."
    # english: mc_pensamiento "That she knew Nino hadn't slept before Nino said anything."
    mc_pensamiento "Que supo que Nino no había dormido antes de que Nino dijera nada."

# game/02_cap1_beat_casa.rpy:844
translate turkish bcl_yotsuba_1b996351:

    # mc_pensamiento "Que sabía dónde dejaba Miku su libro, y que bajaba la voz cuando Ichika se dormía."
    # english: mc_pensamiento "That she knew where Miku left her book, and lowered her voice when Ichika fell asleep."
    mc_pensamiento "Que sabía dónde dejaba Miku su libro, y que bajaba la voz cuando Ichika se dormía."

# game/02_cap1_beat_casa.rpy:846
translate turkish bcl_yotsuba_0c531bc6:

    # mc_pensamiento "Le dije que su punto de partida no era cero. Que nunca lo había sido."
    # english: mc_pensamiento "I told her her starting point wasn't zero. That it never had been."
    mc_pensamiento "Le dije que su punto de partida no era cero. Que nunca lo había sido."

# game/02_cap1_beat_casa.rpy:848
translate turkish bcl_yotsuba_91abd36c:

    # mc_pensamiento "En la vuelta veinticuatro siguió contando en voz alta. El tiempo se lo decía yo."
    # english: mc_pensamiento "On lap twenty-four she kept counting out loud. I was the one calling her time."
    mc_pensamiento "En la vuelta veinticuatro siguió contando en voz alta. El tiempo se lo decía yo."

# game/02_cap1_beat_casa.rpy:850
translate turkish bcl_yotsuba_f91f9a8a:

    # mc_pensamiento "Al día siguiente me escribió un «1» en la muñeca con un corazón torcido. Dijo que era una vuelta."
    # english: mc_pensamiento "The next day she wrote a \"1\" on my wrist with a crooked heart. She said it was one lap."
    mc_pensamiento "Al día siguiente me escribió un «1» en la muñeca con un corazón torcido. Dijo que era una vuelta."

# game/02_cap1_beat_casa.rpy:854
translate turkish bcl_yotsuba_9eff3bb3:

    # mc_pensamiento "Le tomé el tiempo: 1:17."
    # english: mc_pensamiento "I timed her: 1:17."
    mc_pensamiento "Le tomé el tiempo: 1:17."

# game/02_cap1_beat_casa.rpy:856
translate turkish bcl_yotsuba_cb5d9f6f:

    # mc_pensamiento "Se rió, esquivó el tema y dijo que sus piernas le hablan en un idioma secreto."
    # english: mc_pensamiento "She laughed, dodged the subject, and said her legs talk to her in a secret language."
    mc_pensamiento "Se rió, esquivó el tema y dijo que sus piernas le hablan en un idioma secreto."

# game/02_cap1_beat_casa.rpy:858
translate turkish bcl_yotsuba_9d915a39:

    # mc_pensamiento "No supe si la ayudé o solo la dejé correr."
    # english: mc_pensamiento "I couldn't tell if I'd helped her or just let her run."
    mc_pensamiento "No supe si la ayudé o solo la dejé correr."

# game/02_cap1_beat_casa.rpy:862
translate turkish bcl_yotsuba_fcecdcf5:

    # mc_pensamiento "Le dije que se concentrara en correr."
    # english: mc_pensamiento "I told her to focus on running."
    mc_pensamiento "Le dije que se concentrara en correr."

# game/02_cap1_beat_casa.rpy:864
translate turkish bcl_yotsuba_ab10fb2a:

    # mc_pensamiento "Asintió con la misma sonrisa y dejó de contar en voz alta."
    # english: mc_pensamiento "She nodded with the same smile and stopped counting out loud."
    mc_pensamiento "Asintió con la misma sonrisa y dejó de contar en voz alta."

# game/02_cap1_beat_casa.rpy:866
translate turkish bcl_yotsuba_35e8422e:

    # mc_pensamiento "Al día siguiente me llamó «tutor», con el tono que se usa con un desconocido."
    # english: mc_pensamiento "The next day she called me \"tutor,\" in the tone you use with a stranger."
    mc_pensamiento "Al día siguiente me llamó «tutor», con el tono que se usa con un desconocido."

# game/02_cap1_beat_casa.rpy:868
translate turkish bcl_yotsuba_fadd42c6:

    # mc_pensamiento "Le di la razón en lo peor que cree de sí misma."
    # english: mc_pensamiento "I agreed with the worst thing she believes about herself."
    mc_pensamiento "Le di la razón en lo peor que cree de sí misma."

# game/02_cap1_beat_casa.rpy:870
translate turkish bcl_yotsuba_45f8b50a:

    # mc_pensamiento "Cuando me fui, ya había vuelto a la pista. No se despidió, ninguno de los dos lo hizo."
    # english: mc_pensamiento "When I left, she'd already gone back to the track. She didn't say goodbye, and neither did I."
    mc_pensamiento "Cuando me fui, ya había vuelto a la pista. No se despidió, ninguno de los dos lo hizo."

# game/02_cap1_beat_casa.rpy:874
translate turkish bcl_yotsuba_f500e5c0:

    # mc_pensamiento "Y sin embargo hay algo que sí lee, y lo lee mejor que yo."
    # english: mc_pensamiento "And yet there's something she does read, and she reads it better than I do."
    mc_pensamiento "Y sin embargo hay algo que sí lee, y lo lee mejor que yo."

# game/02_cap1_beat_casa.rpy:876
translate turkish bcl_yotsuba_6992a909:

    # mc_pensamiento "Sabe quién no durmió, quién busca algo y quién necesita silencio, sin que se lo digan."
    # english: mc_pensamiento "She knows who didn't sleep, who's looking for something, and who needs quiet, without being told."
    mc_pensamiento "Sabe quién no durmió, quién busca algo y quién necesita silencio, sin que se lo digan."

# game/02_cap1_beat_casa.rpy:878
translate turkish bcl_yotsuba_61d9b41b:

    # mc_pensamiento "Lo hace con cinco personas a la vez, y ni siquiera lo cuenta como un mérito."
    # english: mc_pensamiento "She does it with five people at once, and doesn't even count it as a merit."
    mc_pensamiento "Lo hace con cinco personas a la vez, y ni siquiera lo cuenta como un mérito."

# game/02_cap1_beat_casa.rpy:886
translate turkish bcl_yotsuba_53fd909b:

    # mc_pensamiento "A Yotsuba tampoco fui a buscarla."
    # english: mc_pensamiento "I didn't go looking for Yotsuba either."
    mc_pensamiento "A Yotsuba tampoco fui a buscarla."

# game/02_cap1_beat_casa.rpy:888
translate turkish bcl_yotsuba_a0100973:

    # mc_pensamiento "La conocí corriendo hacia mí, con una sonrisa enorme y un «¿verdad?» medio tono más bajo."
    # english: mc_pensamiento "I met her running toward me, with a huge smile and a \"right?\" half a tone lower."
    mc_pensamiento "La conocí corriendo hacia mí, con una sonrisa enorme y un «¿verdad?» medio tono más bajo."

# game/02_cap1_beat_casa.rpy:890
translate turkish bcl_yotsuba_ded79cf8:

    # mc_pensamiento "El primer día escribió su nombre en la hoja. Solo su nombre."
    # english: mc_pensamiento "The first day she wrote her name on the sheet. Just her name."
    mc_pensamiento "El primer día escribió su nombre en la hoja. Solo su nombre."

# game/02_cap1_beat_casa.rpy:892
translate turkish bcl_yotsuba_762f6110:

    # mc_pensamiento "El segundo intentó defenderme y Nino la cortó."
    # english: mc_pensamiento "The second day she tried to defend me and Nino cut her off."
    mc_pensamiento "El segundo intentó defenderme y Nino la cortó."

# game/02_cap1_beat_casa.rpy:894
translate turkish bcl_yotsuba_2b889a37:

    # mc_pensamiento "Cuando le pedí perdón, me dijo de tres maneras distintas que no pasaba nada."
    # english: mc_pensamiento "When I apologized, she told me three different ways that it was fine."
    mc_pensamiento "Cuando le pedí perdón, me dijo de tres maneras distintas que no pasaba nada."

# game/02_cap1_beat_casa.rpy:896
translate turkish bcl_yotsuba_3f59a290:

    # mc_pensamiento "Pero entrenó quince minutos más cada tarde, por si yo iba. Los contó."
    # english: mc_pensamiento "But she trained fifteen extra minutes every afternoon, in case I showed up. She counted them."
    mc_pensamiento "Pero entrenó quince minutos más cada tarde, por si yo iba. Los contó."

# game/02_cap1_beat_casa.rpy:898
translate turkish bcl_yotsuba_3086dbe7:

    # mc_pensamiento "«Si nadie me necesita, ¿para qué me sobra tanta energía?»"
    # english: mc_pensamiento "\"If nobody needs me, why do I have so much energy left over?\""
    mc_pensamiento "«Si nadie me necesita, ¿para qué me sobra tanta energía?»"

# game/02_cap1_beat_casa.rpy:900
translate turkish bcl_yotsuba_4516e1c0:

    # mc_pensamiento "Se fue corriendo y, al doblar la esquina, bajó el ritmo."
    # english: mc_pensamiento "She ran off and, rounding the corner, slowed down."
    mc_pensamiento "Se fue corriendo y, al doblar la esquina, bajó el ritmo."

# game/02_cap1_beat_casa.rpy:902
translate turkish bcl_yotsuba_a3de6c14:

    # mc_pensamiento "Sigo sin saber qué hace cuando nadie la mira."
    # english: mc_pensamiento "I still don't know what she does when nobody's watching."
    mc_pensamiento "Sigo sin saber qué hace cuando nadie la mira."

# game/02_cap1_beat_casa.rpy:904
translate turkish bcl_yotsuba_aad3a696:

    # mc_pensamiento "Solo conozco la sonrisa. Se la pone hasta cuando no toca."
    # english: mc_pensamiento "I only know the smile. She puts it on even when it doesn't belong."
    mc_pensamiento "Solo conozco la sonrisa. Se la pone hasta cuando no toca."

# game/02_cap1_beat_casa.rpy:925
translate turkish bcl_itsuki_f796f532:

    # mc_pensamiento "A Itsuki la conocí antes de saber su nombre."
    # english: mc_pensamiento "I met Itsuki before I knew her name."
    mc_pensamiento "A Itsuki la conocí antes de saber su nombre."

# game/02_cap1_beat_casa.rpy:927
translate turkish bcl_itsuki_7fd9a9da:

    # mc_pensamiento "Estaba sentada en mi sitio, almorzando, y me pidió que le enseñara un poco."
    # english: mc_pensamiento "She was sitting in my seat, eating lunch, and asked me to teach her a little."
    mc_pensamiento "Estaba sentada en mi sitio, almorzando, y me pidió que le enseñara un poco."

# game/02_cap1_beat_casa.rpy:929
translate turkish bcl_itsuki_7f7fb01a:

    # mc_pensamiento "Le dije que no. Que aprender es un proceso personal."
    # english: mc_pensamiento "I said no. That learning is a personal process."
    mc_pensamiento "Le dije que no. Que aprender es un proceso personal."

# game/02_cap1_beat_casa.rpy:931
translate turkish bcl_itsuki_67602562:

    # mc_pensamiento "Me devolvió una frase que todavía recuerdo: arrogante y carente de empatía."
    # english: mc_pensamiento "She threw a phrase back at me that I still remember: arrogant, with no empathy."
    mc_pensamiento "Me devolvió una frase que todavía recuerdo: arrogante y carente de empatía."

# game/02_cap1_beat_casa.rpy:933
translate turkish bcl_itsuki_be49ac21:

    # mc_pensamiento "Esa tarde nos cruzamos en la azotea. Nos quedamos en silencio, cada uno en un extremo del banco."
    # english: mc_pensamiento "That afternoon we crossed paths on the rooftop. We sat in silence, each at one end of the bench."
    mc_pensamiento "Esa tarde nos cruzamos en la azotea. Nos quedamos en silencio, cada uno en un extremo del banco."

# game/02_cap1_beat_casa.rpy:935
translate turkish bcl_itsuki_6c788b87:

    # mc_pensamiento "Y por la noche, en la puerta del departamento, descubrí que ella vivía ahí."
    # english: mc_pensamiento "And that night, at the apartment door, I found out she lived there."
    mc_pensamiento "Y por la noche, en la puerta del departamento, descubrí que ella vivía ahí."

# game/02_cap1_beat_casa.rpy:937
translate turkish bcl_itsuki_569a71a7:

    # mc_pensamiento "Dijo que prefería reprobar todos los exámenes antes que recibir una sola clase mía."
    # english: mc_pensamiento "She said she'd rather fail every exam than take a single lesson from me."
    mc_pensamiento "Dijo que prefería reprobar todos los exámenes antes que recibir una sola clase mía."

# game/02_cap1_beat_casa.rpy:939
translate turkish bcl_itsuki_a04918d3:

    # mc_pensamiento "Lo de ese primer día todavía no lo he saldado con ella."
    # english: mc_pensamiento "I still haven't squared things with her over that first day."
    mc_pensamiento "Lo de ese primer día todavía no lo he saldado con ella."

# game/02_cap1_beat_casa.rpy:941
translate turkish bcl_itsuki_36cbf0a0:

    # mc_pensamiento "Al día siguiente me dejó mi asiento libre a propósito. Eso también era un mensaje."
    # english: mc_pensamiento "The next day she left my seat free on purpose. That was a message too."
    mc_pensamiento "Al día siguiente me dejó mi asiento libre a propósito. Eso también era un mensaje."

# game/02_cap1_beat_casa.rpy:943
translate turkish bcl_itsuki_e4a124db:

    # mc_pensamiento "Dijo que no pensaba estudiar conmigo."
    # english: mc_pensamiento "She said she had no intention of studying with me."
    mc_pensamiento "Dijo que no pensaba estudiar conmigo."

# game/02_cap1_beat_casa.rpy:945
translate turkish bcl_itsuki_0b906a2d:

    # mc_pensamiento "Aun así, fue ella quien se inventó el juego de busca y encuentra."
    # english: mc_pensamiento "Even so, she was the one who invented the hide-and-seek game."
    mc_pensamiento "Aun así, fue ella quien se inventó el juego de busca y encuentra."

# game/02_cap1_beat_casa.rpy:947
translate turkish bcl_itsuki_4a591b36:

    # mc_pensamiento "Y dijo que no pensaba esconderse. Que estaría donde siempre."
    # english: mc_pensamiento "And she said she wouldn't hide. That she'd be where she always is."
    mc_pensamiento "Y dijo que no pensaba esconderse. Que estaría donde siempre."

# game/02_cap1_beat_casa.rpy:951
translate turkish bcl_itsuki_a4dc247f:

    # mc_pensamiento "Estaba en el aula vacía, con la luz entrando de lado."
    # english: mc_pensamiento "She was in the empty classroom, the light coming in sideways."
    mc_pensamiento "Estaba en el aula vacía, con la luz entrando de lado."

# game/02_cap1_beat_casa.rpy:953
translate turkish bcl_itsuki_08da3a21:

    # mc_pensamiento "Tenía el lápiz levantado, quieto, y tres respuestas tachadas con la misma cifra al final."
    # english: mc_pensamiento "Her pencil was raised, still, and three answers crossed out with the same figure at the end."
    mc_pensamiento "Tenía el lápiz levantado, quieto, y tres respuestas tachadas con la misma cifra al final."

# game/02_cap1_beat_casa.rpy:955
translate turkish bcl_itsuki_4f999d5c:

    # mc_pensamiento "«El tiempo que hace falta», contestó. Luego lo repitió casi igual. Eso la delató."
    # english: mc_pensamiento "\"As long as it takes,\" she answered. Then she repeated it, almost the same. That gave her away."
    mc_pensamiento "«El tiempo que hace falta», contestó. Luego lo repitió casi igual. Eso la delató."

# game/02_cap1_beat_casa.rpy:957
translate turkish bcl_itsuki_3400efa3:

    # mc_pensamiento "Dijo que las otras podían decir que no lo habían intentado. Que ella no tenía esa excusa."
    # english: mc_pensamiento "She said the others could say they hadn't tried. That she didn't have that excuse."
    mc_pensamiento "Dijo que las otras podían decir que no lo habían intentado. Que ella no tenía esa excusa."

# game/02_cap1_beat_casa.rpy:959
translate turkish bcl_itsuki_2b60dae9:

    # mc_pensamiento "Y enseguida: «olvida lo que dije»."
    # english: mc_pensamiento "And right after: \"forget what I said.\""
    mc_pensamiento "Y enseguida: «olvida lo que dije»."

# game/02_cap1_beat_casa.rpy:961
translate turkish bcl_itsuki_98f655d3:

    # mc_pensamiento "Se hundió sobre el cuaderno, y entendí por qué no le preguntaba a nadie."
    # english: mc_pensamiento "She sank over the notebook, and I understood why she didn't ask anyone."
    mc_pensamiento "Se hundió sobre el cuaderno, y entendí por qué no le preguntaba a nadie."

# game/02_cap1_beat_casa.rpy:963
translate turkish bcl_itsuki_895f0ba8:

    # mc_pensamiento "Preguntarle a sus hermanas era admitir algo. Preguntarme a mí, darme la razón."
    # english: mc_pensamiento "Asking her sisters meant admitting something. Asking me, conceding the point."
    mc_pensamiento "Preguntarle a sus hermanas era admitir algo. Preguntarme a mí, darme la razón."

# game/02_cap1_beat_casa.rpy:965
translate turkish bcl_itsuki_d9a8771f:

    # mc_pensamiento "Sabía resolverlo. Solo arrastraba el mismo error del medio."
    # english: mc_pensamiento "She knew how to solve it. She just kept dragging the same mistake from the middle."
    mc_pensamiento "Sabía resolverlo. Solo arrastraba el mismo error del medio."

# game/02_cap1_beat_casa.rpy:969
translate turkish bcl_itsuki_7b4438d9:

    # mc_pensamiento "Le señalé el segundo paso, sin decirle qué estaba mal."
    # english: mc_pensamiento "I pointed to the second step without telling her what was wrong."
    mc_pensamiento "Le señalé el segundo paso, sin decirle qué estaba mal."

# game/02_cap1_beat_casa.rpy:971
translate turkish bcl_itsuki_112cfc8b:

    # mc_pensamiento "Lo encontró ella sola: «la unidad no se cancela ahí»."
    # english: mc_pensamiento "She found it herself: \"the unit doesn't cancel there.\""
    mc_pensamiento "Lo encontró ella sola: «la unidad no se cancela ahí»."

# game/02_cap1_beat_casa.rpy:973
translate turkish bcl_itsuki_1b17f504:

    # mc_pensamiento "No me dio las gracias. Tampoco me pidió que me fuera."
    # english: mc_pensamiento "She didn't thank me. She didn't tell me to leave, either."
    mc_pensamiento "No me dio las gracias. Tampoco me pidió que me fuera."

# game/02_cap1_beat_casa.rpy:975
translate turkish bcl_itsuki_b7bd90f3:

    # mc_pensamiento "Al día siguiente me contó que había rehecho el ejercicio desde el principio."
    # english: mc_pensamiento "The next day she told me she'd redone the exercise from the start."
    mc_pensamiento "Al día siguiente me contó que había rehecho el ejercicio desde el principio."

# game/02_cap1_beat_casa.rpy:977
translate turkish bcl_itsuki_5bece3f0:

    # mc_pensamiento "Sin mirar la corrección."
    # english: mc_pensamiento "Without looking at the correction."
    mc_pensamiento "Sin mirar la corrección."

# game/02_cap1_beat_casa.rpy:979
translate turkish bcl_itsuki_1825a9f8:

    # mc_pensamiento "Salió bien."
    # english: mc_pensamiento "It came out right."
    mc_pensamiento "Salió bien."

# game/02_cap1_beat_casa.rpy:983
translate turkish bcl_itsuki_dd97f49a:

    # mc_pensamiento "Le ofrecí revisarlo desde el principio y dijo que no antes de saber qué iba a explicarle."
    # english: mc_pensamiento "I offered to go over it from the start and she said no before knowing what I'd explain."
    mc_pensamiento "Le ofrecí revisarlo desde el principio y dijo que no antes de saber qué iba a explicarle."

# game/02_cap1_beat_casa.rpy:985
translate turkish bcl_itsuki_88850266:

    # mc_pensamiento "Cerró el cuaderno un centímetro, lo justo para rechazar la oferta."
    # english: mc_pensamiento "She closed the notebook a centimeter, just enough to refuse the offer."
    mc_pensamiento "Cerró el cuaderno un centímetro, lo justo para rechazar la oferta."

# game/02_cap1_beat_casa.rpy:987
translate turkish bcl_itsuki_8326a132:

    # mc_pensamiento "Al día siguiente dijo que todavía no necesitaba mi ayuda. Y que «todavía» era solo una expresión."
    # english: mc_pensamiento "The next day she said she didn't need my help yet. And that \"yet\" was just a figure of speech."
    mc_pensamiento "Al día siguiente dijo que todavía no necesitaba mi ayuda. Y que «todavía» era solo una expresión."

# game/02_cap1_beat_casa.rpy:991
translate turkish bcl_itsuki_83d90008:

    # mc_pensamiento "Le quité el cuaderno y se lo resolví yo, de pie, con su propio lápiz."
    # english: mc_pensamiento "I took the notebook and solved it for her, standing, with her own pencil."
    mc_pensamiento "Le quité el cuaderno y se lo resolví yo, de pie, con su propio lápiz."

# game/02_cap1_beat_casa.rpy:993
translate turkish bcl_itsuki_45371e65:

    # mc_pensamiento "Rápido y correcto. Y le quité lo único que estaba defendiendo: hacerlo ella sola."
    # english: mc_pensamiento "Fast and correct. And I took the one thing she was defending: doing it herself."
    mc_pensamiento "Rápido y correcto. Y le quité lo único que estaba defendiendo: hacerlo ella sola."

# game/02_cap1_beat_casa.rpy:995
translate turkish bcl_itsuki_5f3d484a:

    # mc_pensamiento "Al día siguiente había rehecho todo el ejercicio debajo de mi solución, tachada."
    # english: mc_pensamiento "The next day she'd redone the whole exercise under my solution, crossed out."
    mc_pensamiento "Al día siguiente había rehecho todo el ejercicio debajo de mi solución, tachada."

# game/02_cap1_beat_casa.rpy:997
translate turkish bcl_itsuki_385f0c59:

    # mc_pensamiento "«Lo que hiciste ayer no cuenta. Quería que fuera mío.»"
    # english: mc_pensamiento "\"What you did yesterday doesn't count. I wanted it to be mine.\""
    mc_pensamiento "«Lo que hiciste ayer no cuenta. Quería que fuera mío.»"

# game/02_cap1_beat_casa.rpy:1001
translate turkish bcl_itsuki_77f8ab79:

    # mc_pensamiento "No fui a buscarla al aula."
    # english: mc_pensamiento "I didn't go looking for her at the classroom."
    mc_pensamiento "No fui a buscarla al aula."

# game/02_cap1_beat_casa.rpy:1003
translate turkish bcl_itsuki_e77fe70d:

    # mc_pensamiento "A Itsuki la conocí por un asiento, y ella a mí por arrogante. No le faltó razón."
    # english: mc_pensamiento "I met Itsuki over a seat, and she met me as arrogant. She wasn't wrong."
    mc_pensamiento "A Itsuki la conocí por un asiento, y ella a mí por arrogante. No le faltó razón."

# game/02_cap1_beat_casa.rpy:1005
translate turkish bcl_itsuki_4ebae3ec:

    # mc_pensamiento "Dijo que prefería reprobar todos los exámenes antes que recibir una clase mía."
    # english: mc_pensamiento "She said she'd rather fail every exam than take a lesson from me."
    mc_pensamiento "Dijo que prefería reprobar todos los exámenes antes que recibir una clase mía."

# game/02_cap1_beat_casa.rpy:1007
translate turkish bcl_itsuki_0b906a2d_1:

    # mc_pensamiento "Aun así, fue ella quien se inventó el juego de busca y encuentra."
    # english: mc_pensamiento "Even so, she was the one who invented the hide-and-seek game."
    mc_pensamiento "Aun así, fue ella quien se inventó el juego de busca y encuentra."

# game/02_cap1_beat_casa.rpy:1009
translate turkish bcl_itsuki_a399a037:

    # mc_pensamiento "Cuando supo que no la había ido a buscar, dijo que había ganado el juego."
    # english: mc_pensamiento "When she found out I hadn't gone looking for her, she said she'd won the game."
    mc_pensamiento "Cuando supo que no la había ido a buscar, dijo que había ganado el juego."

# game/02_cap1_beat_casa.rpy:1011
translate turkish bcl_itsuki_05aec194:

    # mc_pensamiento "Que tener razón es lo único que siempre le sale bien."
    # english: mc_pensamiento "That being right is the only thing she always does well."
    mc_pensamiento "Que tener razón es lo único que siempre le sale bien."

# game/02_cap1_beat_casa.rpy:1013
translate turkish bcl_itsuki_39afc0d9:

    # mc_pensamiento "Y que, si hubiera ido, no me habría echado. No inmediatamente."
    # english: mc_pensamiento "And that, if I had gone, she wouldn't have thrown me out. Not right away."
    mc_pensamiento "Y que, si hubiera ido, no me habría echado. No inmediatamente."

# game/02_cap1_beat_casa.rpy:1017
translate turkish bcl_itsuki_b2151d78:

    # mc_pensamiento "En la azotea la encontré con el cuaderno cerrado sobre las rodillas."
    # english: mc_pensamiento "On the rooftop I found her with the notebook closed on her knees."
    mc_pensamiento "En la azotea la encontré con el cuaderno cerrado sobre las rodillas."

# game/02_cap1_beat_casa.rpy:1021
translate turkish bcl_itsuki_718a6603:

    # mc_pensamiento "Antes de que lo cerrara alcancé a ver la página: un ejercicio con un círculo a lápiz."
    # english: mc_pensamiento "Before she closed it, I caught the page: an exercise circled in pencil."
