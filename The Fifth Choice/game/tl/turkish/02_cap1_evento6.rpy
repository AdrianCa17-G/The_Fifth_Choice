    # mc_pensamiento "No hacía falta: cinco caras que ya no fingían nada."
    # english: mc_pensamiento "I didn't need to: five faces that weren't pretending anything anymore."
    mc_pensamiento "No hacía falta: cinco caras que ya no fingían nada."

# game/02_cap1_evento6.rpy:4182
translate turkish e6_mesa_4e5ec988:

    # mc_pensamiento "Ya me sentía parte de ellas."
    # english: mc_pensamiento "I already felt like part of them."
    mc_pensamiento "Ya me sentía parte de ellas."

# game/02_cap1_evento6.rpy:4196
translate turkish e6_casa_909e3643:

    # narrador "Me despedí de todas y volví a casa."
    # english: narrador "I said goodbye to everyone and went home."
    narrador "Me despedí de todas y volví a casa."

# game/02_cap1_evento6.rpy:4198
translate turkish e6_casa_a0d0075f:

    # narrador "Seguía teniendo trabajo. No fue lo primero que pensé al salir."
    # english: narrador "I still had work to do. It wasn't the first thing I thought of on my way out."
    narrador "Seguía teniendo trabajo. No fue lo primero que pensé al salir."

# game/02_cap1_evento6.rpy:4207
translate turkish e6_casa_0bd90d96:

    # narrador "Al llegar, alguien me estaba esperando, y yo también quería verla."
    # english: narrador "When I got there, someone was waiting for me, and I wanted to see her too."
    narrador "Al llegar, alguien me estaba esperando, y yo también quería verla."

# game/02_cap1_evento6.rpy:4209
translate turkish e6_casa_1b140060:

    # mc_pensamiento "Mi hermana Raiha. La primera que dijo que yo podía con las cinco."
    # english: mc_pensamiento "My sister Raiha. The first one who said I could handle all five."
    mc_pensamiento "Mi hermana Raiha. La primera que dijo que yo podía con las cinco."

# game/02_cap1_evento6.rpy:4211
translate turkish e6_casa_9bd431eb:

    # mc_pensamiento "Una de las razones por las que acepté el trabajo cuando no sabía qué decidir."
    # english: mc_pensamiento "One of the reasons I took the job when I didn't know what to decide."
    mc_pensamiento "Una de las razones por las que acepté el trabajo cuando no sabía qué decidir."

# game/02_cap1_evento6.rpy:4213
translate turkish e6_casa_17a3a1b8:

    # narrador "El curry se olía por toda la casa."
    # english: narrador "The smell of curry filled the whole house."
    narrador "El curry se olía por toda la casa."

# game/02_cap1_evento6.rpy:4219
translate turkish e6_casa_14186eab:

    # raiha "¡Hermanito! Hice curry antes de saber cómo te iba a ir."
    # english: raiha "[mc]! I made curry before I knew how it'd go for you."
    raiha "¡Hermanito! Hice curry antes de saber cómo te iba a ir."

# game/02_cap1_evento6.rpy:4221
translate turkish e6_casa_eff74ae5:

    # raiha "Así, como te haya ido, la cena ya está hecha. ¡El curry nunca falla!"
    # english: raiha "That way, however it went, dinner's already done. Curry never fails!"
    raiha "Así, como te haya ido, la cena ya está hecha. ¡El curry nunca falla!"

# game/02_cap1_evento6.rpy:4223
translate turkish e6_casa_055551de:

    # mc "Pues hoy comeremos un banquete, ¿no crees, Raiha?"
    # english: mc "Well, today we're having a feast, don't you think, Raiha?"
    mc "Pues hoy comeremos un banquete, ¿no crees, Raiha?"

# game/02_cap1_evento6.rpy:4225
translate turkish e6_casa_73f0d494:

    # mc "¡¡Aprobaron las cinco!!"
    # english: mc "All five passed!!"
    mc "¡¡Aprobaron las cinco!!"

# game/02_cap1_evento6.rpy:4227
translate turkish e6_casa_a01e577a:

    # raiha "...¿Las cinco?"
    # english: raiha "...All five?"
    raiha "...¿Las cinco?"

# game/02_cap1_evento6.rpy:4229
translate turkish e6_casa_1da5f597:

    # mc "Las cinco."
    # english: mc "All five."
    mc "Las cinco."

# game/02_cap1_evento6.rpy:4231
translate turkish e6_casa_cd763e44:

    # raiha "¡¡LAS CINCO!!"
    # english: raiha "ALL FIVE!!"
    raiha "¡¡LAS CINCO!!"

# game/02_cap1_evento6.rpy:4233
translate turkish e6_casa_20a22bba:

    # raiha "¡Te dije que podías con cinco a la vez!"
    # english: raiha "I told you you could handle five at once!"
    raiha "¡Te dije que podías con cinco a la vez!"

# game/02_cap1_evento6.rpy:4235
translate turkish e6_casa_9f4cfeb7:

    # mc "Me lo dijiste con voz de «ojalá»."
    # english: mc "You said it in an \"I hope so\" voice."
    mc "Me lo dijiste con voz de «ojalá»."

# game/02_cap1_evento6.rpy:4237
translate turkish e6_casa_7770338c:

    # mc "Aunque te perdono porque también dudaba de mí en ese momento."
    # english: mc "But I forgive you, because I doubted myself at the time too."
    mc "Aunque te perdono porque también dudaba de mí en ese momento."

# game/02_cap1_evento6.rpy:4239
translate turkish e6_casa_d0a40ae7:

    # raiha "¡Pero la voz de «ojalá» también cuenta!"
    # english: raiha "But the \"I hope so\" voice counts too!"
    raiha "¡Pero la voz de «ojalá» también cuenta!"

# game/02_cap1_evento6.rpy:4245
translate turkish e6_casa_c5176142:

    # isanari "Mira nada más. El tutor que sobrevivió a las cinco hijas de Maruo."
    # english: isanari "Well, look at that. The tutor who survived all five of Maruo's daughters."
    isanari "Mira nada más. El tutor que sobrevivió a las cinco hijas de Maruo."

# game/02_cap1_evento6.rpy:4247
translate turkish e6_casa_51444c93:

    # isanari "Maruo llamó. Cobramos el mes entero."
    # english: isanari "Maruo called. We get paid for the whole month."
    isanari "Maruo llamó. Cobramos el mes entero."

# game/02_cap1_evento6.rpy:4249
translate turkish e6_casa_cb4f3f26:

    # isanari "Dijo algo más, pero no te lo repito. Se te subiría a la cabeza."
    # english: isanari "He said something else, but I'm not repeating it. It'd go to your head."
    isanari "Dijo algo más, pero no te lo repito. Se te subiría a la cabeza."

# game/02_cap1_evento6.rpy:4251
translate turkish e6_casa_50d8828a:

    # mc "Lo sé."
    # english: mc "I know."
    mc "Lo sé."

# game/02_cap1_evento6.rpy:4253
translate turkish e6_casa_e80cccaa:

    # isanari "Pareces menos contento de lo que dice el pago."
    # english: isanari "You look less happy than the payment says you should."
    isanari "Pareces menos contento de lo que dice el pago."

# game/02_cap1_evento6.rpy:4255
translate turkish e6_casa_356a5a1a:

    # mc "No estoy menos contento. Estoy pensando en otra cosa."
    # english: mc "I'm not less happy. I'm thinking about something else."
    mc "No estoy menos contento. Estoy pensando en otra cosa."

# game/02_cap1_evento6.rpy:4257
translate turkish e6_casa_454e32f3:

    # isanari "¿Qué cosa vale más que cinco veces la tarifa?"
    # english: isanari "What's worth more than five times the going rate?"
    isanari "¿Qué cosa vale más que cinco veces la tarifa?"

# game/02_cap1_evento6.rpy:4259
translate turkish e6_casa_e1c944ba:

    # mc "Todavía no lo sé."
    # english: mc "I don't know yet."
    mc "Todavía no lo sé."

# game/02_cap1_evento6.rpy:4261
translate turkish e6_casa_66c8469c:

    # narrador "Mi padre no dijo nada. Se quedó mirando su plato."
    # english: narrador "My father didn't say anything. He stayed there looking at his plate."
    narrador "Mi padre no dijo nada. Se quedó mirando su plato."

# game/02_cap1_evento6.rpy:4267
translate turkish e6_casa_801c1670:

    # raiha "¡A comer! ¡Que se enfría!"
    # english: raiha "Time to eat! It's getting cold!"
    raiha "¡A comer! ¡Que se enfría!"

# game/02_cap1_evento6.rpy:4269
translate turkish e6_casa_5ca7bee3:

    # mc_pensamiento "Hace un mes, «cinco veces la tarifa» era lo único que oía en esa frase."
    # english: mc_pensamiento "A month ago, \"five times the rate\" was all I heard."
    mc_pensamiento "Hace un mes, «cinco veces la tarifa» era lo único que oía en esa frase."

# game/02_cap1_evento6.rpy:4271
translate turkish e6_casa_45888c15:

    # mc_pensamiento "Esta noche casi ni la escuché."
    # english: mc_pensamiento "Tonight I barely heard it."
    mc_pensamiento "Esta noche casi ni la escuché."

# game/02_cap1_evento6.rpy:4273
translate turkish e6_casa_08c5a4c2:

    # mc "Gracias por la comida."
    # english: mc "Thanks for the food."
    mc "Gracias por la comida."

# game/02_cap1_evento6.rpy:4275
translate turkish e6_casa_81944acc:

    # narrador "Lo dije por costumbre. Pero esta vez lo decía en serio."
    # english: narrador "I said it out of habit. But this time I meant it."
    narrador "Lo dije por costumbre. Pero esta vez lo decía en serio."

# game/02_cap1_evento6.rpy:4277
translate turkish e6_casa_d3eed548:

    # mc_pensamiento "Hace un mes, «todo» era una deuda y una hermana pequeña."
    # english: mc_pensamiento "A month ago, \"everything\" was a debt and a little sister."
    mc_pensamiento "Hace un mes, «todo» era una deuda y una hermana pequeña."

# game/02_cap1_evento6.rpy:4279
translate turkish e6_casa_1e534e22:

    # mc_pensamiento "Ahora hay cinco personas más. Y no salen en ninguna factura."
    # english: mc_pensamiento "Now there are five more people. And they don't show up on any bill."
    mc_pensamiento "Ahora hay cinco personas más. Y no salen en ninguna factura."

# game/02_cap1_evento6.rpy:4300
translate turkish e6_cuarto_8db134a4:

    # narrador "El celular empezó a vibrar antes de que terminara de sentarme."
    # english: narrador "The phone started buzzing before I'd finished sitting down."
    narrador "El celular empezó a vibrar antes de que terminara de sentarme."

# game/02_cap1_evento6.rpy:4307
translate turkish e6_cuarto_8dc24d90:

    # narrador "El grupo seguía llamándose «¡Equipo Quintillizas + Tutor!». Yotsuba nunca lo cambió."
    # english: narrador "The group was still called \"Team Quintuplets + Tutor!\" Yotsuba never changed it."
    narrador "El grupo seguía llamándose «¡Equipo Quintillizas + Tutor!». Yotsuba nunca lo cambió."

# game/02_cap1_evento6.rpy:4309
translate turkish e6_cuarto_156cecc3:

    # narrador "Nino no se había salido. Ni una vez en toda la semana de exámenes."
    # english: narrador "Nino hadn't left it. Not once, the whole exam week."
    narrador "Nino no se había salido. Ni una vez en toda la semana de exámenes."

# game/02_cap1_evento6.rpy:4311
translate turkish e6_cuarto_0a225213:

    # mc_pensamiento "No contesté. Cualquier cosa que escribiera iba a ser menos que lo que acababa de leer."
    # english: mc_pensamiento "I didn't reply. Anything I wrote would be less than what I'd just read."
    mc_pensamiento "No contesté. Cualquier cosa que escribiera iba a ser menos que lo que acababa de leer."

# game/02_cap1_evento6.rpy:4319
translate turkish e6_cuarto_8c9960a8:

    # mc_pensamiento "Hay algo que sé hacer sin que nadie me enseñe: sumar."
    # english: mc_pensamiento "There's one thing I know how to do without anyone teaching me: add."
    mc_pensamiento "Hay algo que sé hacer sin que nadie me enseñe: sumar."

# game/02_cap1_evento6.rpy:4324
translate turkish e6_cuarto_eac3bf4e:

    # mc_pensamiento "Tomé la nota más alta de cada una."
    # english: mc_pensamiento "I took the highest grade from each of them."
    mc_pensamiento "Tomé la nota más alta de cada una."

# game/02_cap1_evento6.rpy:4326
translate turkish e6_cuarto_e0f2010e:

    # mc_pensamiento "Japonés, matemáticas, inglés, ciencias, sociales. Cien, cien, cien, cien, cien."
    # english: mc_pensamiento "Japanese, math, English, science, social studies. 100, 100, 100, 100, 100."
    mc_pensamiento "Japonés, matemáticas, inglés, ciencias, sociales. Cien, cien, cien, cien, cien."

# game/02_cap1_evento6.rpy:4330
translate turkish e6_cuarto_ed137c6c:

    # mc_pensamiento "Cinco notas perfectas en cinco materias distintas. Esa diagonal lo delata."
    # english: mc_pensamiento "Five perfect grades in five different subjects. That diagonal gives it away."
    mc_pensamiento "Cinco notas perfectas en cinco materias distintas. Esa diagonal lo delata."

# game/02_cap1_evento6.rpy:4332
translate turkish e6_cuarto_91b0114b:

    # mc_pensamiento "Un boletín perfecto. De un alumno que no existe."
    # english: mc_pensamiento "A perfect report card. From a student who doesn't exist."
    mc_pensamiento "Un boletín perfecto. De un alumno que no existe."

# game/02_cap1_evento6.rpy:4336
translate turkish e6_cuarto_7c3e6dec:

    # mc_pensamiento "Existe, pero repartido: cada una guarda lo que a las otras cuatro les falta."
    # english: mc_pensamiento "They exist, but split up: each one keeps what the other four lack."
    mc_pensamiento "Existe, pero repartido: cada una guarda lo que a las otras cuatro les falta."

# game/02_cap1_evento6.rpy:4338
translate turkish e6_cuarto_4c373b04:

    # mc_pensamiento "Y en todo el mes no se habían preguntado nada entre ellas."
    # english: mc_pensamiento "And in a whole month, they'd never asked each other for anything."
    mc_pensamiento "Y en todo el mes no se habían preguntado nada entre ellas."

# game/02_cap1_evento6.rpy:4340
translate turkish e6_cuarto_56cae7d0:

    # mc_pensamiento "No controlé ninguna de esas cinco notas."
    # english: mc_pensamiento "I didn't control any of those five grades."
    mc_pensamiento "No controlé ninguna de esas cinco notas."

# game/02_cap1_evento6.rpy:4342
translate turkish e6_cuarto_69e2ec37:

    # mc_pensamiento "Lo único que controlé fue a dónde fui."
    # english: mc_pensamiento "The only thing I controlled was where I went."
    mc_pensamiento "Lo único que controlé fue a dónde fui."

# game/02_cap1_evento6.rpy:4344
translate turkish e6_cuarto_4e2e7f22:

    # mc_pensamiento "Y a dónde no."
    # english: mc_pensamiento "And where I didn't."
    mc_pensamiento "Y a dónde no."

# game/02_cap1_evento6.rpy:4346
translate turkish e6_cuarto_89bfa230:

    # mc_pensamiento "Cinco hojas en fila. Cinco notas de cien. Cada cien, de una persona distinta."
    # english: mc_pensamiento "Five sheets in a row. Five grades of a hundred. Each hundred from a different person."
    mc_pensamiento "Cinco hojas en fila. Cinco notas de cien. Cada cien, de una persona distinta."

# game/02_cap1_evento6.rpy:4348
translate turkish e6_cuarto_53abe3e6:

    # mc_pensamiento "Y ahí estaba la respuesta que llevaba un mes buscando."
    # english: mc_pensamiento "And there was the answer I'd been looking for all month."
    mc_pensamiento "Y ahí estaba la respuesta que llevaba un mes buscando."

# game/02_cap1_evento6.rpy:4350
translate turkish e6_cuarto_7cd9ffb5:

    # mc_pensamiento "Cada una, sola, es una quinta parte. Brillante, pero una parte."
    # english: mc_pensamiento "Each one alone is a fifth. Brilliant, but a part."
    mc_pensamiento "Cada una, sola, es una quinta parte. Brillante, pero una parte."

# game/02_cap1_evento6.rpy:4352
translate turkish e6_cuarto_e0c26510:

    # mc_pensamiento "Juntas son lo que ninguna sería sola: un estudiante perfecto. Capaz de cualquier cosa."
    # english: mc_pensamiento "Together they're what none of them could be alone: one perfect student. Capable of anything."
    mc_pensamiento "Juntas son lo que ninguna sería sola: un estudiante perfecto. Capaz de cualquier cosa."

# game/02_cap1_evento6.rpy:4354
translate turkish e6_cuarto_01ea94b7:

    # mc_pensamiento "Yo creí que mi trabajo era enseñarles a estudiar."
    # english: mc_pensamiento "I thought my job was to teach them how to study."
    mc_pensamiento "Yo creí que mi trabajo era enseñarles a estudiar."

# game/02_cap1_evento6.rpy:4356
translate turkish e6_cuarto_2f965c36:

    # mc_pensamiento "Mi trabajo era conseguir que, por fin, se miraran entre ellas."
    # english: mc_pensamiento "My job was to get them to finally look at each other."
    mc_pensamiento "Mi trabajo era conseguir que, por fin, se miraran entre ellas."

# game/02_cap1_evento6.rpy:4365
translate turkish e6_cuarto_c1167c66:

    # narrador "Abrí la libreta por la página de los cinco nombres. Seguía la frase de aquella noche."
    # english: narrador "I opened the notebook to the page with the five names. The sentence from that night was still there."
    narrador "Abrí la libreta por la página de los cinco nombres. Seguía la frase de aquella noche."

# game/02_cap1_evento6.rpy:4367
translate turkish e6_cuarto_a5989fb9:

    # mc_pensamiento "«De frente y las cinco a la vez, pierdo siempre.»"
    # english: mc_pensamiento "\"Head-on, all five at once, I always lose.\""
    mc_pensamiento "«De frente y las cinco a la vez, pierdo siempre.»"

# game/02_cap1_evento6.rpy:4369
translate turkish e6_cuarto_fb92fc29:

    # narrador "Debajo escribí otra. La letra me salió más firme que la primera vez."
    # english: narrador "Underneath I wrote another one. My handwriting came out steadier than the first time."
    narrador "Debajo escribí otra. La letra me salió más firme que la primera vez."

# game/02_cap1_evento6.rpy:4371
translate turkish e6_cuarto_3f9ce2fc:

    # narrador "«De una en una las alcancé. ¿Y de frente, las cinco a la vez?»"
    # english: narrador "\"One at a time, I reached them. And head-on, all five at once?\""
    narrador "«De una en una las alcancé. ¿Y de frente, las cinco a la vez?»"

# game/02_cap1_evento6.rpy:4381
translate turkish e6_cuarto_676c1662:

    # narrador "Y debajo, más chico, dos nombres: [e6_p1!t] y [e6_p2!t]."
    # english: narrador "And below, smaller, two names: [e6_p1!t] and [e6_p2!t]."
    narrador "Y debajo, más chico, dos nombres: [e6_p1!t] y [e6_p2!t]."

# game/02_cap1_evento6.rpy:4383
translate turkish e6_cuarto_2221951f:

    # mc_pensamiento "Dos promesas hechas sin que nadie me las pidiera."
    # english: mc_pensamiento "Two promises made without anyone asking me to."
    mc_pensamiento "Dos promesas hechas sin que nadie me las pidiera."

# game/02_cap1_evento6.rpy:4385
translate turkish e6_cuarto_0a996f07:

    # mc_pensamiento "Esas sí las voy a cumplir."
    # english: mc_pensamiento "Those ones I'm going to keep."
    mc_pensamiento "Esas sí las voy a cumplir."

# game/02_cap1_evento6.rpy:4402
translate turkish e6_s3_superado_fed68ca2:

    # mc_pensamiento "Maruo dijo «cinco». No dijo «para siempre»."
    # english: mc_pensamiento "Maruo said \"five.\" He didn't say \"forever.\""
    mc_pensamiento "Maruo dijo «cinco». No dijo «para siempre»."

# game/02_cap1_evento6.rpy:4404
translate turkish e6_s3_superado_7e04661e:

    # mc_pensamiento "La condición sigue en pie para la próxima."
    # english: mc_pensamiento "The condition still stands for next time."
    mc_pensamiento "La condición sigue en pie para la próxima."

# game/02_cap1_evento6.rpy:4406
translate turkish e6_s3_superado_87d3c0e4:

    # mc_pensamiento "Esta vez, un punto de margen. ¿Cuántos tendré la próxima?"
    # english: mc_pensamiento "This time, a one-point margin. How many will I have next time?"
    mc_pensamiento "Esta vez, un punto de margen. ¿Cuántos tendré la próxima?"

# game/02_cap1_evento6.rpy:4413
translate turkish e6_s3_mixto_215dba1b:

    # mc_pensamiento "Aprobaron las cinco. Lo repasé tres veces, por si el papel cambiaba de opinión."
    # english: mc_pensamiento "All five passed. I went over it three times, in case the paper changed its mind."
    mc_pensamiento "Aprobaron las cinco. Lo repasé tres veces, por si el papel cambiaba de opinión."

# game/02_cap1_evento6.rpy:4415
translate turkish e6_s3_mixto_bfa5ebd1:

    # mc_pensamiento "No sé qué parte fue mía. Tampoco sé a quién preguntárselo."
    # english: mc_pensamiento "I don't know which part was mine. I don't know who to ask, either."
    mc_pensamiento "No sé qué parte fue mía. Tampoco sé a quién preguntárselo."

# game/02_cap1_evento6.rpy:4417
translate turkish e6_s3_mixto_50c363c2:

    # mc_pensamiento "La libreta no tiene una casilla para eso."
    # english: mc_pensamiento "The notebook doesn't have a box for that."
    mc_pensamiento "La libreta no tiene una casilla para eso."

# game/02_cap1_evento6.rpy:4424
translate turkish e6_s3_bueno_60cf30cd:

    # mc_pensamiento "Abrí las fotos sin aguantar la respiración. Hace un mes no sabía hacerlo."
    # english: mc_pensamiento "I opened the photos without holding my breath. A month ago I couldn't."
    mc_pensamiento "Abrí las fotos sin aguantar la respiración. Hace un mes no sabía hacerlo."

# game/02_cap1_evento6.rpy:4426
translate turkish e6_s3_bueno_649b6b24:

    # mc_pensamiento "Los cinco nombres ya no son una lista. Son cinco personas que salieron bien."
    # english: mc_pensamiento "The five names aren't a list anymore. They're five people who made it through."
    mc_pensamiento "Los cinco nombres ya no son una lista. Son cinco personas que salieron bien."

# game/02_cap1_evento6.rpy:4428
translate turkish e6_s3_bueno_cff37ba0:

    # mc_pensamiento "Y como me importan, ya me preocupa lo que viene."
    # english: mc_pensamiento "And because I care about them, I'm already worried about what's next."
