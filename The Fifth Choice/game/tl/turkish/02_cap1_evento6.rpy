# game/02_cap1_evento6.rpy:3289
translate turkish e6_cinco_de3a775f:

    # narrador "Cada una vino a por su boletín. Boca abajo, sin mirarlo."
    # english: narrador "Each one came for her report card. Face down, without looking at it."
