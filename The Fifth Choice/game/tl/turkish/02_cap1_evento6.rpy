# game/02_cap1_evento6.rpy:3281
translate turkish e6_cinco_66c4335f:

    # narrador "No es que no quisieran salir. Están acostumbradas a esperar."
    # english: narrador "It isn't that they didn't want to come out. They're used to waiting."
