translate turkish e6_miku_gesto_tibia_0b09619f:

    # narrador "Escribió la respuesta de rutas sin una sola mención a la sal."
    # english: narrador "She wrote the routes answer without a single mention of salt."
    narrador "Escribió la respuesta de rutas sin una sola mención a la sal."

# game/02_cap1_evento6.rpy:2089
translate turkish e6_miku_gesto_tibia_7b19e26e:

    # narrador "Cada vez que se acercaba a una frase larga, el cuadernillo le subía un poco más."
    # english: narrador "Each time she got near a long sentence, she lifted the booklet a little higher."
    narrador "Cada vez que se acercaba a una frase larga, el cuadernillo le subía un poco más."

# game/02_cap1_evento6.rpy:2091
translate turkish e6_miku_gesto_tibia_5b019055:

    # mc_pensamiento "Sabía cómo seguir. Se le veía en el lápiz, que dudaba justo antes de cada coma."
    # english: mc_pensamiento "She knew how to go on. You could see it in the pencil, which hesitated right before every comma."
    mc_pensamiento "Sabía cómo seguir. Se le veía en el lápiz, que dudaba justo antes de cada coma."

# game/02_cap1_evento6.rpy:2093
translate turkish e6_miku_gesto_tibia_1e49ac00:

    # mc_pensamiento "No borró. Se detuvo."
    # english: mc_pensamiento "She didn't erase. She stopped."
    mc_pensamiento "No borró. Se detuvo."

# game/02_cap1_evento6.rpy:2095
translate turkish e6_miku_gesto_tibia_f80606ca:

    # mc_pensamiento "Para el caso, es lo mismo que borrar."
    # english: mc_pensamiento "It amounts to the same as erasing."
    mc_pensamiento "Para el caso, es lo mismo que borrar."

# game/02_cap1_evento6.rpy:2104
translate turkish e6_miku_gesto_fria_40e37a8c:

    # narrador "Escribió firme, sin dudas, cuatro renglones exactos."
    # english: narrador "She wrote firmly, no doubts, four exact lines."
    narrador "Escribió firme, sin dudas, cuatro renglones exactos."

# game/02_cap1_evento6.rpy:2106
translate turkish e6_miku_gesto_fria_380801b8:

    # narrador "Hacia la mitad, la mano libre subió hasta los audífonos."
    # english: narrador "Around the middle, her free hand went up to the headphones."
    narrador "Hacia la mitad, la mano libre subió hasta los audífonos."

# game/02_cap1_evento6.rpy:2108
translate turkish e6_miku_gesto_fria_9721a2c7:

    # narrador "Y se quedó ahí hasta el timbre."
    # english: narrador "And stayed there until the bell."
    narrador "Y se quedó ahí hasta el timbre."

# game/02_cap1_evento6.rpy:2110
translate turkish e6_miku_gesto_fria_a1887257:

    # mc_pensamiento "No se los puso. No los soltó."
    # english: mc_pensamiento "She didn't put them on. She didn't let go."
    mc_pensamiento "No se los puso. No los soltó."

# game/02_cap1_evento6.rpy:2112
translate turkish e6_miku_gesto_fria_b88b83e6:

    # mc_pensamiento "Era una respuesta correcta y me dolió mirarla."
    # english: mc_pensamiento "It was a correct answer and it hurt to look at."
    mc_pensamiento "Era una respuesta correcta y me dolió mirarla."

# game/02_cap1_evento6.rpy:2114
translate turkish e6_miku_gesto_fria_67bcc9a3:

    # mc_pensamiento "Yo tenía razón sobre el temario. Y no me alegraba."
    # english: mc_pensamiento "I was right about the syllabus. And it didn't make me happy."
    mc_pensamiento "Yo tenía razón sobre el temario. Y no me alegraba."

# game/02_cap1_evento6.rpy:2123
translate turkish e6_miku_gesto_no_visitada_5ea3b840:

    # narrador "Escribió largo. Se detuvo a mitad de un renglón."
    # english: narrador "She wrote at length. She stopped in the middle of a line."
    narrador "Escribió largo. Se detuvo a mitad de un renglón."

# game/02_cap1_evento6.rpy:2125
translate turkish e6_miku_gesto_no_visitada_23da0bbe:

    # narrador "Pasó la goma una sola vez, con cuidado."
    # english: narrador "She ran the eraser over it once, carefully."
    narrador "Pasó la goma una sola vez, con cuidado."

# game/02_cap1_evento6.rpy:2127
translate turkish e6_miku_gesto_no_visitada_e3aba184:

    # narrador "A la goma le faltaba un borde. Aún se podía usar."
    # english: narrador "The eraser had a corner missing. It was still usable."
    narrador "A la goma le faltaba un borde. Aún se podía usar."

# game/02_cap1_evento6.rpy:2129
translate turkish e6_miku_gesto_no_visitada_548b771d:

    # mc_pensamiento "Desde la segunda fila no pude leer lo que borró. Pude ver cuánto ocupaba."
    # english: mc_pensamiento "From the second row I couldn't read what she erased. I could see how much space it took."
    mc_pensamiento "Desde la segunda fila no pude leer lo que borró. Pude ver cuánto ocupaba."

# game/02_cap1_evento6.rpy:2131
translate turkish e6_miku_gesto_no_visitada_6d45982e:

    # mc_pensamiento "Lo dejó en tres líneas. Cortas, para no molestar."
    # english: mc_pensamiento "She left it at three lines. Short, so as not to bother anyone."
    mc_pensamiento "Lo dejó en tres líneas. Cortas, para no molestar."

# game/02_cap1_evento6.rpy:2162
translate turkish e6_despues_73e8146f:

    # narrador "Sonó la última campana de la semana."
    # english: narrador "The last bell of the week rang."
    narrador "Sonó la última campana de la semana."

# game/02_cap1_evento6.rpy:2164
translate turkish e6_despues_86d9a65d:

    # narrador "El aula se fue vaciando."
    # english: narrador "The classroom slowly emptied out."
    narrador "El aula se fue vaciando."

# game/02_cap1_evento6.rpy:2166
translate turkish e6_despues_0fd6d8c7:

    # narrador "Todos los estudiantes se retiraban a sus hogares."
    # english: narrador "Everyone else packed up and headed home."
    narrador "Todos los estudiantes se retiraban a sus hogares."

# game/02_cap1_evento6.rpy:2168
translate turkish e6_despues_bb816e62:

    # narrador "Ellas se quedaron."
    # english: narrador "They stayed."
    narrador "Ellas se quedaron."

# game/02_cap1_evento6.rpy:2181
translate turkish e6_despues_ea03d837:

    # narrador "Conocía esta aula a esta hora. La recordaba con cinco caras que ya sabían cómo había ido."
    # english: narrador "I knew this room at this hour. I remembered five faces that already knew how it had gone."
    narrador "Conocía esta aula a esta hora. La recordaba con cinco caras que ya sabían cómo había ido."

# game/02_cap1_evento6.rpy:2183
translate turkish e6_despues_ac6db601:

    # narrador "Nadie recogía nada. Ninguna dijo «salió bien»."
    # english: narrador "Nobody was packing up. Nobody said \"it went well.\""
    narrador "Nadie recogía nada. Ninguna dijo «salió bien»."

# game/02_cap1_evento6.rpy:2185
translate turkish e6_despues_9b3cf0bd:

    # narrador "Esta vez no era por miedo a decirlo."
    # english: narrador "This time it wasn't out of fear of saying it."
    narrador "Esta vez no era por miedo a decirlo."

# game/02_cap1_evento6.rpy:2187
translate turkish e6_despues_48c3b85d:

    # narrador "Era porque nadie lo sabía todavía."
    # english: narrador "It was because nobody knew yet."
    narrador "Era porque nadie lo sabía todavía."

# game/02_cap1_evento6.rpy:2189
translate turkish e6_despues_d72e1ff5:

    # mc_pensamiento "Ni siquiera sonaba el reloj."
    # english: mc_pensamiento "You couldn't even hear the clock."
    mc_pensamiento "Ni siquiera sonaba el reloj."

# game/02_cap1_evento6.rpy:2191
translate turkish e6_despues_e479b563:

    # mc_pensamiento "Después de cinco días, el silencio se oía raro."
    # english: mc_pensamiento "After five days, the silence sounded strange."
    mc_pensamiento "Después de cinco días, el silencio se oía raro."

# game/02_cap1_evento6.rpy:2195
translate turkish e6_despues_90151fe4:

    # mc "Bueno. Se acabó."
    # english: mc "Well. That's it."
    mc "Bueno. Se acabó."

# game/02_cap1_evento6.rpy:2197
translate turkish e6_despues_f0b377d3:

    # mc "Pensé en algo bonito para decirles. Lo ensayé de camino al aula."
    # english: mc "I thought of something nice to say. I rehearsed it on the way here."
    mc "Pensé en algo bonito para decirles. Lo ensayé de camino al aula."

# game/02_cap1_evento6.rpy:2199
translate turkish e6_despues_4d0c0381:

    # mc "Pero la verdad es que no sé cómo terminó esto."
    # english: mc "But honestly, I don't know how this turned out."
    mc "Pero la verdad es que no sé cómo terminó esto."

# game/02_cap1_evento6.rpy:2204
translate turkish e6_despues_b704c2a1:

    # mc "No sé si salió bien. Hasta mañana, nadie lo sabe."
    # english: mc "I don't know if it went well. Until tomorrow, nobody does."
    mc "No sé si salió bien. Hasta mañana, nadie lo sabe."

# game/02_cap1_evento6.rpy:2206
translate turkish e6_despues_c5c5de48:

    # mc "Y no voy a decirles «bien hecho» por algo que todavía no sé."
    # english: mc "And I'm not going to say \"well done\" about something I don't know yet."
    mc "Y no voy a decirles «bien hecho» por algo que todavía no sé."

# game/02_cap1_evento6.rpy:2208
translate turkish e6_despues_d4bbca7c:

    # narrador "Era lo más honesto que les había dicho en un mes. Y lo más corto."
    # english: narrador "It was the most honest thing I'd said to them in a month. And the shortest."
    narrador "Era lo más honesto que les había dicho en un mes. Y lo más corto."

# game/02_cap1_evento6.rpy:2242
translate turkish e6_despues_22f49a0c:

    # mc "¿A mí?"
    # english: mc "Me?"
    mc "¿A mí?"

# game/02_cap1_evento6.rpy:2244
translate turkish e6_despues_e70f0f74:

    # mc "Bien. Creo."
    # english: mc "Good. I think."
    mc "Bien. Creo."

# game/02_cap1_evento6.rpy:2246
translate turkish e6_despues_09aff3ba:

    # narrador "Intenté recordar una sola pregunta de mis cinco exámenes. No me vino ninguna."
    # english: narrador "I tried to remember a single question from my five exams. Not one came back."
    narrador "Intenté recordar una sola pregunta de mis cinco exámenes. No me vino ninguna."

# game/02_cap1_evento6.rpy:2248
translate turkish e6_despues_4f9bde1f:

    # mc "...La verdad es que no me acuerdo."
    # english: mc "...Honestly, I don't remember."
    mc "...La verdad es que no me acuerdo."

# game/02_cap1_evento6.rpy:2252
translate turkish e6_despues_48a885a4:

    # nino "¿Cómo que no te acuerdas?"
    # english: nino "What do you mean you don't remember?"
    nino "¿Cómo que no te acuerdas?"

# game/02_cap1_evento6.rpy:2254
translate turkish e6_despues_1ddf575a:

    # nino "Hiciste cinco exámenes. Igual que nosotras."
    # english: nino "You took five exams. Same as us."
    nino "Hiciste cinco exámenes. Igual que nosotras."

# game/02_cap1_evento6.rpy:2256
translate turkish e6_despues_44b75c99:

    # mc "Terminaba antes de la mitad. Y luego..."
    # english: mc "I'd finish before the halfway point. And then..."
    mc "Terminaba antes de la mitad. Y luego..."

# game/02_cap1_evento6.rpy:2258
translate turkish e6_despues_5c549769:

    # mc "Luego las miraba a ustedes."
    # english: mc "Then I'd watch all of you."
    mc "Luego las miraba a ustedes."

# game/02_cap1_evento6.rpy:2262
translate turkish e6_despues_5eb0440c:

    # narrador "Hubo un silencio corto."
    # english: narrador "There was a short silence."
    narrador "Hubo un silencio corto."

# game/02_cap1_evento6.rpy:2264
translate turkish e6_despues_4f3d481c:

    # narrador "Alguien se rió primero. Después, las demás. No supe quién empezó."
    # english: narrador "Someone laughed first. Then the rest. I couldn't tell who started it."
    narrador "Alguien se rió primero. Después, las demás. No supe quién empezó."

# game/02_cap1_evento6.rpy:2270
translate turkish e6_despues_383b6eb4:

    # ichika "Qué tutor más raro."
    # english: ichika "Weirdest tutor ever."
    ichika "Qué tutor más raro."

# game/02_cap1_evento6.rpy:2274
translate turkish e6_despues_1e3bfe75:

    # mc_pensamiento "Cinco exámenes míos, y no recordaba ni una pregunta."
    # english: mc_pensamiento "Five exams of my own, and I couldn't remember a single question."
    mc_pensamiento "Cinco exámenes míos, y no recordaba ni una pregunta."

# game/02_cap1_evento6.rpy:2276
translate turkish e6_despues_50ee3b82:

    # mc_pensamiento "Recordaba un nombre escrito antes que nada, en la hoja de Yotsuba."
    # english: mc_pensamiento "What I remembered was a name, written before anything else, on Yotsuba's sheet."
    mc_pensamiento "Recordaba un nombre escrito antes que nada, en la hoja de Yotsuba."

# game/02_cap1_evento6.rpy:2278
translate turkish e6_despues_019be506:

    # mc_pensamiento "Un guion doblado asomando del bolsillo de Ichika."
    # english: mc_pensamiento "A folded script poking out of Ichika's pocket."
    mc_pensamiento "Un guion doblado asomando del bolsillo de Ichika."

# game/02_cap1_evento6.rpy:2280
translate turkish e6_despues_deff7519:

    # mc_pensamiento "Unos labios moviéndose en inglés, sin sonido."
    # english: mc_pensamiento "Lips moving in English, without a sound."
    mc_pensamiento "Unos labios moviéndose en inglés, sin sonido."

# game/02_cap1_evento6.rpy:2282
translate turkish e6_despues_e100ef74:

    # mc_pensamiento "Un dedo recorriendo renglones en busca de un error."
    # english: mc_pensamiento "A finger running down the lines, hunting for a mistake."
    mc_pensamiento "Un dedo recorriendo renglones en busca de un error."

# game/02_cap1_evento6.rpy:2284
translate turkish e6_despues_d1577dc8:

    # mc_pensamiento "Y unos audífonos al cuello. Apagados."
    # english: mc_pensamiento "And headphones around a neck. Switched off."
    mc_pensamiento "Y unos audífonos al cuello. Apagados."

# game/02_cap1_evento6.rpy:2286
translate turkish e6_despues_c3af8ce2:

    # mc_pensamiento "Cinco personas que saben una cosa cada una."
    # english: mc_pensamiento "Five people who each know one thing."
    mc_pensamiento "Cinco personas que saben una cosa cada una."

# game/02_cap1_evento6.rpy:2288
translate turkish e6_despues_9c4cb0c3:

    # mc_pensamiento "Esta semana no les enseñé nada. Me senté atrás y aprendí yo."
    # english: mc_pensamiento "This week I didn't teach them anything. I sat in the back and did the learning myself."
    mc_pensamiento "Esta semana no les enseñé nada. Me senté atrás y aprendí yo."

# game/02_cap1_evento6.rpy:2294
translate turkish e6_despues_9931e2b6:

    # ichika "Oigan. ¿Se han dado cuenta?"
    # english: ichika "Hey. Did anyone notice?"
    ichika "Oigan. ¿Se han dado cuenta?"

# game/02_cap1_evento6.rpy:2296
translate turkish e6_despues_5eb2dd33:

    # ichika "La campana sonó hace un buen rato. Y ninguna se ha ido."
    # english: ichika "The bell rang ages ago. And nobody's left."
    ichika "La campana sonó hace un buen rato. Y ninguna se ha ido."

# game/02_cap1_evento6.rpy:2300
translate turkish e6_despues_6c535fd2:

    # nino "Estoy esperando a que se vacíe el pasillo."
    # english: nino "I'm waiting for the hallway to clear out."
    nino "Estoy esperando a que se vacíe el pasillo."

# game/02_cap1_evento6.rpy:2304
translate turkish e6_despues_2cda72c4:

    # ichika "El pasillo está vacío desde hace diez minutos, Nino."
    # english: ichika "The hallway's been empty for ten minutes, Nino."
    ichika "El pasillo está vacío desde hace diez minutos, Nino."

# game/02_cap1_evento6.rpy:2308
translate turkish e6_despues_fe0cab27:

    # nino "...Pues espero a que se vacíe más."
    # english: nino "...Then I'm waiting for it to get emptier."
    nino "...Pues espero a que se vacíe más."

# game/02_cap1_evento6.rpy:2316
translate turkish e6_despues_f5a17ac9:

    # yotsuba "...Es que si salimos por esa puerta, se acaba la semana."
    # english: yotsuba "...It's just that if we walk out that door, the week's over."
    yotsuba "...Es que si salimos por esa puerta, se acaba la semana."

# game/02_cap1_evento6.rpy:2318
translate turkish e6_despues_1e264598:

    # narrador "Lo dijo bajito. Yotsuba, que no dice nada bajito."
    # english: narrador "She said it quietly. Yotsuba, who never says anything quietly."
    narrador "Lo dijo bajito. Yotsuba, que no dice nada bajito."

# game/02_cap1_evento6.rpy:2322
translate turkish e6_despues_4373414c:

    # itsuki "Y el mes. El plazo era de un mes."
    # english: itsuki "And the month. The deadline was one month."
    itsuki "Y el mes. El plazo era de un mes."

# game/02_cap1_evento6.rpy:2326
translate turkish e6_despues_532ecf45:

    # narrador "Nadie dijo lo que venía después. No hacía falta."
    # english: narrador "Nobody said what came next. They didn't need to."
    narrador "Nadie dijo lo que venía después. No hacía falta."

# game/02_cap1_evento6.rpy:2328
translate turkish e6_despues_27988dfe:

    # narrador "El plazo era el mío. Ese mes era la razón por la que yo seguía en esta aula."
    # english: narrador "The deadline was mine. That month was the reason I was still in this classroom."
    narrador "El plazo era el mío. Ese mes era la razón por la que yo seguía en esta aula."

# game/02_cap1_evento6.rpy:2330
translate turkish e6_despues_19a99e1b:

    # mc_pensamiento "Mañana un papel diría si seguía. Ellas lo sabían igual que yo."
    # english: mc_pensamiento "Tomorrow a piece of paper would say whether I stayed. They knew it as well as I did."
    mc_pensamiento "Mañana un papel diría si seguía. Ellas lo sabían igual que yo."

# game/02_cap1_evento6.rpy:2332
translate turkish e6_despues_ae469760:

    # narrador "Me miraron las cinco. Querían preguntar lo mismo, y ninguna lo hizo."
    # english: narrador "All five looked at me. They wanted to ask the same thing, and none did."
    narrador "Me miraron las cinco. Querían preguntar lo mismo, y ninguna lo hizo."

# game/02_cap1_evento6.rpy:2336
translate turkish e6_despues_11b46661:

    # nino "Nadie le va a preguntar nada."
    # english: nino "Nobody's going to ask him anything."
    nino "Nadie le va a preguntar nada."

# game/02_cap1_evento6.rpy:2338
translate turkish e6_despues_a4a7ebd0:

    # nino "Lo que tenga que pasar, que pase mañana."
    # english: nino "Whatever's going to happen, let it happen tomorrow."
    nino "Lo que tenga que pasar, que pase mañana."

# game/02_cap1_evento6.rpy:2340
translate turkish e6_despues_71d608db:

    # nino "Mañana se sabe. Y ya."
    # english: nino "We find out tomorrow. That's it."
    nino "Mañana se sabe. Y ya."

# game/02_cap1_evento6.rpy:2344
translate turkish e6_despues_3d56902a:

    # mc_pensamiento "Podía decirles que el lunes estaría con ellas. Sonaría bien."
    # english: mc_pensamiento "I could tell them I'd be with them on Monday. It would sound good."
    mc_pensamiento "Podía decirles que el lunes estaría con ellas. Sonaría bien."

# game/02_cap1_evento6.rpy:2346
translate turkish e6_despues_e2a23a7b:

    # mc_pensamiento "Y sería exactamente lo que les dijeron todos los que se fueron."
    # english: mc_pensamiento "And it would be exactly what everyone who left told them."
    mc_pensamiento "Y sería exactamente lo que les dijeron todos los que se fueron."

# game/02_cap1_evento6.rpy:2348
translate turkish e6_despues_b0ba3c1c:

    # mc "No voy a prometerles nada. Ya les han prometido bastante."
    # english: mc "I won't promise you anything. You've been promised enough."
    mc "No voy a prometerles nada. Ya les han prometido bastante."

# game/02_cap1_evento6.rpy:2350
translate turkish e6_despues_d35a61cf:

    # mc "Solo sé una cosa: hoy no me voy de esta aula hasta que salga la última."
    # english: mc "I only know one thing: I'm not leaving this classroom until the last one of you walks out."
    mc "Solo sé una cosa: hoy no me voy de esta aula hasta que salga la última."

# game/02_cap1_evento6.rpy:2352
translate turkish e6_despues_4cd3ff47:

    # narrador "Nadie contestó. Itsuki bajó la vista a su pupitre. Nino descruzó los brazos."
    # english: narrador "Nobody answered. Itsuki looked down at her desk. Nino unfolded her arms."
    narrador "Nadie contestó. Itsuki bajó la vista a su pupitre. Nino descruzó los brazos."

# game/02_cap1_evento6.rpy:2358
translate turkish e6_despues_ed0f3db6:

    # miku "Entonces salgamos todas a la vez."
    # english: miku "Then let's all leave at the same time."
    miku "Entonces salgamos todas a la vez."

# game/02_cap1_evento6.rpy:2360
translate turkish e6_despues_d0de0845:

    # miku "Así nadie se queda de última."
    # english: miku "That way nobody's last."
    miku "Así nadie se queda de última."

# game/02_cap1_evento6.rpy:2362
translate turkish e6_despues_0b72fae9:

    # narrador "Sin pausa delante. Ya lo tenía decidido."
    # english: narrador "No pause before it. She'd already decided."
    narrador "Sin pausa delante. Ya lo tenía decidido."

# game/02_cap1_evento6.rpy:2368
translate turkish e6_despues_01b85ab2:

