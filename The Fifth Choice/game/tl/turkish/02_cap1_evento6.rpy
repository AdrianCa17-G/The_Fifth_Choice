translate turkish e6_yotsuba_tarde_tibia_f4d14743:

    # yotsuba "¡[mc]! ¡Yo sí sé una cosa! ¡Terminé la hoja entera!"
    # english: yotsuba "[mc]! I do know one thing! I finished the whole sheet!"
    yotsuba "¡[mc]! ¡Yo sí sé una cosa! ¡Terminé la hoja entera!"

# game/02_cap1_evento6.rpy:2531
translate turkish e6_yotsuba_tarde_tibia_ee3fd6c5:

    # yotsuba "Bueno... casi entera. Hubo una frase que empecé y no terminé."
    # english: yotsuba "Well... almost the whole thing. There was one sentence I started and never finished."
    yotsuba "Bueno... casi entera. Hubo una frase que empecé y no terminé."

# game/02_cap1_evento6.rpy:2533
translate turkish e6_yotsuba_tarde_tibia_77c47ed2:

    # mc "¿Cuál?"
    # english: mc "Which one?"
    mc "¿Cuál?"

# game/02_cap1_evento6.rpy:2537
translate turkish e6_yotsuba_tarde_tibia_3252ad13:

    # yotsuba "¡Una que no venía en el examen!"
    # english: yotsuba "One that wasn't on the exam!"
    yotsuba "¡Una que no venía en el examen!"

# game/02_cap1_evento6.rpy:2539
translate turkish e6_yotsuba_tarde_tibia_f105e9d7:

    # narrador "Se rió. La frase se quedó donde la había dejado el lunes."
    # english: narrador "She laughed. The sentence stayed where she'd left it on Monday."
    narrador "Se rió. La frase se quedó donde la había dejado el lunes."

# game/02_cap1_evento6.rpy:2548
translate turkish e6_yotsuba_tarde_fria_fc98c41a:

    # yotsuba "¡Tutor! ¡Hoja llena! ¡Sin mirar a nadie ni una sola vez!"
    # english: yotsuba "Tutor! Full sheet! Didn't look at anybody, not once!"
    yotsuba "¡Tutor! ¡Hoja llena! ¡Sin mirar a nadie ni una sola vez!"

# game/02_cap1_evento6.rpy:2550
translate turkish e6_yotsuba_tarde_fria_fddb175e:

    # yotsuba "Me concentré en lo mío. Como dijiste."
    # english: yotsuba "I focused on my own. Like you said."
    yotsuba "Me concentré en lo mío. Como dijiste."

# game/02_cap1_evento6.rpy:2552
translate turkish e6_yotsuba_tarde_fria_e1afadae:

    # mc "Yotsuba..."
    # english: mc "Yotsuba..."
    mc "Yotsuba..."

# game/02_cap1_evento6.rpy:2554
translate turkish e6_yotsuba_tarde_fria_f358c33a:

    # yotsuba "¡Es lo que tenía que hacer!"
    # english: yotsuba "It's what I had to do!"
    yotsuba "¡Es lo que tenía que hacer!"

# game/02_cap1_evento6.rpy:2556
translate turkish e6_yotsuba_tarde_fria_46c363c5:

    # yotsuba "¡Es lo que mejor sé hacer! Lo sé."
    # english: yotsuba "It's what I do best! I know it."
    yotsuba "¡Es lo que mejor sé hacer! Lo sé."

# game/02_cap1_evento6.rpy:2558
translate turkish e6_yotsuba_tarde_fria_b36c6be1:

    # narrador "Me sonrió a mí. Hacia sus hermanas no giró la cabeza. Ni siquiera ahora."
    # english: narrador "She smiled at me. She didn't turn her head toward her sisters. Not even now."
    narrador "Me sonrió a mí. Hacia sus hermanas no giró la cabeza. Ni siquiera ahora."

# game/02_cap1_evento6.rpy:2567
translate turkish e6_yotsuba_tarde_no_visitada_82ac5d79:

    # yotsuba "¡[mc]! ¡Le pasé un lápiz a Ichika antes de que lo pidiera!"
    # english: yotsuba "[mc]! I passed Ichika a pencil before she even asked!"
    yotsuba "¡[mc]! ¡Le pasé un lápiz a Ichika antes de que lo pidiera!"

# game/02_cap1_evento6.rpy:2569
translate turkish e6_yotsuba_tarde_no_visitada_781bbe21:

    # yotsuba "Eso no sale en el examen, ¡pero cuenta!"
    # english: yotsuba "That's not on the exam, but it counts!"
    yotsuba "Eso no sale en el examen, ¡pero cuenta!"

# game/02_cap1_evento6.rpy:2573
translate turkish e6_yotsuba_tarde_no_visitada_09544e46:

    # yotsuba "...¿Tú me viste? Desde la segunda fila."
    # english: yotsuba "...Did you see me? From the second row."
    yotsuba "...¿Tú me viste? Desde la segunda fila."

# game/02_cap1_evento6.rpy:2575
translate turkish e6_yotsuba_tarde_no_visitada_030e1628:

    # mc "Te vi."
    # english: mc "I saw you."
    mc "Te vi."

# game/02_cap1_evento6.rpy:2579
translate turkish e6_yotsuba_tarde_no_visitada_7969742d:

    # yotsuba "¡Entonces ya está!"
    # english: yotsuba "Then that's all I need!"
    yotsuba "¡Entonces ya está!"

# game/02_cap1_evento6.rpy:2581
translate turkish e6_yotsuba_tarde_no_visitada_d25f835b:

    # narrador "No preguntó qué había visto. Le bastaba con que alguien hubiera mirado."
    # english: narrador "She didn't ask what I'd seen. It was enough for her that someone had been looking."
    narrador "No preguntó qué había visto. Le bastaba con que alguien hubiera mirado."

# game/02_cap1_evento6.rpy:2592
translate turkish e6_ichika_tarde_calida_2e8d30a7:

    # ichika "No me dormí en ningún examen."
    # english: ichika "I didn't fall asleep in a single exam."
    ichika "No me dormí en ningún examen."

# game/02_cap1_evento6.rpy:2594
translate turkish e6_ichika_tarde_calida_fa8e8bcc:

    # ichika "Leí cada enunciado entero, con los ojos abiertos."
    # english: ichika "I read every question all the way through, eyes open."
    ichika "Leí cada enunciado entero, con los ojos abiertos."

# game/02_cap1_evento6.rpy:2596
translate turkish e6_ichika_tarde_calida_14ef4735:

    # ichika "El guion se quedó en el bolsillo. No lo saqué ni una vez."
    # english: ichika "The script stayed in my pocket. I didn't take it out once."
    ichika "El guion se quedó en el bolsillo. No lo saqué ni una vez."

# game/02_cap1_evento6.rpy:2598
translate turkish e6_ichika_tarde_calida_e834f2b1:

    # ichika "Al terminar me quedé mirando la hoja como si la hubiera hecho otra persona."
    # english: ichika "When I finished, I stared at the page like someone else had written it."
    ichika "Al terminar me quedé mirando la hoja como si la hubiera hecho otra persona."

# game/02_cap1_evento6.rpy:2602
translate turkish e6_ichika_tarde_calida_299e07ec:

    # ichika "Era yo. Eso es lo que todavía no me creo."
    # english: ichika "It was me. That's the part I still can't believe."
    ichika "Era yo. Eso es lo que todavía no me creo."

# game/02_cap1_evento6.rpy:2604
translate turkish e6_ichika_tarde_calida_46a4fce0:

    # ichika "Tú lo viste antes que yo, [mc]. En la sala de ensayo."
    # english: ichika "You saw it before I did, [mc]. In the rehearsal room."
    ichika "Tú lo viste antes que yo, [mc]. En la sala de ensayo."

# game/02_cap1_evento6.rpy:2606
translate turkish e6_ichika_tarde_calida_d3560d36:

    # ichika "...Eso tampoco me lo creo."
    # english: ichika "...I can't believe that either."
    ichika "...Eso tampoco me lo creo."

# game/02_cap1_evento6.rpy:2608
translate turkish e6_ichika_tarde_calida_d010dc47:

    # narrador "Ni un chiste. Ni una máscara. Solo lo que había pasado."
    # english: narrador "Not a joke. Not a mask. Just what had happened."
    narrador "Ni un chiste. Ni una máscara. Solo lo que había pasado."

# game/02_cap1_evento6.rpy:2617
translate turkish e6_ichika_tarde_tibia_348b7aab:

    # ichika "¡El profesor me pilló sonriéndole a la hoja! Le dije que era una técnica."
    # english: ichika "The teacher caught me smiling at my paper! I told him it was a technique."
    ichika "¡El profesor me pilló sonriéndole a la hoja! Le dije que era una técnica."

# game/02_cap1_evento6.rpy:2621
translate turkish e6_ichika_tarde_tibia_06f6ee89:

    # ichika "Lo resolví rápido, eso sí."
    # english: ichika "I did solve it fast, though."
    ichika "Lo resolví rápido, eso sí."

# game/02_cap1_evento6.rpy:2623
translate turkish e6_ichika_tarde_tibia_5dbfc8d7:

    # ichika "Lo que no sé es si... No tengo que po—"
    # english: ichika "What I don't know is if... I don't have to han—"
    ichika "Lo que no sé es si... No tengo que po—"

# game/02_cap1_evento6.rpy:2627
translate turkish e6_ichika_tarde_tibia_8404af2f:

    # ichika "¡Olvídalo! Una línea de ensayo. Se me cuelan."
