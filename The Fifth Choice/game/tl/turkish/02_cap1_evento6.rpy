translate turkish e6_yotsuba_tarde_calida_6afc062a:

    # yotsuba "Yo sí sé una cosa."
    # english: yotsuba "I do know one thing."
    yotsuba "Yo sí sé una cosa."

# game/02_cap1_evento6.rpy:2510
translate turkish e6_yotsuba_tarde_calida_f95ed97b:

    # yotsuba "El lunes escribí mi nombre primero, como siempre. Pero después seguí escribiendo."
    # english: yotsuba "On Monday I wrote my name first, like always. But then I kept writing."
    yotsuba "El lunes escribí mi nombre primero, como siempre. Pero después seguí escribiendo."

# game/02_cap1_evento6.rpy:2512
translate turkish e6_yotsuba_tarde_calida_040e700a:

    # yotsuba "Llené la hoja. Y miré a mis hermanas igual, pero para saludarlas."
    # english: yotsuba "I filled the whole page. And I still looked over at my sisters, but just to say hi."
    yotsuba "Llené la hoja. Y miré a mis hermanas igual, pero para saludarlas."

# game/02_cap1_evento6.rpy:2516
translate turkish e6_yotsuba_tarde_calida_246629de:

    # yotsuba "No sé si está bien. Pero esta vez la hoja también era mía."
    # english: yotsuba "I don't know if it's right. But this time the page was mine too."
    yotsuba "No sé si está bien. Pero esta vez la hoja también era mía."

# game/02_cap1_evento6.rpy:2518
translate turkish e6_yotsuba_tarde_calida_e89a12e4:

    # narrador "Sin gritar. En Yotsuba, eso se oye más."
    # english: narrador "No shouting. With Yotsuba, that's louder."
    narrador "Sin gritar. En Yotsuba, eso se oye más."

