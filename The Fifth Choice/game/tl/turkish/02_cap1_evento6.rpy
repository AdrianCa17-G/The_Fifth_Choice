# game/02_cap1_evento6.rpy:4672
translate turkish e6_retrato_e9cecb87:

    # raiha "¿Pendiente? ¿Con quién?"
    # english: raiha "Pending? With whom?"
    raiha "¿Pendiente? ¿Con quién?"

# game/02_cap1_evento6.rpy:4674
translate turkish e6_retrato_9424ec5a:

    # mc "Con alguien que me esperó. Y no fui."
    # english: mc "With someone who waited for me. And I didn't show."
    mc "Con alguien que me esperó. Y no fui."

# game/02_cap1_evento6.rpy:4679
translate turkish e6_retrato_0e371997:

    # raiha "Entonces tienes que ir. Esperar es lo peor."
    # english: raiha "Then you have to go. Waiting is the worst."
    raiha "Entonces tienes que ir. Esperar es lo peor."

# game/02_cap1_evento6.rpy:4681
translate turkish e6_retrato_eebc3e06:

    # narrador "Ella sabe de eso: me espera cada noche con la cena hecha."
    # english: narrador "She'd know: she waits up for me every night with dinner made."
    narrador "Ella sabe de eso: me espera cada noche con la cena hecha."

# game/02_cap1_evento6.rpy:4687
translate turkish e6_retrato_a9f538d5:

    # mc "Dormir. Hasta tarde."
    # english: mc "Sleep. Late."
    mc "Dormir. Hasta tarde."

# game/02_cap1_evento6.rpy:4692
translate turkish e6_retrato_224e6146:

    # raiha "...¿Estás enfermo?"
    # english: raiha "...Are you sick?"
    raiha "...¿Estás enfermo?"

# game/02_cap1_evento6.rpy:4694
translate turkish e6_retrato_55caf2a7:

    # mc "Estoy cansado. Nada más."
    # english: mc "I'm tired. That's all."
    mc "Estoy cansado. Nada más."

# game/02_cap1_evento6.rpy:4696
translate turkish e6_retrato_12a970f9:

    # raiha "Hermanito... Nunca te había oído decir eso."
    # english: raiha "Big brother... I've never heard you say that."
    raiha "Hermanito... Nunca te había oído decir eso."

# game/02_cap1_evento6.rpy:4698
translate turkish e6_retrato_f91eeff3:

    # raiha "...Dormir también es importante."
    # english: raiha "...Sleep is important too."
    raiha "...Dormir también es importante."

# game/02_cap1_evento6.rpy:4700
translate turkish e6_retrato_236f048d:

    # mc "Lo sé. Me lo dijiste tú."
    # english: mc "I know. You told me."
    mc "Lo sé. Me lo dijiste tú."

# game/02_cap1_evento6.rpy:4705
translate turkish e6_retrato_994ea295:

    # raiha "¡Pues mañana no te despierto! ...Salvo que haya curry."
    # english: raiha "Then I won't wake you tomorrow! ...Unless there's curry."
    raiha "¡Pues mañana no te despierto! ...Salvo que haya curry."

# game/02_cap1_evento6.rpy:4710
translate turkish e6_retrato_f5f38220:

    # raiha "Buenas noches, hermanito."
    # english: raiha "Good night, big brother."
    raiha "Buenas noches, hermanito."

# game/02_cap1_evento6.rpy:4712
translate turkish e6_retrato_97c45673:

    # raiha "Hoy pareces el de siempre."
    # english: raiha "You look like your old self tonight."
    raiha "Hoy pareces el de siempre."

# game/02_cap1_evento6.rpy:4714
translate turkish e6_retrato_da2024f8:

    # raiha "Pero sin la cara de estar haciendo cuentas."
    # english: raiha "But without the face of someone doing the math."
    raiha "Pero sin la cara de estar haciendo cuentas."

# game/02_cap1_evento6.rpy:4724
translate turkish e6_retrato_3ca17cf8:

    # narrador "Mi padre se asomó a la puerta poco después. Miró la foto antes de mirarme a mí."
    # english: narrador "My father appeared at the door a little later. He looked at the photo before he looked at me."
    narrador "Mi padre se asomó a la puerta poco después. Miró la foto antes de mirarme a mí."

# game/02_cap1_evento6.rpy:4726
translate turkish e6_retrato_fddcebc3:

    # narrador "Después vio el celular, con la foto de las cinco todavía en la pantalla."
    # english: narrador "Then he saw the phone, with the photo of the five still on the screen."
    narrador "Después vio el celular, con la foto de las cinco todavía en la pantalla."

# game/02_cap1_evento6.rpy:4728
translate turkish e6_retrato_05885dc8:

    # isanari "Buen encuadre. Y tú no sales."
    # english: isanari "Nice framing. And you're not in it."
    isanari "Buen encuadre. Y tú no sales."

# game/02_cap1_evento6.rpy:4730
translate turkish e6_retrato_4b5ccc3f:

    # mc "Alguien tenía que tomarla."
    # english: mc "Somebody had to take it."
    mc "Alguien tenía que tomarla."

# game/02_cap1_evento6.rpy:4732
translate turkish e6_retrato_db7a79a7:

    # isanari "Eso lo sacaste de mí. Los que toman la foto nunca salen en ella."
    # english: isanari "You got that from me. The ones who take the photo never end up in it."
    isanari "Eso lo sacaste de mí. Los que toman la foto nunca salen en ella."

# game/02_cap1_evento6.rpy:4734
translate turkish e6_retrato_6bd958fd:

    # isanari "En la cena dijiste «gracias por la comida»."
    # english: isanari "At dinner you said \"thanks for the food.\""
    isanari "En la cena dijiste «gracias por la comida»."

# game/02_cap1_evento6.rpy:4736
translate turkish e6_retrato_74cbaccb:

    # mc "Lo digo siempre."
    # english: mc "I always say it."
    mc "Lo digo siempre."

# game/02_cap1_evento6.rpy:4741
translate turkish e6_retrato_2ec2a5c1:

    # isanari "No así. Así lo decía tu madre."
    # english: isanari "Not like that. That's how your mother used to say it."
    isanari "No así. Así lo decía tu madre."

# game/02_cap1_evento6.rpy:4743
translate turkish e6_retrato_25ce21ce:

    # isanari "Como si de verdad estuviera dando las gracias por algo."
    # english: isanari "As if she were really thanking someone for something."
    isanari "Como si de verdad estuviera dando las gracias por algo."

# game/02_cap1_evento6.rpy:4745
translate turkish e6_retrato_cfa1cd61:

    # isanari "Buenas noches, [mc]."
    # english: isanari "Good night, [mc]."
    isanari "Buenas noches, [mc]."

# game/02_cap1_evento6.rpy:4747
translate turkish e6_retrato_7eccb234:

    # isanari "...Examen sorpresa aprobado."
    # english: isanari "...Pop quiz passed."
    isanari "...Examen sorpresa aprobado."

# game/02_cap1_evento6.rpy:4749
translate turkish e6_retrato_1344ba7f:

    # narrador "Y se retiró antes de que pudiera contestarle."
    # english: narrador "And he left before I could answer."
    narrador "Y se retiró antes de que pudiera contestarle."

# game/02_cap1_evento6.rpy:4751
translate turkish e6_retrato_47ab7de4:

    # mc_pensamiento "En la cena se quedó mirando su plato más tiempo del necesario."
    # english: mc_pensamiento "At dinner he kept staring at his plate longer than necessary."
    mc_pensamiento "En la cena se quedó mirando su plato más tiempo del necesario."

# game/02_cap1_evento6.rpy:4753
translate turkish e6_retrato_a38676fd:

    # mc_pensamiento "Ahora sé por qué."
    # english: mc_pensamiento "Now I know why."
    mc_pensamiento "Ahora sé por qué."

# game/02_cap1_evento6.rpy:4755
translate turkish e6_retrato_778d9be6:

    # mc_pensamiento "Un mes de «examen sorpresa». Era la primera vez que venía con nota."
    # english: mc_pensamiento "A month of \"pop quizzes.\" It was the first one that came with a grade."
    mc_pensamiento "Un mes de «examen sorpresa». Era la primera vez que venía con nota."

# game/02_cap1_evento6.rpy:4757
translate turkish e6_retrato_516ef1ef:

    # mc_pensamiento "De mi madre recuerdo poco. Ni siquiera cómo daba las gracias."
    # english: mc_pensamiento "I remember little about my mother. Not even how she said thank you."
    mc_pensamiento "De mi madre recuerdo poco. Ni siquiera cómo daba las gracias."

# game/02_cap1_evento6.rpy:4759
translate turkish e6_retrato_c3a94472:

    # mc_pensamiento "Resulta que lo hago igual que ella. Sin saberlo."
    # english: mc_pensamiento "Turns out I do it just like her. Without knowing."
    mc_pensamiento "Resulta que lo hago igual que ella. Sin saberlo."

# game/02_cap1_evento6.rpy:4769
translate turkish e6_retrato_436450aa:

    # narrador "Dejé el celular boca abajo, junto a la foto."
    # english: narrador "I left the phone face down, next to the photo."
    narrador "Dejé el celular boca abajo, junto a la foto."

# game/02_cap1_evento6.rpy:4771
translate turkish e6_retrato_08504ba9:

    # narrador "Apagué la lámpara."
    # english: narrador "I turned off the lamp."
    narrador "Apagué la lámpara."

# game/02_cap1_evento6.rpy:4773
translate turkish e6_retrato_42f3023c:

    # mc_pensamiento "Hace un mes anoté cinco nombres y pensé que al día siguiente empezaba una batalla."
