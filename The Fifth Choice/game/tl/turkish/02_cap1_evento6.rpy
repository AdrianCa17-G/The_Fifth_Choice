    # mc "¿Usted aprobó alguna vez por poco, señor?"
    # english: mc "Have you ever passed by a hair, sir?"
    mc "¿Usted aprobó alguna vez por poco, señor?"

# game/02_cap1_evento6.rpy:3189
translate turkish e6_s2_mixto_33fe5281:

    # maruo "Nunca en un examen."
    # english: maruo "Never on an exam."
    maruo "Nunca en un examen."

# game/02_cap1_evento6.rpy:3191
translate turkish e6_s2_mixto_42571ef2:

    # narrador "No dijo en qué, entonces. Y yo no me atreví a preguntarlo."
    # english: narrador "He didn't say on what, then. And I didn't dare ask."
    narrador "No dijo en qué, entonces. Y yo no me atreví a preguntarlo."

# game/02_cap1_evento6.rpy:3193
translate turkish e6_s2_mixto_b52cbdf4:

    # mc_pensamiento "Ni elogio ni reproche. Parecía seguir haciendo cuentas."
    # english: mc_pensamiento "Neither praise nor blame. He seemed to still be doing the math."
    mc_pensamiento "Ni elogio ni reproche. Parecía seguir haciendo cuentas."

# game/02_cap1_evento6.rpy:3195
translate turkish e6_s2_mixto_eaab06fb:

    # maruo "No me corresponde alegrarme. Tampoco quejarme."
    # english: maruo "It is not my place to be glad. Nor to complain."
    maruo "No me corresponde alegrarme. Tampoco quejarme."

# game/02_cap1_evento6.rpy:3197
translate turkish e6_s2_mixto_c1bff9ba:

    # maruo "Me corresponde que el contrato siga. Y sigue."
    # english: maruo "My concern is that the contract continues. And it does."
    maruo "Me corresponde que el contrato siga. Y sigue."

# game/02_cap1_evento6.rpy:3199
translate turkish e6_s2_mixto_b2516466:

    # mc "Gracias."
    # english: mc "Thank you."
    mc "Gracias."

# game/02_cap1_evento6.rpy:3201
translate turkish e6_s2_mixto_4936a6ef:

    # maruo "No me las des. No es un favor."
    # english: maruo "Do not thank me. It is not a favor."
    maruo "No me las des. No es un favor."

# game/02_cap1_evento6.rpy:3208
translate turkish e6_s2_bueno_21a27cb5:

    # maruo "Tu padre me habló de alguien que no se rendía."
    # english: maruo "Your father told me about someone who did not give up."
    maruo "Tu padre me habló de alguien que no se rendía."

# game/02_cap1_evento6.rpy:3210
translate turkish e6_s2_bueno_93393068:

    # maruo "Me faltaba ver qué hacía ese alguien mientras no se rendía."
    # english: maruo "What I still had to see was what that someone did while refusing to give up."
    maruo "Me faltaba ver qué hacía ese alguien mientras no se rendía."

# game/02_cap1_evento6.rpy:3212
translate turkish e6_s2_bueno_33de77ca:

    # mc "¿Y qué vio?"
    # english: mc "And what did you see?"
    mc "¿Y qué vio?"

# game/02_cap1_evento6.rpy:3214
translate turkish e6_s2_bueno_3fc1d76a:

    # maruo "Mis hijas llegan a casa y hablan de lo que estudian. Antes llegaban y se encerraban."
    # english: maruo "My daughters come home and talk about their studies. They used to come home and shut themselves in."
    maruo "Mis hijas llegan a casa y hablan de lo que estudian. Antes llegaban y se encerraban."

# game/02_cap1_evento6.rpy:3216
translate turkish e6_s2_bueno_ed7c3922:

    # maruo "Pensé que era la edad. Que se les pasaría."
    # english: maruo "I thought it was their age. That it would pass."
    maruo "Pensé que era la edad. Que se les pasaría."

# game/02_cap1_evento6.rpy:3218
translate turkish e6_s2_bueno_39f4e080:

    # maruo "No era la edad."
    # english: maruo "It was not their age."
    maruo "No era la edad."

# game/02_cap1_evento6.rpy:3220
translate turkish e6_s2_bueno_0fcdcd1b:

    # mc "Yo no hice tanto, señor."
    # english: mc "I didn't do that much, sir."
    mc "Yo no hice tanto, señor."

# game/02_cap1_evento6.rpy:3222
translate turkish e6_s2_bueno_f660da35:

    # maruo "No te pedí humildad. Te dije lo que vi."
    # english: maruo "I did not ask for humility. I told you what I saw."
    maruo "No te pedí humildad. Te dije lo que vi."

# game/02_cap1_evento6.rpy:3224
translate turkish e6_s2_bueno_afc1c826:

    # maruo "Esta semana, cada noche, las cinco en la cocina discutiendo a la vez."
    # english: maruo "This week, every night, the five of them in the kitchen, arguing all at once."
    maruo "Esta semana, cada noche, las cinco en la cocina discutiendo a la vez."

# game/02_cap1_evento6.rpy:3226
translate turkish e6_s2_bueno_2658ab91:

    # maruo "Por quién lava los platos, por quién se queda con el último bocado."
    # english: maruo "Over who washes the dishes, over who gets the last bite."
    maruo "Por quién lava los platos, por quién se queda con el último bocado."

# game/02_cap1_evento6.rpy:3228
translate turkish e6_s2_bueno_5700eac8:

    # maruo "Una noche estuve diez minutos en el pasillo. No entré."
    # english: maruo "One night I stood in the hallway for ten minutes. I did not go in."
    maruo "Una noche estuve diez minutos en el pasillo. No entré."

# game/02_cap1_evento6.rpy:3230
translate turkish e6_s2_bueno_24ef4d4d:

    # maruo "No quería que se callaran."
    # english: maruo "I did not want them to stop."
    maruo "No quería que se callaran."

# game/02_cap1_evento6.rpy:3232
translate turkish e6_s2_bueno_954a000f:

    # maruo "Parecía que alguien las había cambiado."
    # english: maruo "It seemed that someone had changed them."
    maruo "Parecía que alguien las había cambiado."

# game/02_cap1_evento6.rpy:3236
translate turkish e6_s2_bueno_a569896d:

    # narrador "Alineó los boletines con dos dedos, aunque ya estaban alineados."
    # english: narrador "He lined up the report cards with two fingers, though they were already lined up."
    narrador "Alineó los boletines con dos dedos, aunque ya estaban alineados."

# game/02_cap1_evento6.rpy:3238
translate turkish e6_s2_bueno_6739f6ff:

    # narrador "Seguían boca abajo. Ninguno de los dos hizo el gesto de darles la vuelta."
    # english: narrador "They were still face down. Neither of us made a move to turn them over."
    narrador "Seguían boca abajo. Ninguno de los dos hizo el gesto de darles la vuelta."

# game/02_cap1_evento6.rpy:3240
translate turkish e6_s2_bueno_57e5f6d5:

    # maruo "Esto no fue una casualidad. No lo repito."
    # english: maruo "This was not a coincidence. I will not say it again."
    maruo "Esto no fue una casualidad. No lo repito."

# game/02_cap1_evento6.rpy:3242
translate turkish e6_s2_bueno_620b4de1:

    # mc "...Gracias, señor."
    # english: mc "...Thank you, sir."
    mc "...Gracias, señor."

# game/02_cap1_evento6.rpy:3244
translate turkish e6_s2_bueno_01f57e05:

    # maruo "Aún no hay nada que agradecer."
    # english: maruo "There is nothing to thank me for yet."
    maruo "Aún no hay nada que agradecer."

# game/02_cap1_evento6.rpy:3262
translate turkish e6_cinco_bb6ecf9b:

    # narrador "Esperé a que ellas salieran."
    # english: narrador "I waited for them to come out."
    narrador "Esperé a que ellas salieran."

# game/02_cap1_evento6.rpy:3264
