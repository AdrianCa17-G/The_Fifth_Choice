    # ichika "¿Todo bien? Yo estoy bien. Que conste."
    # english: ichika "Everything okay? I'm fine. Just so you know."
    ichika "¿Todo bien? Yo estoy bien. Que conste."

# game/02_cap1_evento6.rpy:3448
translate turkish e6_ichika_eco_fria_b9869f2e:

    # mc "No te lo había preguntado."
    # english: mc "I didn't ask."
    mc "No te lo había preguntado."

# game/02_cap1_evento6.rpy:3452
translate turkish e6_ichika_eco_fria_b0dcefa4:

    # ichika "Ya. Lo dije por si acaso."
    # english: ichika "Right. I said it just in case."
    ichika "Ya. Lo dije por si acaso."

