# game/02_cap1_evento6.rpy:4775
translate turkish e6_retrato_f4eadef5:

    # mc_pensamiento "No era una batalla."
    # english: mc_pensamiento "It wasn't a battle."
    mc_pensamiento "No era una batalla."

# game/02_cap1_evento6.rpy:4777
translate turkish e6_retrato_ecd6fdff:

    # mc_pensamiento "Todavía no sé qué era."
    # english: mc_pensamiento "I still don't know what it was."
    mc_pensamiento "Todavía no sé qué era."

# game/02_cap1_evento6.rpy:4779
translate turkish e6_retrato_efe023dc:

    # mc_pensamiento "Pero el lunes vuelvo a tocar esa puerta."
