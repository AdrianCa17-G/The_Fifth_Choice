    # english: narrador "In this room I always end up waiting in silence."
    narrador "En esta sala siempre me toca esperar en silencio."

# game/02_cap1_evento6.rpy:3268
translate turkish e6_cinco_bfb9c098:

    # narrador "Conocía ese ruido de puertas abriéndose una por una. Lo recordaba terminando peor."
    # english: narrador "I knew that sound of doors opening one by one. I remembered it ending worse."
    narrador "Conocía ese ruido de puertas abriéndose una por una. Lo recordaba terminando peor."

# game/02_cap1_evento6.rpy:3279
