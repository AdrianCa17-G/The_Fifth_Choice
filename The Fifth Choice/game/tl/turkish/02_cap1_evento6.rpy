    # ichika "Era un chiste. ...Era un chiste, ¿verdad?"
    # english: ichika "It was a joke. ...It was a joke, right?"
    ichika "Era un chiste. ...Era un chiste, ¿verdad?"

# game/02_cap1_evento6.rpy:3431
translate turkish e6_ichika_eco_tibia_a932999b:

    # mc "Era un chiste."
    # english: mc "It was a joke."
    mc "Era un chiste."

# game/02_cap1_evento6.rpy:3433
translate turkish e6_ichika_eco_tibia_c4678924:

    # ichika "Eso pensaba yo."
    # english: ichika "That's what I thought."
    ichika "Eso pensaba yo."

# game/02_cap1_evento6.rpy:3442
translate turkish e6_ichika_eco_fria_addb9013:

    # narrador "Ichika salió a la hora exacta, con la sonrisa puesta, como todo lo demás."
