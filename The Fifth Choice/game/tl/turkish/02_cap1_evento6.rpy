translate turkish e6_lunes_63d6f30e:

    # itsuki "Lo repito, lo reviso, lo repito otra vez. ...Siempre llego a la misma cifra."
    # english: itsuki "I repeat it, I check it, I repeat it again. ...I always land on the same number."
    itsuki "Lo repito, lo reviso, lo repito otra vez. ...Siempre llego a la misma cifra."

# game/02_cap1_evento6.rpy:440
translate turkish e6_lunes_a586989a:

    # itsuki "No pedí ayuda a nadie. Prefiero equivocarme sola que acertar con ayuda."
    # english: itsuki "I did not ask anyone for help. I would rather be wrong on my own than right with help."
    itsuki "No pedí ayuda a nadie. Prefiero equivocarme sola que acertar con ayuda."

# game/02_cap1_evento6.rpy:442
translate turkish e6_lunes_6b75f5ee:

    # itsuki "Dijiste «sin excepción». Me lo tomo en serio. Tú también deberías."
    # english: itsuki "You said \"no exceptions.\" I am taking that seriously. So should you."
    itsuki "Dijiste «sin excepción». Me lo tomo en serio. Tú también deberías."

# game/02_cap1_evento6.rpy:451
translate turkish e6_lunes_0330e5a8:

    # nino "Treinta días. Y sigues viniendo. ...No digo nada más."
    # english: nino "Thirty days. And you keep showing up. ...I'm not saying anything else."
    nino "Treinta días. Y sigues viniendo. ...No digo nada más."

# game/02_cap1_evento6.rpy:453
translate turkish e6_lunes_e48cacf4:

    # nino "Y no pongas esa cara. Yo no dije nada. Los números hablan solos."
    # english: nino "And don't make that face. I didn't say anything. The numbers speak for themselves."
    nino "Y no pongas esa cara. Yo no dije nada. Los números hablan solos."

# game/02_cap1_evento6.rpy:455
translate turkish e6_lunes_738b6ca9:

    # nino "Repasé inglés leyendo etiquetas en voz baja."
    # english: nino "I reviewed English by reading labels under my breath."
    nino "Repasé inglés leyendo etiquetas en voz baja."

# game/02_cap1_evento6.rpy:457
translate turkish e6_lunes_2038c8c3:

    # nino "...Si me viste mover los labios en el súper, no viste nada."
    # english: nino "...If you saw me moving my lips at the supermarket, you didn't see anything."
    nino "...Si me viste mover los labios en el súper, no viste nada."

# game/02_cap1_evento6.rpy:459
translate turkish e6_lunes_7765113d:

    # nino "Y la próxima vez que quieras dar un discurso, baja la voz. Se oyó hasta el pasillo."
    # english: nino "And next time you feel like giving a speech, lower your voice. They heard you in the hallway."
    nino "Y la próxima vez que quieras dar un discurso, baja la voz. Se oyó hasta el pasillo."

# game/02_cap1_evento6.rpy:465
translate turkish e6_lunes_fec365fb:

    # nino "No viniste a buscarme y tampoco te fuiste. ...No es un cumplido. No lo repitas."
    # english: nino "You didn't come find me, and you didn't leave. ...That's not a compliment. Don't repeat it."
    nino "No viniste a buscarme y tampoco te fuiste. ...No es un cumplido. No lo repitas."

# game/02_cap1_evento6.rpy:467
translate turkish e6_lunes_7e14c42a:

    # nino "Repasé inglés sola, con las etiquetas de la cocina, en voz baja. ...Nadie me escuchó. Mejor para mí."
    # english: nino "I reviewed English alone, with the labels in the kitchen, under my breath. ...Nobody heard me. Good."
    nino "Repasé inglés sola, con las etiquetas de la cocina, en voz baja. ...Nadie me escuchó. Mejor para mí."

# game/02_cap1_evento6.rpy:469
translate turkish e6_lunes_d0ee5cfd:

    # nino "Y no, no te estaba esperando. ...Solo contaba los días."
    # english: nino "And no, I wasn't waiting for you. ...I was just counting the days."
    nino "Y no, no te estaba esperando. ...Solo contaba los días."

# game/02_cap1_evento6.rpy:471
translate turkish e6_lunes_789c777c:

    # nino "Ahora cállate un momento y déjame repasar la última página."
    # english: nino "Now shut up for a second and let me review the last page."
    nino "Ahora cállate un momento y déjame repasar la última página."

# game/02_cap1_evento6.rpy:479
translate turkish e6_lunes_6d9713c5:

    # narrador "Me miraron las cinco. Esperaban una frase para terminar."
    # english: narrador "All five of them looked at me. They were waiting for a line to close things out."
    narrador "Me miraron las cinco. Esperaban una frase para terminar."

# game/02_cap1_evento6.rpy:481
translate turkish e6_lunes_ce3ae9ef:

    # mc_pensamiento "Hace un mes no tenía nada que decirles que no fuera mentira."
    # english: mc_pensamiento "A month ago, I had nothing to tell them that wasn't a lie."
    mc_pensamiento "Hace un mes no tenía nada que decirles que no fuera mentira."

# game/02_cap1_evento6.rpy:483
translate turkish e6_lunes_baf693ee:

    # mc_pensamiento "Hoy sí. Cada una sabe algo, y yo ya sé que lo saben."
    # english: mc_pensamiento "Today I do. Each of them knows something, and I know they know it."
    mc_pensamiento "Hoy sí. Cada una sabe algo, y yo ya sé que lo saben."

# game/02_cap1_evento6.rpy:485
translate turkish e6_lunes_2e619dfc:

    # mc "Hagan lo que saben."
    # english: mc "Do what you know."
    mc "Hagan lo que saben."

# game/02_cap1_evento6.rpy:487
translate turkish e6_lunes_54dac2ff:

    # narrador "Pensé en cada una al decirlo."
    # english: narrador "I thought of each of them as I said it."
    narrador "Pensé en cada una al decirlo."

# game/02_cap1_evento6.rpy:491
translate turkish e6_lunes_1fd7eb4b:

    # narrador "Sentí que ya había dicho esa frase antes."
    # english: narrador "I felt like I'd said that line before."
    narrador "Sentí que ya había dicho esa frase antes."

# game/02_cap1_evento6.rpy:493
translate turkish e6_lunes_ae6b60e5:

    # narrador "Con otro verbo, y con otro final."
    # english: narrador "With a different verb, and a different ending."
    narrador "Con otro verbo, y con otro final."

# game/02_cap1_evento6.rpy:500
translate turkish e6_lunes_f0c83117:

    # profe "Bien, todos a sus pupitres."
    # english: profe "All right, everyone to your desks."
    profe "Bien, todos a sus pupitres."

# game/02_cap1_evento6.rpy:502
translate turkish e6_lunes_4cec2adf:

    # profe "Volteen las hojas de sus exámenes."
    # english: profe "Turn over your exam papers."
    profe "Volteen las hojas de sus exámenes."

# game/02_cap1_evento6.rpy:504
translate turkish e6_lunes_a6ed7813:

    # profe "Pueden empezar."
    # english: profe "You may begin."
    profe "Pueden empezar."

# game/02_cap1_evento6.rpy:509
translate turkish e6_lunes_fd57a51b:

    # narrador "Y así empezaron los exámenes."
    # english: narrador "And that's how the exams began."
    narrador "Y así empezaron los exámenes."

# game/02_cap1_evento6.rpy:511
translate turkish e6_lunes_066b49ee:

    # narrador "Ellas, sentadas delante y concentradas."
    # english: narrador "Them, sitting up front, concentrating."
    narrador "Ellas, sentadas delante y concentradas."

# game/02_cap1_evento6.rpy:513
translate turkish e6_lunes_839ca285:

    # narrador "Cada día, un examen. Cada día terminaba el mío antes de la mitad del tiempo."
    # english: narrador "One exam a day. Every day I finished mine before half the time was up."
    narrador "Cada día, un examen. Cada día terminaba el mío antes de la mitad del tiempo."

# game/02_cap1_evento6.rpy:515
translate turkish e6_lunes_5b34fa6b:

    # mc_pensamiento "Pero siempre me quedaba por ellas."
    # english: mc_pensamiento "But I always stayed for them."
    mc_pensamiento "Pero siempre me quedaba por ellas."

# game/02_cap1_evento6.rpy:517
translate turkish e6_lunes_a41ade50:

    # mc_pensamiento "Siempre me quedaba por una a quien mirar."
    # english: mc_pensamiento "There was always someone to watch."
    mc_pensamiento "Siempre me quedaba por una a quien mirar."

# game/02_cap1_evento6.rpy:519
translate turkish e6_lunes_80fcb7c8:

    # narrador "En un examen nadie habla. Eso no quiere decir que nadie piense."
    # english: narrador "Nobody talks during an exam. That doesn't mean nobody's thinking."
    narrador "En un examen nadie habla. Eso no quiere decir que nadie piense."

# game/02_cap1_evento6.rpy:532
translate turkish e6_s1_superado_ee044c9d:

    # mc_pensamiento "«Si una sola reprueba, se acabó.» Maruo lo dijo en la cocina y no lo repitió."
    # english: mc_pensamiento "\"If even one of them fails, it's over.\" Maruo said it in the kitchen and never said it again."
    mc_pensamiento "«Si una sola reprueba, se acabó.» Maruo lo dijo en la cocina y no lo repitió."

# game/02_cap1_evento6.rpy:534
translate turkish e6_s1_superado_58aad197:

    # mc_pensamiento "Con Maruo no hacía falta: lo iba a cumplir."
    # english: mc_pensamiento "With Maruo there was no need: he'd follow through."
    mc_pensamiento "Con Maruo no hacía falta: lo iba a cumplir."

# game/02_cap1_evento6.rpy:536
translate turkish e6_s1_superado_83614afa:

    # mc_pensamiento "Cinco exámenes, cinco días, y esa frase dándome vueltas en cada uno."
    # english: mc_pensamiento "Five exams, five days, and that line going round my head through each one."
    mc_pensamiento "Cinco exámenes, cinco días, y esa frase dándome vueltas en cada uno."

# game/02_cap1_evento6.rpy:538
translate turkish e6_s1_superado_ac02f513:

    # mc_pensamiento "Hace un mes comencé este trabajo con una palabra clavada: despedido."
    # english: mc_pensamiento "A month ago I started this job with one word stuck in my head: fired."
    mc_pensamiento "Hace un mes comencé este trabajo con una palabra clavada: despedido."

# game/02_cap1_evento6.rpy:540
translate turkish e6_s1_superado_b1c20f3c:

    # mc_pensamiento "Hoy entro pensando en cinco nombres. La palabra sigue ahí."
    # english: mc_pensamiento "Today I walk in thinking about five names. The word is still there."
    mc_pensamiento "Hoy entro pensando en cinco nombres. La palabra sigue ahí."

# game/02_cap1_evento6.rpy:542
translate turkish e6_s1_superado_eac5d090:

    # mc_pensamiento "La diferencia es que ahora sé quién está detrás de cada hoja."
    # english: mc_pensamiento "The difference is that now I know who's behind each sheet of paper."
    mc_pensamiento "La diferencia es que ahora sé quién está detrás de cada hoja."

# game/02_cap1_evento6.rpy:549
translate turkish e6_s1_mixto_92b37e23:

    # mc_pensamiento "En treinta días no se conoce a nadie. Al menos ya no soy un desconocido."
    # english: mc_pensamiento "Thirty days isn't enough to know anyone. At least I'm not a stranger anymore."
    mc_pensamiento "En treinta días no se conoce a nadie. Al menos ya no soy un desconocido."

# game/02_cap1_evento6.rpy:551
translate turkish e6_s1_mixto_0e7465e3:

    # mc_pensamiento "No sé si fue suficiente. Es todo lo que puedo decir."
    # english: mc_pensamiento "I don't know if it was enough. That's all I can say."
    mc_pensamiento "No sé si fue suficiente. Es todo lo que puedo decir."

# game/02_cap1_evento6.rpy:553
translate turkish e6_s1_mixto_bafe5677:

    # mc_pensamiento "Esta vez no pienso en el despido. Pienso en un número: cinco."
    # english: mc_pensamiento "This time I'm not thinking about getting fired. I'm thinking of a number: five."
    mc_pensamiento "Esta vez no pienso en el despido. Pienso en un número: cinco."

# game/02_cap1_evento6.rpy:555
translate turkish e6_s1_mixto_fa1e4250:

    # mc_pensamiento "Cinco exámenes que no puedo corregir, ni acompañar, ni adelantar."
    # english: mc_pensamiento "Five exams I can't correct, sit through with them, or get ahead of."
    mc_pensamiento "Cinco exámenes que no puedo corregir, ni acompañar, ni adelantar."

# game/02_cap1_evento6.rpy:557
translate turkish e6_s1_mixto_72cb8a8c:

    # mc_pensamiento "Hoy les toca a ellas, no a mí."
    # english: mc_pensamiento "Today it's on them, not me."
    mc_pensamiento "Hoy les toca a ellas, no a mí."

# game/02_cap1_evento6.rpy:564
translate turkish e6_s1_bueno_d278495e:

    # mc_pensamiento "Por primera vez en un mes, no me sudan las manos al cruzar la puerta del instituto."
    # english: mc_pensamiento "For the first time in a month, my hands aren't sweating when I walk through the school gate."
    mc_pensamiento "Por primera vez en un mes, no me sudan las manos al cruzar la puerta del instituto."

# game/02_cap1_evento6.rpy:566
translate turkish e6_s1_bueno_af743a61:

    # mc_pensamiento "Las conozco. No a todas igual, pero lo bastante para saber qué se les da bien."
    # english: mc_pensamiento "I know them. Not all of them equally, but well enough to know what each one is good at."
    mc_pensamiento "Las conozco. No a todas igual, pero lo bastante para saber qué se les da bien."

# game/02_cap1_evento6.rpy:568
translate turkish e6_s1_bueno_086fd6ee:

    # mc_pensamiento "Eso no garantiza nada. Lo sé. Una nota es una nota."
    # english: mc_pensamiento "That doesn't guarantee anything. I know. A grade is a grade."
    mc_pensamiento "Eso no garantiza nada. Lo sé. Una nota es una nota."

# game/02_cap1_evento6.rpy:570
translate turkish e6_s1_bueno_3bad88a8:

    # mc_pensamiento "Pero esta mañana las veo de otra forma."
    # english: mc_pensamiento "But this morning I see them differently."
    mc_pensamiento "Pero esta mañana las veo de otra forma."

# game/02_cap1_evento6.rpy:572
translate turkish e6_s1_bueno_7a14b625:

    # mc_pensamiento "Sé cómo estudia cada una. Y qué hace cuando se atasca."
    # english: mc_pensamiento "I know how each of them studies. And what she does when she gets stuck."
    mc_pensamiento "Sé cómo estudia cada una. Y qué hace cuando se atasca."

# game/02_cap1_evento6.rpy:574
translate turkish e6_s1_bueno_23803015:

    # mc_pensamiento "Qué raro. Me da más miedo ahora que antes."
    # english: mc_pensamiento "Funny. I'm more scared now than before."
    mc_pensamiento "Qué raro. Me da más miedo ahora que antes."

# game/02_cap1_evento6.rpy:576
translate turkish e6_s1_bueno_951150d6:

    # mc_pensamiento "Pero confío en ellas."
    # english: mc_pensamiento "But I trust them."
    mc_pensamiento "Pero confío en ellas."

# game/02_cap1_evento6.rpy:594
translate turkish e6_yotsuba_nucleo_05af3783:

    # narrador "Lunes. Japonés. La primera prueba de cinco."
    # english: narrador "Monday. Japanese. The first of five exams."
    narrador "Lunes. Japonés. La primera prueba de cinco."

# game/02_cap1_evento6.rpy:596
translate turkish e6_yotsuba_nucleo_8e3a8dda:

    # narrador "Mi pupitre quedaba en la segunda fila, junto al pasillo."
    # english: narrador "My desk was in the second row, by the hallway."
    narrador "Mi pupitre quedaba en la segunda fila, junto al pasillo."

# game/02_cap1_evento6.rpy:598
translate turkish e6_yotsuba_nucleo_08a64c86:

    # narrador "Terminé el mío antes de la mitad. Lo dejé boca abajo, con el lápiz encima."
    # english: narrador "I finished mine before the halfway mark. I put it face down with the pencil on top."
    narrador "Terminé el mío antes de la mitad. Lo dejé boca abajo, con el lápiz encima."

# game/02_cap1_evento6.rpy:600
translate turkish e6_yotsuba_nucleo_63c77a5f:

    # mc_pensamiento "Ahora solo me quedaba mirar."
    # english: mc_pensamiento "Now all I had to do was watch."
    mc_pensamiento "Ahora solo me quedaba mirar."

# game/02_cap1_evento6.rpy:602
translate turkish e6_yotsuba_nucleo_9fb97962:

    # narrador "Las cinco lo hacían a la vez; yo solo podía mirar a una."
    # english: narrador "All five were taking it at the same time, and I could only watch one."
    narrador "Las cinco lo hacían a la vez; yo solo podía mirar a una."

# game/02_cap1_evento6.rpy:604
translate turkish e6_yotsuba_nucleo_d40f2caf:

    # mc_pensamiento "A Yotsuba."
    # english: mc_pensamiento "Yotsuba."
    mc_pensamiento "A Yotsuba."

# game/02_cap1_evento6.rpy:606
translate turkish e6_yotsuba_nucleo_6dc7628f:

    # narrador "Yotsuba escribió su nombre primero. Siempre lo hace."
    # english: narrador "Yotsuba wrote her name first. She always does."
    narrador "Yotsuba escribió su nombre primero. Siempre lo hace."

# game/02_cap1_evento6.rpy:608
translate turkish e6_yotsuba_nucleo_9854f9e7:

    # mc_pensamiento "El uno por ciento del primer día, bien hecho. Esta vez era solo el principio de la hoja."
    # english: mc_pensamiento "The first day's one percent, done right. This time it was only the top of the page."
    mc_pensamiento "El uno por ciento del primer día, bien hecho. Esta vez era solo el principio de la hoja."

# game/02_cap1_evento6.rpy:617
translate turkish e6_yotsuba_mono_calida_4202f45a:

    # yotsuba_int "Pregunta uno. ¿Qué siente el protagonista cuando se queda solo?"
    # english: yotsuba_int "Question one. What does the main character feel when he's left alone?"
    yotsuba_int "Pregunta uno. ¿Qué siente el protagonista cuando se queda solo?"

# game/02_cap1_evento6.rpy:619
translate turkish e6_yotsuba_mono_calida_5ef0e62a:

    # yotsuba_int "Lo sé. Conté veintitrés vueltas sola, y alguien llevaba ocho mirándome."
    # english: yotsuba_int "I know this one. I counted twenty-three laps by myself, and someone watched eight of them."
    yotsuba_int "Lo sé. Conté veintitrés vueltas sola, y alguien llevaba ocho mirándome."

# game/02_cap1_evento6.rpy:621
translate turkish e6_yotsuba_mono_calida_8f58c1a7:

    # yotsuba_int "Me dijo que mis hermanas no hacen lo que yo hago. Que él tampoco. Y que lo intenta."
    # english: yotsuba_int "He said my sisters don't do what I do. That he doesn't either. And that he's trying."
    yotsuba_int "Me dijo que mis hermanas no hacen lo que yo hago. Que él tampoco. Y que lo intenta."

# game/02_cap1_evento6.rpy:623
translate turkish e6_yotsuba_mono_calida_d1760e3d:

    # yotsuba_int "Me dijo que mi punto de partida no era cero. Que nunca lo fue."
    # english: yotsuba_int "He said my starting point wasn't zero. That it never was."
    yotsuba_int "Me dijo que mi punto de partida no era cero. Que nunca lo fue."

# game/02_cap1_evento6.rpy:625
translate turkish e6_yotsuba_mono_calida_9d24b649:

    # yotsuba_int "Dijo que es pésimo animando a la gente. Y me animó igual."
    # english: yotsuba_int "He said he's terrible at cheering people up. And he cheered me up anyway."
    yotsuba_int "Dijo que es pésimo animando a la gente. Y me animó igual."

# game/02_cap1_evento6.rpy:627
translate turkish e6_yotsuba_mono_calida_57239c4d:

    # yotsuba_int "Veinticinco no es un número perfecto. Lo busqué: el perfecto es el veintiocho."
    # english: yotsuba_int "Twenty-five isn't a perfect number. I looked it up: the perfect one is twenty-eight."
    yotsuba_int "Veinticinco no es un número perfecto. Lo busqué: el perfecto es el veintiocho."

# game/02_cap1_evento6.rpy:629
translate turkish e6_yotsuba_mono_calida_fe46567d:

    # yotsuba_int "Sus divisores son uno, dos, cuatro, siete y catorce. Cinco números. Suman veintiocho."
    # english: yotsuba_int "Its divisors are one, two, four, seven and fourteen. Five numbers. They add up to twenty-eight."
    yotsuba_int "Sus divisores son uno, dos, cuatro, siete y catorce. Cinco números. Suman veintiocho."

# game/02_cap1_evento6.rpy:631
translate turkish e6_yotsuba_mono_calida_11d2ef5d:

    # yotsuba_int "Cinco números distintos, y ninguno sobra. Si falta uno, la cuenta no cierra."
    # english: yotsuba_int "Five different numbers, and none of them is extra. Take one out and the sum falls apart."
    yotsuba_int "Cinco números distintos, y ninguno sobra. Si falta uno, la cuenta no cierra."

# game/02_cap1_evento6.rpy:633
translate turkish e6_yotsuba_mono_calida_9b25486a:

    # yotsuba_int "Yo siempre pensé que era el uno. El más pequeño. El que nadie cuenta."
    # english: yotsuba_int "I always thought I was the one. The smallest. The one nobody counts."
    yotsuba_int "Yo siempre pensé que era el uno. El más pequeño. El que nadie cuenta."

# game/02_cap1_evento6.rpy:635
translate turkish e6_yotsuba_mono_calida_d080e071:

    # yotsuba_int "Vuelve al examen, Yotsuba. Despacio. Nadie te está cronometrando."
    # english: yotsuba_int "Back to the exam, Yotsuba. Slowly. Nobody's timing you."
    yotsuba_int "Vuelve al examen, Yotsuba. Despacio. Nadie te está cronometrando."

# game/02_cap1_evento6.rpy:637
translate turkish e6_yotsuba_mono_calida_345ee248:

    # yotsuba_int "Segunda pregunta. ¿Qué pasa cuando alguien llega para ayudarte?"
    # english: yotsuba_int "Question two. What happens when someone shows up to help you?"
    yotsuba_int "Segunda pregunta. ¿Qué pasa cuando alguien llega para ayudarte?"

# game/02_cap1_evento6.rpy:639
translate turkish e6_yotsuba_mono_calida_8dc8b737:

    # yotsuba_int "Esa no me la sé del todo. Creo que es como un relevo."
    # english: yotsuba_int "I don't totally know that one. I think it's like a relay."
    yotsuba_int "Esa no me la sé del todo. Creo que es como un relevo."

# game/02_cap1_evento6.rpy:641
translate turkish e6_yotsuba_mono_calida_d9d815e5:

    # yotsuba_int "Un relevo no se gana corriendo más que nadie. Se gana recibiendo bien."
    # english: yotsuba_int "You don't win a relay by running faster than everyone. You win it by taking the handoff well."
    yotsuba_int "Un relevo no se gana corriendo más que nadie. Se gana recibiendo bien."

# game/02_cap1_evento6.rpy:648
