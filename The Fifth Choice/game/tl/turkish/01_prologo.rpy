    # narrador "Hay dos clases de personas en este mundo."
    # english: narrador "There are two kinds of people in this world."
    narrador "Hay dos clases de personas en este mundo."

# game/01_prologo.rpy:65
translate turkish prologo_e2b506a5:

    # narrador "Las que pueden permitirse el lujo de equivocarse."
    # english: narrador "The ones who can afford to be wrong."
    narrador "Las que pueden permitirse el lujo de equivocarse."

# game/01_prologo.rpy:67
translate turkish prologo_53f29ec3:

    # narrador "Y las que no."
    # english: narrador "And the ones who can't."
    narrador "Y las que no."

# game/01_prologo.rpy:69
translate turkish prologo_2b8eb266:

    # mc_pensamiento "Yo pertenezco a la segunda."
    # english: mc_pensamiento "I belong to the second kind."
    mc_pensamiento "Yo pertenezco a la segunda."

# game/01_prologo.rpy:76
translate turkish prologo_9d86e401:

    # mc_pensamiento "Mi madre murió cuando yo era pequeño."
    # english: mc_pensamiento "My mother died when I was little."
    mc_pensamiento "Mi madre murió cuando yo era pequeño."

# game/01_prologo.rpy:78
translate turkish prologo_1d2a1938:

    # mc_pensamiento "El restaurante que abrió con mi padre cerró poco después. La deuda sigue ahí."
    # english: mc_pensamiento "The restaurant she opened with my father closed soon after. The debt's still here."
    mc_pensamiento "El restaurante que abrió con mi padre cerró poco después. La deuda sigue ahí."

# game/01_prologo.rpy:80
translate turkish prologo_6ca985c3:

    # mc_pensamiento "Mi padre hace fotos por encargo: bodas, graduaciones, lo que salga."
    # english: mc_pensamiento "My father takes photos for hire: weddings, graduations, whatever comes up."
    mc_pensamiento "Mi padre hace fotos por encargo: bodas, graduaciones, lo que salga."

# game/01_prologo.rpy:82
translate turkish prologo_87f24cdc:

    # mc_pensamiento "Él trabaja y yo estudio. Los dos, hasta el cansancio."
    # english: mc_pensamiento "He works and I study. Both of us, until we drop."
    mc_pensamiento "Él trabaja y yo estudio. Los dos, hasta el cansancio."

# game/01_prologo.rpy:84
translate turkish prologo_5120e485:

    # mc_pensamiento "(Aunque a veces eso no es suficiente para cubrir esta deuda...)"
    # english: mc_pensamiento "(Though sometimes even that isn't enough to cover this debt...)"
    mc_pensamiento "(Aunque a veces eso no es suficiente para cubrir esta deuda...)"

# game/01_prologo.rpy:86
translate turkish prologo_61dfff7b:

    # mc_pensamiento "Luego está Raiha, que, sin lugar a dudas, merece un futuro mejor que esta pobreza."
    # english: mc_pensamiento "And then there's Raiha, who deserves a better future than this. No question."
    mc_pensamiento "Luego está Raiha, que, sin lugar a dudas, merece un futuro mejor que esta pobreza."

# game/01_prologo.rpy:88
translate turkish prologo_067610ba:

    # mc_pensamiento "Por eso estudio."
    # english: mc_pensamiento "That's why I study."
    mc_pensamiento "Por eso estudio."

# game/01_prologo.rpy:90
translate turkish prologo_a5ee6bda:

    # mc_pensamiento "No por vocación o por esas cosas bonitas que dicen los profesores en las ceremonias de ingreso."
    # english: mc_pensamiento "Not out of passion, or whatever they tell you at entrance ceremonies."
    mc_pensamiento "No por vocación o por esas cosas bonitas que dicen los profesores en las ceremonias de ingreso."

# game/01_prologo.rpy:92
translate turkish prologo_8f60f29f:

    # mc_pensamiento "Estudio porque las notas son lo único que puedo controlar."
    # english: mc_pensamiento "I study because grades are the only thing I can control."
    mc_pensamiento "Estudio porque las notas son lo único que puedo controlar."

# game/01_prologo.rpy:97
translate turkish prologo_f11f2bd9:

    # mc_pensamiento "Esta pila de libros es la única herramienta que tengo para cambiar nuestra realidad."
    # english: mc_pensamiento "This stack of books is the only tool I have to change our situation."
    mc_pensamiento "Esta pila de libros es la única herramienta que tengo para cambiar nuestra realidad."

# game/01_prologo.rpy:99
translate turkish prologo_c0f406b4:

    # mc_pensamiento "Logré el primer puesto en el examen nacional. Otra vez."
    # english: mc_pensamiento "I took first place on the national exam. Again."
    mc_pensamiento "Logré el primer puesto en el examen nacional. Otra vez."

# game/01_prologo.rpy:101
translate turkish prologo_323874ec:

    # mc_pensamiento "No es como que me alegre, eso no llenará la nevera."
    # english: mc_pensamiento "It's not like I'm happy about it. It won't fill the fridge."
    mc_pensamiento "No es como que me alegre, eso no llenará la nevera."

# game/01_prologo.rpy:103
translate turkish prologo_e7b66fca:

    # narrador "De repente, una voz infantil interrumpió mis pensamientos intrusivos."
    # english: narrador "Then a little voice cut through my thoughts."
    narrador "De repente, una voz infantil interrumpió mis pensamientos intrusivos."

# game/01_prologo.rpy:105
translate turkish prologo_40cdc0a1:

    # raiha "¡Hermanito! ¡Baja a cenar de una vez!"
    # english: raiha "[mc]! Come down for dinner already!"
    raiha "¡Hermanito! ¡Baja a cenar de una vez!"

# game/01_prologo.rpy:107
translate turkish prologo_96f92b83:

    # mc "Dame un segundo, Raiha, ya mismo termino la tarea."
    # english: mc "Give me a second, Raiha. I'm almost done with my homework."
    mc "Dame un segundo, Raiha, ya mismo termino la tarea."

# game/01_prologo.rpy:109
translate turkish prologo_cc5096a3:

    # raiha "¡Llevas media hora con el mismo 'segundo'! ¡Y el curry no va a durar caliente para siempre!"
    # english: raiha "You've been saying \"a second\" for half an hour! And the curry won't stay hot forever!"
    raiha "¡Llevas media hora con el mismo 'segundo'! ¡Y el curry no va a durar caliente para siempre!"

# game/01_prologo.rpy:111
translate turkish prologo_c073fe57:

    # mc_pensamiento "(¿Curry? ¿Hoy no tocaba solo sopa de miso...?)"
    # english: mc_pensamiento "(Curry? Wasn't tonight just miso soup...?)"
    mc_pensamiento "(¿Curry? ¿Hoy no tocaba solo sopa de miso...?)"

# game/01_prologo.rpy:113
translate turkish prologo_8f568cb5:

    # mc "Está bien... Ya voy."
    # english: mc "Okay... I'm coming."
    mc "Está bien... Ya voy."

# game/01_prologo.rpy:115
translate turkish prologo_3ddc874f:

    # mc_pensamiento "Raiha. Mi hermana pequeña."
    # english: mc_pensamiento "Raiha. My little sister."
    mc_pensamiento "Raiha. Mi hermana pequeña."

# game/01_prologo.rpy:117
translate turkish prologo_a9fb71d7:

    # mc_pensamiento "La única persona en esta casa que sigue creyendo que las cosas pueden salir bien."
    # english: mc_pensamiento "The only person in this house who still believes things can work out."
    mc_pensamiento "La única persona en esta casa que sigue creyendo que las cosas pueden salir bien."

# game/01_prologo.rpy:119
translate turkish prologo_4bcf9c42:

    # mc_pensamiento "Y la única razón por la que no me he rendido todavía."
    # english: mc_pensamiento "And the only reason I haven't given up yet."
    mc_pensamiento "Y la única razón por la que no me he rendido todavía."

# game/01_prologo.rpy:126
translate turkish prologo_6a65ab78:

    # mc "Hoy es una noche especial. ¡Raiha preparó curry!"
    # english: mc "Tonight's a special night. Raiha made curry!"
    mc "Hoy es una noche especial. ¡Raiha preparó curry!"

# game/01_prologo.rpy:128
translate turkish prologo_5f9fd976:

    # mc_pensamiento "Para mucha gente, la cena es solo la cena."
    # english: mc_pensamiento "For a lot of people, dinner is just dinner."
    mc_pensamiento "Para mucha gente, la cena es solo la cena."

# game/01_prologo.rpy:130
translate turkish prologo_0ea7ab85:

    # mc_pensamiento "En esta casa es el único rato del día en que nadie hace cuentas."
    # english: mc_pensamiento "In this house, it's the only part of the day when nobody does the math."
    mc_pensamiento "En esta casa es el único rato del día en que nadie hace cuentas."

# game/01_prologo.rpy:132
translate turkish prologo_7dd3e132:

    # narrador "Ya en la mesa, devoré el plato en cuestión de segundos."
    # english: narrador "At the table, I wolfed it down in seconds."
    narrador "Ya en la mesa, devoré el plato en cuestión de segundos."

# game/01_prologo.rpy:137
translate turkish prologo_3169b299:

    # mc "¡Gracias por la comida!"
    # english: mc "Thanks for the food!"
    mc "¡Gracias por la comida!"

# game/01_prologo.rpy:139
translate turkish prologo_506cde3f:

    # raiha "Hermanito, hoy en la escuela dijeron que los hermanos mayores tienen que dar el ejemplo."
    # english: raiha "Big brother, at school today they said older siblings have to set an example."
    raiha "Hermanito, hoy en la escuela dijeron que los hermanos mayores tienen que dar el ejemplo."

# game/01_prologo.rpy:141
translate turkish prologo_6ffee215:

    # mc "¿En serio? Supongo que yo soy un ejemplo perfecto para ti... ¿no?"
    # english: mc "Really? I guess I'm the perfect example for you... right?"
    mc "¿En serio? Supongo que yo soy un ejemplo perfecto para ti... ¿no?"

# game/01_prologo.rpy:146
translate turkish prologo_c5fa1fc0:

    # raiha "¡Claro! El ejemplo de alguien que estudia todo el día y no duerme nada."
    # english: raiha "Of course! The example of someone who studies all day and never sleeps."
    raiha "¡Claro! El ejemplo de alguien que estudia todo el día y no duerme nada."

# game/01_prologo.rpy:148
translate turkish prologo_b5931cef:

    # mc "La parte de dormir es negociable."
    # english: mc "The sleeping part is negotiable."
    mc "La parte de dormir es negociable."

# game/01_prologo.rpy:150
translate turkish prologo_d61f09f0:

    # raiha "¡No lo es! ¡Cuidar tu salud durmiendo bien también es importante!"
    # english: raiha "It's not! Taking care of your health by sleeping well matters too!"
    raiha "¡No lo es! ¡Cuidar tu salud durmiendo bien también es importante!"

# game/01_prologo.rpy:155
translate turkish prologo_0104dad0:

    # raiha "...Anoche también te escuché pasar páginas a las 3."
    # english: raiha "...I heard you turning pages at 3 last night, too."
    raiha "...Anoche también te escuché pasar páginas a las 3."

# game/01_prologo.rpy:157
translate turkish prologo_2c0a1e35:

    # narrador "Lo dijo sin gritar, que en ella era prácticamente un susurro."
    # english: narrador "She said it without shouting, which for her was practically a whisper."
    narrador "Lo dijo sin gritar, que en ella era prácticamente un susurro."

# game/01_prologo.rpy:159
translate turkish prologo_f7473115:

    # mc_pensamiento "Se lo tomó tan en serio que casi me sentí culpable. Casi."
    # english: mc_pensamiento "She took it so seriously I almost felt guilty. Almost."
    mc_pensamiento "Se lo tomó tan en serio que casi me sentí culpable. Casi."

# game/01_prologo.rpy:170
translate turkish prologo_b531d1dc:

    # narrador "De repente, mi padre, Isanari, entró en el comedor y dejó caer un papel sobre la mesa."
    # english: narrador "Then my father, Isanari, walked into the dining room and dropped a paper on the table."
    narrador "De repente, mi padre, Isanari, entró en el comedor y dejó caer un papel sobre la mesa."

# game/01_prologo.rpy:178
translate turkish prologo_59c8b7e6:

    # isanari "[mc], tengo un trabajo para ti."
    # english: isanari "[mc], I've got a job for you."
    isanari "[mc], tengo un trabajo para ti."

# game/01_prologo.rpy:180
translate turkish prologo_c319e7e8:

    # mc "¿Un trabajo? ¿De qué tipo?"
    # english: mc "A job? What kind?"
    mc "¿Un trabajo? ¿De qué tipo?"

# game/01_prologo.rpy:182
translate turkish prologo_85cec063:

    # isanari "Uno legal, antes de que pongas esa cara."
    # english: isanari "A legal one, so lose that look."
    isanari "Uno legal, antes de que pongas esa cara."

# game/01_prologo.rpy:184
translate turkish prologo_5268c18b:

    # isanari "Un viejo amigo del instituto busca un tutor privado para su familia."
    # english: isanari "An old friend from high school is looking for a private tutor for his family."
    isanari "Un viejo amigo del instituto busca un tutor privado para su familia."

# game/01_prologo.rpy:186
translate turkish prologo_af3f74dc:

    # mc "¿Tutor privado?... Creo que esta vez paso."
    # english: mc "A private tutor?... I think I'll pass this time."
    mc "¿Tutor privado?... Creo que esta vez paso."

# game/01_prologo.rpy:188
translate turkish prologo_c41d5931:

    # mc "No me llama la atención y tampoco soy del tipo que sabe enseñarle a los demás."
    # english: mc "It doesn't interest me, and I'm not the type who knows how to teach others."
    mc "No me llama la atención y tampoco soy del tipo que sabe enseñarle a los demás."

# game/01_prologo.rpy:190
translate turkish prologo_3f63a0d4:

    # isanari "En eso tienes un punto, pero lo que sí te va a interesar es saber el pago."
    # english: isanari "Fair point. But you'll want to hear about the pay."
    isanari "En eso tienes un punto, pero lo que sí te va a interesar es saber el pago."

# game/01_prologo.rpy:194
translate turkish prologo_168a19e4:

    # mc_pensamiento "Al escuchar la palabra 'pago', puse la mayor atención posible."
    # english: mc_pensamiento "At the word \"pay,\" I gave him my full attention."
    mc_pensamiento "Al escuchar la palabra 'pago', puse la mayor atención posible."

# game/01_prologo.rpy:196
translate turkish prologo_d52d7491:

    # mc_pensamiento "(No es como que crea que el dinero lo es todo, pero en esta situación en la que nos encontramos...)"
    # english: mc_pensamiento "(It's not like I think money is everything, but in the situation we're in...)"
    mc_pensamiento "(No es como que crea que el dinero lo es todo, pero en esta situación en la que nos encontramos...)"

# game/01_prologo.rpy:198
translate turkish prologo_75d9ba81:

    # mc "¿De cuánto estamos hablando?"
    # english: mc "How much are we talking about?"
    mc "¿De cuánto estamos hablando?"

# game/01_prologo.rpy:202
translate turkish prologo_b6fade41:

    # isanari "Cinco veces la tarifa normal de un tutor."
    # english: isanari "Five times the going rate for a tutor."
    isanari "Cinco veces la tarifa normal de un tutor."

# game/01_prologo.rpy:204
translate turkish prologo_0c5eb183:

    # narrador "Hubo un silencio breve."
    # english: narrador "There was a brief silence."
    narrador "Hubo un silencio breve."

# game/01_prologo.rpy:206
translate turkish prologo_5afcf733:

    # narrador "Y a mí me delató: en mi cabeza ya había aceptado."
    # english: narrador "And it gave me away: in my head I'd already accepted."
    narrador "Y a mí me delató: en mi cabeza ya había aceptado."

# game/01_prologo.rpy:208
translate turkish prologo_2798abd1:

    # mc "...Entiendo. ¿Tienes más detalles?"
    # english: mc "...I see. Do you have more details?"
    mc "...Entiendo. ¿Tienes más detalles?"

# game/01_prologo.rpy:210
translate turkish prologo_e5b6dbd1:

    # isanari "Es una familia adinerada. Un solo domicilio y clases particulares hasta la graduación."
    # english: isanari "It's a wealthy family. One address, and private lessons until graduation."
    isanari "Es una familia adinerada. Un solo domicilio y clases particulares hasta la graduación."

# game/01_prologo.rpy:212
translate turkish prologo_566e7764:

    # mc_pensamiento "Suena demasiado perfecto... Seguro debe haber una trampa."
    # english: mc_pensamiento "Sounds too perfect... There must be a catch."
    mc_pensamiento "Suena demasiado perfecto... Seguro debe haber una trampa."

# game/01_prologo.rpy:214
translate turkish prologo_f0ff8817:

    # mc "¿Y el truco?"
    # english: mc "And the catch?"
    mc "¿Y el truco?"

# game/01_prologo.rpy:216
translate turkish prologo_5184b20c:

    # isanari "¿Por qué asumes que hay un truco?"
    # english: isanari "Why do you assume there's a catch?"
    isanari "¿Por qué asumes que hay un truco?"

# game/01_prologo.rpy:218
translate turkish prologo_52f773a3:

    # mc "Porque nadie paga cinco veces más por algo que se consigue por una."
    # english: mc "Because nobody pays five times more for something you can get for one."
    mc "Porque nadie paga cinco veces más por algo que se consigue por una."

# game/01_prologo.rpy:223
translate turkish prologo_f0fbb484:

    # narrador "Mi padre sonrió. Aquello significaba que el truco existía."
    # english: narrador "My father smiled. That meant the catch existed."
    narrador "Mi padre sonrió. Aquello significaba que el truco existía."

# game/01_prologo.rpy:225
translate turkish prologo_4f556a77:

    # narrador "Y que habría que descubrirlo por las buenas o por las malas."
    # english: narrador "And that we'd have to find it, the easy way or the hard way."
    narrador "Y que habría que descubrirlo por las buenas o por las malas."

# game/01_prologo.rpy:227
translate turkish prologo_fa56306c:

    # isanari "Detalles menores. Ya los verás."
    # english: isanari "Minor details. You'll see."
    isanari "Detalles menores. Ya los verás."

# game/01_prologo.rpy:229
translate turkish prologo_3973ed9c:

    # mc "Los detalles menores son los que arruinan los cálculos."
    # english: mc "It's the minor details that ruin the math."
    mc "Los detalles menores son los que arruinan los cálculos."

# game/01_prologo.rpy:231
translate turkish prologo_e7c0927d:

    # isanari "Entonces trátalo como un examen sorpresa. Se te dan bien."
    # english: isanari "Then treat it like a pop quiz. You're good at those."
    isanari "Entonces trátalo como un examen sorpresa. Se te dan bien."

# game/01_prologo.rpy:233
translate turkish prologo_094d2707:

    # mc_pensamiento "Sabe exactamente qué tecla tocar. Siempre lo ha sabido."
    # english: mc_pensamiento "He knows exactly which button to push. He always has."
    mc_pensamiento "Sabe exactamente qué tecla tocar. Siempre lo ha sabido."

# game/01_prologo.rpy:235
translate turkish prologo_da0272f9:

    # mc_pensamiento "Y siempre la toca cuando necesita algo de mí."
    # english: mc_pensamiento "And he always pushes it when he needs something from me."
    mc_pensamiento "Y siempre la toca cuando necesita algo de mí."

# game/01_prologo.rpy:240
translate turkish prologo_e4a846da:

    # raiha "¡Hermanito, deberías aceptar!"
    # english: raiha "[mc], you should say yes!"
    raiha "¡Hermanito, deberías aceptar!"

# game/01_prologo.rpy:242
translate turkish prologo_48273306:

    # raiha "¡Así podrías estudiar tranquilo sin andar contando cada cosa que compramos!"
    # english: raiha "That way you could study in peace without counting every single thing we buy!"
    raiha "¡Así podrías estudiar tranquilo sin andar contando cada cosa que compramos!"

# game/01_prologo.rpy:244
translate turkish prologo_b73b23b5:

    # mc "Me lo pensaré, Raiha."
    # english: mc "I'll think about it, Raiha."
    mc "Me lo pensaré, Raiha."

# game/01_prologo.rpy:248
translate turkish prologo_f75472bc:

    # mc_pensamiento "«Cada cosa que compramos». Lo dijo en plural."
    # english: mc_pensamiento "\"Every single thing we buy.\" She said \"we.\""
    mc_pensamiento "«Cada cosa que compramos». Lo dijo en plural."

# game/01_prologo.rpy:250
translate turkish prologo_c25f9ee6:

    # mc_pensamiento "Ella también hace las cuentas. Nunca le pedí que las hiciera."
    # english: mc_pensamiento "She does the math too. I never asked her to."
    mc_pensamiento "Ella también hace las cuentas. Nunca le pedí que las hiciera."

# game/01_prologo.rpy:252
translate turkish prologo_532324bd:

    # mc_pensamiento "No es el trabajo de mis sueños, pero..."
    # english: mc_pensamiento "It's not the job of my dreams, but..."
    mc_pensamiento "No es el trabajo de mis sueños, pero..."

# game/01_prologo.rpy:254
translate turkish prologo_c261d184:

    # mc_pensamiento "Voy a decir que sí. Lo que no tengo tan claro es por qué."
    # english: mc_pensamiento "I'm going to say yes. What I'm less sure of is why."
    mc_pensamiento "Voy a decir que sí. Lo que no tengo tan claro es por qué."

# game/01_prologo.rpy:259
translate turkish prologo_30d14a70:

    # mc_pensamiento "¿Qué es lo que me empuja, de verdad?" nointeract
    # english: mc_pensamiento "What's really pushing me?" nointeract
    mc_pensamiento "¿Qué es lo que me empuja, de verdad?" nointeract

# game/01_prologo.rpy:265
translate turkish prologo_f014e1da:

    # mc_pensamiento "No voy a fingir nobleza. Aceptaré por el dinero, y punto."
    # english: mc_pensamiento "I won't pretend to be noble. I'll take it for the money, period."
    mc_pensamiento "No voy a fingir nobleza. Aceptaré por el dinero, y punto."

# game/01_prologo.rpy:267
translate turkish prologo_7a536940:

    # mc_pensamiento "Las buenas intenciones no pagan las facturas."
    # english: mc_pensamiento "Good intentions don't pay the bills."
    mc_pensamiento "Las buenas intenciones no pagan las facturas."

# game/01_prologo.rpy:273
translate turkish prologo_9b4670df:

    # mc_pensamiento "Raiha ya hace cuentas a su edad."
    # english: mc_pensamiento "Raiha already does the math at her age."
    mc_pensamiento "Raiha ya hace cuentas a su edad."

# game/01_prologo.rpy:275
translate turkish prologo_5b66d214:

    # mc_pensamiento "Si alguien tiene que hacerlas en esta casa, que sea yo."
    # english: mc_pensamiento "If someone in this house has to do it, it should be me."
    mc_pensamiento "Si alguien tiene que hacerlas en esta casa, que sea yo."

# game/01_prologo.rpy:281
translate turkish prologo_e9dea1b1:

    # mc_pensamiento "Nunca he abandonado un problema a medio resolver."
    # english: mc_pensamiento "I've never abandoned a problem half-solved."
    mc_pensamiento "Nunca he abandonado un problema a medio resolver."

# game/01_prologo.rpy:283
translate turkish prologo_5da02c42:

    # mc_pensamiento "Y este no será la excepción."
    # english: mc_pensamiento "And this one won't be the exception."
    mc_pensamiento "Y este no será la excepción."

# game/01_prologo.rpy:286
