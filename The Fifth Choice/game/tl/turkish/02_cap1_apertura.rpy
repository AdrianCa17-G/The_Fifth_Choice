    # english: mc "A bit of both."
    mc "Un poco de las dos cosas."

# game/02_cap1_apertura.rpy:514
translate turkish cap1_apertura_d6871d44:

    # isanari "¿Qué tal el segundo día con esas alumnas?"
    # english: isanari "How was the second day with those students?"
    isanari "¿Qué tal el segundo día con esas alumnas?"

# game/02_cap1_apertura.rpy:519
translate turkish cap1_apertura_ff6c12d7:

