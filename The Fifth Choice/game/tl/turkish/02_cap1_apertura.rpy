translate turkish cap1_adivinanza_hermanas_9fe6d749:

    # raiha "O simplemente durmiendo la siesta en el sofá más cercano."
    # english: raiha "Or just napping on the nearest couch."
    raiha "O simplemente durmiendo la siesta en el sofá más cercano."

# game/02_cap1_apertura.rpy:720
translate turkish cap1_adivinanza_hermanas_7b9d7f37:

    # mc_pensamiento "Actuación... o pereza disfrazada de actuación."
    # english: mc_pensamiento "Acting... or laziness disguised as acting."
    mc_pensamiento "Actuación... o pereza disfrazada de actuación."

# game/02_cap1_apertura.rpy:722
translate turkish cap1_adivinanza_hermanas_43f05dae:

    # mc "¡Sí! Probablemente ahí hace sus audiciones."
    # english: mc "Yes! She probably does her auditions there."
    mc "¡Sí! Probablemente ahí hace sus audiciones."

# game/02_cap1_apertura.rpy:724
translate turkish cap1_adivinanza_hermanas_395e515e:

    # mc "Bien. Anotado."
    # english: mc "Fine. Noted."
    mc "Bien. Anotado."

# game/02_cap1_apertura.rpy:730
translate turkish cap1_adivinanza_hermanas_a1072453:

    # mc "Hay una que se llama {color=#C39BD3}{b}Nino{/b}{/color}."
    # english: mc "There's one named {color=#C39BD3}{b}Nino{/b}{/color}."
    mc "Hay una que se llama {color=#C39BD3}{b}Nino{/b}{/color}."

# game/02_cap1_apertura.rpy:732
translate turkish cap1_adivinanza_hermanas_e1c4474f:

    # mc "Es la segunda hermana de las cinco."
    # english: mc "She's the second sister of the five."
    mc "Es la segunda hermana de las cinco."

# game/02_cap1_apertura.rpy:734
translate turkish cap1_adivinanza_hermanas_56329983:

    # mc "Manda sobre las demás."
    # english: mc "She bosses the others around."
    mc "Manda sobre las demás."

# game/02_cap1_apertura.rpy:736
translate turkish cap1_adivinanza_hermanas_b5d14cec:

    # mc "Y es muy rigurosa con las cosas."
    # english: mc "And she's very strict about things."
    mc "Y es muy rigurosa con las cosas."

# game/02_cap1_apertura.rpy:738
translate turkish cap1_adivinanza_hermanas_986693cb:

    # mc "Hasta me corrigió mi pronunciación en inglés."
    # english: mc "She even corrected my English pronunciation."
    mc "Hasta me corrigió mi pronunciación en inglés."

# game/02_cap1_apertura.rpy:740
translate turkish cap1_adivinanza_hermanas_c91163b2:

    # raiha "¡Uy, esa suena a hermana mayor de verdad!"
    # english: raiha "Ooh, that sounds like a real big sister!"
    raiha "¡Uy, esa suena a hermana mayor de verdad!"

# game/02_cap1_apertura.rpy:742
translate turkish cap1_adivinanza_hermanas_eb572624:

    # raiha "Es como yo cuando te regaño. ¡Pero enojona todo el día!"
    # english: raiha "She's like me when I scold you. But cranky all day long!"
    raiha "Es como yo cuando te regaño. ¡Pero enojona todo el día!"

# game/02_cap1_apertura.rpy:744
translate turkish cap1_adivinanza_hermanas_4f0cbbf2:

    # raiha "Con esa actitud de jefa, seguro anda revisando que no falte nada en casa..."
    # english: raiha "With that boss attitude, she's probably checking that nothing's missing at home..."
