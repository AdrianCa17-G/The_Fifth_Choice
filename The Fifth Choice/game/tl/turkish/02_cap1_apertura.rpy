    raiha "Capaz la encuentras en el {color=#9B6FB8}{b}centro comercial{/b}{/color}, comprando lo que las demás olvidaron."

# game/02_cap1_apertura.rpy:749
translate turkish cap1_adivinanza_hermanas_46fb98f6:

    # mc_pensamiento "Centro comercial... Tiene sentido, viniendo de ella."
    # english: mc_pensamiento "The mall... makes sense, coming from her."
    mc_pensamiento "Centro comercial... Tiene sentido, viniendo de ella."

# game/02_cap1_apertura.rpy:751
translate turkish cap1_adivinanza_hermanas_395e515e_1:

    # mc "Bien. Anotado."
    # english: mc "Fine. Noted."
    mc "Bien. Anotado."

# game/02_cap1_apertura.rpy:757
translate turkish cap1_adivinanza_hermanas_ff8c7736:

