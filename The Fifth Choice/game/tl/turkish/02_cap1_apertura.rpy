    # english: raiha "Just tell me what each one is like and I'll tell you where I'd look for her."
    raiha "Tú solo cuéntame cómo es cada una y yo te digo dónde la buscaría."

# game/02_cap1_apertura.rpy:691
translate turkish cap1_apertura_72163378:

    # raiha "¡Como un juego de adivinanzas!"
    # english: raiha "Like a guessing game!"
    raiha "¡Como un juego de adivinanzas!"

# game/02_cap1_apertura.rpy:693
translate turkish cap1_apertura_5c9f33bf:

    # mc_pensamiento "No pierdo nada con intentarlo."
    # english: mc_pensamiento "Nothing to lose by trying."
    mc_pensamiento "No pierdo nada con intentarlo."

