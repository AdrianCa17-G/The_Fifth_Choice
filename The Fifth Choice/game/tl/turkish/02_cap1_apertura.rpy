translate turkish cap1_apertura_12c02aa3:

    # mc "Tengo una duda algo rara."
    # english: mc "I've got a slightly weird question."
    mc "Tengo una duda algo rara."

# game/02_cap1_apertura.rpy:683
translate turkish cap1_apertura_c4e68d2b:

    # mc "Si tuvieras que adivinar dónde suele estar cada una de esas chicas después de estudiar."
    # english: mc "If you had to guess where each of those girls usually hangs out after studying."
