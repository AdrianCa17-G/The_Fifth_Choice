translate turkish cap1_apertura_5b1a04c0:

    # raiha "¿Y son tontas?"
    # english: raiha "And are they dumb?"
    raiha "¿Y son tontas?"

# game/02_cap1_apertura.rpy:647
translate turkish cap1_apertura_fca52711:

    # mc "No."
    # english: mc "No."
    mc "No."

# game/02_cap1_apertura.rpy:649
translate turkish cap1_apertura_969225d3:

    # narrador "Contesté antes de pensarlo, y me di cuenta de que lo decía en serio."
    # english: narrador "I answered before thinking, and realized I meant it."
    narrador "Contesté antes de pensarlo, y me di cuenta de que lo decía en serio."

# game/02_cap1_apertura.rpy:651
translate turkish cap1_apertura_e239353d:

