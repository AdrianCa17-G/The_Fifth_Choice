# game/02_cap1_apertura.rpy:533
translate turkish cap1_apertura_d92d1190:

    # mc "Todavía no lo sé. Pero pienso averiguarlo."
    # english: mc "I don't know yet. But I plan to find out."
    mc "Todavía no lo sé. Pero pienso averiguarlo."

# game/02_cap1_apertura.rpy:539
translate turkish cap1_apertura_04ff9120:

    # isanari "Cinco cabezas puestas de acuerdo contra una... suena a un problema serio."
    # english: isanari "Five of them against you... sounds like a serious problem."
    isanari "Cinco cabezas puestas de acuerdo contra una... suena a un problema serio."

# game/02_cap1_apertura.rpy:541
translate turkish cap1_apertura_5776ad29:

    # isanari "Me recuerda a mí en el instituto."
    # english: isanari "Reminds me of me in high school."
    isanari "Me recuerda a mí en el instituto."

# game/02_cap1_apertura.rpy:543
translate turkish cap1_apertura_8fc4a755:

    # isanari "Solo que yo era uno contra todos los profesores."
    # english: isanari "Except I was one against all the teachers."
    isanari "Solo que yo era uno contra todos los profesores."

# game/02_cap1_apertura.rpy:545
translate turkish cap1_apertura_5d1e4b1d:

    # mc "No ayudas."
    # english: mc "You're not helping."
    mc "No ayudas."

# game/02_cap1_apertura.rpy:549
translate turkish cap1_apertura_1f75e8a9:

    # mc "Va bien. Dentro de lo que cabe esperar de un segundo día."
    # english: mc "It's going fine. As fine as you can expect from a second day."
    mc "Va bien. Dentro de lo que cabe esperar de un segundo día."

# game/02_cap1_apertura.rpy:551
translate turkish cap1_apertura_e7a49f72:

    # isanari "Ya veo. No sonaste muy convencido al decirlo."
    # english: isanari "I see. You didn't sound very convinced saying it."
    isanari "Ya veo. No sonaste muy convencido al decirlo."

# game/02_cap1_apertura.rpy:553
translate turkish cap1_apertura_ef219105:

    # mc "Es solo cansancio, ya te dije."
    # english: mc "It's just tiredness, I told you."
    mc "Es solo cansancio, ya te dije."

# game/02_cap1_apertura.rpy:559
translate turkish cap1_apertura_67ed0f99:

    # raiha "¡A mí no me engañas! ¡Se te nota en la cara que algo pasó!"
    # english: raiha "You can't fool me! It's written all over your face that something happened!"
    raiha "¡A mí no me engañas! ¡Se te nota en la cara que algo pasó!"

# game/02_cap1_apertura.rpy:563
translate turkish cap1_apertura_962da9d7:

    # mc "¿Podemos hablar de otra cosa?"
    # english: mc "Can we talk about something else?"
    mc "¿Podemos hablar de otra cosa?"

# game/02_cap1_apertura.rpy:565
translate turkish cap1_apertura_110d3457:

    # mc "No quiero pensar en eso ahora mismo."
    # english: mc "I don't want to think about it right now."
    mc "No quiero pensar en eso ahora mismo."

# game/02_cap1_apertura.rpy:567
translate turkish cap1_apertura_ed1a9ad3:

    # isanari "Como quieras, [mc]. No voy a insistir."
    # english: isanari "Whatever you like, [mc]. I won't push."
    isanari "Como quieras, [mc]. No voy a insistir."

# game/02_cap1_apertura.rpy:573
translate turkish cap1_apertura_a4a22747:

    # raiha "¡Yo sí insisto un poquito! Pero está bien, lo dejo por hoy."
    # english: raiha "I'll push a little! But fine, I'll let it go for today."
    raiha "¡Yo sí insisto un poquito! Pero está bien, lo dejo por hoy."

# game/02_cap1_apertura.rpy:580
translate turkish cap1_apertura_4db67c58:

    # isanari "Solo recuerda que un mes no es mucho tiempo."
    # english: isanari "Just remember, a month isn't much time."
    isanari "Solo recuerda que un mes no es mucho tiempo."

# game/02_cap1_apertura.rpy:582
translate turkish cap1_apertura_caf46305:

    # isanari "Y que le di mi palabra a Maruo."
    # english: isanari "And that I gave Maruo my word."
    isanari "Y que le di mi palabra a Maruo."

# game/02_cap1_apertura.rpy:584
translate turkish cap1_apertura_85a5a5c8:

    # mc "Lo sé. No hace falta que me lo recuerdes."
    # english: mc "I know. You don't have to remind me."
    mc "Lo sé. No hace falta que me lo recuerdes."

# game/02_cap1_apertura.rpy:586
translate turkish cap1_apertura_569ae05b:

    # isanari "Tómalo como otro examen sorpresa."
    # english: isanari "Think of it as another pop quiz."
    isanari "Tómalo como otro examen sorpresa."

# game/02_cap1_apertura.rpy:588
translate turkish cap1_apertura_df102e71:

    # mc_pensamiento "Otra vez con esa frase..."
    # english: mc_pensamiento "That line again..."
    mc_pensamiento "Otra vez con esa frase..."

# game/02_cap1_apertura.rpy:590
translate turkish cap1_apertura_b4ff2ac7:

    # mc_pensamiento "Aunque esta vez tiene más razón de la que me gustaría admitir."
    # english: mc_pensamiento "Though this time it has more truth to it than I'd like to admit."
    mc_pensamiento "Aunque esta vez tiene más razón de la que me gustaría admitir."

# game/02_cap1_apertura.rpy:592
translate turkish cap1_apertura_93d7d23b:

    # narrador "Terminada la cena, subí a mi habitación con las cinco hojas bajo el brazo."
    # english: narrador "After dinner, I went up to my room with the five sheets under my arm."
    narrador "Terminada la cena, subí a mi habitación con las cinco hojas bajo el brazo."

# game/02_cap1_apertura.rpy:610
translate turkish cap1_apertura_8e22470c:

    # narrador "Puse las cinco hojas sobre el escritorio y las dejé ahí un buen rato sin tocarlas."
    # english: narrador "I laid the five sheets on the desk and left them there a good while without touching them."
    narrador "Puse las cinco hojas sobre el escritorio y las dejé ahí un buen rato sin tocarlas."

# game/02_cap1_apertura.rpy:612
translate turkish cap1_apertura_0ac2ca61:

    # mc_pensamiento "Ayer pensé que el problema era que no querían estudiar."
    # english: mc_pensamiento "Yesterday I thought the problem was that they didn't want to study."
    mc_pensamiento "Ayer pensé que el problema era que no querían estudiar."

# game/02_cap1_apertura.rpy:614
translate turkish cap1_apertura_b7c23c57:

    # mc_pensamiento "Hoy sé que el problema es otro."
    # english: mc_pensamiento "Today I know the problem is something else."
    mc_pensamiento "Hoy sé que el problema es otro."

# game/02_cap1_apertura.rpy:616
translate turkish cap1_apertura_a7979382:

    # mc_pensamiento "Sí pueden. Se están defendiendo."
    # english: mc_pensamiento "They can. They're defending themselves."
    mc_pensamiento "Sí pueden. Se están defendiendo."

# game/02_cap1_apertura.rpy:618
translate turkish cap1_apertura_342d9666:

    # mc_pensamiento "Y se defienden juntas."
    # english: mc_pensamiento "And they defend themselves together."
    mc_pensamiento "Y se defienden juntas."

# game/02_cap1_apertura.rpy:628
translate turkish cap1_apertura_478b6054:

    # raiha "Hermanito, llevas media hora mirando unos papeles en blanco."
    # english: raiha "Big brother, you've been staring at some blank papers for half an hour."
    raiha "Hermanito, llevas media hora mirando unos papeles en blanco."

# game/02_cap1_apertura.rpy:630
translate turkish cap1_apertura_3877ce2b:

    # mc "No están en blanco."
    # english: mc "They're not blank."
    mc "No están en blanco."

# game/02_cap1_apertura.rpy:632
translate turkish cap1_apertura_7848a04c:

    # raiha "Están llenos de tachones. ¡Eso es peor!"
    # english: raiha "They're full of cross-outs. That's worse!"
    raiha "Están llenos de tachones. ¡Eso es peor!"

# game/02_cap1_apertura.rpy:634
translate turkish cap1_apertura_b974f49d:

