# game/02_cap1_apertura.rpy:685
translate turkish cap1_apertura_93e725a8:

    # mc "¿Por dónde empezarías?"
    # english: mc "Where would you start?"
    mc "¿Por dónde empezarías?"

# game/02_cap1_apertura.rpy:687
translate turkish cap1_apertura_a51b9cd2:

    # raiha "¡Eso es fácil, hermanito!"
    # english: raiha "That's easy, big brother!"
    raiha "¡Eso es fácil, hermanito!"

# game/02_cap1_apertura.rpy:689
translate turkish cap1_apertura_34ff6c6a:

