# game/02_cap1_apertura.rpy:639
translate turkish cap1_apertura_df1ba7ee:

    # raiha "¡Yo solo digo lo que veo!"
    # english: raiha "I'm just saying what I see!"
    raiha "¡Yo solo digo lo que veo!"

