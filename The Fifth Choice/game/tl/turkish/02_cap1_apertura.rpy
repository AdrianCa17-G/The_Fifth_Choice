translate turkish cap1_apertura_c43cfb07:

    # mc_pensamiento "Cinco a la vez... ese es justo el problema."
    # english: mc_pensamiento "Five at once... that's exactly the problem."
    mc_pensamiento "Cinco a la vez... ese es justo el problema."

# game/02_cap1_apertura.rpy:674
translate turkish cap1_apertura_242259a4:

    # mc "Raiha, espera un segundo."
    # english: mc "Raiha, wait a second."
