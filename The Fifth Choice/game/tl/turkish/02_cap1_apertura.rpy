    # english: mc "No, they're not."
    mc "No, no lo son."

# game/02_cap1_apertura.rpy:653
translate turkish cap1_apertura_364cdd16:

    # raiha "Entonces no entiendo el problema."
    # english: raiha "Then I don't see the problem."
    raiha "Entonces no entiendo el problema."

# game/02_cap1_apertura.rpy:658
translate turkish cap1_apertura_05d982ff:

    # raiha "Bueno, da igual. ¡Mucha suerte, hermanito!"
