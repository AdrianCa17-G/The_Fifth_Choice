    mc "Es la primera hermana o hermana mayor de las cinco."

# game/02_cap1_apertura.rpy:711
translate turkish cap1_adivinanza_hermanas_9879094d:

    # mc "Duerme en cualquier parte y dice que tiene audiciones."
