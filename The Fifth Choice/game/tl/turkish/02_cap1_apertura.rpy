translate turkish cap1_adivinanza_hermanas_a90a2559:

    # mc_pensamiento "¿De cuál le hablo ahora?" nointeract
    # english: mc_pensamiento "Who do I tell her about now?" nointeract
    mc_pensamiento "¿De cuál le hablo ahora?" nointeract

# game/02_cap1_apertura.rpy:707
translate turkish cap1_adivinanza_hermanas_f04e14e5:

    # mc "Hay una que se llama {color=#C2185B}{b}Ichika{/b}{/color}."
    # english: mc "There's one named {color=#C2185B}{b}Ichika{/b}{/color}."
    mc "Hay una que se llama {color=#C2185B}{b}Ichika{/b}{/color}."

# game/02_cap1_apertura.rpy:709
translate turkish cap1_adivinanza_hermanas_bde97b50:

