    # mc "Tu padre acaba de decir que no."
    # english: mc "Your father just said no."
    mc "Tu padre acaba de decir que no."

# game/02_cap1_beat_Nino.rpy:279
translate turkish beat_Nino_1160fc09:

    # nino "Mi padre no tiene que vivir con esto todos los días. Yo sí."
    # english: nino "My father doesn't have to live with this every day. I do."
    nino "Mi padre no tiene que vivir con esto todos los días. Yo sí."

# game/02_cap1_beat_Nino.rpy:286
translate turkish beat_Nino_982d867f:

    # narrador "Se sentó en uno de los bancos de la cocina, de golpe."
    # english: narrador "She dropped onto one of the kitchen stools."
    narrador "Se sentó en uno de los bancos de la cocina, de golpe."

# game/02_cap1_beat_Nino.rpy:288
translate turkish beat_Nino_18d33df3:

    # narrador "Las piernas ya no le daban."
    # english: narrador "Her legs just gave out."
    narrador "Las piernas ya no le daban."

# game/02_cap1_beat_Nino.rpy:290
translate turkish beat_Nino_4a727e2b:

    # nino "No es porque seas malo en esto."
    # english: nino "It's not because you're bad at this."
    nino "No es porque seas malo en esto."

# game/02_cap1_beat_Nino.rpy:292
translate turkish beat_Nino_77b8451c:

    # nino "Ni siquiera es porque me caigas mal, aunque me caes mal."
    # english: nino "It's not even because I don't like you, though I don't."
    nino "Ni siquiera es porque me caigas mal, aunque me caes mal."

# game/02_cap1_beat_Nino.rpy:294
translate turkish beat_Nino_9ebd1e6c:

    # nino "Es que ya vi esto pasar varias veces, y siempre fue igual."
    # english: nino "It's that I've watched this happen before, and it always goes the same way."
    nino "Es que ya vi esto pasar varias veces, y siempre fue igual."

# game/02_cap1_beat_Nino.rpy:296
translate turkish beat_Nino_e063175c:

    # nino "Ichika finge que no le importa hasta que le importa."
    # english: nino "Ichika acts like she doesn't care until she does."
    nino "Ichika finge que no le importa hasta que le importa."

# game/02_cap1_beat_Nino.rpy:298
translate turkish beat_Nino_088ef33d:

    # nino "Yotsuba se esfuerza el doble para compensar algo que no puede compensar."
    # english: nino "Yotsuba works twice as hard to make up for something she can't make up for."
    nino "Yotsuba se esfuerza el doble para compensar algo que no puede compensar."

# game/02_cap1_beat_Nino.rpy:300
translate turkish beat_Nino_d6e50c6a:

    # nino "Miku se encierra en su propia burbuja todavía más, y ya estaba bastante encerrada."
    # english: nino "Miku shuts herself deeper into her bubble, and she was already pretty shut in."
    nino "Miku se encierra en su propia burbuja todavía más, y ya estaba bastante encerrada."

# game/02_cap1_beat_Nino.rpy:302
translate turkish beat_Nino_f268aa05:

    # nino "E Itsuki... Itsuki se lo toma como si fuera personal, porque para ella todo lo es."
    # english: nino "And Itsuki... Itsuki takes it personally, because for her everything is."
    nino "E Itsuki... Itsuki se lo toma como si fuera personal, porque para ella todo lo es."

# game/02_cap1_beat_Nino.rpy:304
translate turkish beat_Nino_cf20459c:

    # narrador "Hablaba rápido, sin las pausas que suele dejar entre frase y frase."
    # english: narrador "She was talking fast, without the pauses she usually leaves between sentences."
    narrador "Hablaba rápido, sin las pausas que suele dejar entre frase y frase."

# game/02_cap1_beat_Nino.rpy:306
translate turkish beat_Nino_a07e76a6:

    # nino "Y cuando se van, a mí me toca juntar los pedazos de las cuatro."
    # english: nino "And when they leave, I'm the one stuck picking up the pieces. All four sets."
    nino "Y cuando se van, a mí me toca juntar los pedazos de las cuatro."

# game/02_cap1_beat_Nino.rpy:308
translate turkish beat_Nino_0b85b5dc:

    # nino "Porque soy la única que no se ilusionó nunca."
    # english: nino "Because I'm the only one who never got her hopes up."
    nino "Porque soy la única que no se ilusionó nunca."

# game/02_cap1_beat_Nino.rpy:310
translate turkish beat_Nino_09c50ccb:

    # nino "Cada vez que uno se va, quedamos un poco menos juntas. Y nadie lo nota."
    # english: nino "Every time one of them goes, we end up a little less together. And nobody notices."
    nino "Cada vez que uno se va, quedamos un poco menos juntas. Y nadie lo nota."

# game/02_cap1_beat_Nino.rpy:312
translate turkish beat_Nino_3888c4a9:

    # nino "Alguien tiene que quedarse con la cabeza fría."
    # english: nino "Someone has to keep a cool head."
    nino "Alguien tiene que quedarse con la cabeza fría."

# game/02_cap1_beat_Nino.rpy:314
translate turkish beat_Nino_b40ed618:

    # nino "Siempre soy yo."
    # english: nino "It's always me."
    nino "Siempre soy yo."

# game/02_cap1_beat_Nino.rpy:316
translate turkish beat_Nino_6d3ff4c9:

    # nino "Y estoy cansada de ser la única que ve venir el golpe antes de que llegue."
    # english: nino "And I'm tired of being the only one who sees the blow coming before it lands."
    nino "Y estoy cansada de ser la única que ve venir el golpe antes de que llegue."

# game/02_cap1_beat_Nino.rpy:318
translate turkish beat_Nino_5e647f54:

    # narrador "Se detuvo de golpe, con la taza a medio camino de la boca."
    # english: narrador "She stopped short, the cup halfway to her mouth."
    narrador "Se detuvo de golpe, con la taza a medio camino de la boca."

# game/02_cap1_beat_Nino.rpy:326
translate turkish beat_Nino_5d06c2b7:

    # nino "..."
    # english: nino "..."
    nino "..."

# game/02_cap1_beat_Nino.rpy:328
translate turkish beat_Nino_2afee028:

    # nino "No dije nada de esto."
    # english: nino "I didn't say any of this."
    nino "No dije nada de esto."

# game/02_cap1_beat_Nino.rpy:330
translate turkish beat_Nino_cfba260d:

    # mc "Lo dijiste todo."
    # english: mc "You said all of it."
    mc "Lo dijiste todo."

# game/02_cap1_beat_Nino.rpy:332
translate turkish beat_Nino_f4c87f5b:

    # narrador "No contestó."
    # english: narrador "She didn't answer."
    narrador "No contestó."

# game/02_cap1_beat_Nino.rpy:334
translate turkish beat_Nino_ee44c432:

    # narrador "Bajó la taza sin haber bebido nada."
    # english: narrador "She lowered the cup without having drunk anything."
    narrador "Bajó la taza sin haber bebido nada."

# game/02_cap1_beat_Nino.rpy:336
translate turkish beat_Nino_fa811e19:

    # narrador "Al bajarla, la taza quedó encima de una tarjeta escrita a mano."
    # english: narrador "When she did, it came down on top of a handwritten card."
    narrador "Al bajarla, la taza quedó encima de una tarjeta escrita a mano."

# game/02_cap1_beat_Nino.rpy:338
translate turkish beat_Nino_9fff7446:

    # narrador "Tinta gastada, letra redonda. No era la suya."
    # english: narrador "Faded ink, round handwriting. Not hers."
    narrador "Tinta gastada, letra redonda. No era la suya."

# game/02_cap1_beat_Nino.rpy:342
translate turkish beat_Nino_92535cc3:

    # mc_pensamiento "La misma tarjeta del súper."
    # english: mc_pensamiento "The same card from the supermarket."
    mc_pensamiento "La misma tarjeta del súper."

# game/02_cap1_beat_Nino.rpy:344
translate turkish beat_Nino_6bb0decb:

    # mc_pensamiento "Allí me contó lo de los tutores. Hoy, lo de ellas."
    # english: mc_pensamiento "That's where she told me about the tutors. Today, about them."
    mc_pensamiento "Allí me contó lo de los tutores. Hoy, lo de ellas."

# game/02_cap1_beat_Nino.rpy:346
translate turkish beat_Nino_88b6a7bb:

    # mc_pensamiento "Ahora tenía las dos mitades."
    # english: mc_pensamiento "Now I had both halves."
    mc_pensamiento "Ahora tenía las dos mitades."

# game/02_cap1_beat_Nino.rpy:348
translate turkish beat_Nino_2e315025:

    # mc_pensamiento "No está exagerando."
    # english: mc_pensamiento "She isn't exaggerating."
    mc_pensamiento "No está exagerando."

# game/02_cap1_beat_Nino.rpy:350
translate turkish beat_Nino_3e247c31:

    # mc_pensamiento "No conmigo, al menos."
    # english: mc_pensamiento "Not with me, at least."
    mc_pensamiento "No conmigo, al menos."

# game/02_cap1_beat_Nino.rpy:352
translate turkish beat_Nino_da8eda53:

    # mc_pensamiento "Está describiendo un patrón que ya vio cumplirse varias veces."
    # english: mc_pensamiento "She's describing a pattern she's watched play out more than once."
    mc_pensamiento "Está describiendo un patrón que ya vio cumplirse varias veces."

# game/02_cap1_beat_Nino.rpy:354
translate turkish beat_Nino_9b9bc1aa:

    # mc_pensamiento "Lo único que cambia cada vez es el nombre de quien se va."
    # english: mc_pensamiento "The only thing that changes each time is the name of whoever leaves."
    mc_pensamiento "Lo único que cambia cada vez es el nombre de quien se va."

# game/02_cap1_beat_Nino.rpy:362
translate turkish beat_Nino_ec7b5a72:

    # narrador "Se puso de pie y se acomodó el uniforme."
    # english: narrador "She stood up and straightened her uniform."
    narrador "Se puso de pie y se acomodó el uniforme."

# game/02_cap1_beat_Nino.rpy:367
translate turkish beat_Nino_010bf62d:

    # nino "¿Y bien? ¿Vas a decir que esta vez es distinto?"
    # english: nino "So? Are you going to tell me it's different this time?"
    nino "¿Y bien? ¿Vas a decir que esta vez es distinto?"

# game/02_cap1_beat_Nino.rpy:369
translate turkish beat_Nino_8dbce5bf:

    # mc_pensamiento "No hay una respuesta que la deje tranquila."
    # english: mc_pensamiento "There's no answer that will settle her."
    mc_pensamiento "No hay una respuesta que la deje tranquila."

# game/02_cap1_beat_Nino.rpy:371
translate turkish beat_Nino_0c4370b6:

    # mc_pensamiento "Y quedarme callado también es responder."
    # english: mc_pensamiento "And staying quiet is an answer too."
    mc_pensamiento "Y quedarme callado también es responder."

# game/02_cap1_beat_Nino.rpy:377
translate turkish beat_Nino_bf314bfb:

    # mc_pensamiento "Lo dijo todo. Ahora espera que yo diga algo." nointeract
    # english: mc_pensamiento "She said it all. Now she's waiting for me to say something." nointeract
    mc_pensamiento "Lo dijo todo. Ahora espera que yo diga algo." nointeract

# game/02_cap1_beat_Nino.rpy:401
translate turkish nino_beat_m4a_8166f5fe:

    # mc "¿Y quién junta los tuyos?"
    # english: mc "And who picks up yours?"
    mc "¿Y quién junta los tuyos?"

# game/02_cap1_beat_Nino.rpy:403
translate turkish nino_beat_m4a_6af29a87:

    # nino "...¿Qué?"
    # english: nino "...What?"
    nino "...¿Qué?"

# game/02_cap1_beat_Nino.rpy:405
translate turkish nino_beat_m4a_459f9dbf:

    # mc "Dijiste que te toca juntar los pedazos de las cuatro."
    # english: mc "You said you're the one who picks up the pieces for all four of them."
    mc "Dijiste que te toca juntar los pedazos de las cuatro."

# game/02_cap1_beat_Nino.rpy:407
translate turkish nino_beat_m4a_aeaee864:

    # mc "Pregunto quién junta los tuyos."
    # english: mc "I'm asking who picks up yours."
    mc "Pregunto quién junta los tuyos."

# game/02_cap1_beat_Nino.rpy:409
translate turkish nino_beat_m4a_95d8ce88:

    # nino "Nadie. No hace falta."
    # english: nino "No one. There's no need."
    nino "Nadie. No hace falta."

# game/02_cap1_beat_Nino.rpy:411
translate turkish nino_beat_m4a_d351103e:

    # mc "Hoy fuiste a pedirle a tu padre que me echara."
    # english: mc "Today you went to ask your father to throw me out."
    mc "Hoy fuiste a pedirle a tu padre que me echara."

# game/02_cap1_beat_Nino.rpy:413
translate turkish nino_beat_m4a_86e3b91d:

    # mc "Sola. Sin que ninguna de ellas te lo pidiera."
    # english: mc "Alone. Without any of them asking you to."
    mc "Sola. Sin que ninguna de ellas te lo pidiera."

# game/02_cap1_beat_Nino.rpy:415
translate turkish nino_beat_m4a_e6eb059f:

    # mc "Eso no lo hace alguien con la cabeza fría."
    # english: mc "Someone with a cool head doesn't do that."
    mc "Eso no lo hace alguien con la cabeza fría."

# game/02_cap1_beat_Nino.rpy:417
translate turkish nino_beat_m4a_5135f7b4:

    # narrador "Abrió la boca para contestar y no le salió nada."
    # english: narrador "She opened her mouth to answer and nothing came out."
    narrador "Abrió la boca para contestar y no le salió nada."

# game/02_cap1_beat_Nino.rpy:422
translate turkish nino_beat_m4a_e8db1997:

    # nino "Lo hice porque—"
    # english: nino "I did it because—"
    nino "Lo hice porque—"

# game/02_cap1_beat_Nino.rpy:424
translate turkish nino_beat_m4a_198ddfc6:

    # narrador "Se detuvo sola. No la presioné para que terminara."
    # english: narrador "She stopped herself. I didn't push her to finish."
    narrador "Se detuvo sola. No la presioné para que terminara."

# game/02_cap1_beat_Nino.rpy:426
translate turkish nino_beat_m4a_dea94a4e:

    # nino "No es lo que piensas."
    # english: nino "It's not what you think."
    nino "No es lo que piensas."

# game/02_cap1_beat_Nino.rpy:428
translate turkish nino_beat_m4a_c2ba2cd4:

    # mc "No pienso nada. Solo pregunté."
    # english: mc "I don't think anything. I just asked."
    mc "No pienso nada. Solo pregunté."

# game/02_cap1_beat_Nino.rpy:430
translate turkish nino_beat_m4a_9876ea63:

    # narrador "Se quedó mirando la taza un rato largo."
    # english: narrador "She stared at her cup for a long while."
    narrador "Se quedó mirando la taza un rato largo."

# game/02_cap1_beat_Nino.rpy:435
translate turkish nino_beat_m4a_cc3d8559:

    # nino "Hay que hacer la cena. Son las 5."
    # english: nino "Dinner needs making. It's 5 o'clock."
    nino "Hay que hacer la cena. Son las 5."

# game/02_cap1_beat_Nino.rpy:437
translate turkish nino_beat_m4a_5c602d0c:

    # mc "¿Y?"
    # english: mc "So?"
    mc "¿Y?"

# game/02_cap1_beat_Nino.rpy:442
translate turkish nino_beat_m4a_f4756851:

    # nino "Y no pienso cocinar con alguien mirándome."
    # english: nino "So I'm not cooking with someone watching me."
    nino "Y no pienso cocinar con alguien mirándome."

# game/02_cap1_beat_Nino.rpy:444
translate turkish nino_beat_m4a_abc777be:

    # nino "Corta las cebollas. Finas."
    # english: nino "Cut the onions. Thin."
    nino "Corta las cebollas. Finas."

# game/02_cap1_beat_Nino.rpy:446
translate turkish nino_beat_m4a_eba321c4:

    # mc "Está bien."
    # english: mc "Okay."
    mc "Está bien."

# game/02_cap1_beat_Nino.rpy:448
translate turkish nino_beat_m4a_a07d557e:

    # nino "No es una invitación."
    # english: nino "It's not an invitation."
    nino "No es una invitación."

# game/02_cap1_beat_Nino.rpy:450
translate turkish nino_beat_m4a_a48124da:

    # mc "Es una orden."
    # english: mc "It's an order."
    mc "Es una orden."

# game/02_cap1_beat_Nino.rpy:452
translate turkish nino_beat_m4a_3b1fe385:

    # nino "Exacto."
    # english: nino "Exactly."
    nino "Exacto."

# game/02_cap1_beat_Nino.rpy:454
translate turkish nino_beat_m4a_75ebc646:

    # narrador "Me señaló la tabla con la barbilla, sin mirarme."
    # english: narrador "She pointed at the cutting board with her chin, not looking at me."
    narrador "Me señaló la tabla con la barbilla, sin mirarme."

# game/02_cap1_beat_Nino.rpy:456
translate turkish nino_beat_m4a_ffe24499:

    # narrador "Cortamos en silencio. En toda la tarde no volvió a hablar de despedirme."
    # english: narrador "We chopped in silence. All afternoon, she never brought up firing me again."
    narrador "Cortamos en silencio. En toda la tarde no volvió a hablar de despedirme."

# game/02_cap1_beat_Nino.rpy:458
translate turkish nino_beat_m4a_ff254d31:

    # narrador "Antes de ponerse con la olla, dejó un táper vacío junto a mi mochila."
    # english: narrador "Before starting on the pot, she set an empty container down next to my bag."
    narrador "Antes de ponerse con la olla, dejó un táper vacío junto a mi mochila."

# game/02_cap1_beat_Nino.rpy:460
translate turkish nino_beat_m4a_3c7aae4d:

    # nino "Eso es para ti. Lo que sobre."
    # english: nino "That's for you. Whatever's left over."
    nino "Eso es para ti. Lo que sobre."

# game/02_cap1_beat_Nino.rpy:462
translate turkish nino_beat_m4a_9bbd75b8:

    # mc "Todavía no ha sobrado nada."
    # english: mc "Nothing's left over yet."
    mc "Todavía no ha sobrado nada."

# game/02_cap1_beat_Nino.rpy:467
translate turkish nino_beat_m4a_f3aebfd7:

    # nino "...Va a sobrar."
    # english: nino "...There will be."
    nino "...Va a sobrar."

# game/02_cap1_beat_Nino.rpy:469
translate turkish nino_beat_m4a_0a12d673:

    # narrador "Sobró. Exactamente lo que cabía en el táper."
    # english: narrador "There was. Exactly as much as fit in the container."
    narrador "Sobró. Exactamente lo que cabía en el táper."

# game/02_cap1_beat_Nino.rpy:471
translate turkish nino_beat_m4a_556a3ee1:

    # mc_pensamiento "No le di las gracias. Me pareció que, si lo hacía, lo iba a tirar."
    # english: mc_pensamiento "I didn't thank her. I figured if I did, she'd throw it out."
    mc_pensamiento "No le di las gracias. Me pareció que, si lo hacía, lo iba a tirar."

# game/02_cap1_beat_Nino.rpy:476
translate turkish nino_beat_m4a_e01af13d:

    # mc_pensamiento "No me dejó entrar. Me dio una tarea."
    # english: mc_pensamiento "She didn't let me in. She gave me a job."
    mc_pensamiento "No me dejó entrar. Me dio una tarea."

# game/02_cap1_beat_Nino.rpy:478
translate turkish nino_beat_m4a_7c7b8b85:

    # mc_pensamiento "Con ella, eso es casi lo mismo."
    # english: mc_pensamiento "With her, that's almost the same thing."
    mc_pensamiento "Con ella, eso es casi lo mismo."

# game/02_cap1_beat_Nino.rpy:491
translate turkish nino_beat_m4b_82570eb3:

    # narrador "No dije nada."
    # english: narrador "I said nothing."
    narrador "No dije nada."

# game/02_cap1_beat_Nino.rpy:493
translate turkish nino_beat_m4b_619d0e49:

    # narrador "Rodeé la mesa y recogí la taza que había dejado a medio terminar."
    # english: narrador "I walked around the table and picked up the cup she'd left unfinished."
    narrador "Rodeé la mesa y recogí la taza que había dejado a medio terminar."

# game/02_cap1_beat_Nino.rpy:498
translate turkish nino_beat_m4b_7c7205b2:

    # nino "¿Qué haces?"
    # english: nino "What are you doing?"
    nino "¿Qué haces?"

# game/02_cap1_beat_Nino.rpy:500
translate turkish nino_beat_m4b_8e831ee9:

    # mc "Llevarla al fregadero."
    # english: mc "Taking it to the sink."
    mc "Llevarla al fregadero."

# game/02_cap1_beat_Nino.rpy:502
translate turkish nino_beat_m4b_8f6da307:

    # mc "No hacía falta que la reventaras contra la mesa."
    # english: mc "You didn't have to slam it into the table."
    mc "No hacía falta que la reventaras contra la mesa."

# game/02_cap1_beat_Nino.rpy:504
translate turkish nino_beat_m4b_28920fba:

    # nino "No la reventé."
    # english: nino "I didn't slam it."
    nino "No la reventé."

# game/02_cap1_beat_Nino.rpy:506
translate turkish nino_beat_m4b_7c729c3d:

    # mc "Sonó como si lo hubieras hecho."
    # english: mc "It sounded like you did."
    mc "Sonó como si lo hubieras hecho."

# game/02_cap1_beat_Nino.rpy:508
translate turkish nino_beat_m4b_6208a3ce:

    # narrador "No contestó a eso."
    # english: narrador "She didn't answer that."
    narrador "No contestó a eso."

# game/02_cap1_beat_Nino.rpy:510
translate turkish nino_beat_m4b_6451fe11:

    # narrador "Se quedó apoyada contra la mesa."
    # english: narrador "She stayed leaning against the table."
    narrador "Se quedó apoyada contra la mesa."

# game/02_cap1_beat_Nino.rpy:512
translate turkish nino_beat_m4b_6694c783:

    # narrador "Con los brazos cruzados otra vez, pero menos tensos que antes."
    # english: narrador "Arms crossed again, but less tense than before."
    narrador "Con los brazos cruzados otra vez, pero menos tensos que antes."

# game/02_cap1_beat_Nino.rpy:517
translate turkish nino_beat_m4b_74f2ae67:

    # nino "No esperaba que te quedaras después de escuchar eso."
    # english: nino "I didn't think you'd stay after hearing all that."
    nino "No esperaba que te quedaras después de escuchar eso."

# game/02_cap1_beat_Nino.rpy:519
translate turkish nino_beat_m4b_41d470ed:

    # mc "¿Preferías que me fuera?"
    # english: mc "Would you rather I left?"
    mc "¿Preferías que me fuera?"

# game/02_cap1_beat_Nino.rpy:521
translate turkish nino_beat_m4b_a7d4d544:

    # nino "No dije eso tampoco."
    # english: nino "I didn't say that either."
    nino "No dije eso tampoco."

# game/02_cap1_beat_Nino.rpy:523
translate turkish nino_beat_m4b_e15abf41:

    # narrador "Terminé de lavar la taza en silencio."
    # english: narrador "I finished washing the cup in silence."
    narrador "Terminé de lavar la taza en silencio."

# game/02_cap1_beat_Nino.rpy:525
translate turkish nino_beat_m4b_99ec5a33:

    # narrador "Ella no se movió de su sitio, pero tampoco volvió a sacar el tema con su padre."
    # english: narrador "She didn't leave her spot, but she didn't bring up her father again, either."
    narrador "Ella no se movió de su sitio, pero tampoco volvió a sacar el tema con su padre."

# game/02_cap1_beat_Nino.rpy:527
translate turkish nino_beat_m4b_773ce22b:

    # mc_pensamiento "No dijo nada más de lo que pensaba."
    # english: mc_pensamiento "She didn't say anything more about what she was thinking."
    mc_pensamiento "No dijo nada más de lo que pensaba."

# game/02_cap1_beat_Nino.rpy:529
translate turkish nino_beat_m4b_339ded3b:

    # mc_pensamiento "Y yo tampoco le pregunté."
    # english: mc_pensamiento "And I didn't ask."
    mc_pensamiento "Y yo tampoco le pregunté."

# game/02_cap1_beat_Nino.rpy:542
translate turkish nino_beat_m4c_c44dced5:

    # mc "Entonces deja de juntar los pedazos de las demás y ocúpate de los tuyos."
    # english: mc "Then stop picking up everyone else's pieces and take care of your own."
    mc "Entonces deja de juntar los pedazos de las demás y ocúpate de los tuyos."

# game/02_cap1_beat_Nino.rpy:544
translate turkish nino_beat_m4c_67d14333:

    # narrador "Lo dije pensando que la iba a hacer reaccionar."
    # english: narrador "I said it thinking it would make her react."
    narrador "Lo dije pensando que la iba a hacer reaccionar."

# game/02_cap1_beat_Nino.rpy:546
translate turkish nino_beat_m4c_a1037331:

    # narrador "Reaccionó, pero no como esperaba."
    # english: narrador "She did react, just not the way I expected."
    narrador "Reaccionó, pero no como esperaba."

# game/02_cap1_beat_Nino.rpy:551
translate turkish nino_beat_m4c_5d06c2b7:

    # nino "..."
    # english: nino "..."
    nino "..."

# game/02_cap1_beat_Nino.rpy:553
translate turkish nino_beat_m4c_d5baa7b7:

    # nino "Genial."
    # english: nino "Great."
    nino "Genial."

# game/02_cap1_beat_Nino.rpy:555
translate turkish nino_beat_m4c_95f328de:

    # nino "Dos semanas aquí y ya sabes exactamente qué decirme para que me calle."
    # english: nino "Two weeks here and you already know exactly what to say to shut me up."
    nino "Dos semanas aquí y ya sabes exactamente qué decirme para que me calle."

# game/02_cap1_beat_Nino.rpy:557
translate turkish nino_beat_m4c_177cab84:

    # mc "No dije que te callaras."
    # english: mc "I didn't say to shut up."
    mc "No dije que te callaras."

# game/02_cap1_beat_Nino.rpy:559
translate turkish nino_beat_m4c_f33fecca:

    # nino "Dijiste que me ocupara de lo mío. Es la forma elegante de lo mismo."
    # english: nino "You said to take care of my own. That's just the polite way of saying the same thing."
    nino "Dijiste que me ocupara de lo mío. Es la forma elegante de lo mismo."

# game/02_cap1_beat_Nino.rpy:561
translate turkish nino_beat_m4c_a65aec1d:

    # narrador "Recogió su taza ella misma, sin dejar que me acercara."
    # english: narrador "She picked up her own cup, not letting me get close."
    narrador "Recogió su taza ella misma, sin dejar que me acercara."

# game/02_cap1_beat_Nino.rpy:563
translate turkish nino_beat_m4c_8825864b:

    # nino "Ahora entiendo por qué mi padre firmó contigo. Hablan el mismo idioma."
    # english: nino "Now I get why my father signed you. You two speak the same language."
    nino "Ahora entiendo por qué mi padre firmó contigo. Hablan el mismo idioma."

# game/02_cap1_beat_Nino.rpy:565
translate turkish nino_beat_m4c_a17ce448:

    # mc_pensamiento "No sé si eso es un insulto o la descripción más precisa que me ha dado."
    # english: mc_pensamiento "I can't tell if that's an insult or the most accurate description anyone's given me."
    mc_pensamiento "No sé si eso es un insulto o la descripción más precisa que me ha dado."

# game/02_cap1_beat_Nino.rpy:567
translate turkish nino_beat_m4c_e375bfcf:

    # narrador "Se fue a su habitación sin volver a mirarme, con la taza todavía en la mano."
    # english: narrador "She went to her room without looking at me again, the cup still in her hand."
    narrador "Se fue a su habitación sin volver a mirarme, con la taza todavía en la mano."

# game/02_cap1_beat_Nino.rpy:569
translate turkish nino_beat_m4c_d9e324e9:

    # mc_pensamiento "Le hablé como le habla Maruo."
    # english: mc_pensamiento "I talked to her the way Maruo talks to her."
    mc_pensamiento "Le hablé como le habla Maruo."

# game/02_cap1_beat_Nino.rpy:571
translate turkish nino_beat_m4c_ff22d9f1:

    # mc_pensamiento "Y ella me contestó como le contesta a Maruo: yéndose."
    # english: mc_pensamiento "And she answered the way she answers Maruo: by walking away."
    mc_pensamiento "Y ella me contestó como le contesta a Maruo: yéndose."

# game/02_cap1_beat_Nino.rpy:588
translate turkish nino_beat_m5_aa16b953:

    # narrador "Me quedé un rato más en la cocina, solo, con el ruido del edificio de fondo."
    # english: narrador "I stayed in the kitchen a while longer, alone, with the building's noises in the background."
    narrador "Me quedé un rato más en la cocina, solo, con el ruido del edificio de fondo."

# game/02_cap1_beat_Nino.rpy:590
translate turkish nino_beat_m5_68f0cd67:

    # mc_pensamiento "Vino a pedir que me fuera."
    # english: mc_pensamiento "She came to get me sent away."
    mc_pensamiento "Vino a pedir que me fuera."

# game/02_cap1_beat_Nino.rpy:592
translate turkish nino_beat_m5_964e3b9b:

    # mc_pensamiento "Su padre dijo que no."
    # english: mc_pensamiento "Her father said no."
    mc_pensamiento "Su padre dijo que no."

# game/02_cap1_beat_Nino.rpy:594
translate turkish nino_beat_m5_645f50cf:

    # mc_pensamiento "Y aun así, el que se quedó dando explicaciones fui yo."
    # english: mc_pensamiento "And still, I'm the one left giving explanations."
    mc_pensamiento "Y aun así, el que se quedó dando explicaciones fui yo."

# game/02_cap1_beat_Nino.rpy:598
translate turkish nino_beat_m5_fcd8f28f:

    # mc_pensamiento "Maruo no va a repetir esa advertencia una tercera vez."
    # english: mc_pensamiento "Maruo won't repeat that warning a third time."
    mc_pensamiento "Maruo no va a repetir esa advertencia una tercera vez."

# game/02_cap1_beat_Nino.rpy:600
translate turkish nino_beat_m5_046e9231:

    # mc_pensamiento "La próxima vez que hable de esto, no va a ser una advertencia."
    # english: mc_pensamiento "The next time he brings this up, it won't be a warning."
    mc_pensamiento "La próxima vez que hable de esto, no va a ser una advertencia."

# game/02_cap1_beat_Nino.rpy:602
translate turkish nino_beat_m5_3a005cf7:

    # mc_pensamiento "Será un despido asegurado."
    # english: mc_pensamiento "It'll be a guaranteed dismissal."
    mc_pensamiento "Será un despido asegurado."

# game/02_cap1_beat_Nino.rpy:606
translate turkish nino_beat_m5_454be720:

    # mc_pensamiento "Hoy fue a pelear sola y no le dijo a nadie."
    # english: mc_pensamiento "Today she went to fight alone and told no one."
    mc_pensamiento "Hoy fue a pelear sola y no le dijo a nadie."

# game/02_cap1_beat_Nino.rpy:608
translate turkish nino_beat_m5_68cae4ea:

    # mc_pensamiento "Me puse a cortar cebollas y no volvió a hablar de despedirme."
    # english: mc_pensamiento "I started cutting onions and she never brought up firing me again."
    mc_pensamiento "Me puse a cortar cebollas y no volvió a hablar de despedirme."

# game/02_cap1_beat_Nino.rpy:610
translate turkish nino_beat_m5_609871c2:

    # mc_pensamiento "Mi pregunta se quedó sin respuesta, y ella sabe que sigue ahí."
    # english: mc_pensamiento "My question went unanswered, and she knows it's still out there."
    mc_pensamiento "Mi pregunta se quedó sin respuesta, y ella sabe que sigue ahí."

# game/02_cap1_beat_Nino.rpy:614
translate turkish nino_beat_m5_43518715:

    # mc_pensamiento "La taza quedó en el escurridor y ella no volvió a mirarla."
    # english: mc_pensamiento "The cup stayed in the drying rack and she never looked at it again."
    mc_pensamiento "La taza quedó en el escurridor y ella no volvió a mirarla."

# game/02_cap1_beat_Nino.rpy:616
translate turkish nino_beat_m5_fd2ab357:

    # mc_pensamiento "No me echó. Tampoco me dejó quedarme de verdad."
    # english: mc_pensamiento "She didn't throw me out. She didn't really let me stay, either."
    mc_pensamiento "No me echó. Tampoco me dejó quedarme de verdad."

# game/02_cap1_beat_Nino.rpy:618
translate turkish nino_beat_m5_942c1223:

    # mc_pensamiento "Hoy en lo único que coincidimos fue en callarnos."
    # english: mc_pensamiento "Today the only thing we agreed on was keeping quiet."
    mc_pensamiento "Hoy en lo único que coincidimos fue en callarnos."

# game/02_cap1_beat_Nino.rpy:622
translate turkish nino_beat_m5_7abdd6a1:

    # mc_pensamiento "Maruo cerró la conversación sin alzar la voz."
    # english: mc_pensamiento "Maruo closed the conversation without raising his voice."
    mc_pensamiento "Maruo cerró la conversación sin alzar la voz."

# game/02_cap1_beat_Nino.rpy:624
translate turkish nino_beat_m5_1fd4a4b2:

    # mc_pensamiento "Yo cerré la mía igual, una hora después y en la misma cocina."
    # english: mc_pensamiento "I closed mine the same way, an hour later in the same kitchen."
    mc_pensamiento "Yo cerré la mía igual, una hora después y en la misma cocina."

# game/02_cap1_beat_Nino.rpy:626
translate turkish nino_beat_m5_2b51d7e6:

    # mc_pensamiento "Le cerraron la conversación dos veces en una tarde."
    # english: mc_pensamiento "She got shut down twice in one afternoon."
    mc_pensamiento "Le cerraron la conversación dos veces en una tarde."

