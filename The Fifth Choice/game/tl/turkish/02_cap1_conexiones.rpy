# game/02_cap1_conexiones.rpy:1224
translate turkish cap1_interconexion_1_10e1df39:

    # narrador "Ichika, sin mirarla, le bajó un audífono con un dedo."
    # english: narrador "Ichika, without looking at her, tugged one headphone down with a finger."
    narrador "Ichika, sin mirarla, le bajó un audífono con un dedo."

# game/02_cap1_conexiones.rpy:1226
translate turkish cap1_interconexion_1_980c2270:

    # narrador "Miku se lo volvió a subir. Parecía un juego viejo entre ellas."
    # english: narrador "Miku put it back up. It looked like an old game between them."
    narrador "Miku se lo volvió a subir. Parecía un juego viejo entre ellas."

# game/02_cap1_conexiones.rpy:1232
translate turkish cap1_interconexion_1_76a17314:

    # itsuki "Yo no pienso esconderme. Estaré donde siempre."
    # english: itsuki "I'm not going to hide. I'll be where I always am."
    itsuki "Yo no pienso esconderme. Estaré donde siempre."

# game/02_cap1_conexiones.rpy:1238
translate turkish cap1_interconexion_1_1732b5ac:

    # nino "Treinta días, tutor. A ver a cuántas logras encontrar."
    # english: nino "Thirty days, tutor. Let's see how many of us you find."
    nino "Treinta días, tutor. A ver a cuántas logras encontrar."

# game/02_cap1_conexiones.rpy:1248
translate turkish cap1_interconexion_1_4591049b:

    # narrador "Se fueron sin esperar respuesta."
    # english: narrador "They left without waiting for an answer."
    narrador "Se fueron sin esperar respuesta."

# game/02_cap1_conexiones.rpy:1250
translate turkish cap1_interconexion_1_9361285d:

    # narrador "Yotsuba fue la única que miró atrás antes de salir."
    # english: narrador "Yotsuba was the only one who looked back before going out."
    narrador "Yotsuba fue la única que miró atrás antes de salir."

# game/02_cap1_conexiones.rpy:1252
translate turkish cap1_interconexion_1_eee3fd38:

    # narrador "Y solo Itsuki tardó un poco más en salir."
    # english: narrador "And only Itsuki took a little longer to leave."
    narrador "Y solo Itsuki tardó un poco más en salir."

# game/02_cap1_conexiones.rpy:1257
translate turkish cap1_interconexion_1_b46d9b35:

    # narrador "El aula quedó en silencio."
    # english: narrador "The classroom went quiet."
    narrador "El aula quedó en silencio."

# game/02_cap1_conexiones.rpy:1265
translate turkish cap1_interconexion_1_c3130788:

    # narrador "Terminadas las clases, me quedé un rato en el aula."
    # english: narrador "After classes ended, I stayed in the classroom for a while."
    narrador "Terminadas las clases, me quedé un rato en el aula."

# game/02_cap1_conexiones.rpy:1267
translate turkish cap1_interconexion_1_aaebad49:

    # mc_pensamiento "Tres tardes libres. Cinco nombres."
    # english: mc_pensamiento "Three free afternoons. Five names."
    mc_pensamiento "Tres tardes libres. Cinco nombres."

# game/02_cap1_conexiones.rpy:1269
translate turkish cap1_interconexion_1_76711b5b:

    # mc_pensamiento "Y ya sé dónde buscar a cada una."
    # english: mc_pensamiento "And I already know where to look for each one."
    mc_pensamiento "Y ya sé dónde buscar a cada una."

# game/02_cap1_conexiones.rpy:1271
translate turkish cap1_interconexion_1_5e5cccef:

    # mc_pensamiento "No voy a llegar a todas. Eso también lo sé."
    # english: mc_pensamiento "I won't reach all of them. I know that, too."
    mc_pensamiento "No voy a llegar a todas. Eso también lo sé."

# game/02_cap1_conexiones.rpy:1273
translate turkish cap1_interconexion_1_e644e71f:

    # mc_pensamiento "Empiezo hoy."
    # english: mc_pensamiento "I start today."
    mc_pensamiento "Empiezo hoy."

# game/02_cap1_conexiones.rpy:1298
translate turkish cap1_interconexion_2_3b8cf7a2:

    # narrador "Llegué a mi habitación."
    # english: narrador "I got to my room."
    narrador "Llegué a mi habitación."

# game/02_cap1_conexiones.rpy:1300
translate turkish cap1_interconexion_2_49186f5c:

    # narrador "No abrí la libreta. Ya sabía lo que decía."
    # english: narrador "I didn't open the notebook. I already knew what it said."
    narrador "No abrí la libreta. Ya sabía lo que decía."

# game/02_cap1_conexiones.rpy:1304
translate turkish cap1_interconexion_2_c6d46ed3:

    # mc_pensamiento "Dormí mejor de lo que esperaba."
    # english: mc_pensamiento "I slept better than I expected."
    mc_pensamiento "Dormí mejor de lo que esperaba."

# game/02_cap1_conexiones.rpy:1306
translate turkish cap1_interconexion_2_78461abd:

    # mc_pensamiento "Con [nombre_h!t] algo se movió esta tarde. Poco, pero se movió."
    # english: mc_pensamiento "Something shifted with [nombre_h!t] this afternoon. Not much, but it shifted."
    mc_pensamiento "Con [nombre_h!t] algo se movió esta tarde. Poco, pero se movió."

# game/02_cap1_conexiones.rpy:1308
translate turkish cap1_interconexion_2_504206c7:

    # mc_pensamiento "Por algún lado se empieza."
    # english: mc_pensamiento "You start somewhere."
    mc_pensamiento "Por algún lado se empieza."

# game/02_cap1_conexiones.rpy:1312
translate turkish cap1_interconexion_2_3df0a699:

    # mc_pensamiento "Dormí. No sé si eso es buena o mala señal."
    # english: mc_pensamiento "I slept. I don't know if that's a good sign or a bad one."
    mc_pensamiento "Dormí. No sé si eso es buena o mala señal."

# game/02_cap1_conexiones.rpy:1314
translate turkish cap1_interconexion_2_e8a577ae:

    # mc_pensamiento "Con [nombre_h!t] la tarde pasó sin que nada saliera mal."
    # english: mc_pensamiento "The afternoon with [nombre_h!t] went by without anything going wrong."
    mc_pensamiento "Con [nombre_h!t] la tarde pasó sin que nada saliera mal."

# game/02_cap1_conexiones.rpy:1316
translate turkish cap1_interconexion_2_2eb59cba:

    # mc_pensamiento "Tampoco salió nada que valga la pena anotar."
    # english: mc_pensamiento "Nothing worth writing down came out of it, either."
    mc_pensamiento "Tampoco salió nada que valga la pena anotar."

# game/02_cap1_conexiones.rpy:1320
translate turkish cap1_interconexion_2_0563640f:

    # mc_pensamiento "Me costó dormir."
    # english: mc_pensamiento "It was hard to fall asleep."
    mc_pensamiento "Me costó dormir."

# game/02_cap1_conexiones.rpy:1322
translate turkish cap1_interconexion_2_363d6fa0:

    # mc_pensamiento "Repasé lo que le dije a [nombre_h!t] más veces de las que voy a admitir."
    # english: mc_pensamiento "I replayed what I said to [nombre_h!t] more times than I'll admit."
    mc_pensamiento "Repasé lo que le dije a [nombre_h!t] más veces de las que voy a admitir."

# game/02_cap1_conexiones.rpy:1324
translate turkish cap1_interconexion_2_40d69a80:

    # mc_pensamiento "Tenía razón. Eso no hacía que sonara mejor."
    # english: mc_pensamiento "I was right. That didn't make it sound any better."
    mc_pensamiento "Tenía razón. Eso no hacía que sonara mejor."

# game/02_cap1_conexiones.rpy:1336
translate turkish cap1_interconexion_2_6846f078:

    # narrador "A la mañana siguiente, Raiha ya se había despertado."
    # english: narrador "The next morning, Raiha was already up."
    narrador "A la mañana siguiente, Raiha ya se había despertado."

# game/02_cap1_conexiones.rpy:1338
translate turkish cap1_interconexion_2_759bc9de:

    # narrador "Me llamó al comedor muy alegre."
    # english: narrador "She called me to the dining room, all cheerful."
    narrador "Me llamó al comedor muy alegre."

# game/02_cap1_conexiones.rpy:1340
translate turkish cap1_interconexion_2_e2d911c5:

    # narrador "Esa energía me recordaba a alguien. No supe a quién."
    # english: narrador "That energy reminded me of someone. I couldn't think who."
    narrador "Esa energía me recordaba a alguien. No supe a quién."

# game/02_cap1_conexiones.rpy:1345
translate turkish cap1_interconexion_2_2cb5ec09:

    # raiha "¡Buenos días, hermanito!"
    # english: raiha "Good morning, [mc]!"
    raiha "¡Buenos días, hermanito!"

# game/02_cap1_conexiones.rpy:1347
translate turkish cap1_interconexion_2_1297602f:

    # raiha "¿Qué quieres de desayuno? ¡Tienes que decidirlo ya!"
    # english: raiha "What do you want for breakfast? You have to decide now!"
    raiha "¿Qué quieres de desayuno? ¡Tienes que decidirlo ya!"

# game/02_cap1_conexiones.rpy:1351
translate turkish cap1_interconexion_2_63bcc12f:

    # mc_pensamiento "¿Qué le pido?" nointeract
    # english: mc_pensamiento "What do I tell her?" nointeract
    mc_pensamiento "¿Qué le pido?" nointeract

# game/02_cap1_conexiones.rpy:1355
translate turkish cap1_interconexion_2_9dda3103:

    # mc "Lo que sea, menos curry."
    # english: mc "Anything but curry."
    mc "Lo que sea, menos curry."

# game/02_cap1_conexiones.rpy:1360
translate turkish cap1_interconexion_2_47501e0a:

    # raiha "¡El curry es amor líquido, hermanito!"
    # english: raiha "Curry is liquid love, big brother!"
    raiha "¡El curry es amor líquido, hermanito!"

# game/02_cap1_conexiones.rpy:1362
translate turkish cap1_interconexion_2_f34110c4:

    # mc "A esta hora de la mañana, el amor líquido es una apuesta."
    # english: mc "This early in the morning, liquid love is a gamble."
    mc "A esta hora de la mañana, el amor líquido es una apuesta."

# game/02_cap1_conexiones.rpy:1366
translate turkish cap1_interconexion_2_6d9919e6:

    # mc "Café en un tupper. Y listo."
    # english: mc "Tupperware coffee. Done."
    mc "Café en un tupper. Y listo."

# game/02_cap1_conexiones.rpy:1368
translate turkish cap1_interconexion_2_f06e8aec:

    # raiha "¡No! ¡Hay arroz, tortilla y un pulpito de salchicha!"
    # english: raiha "No! There's rice, omelet, and a little sausage octopus!"
    raiha "¡No! ¡Hay arroz, tortilla y un pulpito de salchicha!"

# game/02_cap1_conexiones.rpy:1370
translate turkish cap1_interconexion_2_4d8ee7a6:

    # mc "¿Los pulpitos no se negocian?"
    # english: mc "The little octopus isn't negotiable?"
    mc "¿Los pulpitos no se negocian?"

# game/02_cap1_conexiones.rpy:1375
translate turkish cap1_interconexion_2_5e277792:

    # raiha "¡Nunca!"
    # english: raiha "Never!"
    raiha "¡Nunca!"

# game/02_cap1_conexiones.rpy:1379
translate turkish cap1_interconexion_2_da054cfc:

    # mc "Nada. Con estas ojeras ya voy servido."
    # english: mc "Nothing. I'm running on eye bags."
    mc "Nada. Con estas ojeras ya voy servido."

# game/02_cap1_conexiones.rpy:1384
translate turkish cap1_interconexion_2_49580c03:

    # raiha "...Voy a prepararte doble porción."
    # english: raiha "...I'm making you a double portion."
    raiha "...Voy a prepararte doble porción."

# game/02_cap1_conexiones.rpy:1386
translate turkish cap1_interconexion_2_2d01493b:

    # raiha "¡Desayunar también es importante! ¡Lo dijo la maestra!"
    # english: raiha "Breakfast matters too! Teacher said so!"
    raiha "¡Desayunar también es importante! ¡Lo dijo la maestra!"

# game/02_cap1_conexiones.rpy:1388
translate turkish cap1_interconexion_2_99e00ba2:

    # narrador "Con ese tono, la decisión ya estaba tomada por los dos."
    # english: narrador "With that tone, the decision had been made for both of us."
    narrador "Con ese tono, la decisión ya estaba tomada por los dos."

# game/02_cap1_conexiones.rpy:1393
translate turkish cap1_interconexion_2_23f80cef:

    # raiha "¡Y no lo dejes olvidado en la mochila como la última vez!"
    # english: raiha "And don't forget it in your bag like last time!"
    raiha "¡Y no lo dejes olvidado en la mochila como la última vez!"

# game/02_cap1_conexiones.rpy:1395
translate turkish cap1_interconexion_2_018ee1fb:

    # mc "Prometido."
    # english: mc "Promise."
    mc "Prometido."

# game/02_cap1_conexiones.rpy:1397
translate turkish cap1_interconexion_2_c6d27d26:

    # narrador "Me lo entregó envuelto en un pañuelo, con el nudo más apretado que he visto en mi vida."
    # english: narrador "She handed it over wrapped in a cloth, tied in the tightest knot I've ever seen."
    narrador "Me lo entregó envuelto en un pañuelo, con el nudo más apretado que he visto en mi vida."

# game/02_cap1_conexiones.rpy:1402
translate turkish cap1_interconexion_2_4e9327ad:

    # narrador "Salí de casa y fui al instituto."
    # english: narrador "I left the house and went to school."
    narrador "Salí de casa y fui al instituto."

# game/02_cap1_conexiones.rpy:1418
translate turkish cap1_interconexion_2_2c2e26a2:

    # narrador "Llegué al instituto con el almuerzo de Raiha en la mochila y la cabeza todavía en lo de ayer."
    # english: narrador "I got to school with Raiha's lunch in my bag and my head still on yesterday."
    narrador "Llegué al instituto con el almuerzo de Raiha en la mochila y la cabeza todavía en lo de ayer."

# game/02_cap1_conexiones.rpy:1420
translate turkish cap1_interconexion_2_e5c2116f:

    # narrador "En el aula, algunas ya estaban en sus pupitres y otras entraban de a una."
    # english: narrador "Some of them were already at their desks; others were trickling in one by one."
    narrador "En el aula, algunas ya estaban en sus pupitres y otras entraban de a una."

# game/02_cap1_conexiones.rpy:1422
translate turkish cap1_interconexion_2_868fa8fb:

    # narrador "Itsuki ya estaba en su pupitre, con el cuaderno de ciencias abierto."
    # english: narrador "Itsuki was already at her desk, science notebook open."
    narrador "Itsuki ya estaba en su pupitre, con el cuaderno de ciencias abierto."

# game/02_cap1_conexiones.rpy:1424
translate turkish cap1_interconexion_2_c08f775c:

    # narrador "De repente, [nombre_h!t] se me cruzó en el camino."
    # english: narrador "Out of nowhere, [nombre_h!t] stepped into my path."
    narrador "De repente, [nombre_h!t] se me cruzó en el camino."

# game/02_cap1_conexiones.rpy:1445
translate turkish cap1_interconexion_2_9f9f1e50:

    # nino "¿Qué le hiciste a [nombre_h!t]?"
    # english: nino "What did you do to [nombre_h!t]?"
    nino "¿Qué le hiciste a [nombre_h!t]?"

# game/02_cap1_conexiones.rpy:1447
translate turkish cap1_interconexion_2_16a9db4d:

    # nino "No paró de decir tu nombre anoche."
    # english: nino "She kept saying your name all night."
    nino "No paró de decir tu nombre anoche."

# game/02_cap1_conexiones.rpy:1449
translate turkish cap1_interconexion_2_0a7143db:

    # nino "Tu nombre, lo genial que la pasaron, como la hiciste sentir."
    # english: nino "Your name, what a great time they had, how you made her feel."
    nino "Tu nombre, lo genial que la pasaron, como la hiciste sentir."

# game/02_cap1_conexiones.rpy:1451
translate turkish cap1_interconexion_2_adb6de60:

    # nino "¿Qué es lo que pretendes con [nombre_h!t]?"
    # english: nino "What are you after with [nombre_h!t]?"
    nino "¿Qué es lo que pretendes con [nombre_h!t]?"

# game/02_cap1_conexiones.rpy:1453
translate turkish cap1_interconexion_2_ffa96970:

    # mc "No es lo que piensas, Nino."
    # english: mc "It's not what you think, Nino."
    mc "No es lo que piensas, Nino."

# game/02_cap1_conexiones.rpy:1455
translate turkish cap1_interconexion_2_2fe83078:

    # mc "Solo cumplí lo que les dije de mi método."
    # english: mc "I just did what I told you about my method."
    mc "Solo cumplí lo que les dije de mi método."

# game/02_cap1_conexiones.rpy:1460
translate turkish cap1_interconexion_2_df3ae5a9:

    # nino "¿Pasaste la tarde a solas con ella?"
    # english: nino "You spent the afternoon alone with her?"
    nino "¿Pasaste la tarde a solas con ella?"

# game/02_cap1_conexiones.rpy:1462
translate turkish cap1_interconexion_2_5d1ffaf1:

    # mc "Sí. Era parte del método."
    # english: mc "Yes. It was part of the method."
    mc "Sí. Era parte del método."

# game/02_cap1_conexiones.rpy:1464
translate turkish cap1_interconexion_2_2db458a9:

    # nino "Ya. El método."
    # english: nino "Right. The method."
    nino "Ya. El método."

# game/02_cap1_conexiones.rpy:1469
translate turkish cap1_interconexion_2_864cfa95:

    # nino "...¿Y por qué no me buscaste a mí primero?"
    # english: nino "...And why didn't you come find me first?"
    nino "...¿Y por qué no me buscaste a mí primero?"

# game/02_cap1_conexiones.rpy:1471
translate turkish cap1_interconexion_2_ed764bae:

    # mc "...¿Qué?"
    # english: mc "...What?"
    mc "...¿Qué?"

# game/02_cap1_conexiones.rpy:1473
translate turkish cap1_interconexion_2_cf39649a:

    # nino "¡Nada!"
    # english: nino "Nothing!"
    nino "¡Nada!"

# game/02_cap1_conexiones.rpy:1475
translate turkish cap1_interconexion_2_76eda96c:

    # nino "Que si te vas a llevar a mis hermanas de una en una, primero se me avisa."
    # english: nino "I mean, if you're going to take my sisters one at a time, you tell me first."
    nino "Que si te vas a llevar a mis hermanas de una en una, primero se me avisa."

# game/02_cap1_conexiones.rpy:1477
translate turkish cap1_interconexion_2_1ef1a716:

    # nino "Yo organizo esta casa. Las cosas pasan por mí."
    # english: nino "I run this house. Things go through me."
    nino "Yo organizo esta casa. Las cosas pasan por mí."

# game/02_cap1_conexiones.rpy:1479
translate turkish cap1_interconexion_2_4a602f09:

    # mc "¿Te molesta no haber sido la primera?"
    # english: mc "Does it bother you that you weren't first?"
    mc "¿Te molesta no haber sido la primera?"

# game/02_cap1_conexiones.rpy:1481
translate turkish cap1_interconexion_2_5d4e5361:

    # nino "¡Me molesta que hagas planes con mis hermanas, tonto!"
    # english: nino "It bothers me that you're making plans with my sisters, idiot!"
    nino "¡Me molesta que hagas planes con mis hermanas, tonto!"

# game/02_cap1_conexiones.rpy:1486
translate turkish cap1_interconexion_2_59a5e422:

    # nino "[nombre_h!t] es mi hermana."
    # english: nino "[nombre_h!t] is my sister."
    nino "[nombre_h!t] es mi hermana."

# game/02_cap1_conexiones.rpy:1488
translate turkish cap1_interconexion_2_0c332c9f:

    # nino "Si le haces daño, te las vas a ver conmigo."
    # english: nino "If you hurt her, you'll have to deal with me."
    nino "Si le haces daño, te las vas a ver conmigo."

# game/02_cap1_conexiones.rpy:1490
translate turkish cap1_interconexion_2_62c10e36:

    # nino "No me importa con cuál pases las tardes."
    # english: nino "I don't care which one you spend your afternoons with."
    nino "No me importa con cuál pases las tardes."

# game/02_cap1_conexiones.rpy:1492
translate turkish cap1_interconexion_2_f2822430:

    # nino "Me importa que no se ilusione."
    # english: nino "I care that she doesn't get her hopes up."
    nino "Me importa que no se ilusione."

# game/02_cap1_conexiones.rpy:1494
translate turkish cap1_interconexion_2_8d6f5a0c:

    # nino "Y que quede claro: sigo diciendo que no vas a durar."
    # english: nino "And let's be clear: I still say you won't last."
    nino "Y que quede claro: sigo diciendo que no vas a durar."

# game/02_cap1_conexiones.rpy:1496
translate turkish cap1_interconexion_2_db1b6cd1:

    # narrador "Se fue rápido, con la cara girada hacia el pasillo."
    # english: narrador "She left fast, her face turned toward the hallway."
    narrador "Se fue rápido, con la cara girada hacia el pasillo."

# game/02_cap1_conexiones.rpy:1501
translate turkish cap1_interconexion_2_f0d4f881:

    # mc_pensamiento "No pude ver si estaba roja."
    # english: mc_pensamiento "I couldn't tell if it was red."
    mc_pensamiento "No pude ver si estaba roja."

# game/02_cap1_conexiones.rpy:1503
translate turkish cap1_interconexion_2_9c56dba0:

    # mc_pensamiento "Preguntó rápido. La excusa tardó más."
    # english: mc_pensamiento "The question came out fast. The excuse took longer."
    mc_pensamiento "Preguntó rápido. La excusa tardó más."

# game/02_cap1_conexiones.rpy:1510
translate turkish cap1_interconexion_2_07da98d6:

    # nino "Oye, tú."
    # english: nino "Hey, you."
    nino "Oye, tú."

# game/02_cap1_conexiones.rpy:1512
translate turkish cap1_interconexion_2_af5e3bb7:

    # nino "Anoche [nombre_h!t] llegó igual que se fue."
    # english: nino "[nombre_h!t] came home last night the same way she left."
    nino "Anoche [nombre_h!t] llegó igual que se fue."

# game/02_cap1_conexiones.rpy:1514
translate turkish cap1_interconexion_2_7704d28b:

    # nino "Ni contenta ni dolida. Como si no hubiera pasado nada."
    # english: nino "Not happy, not hurt. Like nothing happened."
    nino "Ni contenta ni dolida. Como si no hubiera pasado nada."

# game/02_cap1_conexiones.rpy:1516
translate turkish cap1_interconexion_2_f5826188:

    # mc "Es que no pasó nada."
    # english: mc "That's because nothing happened."
    mc "Es que no pasó nada."

# game/02_cap1_conexiones.rpy:1518
translate turkish cap1_interconexion_2_e1345dfa:

    # nino "Bien. Es lo único que te reconozco: no armas escándalo."
    # english: nino "Good. It's the one thing I'll give you: you don't make a scene."
    nino "Bien. Es lo único que te reconozco: no armas escándalo."

# game/02_cap1_conexiones.rpy:1520
translate turkish cap1_interconexion_2_e4054b59:

    # nino "No te lo tomes como un halago."
    # english: nino "Don't take that as a compliment."
    nino "No te lo tomes como un halago."

# game/02_cap1_conexiones.rpy:1522
translate turkish cap1_interconexion_2_d619331f:

    # mc "No lo hice."
    # english: mc "I didn't."
    mc "No lo hice."

# game/02_cap1_conexiones.rpy:1527
translate turkish cap1_interconexion_2_3972f2ab:

    # nino "...Pero sí. Me tranquiliza."
    # english: nino "...But yeah. It's a relief."
    nino "...Pero sí. Me tranquiliza."

# game/02_cap1_conexiones.rpy:1529
translate turkish cap1_interconexion_2_8a755b43:

    # nino "Los que entran haciendo ruido son los que más rápido se van."
    # english: nino "The ones who come in making noise are the first to leave."
    nino "Los que entran haciendo ruido son los que más rápido se van."

# game/02_cap1_conexiones.rpy:1534
translate turkish cap1_interconexion_2_7fe5e839:

    # narrador "Se fue con la misma cara con la que llegó."
    # english: narrador "She left with the same face she came with."
    narrador "Se fue con la misma cara con la que llegó."

# game/02_cap1_conexiones.rpy:1536
translate turkish cap1_interconexion_2_da058dd7:

    # mc_pensamiento "Tardé un segundo en entender que eso también era un cumplido."
    # english: mc_pensamiento "It took me a second to realize that was a compliment, too."
    mc_pensamiento "Tardé un segundo en entender que eso también era un cumplido."

# game/02_cap1_conexiones.rpy:1547
translate turkish cap1_interconexion_2_766825ec:

    # nino "Oye tú."
    # english: nino "Hey, you."
    nino "Oye tú."

# game/02_cap1_conexiones.rpy:1549
translate turkish cap1_interconexion_2_92cfd824:

    # narrador "Nino no gritó. Eso fue lo primero que me asustó."
    # english: narrador "Nino didn't yell. That was the first thing that scared me."
    narrador "Nino no gritó. Eso fue lo primero que me asustó."

# game/02_cap1_conexiones.rpy:1551
translate turkish cap1_interconexion_2_a33b2f74:

    # nino "Anoche vi a [nombre_h!t] muy mal, como si alguien la hubiera humillado."
    # english: nino "Last night [nombre_h!t] looked awful, like someone had humiliated her."
    nino "Anoche vi a [nombre_h!t] muy mal, como si alguien la hubiera humillado."

# game/02_cap1_conexiones.rpy:1553
translate turkish cap1_interconexion_2_d19ae7f7:

    # nino "Se encerró en su cuarto con una mirada perdida."
    # english: nino "She shut herself in her room with a faraway look."
    nino "Se encerró en su cuarto con una mirada perdida."

# game/02_cap1_conexiones.rpy:1555
translate turkish cap1_interconexion_2_b9ed6417:

    # nino "Toqué su puerta para ver cómo estaba."
    # english: nino "I knocked on her door to see how she was."
    nino "Toqué su puerta para ver cómo estaba."

# game/02_cap1_conexiones.rpy:1557
translate turkish cap1_interconexion_2_1cb51305:

    # nino "Dijo que estaba bien. Lo dijo tres veces."
    # english: nino "She said she was fine. She said it three times."
    nino "Dijo que estaba bien. Lo dijo tres veces."

# game/02_cap1_conexiones.rpy:1559
translate turkish cap1_interconexion_2_59b728d1:

    # nino "Nadie dice «estoy bien» tres veces si lo está."
    # english: nino "Nobody says \"I'm fine\" three times if they are."
    nino "Nadie dice «estoy bien» tres veces si lo está."

# game/02_cap1_conexiones.rpy:1561
translate turkish cap1_interconexion_2_5a3e8e21:

    # mc "No fue mi intención..."
    # english: mc "I didn't mean to..."
    mc "No fue mi intención..."

# game/02_cap1_conexiones.rpy:1563
translate turkish cap1_interconexion_2_8a19a1f9:

    # nino "Nunca lo es."
    # english: nino "You never do."
    nino "Nunca lo es."

# game/02_cap1_conexiones.rpy:1565
translate turkish cap1_interconexion_2_35f8065d:

    # nino "Te dije que ibas a hacerles daño. No pensé que tardarías tan poco."
    # english: nino "I told you you'd hurt them. I just didn't think it'd happen this fast."
    nino "Te dije que ibas a hacerles daño. No pensé que tardarías tan poco."

# game/02_cap1_conexiones.rpy:1567
translate turkish cap1_interconexion_2_2d688fc1:

    # mc_pensamiento "Más que enojada, estaba decepcionada."
    # english: mc_pensamiento "She was more disappointed than angry."
    mc_pensamiento "Más que enojada, estaba decepcionada."

# game/02_cap1_conexiones.rpy:1569
translate turkish cap1_interconexion_2_d7cd1064:

    # nino "Hoy no la saludes."
    # english: nino "Don't say hi to her today."
    nino "Hoy no la saludes."

# game/02_cap1_conexiones.rpy:1571
translate turkish cap1_interconexion_2_ebd03b60:

    # nino "No le expliques nada. Déjala."
    # english: nino "Don't explain anything. Leave her alone."
    nino "No le expliques nada. Déjala."

# game/02_cap1_conexiones.rpy:1576
translate turkish cap1_interconexion_2_c61d7eae:

    # narrador "Se fue sin mirarme. No hubo insultos, porque no hacía falta."
    # english: narrador "She left without looking at me. No insults. She didn't need any."
    narrador "Se fue sin mirarme. No hubo insultos, porque no hacía falta."

# game/02_cap1_conexiones.rpy:1578
translate turkish cap1_interconexion_2_d7512319:

    # mc_pensamiento "Quise decir que me arrepentía."
    # english: mc_pensamiento "I wanted to say I was sorry."
    mc_pensamiento "Quise decir que me arrepentía."

# game/02_cap1_conexiones.rpy:1580
translate turkish cap1_interconexion_2_41832b8e:

    # mc_pensamiento "Pero no sabía si tenía derecho a decirlo en voz alta."
    # english: mc_pensamiento "But I didn't know if I had the right to say it out loud."
    mc_pensamiento "Pero no sabía si tenía derecho a decirlo en voz alta."

# game/02_cap1_conexiones.rpy:1589
translate turkish cap1_interconexion_2_bd543fd2:

    # narrador "Las clases terminaron rápidamente."
    # english: narrador "Classes went by quickly."
    narrador "Las clases terminaron rápidamente."

# game/02_cap1_conexiones.rpy:1595
translate turkish cap1_interconexion_2_51f53929:

    # narrador "El timbre del almuerzo sonó y el aula se vació en segundos."
    # english: narrador "The lunch bell rang and the classroom emptied in seconds."
    narrador "El timbre del almuerzo sonó y el aula se vació en segundos."

# game/02_cap1_conexiones.rpy:1597
translate turkish cap1_interconexion_2_93239c10:

    # narrador "Itsuki fue la primera en levantarse."
    # english: narrador "Itsuki was the first to get up."
    narrador "Itsuki fue la primera en levantarse."

# game/02_cap1_conexiones.rpy:1599
translate turkish cap1_interconexion_2_6008c15a:

    # narrador "Tomó el cuaderno de ciencias. No tomó nada más."
    # english: narrador "She took her science notebook. Nothing else."
    narrador "Tomó el cuaderno de ciencias. No tomó nada más."

# game/02_cap1_conexiones.rpy:1601
translate turkish cap1_interconexion_2_524a83c4:

    # narrador "Ninguna bolsa de almuerzo. Ninguna caja."
    # english: narrador "No lunch bag. No lunch box."
    narrador "Ninguna bolsa de almuerzo. Ninguna caja."

# game/02_cap1_conexiones.rpy:1603
translate turkish cap1_interconexion_2_d1d76538:

    # mc_pensamiento "No hacía falta preguntar adónde iba."
    # english: mc_pensamiento "No need to ask where she was going."
    mc_pensamiento "No hacía falta preguntar adónde iba."

# game/02_cap1_conexiones.rpy:1605
translate turkish cap1_interconexion_2_8073c99d:

    # mc_pensamiento "Solo hay un sitio al que se sube por esas escaleras."
    # english: mc_pensamiento "Those stairs only lead to one place."
    mc_pensamiento "Solo hay un sitio al que se sube por esas escaleras."

# game/02_cap1_conexiones.rpy:1635
translate turkish cap1_interconexion_3_b22d50e1:

    # narrador "Entré a mi habitación y saqué mi copia de la hoja de diagnóstico del primer día."
    # english: narrador "I went to my room and took out my copy of the diagnostic sheet from the first day."
    narrador "Entré a mi habitación y saqué mi copia de la hoja de diagnóstico del primer día."

# game/02_cap1_conexiones.rpy:1637
translate turkish cap1_interconexion_3_9e18c22a:

    # mc_pensamiento "Busqué el ejercicio que Itsuki tenía rodeado en el cuaderno."
    # english: mc_pensamiento "I looked for the exercise Itsuki had circled in her notebook."
    mc_pensamiento "Busqué el ejercicio que Itsuki tenía rodeado en el cuaderno."

# game/02_cap1_conexiones.rpy:1639
translate turkish cap1_interconexion_3_3a591cc4:

    # mc_pensamiento "No era difícil. Un paso de conversión, nada más."
    # english: mc_pensamiento "It wasn't hard. One conversion step, nothing more."
    mc_pensamiento "No era difícil. Un paso de conversión, nada más."

# game/02_cap1_conexiones.rpy:1641
translate turkish cap1_interconexion_3_7b217acb:

    # mc_pensamiento "Y llevaba días repasándolo sin ver dónde se le torcía."
    # english: mc_pensamiento "And she'd been going over it for days without seeing where it went wrong."
    mc_pensamiento "Y llevaba días repasándolo sin ver dónde se le torcía."

# game/02_cap1_conexiones.rpy:1643
translate turkish cap1_interconexion_3_12d17ddf:

    # mc_pensamiento "Eso no es falta de esfuerzo."
    # english: mc_pensamiento "That isn't a lack of effort."
    mc_pensamiento "Eso no es falta de esfuerzo."

# game/02_cap1_conexiones.rpy:1645
translate turkish cap1_interconexion_3_817c842f:

    # mc_pensamiento "Nadie le ha dicho dónde mirar. Y ella no va a pedirlo."
    # english: mc_pensamiento "Nobody's told her where to look. And she's not going to ask."
    mc_pensamiento "Nadie le ha dicho dónde mirar. Y ella no va a pedirlo."

# game/02_cap1_conexiones.rpy:1649
translate turkish cap1_interconexion_3_29925c6c:

    # narrador "Entré a mi habitación y volví a pensar en lo de la azotea."
    # english: narrador "I went to my room and thought about the rooftop again."
    narrador "Entré a mi habitación y volví a pensar en lo de la azotea."

# game/02_cap1_conexiones.rpy:1651
translate turkish cap1_interconexion_3_ae9ba0bc:

    # mc_pensamiento "En el aula se atascó y se encerró sobre el cuaderno."
    # english: mc_pensamiento "In class she got stuck and hunched over her notebook."
    mc_pensamiento "En el aula se atascó y se encerró sobre el cuaderno."

# game/02_cap1_conexiones.rpy:1653
translate turkish cap1_interconexion_3_74624351:

    # mc_pensamiento "En la azotea ni siquiera lo abrió."
    # english: mc_pensamiento "On the rooftop she didn't even open it."
    mc_pensamiento "En la azotea ni siquiera lo abrió."

# game/02_cap1_conexiones.rpy:1655
translate turkish cap1_interconexion_3_32f1396a:

    # mc_pensamiento "No sé cuál de las dos cosas me preocupa más."
    # english: mc_pensamiento "I don't know which of the two worries me more."
    mc_pensamiento "No sé cuál de las dos cosas me preocupa más."

# game/02_cap1_conexiones.rpy:1657
translate turkish cap1_interconexion_3_c11f9854:

    # mc_pensamiento "Y el mes ya empezó a correr."
    # english: mc_pensamiento "And the month is already running."
    mc_pensamiento "Y el mes ya empezó a correr."

# game/02_cap1_conexiones.rpy:1664
translate turkish cap1_interconexion_3_ffca3e12:

    # narrador "Mi padre asomó la cabeza. Venía de fotografiar una boda y todavía olía a pastel."
    # english: narrador "My father poked his head in. He'd just come from shooting a wedding and still smelled like cake."
    narrador "Mi padre asomó la cabeza. Venía de fotografiar una boda y todavía olía a pastel."

# game/02_cap1_conexiones.rpy:1666
translate turkish cap1_interconexion_3_e496c1f1:

    # isanari "¿Sigues vivo? Maruo dice que todavía no te han echado."
    # english: isanari "Still alive? Maruo says they haven't kicked you out yet."
    isanari "¿Sigues vivo? Maruo dice que todavía no te han echado."

# game/02_cap1_conexiones.rpy:1668
translate turkish cap1_interconexion_3_dfb108ad:

    # isanari "Con sus hijas, eso ya es récord."
    # english: isanari "With his daughters, that's already a record."
    isanari "Con sus hijas, eso ya es récord."

# game/02_cap1_conexiones.rpy:1670
translate turkish cap1_interconexion_3_c8750a58:

    # mc "¿Hablas con él?"
    # english: mc "You talk to him?"
    mc "¿Hablas con él?"

# game/02_cap1_conexiones.rpy:1672
translate turkish cap1_interconexion_3_a5a375ce:

    # isanari "Desde el instituto. Él era el primero de la clase."
    # english: isanari "Since high school. He was top of the class."
    isanari "Desde el instituto. Él era el primero de la clase."

# game/02_cap1_conexiones.rpy:1674
translate turkish cap1_interconexion_3_91760561:

    # isanari "Yo era el problema de la clase."
    # english: isanari "I was the class problem."
    isanari "Yo era el problema de la clase."

# game/02_cap1_conexiones.rpy:1676
translate turkish cap1_interconexion_3_113e7ecc:

    # mc "Eso explica muchas cosas."
    # english: mc "That explains a lot."
    mc "Eso explica muchas cosas."

# game/02_cap1_conexiones.rpy:1678
translate turkish cap1_interconexion_3_d5223a48:

    # isanari "Explica que nos debamos favores. Él a mí, uno. Yo a él, todos los demás."
    # english: isanari "It explains why we owe each other favors. Him to me, one. Me to him, all the rest."
    isanari "Explica que nos debamos favores. Él a mí, uno. Yo a él, todos los demás."

# game/02_cap1_conexiones.rpy:1680
translate turkish cap1_interconexion_3_da991d01:

    # isanari "¿Y? ¿Cuál de las cinco te odia menos?"
    # english: isanari "So? Which of the five hates you least?"
    isanari "¿Y? ¿Cuál de las cinco te odia menos?"

# game/02_cap1_conexiones.rpy:1682
translate turkish cap1_interconexion_3_c9df3ff4:

    # mc "Depende del día."
    # english: mc "Depends on the day."
    mc "Depende del día."

# game/02_cap1_conexiones.rpy:1684
translate turkish cap1_interconexion_3_fb7d437d:

    # isanari "Entonces vas bien. Tu madre me odió un año entero."
    # english: isanari "Then you're doing fine. Your mother hated me for a whole year."
    isanari "Entonces vas bien. Tu madre me odió un año entero."

# game/02_cap1_conexiones.rpy:1686
translate turkish cap1_interconexion_3_d6eceb00:

    # narrador "Lo dijo sonriendo. Casi nunca la nombra así, de pasada."
    # english: narrador "He said it smiling. He almost never brings her up like that, in passing."
    narrador "Lo dijo sonriendo. Casi nunca la nombra así, de pasada."

# game/02_cap1_conexiones.rpy:1691
translate turkish cap1_interconexion_3_0ad21552:

    # isanari "Le dije a Maruo que eras terco. Que no sabes rendirte."
    # english: isanari "I told Maruo you're stubborn. That you don't know how to give up."
    isanari "Le dije a Maruo que eras terco. Que no sabes rendirte."

# game/02_cap1_conexiones.rpy:1693
translate turkish cap1_interconexion_3_894de16d:

    # isanari "Lo tomó como un elogio. No me hagas quedar de mentiroso."
    # english: isanari "He took it as a compliment. Don't make me a liar."
    isanari "Lo tomó como un elogio. No me hagas quedar de mentiroso."

# game/02_cap1_conexiones.rpy:1695
translate turkish cap1_interconexion_3_4d243876:

    # mc "¿Eso fue un elogio?"
    # english: mc "Was that a compliment?"
    mc "¿Eso fue un elogio?"

# game/02_cap1_conexiones.rpy:1697
translate turkish cap1_interconexion_3_d63da369:

    # isanari "Fue una advertencia. Para los dos."
    # english: isanari "It was a warning. For both of us."
    isanari "Fue una advertencia. Para los dos."

# game/02_cap1_conexiones.rpy:1702
translate turkish cap1_interconexion_3_7c89a101:

    # mc_pensamiento "Antes de cerrar, miró la libreta abierta sobre mi escritorio. No preguntó nada."
    # english: mc_pensamiento "Before closing the door, he glanced at the notebook open on my desk. He didn't ask anything."
    mc_pensamiento "Antes de cerrar, miró la libreta abierta sobre mi escritorio. No preguntó nada."

# game/02_cap1_conexiones.rpy:1704
translate turkish cap1_interconexion_3_fa8751b3:

    # mc_pensamiento "Nunca pregunta. Pero esta vez miró."
    # english: mc_pensamiento "He never asks. But this time he looked."
    mc_pensamiento "Nunca pregunta. Pero esta vez miró."

# game/02_cap1_conexiones.rpy:1713
translate turkish cap1_interconexion_3_6b126fe2:

    # narrador "Los días siguientes se me fueron entre clases, las tutorías y sueño atrasado."
    # english: narrador "The next few days disappeared into classes, tutoring, and lost sleep."
    narrador "Los días siguientes se me fueron entre clases, las tutorías y sueño atrasado."

# game/02_cap1_conexiones.rpy:1715
translate turkish cap1_interconexion_3_86a714a7:

    # narrador "Para cuando levanté la cabeza, habían pasado diez días."
    # english: narrador "By the time I looked up, ten days had gone by."
    narrador "Para cuando levanté la cabeza, habían pasado diez días."

# game/02_cap1_conexiones.rpy:1738
translate turkish cap1_interconexion_3_b43ef6eb:

    # narrador "Las cinco ya estaban en el aula cuando entré."
    # english: narrador "All five were already in the classroom when I walked in."
    narrador "Las cinco ya estaban en el aula cuando entré."

# game/02_cap1_conexiones.rpy:1749
translate turkish cap1_interconexion_3_c47683db:

    # yotsuba "¡Buenos días, tutor! ¡Tienes cara de cansado!"
    # english: yotsuba "Good morning, tutor! You look tired!"
    yotsuba "¡Buenos días, tutor! ¡Tienes cara de cansado!"

# game/02_cap1_conexiones.rpy:1751
translate turkish cap1_interconexion_3_78b52b08:

    # mc "Gracias, Yotsuba."
    # english: mc "Thanks, Yotsuba."
    mc "Gracias, Yotsuba."

# game/02_cap1_conexiones.rpy:1753
translate turkish cap1_interconexion_3_b49abc18:

    # yotsuba "¡De nada!"
    # english: yotsuba "You're welcome!"
    yotsuba "¡De nada!"

# game/02_cap1_conexiones.rpy:1755
translate turkish cap1_interconexion_3_9c0e4e4f:

    # narrador "Lo dijo mirando la pizarra."
    # english: narrador "She said it looking at the board."
    narrador "Lo dijo mirando la pizarra."

# game/02_cap1_conexiones.rpy:1759
translate turkish cap1_interconexion_3_2eac33d2:

    # yotsuba "¡[mc]! ¿Cómo estás? ¡Tienes cara de haber peleado con un oso!"
    # english: yotsuba "[mc]! How are you? You look like you fought a bear!"
    yotsuba "¡[mc]! ¿Cómo estás? ¡Tienes cara de haber peleado con un oso!"

# game/02_cap1_conexiones.rpy:1761
translate turkish cap1_interconexion_3_78b52b08_1:

    # mc "Gracias, Yotsuba."
    # english: mc "Thanks, Yotsuba."
    mc "Gracias, Yotsuba."

# game/02_cap1_conexiones.rpy:1763
translate turkish cap1_interconexion_3_c9f01d65:

    # yotsuba "¡Es un cumplido! ¡Los osos son fuertes!"
    # english: yotsuba "It's a compliment! Bears are strong!"
    yotsuba "¡Es un cumplido! ¡Los osos son fuertes!"

# game/02_cap1_conexiones.rpy:1769
translate turkish cap1_interconexion_3_80bb3e68:

    # ichika "Pregunta seria, [mc]: ¿cuántas horas llevas sin dormir bien?"
    # english: ichika "Serious question, [mc]: how many hours has it been since you slept properly?"
    ichika "Pregunta seria, [mc]: ¿cuántas horas llevas sin dormir bien?"

# game/02_cap1_conexiones.rpy:1771
translate turkish cap1_interconexion_3_bd94d743:

    # mc "He dormido bien. Las suficientes."
    # english: mc "I've slept fine. Enough."
    mc "He dormido bien. Las suficientes."

# game/02_cap1_conexiones.rpy:1773
translate turkish cap1_interconexion_3_1b2c2d4d:

    # mc "Cuidar de cinco bebés no es nada fácil."
    # english: mc "Looking after five babies isn't easy."
    mc "Cuidar de cinco bebés no es nada fácil."

# game/02_cap1_conexiones.rpy:1775
translate turkish cap1_interconexion_3_714049ca:

    # ichika "Eso lo diría alguien que no duerme."
    # english: ichika "That's what someone who doesn't sleep would say."
    ichika "Eso lo diría alguien que no duerme."

# game/02_cap1_conexiones.rpy:1779
translate turkish cap1_interconexion_3_13bbbe46:

    # ichika "Y «las suficientes» no es un número. Me lo enseñó un tutor muy terco."
    # english: ichika "And \"enough\" isn't a number. A very stubborn tutor taught me that."
    ichika "Y «las suficientes» no es un número. Me lo enseñó un tutor muy terco."

# game/02_cap1_conexiones.rpy:1783
translate turkish cap1_interconexion_3_b4c8f8ee:

