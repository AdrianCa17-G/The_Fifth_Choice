    # english: mc "I didn't say anything."
    mc "No dije nada."

# game/02_cap1_conexiones.rpy:693
translate turkish queja_nino_dae772dc:

    # nino "Ya, pero tenías cara de «a ella no la busqué»."
    # english: nino "Yeah, but you had that \"I didn't go looking for her\" look on your face."
    nino "Ya, pero tenías cara de «a ella no la busqué»."

# game/02_cap1_conexiones.rpy:695
translate turkish queja_nino_f2d6ccaf:

    # mc "Solo tenía tres tardes."
    # english: mc "I only had three afternoons."
    mc "Solo tenía tres tardes."

# game/02_cap1_conexiones.rpy:697
translate turkish queja_nino_04073c11:

