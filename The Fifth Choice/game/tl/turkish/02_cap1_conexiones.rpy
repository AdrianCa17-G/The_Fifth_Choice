# game/02_cap1_conexiones.rpy:3714
translate turkish cap1_interconexion_6_325638c5:

    # mc_pensamiento "Y esta vez no podía culpar a nadie más que a mí."
    # english: mc_pensamiento "And this time I couldn't blame anyone but myself."
    mc_pensamiento "Y esta vez no podía culpar a nadie más que a mí."

# game/02_cap1_conexiones.rpy:3716
translate turkish cap1_interconexion_6_344ab5f2:

    # mc_pensamiento "Si después de la semana de exámenes me despiden, será justo."
    # english: mc_pensamiento "If they fire me after exam week, it'll be fair."
    mc_pensamiento "Si después de la semana de exámenes me despiden, será justo."

# game/02_cap1_conexiones.rpy:3731
translate turkish cap1_interconexion_6_bb8d9543:

    # narrador "Maruo apareció en la puerta del departamento."
    # english: narrador "Maruo appeared in the apartment doorway."
    narrador "Maruo apareció en la puerta del departamento."

# game/02_cap1_conexiones.rpy:3733
translate turkish cap1_interconexion_6_fbb79513:

    # narrador "Los zapatos de la entrada eran suyos."
    # english: narrador "The shoes by the door were his."
    narrador "Los zapatos de la entrada eran suyos."

# game/02_cap1_conexiones.rpy:3735
translate turkish cap1_interconexion_6_cbe82050:

    # maruo "Vine a ver cómo iba el estudio."
    # english: maruo "I came to see how the studying is going."
    maruo "Vine a ver cómo iba el estudio."

# game/02_cap1_conexiones.rpy:3737
translate turkish cap1_interconexion_6_bada0e27:

    # narrador "Miró la mesa. Miró a sus hijas. Después me miró a mí."
    # english: narrador "He looked at the table. At his daughters. Then at me."
    narrador "Miró la mesa. Miró a sus hijas. Después me miró a mí."

# game/02_cap1_conexiones.rpy:3741
translate turkish cap1_interconexion_6_064bf1d6:

    # maruo "Ya vi suficiente."
    # english: maruo "I have seen enough."
    maruo "Ya vi suficiente."

# game/02_cap1_conexiones.rpy:3743
translate turkish cap1_interconexion_6_e47f68a8:

    # mc "Señor, todavía quedan..."
    # english: mc "Sir, there's still..."
    mc "Señor, todavía quedan..."

# game/02_cap1_conexiones.rpy:3745
translate turkish cap1_interconexion_6_1efac3cb:

    # maruo "Al terminar la semana lo confirmo."
    # english: maruo "I will confirm it at the end of the week."
    maruo "Al terminar la semana lo confirmo."

# game/02_cap1_conexiones.rpy:3747
translate turkish cap1_interconexion_6_83aada09:

    # narrador "No repitió la advertencia. Ya no era una advertencia."
    # english: narrador "He didn't repeat the warning. It wasn't a warning anymore."
    narrador "No repitió la advertencia. Ya no era una advertencia."

# game/02_cap1_conexiones.rpy:3749
translate turkish cap1_interconexion_6_18ba129f:

    # narrador "Se fue sin esperar respuesta."
    # english: narrador "He left without waiting for an answer."
    narrador "Se fue sin esperar respuesta."

# game/02_cap1_conexiones.rpy:3753
translate turkish cap1_interconexion_6_c3660936:

    # narrador "Cerró con la calma de siempre."
    # english: narrador "He shut the door with his usual calm."
    narrador "Cerró con la calma de siempre."

# game/02_cap1_conexiones.rpy:3755
translate turkish cap1_interconexion_6_a91e7a3c:

    # mc_pensamiento "Lo peor era que sonaba a algo ya decidido."
    # english: mc_pensamiento "The worst part was that it sounded already decided."
    mc_pensamiento "Lo peor era que sonaba a algo ya decidido."

# game/02_cap1_conexiones.rpy:3759
translate turkish cap1_interconexion_6_13bf9935:

    # maruo "En la cocina te dije que esta era tu última oportunidad."
    # english: maruo "In the kitchen I told you this was your last chance."
    maruo "En la cocina te dije que esta era tu última oportunidad."

# game/02_cap1_conexiones.rpy:3761
translate turkish cap1_interconexion_6_b5607ee9:

    # mc "Lo recuerdo."
    # english: mc "I remember."
    mc "Lo recuerdo."

# game/02_cap1_conexiones.rpy:3763
translate turkish cap1_interconexion_6_c5e53baf:

    # maruo "Veo que no la desperdiciaste."
    # english: maruo "I see you did not waste it."
    maruo "Veo que no la desperdiciaste."

# game/02_cap1_conexiones.rpy:3765
translate turkish cap1_interconexion_6_837cbc27:

    # narrador "No sonrió. Maruo no sonríe."
    # english: narrador "He didn't smile. Maruo doesn't smile."
    narrador "No sonrió. Maruo no sonríe."

# game/02_cap1_conexiones.rpy:3767
translate turkish cap1_interconexion_6_056b0cdd:

    # narrador "Pero tardó un segundo de más en irse."
    # english: narrador "But he took a second too long to leave."
    narrador "Pero tardó un segundo de más en irse."

# game/02_cap1_conexiones.rpy:3769
translate turkish cap1_interconexion_6_6c64f57a:

    # maruo "No te confíes. Los exámenes empiezan la siguiente semana."
    # english: maruo "Do not get overconfident. The exams start next week."
    maruo "No te confíes. Los exámenes empiezan la siguiente semana."

# game/02_cap1_conexiones.rpy:3773
translate turkish cap1_interconexion_6_c3660936_1:

    # narrador "Cerró con la calma de siempre."
    # english: narrador "He shut the door with his usual calm."
    narrador "Cerró con la calma de siempre."

# game/02_cap1_conexiones.rpy:3775
translate turkish cap1_interconexion_6_a3f362bc:

    # mc_pensamiento "Viniendo de él, eso casi era un aplauso."
    # english: mc_pensamiento "Coming from him, that was practically applause."
    mc_pensamiento "Viniendo de él, eso casi era un aplauso."

# game/02_cap1_conexiones.rpy:3777
translate turkish cap1_interconexion_6_af6371f7:

    # mc_pensamiento "Aún me queda mi última oportunidad."
    # english: mc_pensamiento "I still have my last chance."
    mc_pensamiento "Aún me queda mi última oportunidad."

# game/02_cap1_conexiones.rpy:3791
translate turkish cap1_interconexion_6_2c844846:

    # mc_pensamiento "Maruo no apareció esa tarde."
    # english: mc_pensamiento "Maruo didn't show up that afternoon."
    mc_pensamiento "Maruo no apareció esa tarde."

# game/02_cap1_conexiones.rpy:3793
translate turkish cap1_interconexion_6_1c83cd7d:

    # mc_pensamiento "Con la mesa así, ni falta hacía."
    # english: mc_pensamiento "With the table like that, he didn't need to."
    mc_pensamiento "Con la mesa así, ni falta hacía."

# game/02_cap1_conexiones.rpy:3795
translate turkish cap1_interconexion_6_cd724de1:

    # mc_pensamiento "Pero cuando me fui, sus zapatos seguían en la entrada."
    # english: mc_pensamiento "But when I left, his shoes were still by the door."
    mc_pensamiento "Pero cuando me fui, sus zapatos seguían en la entrada."

# game/02_cap1_conexiones.rpy:3797
translate turkish cap1_interconexion_6_d44413c6:

    # mc_pensamiento "No sé a qué hora llegó. No sé cuánto escuchó."
    # english: mc_pensamiento "I don't know when he got there. I don't know how much he heard."
    mc_pensamiento "No sé a qué hora llegó. No sé cuánto escuchó."

# game/02_cap1_conexiones.rpy:3799
translate turkish cap1_interconexion_6_628e6243:

    # mc_pensamiento "Solo sé que no interrumpió."
    # english: mc_pensamiento "I only know he didn't interrupt."
    mc_pensamiento "Solo sé que no interrumpió."

# game/02_cap1_conexiones.rpy:3803
translate turkish cap1_interconexion_6_2c844846_1:

    # mc_pensamiento "Maruo no apareció esa tarde."
    # english: mc_pensamiento "Maruo didn't show up that afternoon."
    mc_pensamiento "Maruo no apareció esa tarde."

# game/02_cap1_conexiones.rpy:3805
translate turkish cap1_interconexion_6_25868131:

    # mc_pensamiento "Con él, no saber si eso es buena o mala señal ya es costumbre."
    # english: mc_pensamiento "With him, not knowing whether that's a good or bad sign is par for the course."
    mc_pensamiento "Con él, no saber si eso es buena o mala señal ya es costumbre."

# game/02_cap1_conexiones.rpy:3807
translate turkish cap1_interconexion_6_177b570f:

    # mc_pensamiento "Aunque sus zapatos seguían en la entrada cuando me fui."
    # english: mc_pensamiento "Though his shoes were still by the door when I left."
    mc_pensamiento "Aunque sus zapatos seguían en la entrada cuando me fui."

# game/02_cap1_conexiones.rpy:3809
translate turkish cap1_interconexion_6_6987988c:

    # mc_pensamiento "Tal vez aparezca cuando terminen los exámenes. Con su último mensaje para mí."
    # english: mc_pensamiento "Maybe he'll turn up when the exams are over. With his final message for me."
    mc_pensamiento "Tal vez aparezca cuando terminen los exámenes. Con su último mensaje para mí."

# game/02_cap1_conexiones.rpy:3811
translate turkish cap1_interconexion_6_aa067f33:

    # mc_pensamiento "Ojalá no llegue ese día."
    # english: mc_pensamiento "I hope that day never comes."
    mc_pensamiento "Ojalá no llegue ese día."

# game/02_cap1_conexiones.rpy:3816
translate turkish cap1_interconexion_6_3fe9cad6:

    # narrador "Terminamos pasadas las 6. Nadie quería ser la primera en irse."
    # english: narrador "We finished a little after 6. Nobody wanted to be the first to leave."
    narrador "Terminamos pasadas las 6. Nadie quería ser la primera en irse."

# game/02_cap1_conexiones.rpy:3818
translate turkish cap1_interconexion_6_af707b41:

    # narrador "Yotsuba llevaba diez minutos diciendo que era su última pregunta."
    # english: narrador "Yotsuba had been saying it was her last question for ten minutes."
    narrador "Yotsuba llevaba diez minutos diciendo que era su última pregunta."

# game/02_cap1_conexiones.rpy:3820
translate turkish cap1_interconexion_6_18fd948a:

    # yotsuba "¡Una más! ¡Pero esta sí es la última! ¡Palabra de atleta!"
    # english: yotsuba "One more! But this one's really the last! Athlete's honor!"
    yotsuba "¡Una más! ¡Pero esta sí es la última! ¡Palabra de atleta!"

# game/02_cap1_conexiones.rpy:3822
translate turkish cap1_interconexion_6_6f210dc7:

    # mc "Esa ya la dijiste tres veces."
    # english: mc "You've said that three times already."
    mc "Esa ya la dijiste tres veces."

# game/02_cap1_conexiones.rpy:3824
translate turkish cap1_interconexion_6_ff00c164:

    # yotsuba "¡Y las tres iba en serio!"
    # english: yotsuba "And I meant it all three times!"
    yotsuba "¡Y las tres iba en serio!"

# game/02_cap1_conexiones.rpy:3826
translate turkish cap1_interconexion_6_09bf44ca:

    # narrador "Ichika se estiró y soltó un bostezo de verdad. No de actuación."
    # english: narrador "Ichika stretched and let out a real yawn. Not an act."
    narrador "Ichika se estiró y soltó un bostezo de verdad. No de actuación."

# game/02_cap1_conexiones.rpy:3828
translate turkish cap1_interconexion_6_ac5d5130:

    # narrador "Y esta vez no dijo que el estrés le arruinaba la piel."
    # english: narrador "And this time she didn't say the stress was ruining her skin."
    narrador "Y esta vez no dijo que el estrés le arruinaba la piel."

# game/02_cap1_conexiones.rpy:3830
translate turkish cap1_interconexion_6_6b21f1a9:

    # narrador "Nino e Itsuki seguían comparando respuestas. Ya no discutían. Se corregían."
    # english: narrador "Nino and Itsuki were still comparing answers. They'd stopped arguing. They corrected each other."
    narrador "Nino e Itsuki seguían comparando respuestas. Ya no discutían. Se corregían."

# game/02_cap1_conexiones.rpy:3832
translate turkish cap1_interconexion_6_ba7a7b4c:

    # nino "Tu tercer paso estaba bien. La que no lo había entendido era yo."
    # english: nino "Your third step was right. I was the one who didn't get it."
    nino "Tu tercer paso estaba bien. La que no lo había entendido era yo."

# game/02_cap1_conexiones.rpy:3834
translate turkish cap1_interconexion_6_739f11a5:

    # itsuki "...Gracias."
    # english: itsuki "...Thank you."
    itsuki "...Gracias."

# game/02_cap1_conexiones.rpy:3836
translate turkish cap1_interconexion_6_14505214:

    # narrador "Tan bajito que Nino fingió no oírlo."
    # english: narrador "So quietly that Nino pretended not to hear."
    narrador "Tan bajito que Nino fingió no oírlo."

# game/02_cap1_conexiones.rpy:3838
translate turkish cap1_interconexion_6_f7020fa3:

    # narrador "Miku fue la última en guardar el libro. Antes de irse se detuvo en la puerta."
    # english: narrador "Miku was the last to put her book away. Before leaving, she paused at the door."
    narrador "Miku fue la última en guardar el libro. Antes de irse se detuvo en la puerta."

# game/02_cap1_conexiones.rpy:3840
translate turkish cap1_interconexion_6_997d7fc7:

    # miku "...Fue una buena tarde."
    # english: miku "...That was a good afternoon."
    miku "...Fue una buena tarde."

# game/02_cap1_conexiones.rpy:3842
translate turkish cap1_interconexion_6_3348a18d:

    # mc "Lo fue."
    # english: mc "It was."
    mc "Lo fue."

# game/02_cap1_conexiones.rpy:3844
translate turkish cap1_interconexion_6_494bb9a9:

    # narrador "Sin subirse los audífonos. Y sin pedir perdón después."
    # english: narrador "Without putting her headphones up. And without apologizing after."
    narrador "Sin subirse los audífonos. Y sin pedir perdón después."

# game/02_cap1_conexiones.rpy:3846
translate turkish cap1_interconexion_6_b4867af8:

    # mc_pensamiento "Parecía que, por fin, me habían aceptado como su tutor."
    # english: mc_pensamiento "It seemed they'd finally accepted me as their tutor."
    mc_pensamiento "Parecía que, por fin, me habían aceptado como su tutor."

# game/02_cap1_conexiones.rpy:3848
translate turkish cap1_interconexion_6_32181c3f:

    # mc_pensamiento "O, al menos, habían dejado de intentar echarme."
    # english: mc_pensamiento "Or at least they'd stopped trying to throw me out."
    mc_pensamiento "O, al menos, habían dejado de intentar echarme."

# game/02_cap1_conexiones.rpy:3850
translate turkish cap1_interconexion_6_b3a3b561:

    # mc_pensamiento "Un mes atrás habría pagado por una tarde así. Y no habría creído que existía."
    # english: mc_pensamiento "A month ago I'd have paid for an afternoon like this. And I wouldn't have believed it existed."
    mc_pensamiento "Un mes atrás habría pagado por una tarde así. Y no habría creído que existía."

# game/02_cap1_conexiones.rpy:3854
translate turkish cap1_interconexion_6_ab28c06b:

    # narrador "Terminamos pasadas las 6. Nadie se fue corriendo, pero nadie se quedó de más."
    # english: narrador "We finished a little after 6. Nobody ran out, but nobody lingered either."
    narrador "Terminamos pasadas las 6. Nadie se fue corriendo, pero nadie se quedó de más."

# game/02_cap1_conexiones.rpy:3856
translate turkish cap1_interconexion_6_812a5994:

    # narrador "Ichika recogió sus cosas todavía medio dormida y se despidió con la mano. Sin chiste."
    # english: narrador "Ichika gathered her things, still half asleep, and waved goodbye. No joke."
    narrador "Ichika recogió sus cosas todavía medio dormida y se despidió con la mano. Sin chiste."

# game/02_cap1_conexiones.rpy:3858
translate turkish cap1_interconexion_6_1d5e6281:

    # narrador "En ella, una despedida sin chiste ya era noticia."
    # english: narrador "For her, a goodbye without a joke was news."
    narrador "En ella, una despedida sin chiste ya era noticia."

# game/02_cap1_conexiones.rpy:3860
translate turkish cap1_interconexion_6_bcc064b5:

    # narrador "Nino se fue sin decirme nada."
    # english: narrador "Nino left without saying anything to me."
    narrador "Nino se fue sin decirme nada."

# game/02_cap1_conexiones.rpy:3862
translate turkish cap1_interconexion_6_4ffd00dc:

    # narrador "Pero la hoja de Yotsuba, que había quedado sobre la mesa, tenía tres correcciones con su letra."
    # english: narrador "But Yotsuba's sheet, left on the table, had three corrections in Nino's handwriting."
    narrador "Pero la hoja de Yotsuba, que había quedado sobre la mesa, tenía tres correcciones con su letra."

# game/02_cap1_conexiones.rpy:3864
translate turkish cap1_interconexion_6_8657e07d:

    # yotsuba "¡Mañana seguiremos! ¡Y será mejor!"
    # english: yotsuba "We'll keep going tomorrow! And it'll be better!"
    yotsuba "¡Mañana seguiremos! ¡Y será mejor!"

# game/02_cap1_conexiones.rpy:3866
translate turkish cap1_interconexion_6_ec29a107:

    # narrador "Guardó los lápices más lento de lo necesario, esperando respuesta."
    # english: narrador "She put the pencils away slower than needed, waiting for an answer."
    narrador "Guardó los lápices más lento de lo necesario, esperando respuesta."

# game/02_cap1_conexiones.rpy:3868
translate turkish cap1_interconexion_6_7d0f5309:

    # mc "Mañana seguiremos."
    # english: mc "We'll keep going tomorrow."
    mc "Mañana seguiremos."

# game/02_cap1_conexiones.rpy:3870
translate turkish cap1_interconexion_6_c7d3b801:

    # narrador "Itsuki cerró el cuaderno y dijo que le quedaba algo por repasar sola."
    # english: narrador "Itsuki closed her notebook and said she had something left to review alone."
    narrador "Itsuki cerró el cuaderno y dijo que le quedaba algo por repasar sola."

# game/02_cap1_conexiones.rpy:3872
translate turkish cap1_interconexion_6_e4b90508:

    # narrador "No me pidió ayuda. Tampoco me pidió que me fuera."
    # english: narrador "She didn't ask for help. She didn't ask me to leave, either."
    narrador "No me pidió ayuda. Tampoco me pidió que me fuera."

# game/02_cap1_conexiones.rpy:3874
translate turkish cap1_interconexion_6_5d005e68:

    # miku "...Hasta mañana."
    # english: miku "...See you tomorrow."
    miku "...Hasta mañana."

# game/02_cap1_conexiones.rpy:3876
translate turkish cap1_interconexion_6_4d06f82a:

    # narrador "Dos palabras, dichas desde la puerta, sin subirse los audífonos. Un avance enorme."
    # english: narrador "A few words, said from the doorway, without pulling her headphones up. Huge progress."
    narrador "Dos palabras, dichas desde la puerta, sin subirse los audífonos. Un avance enorme."

# game/02_cap1_conexiones.rpy:3878
translate turkish cap1_interconexion_6_5289a195:

    # mc_pensamiento "No fue un aplauso. Pero tampoco fue el portazo del primer día."
    # english: mc_pensamiento "It wasn't applause. But it wasn't the slammed door of the first day, either."
    mc_pensamiento "No fue un aplauso. Pero tampoco fue el portazo del primer día."

# game/02_cap1_conexiones.rpy:3880
translate turkish cap1_interconexion_6_8582650c:

    # mc_pensamiento "Con ellas, eso ya es mucho."
    # english: mc_pensamiento "With them, that's already a lot."
    mc_pensamiento "Con ellas, eso ya es mucho."

# game/02_cap1_conexiones.rpy:3882
translate turkish cap1_interconexion_6_6ea7c148:

    # mc_pensamiento "Lo que no sabía era si sería suficiente para que aprueben los exámenes."
    # english: mc_pensamiento "What I didn't know was whether it would be enough to pass the exams."
    mc_pensamiento "Lo que no sabía era si sería suficiente para que aprueben los exámenes."

# game/02_cap1_conexiones.rpy:3884
translate turkish cap1_interconexion_6_c39a0182:

    # mc_pensamiento "No lo sé."
    # english: mc_pensamiento "I don't know."
    mc_pensamiento "No lo sé."

# game/02_cap1_conexiones.rpy:3888
translate turkish cap1_interconexion_6_5c53543a:

    # narrador "Terminamos pasadas las 6. Se fueron saliendo de a una, sin despedirse del todo."
    # english: narrador "We finished a little after 6. They left one by one, never quite saying goodbye."
    narrador "Terminamos pasadas las 6. Se fueron saliendo de a una, sin despedirse del todo."

# game/02_cap1_conexiones.rpy:3890
translate turkish cap1_interconexion_6_bf5c1869:

    # narrador "Ichika se despertó cuando ya nadie la miraba."
    # english: narrador "Ichika woke up when nobody was looking anymore."
    narrador "Ichika se despertó cuando ya nadie la miraba."

# game/02_cap1_conexiones.rpy:3892
translate turkish cap1_interconexion_6_ca2b3580:

