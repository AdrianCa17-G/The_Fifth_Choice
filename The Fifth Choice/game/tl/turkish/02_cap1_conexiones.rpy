translate turkish cap1_interconexion_5_6daef2b0:

    # mc_pensamiento "Pero la confianza también se acaba."
    # english: mc_pensamiento "But trust runs out, too."
    mc_pensamiento "Pero la confianza también se acaba."

# game/02_cap1_conexiones.rpy:3156
translate turkish cap1_interconexion_5_b82fd808:

    # mc_pensamiento "Las otras dos se van a quedar esperando."
    # english: mc_pensamiento "The other two will be left waiting."
    mc_pensamiento "Las otras dos se van a quedar esperando."

# game/02_cap1_conexiones.rpy:3158
translate turkish cap1_interconexion_5_14f08cdd:

    # mc_pensamiento "Eso también lo elijo yo."
    # english: mc_pensamiento "That's my choice, too."
    mc_pensamiento "Eso también lo elijo yo."

# game/02_cap1_conexiones.rpy:3203
translate turkish cap1_interconexion_6_e29c8c40:

    # narrador "Llegué a mi habitación y fui directamente a mi escritorio."
    # english: narrador "I got to my room and went straight to my desk."
    narrador "Llegué a mi habitación y fui directamente a mi escritorio."

# game/02_cap1_conexiones.rpy:3205
translate turkish cap1_interconexion_6_f5b0f01a:

    # narrador "Agarré la libreta y la abrí por primera vez en semanas."
    # english: narrador "I grabbed the notebook and opened it for the first time in weeks."
    narrador "Agarré la libreta y la abrí por primera vez en semanas."

# game/02_cap1_conexiones.rpy:3207
translate turkish cap1_interconexion_6_dfd06a4f:

    # mc_pensamiento "Cinco nombres con tres tardes ya gastadas."
    # english: mc_pensamiento "Five names, three afternoons already spent."
    mc_pensamiento "Cinco nombres con tres tardes ya gastadas."

# game/02_cap1_conexiones.rpy:3209
translate turkish cap1_interconexion_6_8b121cdd:

    # mc_pensamiento "Y el lunes empiezan los exámenes."
    # english: mc_pensamiento "And the exams start Monday."
    mc_pensamiento "Y el lunes empiezan los exámenes."

# game/02_cap1_conexiones.rpy:3213
translate turkish cap1_interconexion_6_de994cb5:

    # mc_pensamiento "Con [nombre_h!t], la última tarde salió mejor de lo que esperaba."
    # english: mc_pensamiento "The last afternoon with [nombre_h!t] went better than I expected."
    mc_pensamiento "Con [nombre_h!t], la última tarde salió mejor de lo que esperaba."

# game/02_cap1_conexiones.rpy:3215
translate turkish cap1_interconexion_6_5407a410:

    # mc_pensamiento "Puede que hoy hasta duerma."
    # english: mc_pensamiento "Maybe I'll even sleep tonight."
    mc_pensamiento "Puede que hoy hasta duerma."

# game/02_cap1_conexiones.rpy:3217
translate turkish cap1_interconexion_6_3c7fa4a3:

    # mc_pensamiento "Con ellas, que algo salga bien siempre me asusta un poco."
    # english: mc_pensamiento "With them, when something goes well, it always scares me a little."
    mc_pensamiento "Con ellas, que algo salga bien siempre me asusta un poco."

# game/02_cap1_conexiones.rpy:3221
translate turkish cap1_interconexion_6_e4f3bd87:

    # mc_pensamiento "No sé si dormiré."
    # english: mc_pensamiento "I don't know if I'll sleep."
    mc_pensamiento "No sé si dormiré."

# game/02_cap1_conexiones.rpy:3223
translate turkish cap1_interconexion_6_ed71c05d:

    # mc_pensamiento "Con [nombre_h!t], la última tarde no sumó ni restó."
    # english: mc_pensamiento "The last afternoon with [nombre_h!t] didn't add or subtract anything."
    mc_pensamiento "Con [nombre_h!t], la última tarde no sumó ni restó."

# game/02_cap1_conexiones.rpy:3225
translate turkish cap1_interconexion_6_4892cf3c:

    # mc_pensamiento "Y con el tiempo contado, eso ya es una forma de perder."
    # english: mc_pensamiento "And with time running out, that's already a way of losing."
    mc_pensamiento "Y con el tiempo contado, eso ya es una forma de perder."

# game/02_cap1_conexiones.rpy:3229
translate turkish cap1_interconexion_6_190abd47:

    # mc_pensamiento "Esta última tarde me pesaba."
    # english: mc_pensamiento "That last afternoon weighed on me."
    mc_pensamiento "Esta última tarde me pesaba."

# game/02_cap1_conexiones.rpy:3231
translate turkish cap1_interconexion_6_a50ce15f:

    # mc_pensamiento "Me va a costar dormir."
    # english: mc_pensamiento "It's going to be hard to sleep."
    mc_pensamiento "Me va a costar dormir."

# game/02_cap1_conexiones.rpy:3233
translate turkish cap1_interconexion_6_6a9afc65:

    # mc_pensamiento "Tenía una sola tarde, y la usé para decirle eso a [nombre_h!t]."
    # english: mc_pensamiento "I had one afternoon, and I used it to say that to [nombre_h!t]."
    mc_pensamiento "Tenía una sola tarde, y la usé para decirle eso a [nombre_h!t]."

# game/02_cap1_conexiones.rpy:3235
translate turkish cap1_interconexion_6_edae77f9:

    # mc_pensamiento "Seguía oyendo mi propia voz diciendo lo que dije."
    # english: mc_pensamiento "I kept hearing my own voice saying what I said."
    mc_pensamiento "Seguía oyendo mi propia voz diciendo lo que dije."

# game/02_cap1_conexiones.rpy:3239
translate turkish cap1_interconexion_6_3b550a94:

    # mc_pensamiento "Y mi última oportunidad la desperdicié."
    # english: mc_pensamiento "And I wasted my last chance."
    mc_pensamiento "Y mi última oportunidad la desperdicié."

# game/02_cap1_conexiones.rpy:3241
translate turkish cap1_interconexion_6_a9782a81:

    # mc_pensamiento "Sabía que algo se había roto con Maruo. Lo que no sabía era cuánto."
    # english: mc_pensamiento "I knew something had broken with Maruo. What I didn't know was how badly."
    mc_pensamiento "Sabía que algo se había roto con Maruo. Lo que no sabía era cuánto."

# game/02_cap1_conexiones.rpy:3243
translate turkish cap1_interconexion_6_59f0c7ff:

    # mc_pensamiento "Lo sabré después de los exámenes."
    # english: mc_pensamiento "I'd find out after the exams."
    mc_pensamiento "Lo sabré después de los exámenes."

# game/02_cap1_conexiones.rpy:3245
translate turkish cap1_interconexion_6_a220126b:

    # mc_pensamiento "Cuando vea reprobar a sus hijas."
    # english: mc_pensamiento "When I watch his daughters fail."
    mc_pensamiento "Cuando vea reprobar a sus hijas."

# game/02_cap1_conexiones.rpy:3247
translate turkish cap1_interconexion_6_966e103a:

    # mc_pensamiento "Desde mi pupitre, sin poder decir nada."
    # english: mc_pensamiento "From my desk, unable to say a word."
    mc_pensamiento "Desde mi pupitre, sin poder decir nada."

# game/02_cap1_conexiones.rpy:3249
translate turkish cap1_interconexion_6_4679d847:

    # mc_pensamiento "No quiero ni imaginar la cara que pondrán Raiha y mi padre."
    # english: mc_pensamiento "I don't even want to imagine the faces Raiha and my father will make."
    mc_pensamiento "No quiero ni imaginar la cara que pondrán Raiha y mi padre."

# game/02_cap1_conexiones.rpy:3253
translate turkish cap1_interconexion_6_d7143402:

    # mc_pensamiento "La advertencia de Maruo seguía en pie."
    # english: mc_pensamiento "Maruo's warning still stood."
    mc_pensamiento "La advertencia de Maruo seguía en pie."

# game/02_cap1_conexiones.rpy:3255
translate turkish cap1_interconexion_6_615cbe23:

    # mc_pensamiento "Pero esta vez, por los pelos, le había ganado."
    # english: mc_pensamiento "But this time, by a hair, I'd beaten it."
    mc_pensamiento "Pero esta vez, por los pelos, le había ganado."

# game/02_cap1_conexiones.rpy:3257
translate turkish cap1_interconexion_6_20fb25f9:

    # mc_pensamiento "Parece que sí habrá trabajo para el siguiente mes."
    # english: mc_pensamiento "Looks like there'll be work next month after all."
    mc_pensamiento "Parece que sí habrá trabajo para el siguiente mes."

# game/02_cap1_conexiones.rpy:3264
translate turkish cap1_interconexion_6_21ee4899:

    # mc_pensamiento "Mañana es viernes."
    # english: mc_pensamiento "Tomorrow's Friday."
    mc_pensamiento "Mañana es viernes."

# game/02_cap1_conexiones.rpy:3266
translate turkish cap1_interconexion_6_19793afa:

    # mc_pensamiento "El último día antes de la semana de exámenes."
    # english: mc_pensamiento "The last day before exam week."
    mc_pensamiento "El último día antes de la semana de exámenes."

# game/02_cap1_conexiones.rpy:3268
translate turkish cap1_interconexion_6_e892e575:

    # mc_pensamiento "Hablaré con las chicas y les daré un mensaje de aliento."
    # english: mc_pensamiento "I'll talk to the girls and give them a pep talk."
    mc_pensamiento "Hablaré con las chicas y les daré un mensaje de aliento."

# game/02_cap1_conexiones.rpy:3270
translate turkish cap1_interconexion_6_b2f00d9b:

    # mc_pensamiento "No soy muy bueno animando a gente."
    # english: mc_pensamiento "I'm not good at cheering people up."
    mc_pensamiento "No soy muy bueno animando a gente."

# game/02_cap1_conexiones.rpy:3272
translate turkish cap1_interconexion_6_5ae8a594:

    # mc_pensamiento "Pero mañana daré mi mejor esfuerzo."
    # english: mc_pensamiento "But tomorrow I'll give it my best."
    mc_pensamiento "Pero mañana daré mi mejor esfuerzo."

# game/02_cap1_conexiones.rpy:3283
translate turkish cap1_interconexion_6_b62ccdfb:

    # narrador "Viernes. El instituto olía distinto: a papel subrayado y estudiantes preocupados."
    # english: narrador "Friday. The school smelled different: like highlighted paper and worried students."
    narrador "Viernes. El instituto olía distinto: a papel subrayado y estudiantes preocupados."

# game/02_cap1_conexiones.rpy:3285
translate turkish cap1_interconexion_6_5dc916ab:

    # narrador "Hasta los alumnos que nunca estudian tenían un cuaderno abierto."
    # english: narrador "Even the students who never study had a notebook open."
    narrador "Hasta los alumnos que nunca estudian tenían un cuaderno abierto."

# game/02_cap1_conexiones.rpy:3287
translate turkish cap1_interconexion_6_566cc354:

    # narrador "La tensión se sentía hasta en los rincones del instituto."
    # english: narrador "You could feel the tension in every corner of the school."
    narrador "La tensión se sentía hasta en los rincones del instituto."

# game/02_cap1_conexiones.rpy:3289
translate turkish cap1_interconexion_6_5fc1b353:

    # narrador "Y yo no podía ser la excepción."
    # english: narrador "And I was no exception."
    narrador "Y yo no podía ser la excepción."

# game/02_cap1_conexiones.rpy:3293
translate turkish cap1_interconexion_6_ef5f02a8:

    # mc_pensamiento "Mis exámenes no me quitan el sueño."
    # english: mc_pensamiento "My exams don't keep me up at night."
    mc_pensamiento "Mis exámenes no me quitan el sueño."

# game/02_cap1_conexiones.rpy:3295
translate turkish cap1_interconexion_6_08e08537:

    # mc_pensamiento "Los suyos, sí."
    # english: mc_pensamiento "Theirs do."
    mc_pensamiento "Los suyos, sí."

# game/02_cap1_conexiones.rpy:3297
translate turkish cap1_interconexion_6_1a3b9cab:

    # mc_pensamiento "Mejor voy al aula."
    # english: mc_pensamiento "Better head to the classroom."
    mc_pensamiento "Mejor voy al aula."

# game/02_cap1_conexiones.rpy:3302
translate turkish cap1_interconexion_6_2413c4e6:

    # narrador "En el aula nadie hablaba de otra cosa más que de los exámenes."
    # english: narrador "In the classroom, nobody talked about anything but the exams."
    narrador "En el aula nadie hablaba de otra cosa más que de los exámenes."

# game/02_cap1_conexiones.rpy:3304
translate turkish cap1_interconexion_6_230f8a10:

    # narrador "Y las Nakano, menos."
    # english: narrador "And the Nakanos least of all."
    narrador "Y las Nakano, menos."

# game/02_cap1_conexiones.rpy:3306
translate turkish cap1_interconexion_6_c08f775c:

    # narrador "De repente, [nombre_h!t] se me cruzó en el camino."
    # english: narrador "Out of nowhere, [nombre_h!t] stepped into my path."
    narrador "De repente, [nombre_h!t] se me cruzó en el camino."

# game/02_cap1_conexiones.rpy:3313
translate turkish cap1_interconexion_6_480744a7:

    # narrador "A media mañana me alcanzaron, las dos únicas quintillizas."
    # english: narrador "Mid-morning, the only two sisters left caught up with me."
    narrador "A media mañana me alcanzaron, las dos únicas quintillizas."

# game/02_cap1_conexiones.rpy:3315
translate turkish cap1_interconexion_6_2d29bcca:

    # narrador "A las que no había ido a buscar."
    # english: narrador "The two I hadn't gone looking for."
    narrador "A las que no había ido a buscar."

# game/02_cap1_conexiones.rpy:3345
translate turkish cap1_interconexion_6_022ef673:

    # narrador "Faltaba la cereza del pastel."
    # english: narrador "All that was missing was the cherry on top."
    narrador "Faltaba la cereza del pastel."

# game/02_cap1_conexiones.rpy:3347
translate turkish cap1_interconexion_6_a0b933c8:

    # narrador "Y la puso la que había empezado el juego. Con su frialdad de siempre."
    # english: narrador "And it came from the one who started the game. With her usual coolness."
    narrador "Y la puso la que había empezado el juego. Con su frialdad de siempre."

# game/02_cap1_conexiones.rpy:3358
translate turkish cap1_interconexion_6_f9ed82c5:

    # itsuki "El juego se acabó hoy."
    # english: itsuki "The game ends today."
    itsuki "El juego se acabó hoy."

# game/02_cap1_conexiones.rpy:3360
translate turkish cap1_interconexion_6_4ac3e07b:

    # mc "¿Ya?"
    # english: mc "Already?"
    mc "¿Ya?"

# game/02_cap1_conexiones.rpy:3362
translate turkish cap1_interconexion_6_b0f8f4f6:

    # itsuki "Era la última tarde libre. No quedan más."
    # english: itsuki "That was the last free afternoon. There are no more."
    itsuki "Era la última tarde libre. No quedan más."

# game/02_cap1_conexiones.rpy:3364
translate turkish cap1_interconexion_6_ffdaed10:

    # mc "Ya lo sabía, señora obvia."
    # english: mc "I know that, Captain Obvious."
    mc "Ya lo sabía, señora obvia."

# game/02_cap1_conexiones.rpy:3366
translate turkish cap1_interconexion_6_7bda1083:

    # itsuki "Te dije que no alcanzarías para todas. Tres de cinco."
    # english: itsuki "I told you that you wouldn't reach all of us. Three out of five."
    itsuki "Te dije que no alcanzarías para todas. Tres de cinco."

# game/02_cap1_conexiones.rpy:3368
translate turkish cap1_interconexion_6_d2dd9d5f:

    # itsuki "El trabajo resultó más pesado de lo que creías."
    # english: itsuki "The job turned out heavier than you thought."
    itsuki "El trabajo resultó más pesado de lo que creías."

# game/02_cap1_conexiones.rpy:3370
translate turkish cap1_interconexion_6_50d8828a:

    # mc "Lo sé."
    # english: mc "I know."
    mc "Lo sé."

# game/02_cap1_conexiones.rpy:3376
translate turkish cap1_interconexion_6_055a5bb9:

    # yotsuba "¡Pero tres de cinco es más de la mitad! ¡Es un sesenta por ciento!"
    # english: yotsuba "But three out of five is more than half! That's sixty percent!"
    yotsuba "¡Pero tres de cinco es más de la mitad! ¡Es un sesenta por ciento!"

# game/02_cap1_conexiones.rpy:3378
translate turkish cap1_interconexion_6_3eee98fa:

    # yotsuba "¡Un sesenta es un buen número!"
    # english: yotsuba "Sixty is a great number!"
    yotsuba "¡Un sesenta es un buen número!"

# game/02_cap1_conexiones.rpy:3384
translate turkish cap1_interconexion_6_c3f9ed4d:

    # itsuki "Es un aprobado a medias, Yotsuba."
    # english: itsuki "It's a barely-passing grade, Yotsuba."
    itsuki "Es un aprobado a medias, Yotsuba."

# game/02_cap1_conexiones.rpy:3386
translate turkish cap1_interconexion_6_e59adc18:

    # itsuki "Hay algo de esfuerzo, pero no lo suficiente."
    # english: itsuki "There's some effort, but not enough."
    itsuki "Hay algo de esfuerzo, pero no lo suficiente."

# game/02_cap1_conexiones.rpy:3392
translate turkish cap1_interconexion_6_ff87fe90:

    # ichika "Y el pobre tutor corriendo detrás de nosotras todo el mes."
    # english: ichika "And poor tutor, running after us all month."
    ichika "Y el pobre tutor corriendo detrás de nosotras todo el mes."

# game/02_cap1_conexiones.rpy:3396
translate turkish cap1_interconexion_6_182aa232:

    # ichika "Qué romántico."
    # english: ichika "How romantic."
    ichika "Qué romántico."

# game/02_cap1_conexiones.rpy:3398
translate turkish cap1_interconexion_6_4ecb6adc:

    # ichika "A mí me encontró dormida en el suelo."
    # english: ichika "He found me asleep on the floor."
    ichika "A mí me encontró dormida en el suelo."

# game/02_cap1_conexiones.rpy:3402
translate turkish cap1_interconexion_6_182aa232_1:

    # ichika "Qué romántico."
    # english: ichika "How romantic."
    ichika "Qué romántico."

# game/02_cap1_conexiones.rpy:3404
translate turkish cap1_interconexion_6_9e956335:

    # ichika "Casi me dan ganas de haberme dejado encontrar."
    # english: ichika "I almost wish I'd let myself be found."
    ichika "Casi me dan ganas de haberme dejado encontrar."

# game/02_cap1_conexiones.rpy:3406
translate turkish cap1_interconexion_6_b7dafb17:

    # mc "Fue mi trabajo."
    # english: mc "It was my job."
    mc "Fue mi trabajo."

# game/02_cap1_conexiones.rpy:3408
translate turkish cap1_interconexion_6_9dcd460c:

    # mc "No tenía otras intenciones."
    # english: mc "I had no other intentions."
    mc "No tenía otras intenciones."

# game/02_cap1_conexiones.rpy:3410
translate turkish cap1_interconexion_6_c5e00067:

    # ichika "Ya, ya. Trabajo."
    # english: ichika "Sure, sure. Work."
    ichika "Ya, ya. Trabajo."

# game/02_cap1_conexiones.rpy:3412
translate turkish cap1_interconexion_6_9387cf32:

    # ichika "Como tú digas."
    # english: ichika "Whatever you say."
    ichika "Como tú digas."

# game/02_cap1_conexiones.rpy:3418
translate turkish cap1_interconexion_6_435cdb8c:

    # nino "Dejen de hacerlo parecer una hazaña."
    # english: nino "Stop making it sound like some great feat."
    nino "Dejen de hacerlo parecer una hazaña."

# game/02_cap1_conexiones.rpy:3420
translate turkish cap1_interconexion_6_fb8aeb1c:

    # nino "Solo fue un tipo yendo de aquí para allá."
    # english: nino "It was just some guy running back and forth."
    nino "Solo fue un tipo yendo de aquí para allá."

# game/02_cap1_conexiones.rpy:3422
translate turkish cap1_interconexion_6_dec2abf0:

    # nino "Nada relevante."
    # english: nino "Nothing special."
    nino "Nada relevante."

# game/02_cap1_conexiones.rpy:3426
translate turkish cap1_interconexion_6_a8370f4e:

    # nino "...Pero pensándolo bien."
    # english: nino "...But come to think of it."
    nino "...Pero pensándolo bien."

# game/02_cap1_conexiones.rpy:3428
translate turkish cap1_interconexion_6_1cd560ad:

    # nino "...Hasta ahora no fue el peor tutor que hemos tenido."
    # english: nino "...So far, he hasn't been the worst tutor we've had."
    nino "...Hasta ahora no fue el peor tutor que hemos tenido."

# game/02_cap1_conexiones.rpy:3430
translate turkish cap1_interconexion_6_ca31f8c6:

    # mc "Gracias, Nino, por el cumplido."
    # english: mc "Thanks for the compliment, Nino."
    mc "Gracias, Nino, por el cumplido."

# game/02_cap1_conexiones.rpy:3432
translate turkish cap1_interconexion_6_ce20d29c:

    # mc "Viniendo de ti, es porque en verdad hice un buen trabajo."
    # english: mc "Coming from you, it means I really did a good job."
    mc "Viniendo de ti, es porque en verdad hice un buen trabajo."

# game/02_cap1_conexiones.rpy:3434
translate turkish cap1_interconexion_6_4326f4e2:

    # narrador "Se volteó con la cara sonrojada."
    # english: narrador "She turned away, her face flushed."
    narrador "Se volteó con la cara sonrojada."

# game/02_cap1_conexiones.rpy:3439
translate turkish cap1_interconexion_6_cc98f57b:

    # nino "Idiota."
    # english: nino "Idiot."
    nino "Idiota."

# game/02_cap1_conexiones.rpy:3441
translate turkish cap1_interconexion_6_d4cb08c7:

    # nino "Que quede claro que eso no es un cumplido."
    # english: nino "And to be clear, that wasn't a compliment."
    nino "Que quede claro que eso no es un cumplido."

# game/02_cap1_conexiones.rpy:3443
translate turkish cap1_interconexion_6_6f194521:

    # nino "Era tu trabajo, tu obligación, nada más."
    # english: nino "It was your job, your obligation, nothing more."
    nino "Era tu trabajo, tu obligación, nada más."

# game/02_cap1_conexiones.rpy:3447
translate turkish cap1_interconexion_6_35036d86:

    # nino "Y todavía falta ver si sirvió de algo."
    # english: nino "And we still have to see if it did any good."
    nino "Y todavía falta ver si sirvió de algo."

# game/02_cap1_conexiones.rpy:3449
translate turkish cap1_interconexion_6_bc07b2f8:

    # mc "Si sirvió, no lo dudes."
    # english: mc "It did, don't doubt it."
