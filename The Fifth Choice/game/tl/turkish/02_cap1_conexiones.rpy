    # narrador "En la hora de descanso las encontré a las cinco juntas."
    # english: narrador "At the break, I found all five of them together."
    narrador "En la hora de descanso las encontré a las cinco juntas."

# game/02_cap1_conexiones.rpy:953
translate turkish cap1_interconexion_1_a5410405:

    # mc_pensamiento "No venía a obligarlas a estudiar todas juntas. Eso ya sé que no funciona."
    # english: mc_pensamiento "I hadn't come to force them to study together. I already know that doesn't work."
    mc_pensamiento "No venía a obligarlas a estudiar todas juntas. Eso ya sé que no funciona."

