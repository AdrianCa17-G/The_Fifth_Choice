    # english: nino "I couldn't care less."
    nino "Me da exactamente igual."

# game/02_cap1_conexiones.rpy:702
translate turkish queja_nino_9e5c26f8:

    # nino "Además, ya te vi en mi casa más de lo que quería."
    # english: nino "Besides, I've already seen you at my place more than I wanted to."
    nino "Además, ya te vi en mi casa más de lo que quería."

# game/02_cap1_conexiones.rpy:704
translate turkish queja_nino_d98384c0:

    # nino "Eso cuenta como visita. Por desgracia."
    # english: nino "That counts as a visit. Unfortunately."
    nino "Eso cuenta como visita. Por desgracia."

# game/02_cap1_conexiones.rpy:706
translate turkish queja_nino_7cb8b689:

    # mc "¿Eso fue un «me hubiera gustado»?"
    # english: mc "Was that a \"wish you'd come\"?"
    mc "¿Eso fue un «me hubiera gustado»?"

# game/02_cap1_conexiones.rpy:708
translate turkish queja_nino_4073aa39:

    # nino "¡NO! ¡Fue un «qué alivio»!"
    # english: nino "NO! That was a \"what a relief\"!"
    nino "¡NO! ¡Fue un «qué alivio»!"

# game/02_cap1_conexiones.rpy:713
translate turkish queja_nino_25d6d6d4:

    # nino "...Mira. No esperaba nada."
    # english: nino "...Look. I didn't expect anything."
    nino "...Mira. No esperaba nada."

# game/02_cap1_conexiones.rpy:715
translate turkish queja_nino_3494ccc3:

    # nino "Esa es la ventaja de no esperar: nadie te decepciona."
    # english: nino "That's the upside of not expecting anything: nobody lets you down."
    nino "Esa es la ventaja de no esperar: nadie te decepciona."

# game/02_cap1_conexiones.rpy:717
translate turkish queja_nino_6b7659d0:

    # nino "Pero las que sí fuiste a ver llegaron distintas a casa."
    # english: nino "But the ones you did go see came home different."
    nino "Pero las que sí fuiste a ver llegaron distintas a casa."

# game/02_cap1_conexiones.rpy:719
translate turkish queja_nino_5f2be1ef:

    # mc "¿Distintas cómo?"
    # english: mc "Different how?"
    mc "¿Distintas cómo?"

# game/02_cap1_conexiones.rpy:721
translate turkish queja_nino_6522518a:

    # nino "Distintas. No te digo si mejor o peor."
    # english: nino "Different. I'm not saying better or worse."
    nino "Distintas. No te digo si mejor o peor."

# game/02_cap1_conexiones.rpy:723
translate turkish queja_nino_2756b91d:

    # nino "Pero alguien tiene que ser la que no cambia."
    # english: nino "But somebody has to be the one who doesn't change."
    nino "Pero alguien tiene que ser la que no cambia."

# game/02_cap1_conexiones.rpy:725
translate turkish queja_nino_3bafeaf9:

    # nino "Para que las demás tengan a dónde volver."
    # english: nino "So the others have somewhere to come back to."
