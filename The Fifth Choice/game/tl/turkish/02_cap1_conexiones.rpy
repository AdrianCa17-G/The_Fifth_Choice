    yotsuba "Cronometré dos vueltas de más. Por si acaso."

# game/02_cap1_conexiones.rpy:830
translate turkish queja_yotsuba_9a87d34e:

    # mc "Lo siento."
    # english: mc "I'm sorry."
    mc "Lo siento."

# game/02_cap1_conexiones.rpy:832
translate turkish queja_yotsuba_5dac8aef:

    # yotsuba "No lo sientas. Es que pensé que a lo mejor te hacía falta alguien que te animara."
    # english: yotsuba "Don't be. I just thought you might need someone to cheer you on."
    yotsuba "No lo sientas. Es que pensé que a lo mejor te hacía falta alguien que te animara."

# game/02_cap1_conexiones.rpy:834
translate turkish queja_yotsuba_46ad4975:

    # yotsuba "Y si nadie me necesita, ¿para qué me sobra tanta energía?"
    # english: yotsuba "And if nobody needs me, what's all this extra energy for?"
    yotsuba "Y si nadie me necesita, ¿para qué me sobra tanta energía?"

# game/02_cap1_conexiones.rpy:839
translate turkish queja_yotsuba_38b6516c:

    # yotsuba "¡Pero no importa! ¡Me sobra, así que la reparto!"
    # english: yotsuba "But it doesn't matter! I've got extra, so I share it!"
    yotsuba "¡Pero no importa! ¡Me sobra, así que la reparto!"

# game/02_cap1_conexiones.rpy:841
translate turkish queja_yotsuba_76e1850a:

    # yotsuba "¡Y para la próxima vez ya tengo tres vueltas de ventaja!"
    # english: yotsuba "And next time I'm already three laps ahead!"
    yotsuba "¡Y para la próxima vez ya tengo tres vueltas de ventaja!"

# game/02_cap1_conexiones.rpy:843
translate turkish queja_yotsuba_32a416fe:

    # mc "Dijiste dos."
    # english: mc "You said two."
    mc "Dijiste dos."

# game/02_cap1_conexiones.rpy:845
translate turkish queja_yotsuba_cbf2bbab:

    # yotsuba "¡La tercera la corro ahora mismo!"
    # english: yotsuba "I'm running the third one right now!"
    yotsuba "¡La tercera la corro ahora mismo!"

