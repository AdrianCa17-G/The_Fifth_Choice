# game/02_cap1_conexiones.rpy:730
translate turkish queja_nino_e3ac8a5a:

    # nino "...Eso no significa que quisiera que vinieras. Que quede claro."
    # english: nino "...That doesn't mean I wanted you to come. Let's be clear."
    nino "...Eso no significa que quisiera que vinieras. Que quede claro."

# game/02_cap1_conexiones.rpy:732
translate turkish queja_nino_45e4d005:

    # mc "Queda clarísimo."
    # english: mc "Crystal clear."
    mc "Queda clarísimo."

# game/02_cap1_conexiones.rpy:734
translate turkish queja_nino_1b421292:

    # nino "¡Y deja de poner esa cara de culpa! ¡No era una queja!"
    # english: nino "And stop making that guilty face! It wasn't a complaint!"
