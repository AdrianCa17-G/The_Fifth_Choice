    mc "¿Habría sido qué?"

# game/02_cap1_conexiones.rpy:900
translate turkish queja_itsuki_d3feb8c2:

    # itsuki "Nada. Una tontería."
    # english: itsuki "Nothing. Something silly."
    itsuki "Nada. Una tontería."

# game/02_cap1_conexiones.rpy:905
translate turkish queja_itsuki_adcff12d:

    # itsuki "Solo digo que, si hubieras venido, no te habría echado."
    # english: itsuki "I'm only saying that if you had come, I wouldn't have thrown you out."
    itsuki "Solo digo que, si hubieras venido, no te habría echado."

# game/02_cap1_conexiones.rpy:907
translate turkish queja_itsuki_c3f630c7:

    # mc "¿No?"
    # english: mc "No?"
    mc "¿No?"

# game/02_cap1_conexiones.rpy:909
translate turkish queja_itsuki_8c9930a8:

    # itsuki "No inmediatamente."
    # english: itsuki "Not immediately."
    itsuki "No inmediatamente."

# game/02_cap1_conexiones.rpy:911
translate turkish queja_itsuki_146606f2:

    # itsuki "Y no lo apuntes en ningún sitio."
    # english: itsuki "And don't write that down anywhere."
    itsuki "Y no lo apuntes en ningún sitio."

# game/02_cap1_conexiones.rpy:938
translate turkish cap1_interconexion_1_14a98fb8:

    # narrador "Llegué al instituto temprano, como siempre."
    # english: narrador "I got to school early, like always."
    narrador "Llegué al instituto temprano, como siempre."

# game/02_cap1_conexiones.rpy:942
translate turkish cap1_interconexion_1_72fdf694:

    # mc_pensamiento "Pero esta vez llegaba con un plan."
    # english: mc_pensamiento "But this time I came with a plan."
    mc_pensamiento "Pero esta vez llegaba con un plan."

# game/02_cap1_conexiones.rpy:944
translate turkish cap1_interconexion_1_714eae7e:

    # mc_pensamiento "Ir de una en una. Es la única forma de hacerlas estudiar."
    # english: mc_pensamiento "One at a time. It's the only way to get them to study."
    mc_pensamiento "Ir de una en una. Es la única forma de hacerlas estudiar."

# game/02_cap1_conexiones.rpy:946
translate turkish cap1_interconexion_1_34d88442:

    # mc_pensamiento "No será fácil, pero puedo lograrlo."
    # english: mc_pensamiento "It won't be easy, but I can do it."
    mc_pensamiento "No será fácil, pero puedo lograrlo."

