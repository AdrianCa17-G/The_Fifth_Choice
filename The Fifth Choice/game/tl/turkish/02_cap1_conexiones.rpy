translate turkish queja_miku_5171db1a:

    # narrador "Se subió el libro hasta media cara. Esta vez sí."
    # english: narrador "She pulled the book up over half her face. This time she did."
    narrador "Se subió el libro hasta media cara. Esta vez sí."

# game/02_cap1_conexiones.rpy:813
translate turkish queja_yotsuba_46514d0d:

    # yotsuba "¡No pasa nada! ¡De verdad!"
    # english: yotsuba "It's okay! Really!"
    yotsuba "¡No pasa nada! ¡De verdad!"

# game/02_cap1_conexiones.rpy:815
translate turkish queja_yotsuba_652306a9:

    # yotsuba "¡Tres tardes no alcanzan para cinco! ¡Eso lo entiende cualquiera!"
    # english: yotsuba "Three afternoons aren't enough for five! Anyone can see that!"
    yotsuba "¡Tres tardes no alcanzan para cinco! ¡Eso lo entiende cualquiera!"

# game/02_cap1_conexiones.rpy:817
translate turkish queja_yotsuba_e1afadae:

    # mc "Yotsuba..."
    # english: mc "Yotsuba..."
    mc "Yotsuba..."

# game/02_cap1_conexiones.rpy:819
translate turkish queja_yotsuba_217f6046:

    # yotsuba "¡Te lo digo en serio!"
    # english: yotsuba "I mean it!"
    yotsuba "¡Te lo digo en serio!"

