translate turkish queja_yotsuba_2655884a:

    # yotsuba "...Aunque estuve entrenando por si venías."
    # english: yotsuba "...Although I did train in case you came."
    yotsuba "...Aunque estuve entrenando por si venías."

# game/02_cap1_conexiones.rpy:826
translate turkish queja_yotsuba_a2d65b2c:

    # yotsuba "Me quedé quince minutos más cada tarde. Los conté."
    # english: yotsuba "I stayed fifteen extra minutes every afternoon. I counted."
