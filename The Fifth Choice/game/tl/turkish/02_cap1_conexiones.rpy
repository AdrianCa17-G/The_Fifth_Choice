# game/02_cap1_conexiones.rpy:766
translate turkish queja_miku_bbd09602:

    # mc "¿Con el sitio?"
    # english: mc "The spot?"
    mc "¿Con el sitio?"

# game/02_cap1_conexiones.rpy:768
translate turkish queja_miku_6702bd04:

    # miku "...Con el sitio."
    # english: miku "...The spot."
    miku "...Con el sitio."

# game/02_cap1_conexiones.rpy:770
translate turkish queja_miku_20a40419:

    # miku "...Hay una silla enfrente de la mía. Siempre está vacía."
    # english: miku "...There's a chair across from mine. It's always empty."
    miku "...Hay una silla enfrente de la mía. Siempre está vacía."

# game/02_cap1_conexiones.rpy:772
translate turkish queja_miku_ca3780b8:

    # narrador "Lo dijo mirando el libro. Pero esta vez no lo subió hasta media cara."
    # english: narrador "She said it looking at her book. But this time she didn't raise it to cover half her face."
    narrador "Lo dijo mirando el libro. Pero esta vez no lo subió hasta media cara."

# game/02_cap1_conexiones.rpy:777
translate turkish queja_miku_5ee7aa8a:

    # miku "...Dejé el libro abierto en la misma página dos días."
    # english: miku "...I left the book open to the same page for two days."
    miku "...Dejé el libro abierto en la misma página dos días."

# game/02_cap1_conexiones.rpy:779
translate turkish queja_miku_5a3a1c8e:

    # miku "...Por si hacía falta una excusa."
    # english: miku "...In case I needed an excuse."
    miku "...Por si hacía falta una excusa."

# game/02_cap1_conexiones.rpy:781
translate turkish queja_miku_9b2cffcf:

    # mc "¿Una excusa para qué?"
    # english: mc "An excuse for what?"
    mc "¿Una excusa para qué?"

# game/02_cap1_conexiones.rpy:783
translate turkish queja_miku_15c784ed:

    # miku "...Para hablar. Si alguien se sentaba."
    # english: miku "...To talk. If someone sat down."
    miku "...Para hablar. Si alguien se sentaba."

# game/02_cap1_conexiones.rpy:785
translate turkish queja_miku_011d5b90:

    # miku "...Nadie lo hizo. No pasa nada."
    # english: miku "...Nobody did. It's fine."
    miku "...Nadie lo hizo. No pasa nada."

# game/02_cap1_conexiones.rpy:787
translate turkish queja_miku_d3bc9b96:

    # mc "Lo siento, Miku."
    # english: mc "I'm sorry, Miku."
    mc "Lo siento, Miku."

# game/02_cap1_conexiones.rpy:789
translate turkish queja_miku_46f4e2f8:

    # miku "...No lo sientas. Soy buena esperando."
    # english: miku "...Don't be. I'm good at waiting."
    miku "...No lo sientas. Soy buena esperando."

# game/02_cap1_conexiones.rpy:791
translate turkish queja_miku_8e3c3fc5:

    # miku "...Perdón. Eso sonó triste. No era la idea."
