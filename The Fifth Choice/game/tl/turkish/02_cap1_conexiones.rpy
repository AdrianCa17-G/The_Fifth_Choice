    itsuki "Dije que no me iba a esconder. Y no lo hice."

# game/02_cap1_conexiones.rpy:868
translate turkish queja_itsuki_3d78fb56:

    # mc "Lo sé. Te encontré en la azotea."
    # english: mc "I know. I found you on the rooftop."
    mc "Lo sé. Te encontré en la azotea."

# game/02_cap1_conexiones.rpy:870
translate turkish queja_itsuki_b8759b8a:

    # itsuki "Eso no cuenta. Subiste por costumbre, no por buscarme."
    # english: itsuki "That doesn't count. You went up out of habit, not to look for me."
    itsuki "Eso no cuenta. Subiste por costumbre, no por buscarme."

# game/02_cap1_conexiones.rpy:872
translate turkish queja_itsuki_dc8bb2c0:

    # mc "...Es verdad."
    # english: mc "...True."
    mc "...Es verdad."

# game/02_cap1_conexiones.rpy:874
translate turkish queja_itsuki_d6edce34:

    # itsuki "Entonces gané el juego."
    # english: itsuki "Then I won the game."
    itsuki "Entonces gané el juego."

# game/02_cap1_conexiones.rpy:876
translate turkish queja_itsuki_9ac526f8:

    # mc "¿Y qué ganas?"
    # english: mc "And what do you win?"
    mc "¿Y qué ganas?"

# game/02_cap1_conexiones.rpy:878
translate turkish queja_itsuki_0e9b9593:

    # itsuki "Tener razón. Es lo único que siempre me sale bien."
    # english: itsuki "Being right. It's the one thing I always get right."
    itsuki "Tener razón. Es lo único que siempre me sale bien."

# game/02_cap1_conexiones.rpy:883
translate turkish queja_itsuki_2fc345d2:

    # itsuki "No te rías."
    # english: itsuki "Don't laugh."
    itsuki "No te rías."

# game/02_cap1_conexiones.rpy:885
translate turkish queja_itsuki_5e1b0b6c:

    # mc "No me estoy riendo."
    # english: mc "I'm not laughing."
    mc "No me estoy riendo."

# game/02_cap1_conexiones.rpy:887
translate turkish queja_itsuki_f86d718e:

    # itsuki "Se te nota en la voz."
    # english: itsuki "I can hear it in your voice."
    itsuki "Se te nota en la voz."

# game/02_cap1_conexiones.rpy:892
translate turkish queja_itsuki_41a387f4:

    # itsuki "...Tampoco esperaba que me buscaras."
    # english: itsuki "...I didn't expect you to look for me, either."
    itsuki "...Tampoco esperaba que me buscaras."

# game/02_cap1_conexiones.rpy:894
translate turkish queja_itsuki_c8ab1241:

    # itsuki "Yo no iba a pedírtelo. Pedirlo habría sido..."
    # english: itsuki "I wasn't going to ask you to. Asking would have been..."
    itsuki "Yo no iba a pedírtelo. Pedirlo habría sido..."

# game/02_cap1_conexiones.rpy:896
translate turkish queja_itsuki_6f79e92f:

    # narrador "Se detuvo. En Itsuki, dejar una frase a medias es rarísimo."
    # english: narrador "She stopped. Itsuki leaving a sentence half-done is really strange."
    narrador "Se detuvo. En Itsuki, dejar una frase a medias es rarísimo."

# game/02_cap1_conexiones.rpy:898
translate turkish queja_itsuki_4966a73e:

