    # narrador "Nino, con los brazos cruzados y la hoja en blanco, mirándome como si yo fuera el problema."
    # english: narrador "Nino, arms crossed, her sheet blank, glaring at me like I was the problem."
    narrador "Nino, con los brazos cruzados y la hoja en blanco, mirándome como si yo fuera el problema."

# game/02_cap1_conexiones.rpy:3708
translate turkish cap1_interconexion_6_3c258839:

    # narrador "Yotsuba sonreía enorme sobre una hoja casi vacía."
    # english: narrador "Yotsuba grinned wide over a nearly empty sheet."
