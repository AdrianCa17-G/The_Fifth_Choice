# game/02_cap1_conexiones.rpy:661
translate turkish queja_ichika_e757a19d:

    # ichika "¡Era un chiste! ¡Soy una artista, siempre estoy espléndida!"
    # english: ichika "It was a joke! I'm an artist, I'm always splendid!"
    ichika "¡Era un chiste! ¡Soy una artista, siempre estoy espléndida!"

# game/02_cap1_conexiones.rpy:666
translate turkish queja_ichika_827a9b01:

    # ichika "...Pero la próxima vez, no tardes tanto."
    # english: ichika "...But next time, don't take so long."
    ichika "...Pero la próxima vez, no tardes tanto."

# game/02_cap1_conexiones.rpy:668
translate turkish queja_ichika_be468d92:

    # ichika "Estas cosas se agradecen. Aunque no lo parezca."
    # english: ichika "These things are appreciated. Even if it doesn't look like it."
    ichika "Estas cosas se agradecen. Aunque no lo parezca."

# game/02_cap1_conexiones.rpy:673
translate turkish queja_ichika_b5b953c9:

    # narrador "Se fue con la sonrisa puesta."
    # english: narrador "She left with her smile still on."
    narrador "Se fue con la sonrisa puesta."

# game/02_cap1_conexiones.rpy:675
translate turkish queja_ichika_9cf2eb82:

    # narrador "Se la vi acomodar por el pasillo, como quien se ajusta un disfraz."
    # english: narrador "I watched her settle it into place down the hallway, like someone straightening a costume."
    narrador "Se la vi acomodar por el pasillo, como quien se ajusta un disfraz."

# game/02_cap1_conexiones.rpy:689
translate turkish queja_nino_1f721745:

    # nino "Ni creas que me molesta."
    # english: nino "Don't think it bothers me."
    nino "Ni creas que me molesta."

# game/02_cap1_conexiones.rpy:691
translate turkish queja_nino_b2054ef5:

