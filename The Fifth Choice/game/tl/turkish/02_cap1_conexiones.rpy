    # itsuki "No es asunto tuyo. Pero tampoco es casualidad."
    # english: itsuki "It's not your business. But it isn't a coincidence, either."
    itsuki "No es asunto tuyo. Pero tampoco es casualidad."

# game/02_cap1_conexiones.rpy:2363
translate turkish cap1_interconexion_4_4c4a805c:

    # itsuki "Y la hipótesis más probable eres tú."
    # english: itsuki "And the most likely hypothesis is you."
    itsuki "Y la hipótesis más probable eres tú."

# game/02_cap1_conexiones.rpy:2368
translate turkish cap1_interconexion_4_e5a8d4dd:

    # narrador "Nadie dijo nada más."
    # english: narrador "Nobody said anything else."
    narrador "Nadie dijo nada más."

# game/02_cap1_conexiones.rpy:2370
translate turkish cap1_interconexion_4_f8835cc3:

    # narrador "Las cuatro me miraron, y las cuatro apartaron la vista casi al mismo tiempo."
    # english: narrador "All four of them looked at me, and all four looked away at almost the same moment."
    narrador "Las cuatro me miraron, y las cuatro apartaron la vista casi al mismo tiempo."

# game/02_cap1_conexiones.rpy:2378
translate turkish cap1_interconexion_4_c65ead32:

    # mc_pensamiento "Nino no era de las que se iban sin avisar."
    # english: mc_pensamiento "Nino wasn't the type to leave without telling anyone."
    mc_pensamiento "Nino no era de las que se iban sin avisar."

# game/02_cap1_conexiones.rpy:2380
translate turkish cap1_interconexion_4_21465703:

    # mc_pensamiento "Y menos sin dejarme una frase hiriente de despedida."
    # english: mc_pensamiento "And certainly not without leaving me a cutting parting remark."
    mc_pensamiento "Y menos sin dejarme una frase hiriente de despedida."

# game/02_cap1_conexiones.rpy:2382
translate turkish cap1_interconexion_4_f02ea8fa:

    # mc_pensamiento "Las cuatro lo habían notado. Cada una a su manera."
    # english: mc_pensamiento "All four had noticed. Each in her own way."
    mc_pensamiento "Las cuatro lo habían notado. Cada una a su manera."

# game/02_cap1_conexiones.rpy:2384
translate turkish cap1_interconexion_4_fbf5dd89:

    # mc_pensamiento "Como dijo Yotsuba, debe estar en su casa con Maruo."
    # english: mc_pensamiento "Like Yotsuba said, she must be home with Maruo."
    mc_pensamiento "Como dijo Yotsuba, debe estar en su casa con Maruo."

# game/02_cap1_conexiones.rpy:2386
translate turkish cap1_interconexion_4_bba0c283:

    # mc_pensamiento "Tengo el presentimiento de que esta tarde va a ser más larga de lo normal."
    # english: mc_pensamiento "I have a feeling this afternoon is going to be longer than usual."
    mc_pensamiento "Tengo el presentimiento de que esta tarde va a ser más larga de lo normal."

# game/02_cap1_conexiones.rpy:2417
translate turkish cap1_interconexion_5_e4145c7d:

    # narrador "Llegué a casa y fui directamente a mi cuarto."
    # english: narrador "I got home and went straight to my room."
    narrador "Llegué a casa y fui directamente a mi cuarto."

# game/02_cap1_conexiones.rpy:2419
translate turkish cap1_interconexion_5_cbd975c3:

    # mc_pensamiento "Me quedé pensando en la discusión que hubo entre Nino y su padre."
    # english: mc_pensamiento "I kept thinking about the argument between Nino and her father."
    mc_pensamiento "Me quedé pensando en la discusión que hubo entre Nino y su padre."

# game/02_cap1_conexiones.rpy:2421
translate turkish cap1_interconexion_5_029169f5:

    # mc_pensamiento "Y en lo que le dije yo después."
    # english: mc_pensamiento "And what I said to her afterward."
    mc_pensamiento "Y en lo que le dije yo después."

# game/02_cap1_conexiones.rpy:2425
translate turkish cap1_interconexion_5_63f04799:

    # mc_pensamiento "Creo que terminamos en buenas condiciones."
    # english: mc_pensamiento "I think we ended on decent terms."
    mc_pensamiento "Creo que terminamos en buenas condiciones."

# game/02_cap1_conexiones.rpy:2427
translate turkish cap1_interconexion_5_c80bf177:

    # mc_pensamiento "Aun así, no dejaba de darle vueltas a lo que le solté a Nino en la cocina."
    # english: mc_pensamiento "Still, I couldn't stop turning over what I'd blurted out to Nino in the kitchen."
    mc_pensamiento "Aun así, no dejaba de darle vueltas a lo que le solté a Nino en la cocina."

# game/02_cap1_conexiones.rpy:2429
translate turkish cap1_interconexion_5_c6e26eb3:

    # mc_pensamiento "Se quedó en silencio... pero tampoco me devolvió la pregunta."
    # english: mc_pensamiento "She went quiet... but she didn't throw the question back at me, either."
    mc_pensamiento "Se quedó en silencio... pero tampoco me devolvió la pregunta."

# game/02_cap1_conexiones.rpy:2433
translate turkish cap1_interconexion_5_4e4baa8e:

    # mc_pensamiento "Al final solo lavé una taza y ya."
    # english: mc_pensamiento "In the end I just washed a cup, and that was it."
    mc_pensamiento "Al final solo lavé una taza y ya."

# game/02_cap1_conexiones.rpy:2435
translate turkish cap1_interconexion_5_a8c9c411:

    # mc_pensamiento "Ninguno dijo nada que valiera la pena."
    # english: mc_pensamiento "Neither of us said anything worth saying."
    mc_pensamiento "Ninguno dijo nada que valiera la pena."

# game/02_cap1_conexiones.rpy:2437
translate turkish cap1_interconexion_5_0f0852af:

    # mc_pensamiento "Supongo que a veces no hay más que decir."
    # english: mc_pensamiento "I guess sometimes there's nothing else to say."
    mc_pensamiento "Supongo que a veces no hay más que decir."

# game/02_cap1_conexiones.rpy:2441
translate turkish cap1_interconexion_5_1f301da6:

    # mc_pensamiento "Y lo que no debí haberle dicho."
    # english: mc_pensamiento "And what I shouldn't have said to her."
    mc_pensamiento "Y lo que no debí haberle dicho."

# game/02_cap1_conexiones.rpy:2443
translate turkish cap1_interconexion_5_27a8bb27:

    # mc_pensamiento "La frase que le tiré a Nino sonaba increíble en mi cabeza."
    # english: mc_pensamiento "The line I threw at Nino sounded great in my head."
    mc_pensamiento "La frase que le tiré a Nino sonaba increíble en mi cabeza."

# game/02_cap1_conexiones.rpy:2445
translate turkish cap1_interconexion_5_e200a069:

    # mc_pensamiento "En su cocina fue un desastre."
    # english: mc_pensamiento "In her kitchen it was a disaster."
    mc_pensamiento "En su cocina fue un desastre."

# game/02_cap1_conexiones.rpy:2447
translate turkish cap1_interconexion_5_3823885b:

    # mc_pensamiento "Y ya no había forma de echarse atrás."
    # english: mc_pensamiento "And there was no way to take it back."
    mc_pensamiento "Y ya no había forma de echarse atrás."

# game/02_cap1_conexiones.rpy:2451
translate turkish cap1_interconexion_5_2929260d:

    # mc_pensamiento "Pero lo peor de todo es lo que me dijo Maruo."
    # english: mc_pensamiento "But the worst part was what Maruo told me."
    mc_pensamiento "Pero lo peor de todo es lo que me dijo Maruo."

# game/02_cap1_conexiones.rpy:2453
translate turkish cap1_interconexion_5_00efff6b:

    # mc_pensamiento "«Se acabó. Ese día no hay discusión ni segunda oportunidad.»"
    # english: mc_pensamiento "\"It is over. On that day there is no discussion and no second chance.\""
    mc_pensamiento "«Se acabó. Ese día no hay discusión ni segunda oportunidad.»"

# game/02_cap1_conexiones.rpy:2455
translate turkish cap1_interconexion_5_e1eaa35c:

    # mc_pensamiento "Maruo no es de los que repiten las cosas. Su voz me seguía zumbando en la cabeza."
    # english: mc_pensamiento "Maruo isn't the type to repeat himself. His voice kept ringing in my head."
    mc_pensamiento "Maruo no es de los que repiten las cosas. Su voz me seguía zumbando en la cabeza."

# game/02_cap1_conexiones.rpy:2459
translate turkish cap1_interconexion_5_359644ba:

    # mc_pensamiento "El lado positivo es que Maruo parece seguir confiando en mí."
    # english: mc_pensamiento "The bright side is that Maruo still seems to trust me."
    mc_pensamiento "El lado positivo es que Maruo parece seguir confiando en mí."

# game/02_cap1_conexiones.rpy:2461
translate turkish cap1_interconexion_5_0b32692e:

    # mc_pensamiento "No había soltado nada nuevo. Pero el reloj no para."
    # english: mc_pensamiento "He hadn't said anything new. But the clock doesn't stop."
    mc_pensamiento "No había soltado nada nuevo. Pero el reloj no para."

# game/02_cap1_conexiones.rpy:2469
translate turkish cap1_interconexion_5_eb042592:

    # raiha "Hermanito, llegó esto. Lo dejo aquí, ¿sí?"
    # english: raiha "Big brother, this came. I'll leave it here, okay?"
    raiha "Hermanito, llegó esto. Lo dejo aquí, ¿sí?"

# game/02_cap1_conexiones.rpy:2471
translate turkish cap1_interconexion_5_8f08c970:

    # narrador "Un sobre del banco. Lo dejó boca abajo en mi escritorio, como si así pesara menos."
    # english: narrador "A bank envelope. She set it face down on my desk, as if that would make it weigh less."
    narrador "Un sobre del banco. Lo dejó boca abajo en mi escritorio, como si así pesara menos."

# game/02_cap1_conexiones.rpy:2473
translate turkish cap1_interconexion_5_307dc3c9:

    # mc "Es para papá."
    # english: mc "That's for Dad."
    mc "Es para papá."

# game/02_cap1_conexiones.rpy:2478
translate turkish cap1_interconexion_5_53a4dcaa:

    # raiha "Ya sé. Pero cuando abre esos, se pone serio toda la noche."
    # english: raiha "I know. But when he opens those, he's serious all night."
    raiha "Ya sé. Pero cuando abre esos, se pone serio toda la noche."

# game/02_cap1_conexiones.rpy:2480
translate turkish cap1_interconexion_5_2b1c8cb0:

    # raiha "Tú también. Pero tú por lo menos te comes la cena."
    # english: raiha "So are you. But at least you eat your dinner."
    raiha "Tú también. Pero tú por lo menos te comes la cena."

# game/02_cap1_conexiones.rpy:2482
translate turkish cap1_interconexion_5_1869323c:

    # narrador "En la otra mano llevaba una hoja doblada."
    # english: narrador "In her other hand she had a folded sheet of paper."
    narrador "En la otra mano llevaba una hoja doblada."

# game/02_cap1_conexiones.rpy:2484
translate turkish cap1_interconexion_5_3aee05a3:

    # mc "¿Y eso?"
    # english: mc "What's that?"
    mc "¿Y eso?"

# game/02_cap1_conexiones.rpy:2489
translate turkish cap1_interconexion_5_dd05e366:

    # raiha "Nada. Una excursión de la escuela. Al acuario."
    # english: raiha "Nothing. A school trip. To the aquarium."
    raiha "Nada. Una excursión de la escuela. Al acuario."

# game/02_cap1_conexiones.rpy:2491
translate turkish cap1_interconexion_5_28c4f023:

    # raiha "No voy a ir. Los peces son aburridos."
    # english: raiha "I'm not going. Fish are boring."
    raiha "No voy a ir. Los peces son aburridos."

# game/02_cap1_conexiones.rpy:2493
translate turkish cap1_interconexion_5_1c8fc49b:

    # mc "Te encantan los peces."
    # english: mc "You love fish."
    mc "Te encantan los peces."

# game/02_cap1_conexiones.rpy:2495
translate turkish cap1_interconexion_5_4eeed3d5:

    # raiha "¡Me encantaban! Ya soy grande."
    # english: raiha "I used to! I'm big now."
    raiha "¡Me encantaban! Ya soy grande."

# game/02_cap1_conexiones.rpy:2500
translate turkish cap1_interconexion_5_f4c580bc:

    # raiha "¡Buenas noches, hermanito!"
    # english: raiha "Good night, [mc]!"
    raiha "¡Buenas noches, hermanito!"

# game/02_cap1_conexiones.rpy:2505
translate turkish cap1_interconexion_5_aa916f23:

    # mc_pensamiento "Antes de salir dobló la hoja una vez más. Para que no se viera el precio."
    # english: mc_pensamiento "Before leaving, she folded the sheet once more. So the price wouldn't show."
    mc_pensamiento "Antes de salir dobló la hoja una vez más. Para que no se viera el precio."

# game/02_cap1_conexiones.rpy:2507
translate turkish cap1_interconexion_5_6e5b6877:

    # mc_pensamiento "Yo hacía lo mismo a su edad. No sabía que ella también."
    # english: mc_pensamiento "I used to do the same at her age. I didn't know she did too."
    mc_pensamiento "Yo hacía lo mismo a su edad. No sabía que ella también."

# game/02_cap1_conexiones.rpy:2509
translate turkish cap1_interconexion_5_cb8fd8ec:

    # narrador "Esperé a oír su puerta y bajé con el sobre."
    # english: narrador "I waited until I heard her door, then went downstairs with the envelope."
    narrador "Esperé a oír su puerta y bajé con el sobre."

# game/02_cap1_conexiones.rpy:2514
translate turkish cap1_interconexion_5_313c9421:

    # narrador "Mi padre estaba en la mesa, con la cámara desarmada sobre un trapo."
    # english: narrador "My father was at the table, his camera in pieces on a rag."
    narrador "Mi padre estaba en la mesa, con la cámara desarmada sobre un trapo."

# game/02_cap1_conexiones.rpy:2519
translate turkish cap1_interconexion_5_271eba2c:

    # narrador "Le dejé el sobre al lado. Lo miró sin tocarlo."
    # english: narrador "I set the envelope beside him. He looked at it without touching it."
    narrador "Le dejé el sobre al lado. Lo miró sin tocarlo."

# game/02_cap1_conexiones.rpy:2524
translate turkish cap1_interconexion_5_fd61bbca:

    # isanari "Otra carta de amor del banco. Me escriben más que tu madre cuando éramos novios."
    # english: isanari "Another love letter from the bank. They write me more than your mother did when we were dating."
    isanari "Otra carta de amor del banco. Me escriben más que tu madre cuando éramos novios."

# game/02_cap1_conexiones.rpy:2526
translate turkish cap1_interconexion_5_2f162686:

    # mc "Raiha dice que cuando abres esos te pones serio toda la noche."
    # english: mc "Raiha says when you open those, you're serious all night."
    mc "Raiha dice que cuando abres esos te pones serio toda la noche."

# game/02_cap1_conexiones.rpy:2528
translate turkish cap1_interconexion_5_2f945a19:

    # isanari "Raiha exagera."
    # english: isanari "Raiha exaggerates."
    isanari "Raiha exagera."

# game/02_cap1_conexiones.rpy:2530
translate turkish cap1_interconexion_5_191a8e4c:

    # narrador "Lo abrió. Leyó la primera línea y lo volvió a doblar."
    # english: narrador "He opened it. Read the first line and folded it back up."
    narrador "Lo abrió. Leyó la primera línea y lo volvió a doblar."

# game/02_cap1_conexiones.rpy:2532
translate turkish cap1_interconexion_5_c8701baa:

    # narrador "Se quedó callado tanto rato que terminé sentándome enfrente."
    # english: narrador "He stayed quiet so long I ended up sitting down across from him."
    narrador "Se quedó callado tanto rato que terminé sentándome enfrente."

# game/02_cap1_conexiones.rpy:2534
translate turkish cap1_interconexion_5_e0341768:

    # isanari "El restaurante era el sueño de tu madre."
    # english: isanari "The restaurant was your mother's dream."
    isanari "El restaurante era el sueño de tu madre."

# game/02_cap1_conexiones.rpy:2536
translate turkish cap1_interconexion_5_7add355d:

    # isanari "Los papeles del préstamo los firmé yo. Sonriendo."
    # english: isanari "I signed the loan papers. Smiling."
    isanari "Los papeles del préstamo los firmé yo. Sonriendo."

# game/02_cap1_conexiones.rpy:2538
translate turkish cap1_interconexion_5_9792c1e1:

    # isanari "Con ella al lado, no se me ocurrió que podía salir mal."
    # english: isanari "With her beside me, it never occurred to me that it could go wrong."
    isanari "Con ella al lado, no se me ocurrió que podía salir mal."

# game/02_cap1_conexiones.rpy:2540
translate turkish cap1_interconexion_5_88460131:

    # mc "Nadie podía saberlo."
    # english: mc "Nobody could have known."
    mc "Nadie podía saberlo."

# game/02_cap1_conexiones.rpy:2542
translate turkish cap1_interconexion_5_f00becb2:

    # isanari "Yo era el adulto. Me tocaba saberlo."
    # english: isanari "I was the adult. It was my job to know."
    isanari "Yo era el adulto. Me tocaba saberlo."

# game/02_cap1_conexiones.rpy:2544
translate turkish cap1_interconexion_5_87460380:

    # narrador "Dejó el lente encima del sobre, como un pisapapeles."
    # english: narrador "He set the camera lens on top of the envelope like a paperweight."
    narrador "Dejó el lente encima del sobre, como un pisapapeles."

# game/02_cap1_conexiones.rpy:2546
translate turkish cap1_interconexion_5_118e6d11:

    # isanari "Ella quería que estudiaras para que tengas un buen futuro."
    # english: isanari "She wanted you to study so you'd have a good future."
    isanari "Ella quería que estudiaras para que tengas un buen futuro."

# game/02_cap1_conexiones.rpy:2548
translate turkish cap1_interconexion_5_c433b419:

    # isanari "No para pagar lo que firmé yo."
    # english: isanari "Not to pay for what I signed."
    isanari "No para pagar lo que firmé yo."

# game/02_cap1_conexiones.rpy:2550
translate turkish cap1_interconexion_5_bb34d454:

    # isanari "Y aun así te traje este trabajo."
    # english: isanari "And still I brought you this job."
    isanari "Y aun así te traje este trabajo."

# game/02_cap1_conexiones.rpy:2552
translate turkish cap1_interconexion_5_35d7b6f4:

    # mc "Lo acepté yo."
    # english: mc "I'm the one who took it."
    mc "Lo acepté yo."

# game/02_cap1_conexiones.rpy:2554
translate turkish cap1_interconexion_5_dddfc1ec:

    # isanari "Después de que yo dijera que sí."
    # english: isanari "After I said yes."
    isanari "Después de que yo dijera que sí."

# game/02_cap1_conexiones.rpy:2556
translate turkish cap1_interconexion_5_bcd08a78:

    # isanari "No me quites la culpa. Esa es mía."
    # english: isanari "Don't take the blame off me. That one's mine."
    isanari "No me quites la culpa. Esa es mía."

# game/02_cap1_conexiones.rpy:2561
translate turkish cap1_interconexion_5_2fce6d55:

    # isanari "Bueno. Suficiente drama por hoy."
    # english: isanari "Anyway. Enough drama for today."
    isanari "Bueno. Suficiente drama por hoy."

# game/02_cap1_conexiones.rpy:2563
translate turkish cap1_interconexion_5_60ac0963:

    # isanari "Anda a dormir. Todavía te quedan cinco por enseñar."
    # english: isanari "Go to bed. You've still got five to teach."
    isanari "Anda a dormir. Todavía te quedan cinco por enseñar."

# game/02_cap1_conexiones.rpy:2568
translate turkish cap1_interconexion_5_52f72a6b:

    # mc_pensamiento "Raiha tenía razón. Se ponía serio con esos sobres."
    # english: mc_pensamiento "Raiha was right. He did get serious over those envelopes."
    mc_pensamiento "Raiha tenía razón. Se ponía serio con esos sobres."

# game/02_cap1_conexiones.rpy:2570
translate turkish cap1_interconexion_5_1b3eeeff:

    # mc_pensamiento "Solo que nunca delante de nosotros."
    # english: mc_pensamiento "Just never in front of us."
    mc_pensamiento "Solo que nunca delante de nosotros."

# game/02_cap1_conexiones.rpy:2577
translate turkish cap1_interconexion_5_dafb8b8f:

    # narrador "Pasadas las 11, me sonó el teléfono. En la pantalla decía «Maruo»."
    # english: narrador "A little after 11, my phone rang. The screen said \"Maruo.\""
    narrador "Pasadas las 11, me sonó el teléfono. En la pantalla decía «Maruo»."

# game/02_cap1_conexiones.rpy:2579
translate turkish cap1_interconexion_5_22b8942e:

    # mc "¿Diga?"
    # english: mc "Hello?"
    mc "¿Diga?"

# game/02_cap1_conexiones.rpy:2581
translate turkish cap1_interconexion_5_c09410c7:

    # maruo "¿Te desperté?"
    # english: maruo "Did I wake you?"
    maruo "¿Te desperté?"

# game/02_cap1_conexiones.rpy:2583
translate turkish cap1_interconexion_5_d4ea9aa3:

    # mc "No, señor."
    # english: mc "No, sir."
    mc "No, señor."

# game/02_cap1_conexiones.rpy:2585
translate turkish cap1_interconexion_5_d712d384:

    # narrador "De fondo se oía una megafonía. Llamaban al doctor Nakano a la tercera planta."
    # english: narrador "A PA system droned in the background. They were paging Dr. Nakano to the third floor."
    narrador "De fondo se oía una megafonía. Llamaban al doctor Nakano a la tercera planta."

# game/02_cap1_conexiones.rpy:2587
translate turkish cap1_interconexion_5_e5a2ba62:

    # maruo "Esta tarde estuviste en la cocina."
    # english: maruo "You were in the kitchen this afternoon."
    maruo "Esta tarde estuviste en la cocina."

# game/02_cap1_conexiones.rpy:2589
translate turkish cap1_interconexion_5_349c2774:

    # mc "No era mi intención escuchar."
    # english: mc "I didn't mean to listen in."
    mc "No era mi intención escuchar."

# game/02_cap1_conexiones.rpy:2591
translate turkish cap1_interconexion_5_e422a729:

    # maruo "No te llamo por eso."
    # english: maruo "That is not why I am calling."
    maruo "No te llamo por eso."

# game/02_cap1_conexiones.rpy:2595
translate turkish cap1_interconexion_5_bfbb6f77:

    # maruo "Lo que te dije ahí sigue en pie. No lo repito."
    # english: maruo "What I told you there still stands. I will not repeat it."
    maruo "Lo que te dije ahí sigue en pie. No lo repito."

# game/02_cap1_conexiones.rpy:2597
translate turkish cap1_interconexion_5_2f41efd2:

    # maruo "Cuando te fuiste, ¿mis hijas habían cenado?"
    # english: maruo "When you left, had my daughters eaten?"
    maruo "Cuando te fuiste, ¿mis hijas habían cenado?"

# game/02_cap1_conexiones.rpy:2599
translate turkish cap1_interconexion_5_cf97645b:

    # mc_pensamiento "De todas las preguntas posibles, era la última que esperaba."
    # english: mc_pensamiento "Of all the possible questions, it was the last one I expected."
    mc_pensamiento "De todas las preguntas posibles, era la última que esperaba."

# game/02_cap1_conexiones.rpy:2603
translate turkish cap1_interconexion_5_71c41bff:

    # mc "Nino estaba cocinando. Le ayudé con las cebollas."
    # english: mc "Nino was cooking. I helped her with the onions."
    mc "Nino estaba cocinando. Le ayudé con las cebollas."

# game/02_cap1_conexiones.rpy:2605
translate turkish cap1_interconexion_5_6c5f8cc7:

    # narrador "Hubo un silencio largo. La megafonía volvió a llamarlo."
    # english: narrador "A long silence. The PA called for him again."
    narrador "Hubo un silencio largo. La megafonía volvió a llamarlo."

# game/02_cap1_conexiones.rpy:2607
translate turkish cap1_interconexion_5_cbc9835d:

    # maruo "...Entiendo."
    # english: maruo "...I see."
    maruo "...Entiendo."

# game/02_cap1_conexiones.rpy:2611
translate turkish cap1_interconexion_5_3b1bb190:

    # mc "No lo sé, señor. Me fui antes."
    # english: mc "I don't know, sir. I left before that."
    mc "No lo sé, señor. Me fui antes."

# game/02_cap1_conexiones.rpy:2613
translate turkish cap1_interconexion_5_5314f221:

    # maruo "Ya."
    # english: maruo "Right."
    maruo "Ya."

# game/02_cap1_conexiones.rpy:2615
translate turkish cap1_interconexion_5_fd935a1d:

    # maruo "Es todo. Buenas noches, [mc]."
    # english: maruo "That is all. Good night, [mc]."
    maruo "Es todo. Buenas noches, [mc]."

# game/02_cap1_conexiones.rpy:2617
translate turkish cap1_interconexion_5_61ad566e:

    # narrador "Colgó antes de que pudiera contestarle."
    # english: narrador "He hung up before I could answer."
    narrador "Colgó antes de que pudiera contestarle."

# game/02_cap1_conexiones.rpy:2619
translate turkish cap1_interconexion_5_c74cb338:

    # mc_pensamiento "Me llamó desde un hospital, a las 11, para preguntar si sus hijas habían cenado."
    # english: mc_pensamiento "He called me from a hospital, at 11, to ask whether his daughters had eaten."
    mc_pensamiento "Me llamó desde un hospital, a las 11, para preguntar si sus hijas habían cenado."

# game/02_cap1_conexiones.rpy:2621
translate turkish cap1_interconexion_5_1b6b1d3d:

    # mc_pensamiento "Quizá no es que no quiera estar en casa."
    # english: mc_pensamiento "Maybe it isn't that he doesn't want to be home."
    mc_pensamiento "Quizá no es que no quiera estar en casa."

# game/02_cap1_conexiones.rpy:2623
translate turkish cap1_interconexion_5_51fc9df7:

    # mc_pensamiento "Quizá es que no sabe cómo volver."
    # english: mc_pensamiento "Maybe he just doesn't know how to come back."
    mc_pensamiento "Quizá es que no sabe cómo volver."

# game/02_cap1_conexiones.rpy:2625
translate turkish cap1_interconexion_5_fe6f9721:

    # mc_pensamiento "Solo me quedaba una última tarde libre."
    # english: mc_pensamiento "I only had one free afternoon left."
    mc_pensamiento "Solo me quedaba una última tarde libre."

# game/02_cap1_conexiones.rpy:2634
translate turkish cap1_interconexion_5_6bedbabb:

    # narrador "Los días siguientes se me pasaron volando."
    # english: narrador "The next few days flew by."
    narrador "Los días siguientes se me pasaron volando."

# game/02_cap1_conexiones.rpy:2636
translate turkish cap1_interconexion_5_021043aa:

    # narrador "Cuando quise acordarme, los exámenes estaban respirándome en la nuca."
    # english: narrador "Before I knew it, the exams were breathing down my neck."
    narrador "Cuando quise acordarme, los exámenes estaban respirándome en la nuca."

# game/02_cap1_conexiones.rpy:2647
translate turkish cap1_interconexion_5_14a98fb8:

    # narrador "Llegué al instituto temprano, como siempre."
    # english: narrador "I got to school early, like always."
    narrador "Llegué al instituto temprano, como siempre."

# game/02_cap1_conexiones.rpy:2649
translate turkish cap1_interconexion_5_69786bcd:

    # narrador "En la entrada del instituto acababan de clavar el cartel con los horarios de los exámenes."
    # english: narrador "They'd just pinned up the exam schedule at the school entrance."
    narrador "En la entrada del instituto acababan de clavar el cartel con los horarios de los exámenes."

# game/02_cap1_conexiones.rpy:2651
translate turkish cap1_interconexion_5_8391fa67:

    # narrador "Cinco asignaturas. Cinco fechas. Y cero margen de error."
    # english: narrador "Five subjects. Five dates. And zero margin for error."
    narrador "Cinco asignaturas. Cinco fechas. Y cero margen de error."

# game/02_cap1_conexiones.rpy:2657
translate turkish cap1_interconexion_5_c7636a7a:

    # mc_pensamiento "Cinco fechas en un papel. Y yo aquí parado." nointeract
    # english: mc_pensamiento "Five dates on a sheet of paper. And me standing here." nointeract
    mc_pensamiento "Cinco fechas en un papel. Y yo aquí parado." nointeract

# game/02_cap1_conexiones.rpy:2661
translate turkish cap1_interconexion_5_fba84040:

    # mc_pensamiento "Obviamente no cambió nada."
    # english: mc_pensamiento "Obviously, nothing changed."
    mc_pensamiento "Obviamente no cambió nada."

# game/02_cap1_conexiones.rpy:2663
translate turkish cap1_interconexion_5_0af8db3b:

    # mc_pensamiento "Las fechas de los exámenes nunca se retrasan cuando de verdad te hace falta."
    # english: mc_pensamiento "Exam dates never get pushed back when you actually need them to."
    mc_pensamiento "Las fechas de los exámenes nunca se retrasan cuando de verdad te hace falta."

# game/02_cap1_conexiones.rpy:2665
translate turkish cap1_interconexion_5_e1fc9644:

    # mc_pensamiento "Lo que más me preocupa es cómo saldrán esas cinco."
    # english: mc_pensamiento "What worries me most is how those five will do."
    mc_pensamiento "Lo que más me preocupa es cómo saldrán esas cinco."

# game/02_cap1_conexiones.rpy:2669
translate turkish cap1_interconexion_5_e6548c3f:

    # mc_pensamiento "Contando con los dedos da la sensación de que queda menos."
    # english: mc_pensamiento "Counting on my fingers makes it feel like there's less time left."
    mc_pensamiento "Contando con los dedos da la sensación de que queda menos."

# game/02_cap1_conexiones.rpy:2671
translate turkish cap1_interconexion_5_acf289f3:

    # mc_pensamiento "Y mirando el calendario asusta igual."
    # english: mc_pensamiento "And looking at the calendar is just as scary."
    mc_pensamiento "Y mirando el calendario asusta igual."

# game/02_cap1_conexiones.rpy:2673
translate turkish cap1_interconexion_5_fe467f48:

    # mc_pensamiento "No por mí, sino por ellas."
    # english: mc_pensamiento "Not for me. For them."
    mc_pensamiento "No por mí, sino por ellas."

# game/02_cap1_conexiones.rpy:2677
translate turkish cap1_interconexion_5_1948dc62:

    # mc_pensamiento "Intenté poner cara de poca preocupación frente al reflejo de la ventana."
    # english: mc_pensamiento "I tried to look unworried in the window's reflection."
    mc_pensamiento "Intenté poner cara de poca preocupación frente al reflejo de la ventana."

# game/02_cap1_conexiones.rpy:2679
translate turkish cap1_interconexion_5_48b7bfd4:

    # mc_pensamiento "No me lo creía ni yo."
    # english: mc_pensamiento "I didn't even buy it myself."
    mc_pensamiento "No me lo creía ni yo."

# game/02_cap1_conexiones.rpy:2681
translate turkish cap1_interconexion_5_e5e031a3:

    # mc_pensamiento "Esa semana sí es importante, no puedo andar con juegos."
    # english: mc_pensamiento "This week matters. I can't be playing games."
    mc_pensamiento "Esa semana sí es importante, no puedo andar con juegos."

# game/02_cap1_conexiones.rpy:2690
translate turkish cap1_interconexion_5_502b1bfb:

    # narrador "Las cinco ya estaban en sus sitios."
    # english: narrador "All five were already in their seats."
    narrador "Las cinco ya estaban en sus sitios."

# game/02_cap1_conexiones.rpy:2692
translate turkish cap1_interconexion_5_f5a730e4:

    # narrador "Raro en ellas. El peso de los exámenes ya se les notaba."
    # english: narrador "Unusual for them. The weight of the exams was already showing."
    narrador "Raro en ellas. El peso de los exámenes ya se les notaba."

# game/02_cap1_conexiones.rpy:2696
translate turkish cap1_interconexion_5_c3fa7d18:

    # mc_pensamiento "Iré a saludarlas y a decirles que saquen sus libros."
    # english: mc_pensamiento "I'll go say hi and tell them to take out their books."
    mc_pensamiento "Iré a saludarlas y a decirles que saquen sus libros."

# game/02_cap1_conexiones.rpy:2698
translate turkish cap1_interconexion_5_a76bc738:

    # narrador "Antes de llegar, una de ellas se me cruzó en el camino."
    # english: narrador "Before I got there, one of them stepped into my path."
    narrador "Antes de llegar, una de ellas se me cruzó en el camino."

# game/02_cap1_conexiones.rpy:2700
translate turkish cap1_interconexion_5_f34fa2db:

    # mc_pensamiento "Ya sabía quién era antes de verle la cara. Solo una se me cruza así."
    # english: mc_pensamiento "I knew who it was before seeing her face. Only one of them cuts me off like that."
    mc_pensamiento "Ya sabía quién era antes de verle la cara. Solo una se me cruza así."

# game/02_cap1_conexiones.rpy:2709
translate turkish cap1_interconexion_5_a28e0eab:

    # mc "Nino. Saca tus libros, que ya mismo son los exámenes."
    # english: mc "Nino. Get your books out, the exams are right around the corner."
    mc "Nino. Saca tus libros, que ya mismo son los exámenes."

# game/02_cap1_conexiones.rpy:2714
translate turkish cap1_interconexion_5_df3376e0:

    # nino "No me mires así."
    # english: nino "Don't look at me like that."
    nino "No me mires así."

# game/02_cap1_conexiones.rpy:2716
translate turkish cap1_interconexion_5_ba654ddf:

    # mc "No estoy mirando nada."
    # english: mc "I'm not looking at anything."
    mc "No estoy mirando nada."

# game/02_cap1_conexiones.rpy:2718
translate turkish cap1_interconexion_5_f8df03ce:

    # nino "Sí lo haces. Con esa cara de «sé algo de ti»."
    # english: nino "Yes, you are. With that \"I know something about you\" face."
    nino "Sí lo haces. Con esa cara de «sé algo de ti»."

# game/02_cap1_conexiones.rpy:2720
translate turkish cap1_interconexion_5_93edb413:

    # nino "Y no sabes nada."
    # english: nino "And you don't know anything."
    nino "Y no sabes nada."

# game/02_cap1_conexiones.rpy:2722
translate turkish cap1_interconexion_5_1a707e16:

    # mc "Sé que las cebollas las corté finas."
    # english: mc "I know I cut the onions thin."
    mc "Sé que las cebollas las corté finas."

# game/02_cap1_conexiones.rpy:2727
translate turkish cap1_interconexion_5_a245b543:

    # nino "...Gruesas. Las cortaste gruesas."
    # english: nino "...Thick. You cut them thick."
    nino "...Gruesas. Las cortaste gruesas."

# game/02_cap1_conexiones.rpy:2729
translate turkish cap1_interconexion_5_7eec0378:

    # mc "Pero no te quejaste."
    # english: mc "But you didn't complain."
    mc "Pero no te quejaste."

# game/02_cap1_conexiones.rpy:2734
translate turkish cap1_interconexion_5_083d74f9:

    # nino "Lo de aquel día no fue una invitación. Que quede claro."
    # english: nino "What happened that day wasn't an invitation. Let's be clear."
    nino "Lo de aquel día no fue una invitación. Que quede claro."

# game/02_cap1_conexiones.rpy:2736
translate turkish cap1_interconexion_5_c42ed6db:

    # mc "Lo sé. Fue una orden."
    # english: mc "I know. It was an order."
    mc "Lo sé. Fue una orden."

# game/02_cap1_conexiones.rpy:2738
translate turkish cap1_interconexion_5_3b1fe385:

    # nino "Exacto."
    # english: nino "Exactly."
    nino "Exacto."

# game/02_cap1_conexiones.rpy:2743
translate turkish cap1_interconexion_5_00014055:

    # nino "Solo... hoy no me preguntes nada."
    # english: nino "Just... don't ask me anything today."
    nino "Solo... hoy no me preguntes nada."

# game/02_cap1_conexiones.rpy:2745
translate turkish cap1_interconexion_5_5776ef9c:

    # nino "Si me preguntas, no voy a saber qué contestar."
    # english: nino "If you ask, I won't know what to say."
    nino "Si me preguntas, no voy a saber qué contestar."

# game/02_cap1_conexiones.rpy:2750
translate turkish cap1_interconexion_5_28fc552d:

    # narrador "Más que una orden, era un ruego."
    # english: narrador "It was less an order than a plea."
    narrador "Más que una orden, era un ruego."

# game/02_cap1_conexiones.rpy:2757
translate turkish cap1_interconexion_5_be896031:

    # nino "Te aviso que sigo sin tener ganas de hablar de aquello."
    # english: nino "Fair warning: I still don't feel like talking about that."
    nino "Te aviso que sigo sin tener ganas de hablar de aquello."

# game/02_cap1_conexiones.rpy:2759
translate turkish cap1_interconexion_5_6fde286a:

    # mc "Tampoco iba a preguntar."
    # english: mc "I wasn't going to ask."
    mc "Tampoco iba a preguntar."

# game/02_cap1_conexiones.rpy:2761
translate turkish cap1_interconexion_5_07fb638a:

    # nino "Más te vale."
    # english: nino "You'd better not."
    nino "Más te vale."

# game/02_cap1_conexiones.rpy:2763
translate turkish cap1_interconexion_5_ef3c0499:

    # narrador "Se quedó mirando su cuaderno cerrado. Tardó en volver a hablar."
    # english: narrador "She stared at her closed notebook. It took her a while to speak again."
    narrador "Se quedó mirando su cuaderno cerrado. Tardó en volver a hablar."

# game/02_cap1_conexiones.rpy:2768
translate turkish cap1_interconexion_5_c65502db:

    # nino "...Lavaste mi taza."
    # english: nino "...You washed my cup."
    nino "...Lavaste mi taza."

# game/02_cap1_conexiones.rpy:2770
translate turkish cap1_interconexion_5_0a6231f1:

    # mc "Era una taza."
    # english: mc "It was a cup."
    mc "Era una taza."

# game/02_cap1_conexiones.rpy:2772
translate turkish cap1_interconexion_5_fdb6212f:

    # nino "Era mi taza. Nadie toca mi taza."
    # english: nino "It was my cup. Nobody touches my cup."
    nino "Era mi taza. Nadie toca mi taza."

# game/02_cap1_conexiones.rpy:2774
translate turkish cap1_interconexion_5_c0a7eadb:

    # nino "No lo vuelvas a hacer."
    # english: nino "Don't do it again."
    nino "No lo vuelvas a hacer."

# game/02_cap1_conexiones.rpy:2779
translate turkish cap1_interconexion_5_a4daf1c3:

    # nino "...O sea. Haz lo que quieras."
    # english: nino "...I mean. Do what you want."
    nino "...O sea. Haz lo que quieras."

# game/02_cap1_conexiones.rpy:2784
translate turkish cap1_interconexion_5_7bf7df2a:

    # narrador "Fue lo más parecido a un «gracias» que iba a sacarle."
    # english: narrador "It was the closest thing to a \"thank you\" I was going to get out of her."
    narrador "Fue lo más parecido a un «gracias» que iba a sacarle."

# game/02_cap1_conexiones.rpy:2788
translate turkish cap1_interconexion_5_dbb97551:

    # mc "Nino..."
    # english: mc "Nino..."
    mc "Nino..."

# game/02_cap1_conexiones.rpy:2790
translate turkish cap1_interconexion_5_1000075e:

    # narrador "No contestó. No giró la cabeza ni para ignorarme."
    # english: narrador "She didn't answer. She didn't even turn her head to ignore me."
    narrador "No contestó. No giró la cabeza ni para ignorarme."

# game/02_cap1_conexiones.rpy:2792
translate turkish cap1_interconexion_5_45f2a0f3:

    # mc "Lo que te dije en la cocina..."
    # english: mc "What I said to you in the kitchen..."
    mc "Lo que te dije en la cocina..."

# game/02_cap1_conexiones.rpy:2797
translate turkish cap1_interconexion_5_0bc5741c:

    # nino "No lo repitas."
    # english: nino "Don't repeat it."
    nino "No lo repitas."

# game/02_cap1_conexiones.rpy:2799
translate turkish cap1_interconexion_5_2af1bbb5:

    # nino "Tenías razón en una cosa: tengo que ocuparme de lo mío."
    # english: nino "You were right about one thing: I need to take care of my own business."
    nino "Tenías razón en una cosa: tengo que ocuparme de lo mío."

# game/02_cap1_conexiones.rpy:2801
translate turkish cap1_interconexion_5_2c9c8456:

    # nino "Y eso voy a hacer. Empezando por no hablarte."
    # english: nino "And that's what I'll do. Starting with not talking to you."
    nino "Y eso voy a hacer. Empezando por no hablarte."

# game/02_cap1_conexiones.rpy:2806
translate turkish cap1_interconexion_5_7babfdfd:

    # narrador "Lo dijo sin elevar la voz."
    # english: narrador "She said it without raising her voice."
    narrador "Lo dijo sin elevar la voz."

# game/02_cap1_conexiones.rpy:2808
translate turkish cap1_interconexion_5_ba0b3264:

    # narrador "Con la misma calma que su padre."
    # english: narrador "With the same calm as her father."
    narrador "Con la misma calma que su padre."

# game/02_cap1_conexiones.rpy:2810
translate turkish cap1_interconexion_5_13533ffc:

    # mc_pensamiento "Esa calma la sacó de él."
    # english: mc_pensamiento "She gets that calm from him."
    mc_pensamiento "Esa calma la sacó de él."

# game/02_cap1_conexiones.rpy:2812
translate turkish cap1_interconexion_5_70bc47c8:

    # mc_pensamiento "Y la estaba usando por mi culpa."
    # english: mc_pensamiento "And she was using it because of me."
    mc_pensamiento "Y la estaba usando por mi culpa."

# game/02_cap1_conexiones.rpy:2827
translate turkish cap1_interconexion_5_fec64cf2:

    # narrador "Las otras cuatro fueron llegando de a una. Esta vez nadie hizo ruido."
    # english: narrador "The other four trickled in one by one. This time nobody made any noise."
    narrador "Las otras cuatro fueron llegando de a una. Esta vez nadie hizo ruido."

# game/02_cap1_conexiones.rpy:2829
translate turkish cap1_interconexion_5_99f61bf4:

    # narrador "Las saludé y fui directo al grano en lo que debía decirles."
    # english: narrador "I greeted them and got straight to the point."
    narrador "Las saludé y fui directo al grano en lo que debía decirles."

# game/02_cap1_conexiones.rpy:2833
translate turkish cap1_interconexion_5_ebea290d:

    # mc "Muy bien, escuchen: los exámenes están a la vuelta de la esquina."
    # english: mc "All right, listen up: the exams are right around the corner."
    mc "Muy bien, escuchen: los exámenes están a la vuelta de la esquina."

# game/02_cap1_conexiones.rpy:2835
translate turkish cap1_interconexion_5_2fc0a77c:

    # mc "Hemos estudiado mucho en estas semanas, así que no se atrevan a reprobar."
    # english: mc "We've studied hard these past weeks, so don't you dare fail."
    mc "Hemos estudiado mucho en estas semanas, así que no se atrevan a reprobar."

# game/02_cap1_conexiones.rpy:2837
translate turkish cap1_interconexion_5_bd1e5461:

    # mc "Arruinarían mi reputación como tutor. Y mi trabajo."
    # english: mc "You'd ruin my reputation as a tutor. And my job."
    mc "Arruinarían mi reputación como tutor. Y mi trabajo."

# game/02_cap1_conexiones.rpy:2839
translate turkish cap1_interconexion_5_5b9358f2:

    # mc "Confío en que aprobarán..."
    # english: mc "I'm trusting you'll pass..."
    mc "Confío en que aprobarán..."

# game/02_cap1_conexiones.rpy:2841
translate turkish cap1_interconexion_5_d072d50f:

    # mc_pensamiento "Me quedaron viendo con cara de preocupación."
    # english: mc_pensamiento "They stared back at me, worried."
    mc_pensamiento "Me quedaron viendo con cara de preocupación."

# game/02_cap1_conexiones.rpy:2843
translate turkish cap1_interconexion_5_562fd63c:

    # mc_pensamiento "Parece que están nerviosas por el inicio de los exámenes."
    # english: mc_pensamiento "Looks like they're nervous about the exams starting."
    mc_pensamiento "Parece que están nerviosas por el inicio de los exámenes."

# game/02_cap1_conexiones.rpy:2845
translate turkish cap1_interconexion_5_12558cff:

    # mc "¿Se encuentran bien todas? ¿No están nerviosas?"
    # english: mc "Is everyone okay? You're not nervous?"
    mc "¿Se encuentran bien todas? ¿No están nerviosas?"

# game/02_cap1_conexiones.rpy:2856
translate turkish cap1_interconexion_5_f3db32f0:

    # yotsuba "¡Eh, nosotras estamos súper tranquilas! ¡Para nada nerviosas!"
    # english: yotsuba "Hey, we're super calm! Not nervous at all!"
    yotsuba "¡Eh, nosotras estamos súper tranquilas! ¡Para nada nerviosas!"

# game/02_cap1_conexiones.rpy:2858
translate turkish cap1_interconexion_5_b8240593:

    # mc "Yotsuba, estás sosteniendo tu lápiz al revés."
    # english: mc "Yotsuba, you're holding your pencil backwards."
    mc "Yotsuba, estás sosteniendo tu lápiz al revés."

