    narrador "Se fue a paso rápido antes de que pudiera contestar. Había hablado de más."

# game/02_cap1_conexiones.rpy:756
translate turkish queja_miku_f0045840:

    # miku "...No me buscaste."
    # english: miku "...You didn't look for me."
    miku "...No me buscaste."

# game/02_cap1_conexiones.rpy:758
translate turkish queja_miku_afa15b83:

    # mc "Tenía tres tardes."
    # english: mc "I only had three afternoons."
    mc "Tenía tres tardes."

# game/02_cap1_conexiones.rpy:760
translate turkish queja_miku_970ca85c:

    # miku "...Ya sé."
    # english: miku "...I know."
    miku "...Ya sé."

# game/02_cap1_conexiones.rpy:762
translate turkish queja_miku_0e54282c:

    # miku "...Así estuvo bien. Estuve tranquila."
    # english: miku "...It was fine. I was calm."
    miku "...Así estuvo bien. Estuve tranquila."

# game/02_cap1_conexiones.rpy:764
translate turkish queja_miku_2bce1464:

    # miku "...Pero habrías acertado, por cierto."
    # english: miku "...But you would have gotten it right, by the way."
