translate english hub_Ichika_aab7c9fc:

    # narrador "La puerta estaba entreabierta."
    narrador "The door was ajar."

# game/02_cap1_Ichika.rpy:45
translate english hub_Ichika_4a12e511:

    # narrador "Y fue ahí cuando la vi."
    narrador "And that's when I saw her."

# game/02_cap1_Ichika.rpy:52
translate english hub_Ichika_e739d9e4:

    # narrador "La reconocí por el suéter amarillo atado a la cintura antes que por la cara."
    narrador "I recognized the yellow sweater tied around her waist before I recognized her face."

# game/02_cap1_Ichika.rpy:54
translate english hub_Ichika_96f4d85f:

    # mc_pensamiento "Está dormida."
    mc_pensamiento "She's asleep."

# game/02_cap1_Ichika.rpy:56
translate english hub_Ichika_d70c78da:

    # mc_pensamiento "Sentada en el suelo. Con el guion en la mano."
    mc_pensamiento "Sitting on the floor. Script in hand."

# game/02_cap1_Ichika.rpy:58
translate english hub_Ichika_53606463:

    # narrador "A su lado había dos latas de energizante."
    narrador "Next to her were two cans of energy drink."

# game/02_cap1_Ichika.rpy:60
translate english hub_Ichika_10dd4cf6:

    # narrador "Una de ellas abollada, como si la hubiera apretado sin darse cuenta."
    narrador "One of them was dented, as if she'd squeezed it without noticing."

# game/02_cap1_Ichika.rpy:62
translate english hub_Ichika_e1fbc869:

    # mc_pensamiento "Y un horario escrito a mano, con tres columnas superpuestas."
    mc_pensamiento "And a handwritten schedule, with three columns piled on top of each other."

# game/02_cap1_Ichika.rpy:64
translate english hub_Ichika_60cfaf62:

    # mc_pensamiento "Clases. Ensayos. Algo tachado que no llegué a leer."
    mc_pensamiento "Classes. Rehearsals. Something crossed out that I couldn't make out."

# game/02_cap1_Ichika.rpy:66
translate english hub_Ichika_553074cb:

    # narrador "Me quedé en la puerta un momento, sin saber si entrar o retroceder."
    narrador "I stood in the doorway a moment, unsure whether to go in or back away."

# game/02_cap1_Ichika.rpy:68
translate english hub_Ichika_e2848a2d:

    # narrador "Decidí entrar."
    narrador "I decided to go in."

# game/02_cap1_Ichika.rpy:70
translate english hub_Ichika_3304407c:

    # narrador "Me acerqué despacio, tratando de no hacer ruido con los pasos."
    narrador "I crept closer, trying not to let my footsteps make any noise."

# game/02_cap1_Ichika.rpy:72
translate english hub_Ichika_1412a21b:

    # mc_pensamiento "No sabía si despertarla o dejarla dormir un poco más."
    mc_pensamiento "I didn't know whether to wake her or let her sleep a little longer."

# game/02_cap1_Ichika.rpy:74
translate english hub_Ichika_2b29db84:

    # mc_pensamiento "No llegué a decidirlo."
    mc_pensamiento "I never got to decide."

# game/02_cap1_Ichika.rpy:79
translate english hub_Ichika_032b9c34:

    # narrador "El guion terminó de resbalarle de la mano y cayó al piso."
    narrador "The script finally slid out of her hand and hit the floor."

# game/02_cap1_Ichika.rpy:81
translate english hub_Ichika_113743c3:

    # narrador "Eso la despertó."
    narrador "That woke her."

# game/02_cap1_Ichika.rpy:92
translate english hub_Ichika_ea7eac0c:

    # narrador "Abrió los ojos de golpe, sin saber todavía dónde estaba."
    narrador "Her eyes snapped open, not yet knowing where she was."

# game/02_cap1_Ichika.rpy:97
translate english hub_Ichika_d2e13757:

    # ichika "...¿[mc]?"
    ichika "...[mc]?"

# game/02_cap1_Ichika.rpy:99
translate english hub_Ichika_3f31119d:

    # ichika "¿Qué haces aquí?"
    ichika "What are you doing here?"

# game/02_cap1_Ichika.rpy:101
translate english hub_Ichika_f62c3c00:

    # ichika "...¿Qué hora es?"
    ichika "...What time is it?"

# game/02_cap1_Ichika.rpy:103
translate english hub_Ichika_aecc1e7b:

    # narrador "Me preguntó sin actuación, sin la voz que usa para todo."
    narrador "She asked it without any act, without the voice she uses for everything."

# game/02_cap1_Ichika.rpy:105
translate english hub_Ichika_3318ad43:

    # mc "Las cuatro y media."
    mc "Four thirty."

# game/02_cap1_Ichika.rpy:107
translate english hub_Ichika_2a88e035:

    # ichika "..."
    ichika "..."

# game/02_cap1_Ichika.rpy:109
translate english hub_Ichika_f846194c:

    # ichika "Perdí la tarde entera."
    ichika "I lost the whole afternoon."

# game/02_cap1_Ichika.rpy:111
translate english hub_Ichika_44ec7975:

    # narrador "Lo dijo plano. Sin exclamación."
    narrador "She said it flat. No exclamation."

# game/02_cap1_Ichika.rpy:113
translate english hub_Ichika_89dce28e:

    # narrador "Sin la pausa que pone antes de un chiste."
    narrador "No pause, the kind she leaves before a joke."

# game/02_cap1_Ichika.rpy:115
translate english hub_Ichika_b503f5fa:

    # mc_pensamiento "Esa no es su voz normal."
    mc_pensamiento "That's not her normal voice."

# game/02_cap1_Ichika.rpy:117
translate english hub_Ichika_9885b390:

    # mc_pensamiento "Su voz normal tiene dirección de escena."
    mc_pensamiento "Her normal voice comes with stage directions."

# game/02_cap1_Ichika.rpy:119
translate english hub_Ichika_d1048ce4:

    # mc_pensamiento "Esta no tenía ninguna."
    mc_pensamiento "This one didn't have any."

# game/02_cap1_Ichika.rpy:121
translate english hub_Ichika_976d04a9:

    # narrador "Duró medio segundo."
    narrador "It lasted half a second."

# game/02_cap1_Ichika.rpy:123
translate english hub_Ichika_2a156380:

    # narrador "Después pareció darse cuenta de que yo estaba ahí, y de que la había visto así."
    narrador "Then she seemed to realize I was there, and that I'd seen her like that."

# game/02_cap1_Ichika.rpy:131
translate english hub_Ichika_5815feda:

    # mc "Luces demasiado cansada."
    mc "You look way too tired."

# game/02_cap1_Ichika.rpy:136
translate english hub_Ichika_e27feef0:

    # ichika "¿Yo?"
    ichika "Who, me?"

# game/02_cap1_Ichika.rpy:138
translate english hub_Ichika_68fdbd58:

    # ichika "Jaja, te preocupas demasiado por mí, [mc]."
    ichika "Haha, you worry about me too much, [mc]."

# game/02_cap1_Ichika.rpy:140
translate english hub_Ichika_f999561d:

    # mc "¿Entonces qué estabas haciendo?"
    mc "Then what were you doing?"

# game/02_cap1_Ichika.rpy:142
translate english hub_Ichika_b3bd9b91:

    # ichika "¡Estaba practicando!"
    ichika "I was practicing!"

# game/02_cap1_Ichika.rpy:144
translate english hub_Ichika_90ad8b13:

    # mc "¿Practicando dormir?"
    mc "Practicing sleeping?"

# game/02_cap1_Ichika.rpy:146
translate english hub_Ichika_0668a5bf:

    # ichika "¡Es una técnica interpretativa! ¡Se llama... descanso escénico!"
    ichika "It's an acting technique! It's called... stage rest!"

# game/02_cap1_Ichika.rpy:148
translate english hub_Ichika_810c9045:

    # mc "No existe eso."
    mc "That doesn't exist."

# game/02_cap1_Ichika.rpy:153
translate english hub_Ichika_5122574d:

    # ichika "¡Claro que existe! ¡Lo inventé yo hace cinco minutos!"
    ichika "Of course it does! I invented it five minutes ago!"

# game/02_cap1_Ichika.rpy:155
translate english hub_Ichika_3cc6b8a8:

    # narrador "Se rió de su propio chiste, un poco más fuerte."
    narrador "She laughed at her own joke, a little too loud."

# game/02_cap1_Ichika.rpy:157
translate english hub_Ichika_6ff6cf11:

    # mc_pensamiento "Cambió de tema tan rápido que casi no lo noto."
    mc_pensamiento "She changed the subject so fast I almost missed it."

# game/02_cap1_Ichika.rpy:159
translate english hub_Ichika_31af216d:

    # mc_pensamiento "Casi."
    mc_pensamiento "Almost."

# game/02_cap1_Ichika.rpy:161
translate english hub_Ichika_206cdf43:

    # narrador "Se puso de pie y se sacudió la falda."
    narrador "She got to her feet and brushed off her skirt."

# game/02_cap1_Ichika.rpy:163
translate english hub_Ichika_ac689a7f:

    # narrador "Recogió el guion del suelo con un solo movimiento, como si llevara ensayado también eso."
    narrador "She scooped the script off the floor in one move, as if she'd rehearsed that too."

# game/02_cap1_Ichika.rpy:165
translate english hub_Ichika_cb2ff2a1:

    # mc "¿Cuánto tiempo dormiste anoche?"
    mc "How long did you sleep last night?"

# game/02_cap1_Ichika.rpy:170
translate english hub_Ichika_27b02710:

    # ichika "¡Lo suficiente!"
    ichika "Enough!"

# game/02_cap1_Ichika.rpy:172
translate english hub_Ichika_28feb0dd:

    # mc "Eso no es un número."
    mc "That's not a number."

# game/02_cap1_Ichika.rpy:174
translate english hub_Ichika_444e33d9:

    # ichika "¿Y desde cuándo un tutor pide cifras de algo que no entra en el examen?"
    ichika "And since when does a tutor ask for figures on something that isn't on the exam?"

# game/02_cap1_Ichika.rpy:176
translate english hub_Ichika_ea25d5cd:

    # narrador "Lo dijo con una sonrisa, pero cambió de tema otra vez, y esta ya era la segunda."
    narrador "She said it with a smile, but she changed the subject again, and that made two."

# game/02_cap1_Ichika.rpy:180
translate english hub_Ichika_c9aa19af:

    # narrador "Guardó el horario doblándolo rápido."
    narrador "She put the schedule away, folding it fast."

# game/02_cap1_Ichika.rpy:182
translate english hub_Ichika_ecf92909:

    # narrador "Más rápido de lo necesario, antes de que yo pudiera leer lo que estaba tachado."
    narrador "Faster than necessary, before I could read what was crossed out."

# game/02_cap1_Ichika.rpy:184
translate english hub_Ichika_5aad4691:

    # mc "¿Cuándo puedo verte para la próxima lección?"
    mc "When can I see you for the next lesson?"

# game/02_cap1_Ichika.rpy:186
translate english hub_Ichika_2ad32c22:

    # narrador "Se lo pregunté sin pensar mucho, solo para cambiar de tema yo también."
    narrador "I asked without thinking much, just to change the subject myself."

# game/02_cap1_Ichika.rpy:191
translate english hub_Ichika_a25952ba:

    # ichika "Martes a las cinco y veinte. Nunca antes de eso."
    ichika "Tuesday at five twenty. Never before that."

# game/02_cap1_Ichika.rpy:193
translate english hub_Ichika_eeb5e024:

    # mc "¿Por qué no a las cinco? Es más redondo."
    mc "Why not five? It's a rounder number."

# game/02_cap1_Ichika.rpy:195
translate english hub_Ichika_bce9c4c6:

    # ichika "Salgo del ensayo a las cuatro treinta y cinco. Cuatro minutos para cambiarme."
    ichika "Rehearsal ends at four thirty-five. Four minutes to change."

# game/02_cap1_Ichika.rpy:197
translate english hub_Ichika_497cb95b:

    # ichika "Seis hasta la estación. El tren de las cuatro cuarenta y cinco tarda veinticinco."
    ichika "Six to the station. The four forty-five train takes twenty-five."

# game/02_cap1_Ichika.rpy:199
translate english hub_Ichika_6787c90e:

    # ichika "Y diez andando hasta casa. Cinco y veinte."
    ichika "And ten more on foot to get home. Five twenty."

# game/02_cap1_Ichika.rpy:201
translate english hub_Ichika_7f68fb33:

    # mc_pensamiento "Vaya, tiene un horario muy bien cronometrado."
    mc_pensamiento "Wow, her schedule is timed down to the minute."

# game/02_cap1_Ichika.rpy:203
translate english hub_Ichika_91823512:

    # mc_pensamiento "Lo cual me preocupa bastante."
    mc_pensamiento "Which worries me quite a bit."

# game/02_cap1_Ichika.rpy:205
translate english hub_Ichika_ab9441fb:

    # mc "Lo dijiste de corrido, sin titubear, como si ya tuvieras la cuenta hecha en la cabeza."
    mc "You said that straight off, no hesitation, like you'd already done the math in your head."

# game/02_cap1_Ichika.rpy:207
translate english hub_Ichika_5541ffec:

    # mc "Nadie improvisa ese número tan rápido."
    mc "Nobody improvises a number that fast."

# game/02_cap1_Ichika.rpy:212
translate english hub_Ichika_8122b87e:

    # ichika "¡Es que soy muy organizada! ¡Parte del oficio!"
    ichika "I'm just very organized! Part of the job!"

# game/02_cap1_Ichika.rpy:214
translate english hub_Ichika_884ce044:

    # narrador "Se rió, tapando otra vez algo que se le había escapado sin querer."
    narrador "She laughed, covering up something else that had slipped out."

# game/02_cap1_Ichika.rpy:216
translate english hub_Ichika_0efa87f2:

    # mc_pensamiento "Dos latas de energizante."
    mc_pensamiento "Two cans of energy drink."

# game/02_cap1_Ichika.rpy:218
translate english hub_Ichika_3bcf9d73:

    # mc_pensamiento "Un horario con algo tachado que no quiere que vea."
    mc_pensamiento "A schedule with something crossed out that she doesn't want me to see."

# game/02_cap1_Ichika.rpy:220
translate english hub_Ichika_8373851d:

    # mc_pensamiento "Una cuenta de minutos que le salió demasiado rápido."
    mc_pensamiento "A count of minutes that came out way too fast."

# game/02_cap1_Ichika.rpy:222
translate english hub_Ichika_b8ceb586:

    # mc_pensamiento "Y ahora esto."
    mc_pensamiento "And now this."

# game/02_cap1_Ichika.rpy:224
translate english hub_Ichika_e3228ccd:

    # mc_pensamiento "Una sola sería casualidad."
    mc_pensamiento "One would be a coincidence."

# game/02_cap1_Ichika.rpy:226
translate english hub_Ichika_26ed6dfb:

    # mc_pensamiento "Cuatro ya son un patrón."
    mc_pensamiento "Four is a pattern."

# game/02_cap1_Ichika.rpy:241
translate english hub_Ichika_3d1db1ba:

    # narrador "Se sentó en una de las sillas plegables."
    narrador "She sat down on one of the folding chairs."

# game/02_cap1_Ichika.rpy:243
translate english hub_Ichika_08d02c87:

    # narrador "Con el guion otra vez en la mano, y pasó una página sin leerla."
    narrador "With the script back in her hand, she turned a page without reading it."

# game/02_cap1_Ichika.rpy:245
translate english hub_Ichika_3a474d5e:

    # ichika "Bueno, ¿viniste a verme actuar o viniste a regañarme?"
    ichika "So, did you come to watch me act or to scold me?"

# game/02_cap1_Ichika.rpy:247
translate english hub_Ichika_205cb3e4:

    # mc "Vine a darte clase. Aunque sea media hora."
    mc "I came to give you a lesson. Even if it's only half an hour."

# game/02_cap1_Ichika.rpy:249
translate english hub_Ichika_0c14df26:

    # ichika "¡Qué aburrido!"
    ichika "How boring!"

# game/02_cap1_Ichika.rpy:251
translate english hub_Ichika_e03661bc:

    # ichika "Yo esperaba algo con más drama."
    ichika "I was hoping for something with more drama."

# game/02_cap1_Ichika.rpy:253
translate english hub_Ichika_74993e97:

    # narrador "Sonrió, esperando la broma de vuelta."
    narrador "She smiled, waiting for the joke to come back."

# game/02_cap1_Ichika.rpy:255
translate english hub_Ichika_e9f22916:

    # narrador "La que suele devolverle cualquiera que hable con ella."
    narrador "The one anybody who talks to her usually throws right back."

# game/02_cap1_Ichika.rpy:265
translate english hub_Ichika_a71b6ba8:

    # mc_pensamiento "Tres cosas que acabo de ver, y un chiste encima de cada una."
    mc_pensamiento "Three things I just saw, and she's got a joke ready on top of each one."

# game/02_cap1_Ichika.rpy:267
translate english hub_Ichika_5b7b7e0d:

    # mc_pensamiento "Ahora espera el siguiente. El mío."
    mc_pensamiento "Now she's waiting for the next one. Mine."

# game/02_cap1_Ichika.rpy:275
translate english hub_Ichika_8717af1e:

    # mc_pensamiento "Tengo un segundo para contestar. Ella ya está sonriendo." nointeract
    mc_pensamiento "I have one second to answer. She's already smiling." nointeract

# game/02_cap1_Ichika.rpy:296
translate english ichika_m4a_82570eb3:

    # narrador "No dije nada."
    narrador "I said nothing."

# game/02_cap1_Ichika.rpy:298
translate english ichika_m4a_6ae30505:

    # narrador "Me quedé de pie, mirándola, sin devolverle el chiste."
    narrador "I just stood there, looking at her, without throwing the joke back."

# game/02_cap1_Ichika.rpy:303
translate english ichika_m4a_f4739a92:

    # ichika "...¿Qué?"
    ichika "...What?"

# game/02_cap1_Ichika.rpy:305
translate english ichika_m4a_0090a2d5:

    # mc "Nada."
    mc "Nothing."

# game/02_cap1_Ichika.rpy:307
translate english ichika_m4a_e2c44b00:

    # ichika "No pusiste cara de nada."
    ichika "That wasn't a \"nothing\" face."

# game/02_cap1_Ichika.rpy:309
translate english ichika_m4a_8529d9b3:

    # ichika "Pusiste cara de estar esperando algo."
    ichika "That was a \"waiting for something\" face."

# game/02_cap1_Ichika.rpy:311
translate english ichika_m4a_f54559ef:

    # mc "Puede ser."
    mc "Maybe."

# game/02_cap1_Ichika.rpy:313
translate english ichika_m4a_ae719ef4:

    # narrador "El silencio se estiró más de lo que suele durar entre los dos."
    narrador "The silence stretched longer than it ever does between us."

# game/02_cap1_Ichika.rpy:315
translate english ichika_m4a_41dc9856:

    # narrador "Ella fue la que lo rompió, y lo hizo sin la sonrisa de antes."
    narrador "She was the one who broke it, and without her earlier smile."

# game/02_cap1_Ichika.rpy:320
translate english ichika_m4a_d82ec8db:

    # ichika "...No sé cuánto más puedo seguir haciendo esto."
    ichika "...I don't know how much longer I can keep doing this."

# game/02_cap1_Ichika.rpy:322
translate english ichika_m4a_fb831c02:

    # mc "¿Esto qué?"
    mc "Doing what?"

# game/02_cap1_Ichika.rpy:324
translate english ichika_m4a_ff91cfd9:

    # ichika "Todo."
    ichika "All of it."

# game/02_cap1_Ichika.rpy:326
translate english ichika_m4a_2343d0d7:

    # ichika "Las audiciones. Las clases."
    ichika "The auditions. The classes."

# game/02_cap1_Ichika.rpy:328
translate english ichika_m4a_a28ffc56:

    # ichika "Fingir que puedo con las dos."
    ichika "Pretending I can handle both."

# game/02_cap1_Ichika.rpy:330
translate english ichika_m4a_f48097ab:

    # narrador "Lo dijo sin exclamación."
    narrador "She said it without an exclamation."

# game/02_cap1_Ichika.rpy:332
translate english ichika_m4a_1e5d3425:

    # narrador "La primera frase larga de toda la tarde sin una sola."
    narrador "Her first long sentence all afternoon, and not one exclamation point."

# game/02_cap1_Ichika.rpy:334
translate english ichika_m4a_a4e034ea:

    # mc "No dije que no pudieras."
    mc "I didn't say you couldn't."

# game/02_cap1_Ichika.rpy:336
translate english ichika_m4a_fa4f86ef:

    # ichika "No hacía falta."
    ichika "You didn't have to."

# game/02_cap1_Ichika.rpy:338
translate english ichika_m4a_a4f97406:

    # ichika "Yo también me lo digo, y no me lo creo ni cuando lo digo yo."
    ichika "I tell myself that too, and I don't believe it even when I'm the one saying it."

# game/02_cap1_Ichika.rpy:340
translate english ichika_m4a_f25d0f69:

    # narrador "Se quedó mirando el guion, sin pasar la página."
    narrador "She kept staring at the script without turning the page."

# game/02_cap1_Ichika.rpy:342
translate english ichika_m4a_b402bae2:

    # ichika "La audición que tenía cuando llegaste... no fui."
    ichika "The audition I had when you showed up... I didn't go."

# game/02_cap1_Ichika.rpy:344
translate english ichika_m4a_b4045233:

    # ichika "Me dormí en el tren. Desperté tres estaciones después."
    ichika "I fell asleep on the train. Woke up three stops later."

# game/02_cap1_Ichika.rpy:346
translate english ichika_m4a_abf9856d:

    # mc_pensamiento "Lo tachado del horario. Apostaría a que era eso."
    mc_pensamiento "What was crossed out on the schedule. I'd bet that was it."

# game/02_cap1_Ichika.rpy:348
translate english ichika_m4a_f314fb75:

    # mc_pensamiento "Y al día siguiente me abrió la puerta diciendo que había sido un éxito."
    mc_pensamiento "And the next day she opened the door and told me it had been a success."

# game/02_cap1_Ichika.rpy:353
translate english ichika_m4a_2a88e035:

    # ichika "..."
    ichika "..."

# game/02_cap1_Ichika.rpy:355
translate english ichika_m4a_248f241d:

    # ichika "¿No vas a decir nada aprovechado sobre esto?"
    ichika "Aren't you going to turn this into a lesson?"

# game/02_cap1_Ichika.rpy:357
translate english ichika_m4a_741417ec:

    # mc "¿Cómo qué?"
    mc "Like what?"

# game/02_cap1_Ichika.rpy:359
translate english ichika_m4a_cfdc81f3:

    # ichika "No sé. Algo de tutor."
    ichika "I don't know. Something tutor-y."

# game/02_cap1_Ichika.rpy:361
translate english ichika_m4a_efeab5f1:

    # ichika "\"Si estás cansada, deberías dormir más.\""
    ichika "\"If you're tired, you should sleep more.\""

# game/02_cap1_Ichika.rpy:363
translate english ichika_m4a_b577e0b4:

    # mc "Eso ya lo sabes tú sola."
    mc "You already know that on your own."

# game/02_cap1_Ichika.rpy:365
translate english ichika_m4a_9254dbaf:

    # narrador "Sonrió, esta vez más despacio, sin la energía de antes."
    narrador "She smiled, slower this time, without her earlier energy."

# game/02_cap1_Ichika.rpy:370
translate english ichika_m4a_bdb90174:

    # ichika "...Gracias por no decir la frase obvia."
    ichika "...Thanks for not saying the obvious thing."

# game/02_cap1_Ichika.rpy:375
translate english ichika_m4a_2b83b5cf:

    # narrador "Guardó el guion en la mochila, todavía sin la actuación completa de vuelta."
    narrador "She put the script in her bag, still without the full act back."

# game/02_cap1_Ichika.rpy:377
translate english ichika_m4a_d1f59608:

    # mc_pensamiento "Volvió la sonrisa. Pero tardó, y no vino con exclamación."
    mc_pensamiento "The smile came back. But late, and without the exclamation."

# game/02_cap1_Ichika.rpy:379
translate english ichika_m4a_ea405858:

    # mc_pensamiento "Es la primera vez que la veo actuar despacio."
    mc_pensamiento "It's the first time I've seen her act slowly."

# game/02_cap1_Ichika.rpy:393
translate english ichika_m4b_37133fb3:

    # mc "Con más drama, entonces."
    mc "With more drama, then."

# game/02_cap1_Ichika.rpy:395
translate english ichika_m4b_9cb27a56:

    # mc "Entras corriendo, gritando mi nombre."
    mc "You come running in, shouting my name."

# game/02_cap1_Ichika.rpy:400
translate english ichika_m4b_6f7916da:

    # ichika "¡Eso es de telenovela de la tarde! Hay que innovar."
    ichika "That's afternoon soap opera stuff! We have to innovate."

# game/02_cap1_Ichika.rpy:402
translate english ichika_m4b_0f7c4f6f:

    # mc "¿Qué tal un dragón?"
    mc "How about a dragon?"

# game/02_cap1_Ichika.rpy:404
translate english ichika_m4b_f3c27711:

    # ichika "¡Un dragón que además sabe matemáticas!"
    ichika "A dragon who also knows math!"

# game/02_cap1_Ichika.rpy:406
translate english ichika_m4b_984583e0:

    # ichika "¡Perfecto para ti!"
    ichika "Perfect for you!"

# game/02_cap1_Ichika.rpy:408
translate english ichika_m4b_51809b6b:

    # narrador "Se rió, esta vez de verdad, y la conversación se fue por ahí un rato."
    narrador "She laughed, really laughed this time, and the conversation wandered off that way for a while."

# game/02_cap1_Ichika.rpy:410
translate english ichika_m4b_da613409:

    # mc_pensamiento "Es una buena broma. Las suyas siempre lo son."
    mc_pensamiento "It's a good joke. Hers always are."

# game/02_cap1_Ichika.rpy:412
translate english ichika_m4b_6c3c6483:

    # mc_pensamiento "Pero seguimos hablando de dragones y no de las dos latas de energizante."
    mc_pensamiento "But we kept talking about dragons and not about the two cans of energy drink."

# game/02_cap1_Ichika.rpy:417
translate english ichika_m4b_94e30c26:

    # ichika "¡Y el dragón tendría que usar lentes! ¡Para verse serio con los números!"
    ichika "And the dragon would have to wear glasses! To look serious with the numbers!"

# game/02_cap1_Ichika.rpy:419
translate english ichika_m4b_d211e69f:

    # mc "Los dragones no necesitan lentes."
    mc "Dragons don't need glasses."

# game/02_cap1_Ichika.rpy:421
translate english ichika_m4b_ab05fc24:

    # ichika "¡Este sí! ¡Es miope de tanto leer contratos de audición!"
    ichika "This one does! He's nearsighted from reading audition contracts!"

# game/02_cap1_Ichika.rpy:423
translate english ichika_m4b_26ece722:

    # narrador "Siguió inventando detalles del dragón durante un rato más, cada uno más absurdo que el anterior."
    narrador "She kept inventing dragon details for a while longer, each one more absurd than the last."

# game/02_cap1_Ichika.rpy:425
translate english ichika_m4b_bc361f7a:

    # mc_pensamiento "Cuanto más se ríe, menos espacio queda para preguntar nada en serio."
    mc_pensamiento "The more she laughs, the less room there is to ask anything serious."

# game/02_cap1_Ichika.rpy:427
translate english ichika_m4b_68fb1e3d:

    # narrador "Guardó el guion en la mochila sin volver a mirarlo."
    narrador "She put the script in her bag without looking at it again."

# game/02_cap1_Ichika.rpy:429
translate english ichika_m4b_4a88d343:

    # ichika "Bueno, vamos, antes de que se haga de noche."
    ichika "Okay, let's go, before it gets dark."

# game/02_cap1_Ichika.rpy:434
translate english ichika_m4b_7b7f8909:

    # mc_pensamiento "No dijo nada más de lo que vi al entrar."
    mc_pensamiento "She said nothing more than what I'd seen walking in."

# game/02_cap1_Ichika.rpy:436
translate english ichika_m4b_a0d53543:

    # mc_pensamiento "Y yo tampoco insistí."
    mc_pensamiento "And I didn't push."

# game/02_cap1_Ichika.rpy:450
translate english ichika_m4c_5cdb123d:

    # mc "Si tienes energía para hacer chistes, tienes energía para estudiar."
    mc "If you have the energy to make jokes, you have the energy to study."

# game/02_cap1_Ichika.rpy:455
translate english ichika_m4c_3145906b:

    # narrador "La sonrisa no desapareció del todo, pero algo detrás de ella sí."
    narrador "The smile didn't disappear completely, but something behind it did."

# game/02_cap1_Ichika.rpy:457
translate english ichika_m4c_2a88e035:

    # ichika "..."
    ichika "..."

# game/02_cap1_Ichika.rpy:459
translate english ichika_m4c_640597d0:

    # ichika "Ya veo."
    ichika "I see."

# game/02_cap1_Ichika.rpy:461
translate english ichika_m4c_d422da2f:

    # narrador "Lo dijo con la voz más parecida a la de un adulto que le hubiera oído usar."
    narrador "It was the most grown-up voice I'd ever heard from her."

# game/02_cap1_Ichika.rpy:466
translate english ichika_m4c_6f47d205:

    # ichika "¡Tienes razón! ¡Debería aprovechar mejor el tiempo!"
    ichika "You're right! I should make better use of my time!"

# game/02_cap1_Ichika.rpy:471
translate english ichika_m4c_380235b3:

    # narrador "Guardó el guion de un solo movimiento, rápido."
    narrador "She stuffed the script away in one quick move."

# game/02_cap1_Ichika.rpy:473
translate english ichika_m4c_03c84224:

    # narrador "Sin doblar las páginas con cuidado como antes."
    narrador "Without smoothing the pages carefully the way she used to."

# game/02_cap1_Ichika.rpy:475
translate english ichika_m4c_15860ca1:

    # mc_pensamiento "Dije exactamente lo que un padre le diría."
    mc_pensamiento "I said exactly what a parent would say."

# game/02_cap1_Ichika.rpy:477
translate english ichika_m4c_af408e6b:

    # mc_pensamiento "Y ella me contestó exactamente lo que le contesta a un padre."
    mc_pensamiento "And she answered exactly what she answers a parent."

# game/02_cap1_Ichika.rpy:479
translate english ichika_m4c_c1a69890:

    # narrador "Salió primero, sosteniendo la puerta apenas el tiempo justo para no dejarla cerrarse en mi cara."
    narrador "She went out first, holding the door just long enough that it wouldn't shut in my face."

# game/02_cap1_Ichika.rpy:481
translate english ichika_m4c_a9e05477:

    # mc_pensamiento "No fue grosera. Fue correcta."
    mc_pensamiento "She wasn't rude. She was polite."

# game/02_cap1_Ichika.rpy:483
translate english ichika_m4c_fabc9b0b:

    # mc_pensamiento "Y eso, viniendo de ella, es peor que un portazo."
    mc_pensamiento "And coming from her, that's worse than a slammed door."

# game/02_cap1_Ichika.rpy:500
translate english ichika_m5_c66efc96:

    # narrador "Terminó de guardar el guion en la mochila cuando el teléfono le vibró en el bolsillo."
    narrador "She was finishing packing the script when the phone buzzed in her pocket."

# game/02_cap1_Ichika.rpy:505
translate english ichika_m5_d3638b1b:

    # narrador "Lo sacó sin mirar quién era, por costumbre."
    narrador "She pulled it out without looking at who it was, out of habit."

# game/02_cap1_Ichika.rpy:507
translate english ichika_m5_fdf138de:

    # narrador "Pero en cuanto vio la pantalla, algo en su postura cambió."
    narrador "But the moment she saw the screen, something in her posture changed."

# game/02_cap1_Ichika.rpy:512
translate english ichika_m5_2a88e035:

    # ichika "..."
    ichika "..."

# game/02_cap1_Ichika.rpy:514
translate english ichika_m5_849fef5d:

    # mc "¿Pasa algo?"
    mc "Something wrong?"

# game/02_cap1_Ichika.rpy:516
translate english ichika_m5_37dc111d:

    # ichika "Es del club. Dicen que hay un papel libre para la obra de primavera."
    ichika "It's from the club. They say there's an open part in the spring play."

# game/02_cap1_Ichika.rpy:518
translate english ichika_m5_3cf488d2:

    # mc "¿Eso es bueno o malo?"
    mc "Is that good or bad?"

# game/02_cap1_Ichika.rpy:520
translate english ichika_m5_e3cba8b4:

    # ichika "¡Es buenísimo! Es el papel que quería desde el año pasado."
    ichika "It's amazing! It's the part I've wanted since last year."

# game/02_cap1_Ichika.rpy:522
translate english ichika_m5_d0ced2ab:

    # narrador "Lo dijo con la voz de siempre, alta y rápida."
    narrador "She said it in her usual voice, loud and fast."

# game/02_cap1_Ichika.rpy:524
translate english ichika_m5_67461d7a:

    # narrador "Pero no sonrió al decirlo. No todavía."
    narrador "But she didn't smile as she said it. Not yet."

# game/02_cap1_Ichika.rpy:526
translate english ichika_m5_0e53721a:

    # mc "¿Y vas a aceptarlo?"
    mc "And are you going to take it?"

# game/02_cap1_Ichika.rpy:531
translate english ichika_m5_52f568f4:

    # ichika "Obvio que sí."
    ichika "Obviously."

# game/02_cap1_Ichika.rpy:533
translate english ichika_m5_7fdbeb29:

    # narrador "Contestó demasiado rápido, antes de terminar de pensarlo."
    narrador "She answered too fast, before she'd finished thinking it through."

# game/02_cap1_Ichika.rpy:535
translate english ichika_m5_6acc5a5e:

    # mc_pensamiento "Un papel más. Sobre las audiciones que ya tiene. Sobre las clases que le faltan."
    mc_pensamiento "One more part. On top of the auditions she already has. On top of the classes she's missing."

# game/02_cap1_Ichika.rpy:537
translate english ichika_m5_992d051f:

    # mc_pensamiento "La cuenta no cierra, y ella lo sabe mejor que nadie."
    mc_pensamiento "The math doesn't add up, and she knows it better than anyone."

# game/02_cap1_Ichika.rpy:539
translate english ichika_m5_5ee13c0f:

    # mc "¿Tienes tiempo para eso?"
    mc "Do you have time for that?"

# game/02_cap1_Ichika.rpy:544
translate english ichika_m5_8cbb989c:

    # ichika "No pongas esa cara."
    ichika "Don't make that face."

# game/02_cap1_Ichika.rpy:546
translate english ichika_m5_2d25235f:

    # mc "¿Qué cara?"
    mc "What face?"

# game/02_cap1_Ichika.rpy:548
translate english ichika_m5_49e0e23b:

    # ichika "Esa que dice que vas a sumar otra cosa a la lista de preguntas que no me vas a hacer."
    ichika "The one that says you're about to add another item to the list of questions you won't ask me."

# game/02_cap1_Ichika.rpy:550
translate english ichika_m5_b18c251b:

    # mc "No iba a preguntar nada."
    mc "I wasn't going to ask anything."

# game/02_cap1_Ichika.rpy:552
translate english ichika_m5_e100f91b:

    # ichika "Mentiroso."
    ichika "Liar."

# game/02_cap1_Ichika.rpy:554
translate english ichika_m5_6589e086:

    # narrador "Lo dijo casi riendo, y por un segundo volvió a ser la de siempre."
    narrador "She said it almost laughing, and for a second she was her usual self again."

# game/02_cap1_Ichika.rpy:559
translate english ichika_m5_d8123619:

    # ichika "Contestaré luego. Ahora tengo que acompañarte a la salida antes de que cierren el edificio."
    ichika "I'll answer later. Right now I have to walk you out before they lock up the building."

# game/02_cap1_Ichika.rpy:564
translate english ichika_m5_2c52f71b:

    # mc_pensamiento "No contestó el mensaje. Ni siquiera lo volvió a mirar."
    mc_pensamiento "She didn't answer the message. She didn't even look at it again."

# game/02_cap1_Ichika.rpy:566
translate english ichika_m5_fdae3d29:

    # mc_pensamiento "Solo lo guardó, como guarda todo lo demás."
    mc_pensamiento "She just put it away, the way she puts away everything else."

# game/02_cap1_Ichika.rpy:568
translate english ichika_m5_7ae606a0:

    # narrador "Guardó el teléfono en el bolsillo de la falda."
    narrador "She slipped the phone into her skirt pocket."

# game/02_cap1_Ichika.rpy:570
translate english ichika_m5_1f8303e8:

    # narrador "Con el mismo movimiento con el que había guardado el guion."
    narrador "With the same move she'd used to put away the script."

# game/02_cap1_Ichika.rpy:590
translate english ichika_m6_84f8fd7e:

    # narrador "Salimos cuando el conserje empezaba a apagar las luces del pasillo."
    narrador "We left as the janitor started turning off the hallway lights."

# game/02_cap1_Ichika.rpy:592
translate english ichika_m6_ba763b7b:

    # mc_pensamiento "Una de cinco."
    mc_pensamiento "One out of five."

# game/02_cap1_Ichika.rpy:594
translate english ichika_m6_193001f8:

    # mc_pensamiento "Y esta se durmió antes de que yo dijera nada."
    mc_pensamiento "And this one fell asleep before I'd said anything."

# game/02_cap1_Ichika.rpy:596
translate english ichika_m6_47430c21:

    # mc_pensamiento "Quedan [tiempo_restante!t]."
    mc_pensamiento "[tiempo_restante!tc] left."

# game/02_cap1_Ichika.rpy:601
translate english ichika_m6_2d141dd0:

    # mc_pensamiento "Dijo que no sabía cuánto más podía seguir así."
    mc_pensamiento "She said she didn't know how much longer she could go on like this."

# game/02_cap1_Ichika.rpy:603
translate english ichika_m6_a4b1520e:

    # mc_pensamiento "No sé si me lo dijo a mí o si se le escapó."
    mc_pensamiento "I don't know if she said it to me or if it just slipped out."

# game/02_cap1_Ichika.rpy:605
translate english ichika_m6_ab1257b8:

    # mc_pensamiento "Tampoco sé si hay diferencia."
    mc_pensamiento "I don't know if there's a difference, either."

# game/02_cap1_Ichika.rpy:607
translate english ichika_m6_2d1f7225:

    # mc_pensamiento "Y aun así, en cuanto llegó el mensaje del papel nuevo, dijo que sí sin pensarlo dos veces."
    mc_pensamiento "And even so, the moment the message about the new part came, she said yes without thinking twice."

# game/02_cap1_Ichika.rpy:609
translate english ichika_m6_0c6a70a5:

    # mc_pensamiento "Como si admitir que no puede con todo no cambiara en nada lo que va a seguir haciendo mañana."
    mc_pensamiento "As if admitting she can't handle everything changed nothing about what she'll do tomorrow."

# game/02_cap1_Ichika.rpy:613
translate english ichika_m6_6580d73a:

    # mc_pensamiento "Hablamos de dragones durante diez minutos."
    mc_pensamiento "We talked about dragons for ten minutes."

# game/02_cap1_Ichika.rpy:615
translate english ichika_m6_c537de5a:

    # mc_pensamiento "Fue divertido."
    mc_pensamiento "It was fun."

# game/02_cap1_Ichika.rpy:617
translate english ichika_m6_58125b36:

    # mc_pensamiento "No estoy seguro de que haya sido nada más que eso."
    mc_pensamiento "I'm not sure it was anything more than that."

# game/02_cap1_Ichika.rpy:619
translate english ichika_m6_91814221:

    # mc_pensamiento "No hubo ningún cambio en ella."
    mc_pensamiento "Nothing changed in her."

# game/02_cap1_Ichika.rpy:621
translate english ichika_m6_f2d855f1:

    # mc_pensamiento "Siento como si no hubiera hecho nada para ayudarla."
    mc_pensamiento "I feel like I did nothing to help her."

# game/02_cap1_Ichika.rpy:623
translate english ichika_m6_92cac049:

    # mc_pensamiento "Y cuando le ofrecieron el papel que quería, aceptó antes de que yo dijera nada."
    mc_pensamiento "And when they offered her the part she wanted, she accepted before I'd said a word."

# game/02_cap1_Ichika.rpy:625
translate english ichika_m6_7385fe81:

    # mc_pensamiento "Ni una palabra sobre todo lo que ya tiene encima."
    mc_pensamiento "Not a word about everything she already has on her plate."

# game/02_cap1_Ichika.rpy:629
translate english ichika_m6_eac03fa8:

    # mc_pensamiento "Tenía razón en lo que dije."
    mc_pensamiento "I was right about what I said."

# game/02_cap1_Ichika.rpy:631
translate english ichika_m6_48c3d7fa:

    # mc_pensamiento "Pero no me hace sentir mejor."
    mc_pensamiento "But it doesn't make me feel any better."

# game/02_cap1_Ichika.rpy:633
translate english ichika_m6_c269bef2:

    # mc_pensamiento "Sostuvo la puerta el tiempo justo. Ni un segundo más."
    mc_pensamiento "She held the door just long enough. Not a second more."

# game/02_cap1_Ichika.rpy:635
translate english ichika_m6_ae577c3e:

    # mc_pensamiento "Y aun con todo lo que le dije, aceptó un papel más antes de que llegáramos a la salida."
    mc_pensamiento "And after everything I said to her, she took one more part before we even reached the exit."

# game/02_cap1_Ichika.rpy:637
translate english ichika_m6_ba69d736:

    # mc_pensamiento "Como si hoy solo le hubiera enseñado a esconder mejor la cuenta."
    mc_pensamiento "As if all I'd taught her today was how to hide the total better."

# game/02_cap1_Ichika.rpy:639
translate english ichika_m6_1f1f69d3:

    # mc_pensamiento "No a hacerla más corta."
    mc_pensamiento "Not how to make it smaller."

translate english strings:

    # game/02_cap1_Ichika.rpy:271
    old "¿Qué le dirás a Ichika?"
    new "What will you say to Ichika?"

    # game/02_cap1_Ichika.rpy:271
    old "Se durmió en el suelo del club, y ya está bromeando otra vez."
    new "She fell asleep on the club floor, and she's already joking again."

    # game/02_cap1_Ichika.rpy:277
    old "No seguirle la broma. Esperar a que hable ella."
    new "Don't play along. Wait for her to speak."

    # game/02_cap1_Ichika.rpy:280
    old "Seguirle la broma. Por hoy ya tuvo bastante."
    new "Play along. She's had enough for today."

    # game/02_cap1_Ichika.rpy:283
    old "Si tienes energía para hacer chistes, tienes energía\npara estudiar."
    new "If you have the energy to make jokes,\nyou have the energy to study."

