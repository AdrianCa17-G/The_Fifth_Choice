    narrador "The drama club had a room of its own behind the auditorium."

# game/02_cap1_Ichika.rpy:41
translate english hub_Ichika_1f765782:

    # narrador "Nadie me dijo que llamara antes de entrar."
    narrador "Nobody had told me to knock first."

