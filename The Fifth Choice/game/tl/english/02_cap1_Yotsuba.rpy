# game/02_cap1_Yotsuba.rpy:39
translate english hub_Yotsuba_69f96e52:

    # narrador "La pista de atletismo estaba al fondo del edificio de deportes."
    narrador "The track was at the back of the sports building."

# game/02_cap1_Yotsuba.rpy:41
translate english hub_Yotsuba_95a4bb7c:

    # narrador "Tardé diez minutos en encontrarla."
    narrador "It took me ten minutes to find it."

# game/02_cap1_Yotsuba.rpy:43
translate english hub_Yotsuba_5c0ae042:

    # narrador "El club había cerrado. Las gradas estaban vacías y las luces de competición apagadas."
    narrador "The club had closed. The stands were empty and the competition lights were off."

# game/02_cap1_Yotsuba.rpy:45
translate english hub_Yotsuba_af948288:

    # narrador "Solo estaba encendido el sistema de emergencia, que daba una luz naranja pareja y sin sombras."
    narrador "Only the emergency system was on, giving off a flat orange light with no shadows."

# game/02_cap1_Yotsuba.rpy:52
translate english hub_Yotsuba_f8d72261:

    # mc_pensamiento "El club se había ido hace por lo menos media hora."
    mc_pensamiento "The club had left at least half an hour ago."

# game/02_cap1_Yotsuba.rpy:54
translate english hub_Yotsuba_044a8b91:

    # mc_pensamiento "Ella sigue ahí."
    mc_pensamiento "She's still here."

# game/02_cap1_Yotsuba.rpy:56
translate english hub_Yotsuba_8a1be019:

    # mc_pensamiento "Sola."
    mc_pensamiento "Alone."

# game/02_cap1_Yotsuba.rpy:58
translate english hub_Yotsuba_e092a5a5:

    # mc_pensamiento "Se cambió para irse a casa y solo se dejó las zapatillas puestas."
    mc_pensamiento "She'd changed to go home, but left her running shoes on."

# game/02_cap1_Yotsuba.rpy:60
translate english hub_Yotsuba_47d40feb:

    # narrador "Seguía dando vueltas, sin siquiera notar mi presencia."
    narrador "She kept running laps, without even noticing me."

# game/02_cap1_Yotsuba.rpy:62
translate english hub_Yotsuba_790a3ac4:

    # narrador "Fue la tercera vuelta cuando escuché lo que decía."
    narrador "It was around the third lap that I heard what she was saying."

# game/02_cap1_Yotsuba.rpy:64
translate english hub_Yotsuba_c61e2cf5:

    # yotsuba "¡Veinte! ¡Vamos, Yotsuba! ¡Tú puedes!"
    yotsuba "Twenty! Come on, Yotsuba! You can do it!"

# game/02_cap1_Yotsuba.rpy:66
translate english hub_Yotsuba_d3553b58:

    # yotsuba "¡La vuelta veintiuno es tuya! ¡Es tu vuelta favorita!"
    yotsuba "Lap twenty-one is yours! It's your favorite lap!"

# game/02_cap1_Yotsuba.rpy:68
translate english hub_Yotsuba_6fa6552f:

    # mc_pensamiento "Estaba contando en voz alta."
    mc_pensamiento "She was counting out loud."

# game/02_cap1_Yotsuba.rpy:70
translate english hub_Yotsuba_0a0dff88:

    # mc_pensamiento "Y animándose a sí misma."
    mc_pensamiento "And cheering herself on."

# game/02_cap1_Yotsuba.rpy:72
translate english hub_Yotsuba_d34367be:

    # narrador "Me quedé observándola y memorizando el número de vueltas que llevaba."
    narrador "I stayed there watching, keeping track of how many laps she'd done."

# game/02_cap1_Yotsuba.rpy:77
translate english hub_Yotsuba_5cd178db:

    # yotsuba "¡Veintidós! ¡Esto es fácil! ¡Podría hacer cien! ¡Bueno, quizás no cien, pero sí veinticinco!"
    yotsuba "Twenty-two! Easy! I could do a hundred! Okay, maybe not a hundred, but twenty-five for sure!"

# game/02_cap1_Yotsuba.rpy:79
translate english hub_Yotsuba_f57d8ad2:

    # yotsuba "¡Veinticinco es un número perfecto!"
    yotsuba "Twenty-five is a perfect number!"

# game/02_cap1_Yotsuba.rpy:81
translate english hub_Yotsuba_57aef825:

    # mc_pensamiento "No es un número perfecto."
    mc_pensamiento "It's not a perfect number."

# game/02_cap1_Yotsuba.rpy:83
translate english hub_Yotsuba_5770c106:

    # narrador "Cuando pasó por delante de las gradas lo vi: lo estaba anotando."
    narrador "When she passed the stands I saw it: she was writing it down."

# game/02_cap1_Yotsuba.rpy:85
translate english hub_Yotsuba_08934ab9:

    # narrador "En la muñeca. Con rotulador."
    narrador "On her wrist. In marker."

# game/02_cap1_Yotsuba.rpy:87
translate english hub_Yotsuba_b1022a3d:

    # mc_pensamiento "Lleva las vueltas escritas en el brazo."
    mc_pensamiento "She's got the laps written on her arm."

# game/02_cap1_Yotsuba.rpy:89
translate english hub_Yotsuba_08f7cede:

    # narrador "Tomó la curva y me vio."
    narrador "She took the curve and saw me."

# game/02_cap1_Yotsuba.rpy:104
translate english hub_Yotsuba_dacbc8bb:

    # narrador "Se paró en seco a mitad de la pista."
    narrador "She stopped dead in the middle of the track."

# game/02_cap1_Yotsuba.rpy:106
translate english hub_Yotsuba_ad52ef4c:

    # narrador "Murmuró algo entre dientes, sin aire."
    narrador "She muttered something under her breath, out of air."

# game/02_cap1_Yotsuba.rpy:108
translate english hub_Yotsuba_099bef7b:

    # yotsuba "..."
    yotsuba "..."

# game/02_cap1_Yotsuba.rpy:110
translate english hub_Yotsuba_b7dcf393:

    # mc "Llevas veintitrés vueltas, Yotsuba."
    mc "You're on lap twenty-three, Yotsuba."

# game/02_cap1_Yotsuba.rpy:112
translate english hub_Yotsuba_f957dc9a:

    # mc "Te va a dar algo si sigues hablando contigo misma."
    mc "You're going to wear yourself out talking to yourself."

# game/02_cap1_Yotsuba.rpy:117
translate english hub_Yotsuba_64cbabbc:

    # yotsuba "¡No estaba hablando sola! ¡Estaba haciendo técnica de concentración mental!"
    yotsuba "I wasn't talking to myself! I was doing mental focus training!"

# game/02_cap1_Yotsuba.rpy:119
translate english hub_Yotsuba_4cfb5467:

    # yotsuba "¡Es un método avalado por atletas de élite!"
    yotsuba "It's a method endorsed by elite athletes!"

# game/02_cap1_Yotsuba.rpy:121
translate english hub_Yotsuba_3363f335:

    # mc "Ajá."
    mc "Uh-huh."

# game/02_cap1_Yotsuba.rpy:123
translate english hub_Yotsuba_81607968:

    # yotsuba "¡Lo dijeron en un documental de la tele!"
    yotsuba "They said so in a TV documentary!"

# game/02_cap1_Yotsuba.rpy:125
translate english hub_Yotsuba_8b3841aa:

    # mc "¿Cuánto tiempo llevas aquí?"
    mc "How long have you been here?"

# game/02_cap1_Yotsuba.rpy:127
translate english hub_Yotsuba_65583a45:

    # narrador "Pausa."
    narrador "Pause."

# game/02_cap1_Yotsuba.rpy:132
translate english hub_Yotsuba_71b765fe:

    # yotsuba "...¿Cuánto llevas tú, [mc]?"
    yotsuba "...How long have you been here, [mc]?"

# game/02_cap1_Yotsuba.rpy:134
translate english hub_Yotsuba_43184c08:

    # mc "Tus últimas ocho vueltas."
    mc "Your last eight laps."

# game/02_cap1_Yotsuba.rpy:136
translate english hub_Yotsuba_099bef7b_1:

    # yotsuba "..."
    yotsuba "..."

# game/02_cap1_Yotsuba.rpy:138
translate english hub_Yotsuba_5f276b32:

    # yotsuba "Eso es mucho tiempo."
    yotsuba "That's a long time."

# game/02_cap1_Yotsuba.rpy:140
translate english hub_Yotsuba_f6c0baba:

    # mc "Sí. Lo es."
    mc "Yeah. It is."

# game/02_cap1_Yotsuba.rpy:142
translate english hub_Yotsuba_5abc9ae7:

    # mc "Y parece que no es la primera vez que te quedas después de que el club se va."
    mc "And it looks like it's not the first time you've stayed after the club leaves."

# game/02_cap1_Yotsuba.rpy:149
translate english hub_Yotsuba_6eb6d5d7:

    # narrador "Bajó la mirada, con las manos recogidas contra el pecho."
    narrador "She lowered her gaze, hands tucked against her chest."

# game/02_cap1_Yotsuba.rpy:151
translate english hub_Yotsuba_77b6409d:

    # narrador "Como si acabara de darse cuenta de que alguien la estaba viendo."
    narrador "As if she'd just realized someone was watching her."

# game/02_cap1_Yotsuba.rpy:153
translate english hub_Yotsuba_9c063e63:

    # narrador "En el antebrazo, las marcas de rotulador corridas por el sudor."
    narrador "On her forearm, the marker numbers smeared with sweat."

# game/02_cap1_Yotsuba.rpy:157
translate english hub_Yotsuba_f2880ffd:

    # yotsuba "¿Por qué estás aquí?"
    yotsuba "Why are you here?"

# game/02_cap1_Yotsuba.rpy:159
translate english hub_Yotsuba_d92cb5f9:

    # mc "Porque es donde estás tú."
    mc "Because it's where you are."

# game/02_cap1_Yotsuba.rpy:161
translate english hub_Yotsuba_760666ed:

    # yotsuba "¿Y eso por qué importa?"
    yotsuba "And why does that matter?"

# game/02_cap1_Yotsuba.rpy:163
translate english hub_Yotsuba_1f5f6451:

    # mc "Porque soy tu tutor."
    mc "Because I'm your tutor."

# game/02_cap1_Yotsuba.rpy:165
translate english hub_Yotsuba_e3aab386:

    # narrador "Lo procesó un segundo."
    narrador "She processed that for a second."

# game/02_cap1_Yotsuba.rpy:167
translate english hub_Yotsuba_af644779:

    # narrador "Luego asintió con la solemnidad de quien acaba de recordar algo obvio."
    narrador "Then she nodded, with the solemnity of someone remembering something obvious."

# game/02_cap1_Yotsuba.rpy:169
translate english hub_Yotsuba_3a76904c:

    # yotsuba "¡Ah, claro! ¡Eso tiene sentido! ¡Pues bienvenido a la pista!"
    yotsuba "Oh, right! That makes sense! Well, welcome to the track!"

# game/02_cap1_Yotsuba.rpy:171
translate english hub_Yotsuba_d59e10d5:

    # mc "Gracias. ¿Por qué sigues aquí si el club ya se fue?"
    mc "Thanks. Why are you still here if the club already left?"

# game/02_cap1_Yotsuba.rpy:173
translate english hub_Yotsuba_e9196700:

    # narrador "La pregunta la pilló sin la exclamación preparada."
    narrador "The question caught her without an exclamation ready."

# game/02_cap1_Yotsuba.rpy:175
translate english hub_Yotsuba_05471eea:

    # yotsuba "...Quería terminar las series."
    yotsuba "...I wanted to finish my sets."

# game/02_cap1_Yotsuba.rpy:177
translate english hub_Yotsuba_983fca69:

    # mc "¿Cuántas series?"
    mc "How many sets?"

# game/02_cap1_Yotsuba.rpy:179
translate english hub_Yotsuba_f13e20e2:

    # yotsuba "Las que me faltaban."
    yotsuba "The ones I had left."

# game/02_cap1_Yotsuba.rpy:181
translate english hub_Yotsuba_e5f84a5c:

    # mc "¿Cuántas te faltaban?"
    mc "How many did you have left?"

# game/02_cap1_Yotsuba.rpy:183
translate english hub_Yotsuba_abbf49eb:

    # yotsuba "...Treinta."
    yotsuba "...Thirty."

# game/02_cap1_Yotsuba.rpy:185
translate english hub_Yotsuba_d66e996f:

    # narrador "Treinta vueltas después de que el club cerró."
    narrador "Thirty laps after the club closed."

# game/02_cap1_Yotsuba.rpy:187
translate english hub_Yotsuba_aa9fc9b7:

    # mc_pensamiento "Antes dijo veinticinco."
    mc_pensamiento "She said twenty-five before."

# game/02_cap1_Yotsuba.rpy:189
translate english hub_Yotsuba_565e5b29:

    # mc_pensamiento "Ahora dice treinta."
    mc_pensamiento "Now she says thirty."

# game/02_cap1_Yotsuba.rpy:191
translate english hub_Yotsuba_d488ab22:

    # mc_pensamiento "Eso es entre nueve y doce kilómetros, dependiendo del tamaño de la pista."
    mc_pensamiento "That's between nine and twelve kilometers, depending on the size of the track."

# game/02_cap1_Yotsuba.rpy:193
translate english hub_Yotsuba_c4616b77:

    # mc "¿Entrenas así todos los días?"
    mc "Do you train like this every day?"

# game/02_cap1_Yotsuba.rpy:195
translate english hub_Yotsuba_87918704:

    # yotsuba "¡Solo cuando quiero mejorar!"
    yotsuba "Only when I want to improve!"

# game/02_cap1_Yotsuba.rpy:197
translate english hub_Yotsuba_93386e44:

    # yotsuba "...O sea, todos los días."
    yotsuba "...So, every day."

# game/02_cap1_Yotsuba.rpy:199
translate english hub_Yotsuba_48507ed8:

    # mc "¿Y el club no se queda?"
    mc "And the club doesn't stay?"

# game/02_cap1_Yotsuba.rpy:201
translate english hub_Yotsuba_52cfb733:

    # narrador "Algo cambió en la forma en que se apoyó en la valla."
    narrador "Something shifted in the way she leaned on the fence."

# game/02_cap1_Yotsuba.rpy:203
translate english hub_Yotsuba_7fc07a40:

    # yotsuba "El club tiene sus propios objetivos. Yo tengo los míos."
    yotsuba "The club has its own goals. I have mine."

# game/02_cap1_Yotsuba.rpy:205
translate english hub_Yotsuba_c2fd32ce:

    # mc "¿Cuáles son los tuyos?"
    mc "What are yours?"

# game/02_cap1_Yotsuba.rpy:207
translate english hub_Yotsuba_51e0d285:

    # narrador "No contestó de inmediato."
    narrador "She didn't answer right away."

# game/02_cap1_Yotsuba.rpy:211
translate english hub_Yotsuba_608b19fb:

    # narrador "Miró la pista, el rotulador, las gradas vacías."
    narrador "She looked at the track, the marker, the empty stands."

# game/02_cap1_Yotsuba.rpy:221
translate english hub_Yotsuba_dd7ad63a:

    # yotsuba "Mis hermanas son mejores que yo en casi todo."
    yotsuba "My sisters are better than me at almost everything."

# game/02_cap1_Yotsuba.rpy:223
translate english hub_Yotsuba_bad8a5a8:

    # yotsuba "Ichika actúa. Nino cocina. Miku sabe de historia. Itsuki estudia."
    yotsuba "Ichika acts. Nino cooks. Miku knows history. Itsuki studies."

# game/02_cap1_Yotsuba.rpy:225
translate english hub_Yotsuba_6f25bbc5:

    # yotsuba "Y yo..."
    yotsuba "And me..."

# game/02_cap1_Yotsuba.rpy:227
translate english hub_Yotsuba_6130609c:

    # narrador "Señaló la pista con la mano abierta."
    narrador "She gestured at the track with an open hand."

# game/02_cap1_Yotsuba.rpy:229
translate english hub_Yotsuba_f478a62d:

    # yotsuba "Yo corro y animo. Así que lo hago lo mejor que puedo."
    yotsuba "I run and cheer. So I do it as well as I can."

# game/02_cap1_Yotsuba.rpy:231
translate english hub_Yotsuba_f524c16f:

    # narrador "Sonrió. Era una sonrisa buena, sin fisuras visibles."
    narrador "She smiled. A good smile, with no visible cracks."

# game/02_cap1_Yotsuba.rpy:233
translate english hub_Yotsuba_0175ae5f:

    # mc_pensamiento "Si no supiera lo que acaba de decir, pensaría que está contenta."
    mc_pensamiento "If I hadn't heard what she just said, I'd think she was happy."

# game/02_cap1_Yotsuba.rpy:235
translate english hub_Yotsuba_093e5510:

    # mc_pensamiento "Pero lo que acaba de decir es que su única razón para estar aquí es no quedarse atrás."
    mc_pensamiento "But what she just said is that her only reason to be here is not getting left behind."

# game/02_cap1_Yotsuba.rpy:237
translate english hub_Yotsuba_b4a1d854:

    # mc_pensamiento "Como si destrozarse el cuerpo en esa pista fuera un precio justo por sentirse útil."
    mc_pensamiento "As if wrecking her body on that track were a fair price for feeling useful."

# game/02_cap1_Yotsuba.rpy:245
translate english hub_Yotsuba_4ada2643:

    # narrador "Se limpió el rotulador de la muñeca con el borde de la manga."
    narrador "She wiped the marker off her wrist with the edge of her sleeve."

# game/02_cap1_Yotsuba.rpy:247
translate english hub_Yotsuba_fa1c144e:

    # narrador "Y volvió a mirarme con esa sonrisa intacta."
    narrador "And looked back at me with that smile still intact."

# game/02_cap1_Yotsuba.rpy:252
translate english hub_Yotsuba_bdd347ba:

    # yotsuba "¡Bueno!"
    yotsuba "Okay!"

# game/02_cap1_Yotsuba.rpy:254
translate english hub_Yotsuba_8780079b:

    # yotsuba "¡Si has venido a verme entrenar, puedes cronometrarme en la siguiente vuelta!"
    yotsuba "If you came to watch me train, you can time my next lap!"

# game/02_cap1_Yotsuba.rpy:256
translate english hub_Yotsuba_1413e07a:

    # yotsuba "¡Soy más rápida cuando alguien mira!"
    yotsuba "I'm faster when somebody's watching!"

# game/02_cap1_Yotsuba.rpy:258
translate english hub_Yotsuba_31ad5bb2:

    # narrador "Sacó un cronómetro del bolsillo de la falda y lo balanceó de su cordón."
    narrador "She pulled a stopwatch out of her skirt pocket and swung it by its cord."

# game/02_cap1_Yotsuba.rpy:260
translate english hub_Yotsuba_7a9415d0:

    # mc_pensamiento "Cambió de tema."
    mc_pensamiento "She changed the subject."

# game/02_cap1_Yotsuba.rpy:262
translate english hub_Yotsuba_bf3dfa3d:

    # mc_pensamiento "Lo hizo tan rápido y con tanta energía que casi no lo noté."
    mc_pensamiento "She did it so fast and with so much energy that I almost missed it."

# game/02_cap1_Yotsuba.rpy:264
translate english hub_Yotsuba_9c7789cd:

    # narrador "Dio un par de saltos en el sitio, sacudiendo los brazos."
    narrador "She did a couple of hops in place, shaking out her arms."

# game/02_cap1_Yotsuba.rpy:266
translate english hub_Yotsuba_7619be4e:

    # narrador "Como si así pudiera sacudirse también lo que acababa de decir."
    narrador "As if she could shake off what she'd just said, too."

# game/02_cap1_Yotsuba.rpy:268
translate english hub_Yotsuba_ef08b681:

    # yotsuba "¡Vamos, no hay tiempo que perder! ¡El sol no espera!"
    yotsuba "Come on, no time to lose! The sun won't wait!"

# game/02_cap1_Yotsuba.rpy:273
translate english hub_Yotsuba_1229031f:

    # narrador "Y entonces se quedó quieta, con el puño en alto y el cronómetro colgando."
    narrador "And then she went still, fist in the air, stopwatch dangling."

# game/02_cap1_Yotsuba.rpy:275
translate english hub_Yotsuba_192585dd:

    # narrador "El sol llevaba rato escondido tras las nubes."
    narrador "The sun had been hiding behind the clouds for a while."

# game/02_cap1_Yotsuba.rpy:277
translate english hub_Yotsuba_df3afe99:

    # narrador "Solo quedaba la luz naranja de emergencia."
    narrador "All that was left was the orange emergency light."

# game/02_cap1_Yotsuba.rpy:279
translate english hub_Yotsuba_f7284195:

    # mc_pensamiento "No había sol que esperar. Ella lo sabía tan bien como yo."
    mc_pensamiento "There was no sun to wait for. She knew that as well as I did."

# game/02_cap1_Yotsuba.rpy:281
translate english hub_Yotsuba_d084a269:

    # narrador "Pensé en lo que había visto estas últimas ocho vueltas."
    narrador "I thought about what I'd seen over those last eight laps."

# game/02_cap1_Yotsuba.rpy:283
translate english hub_Yotsuba_aea446c9:

    # narrador "En lo que había dicho, y en lo que no."
    narrador "About what she'd said, and what she hadn't."

# game/02_cap1_Yotsuba.rpy:287
translate english hub_Yotsuba_5d11bb2a:

    # mc_pensamiento "'Yo corro y animo'"
    mc_pensamiento "\"I run and cheer.\""

# game/02_cap1_Yotsuba.rpy:289
translate english hub_Yotsuba_a7b0255e:

    # mc_pensamiento "Como si fuera un puesto que le tocó por descarte, no algo que eligió."
    mc_pensamiento "Like it's a position she got by default, not something she chose."

# game/02_cap1_Yotsuba.rpy:291
translate english hub_Yotsuba_42809fc2:

    # yotsuba "¿Qué pasa? ¡Que el cronómetro no muerde!"
    yotsuba "What's wrong? The stopwatch doesn't bite!"

# game/02_cap1_Yotsuba.rpy:293
translate english hub_Yotsuba_050d2fe6:

    # narrador "En el brazo aún quedaba una mancha gris."
    narrador "There was still a gray smudge on her arm."

# game/02_cap1_Yotsuba.rpy:295
translate english hub_Yotsuba_ec9e6ac4:

    # narrador "Lo único que no había conseguido borrar."
    narrador "The one thing she hadn't managed to rub off."

# game/02_cap1_Yotsuba.rpy:299
translate english hub_Yotsuba_4fde309b:

    # mc_pensamiento "Podía dejarlo pasar. Cronometrarla y ya."
    mc_pensamiento "I could let it go. Just time her and that's it."

# game/02_cap1_Yotsuba.rpy:301
translate english hub_Yotsuba_959ea707:

    # yotsuba "¿[mc]? Parece que estás pensando en qué decir, ¿verdad?"
    yotsuba "[mc]? Looks like you're thinking about what to say, right?"

# game/02_cap1_Yotsuba.rpy:303
translate english hub_Yotsuba_31e8ba6d:

    # narrador "La sonrisa se le torció un instante."
    narrador "Her smile twisted for an instant."

# game/02_cap1_Yotsuba.rpy:305
translate english hub_Yotsuba_f9ef5ab8:

    # narrador "Después volvió a su sitio, como si nada."
    narrador "Then it snapped back into place, as if nothing had happened."

# game/02_cap1_Yotsuba.rpy:307
translate english hub_Yotsuba_c1bf67cd:

    # narrador "Seguía con el brazo estirado. El cronómetro, colgando de su cordón."
    narrador "Her arm was still stretched out. The stopwatch hung from its cord."

# game/02_cap1_Yotsuba.rpy:315
translate english hub_Yotsuba_dddf38fb:

    # mc_pensamiento "Lo que diga ahora, se lo va a llevar igual: con esa sonrisa puesta."
    mc_pensamiento "Whatever I say now, she'll take it the same way: with that smile on."

# game/02_cap1_Yotsuba.rpy:329
translate english hub_Yotsuba_0bf7416d:

    # mc_pensamiento "Me está dando una salida. Con el cronómetro en la mano." nointeract
    mc_pensamiento "She's giving me an out. With the stopwatch in her hand." nointeract

# game/02_cap1_Yotsuba.rpy:349
translate english yotsuba_m4a_09bff940:

    # mc "Antes de eso."
    mc "Before that."

# game/02_cap1_Yotsuba.rpy:354
translate english yotsuba_m4a_6f2fab05:

    # yotsuba "¿Antes de qué?"
    yotsuba "Before what?"

# game/02_cap1_Yotsuba.rpy:356
translate english yotsuba_m4a_1806916d:

    # mc "Dijiste que tus hermanas son mejores que tú en casi todo."
    mc "You said your sisters are better than you at almost everything."

# game/02_cap1_Yotsuba.rpy:358
translate english yotsuba_m4a_2f7c3e5f:

    # yotsuba "¡Sí! ¡Pero eso no es malo! ¡Cada una tiene lo suyo!"
    yotsuba "Yeah! But that's not bad! Everybody has their own thing!"

# game/02_cap1_Yotsuba.rpy:360
translate english yotsuba_m4a_ff77332c:

    # yotsuba "¡Y yo tengo lo mío!"
    yotsuba "And I have mine!"

# game/02_cap1_Yotsuba.rpy:362
translate english yotsuba_m4a_2718936b:

    # mc "Lo sé. Pero te saltaste algo."
    mc "I know. But you skipped something."

# game/02_cap1_Yotsuba.rpy:367
translate english yotsuba_m4a_f86f3b4d:

    # narrador "Su sonrisa no desapareció."
    narrador "Her smile didn't disappear."

# game/02_cap1_Yotsuba.rpy:369
translate english yotsuba_m4a_5e41767b:

    # narrador "Pero tardó un poco más en llegar."
    narrador "But it took a little longer to arrive."

# game/02_cap1_Yotsuba.rpy:371
translate english yotsuba_m4a_19804c01:

    # yotsuba "...¿Qué me salté?"
    yotsuba "...What did I skip?"

# game/02_cap1_Yotsuba.rpy:373
translate english yotsuba_m4a_44374d52:

    # mc "Esta mañana. Supiste que Nino no había dormido bien antes de que ella dijera nada."
    mc "This morning. You knew Nino hadn't slept well before she said anything."

# game/02_cap1_Yotsuba.rpy:375
translate english yotsuba_m4a_b1290b50:

    # yotsuba "Estaba un poco más callada que de costumbre."
    yotsuba "She was a little quieter than usual."

# game/02_cap1_Yotsuba.rpy:377
translate english yotsuba_m4a_e19d8508:

    # mc "Y le dijiste a Miku dónde estaba su libro antes de que ella preguntara."
    mc "And you told Miku where her book was before she asked."

# game/02_cap1_Yotsuba.rpy:379
translate english yotsuba_m4a_e7733faf:

    # yotsuba "Es que siempre lo deja en el mismo sitio después de leerlo."
    yotsuba "It's just that she always leaves it in the same spot after she reads it."

# game/02_cap1_Yotsuba.rpy:381
translate english yotsuba_m4a_fef7087f:

    # mc "Y cuando Ichika se duerme en la mesa, eres la única que baja la voz."
    mc "And when Ichika falls asleep at the table, you're the only one who lowers your voice."

# game/02_cap1_Yotsuba.rpy:383
translate english yotsuba_m4a_b7af9099:

    # mc "Nadie te lo pidió. Ni siquiera ella."
    mc "Nobody asked you to. Not even her."

# game/02_cap1_Yotsuba.rpy:385
translate english yotsuba_m4a_d829e611:

    # narrador "Hubo un breve silencio."
    narrador "There was a brief silence."

# game/02_cap1_Yotsuba.rpy:387
translate english yotsuba_m4a_8d245b73:

    # narrador "Un silencio de una Yotsuba que está comprobando si todo eso fue verdad."
    narrador "The silence of a Yotsuba checking whether all of that was true."

# game/02_cap1_Yotsuba.rpy:392
translate english yotsuba_m4a_b4f4a658:

    # yotsuba "Oye, [mc]... ¿Me estabas observando?"
    yotsuba "Hey, [mc]... Were you watching me?"

# game/02_cap1_Yotsuba.rpy:394
translate english yotsuba_m4a_db50bf36:

    # mc "Soy tu tutor. Observar es parte del trabajo."
    mc "I'm your tutor. Watching is part of the job."

# game/02_cap1_Yotsuba.rpy:396
translate english yotsuba_m4a_8bb37089:

    # yotsuba "Eso que describes no es nada especial."
    yotsuba "What you're describing is nothing special."

# game/02_cap1_Yotsuba.rpy:398
translate english yotsuba_m4a_d77a8cab:

    # yotsuba "Cualquiera lo haría."
    yotsuba "Anyone would do it."

# game/02_cap1_Yotsuba.rpy:400
translate english yotsuba_m4a_90c21b59:

    # mc "Ninguna de tus hermanas lo hace. Yo tampoco. Y lo intento."
    mc "None of your sisters do. I don't either. And I try."

# game/02_cap1_Yotsuba.rpy:405
translate english yotsuba_m4a_379bf445:

    # yotsuba "...Pero eso no entra en ningún examen."
    yotsuba "...But that doesn't count on any exam."

# game/02_cap1_Yotsuba.rpy:407
translate english yotsuba_m4a_07581798:

    # mc "En Japonés entra algo que se llama comprensión lectora."
    mc "Japanese has something called reading comprehension."

# game/02_cap1_Yotsuba.rpy:409
translate english yotsuba_m4a_860b1754:

    # mc "Solo que tú no lo haces con libros. Lo haces con personas."
    mc "Only you don't do it with books. You do it with people."

# game/02_cap1_Yotsuba.rpy:411
translate english yotsuba_m4a_3d31155c:

    # mc "Sabes leer lo que dicen y lo que se callan, aunque no lo expliquen."
    mc "You can read what people say and what they leave unsaid, even when nobody explains it."

# game/02_cap1_Yotsuba.rpy:413
translate english yotsuba_m4a_22772cd2:

    # mc "Tú lo haces de forma natural con cinco personas a la vez."
    mc "You do it naturally, with five people at once."

# game/02_cap1_Yotsuba.rpy:415
translate english yotsuba_m4a_1f150474:

    # narrador "No dijo nada. Miraba la pista, pero no la pista de verdad."
    narrador "She said nothing. She was looking at the track, but not the real one."

# game/02_cap1_Yotsuba.rpy:417
translate english yotsuba_m4a_be4b5158:

    # mc "No te digo que sea suficiente para el examen. "
    mc "I'm not saying it's enough for the exam."

# game/02_cap1_Yotsuba.rpy:419
translate english yotsuba_m4a_1d13b1d0:

    # mc "Te digo que tu punto de partida no es cero. Nunca lo fue."
    mc "I'm saying your starting point isn't zero. It never was."

# game/02_cap1_Yotsuba.rpy:421
translate english yotsuba_m4a_099bef7b:

    # yotsuba "..."
    yotsuba "..."

# game/02_cap1_Yotsuba.rpy:423
translate english yotsuba_m4a_7c52df80:

    # narrador "Pasó un momento largo."
    narrador "A long moment passed."

# game/02_cap1_Yotsuba.rpy:428
translate english yotsuba_m4a_3bd8a223:

    # yotsuba "No sé si eso es verdad o si eres muy bueno animando a la gente."
    yotsuba "I don't know if that's true or if you're just really good at cheering people up."

# game/02_cap1_Yotsuba.rpy:430
translate english yotsuba_m4a_070246e7:

    # mc "Soy pésimo animando a la gente. Pregúntale a cualquiera."
    mc "I'm terrible at cheering people up. Ask anyone."

# game/02_cap1_Yotsuba.rpy:432
translate english yotsuba_m4a_ec127ae8:

    # narrador "Lo pensó."
    narrador "She thought about it."

# game/02_cap1_Yotsuba.rpy:437
translate english yotsuba_m4a_8d7ef4d6:

    # yotsuba "...Eso también es verdad."
    yotsuba "...That's true too."

# game/02_cap1_Yotsuba.rpy:439
translate english yotsuba_m4a_001ea086:

    # mc "Dame el cronómetro."
    mc "Give me the stopwatch."

# game/02_cap1_Yotsuba.rpy:444
translate english yotsuba_m4a_31ac6e3f:

    # narrador "Me lo pasó sin decir nada más."
    narrador "She handed it over without another word."

# game/02_cap1_Yotsuba.rpy:446
translate english yotsuba_m4a_e9faf76d:

    # narrador "Arrancó la vuelta veinticuatro. Al pasar por la grada, dijo el número en voz alta."
    narrador "She started lap twenty-four. As she passed the stands, she said the number out loud."

# game/02_cap1_Yotsuba.rpy:448
translate english yotsuba_m4a_a64d389b:

    # narrador "Yo le contesté con el tiempo."
    narrador "I answered with her time."

# game/02_cap1_Yotsuba.rpy:450
translate english yotsuba_m4a_cf01fd5a:

    # narrador "Ya no se gritaba ánimos. Ahora la cuenta la llevábamos entre dos."
    narrador "She wasn't cheering herself on anymore. Now the two of us were keeping count."

# game/02_cap1_Yotsuba.rpy:460
translate english yotsuba_m4b_c91c4f75:

    # narrador "Cogí el cronómetro que me tendió."
    narrador "I took the stopwatch she held out."

# game/02_cap1_Yotsuba.rpy:465
translate english yotsuba_m4b_bebf4dee:

    # yotsuba "¡Genial! ¡Preparado!"
    yotsuba "Great! Ready!"

# game/02_cap1_Yotsuba.rpy:467
translate english yotsuba_m4b_4cd88bbd:

    # mc "Preparado."
    mc "Ready."

# game/02_cap1_Yotsuba.rpy:472
translate english yotsuba_m4b_dbef168c:

    # narrador "Salió disparada. Era rápida de verdad."
    narrador "She shot off. She really was fast."

# game/02_cap1_Yotsuba.rpy:474
translate english yotsuba_m4b_e8e249b7:

    # narrador "Cuando terminó la vuelta, frenó delante de mí con los brazos abiertos, esperando el tiempo."
    narrador "When she finished the lap, she skidded to a stop in front of me, arms wide, waiting for her time."

# game/02_cap1_Yotsuba.rpy:478
translate english yotsuba_m4b_ad780f00:

    # mc "Un minuto con diecisiete."
    mc "One minute seventeen."

# game/02_cap1_Yotsuba.rpy:480
translate english yotsuba_m4b_9396c512:

    # yotsuba "¡Sabía que hoy estaba bien! ¡Lo noté en el calentamiento!"
    yotsuba "I knew today was a good day! I could tell in the warm-up!"

# game/02_cap1_Yotsuba.rpy:482
translate english yotsuba_m4b_5ccc5693:

    # mc "¿Lo notas en el calentamiento?"
    mc "You can tell in the warm-up?"

# game/02_cap1_Yotsuba.rpy:484
translate english yotsuba_m4b_cbdc5501:

    # yotsuba "¡Siempre! Las piernas me avisan. ¡Es como un idioma secreto entre mi cuerpo y yo!"
    yotsuba "Always! My legs warn me. It's like a secret language between my body and me!"

# game/02_cap1_Yotsuba.rpy:486
translate english yotsuba_m4b_eeeac10b:

    # narrador "Sonreí sin querer."
    narrador "I smiled without meaning to."

# game/02_cap1_Yotsuba.rpy:488
translate english yotsuba_m4b_4c0b2836:

    # mc "¿Y tu cabeza?"
    mc "And your head?"

# game/02_cap1_Yotsuba.rpy:490
translate english yotsuba_m4b_5f541407:

    # yotsuba "¡Mi cabeza va a donde van las piernas! ¡Equipo completo!"
    yotsuba "My head goes where my legs go! Full team!"

# game/02_cap1_Yotsuba.rpy:492
translate english yotsuba_m4b_155c062d:

    # narrador "Se rió de su propio chiste. Era una risa fácil, sin trampa."
    narrador "She laughed at her own joke. An easy laugh, no catch."

# game/02_cap1_Yotsuba.rpy:494
translate english yotsuba_m4b_7449d565:

    # mc_pensamiento "Esquivó el tema."
    mc_pensamiento "She dodged the subject."

# game/02_cap1_Yotsuba.rpy:496
translate english yotsuba_m4b_bc880661:

    # mc_pensamiento "O tal vez prefirió quedarse con el cronómetro porque era más sencillo."
    mc_pensamiento "Or maybe she preferred the stopwatch because it was easier."

# game/02_cap1_Yotsuba.rpy:498
translate english yotsuba_m4b_831faa21:

    # mc_pensamiento "No lo sé. Y ella tampoco me lo va a decir hoy."
    mc_pensamiento "I don't know. And she's not going to tell me today."

# game/02_cap1_Yotsuba.rpy:500
translate english yotsuba_m4b_d7a5bf22:

    # mc "Otra vuelta."
    mc "Another lap."

# game/02_cap1_Yotsuba.rpy:502
translate english yotsuba_m4b_23f7894f:

    # yotsuba "¡Otra vuelta! ¡Esta va a ser mejor!"
    yotsuba "Another lap! This one's going to be better!"

# game/02_cap1_Yotsuba.rpy:507
translate english yotsuba_m4b_ad65c156:

    # narrador "Y lo fue."
    narrador "And it was."

# game/02_cap1_Yotsuba.rpy:509
translate english yotsuba_m4b_bc429fcf:

    # narrador "No conseguí ayudarla a sentirse mejor, pero tampoco la hice sentir peor."
    narrador "I hadn't managed to make her feel better, but I hadn't made her feel worse either."

# game/02_cap1_Yotsuba.rpy:522
translate english yotsuba_m4c_2a34eaf3:

    # mc "Entonces concéntrate en correr. Si es lo tuyo, hazlo bien."
    mc "Then focus on running. If it's your thing, do it well."

# game/02_cap1_Yotsuba.rpy:527
translate english yotsuba_m4c_2799abdf:

    # narrador "Asintió."
    narrador "She nodded."

# game/02_cap1_Yotsuba.rpy:529
translate english yotsuba_m4c_e8af6149:

    # narrador "Rápido, una sola vez, como quien recibe una instrucción."
    narrador "Fast, just once, like someone taking an order."

# game/02_cap1_Yotsuba.rpy:534
translate english yotsuba_m4c_6c375f7f:

    # yotsuba "¡Tienes razón! ¡Eso estaba haciendo! ¡Qué bueno que lo entiendas!"
    yotsuba "You're right! That's what I was doing! Good thing you get it!"

# game/02_cap1_Yotsuba.rpy:539
translate english yotsuba_m4c_2147757d:

    # narrador "Volvió a la pista sin esperar respuesta. La sonrisa era idéntica a la de antes."
    narrador "She went back to the track without waiting for an answer. Same smile as before."

# game/02_cap1_Yotsuba.rpy:542
translate english yotsuba_m4c_dff49f14:

    # mc_pensamiento "Le dije exactamente lo que quería escuchar."
    mc_pensamiento "I told her exactly what she wanted to hear."

# game/02_cap1_Yotsuba.rpy:544
translate english yotsuba_m4c_f1f69b3f:

    # mc_pensamiento "O lo que lleva siempre diciéndose a sí misma."
    mc_pensamiento "Or what she's always telling herself."

# game/02_cap1_Yotsuba.rpy:546
translate english yotsuba_m4c_8bbf892a:

    # narrador "Dio la vuelta veinticuatro en un silencio absoluto."
    narrador "She ran lap twenty-four in total silence."

# game/02_cap1_Yotsuba.rpy:548
translate english yotsuba_m4c_e791f9ae:

    # narrador "Sin contar. Sin animarse."
    narrador "No counting. No cheering herself on."

# game/02_cap1_Yotsuba.rpy:550
translate english yotsuba_m4c_ec6cf7fe:

    # narrador "Al principio no le di importancia, pero para la vuelta veinticinco lo entendí."
    narrador "At first I didn't think anything of it, but by lap twenty-five I understood."

# game/02_cap1_Yotsuba.rpy:552
translate english yotsuba_m4c_718f0447:

    # mc_pensamiento "Antes contaba en voz alta porque así no perdía el ritmo."
    mc_pensamiento "Before, she counted out loud so she wouldn't lose her rhythm."

# game/02_cap1_Yotsuba.rpy:554
translate english yotsuba_m4c_3c3567cc:

    # mc_pensamiento "Ahora ya no le hacía falta."
    mc_pensamiento "Now she didn't need to."

# game/02_cap1_Yotsuba.rpy:556
translate english yotsuba_m4c_6aca2abf:

    # narrador "Seguí ahí parado hasta que terminó la serie."
    narrador "I stayed there until she finished the set."

# game/02_cap1_Yotsuba.rpy:558
translate english yotsuba_m4c_442f9b5c:

    # narrador "No sé muy bien por qué."
    narrador "I'm not really sure why."

# game/02_cap1_Yotsuba.rpy:560
translate english yotsuba_m4c_b4bd44bb:

    # mc_pensamiento "Acabo de decirle a alguien que se concentre en la única cosa que cree que la hace valer."
    mc_pensamiento "I just told someone to focus on the only thing she thinks makes her worth anything."

# game/02_cap1_Yotsuba.rpy:562
translate english yotsuba_m4c_946a5c21:

    # mc_pensamiento "Y ahora mismo no sé si le di una instrucción o una sentencia."
    mc_pensamiento "And right now I don't know if I gave her an instruction or a sentence."

# game/02_cap1_Yotsuba.rpy:577
translate english yotsuba_m5_cbf71d57:

    # narrador "Recogí mis cosas y caminé hacia la salida del graderío."
    narrador "I gathered my things and walked toward the exit of the stands."

# game/02_cap1_Yotsuba.rpy:581
translate english yotsuba_m5_b07e6c17:

    # narrador "Le dejé el cronómetro colgado de la valla, donde pudiera verlo."
    narrador "I left the stopwatch hanging on the fence, where she could see it."

# game/02_cap1_Yotsuba.rpy:583
translate english yotsuba_m5_3cf82960:

    # mc_pensamiento "Pensé en decirle algo antes de irme."
    mc_pensamiento "I thought about saying something before I left."

# game/02_cap1_Yotsuba.rpy:587
translate english yotsuba_m5_68e602f9:

    # narrador "Pero cuando llegué, ella ya había vuelto a la pista."
    narrador "But by the time I got there, she was already back on the track."

# game/02_cap1_Yotsuba.rpy:589
translate english yotsuba_m5_22890f61:

    # narrador "Sin esperar a que yo terminara de irme."
    narrador "Without waiting for me to finish leaving."

# game/02_cap1_Yotsuba.rpy:591
translate english yotsuba_m5_aa624164:

    # mc_pensamiento "No se despidió."
    mc_pensamiento "She didn't say goodbye."

# game/02_cap1_Yotsuba.rpy:593
translate english yotsuba_m5_e86f7895:

    # mc_pensamiento "Solo volvió a correr, como si la conversación nunca hubiera interrumpido nada."
    mc_pensamiento "She just went back to running, as if the conversation had never interrupted anything."

# game/02_cap1_Yotsuba.rpy:595
translate english yotsuba_m5_86bd8720:

    # mc_pensamiento "Un 'nos vemos mañana'. Hoy ninguno de los dos lo dijo."
    mc_pensamiento "A \"see you tomorrow.\" Neither of us said it today."

# game/02_cap1_Yotsuba.rpy:614
translate english yotsuba_m6_1fd38f78:

    # mc_pensamiento "Una de cinco. Y esta no paraba de correr."
    mc_pensamiento "One of five. And this one never stopped running."

# game/02_cap1_Yotsuba.rpy:616
translate english yotsuba_m6_cf4bd26f:

    # mc_pensamiento "Solo quedan [tiempo_restante!t]."
    mc_pensamiento "Only [tiempo_restante!t] left."

# game/02_cap1_Yotsuba.rpy:620
translate english yotsuba_m6_e3386449:

    # mc_pensamiento "Me preguntó si era verdad o si solo era bueno animando a la gente."
    mc_pensamiento "She asked me if it was true, or if I'm just good at cheering people up."

# game/02_cap1_Yotsuba.rpy:622
translate english yotsuba_m6_bff1569b:

    # mc_pensamiento "La respuesta honesta es que no lo sé todavía."
    mc_pensamiento "The honest answer is I don't know yet."

# game/02_cap1_Yotsuba.rpy:624
translate english yotsuba_m6_8273d2fa:

    # mc_pensamiento "Pero su punto de partida no era cero."
    mc_pensamiento "But her starting point wasn't zero."

# game/02_cap1_Yotsuba.rpy:626
translate english yotsuba_m6_c978604d:

    # mc_pensamiento "De eso sí estoy seguro."
    mc_pensamiento "That much I'm sure of."

# game/02_cap1_Yotsuba.rpy:630
translate english yotsuba_m6_c3b9806e:

    # mc_pensamiento "Un minuto con diecisiete. Un minuto con catorce en la última."
    mc_pensamiento "One minute seventeen. One fourteen on the last lap."

# game/02_cap1_Yotsuba.rpy:632
translate english yotsuba_m6_76f373e9:

    # mc_pensamiento "No sé si mejoró por el cronómetro o a pesar de él."
    mc_pensamiento "I don't know if she improved because of the stopwatch or in spite of it."

# game/02_cap1_Yotsuba.rpy:634
translate english yotsuba_m6_24615bf0:

    # mc_pensamiento "Tampoco sé qué iba a decir antes de que se lo diera."
    mc_pensamiento "I also don't know what I was going to say before she handed it to me."

# game/02_cap1_Yotsuba.rpy:636
translate english yotsuba_m6_058f5934:

    # mc_pensamiento "Pero le puso tanta energía al asunto que ya no hubo forma de volver atrás."
    mc_pensamiento "But she put so much energy into it that there was no going back."

# game/02_cap1_Yotsuba.rpy:640
translate english yotsuba_m6_3b5d9122:

    # mc_pensamiento "Dejó de contar en voz alta después de lo que dije."
    mc_pensamiento "She stopped counting out loud after what I said."

# game/02_cap1_Yotsuba.rpy:642
translate english yotsuba_m6_3e2ab6d0:

    # mc_pensamiento "Puede que no importe."
    mc_pensamiento "Maybe it doesn't matter."

# game/02_cap1_Yotsuba.rpy:644
translate english yotsuba_m6_d08dc6af:

    # mc_pensamiento "Tal vez ese método suyo no servía para nada y mi consejo fue el correcto."
    mc_pensamiento "Maybe that method of hers was useless and my advice was right."

# game/02_cap1_Yotsuba.rpy:646
translate english yotsuba_m6_456dc114:

    # mc_pensamiento "O tal vez le acabo de confirmar la única cosa de la que nadie debería haberla convencido nunca."
    mc_pensamiento "Or maybe I just confirmed the one thing nobody should ever have convinced her of."

translate english strings:

    # game/02_cap1_Yotsuba.rpy:325
    old "¿Qué le dirás a Yotsuba?"
    new "What will you say to Yotsuba?"

    # game/02_cap1_Yotsuba.rpy:325
    old "Te ofrece el cronómetro. Lo que acaba de decir sigue ahí."
    new "She holds out the stopwatch. What she just said hangs in the air."

    # game/02_cap1_Yotsuba.rpy:331
    old "No tomar el cronómetro todavía. Volver a lo que dijo."
    new "Don't take it yet. Go back to what she said."

    # game/02_cap1_Yotsuba.rpy:334
    old "Claro, dame el cronómetro."
    new "Sure, give me the stopwatch."

    # game/02_cap1_Yotsuba.rpy:337
    old "Si correr es lo tuyo, concéntrate en eso."
    new "If running is your thing, focus on that."

