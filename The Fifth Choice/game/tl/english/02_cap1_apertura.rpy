# game/02_cap1_apertura.rpy:37
translate english cap1_apertura_2a640927:

    # mc_pensamiento "Dormí cuatro horas. No por estudiar, por primera vez en meses."
    mc_pensamiento "I slept four hours. Not from studying, for the first time in months."

# game/02_cap1_apertura.rpy:39
translate english cap1_apertura_9a0ac022:

    # mc_pensamiento "Me quedé mirando el techo repasando la escena entera."
    mc_pensamiento "I lay staring at the ceiling, replaying the whole scene."

# game/02_cap1_apertura.rpy:41
translate english cap1_apertura_5719ba63:

    # mc_pensamiento "Cinco caras idénticas y cinco formas distintas de decirme que sobro."
    mc_pensamiento "Five identical faces, five different ways of telling me I'm in the way."

# game/02_cap1_apertura.rpy:43
translate english cap1_apertura_981dafca:

    # mc_pensamiento "Y una palabra que no se me despegó en toda la noche."
    mc_pensamiento "And one word that wouldn't leave me all night."

# game/02_cap1_apertura.rpy:45
translate english cap1_apertura_313658da:

    # mc_pensamiento "Despedido."
    mc_pensamiento "Fired."

# game/02_cap1_apertura.rpy:49
translate english cap1_apertura_57b6efaf:

    # narrador "Llegué al instituto antes que casi nadie, como siempre. Esta vez no fue por costumbre."
    narrador "I got to school before almost anyone, as usual. This time it wasn't out of habit."

# game/02_cap1_apertura.rpy:51
translate english cap1_apertura_8f983d1a:

    # mc_pensamiento "Era el único sitio donde todavía sabía exactamente lo que estaba haciendo."
    mc_pensamiento "It was the only place where I still knew exactly what I was doing."

# game/02_cap1_apertura.rpy:56
translate english cap1_apertura_65e843f5:

    # narrador "Mi asiento estaba libre."
    narrador "My seat was free."

# game/02_cap1_apertura.rpy:61
translate english cap1_apertura_f7ab3171:

    # mc_pensamiento "Libre, y con el pupitre de al lado ocupado."
    mc_pensamiento "Free, with the desk next to it taken."

# game/02_cap1_apertura.rpy:63
translate english cap1_apertura_6edea804:

    # narrador "Itsuki tenía la mirada clavada en su cuaderno."
    narrador "Itsuki had her eyes glued to her notebook."

# game/02_cap1_apertura.rpy:65
translate english cap1_apertura_b47bd2ce:

    # narrador "Con una concentración que no le hacía falta a las siete y media de la mañana."
    narrador "With a concentration nobody needs at seven-thirty in the morning."

# game/02_cap1_apertura.rpy:67
translate english cap1_apertura_6bda9fa8:

    # mc_pensamiento "Me dejó el sitio a propósito."
    mc_pensamiento "She left me the spot on purpose."

# game/02_cap1_apertura.rpy:69
translate english cap1_apertura_f54fdc3c:

    # mc_pensamiento "Eso también era un mensaje."
    mc_pensamiento "That was a message too."

# game/02_cap1_apertura.rpy:79
translate english cap1_apertura_79453dac:

    # mc "Buenos días."
    mc "Good morning."

# game/02_cap1_apertura.rpy:81
translate english cap1_apertura_97eba050:

    # itsuki "..."
    itsuki "..."

# game/02_cap1_apertura.rpy:83
translate english cap1_apertura_d7498e83:

    # mc "Voy a ir esta tarde."
    mc "I'm going over this afternoon."

# game/02_cap1_apertura.rpy:85
translate english cap1_apertura_b1d07282:

    # itsuki "Ya sé que vas a ir."
    itsuki "I know you are."

# game/02_cap1_apertura.rpy:87
translate english cap1_apertura_7a61b417:

    # itsuki "Mi padre nos dio tu horario anoche."
    itsuki "My father gave us your schedule last night."

# game/02_cap1_apertura.rpy:89
translate english cap1_apertura_d028c2f2:

    # mc "Solo lo estoy avisando."
    mc "I'm just letting you know."

# game/02_cap1_apertura.rpy:91
translate english cap1_apertura_7a272791:

    # itsuki "Avisa lo que quieras. Yo no pienso estudiar contigo."
    itsuki "Let me know all you like. I'm not studying with you."

# game/02_cap1_apertura.rpy:93
translate english cap1_apertura_e38aef3d:

    # mc_pensamiento "(...)"
    mc_pensamiento "(...)"

# game/02_cap1_apertura.rpy:98
translate english cap1_apertura_94dd5c10:

    # mc_pensamiento "Ni me mira. ¿Y yo qué hago con eso?" nointeract
    mc_pensamiento "She won't even look at me. What am I supposed to do with that?" nointeract

# game/02_cap1_apertura.rpy:102
translate english cap1_apertura_b5bfe03e:

    # mc_pensamiento "¡Bien!"
    mc_pensamiento "Fine!"

# game/02_cap1_apertura.rpy:104
translate english cap1_apertura_d9e7ef67:

    # mc_pensamiento "Si quiere jugar a las distancias, a mí me sobra paciencia para eso."
    mc_pensamiento "If she wants to play the distance game, I have patience to spare."

# game/02_cap1_apertura.rpy:106
translate english cap1_apertura_7c77ebdc:

    # mc_pensamiento "No es que necesite su compañía para nada."
    mc_pensamiento "It's not like I need her company for anything."

# game/02_cap1_apertura.rpy:110
translate english cap1_apertura_951ea2ca:

    # mc_pensamiento "Es raro."
    mc_pensamiento "It's strange."

# game/02_cap1_apertura.rpy:112
translate english cap1_apertura_1a808fe6:

    # mc_pensamiento "Ayer gritaba que me odiaba y hoy ni siquiera se molesta en mirarme."
    mc_pensamiento "Yesterday she was shouting that she hated me, and today she doesn't even bother to look at me."

# game/02_cap1_apertura.rpy:114
translate english cap1_apertura_6c1a75a1:

    # mc_pensamiento "Como si ya hubiera decidido que no valgo ni para enojarse."
    mc_pensamiento "As if she'd already decided I'm not even worth getting angry at."

# game/02_cap1_apertura.rpy:118
translate english cap1_apertura_4fd2287f:

    # mc_pensamiento "Mejor así, la verdad."
    mc_pensamiento "Better this way, honestly."

# game/02_cap1_apertura.rpy:120
translate english cap1_apertura_9c738aaf:

    # mc_pensamiento "Menos ruido, menos discusiones."
    mc_pensamiento "Less noise, fewer arguments."

# game/02_cap1_apertura.rpy:122
translate english cap1_apertura_1007a7d0:

    # mc_pensamiento "(Aunque el silencio, viniendo de ella, se siente casi más pesado que los gritos.)"
    mc_pensamiento "(Though her silence feels almost heavier than the shouting.)"

# game/02_cap1_apertura.rpy:128
translate english cap1_apertura_a9650fbf:

    # narrador "Volvió a su cuaderno con un gesto seco y no dijo una palabra más en toda la mañana."
    narrador "She went back to her notebook with a curt gesture and didn't say another word all morning."

# game/02_cap1_apertura.rpy:130
translate english cap1_apertura_fb11f01c:

    # mc_pensamiento "Ahí estaba lo verdaderamente incómodo del asunto."
    mc_pensamiento "That was the truly uncomfortable part."

# game/02_cap1_apertura.rpy:132
translate english cap1_apertura_bd9482c7:

    # mc_pensamiento "No era que me odiara."
    mc_pensamiento "It wasn't that she hated me."

# game/02_cap1_apertura.rpy:134
translate english cap1_apertura_b12413a1:

    # mc_pensamiento "Era que iba a odiarme desde las ocho hasta las tres."
    mc_pensamiento "It was that she was going to hate me from eight to three."

# game/02_cap1_apertura.rpy:136
translate english cap1_apertura_357f7df0:

    # mc_pensamiento "Y después, desde las cuatro hasta que me fuera de su casa."
    mc_pensamiento "And then, from four until I left her house."

# game/02_cap1_apertura.rpy:138
translate english cap1_apertura_1879b1e7:

    # mc_pensamiento "Sin pausa. Sin cambio de escenario."
    mc_pensamiento "No breaks. No change of scenery."

# game/02_cap1_apertura.rpy:140
translate english cap1_apertura_2095459a:

    # mc_pensamiento "Jornada completa."
    mc_pensamiento "Full-time."

# game/02_cap1_apertura.rpy:158
translate english cap1_apertura_f6ffc7f2:

    # narrador "Toqué a las cuatro en punto."
    narrador "I knocked at four on the dot."

# game/02_cap1_apertura.rpy:162
translate english cap1_apertura_11a15e52:

    # narrador "Me abrió Ichika, otra vez, con la misma sonrisa de la primera vez."
    narrador "Ichika opened the door, again, with the same smile as the first time."

# game/02_cap1_apertura.rpy:164
translate english cap1_apertura_da365e2c:

    # mc "¿Qué tal la audición?"
    mc "How did the audition go?"

# game/02_cap1_apertura.rpy:166
translate english cap1_apertura_a2d798e6:

    # ichika "¡Un éxito rotundo!"
    ichika "A resounding success!"

# game/02_cap1_apertura.rpy:168
translate english cap1_apertura_68d6d623:

    # narrador "No dijo de qué. Y se apartó de la puerta antes de que pudiera preguntar."
    narrador "She didn't say at what. And she stepped away from the door before I could ask."

# game/02_cap1_apertura.rpy:170
translate english cap1_apertura_0a6e2a56:

    # mc_pensamiento "Esta vez venía preparado."
    mc_pensamiento "This time I came prepared."

# game/02_cap1_apertura.rpy:172
translate english cap1_apertura_41fb75b0:

    # mc_pensamiento "Cinco cuadernos, un temario dividido por materias y ninguna expectativa."
    mc_pensamiento "Five notebooks, a syllabus split by subject, and zero expectations."

# game/02_cap1_apertura.rpy:174
translate english cap1_apertura_aef8ebaf:

    # mc_pensamiento "Lo que no esperaba era lo que encontré al entrar."
    mc_pensamiento "What I didn't expect was what I found when I walked in."

# game/02_cap1_apertura.rpy:181
translate english cap1_apertura_ec22ccc0:

    # narrador "Las cinco estaban sentadas en fila frente a la mesa."
    narrador "All five were sitting in a row in front of the table."

# game/02_cap1_apertura.rpy:183
translate english cap1_apertura_41b18aee:

    # narrador "Rectas. En silencio. Con los cuadernos abiertos."
    narrador "Straight-backed. Silent. Notebooks open."

# game/02_cap1_apertura.rpy:185
translate english cap1_apertura_6cd18920:

    # mc_pensamiento "..."
    mc_pensamiento "..."

# game/02_cap1_apertura.rpy:187
translate english cap1_apertura_6e80f4d9:

    # mc_pensamiento "Esto está mal."
    mc_pensamiento "This is wrong."

# game/02_cap1_apertura.rpy:189
translate english cap1_apertura_e40a17cf:

    # yotsuba "¡Buenas tardes, profesor!"
    yotsuba "Good afternoon, teacher!"

# game/02_cap1_apertura.rpy:191
translate english cap1_apertura_ad2b9460:

    # mc "No soy profesor."
    mc "I'm not a teacher."

# game/02_cap1_apertura.rpy:193
translate english cap1_apertura_3c0e8731:

    # ichika "Hoy sí. Hoy vamos a portarnos bien."
    ichika "Today you are. Today we're going to behave."

# game/02_cap1_apertura.rpy:195
translate english cap1_apertura_94e6dbc9:

    # ichika "Que conste."
    ichika "For the record."

# game/02_cap1_apertura.rpy:197
translate english cap1_apertura_a1375f3c:

    # mc_pensamiento "Ayer tuve que arrastrarlas una por una para que se sentaran."
    mc_pensamiento "Yesterday I had to drag them to the table one by one."

# game/02_cap1_apertura.rpy:199
translate english cap1_apertura_ea011162:

    # mc_pensamiento "Hoy me estaban esperando."
    mc_pensamiento "Today they were waiting for me."

# game/02_cap1_apertura.rpy:201
translate english cap1_apertura_ffc2bded:

    # mc_pensamiento "Nadie cambia tanto en veinticuatro horas. Nadie."
    mc_pensamiento "Nobody changes that much in twenty-four hours. Nobody."

# game/02_cap1_apertura.rpy:203
translate english cap1_apertura_0590fa32:

    # nino "¿Vas a quedarte parado o vas a dar la clase?"
    nino "Are you going to stand there, or are you going to teach?"

# game/02_cap1_apertura.rpy:205
translate english cap1_apertura_e2c26f82:

    # mc "Depende. ¿Qué es esto?"
    mc "Depends. What is this?"

# game/02_cap1_apertura.rpy:207
translate english cap1_apertura_4de9a148:

    # nino "Colaboración."
    nino "Cooperation."

# game/02_cap1_apertura.rpy:209
translate english cap1_apertura_cb1d3602:

    # mc "Ayer me dijiste que no ibas a gastar un solo segundo en esto."
    mc "Yesterday you told me you wouldn't spend a single second on this."

# game/02_cap1_apertura.rpy:211
translate english cap1_apertura_f65526c4:

    # nino "Y hoy cambié de opinión."
    nino "And today I changed my mind."

# game/02_cap1_apertura.rpy:213
translate english cap1_apertura_4454aabf:

    # nino "¿Algún problema?"
    nino "Is that a problem?"

# game/02_cap1_apertura.rpy:215
translate english cap1_apertura_2dd37f5d:

    # narrador "Lo dijo sin apartar la mirada. Ninguna de las otras cuatro se movió."
    narrador "She said it without looking away. None of the other four moved."

# game/02_cap1_apertura.rpy:217
translate english cap1_apertura_93639567:

    # mc_pensamiento "Ninguna de ellas está aquí porque quiera estar."
    mc_pensamiento "None of them is here because they want to be."

# game/02_cap1_apertura.rpy:219
translate english cap1_apertura_224ba977:

    # mc_pensamiento "Están aquí porque Nino les dijo que se sentaran."
    mc_pensamiento "They're here because Nino told them to sit down."

# game/02_cap1_apertura.rpy:221
translate english cap1_apertura_b5bfe03e_1:

    # mc_pensamiento "¡Bien!"
    mc_pensamiento "Fine!"

# game/02_cap1_apertura.rpy:223
translate english cap1_apertura_cb5b73d9:

    # mc_pensamiento "Si quieren jugar a esto, juguemos."
    mc_pensamiento "If they want to play this game, let's play."

# game/02_cap1_apertura.rpy:225
translate english cap1_apertura_b14323fe:

    # mc "Página doce. Empezamos por lo más simple del temario."
    mc "Page twelve. We start with the simplest part of the syllabus."

# game/02_cap1_apertura.rpy:230
translate english cap1_apertura_3bc14e31:

    # narrador "Repartí el ejercicio."
    narrador "I handed out the exercise."

# game/02_cap1_apertura.rpy:232
translate english cap1_apertura_bed8b6f8:

    # narrador "Cinco copias idénticas, seis preguntas cada una, nivel de primer curso."
    narrador "Five identical copies, six questions each, first-year level."

# game/02_cap1_apertura.rpy:234
translate english cap1_apertura_5541806f:

    # mc "Les tomará unos diez minutos."
    mc "It should take you about ten minutes."

# game/02_cap1_apertura.rpy:236
translate english cap1_apertura_a27b9683:

    # narrador "No hizo falta esperar los diez minutos."
    narrador "There was no need to wait ten minutes."

# game/02_cap1_apertura.rpy:238
translate english cap1_apertura_c844a511:

    # narrador "En solo cuatro minutos ya me habían devuelto las cinco hojas resueltas sobre la mesa."
    narrador "In just four minutes, all five sheets were back on the table, completed."

# game/02_cap1_apertura.rpy:240
translate english cap1_apertura_99991902:

    # mc_pensamiento "Eso también estaba mal."
    mc_pensamiento "That was wrong too."

# game/02_cap1_apertura.rpy:245
translate english cap1_apertura_33a69617:

    # narrador "Corregí la primera hoja. Seis de seis mal."
    narrador "I graded the first sheet. Six out of six wrong."

# game/02_cap1_apertura.rpy:247
translate english cap1_apertura_4eee37f5:

    # narrador "Corregí la segunda hoja. Seis de seis mal."
    narrador "I graded the second sheet. Six out of six wrong."

# game/02_cap1_apertura.rpy:249
translate english cap1_apertura_6cd18920_1:

    # mc_pensamiento "..."
    mc_pensamiento "..."

# game/02_cap1_apertura.rpy:251
translate english cap1_apertura_8fb494e1:

    # narrador "Las cinco hojas tenían exactamente las mismas seis respuestas equivocadas."
    narrador "All five sheets had exactly the same six wrong answers."

# game/02_cap1_apertura.rpy:253
translate english cap1_apertura_a6f09f1c:

    # narrador "Palabra por palabra."
    narrador "Word for word."

# game/02_cap1_apertura.rpy:255
translate english cap1_apertura_41b6c109:

    # mc_pensamiento "No es que no supieran hacerlo."
    mc_pensamiento "It's not that they didn't know how."

# game/02_cap1_apertura.rpy:257
translate english cap1_apertura_0da7f35c:

    # mc_pensamiento "Es que se pusieron de acuerdo en cómo hacerlo mal."
    mc_pensamiento "It's that they'd agreed on how to get it wrong."

# game/02_cap1_apertura.rpy:264
translate english cap1_apertura_b05e67f1:

    # mc "Nino."
    mc "Nino."

# game/02_cap1_apertura.rpy:269
translate english cap1_apertura_70ada058:

    # nino "¿Sí?"
    nino "Yes?"

# game/02_cap1_apertura.rpy:271
translate english cap1_apertura_c6b328eb:

    # mc "Coordinar cinco respuestas idénticas cuesta más trabajo que responder bien."
    mc "Coordinating five identical answers takes more work than answering correctly."

# game/02_cap1_apertura.rpy:273
translate english cap1_apertura_8f81fbe0:

    # nino "Qué observación tan interesante."
    nino "What an interesting observation."

# game/02_cap1_apertura.rpy:275
translate english cap1_apertura_934b2227:

    # mc "Es una observación minuiciosa."
    mc "It's a careful observation."

# game/02_cap1_apertura.rpy:277
translate english cap1_apertura_82d03f60:

    # mc "Si querían perder el tiempo, tenían formas más baratas."
    mc "If you wanted to waste time, there were cheaper ways."

# game/02_cap1_apertura.rpy:279
translate english cap1_apertura_1891dddd:

    # nino "Entonces tómalo como lo que es."
    nino "Then take it for what it is."

# game/02_cap1_apertura.rpy:281
translate english cap1_apertura_2de9050f:

    # nino "Cinco alumnas que no aprenden nada contigo, por escrito y por triplicado."
    nino "Five students who learn nothing from you, in writing and in triplicate."

# game/02_cap1_apertura.rpy:283
translate english cap1_apertura_cd3d4e6b:

    # nino "Mi padre va a leer esas hojas."
    nino "My father is going to read those sheets."

# game/02_cap1_apertura.rpy:285
translate english cap1_apertura_ea6f144d:

    # mc_pensamiento "Ahí estaba."
    mc_pensamiento "There it was."

# game/02_cap1_apertura.rpy:287
translate english cap1_apertura_737fdb67:

    # mc_pensamiento "No querían echarme a gritos. Querían mi carta de renuncia."
    mc_pensamiento "They didn't want to run me off by yelling. They wanted my resignation letter."

# game/02_cap1_apertura.rpy:289
translate english cap1_apertura_3e90f2ab:

    # mc "Vas a hacer que reprueben para que me despidan."
    mc "You're going to make them fail so I get fired."

# game/02_cap1_apertura.rpy:291
translate english cap1_apertura_942bbd38:

    # nino "Voy a hacer que quede claro lo que ya era obvio ayer."
    nino "I'm just making official what was obvious yesterday."

# game/02_cap1_apertura.rpy:293
translate english cap1_apertura_ac0f536b:

    # nino "El último duró cuatro días. Tú llevas uno."
    nino "The last one lasted four days. You've lasted one."

# game/02_cap1_apertura.rpy:302
translate english cap1_apertura_faa7ce1c:

    # yotsuba "Nino, eso no es justo. Él solo está—"
    yotsuba "Nino, that's not fair. He's just—"

# game/02_cap1_apertura.rpy:308
translate english cap1_apertura_e0b53ddf:

    # nino "Yotsuba."
    nino "Yotsuba."

# game/02_cap1_apertura.rpy:314
translate english cap1_apertura_5ce3baf5:

    # yotsuba "...No dije nada."
    yotsuba "...I didn't say anything."

# game/02_cap1_apertura.rpy:319
translate english cap1_apertura_7b4babe9:

    # mc_pensamiento "Iba a defenderme. Y se arrepintió a mitad de frase."
    mc_pensamiento "She was about to defend me. And changed her mind halfway through the sentence."

# game/02_cap1_apertura.rpy:321
translate english cap1_apertura_e699a3ea:

    # narrador "Se encogió en el sitio y se puso a alinear los bordes de su hoja con las dos manos, muy despacio, como si eso fuera una tarea."
    narrador "She shrank back and slowly squared the edges of her sheet with both hands, as if it were a task."

# game/02_cap1_apertura.rpy:324
translate english cap1_apertura_c5bb8959:

    # mc_pensamiento "Yotsuba no está de acuerdo con Nino."
    mc_pensamiento "Yotsuba doesn't agree with Nino."

# game/02_cap1_apertura.rpy:326
translate english cap1_apertura_f80a9f0c:

    # mc_pensamiento "Pero está obedeciéndola, que no es lo mismo."
    mc_pensamiento "But she's obeying her, which is not the same thing."

# game/02_cap1_apertura.rpy:332
translate english cap1_apertura_9da0659d:

    # ichika "Bueno, tampoco hay que dramatizar."
    ichika "Well, no need to be dramatic."

# game/02_cap1_apertura.rpy:334
translate english cap1_apertura_e537a7fe:

    # narrador "Lo dijo mirando a Yotsuba, no a mí. Yotsuba soltó el borde de la hoja."
    narrador "She said it looking at Yotsuba, not me. Yotsuba let go of the edge of the sheet."

# game/02_cap1_apertura.rpy:336
translate english cap1_apertura_25f05f5a:

    # ichika "Contestamos las seis. Nadie dijo que hubiera que acertarlas."
    ichika "We answered all six. Nobody said we had to get them right."

# game/02_cap1_apertura.rpy:338
translate english cap1_apertura_924b5be4:

    # mc "Contestaron las seis igual de mal."
    mc "You all answered the six equally wrong."

# game/02_cap1_apertura.rpy:340
translate english cap1_apertura_f306d8b1:

    # ichika "¿Coincidencia?"
    ichika "Coincidence?"

# game/02_cap1_apertura.rpy:342
translate english cap1_apertura_0c84646f:

    # ichika "Somos quintillizas, pensamos parecido."
    ichika "We're quintuplets, we think alike."

# game/02_cap1_apertura.rpy:344
translate english cap1_apertura_f4dd4d98:

    # mc_pensamiento "Mentía tan bien que casi daba gusto."
    mc_pensamiento "She lied so well it was almost a pleasure."

# game/02_cap1_apertura.rpy:349
translate english cap1_apertura_4066771f:

    # narrador "Cuando volví a levantar la vista, Ichika ya tenía los ojos cerrados."
    narrador "When I looked up again, Ichika already had her eyes closed."

# game/02_cap1_apertura.rpy:351
translate english cap1_apertura_7343a675:

    # narrador "La cabeza, apoyada en el respaldo."
    narrador "Her head resting against the backrest."

# game/02_cap1_apertura.rpy:353
translate english cap1_apertura_1e85788d:

    # mc_pensamiento "Y ahí se cayó la función."
    mc_pensamiento "And that's where the show fell apart."

# game/02_cap1_apertura.rpy:355
translate english cap1_apertura_62eb5936:

    # narrador "Miku no había levantado la vista de la mesa en todo el rato."
    narrador "Miku hadn't looked up from the table the whole time."

# game/02_cap1_apertura.rpy:357
translate english cap1_apertura_52c9ddf1:

    # narrador "Tenía los auriculares puestos y, esta vez, sonando."
    narrador "She had her headphones on and, this time, they were actually playing."

# game/02_cap1_apertura.rpy:359
translate english cap1_apertura_22634700:

    # narrador "Itsuki estaba con los brazos tensos y la cara torcida hacia la ventana."
    narrador "Itsuki sat with tense arms and her face turned toward the window."

# game/02_cap1_apertura.rpy:361
translate english cap1_apertura_4453415a:

    # mc_pensamiento "No participó en el plan, pero tampoco pensaba ayudarme."
    mc_pensamiento "She hadn't joined the plan, but she wasn't going to help me either."

# game/02_cap1_apertura.rpy:363
translate english cap1_apertura_351131e9:

    # narrador "Junté las cinco hojas y las dejé en una pila."
    narrador "I gathered the five sheets and set them in a pile."

# game/02_cap1_apertura.rpy:365
translate english cap1_apertura_a74650f1:

    # mc "Última pregunta y me voy. La pregunta siete no está en la hoja."
    mc "Last question and I'm going. Question seven isn't on the sheet."

# game/02_cap1_apertura.rpy:367
translate english cap1_apertura_f04531b1:

    # mc "Veamos qué tal les va en inglés."
    mc "Let's see how you do in English."

# game/02_cap1_apertura.rpy:369
translate english cap1_apertura_b8228933:

    # narrador "Empecé a leerles una oración."
    narrador "I started reading them a sentence."

# game/02_cap1_apertura.rpy:371
translate english cap1_apertura_007a7276:

    # mc "«He didn't want to go, but he had to.»"
    mc "\"He didn't want to go, but he had to.\""

# game/02_cap1_apertura.rpy:373
translate english cap1_apertura_577c22c6:

    # narrador "Lo leí a propósito, con el peor acento que pude."
    narrador "I read it on purpose, with the worst accent I could manage."

# game/02_cap1_apertura.rpy:381
translate english cap1_apertura_ecafe99c:

    # nino "Had to. No «jad tu». Se pega, no se separa."
    nino "Had to. Not \"hah-doh too.\" It links together, you don't chop it up."

# game/02_cap1_apertura.rpy:383
translate english cap1_apertura_8c852206:

    # narrador "Se quedó en silencio."
    narrador "She went silent."

# game/02_cap1_apertura.rpy:388
translate english cap1_apertura_5d06c2b7:

    # nino "..."
    nino "..."

# game/02_cap1_apertura.rpy:390
translate english cap1_apertura_b2516466:

    # mc "Gracias."
    mc "Thanks."

# game/02_cap1_apertura.rpy:392
translate english cap1_apertura_1cfec1b2:

    # nino "¡No te he corregido a ti! ¡Es que dolía escucharlo!"
    nino "I wasn't correcting you! It just hurt to listen to!"

# game/02_cap1_apertura.rpy:394
translate english cap1_apertura_6a1f62a4:

    # mc "Claro."
    mc "Sure."

# game/02_cap1_apertura.rpy:396
translate english cap1_apertura_7883848b:

    # nino "¡Se acabó! ¡Fuera de mi casa!"
    nino "That's it! Get out of my house!"

# game/02_cap1_apertura.rpy:405
translate english cap1_apertura_b08282e8:

    # narrador "Se levantó y se encerró de un portazo, igual que el día anterior, solo que esta vez se llevó su cuaderno con ella."
    narrador "She got up and slammed herself into her room like yesterday, except this time she took her notebook."

# game/02_cap1_apertura.rpy:408
translate english cap1_apertura_73b937d8:

    # narrador "Las otras tres tardaron menos de un minuto en desaparecer detrás de ella."
    narrador "The other three took less than a minute to disappear behind her."

# game/02_cap1_apertura.rpy:410
translate english cap1_apertura_9c28c1da:

    # narrador "Miku fue la última."
    narrador "Miku was the last."

# game/02_cap1_apertura.rpy:412
translate english cap1_apertura_07be4aeb:

    # narrador "Se detuvo a mitad del pasillo, de espaldas, con el libro apretado contra el pecho."
    narrador "She stopped halfway down the hallway, her back to me, the book pressed to her chest."

# game/02_cap1_apertura.rpy:417
translate english cap1_apertura_847e5e0a:

    # miku "...No fue idea mía."
    miku "...It wasn't my idea."

# game/02_cap1_apertura.rpy:419
translate english cap1_apertura_29acebe4:

    # narrador "Lo dijo tan bajo que tuve que reconstruirlo un segundo después, cuando ya no estaba."
    narrador "She said it so quietly I had to piece it together a second later, once she was gone."

# game/02_cap1_apertura.rpy:421
translate english cap1_apertura_94e38a52:

    # narrador "Porque en cuanto lo dijo, se dio cuenta de que lo había dicho."
    narrador "Because the moment she said it, she realized she'd said it."

# game/02_cap1_apertura.rpy:423
translate english cap1_apertura_02210516:

    # miku "...Olvídalo. Perdón."
    miku "...Forget it. Sorry."

# game/02_cap1_apertura.rpy:428
translate english cap1_apertura_7d818ebb:

    # mc_pensamiento "Segunda vez que habla sin querer. La primera se escondió detrás del libro."
    mc_pensamiento "Second time she's spoken without meaning to. The first time she hid behind the book."

# game/02_cap1_apertura.rpy:430
translate english cap1_apertura_4dd09698:

    # mc_pensamiento "Esta vez, además, pidió perdón."
    mc_pensamiento "This time, she also apologized."

# game/02_cap1_apertura.rpy:432
translate english cap1_apertura_3bb019af:

    # mc_pensamiento "Nadie se disculpa por decir algo cierto, a menos que le hayan enseñado que decirlo cuesta."
    mc_pensamiento "Nobody apologizes for saying something true, unless they've learned that saying it has a cost."

# game/02_cap1_apertura.rpy:434
translate english cap1_apertura_d2fb33a5:

    # mc_pensamiento "Segundo día. Segundo fracaso."
    mc_pensamiento "Second day. Second failure."

# game/02_cap1_apertura.rpy:436
translate english cap1_apertura_e9b64b81:

    # mc_pensamiento "Pero por primera vez me llevaba algo a casa."
    mc_pensamiento "But for the first time, I was taking something home."

# game/02_cap1_apertura.rpy:444
translate english cap1_apertura_1a2fc047:

    # narrador "Estaba recogiendo mis cosas cuando la puerta del fondo se abrió."
    narrador "I was packing my things when the door at the back opened."

# game/02_cap1_apertura.rpy:451
translate english cap1_apertura_985a1e1e:

    # maruo "Vi las hojas."
    maruo "I saw the sheets."

# game/02_cap1_apertura.rpy:453
translate english cap1_apertura_29b09b65:

    # mc_pensamiento "Rápido. Muy rápido."
    mc_pensamiento "Fast. Very fast."

# game/02_cap1_apertura.rpy:455
translate english cap1_apertura_d6807f38:

    # maruo "Seis errores idénticos por cinco."
    maruo "Six identical mistakes times five."

# game/02_cap1_apertura.rpy:457
translate english cap1_apertura_9e53620a:

    # maruo "Supongo que no hace falta que te explique lo que significa."
    maruo "I assume I need not explain what that means."

# game/02_cap1_apertura.rpy:459
translate english cap1_apertura_485a264e:

    # mc "Sí, no hace falta."
    mc "No, you don't need to."

# game/02_cap1_apertura.rpy:461
translate english cap1_apertura_2ddbc561:

    # maruo "¿Y bien?"
    maruo "And so?"

# game/02_cap1_apertura.rpy:463
translate english cap1_apertura_f8ee9e82:

    # mc "Significa que son capaces de coordinar cinco respuestas iguales en cuatro minutos."
    mc "It means they can coordinate five identical answers in four minutes."

# game/02_cap1_apertura.rpy:465
translate english cap1_apertura_6ea26ecb:

    # mc "Eso no lo hace alguien que no entiende el ejercicio."
    mc "That's not something someone who doesn't understand the exercise can do."

# game/02_cap1_apertura.rpy:467
translate english cap1_apertura_0f17b80c:

    # narrador "Me miró un momento más largo de lo que me había mirado el día anterior."
    narrador "He looked at me a moment longer than he had the day before."

# game/02_cap1_apertura.rpy:469
translate english cap1_apertura_394e1530:

    # maruo "Los exámenes son en un mes."
    maruo "The exams are in a month."

# game/02_cap1_apertura.rpy:471
translate english cap1_apertura_ae2333fd:

    # maruo "Cinco asignaturas. Las cinco tienen que aprobarlas todas."
    maruo "Five subjects. All five of them must pass every one."

# game/02_cap1_apertura.rpy:473
translate english cap1_apertura_0a947382:

    # mc "¿Y si una sola reprueba?"
    mc "And if just one fails?"

# game/02_cap1_apertura.rpy:475
translate english cap1_apertura_f1d8c19b:

    # maruo "Ya te lo dije ayer. No lo repito."
    maruo "I told you yesterday. I do not repeat myself."

# game/02_cap1_apertura.rpy:479
translate english cap1_apertura_aa8f1143:

    # narrador "Se fue como se había ido el día anterior, sin subir la voz y sin dejar espacio para contestar."
    narrador "He left the way he had the day before: no raised voice, no room for a reply."

# game/02_cap1_apertura.rpy:481
translate english cap1_apertura_e7cb92b5:

    # mc_pensamiento "Un mes."
    mc_pensamiento "One month."

# game/02_cap1_apertura.rpy:483
translate english cap1_apertura_457ad5de:

    # mc_pensamiento "Treinta días para cinco alumnas que hoy se organizaron para reprobar."
    mc_pensamiento "Thirty days for five students who today organized themselves to fail."

# game/02_cap1_apertura.rpy:496
translate english cap1_apertura_f1966eb0:

    # narrador "Salí del edificio pasadas las siete. Fui directo a casa."
    narrador "I left the building after seven. I went straight home."

# game/02_cap1_apertura.rpy:503
translate english cap1_apertura_7b64568f:

    # narrador "La cena transcurrió casi en silencio, solo se escuchaba el sonido de los cubiertos."
    narrador "Dinner went by almost in silence, just the clink of silverware."

# game/02_cap1_apertura.rpy:508
translate english cap1_apertura_b7de8e94:

    # raiha "Hermanito, te noto más callado que de costumbre."
    raiha "Big brother, you seem quieter than usual."

# game/02_cap1_apertura.rpy:510
translate english cap1_apertura_2412ca7c:

    # mc "Solo estoy cansado."
    mc "I'm just tired."

# game/02_cap1_apertura.rpy:516
translate english cap1_apertura_b90b0b29:

    # isanari "¿Cansado, o el trabajo ya te está pasando factura?"
    isanari "Tired, or is the job already taking its toll?"

# game/02_cap1_apertura.rpy:518
translate english cap1_apertura_265e5ae8:

    # mc "Un poco de las dos cosas."
    mc "A bit of both."

# game/02_cap1_apertura.rpy:520
translate english cap1_apertura_d6871d44:

    # isanari "¿Qué tal el segundo día con esas alumnas?"
    isanari "How was the second day with those students?"

# game/02_cap1_apertura.rpy:525
translate english cap1_apertura_ff6c12d7:

    # mc_pensamiento "¿Cuánto les cuento?" nointeract
    mc_pensamiento "How much do I tell them?" nointeract

# game/02_cap1_apertura.rpy:529
translate english cap1_apertura_392a4c62:

    # mc "Sinceramente... hoy fue peor que ayer."
    mc "Honestly... today was worse than yesterday."

# game/02_cap1_apertura.rpy:531
translate english cap1_apertura_60225a7e:

    # mc "Se pusieron de acuerdo para responder mal a propósito."
    mc "They agreed to give wrong answers on purpose."

# game/02_cap1_apertura.rpy:537
translate english cap1_apertura_65425eaf:

    # raiha "¡Eso es horrible! ¿Por qué harían algo así?"
    raiha "That's awful! Why would they do something like that?"

# game/02_cap1_apertura.rpy:539
translate english cap1_apertura_d92d1190:

    # mc "Todavía no lo sé. Pero pienso averiguarlo."
    mc "I don't know yet. But I plan to find out."

# game/02_cap1_apertura.rpy:545
translate english cap1_apertura_04ff9120:

    # isanari "Cinco cabezas puestas de acuerdo contra una... suena a un problema serio."
    isanari "Five of them against you... sounds like a serious problem."

# game/02_cap1_apertura.rpy:547
translate english cap1_apertura_5776ad29:

    # isanari "Me recuerda a mí en el instituto."
    isanari "Reminds me of me in high school."

# game/02_cap1_apertura.rpy:549
translate english cap1_apertura_8fc4a755:

    # isanari "Solo que yo era uno contra todos los profesores."
    isanari "Except I was one against all the teachers."

# game/02_cap1_apertura.rpy:551
translate english cap1_apertura_5d1e4b1d:

    # mc "No ayudas."
    mc "You're not helping."

# game/02_cap1_apertura.rpy:555
translate english cap1_apertura_1f75e8a9:

    # mc "Va bien. Dentro de lo que cabe esperar de un segundo día."
    mc "It's going fine. As fine as you can expect from a second day."

# game/02_cap1_apertura.rpy:557
translate english cap1_apertura_e7a49f72:

    # isanari "Ya veo. No sonaste muy convencido al decirlo."
    isanari "I see. You didn't sound very convinced saying it."

# game/02_cap1_apertura.rpy:559
translate english cap1_apertura_ef219105:

    # mc "Es solo cansancio, ya te dije."
    mc "It's just tiredness, I told you."

# game/02_cap1_apertura.rpy:565
translate english cap1_apertura_67ed0f99:

    # raiha "¡A mí no me engañas! ¡Se te nota en la cara que algo pasó!"
    raiha "You can't fool me! It's written all over your face that something happened!"

# game/02_cap1_apertura.rpy:569
translate english cap1_apertura_962da9d7:

    # mc "¿Podemos hablar de otra cosa?"
    mc "Can we talk about something else?"

# game/02_cap1_apertura.rpy:571
translate english cap1_apertura_110d3457:

    # mc "No quiero pensar en eso ahora mismo."
    mc "I don't want to think about it right now."

# game/02_cap1_apertura.rpy:573
translate english cap1_apertura_ed1a9ad3:

    # isanari "Como quieras, [mc]. No voy a insistir."
    isanari "Whatever you like, [mc]. I won't push."

# game/02_cap1_apertura.rpy:579
translate english cap1_apertura_a4a22747:

    # raiha "¡Yo sí insisto un poquito! Pero está bien, lo dejo por hoy."
    raiha "I'll push a little! But fine, I'll let it go for today."

# game/02_cap1_apertura.rpy:586
translate english cap1_apertura_4db67c58:

    # isanari "Solo recuerda que un mes no es mucho tiempo."
    isanari "Just remember, a month isn't much time."

# game/02_cap1_apertura.rpy:588
translate english cap1_apertura_caf46305:

    # isanari "Y que le di mi palabra a Maruo."
    isanari "And that I gave Maruo my word."

# game/02_cap1_apertura.rpy:590
translate english cap1_apertura_85a5a5c8:

    # mc "Lo sé. No hace falta que me lo recuerdes."
    mc "I know. You don't have to remind me."

# game/02_cap1_apertura.rpy:592
translate english cap1_apertura_569ae05b:

    # isanari "Tómalo como otro examen sorpresa."
    isanari "Think of it as another pop quiz."

# game/02_cap1_apertura.rpy:594
translate english cap1_apertura_df102e71:

    # mc_pensamiento "Otra vez con esa frase..."
    mc_pensamiento "That line again..."

# game/02_cap1_apertura.rpy:596
translate english cap1_apertura_b4ff2ac7:

    # mc_pensamiento "Aunque esta vez tiene más razón de la que me gustaría admitir."
    mc_pensamiento "Though this time it has more truth to it than I'd like to admit."

# game/02_cap1_apertura.rpy:598
translate english cap1_apertura_93d7d23b:

    # narrador "Terminada la cena, subí a mi habitación con las cinco hojas bajo el brazo."
    narrador "After dinner, I went up to my room with the five sheets under my arm."

# game/02_cap1_apertura.rpy:616
translate english cap1_apertura_8e22470c:

    # narrador "Puse las cinco hojas sobre el escritorio y las dejé ahí un buen rato sin tocarlas."
    narrador "I laid the five sheets on the desk and left them there a good while without touching them."

# game/02_cap1_apertura.rpy:618
translate english cap1_apertura_0ac2ca61:

    # mc_pensamiento "Ayer pensé que el problema era que no querían estudiar."
    mc_pensamiento "Yesterday I thought the problem was that they didn't want to study."

# game/02_cap1_apertura.rpy:620
translate english cap1_apertura_b7c23c57:

    # mc_pensamiento "Hoy sé que el problema es otro."
    mc_pensamiento "Today I know the problem is something else."

# game/02_cap1_apertura.rpy:622
translate english cap1_apertura_3387dd17:

    # mc_pensamiento "No es que no puedan. Es que se defienden."
    mc_pensamiento "It's not that they can't. It's that they're defending themselves."

# game/02_cap1_apertura.rpy:624
translate english cap1_apertura_342d9666:

    # mc_pensamiento "Y se defienden juntas."
    mc_pensamiento "And they defend themselves together."

# game/02_cap1_apertura.rpy:634
translate english cap1_apertura_478b6054:

    # raiha "Hermanito, llevas media hora mirando unos papeles en blanco."
    raiha "Big brother, you've been staring at some blank papers for half an hour."

# game/02_cap1_apertura.rpy:636
translate english cap1_apertura_3877ce2b:

    # mc "No están en blanco."
    mc "They're not blank."

# game/02_cap1_apertura.rpy:638
translate english cap1_apertura_7848a04c:

    # raiha "Están llenos de tachones. ¡Eso es peor!"
    raiha "They're full of cross-outs. That's worse!"

# game/02_cap1_apertura.rpy:640
translate english cap1_apertura_b974f49d:

    # mc "Gracias por el ánimo."
    mc "Thanks for the encouragement."

# game/02_cap1_apertura.rpy:645
translate english cap1_apertura_df1ba7ee:

    # raiha "¡Yo solo digo lo que veo!"
    raiha "I'm just saying what I see!"

# game/02_cap1_apertura.rpy:647
translate english cap1_apertura_c92bead0:

    # raiha "¿Son de las chicas a las que les das clase?"
    raiha "Are they from the girls you're teaching?"

# game/02_cap1_apertura.rpy:649
translate english cap1_apertura_494a6419:

    # mc "Sí."
    mc "Yes."

# game/02_cap1_apertura.rpy:651
translate english cap1_apertura_5b1a04c0:

    # raiha "¿Y son tontas?"
    raiha "And are they dumb?"

# game/02_cap1_apertura.rpy:653
translate english cap1_apertura_fca52711:

    # mc "No."
    mc "No."

# game/02_cap1_apertura.rpy:655
translate english cap1_apertura_969225d3:

    # narrador "Contesté antes de pensarlo, y me di cuenta de que lo decía en serio."
    narrador "I answered before thinking, and realized I meant it."

# game/02_cap1_apertura.rpy:657
translate english cap1_apertura_e239353d:

    # mc "No, no lo son."
    mc "No, they're not."

# game/02_cap1_apertura.rpy:659
translate english cap1_apertura_364cdd16:

    # raiha "Entonces no entiendo el problema."
    raiha "Then I don't see the problem."

# game/02_cap1_apertura.rpy:664
translate english cap1_apertura_05d982ff:

    # raiha "Bueno, da igual. ¡Mucha suerte, hermanito!"
    raiha "Well, whatever. Good luck, big brother!"

# game/02_cap1_apertura.rpy:666
translate english cap1_apertura_60fc6406:

    # raiha "¡Sé que puedes con las cinco a la vez!"
    raiha "I know you can handle all five at once!"

# game/02_cap1_apertura.rpy:668
translate english cap1_apertura_8675b762:

    # narrador "Lo dijo muy segura. Casi."
    narrador "She sounded very sure. Almost."

# game/02_cap1_apertura.rpy:678
translate english cap1_apertura_c43cfb07:

    # mc_pensamiento "Cinco a la vez... ese es justo el problema."
    mc_pensamiento "Five at once... that's exactly the problem."

# game/02_cap1_apertura.rpy:680
translate english cap1_apertura_242259a4:

    # mc "Raiha, espera un segundo."
    mc "Raiha, wait a second."

# game/02_cap1_apertura.rpy:685
translate english cap1_apertura_f05be151:

    # raiha "¿Mm? ¿Qué pasa?"
    raiha "Mm? What's up?"

# game/02_cap1_apertura.rpy:687
translate english cap1_apertura_12c02aa3:

    # mc "Tengo una duda algo rara."
    mc "I've got a slightly weird question."

# game/02_cap1_apertura.rpy:689
translate english cap1_apertura_c4e68d2b:

    # mc "Si tuvieras que adivinar dónde suele estar cada una de esas chicas después de estudiar."
    mc "If you had to guess where each of those girls usually hangs out after studying."

# game/02_cap1_apertura.rpy:691
translate english cap1_apertura_93e725a8:

    # mc "¿Por dónde empezarías?"
    mc "Where would you start?"

# game/02_cap1_apertura.rpy:693
translate english cap1_apertura_a51b9cd2:

    # raiha "¡Eso es fácil, hermanito!"
    raiha "That's easy, big brother!"

# game/02_cap1_apertura.rpy:695
translate english cap1_apertura_34ff6c6a:

    # raiha "Tú solo cuéntame cómo es cada una y yo te digo dónde la buscaría."
    raiha "Just tell me what each one is like and I'll tell you where I'd look for her."

# game/02_cap1_apertura.rpy:697
translate english cap1_apertura_72163378:

    # raiha "¡Como un juego de adivinanzas!"
    raiha "Like a guessing game!"

# game/02_cap1_apertura.rpy:699
translate english cap1_apertura_5c9f33bf:

    # mc_pensamiento "No pierdo nada con intentarlo."
    mc_pensamiento "Nothing to lose by trying."

# game/02_cap1_apertura.rpy:707
translate english cap1_adivinanza_hermanas_a90a2559:

    # mc_pensamiento "¿De cuál le hablo ahora?" nointeract
    mc_pensamiento "Who do I tell her about now?" nointeract

# game/02_cap1_apertura.rpy:713
translate english cap1_adivinanza_hermanas_f04e14e5:

    # mc "Hay una que se llama {color=#C2185B}{b}Ichika{/b}{/color}."
    mc "There's one named {color=#C2185B}{b}Ichika{/b}{/color}."

# game/02_cap1_apertura.rpy:715
translate english cap1_adivinanza_hermanas_bde97b50:

    # mc "Es la primera hermana o hermana mayor de las cinco."
    mc "She's the first sister, the eldest of the five."

# game/02_cap1_apertura.rpy:717
translate english cap1_adivinanza_hermanas_9879094d:

    # mc "Duerme en cualquier parte y dice que tiene audiciones."
    mc "She sleeps anywhere and says she has auditions."

# game/02_cap1_apertura.rpy:719
translate english cap1_adivinanza_hermanas_683bea97:

    # raiha "¡Ah, esa es fácil!"
    raiha "Oh, that one's easy!"

# game/02_cap1_apertura.rpy:721
translate english cap1_adivinanza_hermanas_82a974fd:

    # raiha "Si anda con audiciones, seguro se pasa las horas ensayando en la {color=#AD1457}{b}sala de ensayo{/b}{/color} del colegio."
    raiha "If she's got auditions, she's probably spending hours rehearsing in the school's {color=#AD1457}{b}rehearsal room{/b}{/color}."

# game/02_cap1_apertura.rpy:724
translate english cap1_adivinanza_hermanas_9fe6d749:

    # raiha "O simplemente durmiendo la siesta en el sofá más cercano."
    raiha "Or just napping on the nearest couch."

# game/02_cap1_apertura.rpy:726
translate english cap1_adivinanza_hermanas_7b9d7f37:

    # mc_pensamiento "Actuación... o pereza disfrazada de actuación."
    mc_pensamiento "Acting... or laziness disguised as acting."

# game/02_cap1_apertura.rpy:728
translate english cap1_adivinanza_hermanas_43f05dae:

    # mc "¡Sí! Probablemente ahí hace sus audiciones."
    mc "Yes! She probably does her auditions there."

# game/02_cap1_apertura.rpy:730
translate english cap1_adivinanza_hermanas_395e515e:

    # mc "Bien. Anotado."
    mc "Fine. Noted."

# game/02_cap1_apertura.rpy:736
translate english cap1_adivinanza_hermanas_a1072453:

    # mc "Hay una que se llama {color=#C39BD3}{b}Nino{/b}{/color}."
    mc "There's one named {color=#C39BD3}{b}Nino{/b}{/color}."

# game/02_cap1_apertura.rpy:738
translate english cap1_adivinanza_hermanas_e1c4474f:

    # mc "Es la segunda hermana de las cinco."
    mc "She's the second sister of the five."

# game/02_cap1_apertura.rpy:740
translate english cap1_adivinanza_hermanas_56329983:

    # mc "Manda sobre las demás."
    mc "She bosses the others around."

# game/02_cap1_apertura.rpy:742
translate english cap1_adivinanza_hermanas_b5d14cec:

    # mc "Y es muy rigurosa con las cosas."
    mc "And she's very strict about things."

# game/02_cap1_apertura.rpy:744
translate english cap1_adivinanza_hermanas_986693cb:

    # mc "Hasta me corrigió mi pronunciación en inglés."
    mc "She even corrected my English pronunciation."

# game/02_cap1_apertura.rpy:746
translate english cap1_adivinanza_hermanas_c91163b2:

    # raiha "¡Uy, esa suena a hermana mayor de verdad!"
    raiha "Ooh, that sounds like a real big sister!"

# game/02_cap1_apertura.rpy:748
translate english cap1_adivinanza_hermanas_eb572624:

    # raiha "Es como yo cuando te regaño. ¡Pero enojona todo el día!"
    raiha "She's like me when I scold you. But cranky all day long!"

# game/02_cap1_apertura.rpy:750
translate english cap1_adivinanza_hermanas_4f0cbbf2:

    # raiha "Con esa actitud de jefa, seguro anda revisando que no falte nada en casa..."
    raiha "With that boss attitude, she's probably checking that nothing's missing at home..."

# game/02_cap1_apertura.rpy:752
translate english cap1_adivinanza_hermanas_f52fed51:

    # raiha "Capaz la encuentras en el {color=#9B6FB8}{b}centro comercial{/b}{/color}, comprando lo que las demás olvidaron."
    raiha "You might find her at the {color=#9B6FB8}{b}shopping mall{/b}{/color}, buying what the others forgot."

# game/02_cap1_apertura.rpy:755
translate english cap1_adivinanza_hermanas_46fb98f6:

    # mc_pensamiento "Centro comercial... Tiene sentido, viniendo de ella."
    mc_pensamiento "The mall... makes sense, coming from her."

# game/02_cap1_apertura.rpy:757
translate english cap1_adivinanza_hermanas_395e515e_1:

    # mc "Bien. Anotado."
    mc "Fine. Noted."

# game/02_cap1_apertura.rpy:763
translate english cap1_adivinanza_hermanas_ff8c7736:

    # mc "Hay una que se llama {color=#5DADE2}{b}Miku{/b}{/color}."
    mc "There's one named {color=#5DADE2}{b}Miku{/b}{/color}."

# game/02_cap1_apertura.rpy:765
translate english cap1_adivinanza_hermanas_56d3cb13:

    # mc "Es la tercera hermana de las cinco."
    mc "She's the third sister of the five."

# game/02_cap1_apertura.rpy:767
translate english cap1_adivinanza_hermanas_55cec937:

    # mc "La hermana del medio."
    mc "The middle sister."

# game/02_cap1_apertura.rpy:769
translate english cap1_adivinanza_hermanas_63cfe12f:

    # mc "Casi no habla y usa sus audífonos todo el tiempo."
    mc "She barely talks and wears her headphones all the time."

# game/02_cap1_apertura.rpy:771
translate english cap1_adivinanza_hermanas_18845728:

    # raiha "Con lo calladita que es, seguro se esconde entre libros en la {color=#3D8FC7}{b}biblioteca{/b}{/color}, sin que nadie la moleste."
    raiha "As quiet as she is, she's probably hiding among books in the {color=#3D8FC7}{b}library{/b}{/color}, where nobody bothers her."

# game/02_cap1_apertura.rpy:774
translate english cap1_adivinanza_hermanas_756eb8be:

    # raiha "Las calladas siempre tienen su rincón secreto."
    raiha "The quiet ones always have a secret corner."

# game/02_cap1_apertura.rpy:776
translate english cap1_adivinanza_hermanas_d8cbdc9f:

    # mc_pensamiento "Un rincón secreto que sería la biblioteca."
    mc_pensamiento "A secret corner, meaning the library."

# game/02_cap1_apertura.rpy:778
translate english cap1_adivinanza_hermanas_5edb953d:

    # mc_pensamiento "Si la encuentro ahí, al menos no tendré que gritar para que me escuche."
    mc_pensamiento "If I find her there, at least I won't have to shout to be heard."

# game/02_cap1_apertura.rpy:780
translate english cap1_adivinanza_hermanas_395e515e_2:

    # mc "Bien. Anotado."
    mc "Fine. Noted."

# game/02_cap1_apertura.rpy:786
translate english cap1_adivinanza_hermanas_8aa17df2:

    # mc "Hay una que se llama {color=#58D68D}{b}Yotsuba{/b}{/color}."
    mc "There's one named {color=#58D68D}{b}Yotsuba{/b}{/color}."

# game/02_cap1_apertura.rpy:788
translate english cap1_adivinanza_hermanas_faef3218:

    # mc "Es la cuarta hermana de las cinco."
    mc "She's the fourth sister of the five."

# game/02_cap1_apertura.rpy:790
translate english cap1_adivinanza_hermanas_050eacdb:

    # mc "Rebosa de energía, es muy alegre."
    mc "She's overflowing with energy, very cheerful."

# game/02_cap1_apertura.rpy:792
translate english cap1_adivinanza_hermanas_cb2a2ead:

    # mc "Corrió por el pasillo para conocerme."
    mc "She ran down the hallway to meet me."

# game/02_cap1_apertura.rpy:794
translate english cap1_adivinanza_hermanas_6a0e476a:

    # raiha "¡Esa me cae bien solo de escucharla!"
    raiha "I like her just from hearing about her!"

# game/02_cap1_apertura.rpy:796
translate english cap1_adivinanza_hermanas_11a54a07:

    # raiha "Con esa energía, seguro es una atleta."
    raiha "With that energy, she must be an athlete."

# game/02_cap1_apertura.rpy:798
translate english cap1_adivinanza_hermanas_29dc50ab:

    # raiha "Puede que se la pase entrenando en alguna {color=#3FAF71}{b}pista de atletismo{/b}{/color}."
    raiha "She might spend all her time training on some {color=#3FAF71}{b}track{/b}{/color}."

# game/02_cap1_apertura.rpy:801
translate english cap1_adivinanza_hermanas_469e99ca:

    # mc_pensamiento "Entrenando al aire libre, entonces."
    mc_pensamiento "Training outdoors, then."

# game/02_cap1_apertura.rpy:803
translate english cap1_adivinanza_hermanas_763c23e6:

    # mc_pensamiento "Si empiezo por ella, tendré que correr detrás hasta atraparla."
    mc_pensamiento "If I start with her, I'll have to chase her until I catch her."

# game/02_cap1_apertura.rpy:805
translate english cap1_adivinanza_hermanas_40b24b22:

    # mc_pensamiento "Es broma... o no."
    mc_pensamiento "Just kidding... or not."

# game/02_cap1_apertura.rpy:807
translate english cap1_adivinanza_hermanas_395e515e_3:

    # mc "Bien. Anotado."
    mc "Fine. Noted."

# game/02_cap1_apertura.rpy:814
translate english cap1_adivinanza_hermanas_6a869de6:

    # mc "Hay una que se llama {color=#EC7063}{b}Itsuki{/b}{/color}."
    mc "There's one named {color=#EC7063}{b}Itsuki{/b}{/color}."

# game/02_cap1_apertura.rpy:816
translate english cap1_adivinanza_hermanas_a7a5c0af:

    # mc "Es la última hermana de las cinco. La menor."
    mc "She's the last of the five sisters. The youngest."

# game/02_cap1_apertura.rpy:818
translate english cap1_adivinanza_hermanas_3af009c8:

    # mc "La que se sentó en mi puesto el primer día."
    mc "The one who sat in my seat the first day."

# game/02_cap1_apertura.rpy:820
translate english cap1_adivinanza_hermanas_7cb2882b:

    # mc "Y la que más problemas me ha causado."
    mc "And the one who's given me the most trouble."

# game/02_cap1_apertura.rpy:825
translate english cap1_adivinanza_hermanas_244b17f8:

    # raiha "¡Espera, espera!"
    raiha "Wait, wait!"

# game/02_cap1_apertura.rpy:827
translate english cap1_adivinanza_hermanas_df7af3eb:

    # raiha "¿La del asiento? ¿La que me contaste?"
    raiha "The one with the seat? The one you told me about?"

# game/02_cap1_apertura.rpy:829
translate english cap1_adivinanza_hermanas_36d74e38:

    # mc "...Sí, esa misma."
    mc "...Yes, that one."

# game/02_cap1_apertura.rpy:831
translate english cap1_adivinanza_hermanas_20f19cc2:

    # raiha "¡Con razón volviste con esa cara aquella noche!"
    raiha "No wonder you came home with that face that night!"

# game/02_cap1_apertura.rpy:833
translate english cap1_adivinanza_hermanas_5ddc4b9a:

    # mc "Es bastante aplicada, eso sí. Se queda repasando después de que terminan las clases, aunque nadie se lo pida."
    mc "She's pretty diligent, though. She stays to review after class even when nobody asks her to."

# game/02_cap1_apertura.rpy:839
translate english cap1_adivinanza_hermanas_727c5001:

    # raiha "Entonces no hay mucho misterio ahí."
    raiha "Then there's not much mystery there."

# game/02_cap1_apertura.rpy:841
translate english cap1_adivinanza_hermanas_cb0c501e:

    # raiha "Seguro sigue en el {color=#D35443}{b}aula vacía{/b}{/color}, después de clases, sola con sus apuntes."
    raiha "She's probably still in the {color=#D35443}{b}empty classroom{/b}{/color} after class, alone with her notes."

# game/02_cap1_apertura.rpy:843
translate english cap1_adivinanza_hermanas_7925ded2:

    # mc_pensamiento "Sola y sin que la molesten. Como ahora mismo, seguramente."
    mc_pensamiento "Alone and undisturbed. Like right now, probably."

# game/02_cap1_apertura.rpy:845
translate english cap1_adivinanza_hermanas_412b97b0:

    # mc "Listo. Anotado."
    mc "Done. Noted."

# game/02_cap1_apertura.rpy:850
translate english cap1_adivinanza_hermanas_1556cabd:

    # raiha "¡Ya está!"
    raiha "That's it!"

# game/02_cap1_apertura.rpy:852
translate english cap1_adivinanza_hermanas_6935ba97:

    # raiha "Cinco hermanas, cinco escondites."
    raiha "Five sisters, five hideouts."

# game/02_cap1_apertura.rpy:854
translate english cap1_adivinanza_hermanas_8fcb8a09:

    # raiha "¡De nada, hermanito!"
    raiha "You're welcome, big brother!"

# game/02_cap1_apertura.rpy:856
translate english cap1_adivinanza_hermanas_7dedb9b6:

    # mc "...Gracias, Raiha. Puede que esto sirva más de lo que crees."
    mc "...Thanks, Raiha. This might help more than you think."

# game/02_cap1_apertura.rpy:858
translate english cap1_adivinanza_hermanas_cf0b8072:

    # raiha "¡Siempre sirvo, solo que casi nunca me lo agradecen!"
    raiha "I'm always helpful, people just almost never thank me!"

# game/02_cap1_apertura.rpy:863
translate english cap1_adivinanza_hermanas_8a80d09e:

    # narrador "Se fue tan rápido como había entrado, muy contenta de haber resuelto algo."
    narrador "She left as fast as she'd come in, very happy to have solved something."

# game/02_cap1_apertura.rpy:865
translate english cap1_adivinanza_hermanas_6cd18920:

    # mc_pensamiento "..."
    mc_pensamiento "..."

# game/02_cap1_apertura.rpy:867
translate english cap1_adivinanza_hermanas_e21cc43a:

    # mc_pensamiento "Repasemos."
    mc_pensamiento "Let's review."

# game/02_cap1_apertura.rpy:869
translate english cap1_adivinanza_hermanas_ec075563:

    # mc_pensamiento "Cinco respuestas idénticas en cuatro minutos."
    mc_pensamiento "Five identical answers in four minutes."

# game/02_cap1_apertura.rpy:871
translate english cap1_adivinanza_hermanas_b3a907db:

    # mc_pensamiento "Eso requiere ponerse de acuerdo antes y concordar el error."
    mc_pensamiento "That takes agreeing beforehand and matching the mistake."

# game/02_cap1_apertura.rpy:873
translate english cap1_adivinanza_hermanas_da63ad50:

    # mc_pensamiento "Y sostenerlo delante de mí sin que falle ninguna."
    mc_pensamiento "And holding it in front of me without anyone slipping."

# game/02_cap1_apertura.rpy:875
translate english cap1_adivinanza_hermanas_98c36c8e:

    # mc_pensamiento "Es un trabajo en equipo mejor ejecutado que la mitad de los proyectos de mi clase."
    mc_pensamiento "That's better teamwork than half the projects in my class."

# game/02_cap1_apertura.rpy:877
translate english cap1_adivinanza_hermanas_22359e11:

    # mc_pensamiento "Y Nino me corrigió un had to sin pensarlo, molesta, en mitad de una discusión."
    mc_pensamiento "And Nino corrected my \"had to\" without thinking, annoyed, in the middle of an argument."

# game/02_cap1_apertura.rpy:879
translate english cap1_adivinanza_hermanas_be3e8373:

    # mc_pensamiento "Nadie corrige por reflejo algo que no domina."
    mc_pensamiento "Nobody corrects by reflex something they haven't mastered."

# game/02_cap1_apertura.rpy:881
translate english cap1_adivinanza_hermanas_76e31897:

    # narrador "Volví a mirar las cinco hojas."
    narrador "I looked at the five sheets again."

# game/02_cap1_apertura.rpy:883
translate english cap1_adivinanza_hermanas_2725d384:

    # narrador "En la de Miku, debajo de la respuesta equivocada, había una marca de goma mal borrada."
    narrador "On Miku's, beneath the wrong answer, there was the smudge of a badly erased one."

# game/02_cap1_apertura.rpy:885
translate english cap1_adivinanza_hermanas_355ed1a0:

    # mc_pensamiento "Escribió la correcta primero."
    mc_pensamiento "She wrote the right one first."

# game/02_cap1_apertura.rpy:887
translate english cap1_adivinanza_hermanas_cfd6c4e6:

    # mc_pensamiento "Y después la borró."
    mc_pensamiento "And then she erased it."

# game/02_cap1_apertura.rpy:889
translate english cap1_adivinanza_hermanas_6b589e91:

    # mc_pensamiento "Ayer me habló de logística del período Sengoku sin que nadie se lo preguntara."
    mc_pensamiento "Yesterday she told me about Sengoku-period logistics without anyone asking."

# game/02_cap1_apertura.rpy:891
translate english cap1_adivinanza_hermanas_cb19a329:

    # mc_pensamiento "No son cinco alumnas malas."
    mc_pensamiento "They're not five bad students."

# game/02_cap1_apertura.rpy:893
translate english cap1_adivinanza_hermanas_298819bd:

    # mc_pensamiento "Son cinco personas que saben una cosa cada una y que han decidido no enseñármela."
    mc_pensamiento "They're five people who each know one thing and have decided not to teach it to me."

# game/02_cap1_apertura.rpy:898
translate english cap1_adivinanza_hermanas_464027f3:

    # narrador "Abrí la libreta por la página donde había anotado los cinco nombres la noche anterior."
    narrador "I opened my notebook to the page where I'd written the five names the night before."

# game/02_cap1_apertura.rpy:900
translate english cap1_adivinanza_hermanas_96aafde3:

    # narrador "Debajo de la línea escribí una sola frase."
    narrador "Beneath the line, I wrote a single sentence."

# game/02_cap1_apertura.rpy:902
translate english cap1_adivinanza_hermanas_e9453a19:

    # mc_pensamiento "De frente y las cinco a la vez, pierdo siempre. Son un muro y yo soy uno."
    mc_pensamiento "Head-on, all five at once, I always lose. They're a wall and I'm just one person."

# game/02_cap1_apertura.rpy:904
translate english cap1_adivinanza_hermanas_59317b51:

    # mc_pensamiento "Así que no voy a ir de frente."
    mc_pensamiento "So I won't go head-on."

# game/02_cap1_apertura.rpy:906
translate english cap1_adivinanza_hermanas_27f9ac46:

    # mc_pensamiento "Voy a ir de una en una."
    mc_pensamiento "I'll go one at a time."

# game/02_cap1_apertura.rpy:908
translate english cap1_adivinanza_hermanas_52c1551f:

    # mc_pensamiento "Y no en su casa, donde se cubren entre ellas."
    mc_pensamiento "And not at their home, where they cover for each other."

# game/02_cap1_apertura.rpy:910
translate english cap1_adivinanza_hermanas_4bcfefae:

    # mc_pensamiento "Donde cada una esté sola."
    mc_pensamiento "Where each one is alone."

# game/02_cap1_apertura.rpy:912
translate english cap1_adivinanza_hermanas_08504ba9:

    # narrador "Apagué la lámpara."
    narrador "I turned off the lamp."

# game/02_cap1_apertura.rpy:917
translate english cap1_adivinanza_hermanas_7d2f19d3:

    # narrador "Treinta días."
    narrador "Thirty days."

