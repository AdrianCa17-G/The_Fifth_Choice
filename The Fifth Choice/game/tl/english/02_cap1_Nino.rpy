translate english nino_m4a_035c2dca:

    # mc "Hablar de más no va a convencerte."
    mc "Saying more won't convince you."

# game/02_cap1_Nino.rpy:363
translate english nino_m4a_46f91654:

    # narrador "Se quedó quieta, con la cesta a medio subir, como si esperara el resto de la frase que no llegó."
    narrador "She froze, the basket halfway up her arm, as if waiting for the rest of a sentence that never came."

# game/02_cap1_Nino.rpy:368
translate english nino_m4a_5d06c2b7:

    # nino "..."
    nino "..."

# game/02_cap1_Nino.rpy:370
translate english nino_m4a_f3b5a09f:

    # nino "Esa es la primera vez que alguien no me promete nada."
    nino "That's the first time anyone hasn't promised me anything."

# game/02_cap1_Nino.rpy:372
translate english nino_m4a_efcacc5e:

    # mc "No tengo nada que prometer todavía."
    mc "I've got nothing to promise yet."

# game/02_cap1_Nino.rpy:374
translate english nino_m4a_37e0c68c:

    # mc "No he hecho nada que lo merezca."
    mc "I haven't done anything to earn one."

# game/02_cap1_Nino.rpy:376
translate english nino_m4a_de85e23f:

    # narrador "Lo pensó un momento, sin la hostilidad de antes ni la calma que tampoco tiene."
    narrador "She thought about it a moment, no longer hostile, but not calm either."

# game/02_cap1_Nino.rpy:381
translate english nino_m4a_28d3c23e:

    # nino "Eso no significa que confíe en ti."
    nino "That doesn't mean I trust you."

# game/02_cap1_Nino.rpy:383
translate english nino_m4a_345f967b:

    # mc "No dije que lo hicieras."
    mc "I didn't say you did."

# game/02_cap1_Nino.rpy:385
translate english nino_m4a_7130b483:

    # nino "Bien. Que quede claro."
    nino "Good. Let's be clear."

# game/02_cap1_Nino.rpy:387
translate english nino_m4a_ee3b05fb:

    # narrador "Se quedó mirando la tarjeta de receta un segundo más, antes de guardarla del todo."
    narrador "She looked at the recipe card a second longer before putting it away for good."

# game/02_cap1_Nino.rpy:392
translate english nino_m4a_6f120042:

    # nino "...No le digas a mis hermanas que hablé de más."
    nino "...Don't tell my sisters I talked too much."

# game/02_cap1_Nino.rpy:394
translate english nino_m4a_b08b2dda:

    # mc "No dije nada de más."
    mc "I haven't said anything."

# game/02_cap1_Nino.rpy:399
translate english nino_m4a_d0f0edaf:

    # nino "Tú entendiste. Con eso alcanza."
    nino "You understood. That's enough."

# game/02_cap1_Nino.rpy:404
translate english nino_m4a_25237af7:

    # narrador "Terminó de subir la cesta al brazo y siguió caminando hacia la caja."
    narrador "She hitched the basket back onto her arm and kept walking toward the register."

# game/02_cap1_Nino.rpy:406
translate english nino_m4a_7c0f2599:

    # narrador "No me esperó. Tampoco me dijo que me fuera."
    narrador "She didn't wait for me. She didn't tell me to leave, either."

# game/02_cap1_Nino.rpy:408
translate english nino_m4a_92244fef:

    # mc_pensamiento "No gané su confianza. Todavía no."
    mc_pensamiento "I didn't win her trust. Not yet."

# game/02_cap1_Nino.rpy:410
translate english nino_m4a_85e43ec2:

    # mc_pensamiento "Pero por lo menos entendió que no iba a regalarle promesas vacías."
    mc_pensamiento "But at least she understood I wasn't going to hand her empty promises."

# game/02_cap1_Nino.rpy:424
translate english nino_m4b_82570eb3:

    # narrador "No dije nada."
    narrador "I said nothing."

# game/02_cap1_Nino.rpy:426
translate english nino_m4b_5aa59cd3:

    # narrador "Le quité la cesta del brazo y empecé a caminar hacia la caja."
    narrador "I took the basket off her arm and started toward the register."

# game/02_cap1_Nino.rpy:431
translate english nino_m4b_7c7205b2:

    # nino "¿Qué haces?"
    nino "What are you doing?"

# game/02_cap1_Nino.rpy:433
translate english nino_m4b_7060f4d7:

    # mc "Ayudarte con esto. Pesa."
    mc "Helping you with this. It's heavy."

# game/02_cap1_Nino.rpy:435
translate english nino_m4b_079a7926:

    # nino "No te pedí ayuda."
    nino "I didn't ask for help."

# game/02_cap1_Nino.rpy:437
translate english nino_m4b_95e1f74a:

    # mc "No la pediste. Te la estoy dando igual."
    mc "You didn't ask. I'm giving it anyway."

# game/02_cap1_Nino.rpy:439
translate english nino_m4b_cd3d3a28:

    # narrador "Se quedó un segundo sin saber qué contestar a eso."
    narrador "She stood there a second with no idea how to answer that."

# game/02_cap1_Nino.rpy:444
translate english nino_m4b_81c68cc6:

    # nino "...Esa cesta pesa más de lo que parece."
    nino "...This basket is heavier than it looks."

# game/02_cap1_Nino.rpy:446
translate english nino_m4b_2c34cbe7:

    # mc "Ya lo noté."
    mc "I noticed."

# game/02_cap1_Nino.rpy:448
translate english nino_m4b_fd084507:

    # narrador "Fue lo más parecido a un agradecimiento que iba a conseguir."
    narrador "It was the closest thing to a thank-you I was going to get."

# game/02_cap1_Nino.rpy:450
translate english nino_m4b_9aeb5c81:

    # narrador "Terminó caminando a mi lado sin discutirlo."
    narrador "She ended up walking next to me without arguing about it."

# game/02_cap1_Nino.rpy:452
translate english nino_m4b_0a53e02e:

    # nino "Esto no significa nada."
    nino "This doesn't mean anything."

# game/02_cap1_Nino.rpy:457
translate english nino_m4b_e4922f61:

    # mc "No dije que significara algo."
    mc "I didn't say it did."

# game/02_cap1_Nino.rpy:459
translate english nino_m4b_42ad410a:

    # narrador "Hicimos el resto del pasillo en silencio."
    narrador "We covered the rest of the aisle in silence."

# game/02_cap1_Nino.rpy:461
translate english nino_m4b_e9fb4dcd:

    # narrador "Yo con su cesta; ella sin saber dónde poner las manos."
    narrador "Me with her basket; her not knowing what to do with her hands."

# game/02_cap1_Nino.rpy:463
translate english nino_m4b_db2a7b91:

    # mc_pensamiento "No dijo nada más de lo que se le escapó."
    mc_pensamiento "She said nothing more than what had slipped out."

# game/02_cap1_Nino.rpy:465
translate english nino_m4b_12e72bdc:

    # mc_pensamiento "Y yo preferí dejarlo así."
    mc_pensamiento "And I preferred to leave it that way."

# game/02_cap1_Nino.rpy:467
translate english nino_m4b_23b1fa09:

    # mc_pensamiento "A veces el silencio es lo único que se puede compartir."
    mc_pensamiento "Sometimes silence is all you can share."

# game/02_cap1_Nino.rpy:481
translate english nino_m4c_76ac5db7:

    # mc "Yo sí voy a durar."
    mc "I'm going to last."

# game/02_cap1_Nino.rpy:483
translate english nino_m4c_c3a391f8:

    # narrador "Lo dije para tranquilizarla."
    narrador "I said it to reassure her."

# game/02_cap1_Nino.rpy:485
translate english nino_m4c_aaf11919:

    # narrador "No funcionó."
    narrador "It didn't work."

# game/02_cap1_Nino.rpy:487
translate english nino_m4c_5d06c2b7:

    # nino "..."
    nino "..."

# game/02_cap1_Nino.rpy:489
translate english nino_m4c_a1ca68f0:

    # narrador "Se rió, pero no de gracia."
    narrador "She laughed, but not because anything was funny."

# game/02_cap1_Nino.rpy:491
translate english nino_m4c_0895475e:

    # nino "Eso mismo dijo el que llegó antes de ti."
    nino "The one before you said the exact same thing."

# game/02_cap1_Nino.rpy:493
translate english nino_m4c_5c8b5883:

    # nino "Palabra por palabra, casi."
    nino "Word for word, almost."

# game/02_cap1_Nino.rpy:495
translate english nino_m4c_098bc342:

    # mc "Yo no soy él."
    mc "I'm not him."

# game/02_cap1_Nino.rpy:497
translate english nino_m4c_ca6013e6:

    # nino "Todos dicen eso también."
    nino "They all say that, too."

# game/02_cap1_Nino.rpy:499
translate english nino_m4c_162dd8aa:

    # mc "¿Entonces qué querías que dijera?"
    mc "Then what did you want me to say?"

# game/02_cap1_Nino.rpy:501
translate english nino_m4c_7b1d54a3:

    # nino "Nada. Ese es el punto."
    nino "Nothing. That's the point."

# game/02_cap1_Nino.rpy:503
translate english nino_m4c_baf082b6:

    # narrador "Terminó de acomodar la cesta en el brazo, ya sin mirarme."
    narrador "She finished settling the basket on her arm, no longer looking at me."

# game/02_cap1_Nino.rpy:505
translate english nino_m4c_d59c576f:

    # nino "Guárdate la promesa. No la voy a necesitar."
    nino "Keep your promise. I won't need it."

# game/02_cap1_Nino.rpy:510
translate english nino_m4c_ac73ac90:

    # mc_pensamiento "Le dije exactamente lo que no quería oír."
    mc_pensamiento "I told her exactly what she didn't want to hear."

# game/02_cap1_Nino.rpy:512
translate english nino_m4c_a9ff46cb:

    # mc_pensamiento "Y lo peor es que lo dije pensando que la iba a ayudar."
    mc_pensamiento "And the worst part is I said it thinking it would help her."

# game/02_cap1_Nino.rpy:514
translate english nino_m4c_278c000e:

    # narrador "Caminó hacia la caja sin esperarme, ocultando el papel antes de que pudiera ver algo más."
    narrador "She headed for the register without waiting, hiding the paper before I could see anything more."

# game/02_cap1_Nino.rpy:529
translate english nino_m5_90abc0f5:

    # narrador "Casi en la puerta, el celular de Nino sonó."
    narrador "Almost at the door, Nino's phone rang."

# game/02_cap1_Nino.rpy:534
translate english nino_m5_9572abec:

    # nino "¿Qué?"
    nino "What?"

# game/02_cap1_Nino.rpy:536
translate english nino_m5_1d8c7305:

    # narrador "Contestó sin mirar la pantalla. Debía saber de memoria quién era."
    narrador "She answered without looking at the screen. She must have known by heart who it was."

# game/02_cap1_Nino.rpy:538
translate english nino_m5_7b175825:

    # nino "Sí, papá. Ya voy para allá."
    nino "Yes, Dad. I'm on my way."

# game/02_cap1_Nino.rpy:540
translate english nino_m5_08cc6c36:

    # narrador "Se adelantó un paso, dándome la espalda, como si eso bastara para que no la escuchara."
    narrador "She stepped ahead, her back to me, as if that were enough to keep me from hearing."

# game/02_cap1_Nino.rpy:542
translate english nino_m5_d5488650:

    # nino "Sobre el tutor nuevo..."
    nino "About the new tutor..."

# game/02_cap1_Nino.rpy:544
translate english nino_m5_d6e23c58:

    # narrador "Bajó la voz. No lo suficiente."
    narrador "She lowered her voice. Not enough."

# game/02_cap1_Nino.rpy:546
translate english nino_m5_38df0476:

    # nino "Aún no me convence."
    nino "I'm still not convinced."

# game/02_cap1_Nino.rpy:548
translate english nino_m5_4aedc3ab:

    # mc_pensamiento "No dijo mi nombre. No hacía falta."
    mc_pensamiento "She didn't say my name. She didn't need to."

# game/02_cap1_Nino.rpy:550
translate english nino_m5_21149622:

    # nino "No, no pasó nada."
    nino "No, nothing happened."

# game/02_cap1_Nino.rpy:552
translate english nino_m5_a121c554:

    # narrador "Se quedó escuchando lo que fuera que le contestaran del otro lado, con la mandíbula apretada."
    narrador "She listened to whatever they answered on the other end, her jaw clenched."

# game/02_cap1_Nino.rpy:554
translate english nino_m5_a70d5605:

    # nino "Porque no quiero explicarlo, por eso."
    nino "Because I don't want to explain, that's why."

# game/02_cap1_Nino.rpy:556
translate english nino_m5_345c4c64:

    # narrador "Colgó antes de que la respuesta la obligara a decir algo más."
    narrador "She hung up before the answer could make her say anything more."

# game/02_cap1_Nino.rpy:558
translate english nino_m5_bdf1d8f7:

    # narrador "Guardó el teléfono y siguió caminando hacia la salida, sin voltear a verme."
    narrador "She pocketed the phone and kept walking toward the exit, without turning to look at me."

# game/02_cap1_Nino.rpy:560
translate english nino_m5_cb1ee93c:

    # mc_pensamiento "No dijo por qué."
    mc_pensamiento "She didn't say why."

# game/02_cap1_Nino.rpy:562
translate english nino_m5_4f797266:

    # mc_pensamiento "Y por primera vez, no sonó a que me odiara."
    mc_pensamiento "And for the first time, it didn't sound like she hated me."

# game/02_cap1_Nino.rpy:564
translate english nino_m5_a3679f45:

    # mc_pensamiento "Sonó a que no sabía cómo explicarlo sin decir de más."
    mc_pensamiento "It sounded like she didn't know how to explain it without saying too much."

# game/02_cap1_Nino.rpy:575
translate english nino_m5_48add8c3:

    # narrador "La acompañé hasta la salida, cargando lo que me dejó cargar."
    narrador "I walked her to the exit, carrying what she let me carry."

# game/02_cap1_Nino.rpy:577
translate english nino_m5_ad4b0971:

    # narrador "En la caja pagó ella, sin mirar el total."
    narrador "At the register she paid, without looking at the total."

# game/02_cap1_Nino.rpy:579
translate english nino_m5_70c1ad29:

    # mc_pensamiento "Lo que costaba esa cesta era lo que yo gasto en comida en un mes."
    mc_pensamiento "What that basket cost is what I spend on food in a month."

# game/02_cap1_Nino.rpy:581
translate english nino_m5_ee406bcf:

    # mc_pensamiento "Una de las cinco. Y esta solo bajó la guardia un minuto."
    mc_pensamiento "One of the five. And this one only lowered her guard for a minute."

# game/02_cap1_Nino.rpy:583
translate english nino_m5_47430c21:

    # mc_pensamiento "Quedan [tiempo_restante!t]."
    mc_pensamiento "[tiempo_restante!tc] left."

# game/02_cap1_Nino.rpy:587
translate english nino_m5_fc038905:

    # mc_pensamiento "No confía en mí."
    mc_pensamiento "She doesn't trust me."

# game/02_cap1_Nino.rpy:589
translate english nino_m5_a7152823:

    # mc_pensamiento "Lo dijo ella misma, y no tengo motivos para no creerle."
    mc_pensamiento "She said so herself, and I have no reason not to believe her."

# game/02_cap1_Nino.rpy:591
translate english nino_m5_88c5e563:

    # mc_pensamiento "Pero por primera vez no me trató como al siguiente de la fila."
    mc_pensamiento "But for the first time, she didn't treat me like the next one in line."

# game/02_cap1_Nino.rpy:593
translate english nino_m5_8a31bc5d:

    # mc_pensamiento "Me trató como algo todavía sin decidir."
    mc_pensamiento "She treated me like a decision she hadn't made yet."

# game/02_cap1_Nino.rpy:597
translate english nino_m5_7d8f1809:

    # mc_pensamiento "Cargué su cesta y no dijimos nada importante."
    mc_pensamiento "I carried her basket and we didn't say anything important."

# game/02_cap1_Nino.rpy:599
translate english nino_m5_90663b2d:

    # mc_pensamiento "No sé si eso cuenta como algo."
    mc_pensamiento "I don't know if that counts as anything."

# game/02_cap1_Nino.rpy:601
translate english nino_m5_a72d875c:

    # mc_pensamiento "Con ella, nunca se sabe si avanzaste o retrocediste."
    mc_pensamiento "With her, you never know if you moved forward or back."

# game/02_cap1_Nino.rpy:605
translate english nino_m5_bf6e6cbf:

    # mc_pensamiento "Le prometí que iba a durar."
    mc_pensamiento "I promised her I'd last."

# game/02_cap1_Nino.rpy:607
translate english nino_m5_ed5816e0:

    # mc_pensamiento "Ella ya había escuchado esa frase antes."
    mc_pensamiento "She'd heard that one before."

# game/02_cap1_Nino.rpy:609
translate english nino_m5_e9df5021:

    # mc_pensamiento "Yo mismo me puse en la misma fila que los anteriores."
    mc_pensamiento "I put myself in the same line as the ones before."

translate english strings:

    # game/02_cap1_Nino.rpy:326
    old "¿Qué le dirás a Nino?"
    new "What will you say to Nino?"

    # game/02_cap1_Nino.rpy:326
    old "Te contó más de lo que quería. Ahora espera tu respuesta."
    new "She said more than she meant to. Now she's waiting on you."

    # game/02_cap1_Nino.rpy:332
    old "Tienes razón en desconfiar. Solo el tiempo lo va a demostrar."
    new "You're right not to trust me. Only time will prove it."

    # game/02_cap1_Nino.rpy:335
    old "Cargarle la cesta, sin decir nada."
    new "Carry her basket, without saying anything."

    # game/02_cap1_Nino.rpy:338
    old "Yo sí voy a durar."
    new "I'm going to last."

