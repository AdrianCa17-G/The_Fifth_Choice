translate english final_malo_beat_5fda9493:

    # narrador "No se los subió. Los dejó ahí, apoyadas."
    narrador "She didn't put them on. She left her hands resting there."

# game/02_cap1_final_malo.rpy:289
translate english final_malo_beat_e7c6610e:

    # miku "...Dijiste que lo de la sal no entraba en el examen."
    miku "...You said the salt part wasn't on the exam."

# game/02_cap1_final_malo.rpy:291
translate english final_malo_beat_1afaf38a:

    # miku "...Tenías razón."
    miku "...You were right."

# game/02_cap1_final_malo.rpy:293
translate english final_malo_beat_52aeb1e4:

    # miku "...Por eso no volví a abrir el libro."
    miku "...That's why I never opened the book again."

# game/02_cap1_final_malo.rpy:299
translate english final_malo_beat_1f6a2857:

    # itsuki "Te lo dije el primer día. Esto no iba a funcionar."
    itsuki "I told you on the first day. This was not going to work."

# game/02_cap1_final_malo.rpy:301
translate english final_malo_beat_b08a7ad8:

    # itsuki "Ahora lo tengo confirmado. No me hace ninguna gracia."
    itsuki "Now I have it confirmed. It gives me no pleasure."

# game/02_cap1_final_malo.rpy:307
translate english final_malo_beat_5586fe52:

    # itsuki "Me quitaste el cuaderno de las manos."
    itsuki "You took the notebook out of my hands."

# game/02_cap1_final_malo.rpy:309
translate english final_malo_beat_ec0b423b:

    # itsuki "Me lo resolviste delante de mí."
    itsuki "You solved it right in front of me."

# game/02_cap1_final_malo.rpy:311
translate english final_malo_beat_8e7bfcf4:

    # itsuki "Eso no se me va a olvidar."
    itsuki "I won't forget that."

# game/02_cap1_final_malo.rpy:315
translate english final_malo_beat_4375f843:

    # itsuki "Me dijiste dónde mirar. Una vez."
    itsuki "You told me where to look. Once."

# game/02_cap1_final_malo.rpy:317
translate english final_malo_beat_cf2ecde3:

    # itsuki "Pensé que habría una segunda."
    itsuki "I thought there would be a second time."

# game/02_cap1_final_malo.rpy:321
translate english final_malo_beat_6c74d1cf:

    # itsuki "Me ofreciste revisarlo desde el principio. Te dije que no."
    itsuki "You offered to go over it from the start. I said no."

# game/02_cap1_final_malo.rpy:323
translate english final_malo_beat_c22f44a8:

    # itsuki "Ahora no voy a saber qué ibas a explicarme."
    itsuki "Now I'll never know what you were going to explain."

# game/02_cap1_final_malo.rpy:327
translate english final_malo_beat_b9381dc8:

    # narrador "Intenté decir algo. Itsuki lo notó antes que yo."
    narrador "I tried to say something. Itsuki noticed before I did."

# game/02_cap1_final_malo.rpy:329
translate english final_malo_beat_6002e467:

    # itsuki "No lo digas."
    itsuki "Don't say it."

# game/02_cap1_final_malo.rpy:331
translate english final_malo_beat_08785b70:

    # itsuki "Un «lo siento» ahora sería para ti, no para nosotras."
    itsuki "An \"I'm sorry\" now would be for you, not for us."

# game/02_cap1_final_malo.rpy:333
translate english final_malo_beat_14eaebf9:

    # narrador "Me quedé callado. No tenía otra cosa que hacer."
    narrador "I stayed quiet. There was nothing else to do."

# game/02_cap1_final_malo.rpy:335
translate english final_malo_beat_2c0cdccb:

    # mc_pensamiento "Itsuki tenía razón. Otra vez."
    mc_pensamiento "Itsuki was right. Again."

# game/02_cap1_final_malo.rpy:337
translate english final_malo_beat_719354cc:

    # narrador "Recogí mi mochila. Nadie me detuvo."
    narrador "I picked up my bag. Nobody stopped me."

# game/02_cap1_final_malo.rpy:339
translate english final_malo_beat_9fbe7244:

    # narrador "Tampoco nadie me acompañó hasta la puerta."
    narrador "Nobody walked me to the door, either."

# game/02_cap1_final_malo.rpy:343
translate english final_malo_beat_e4574c06:

    # narrador "La cerré yo mismo. Sin portazo."
    narrador "I closed it myself. No slam."

# game/02_cap1_final_malo.rpy:345
translate english final_malo_beat_c741a79b:

    # narrador "Para que no pareciera que me enfadaba."
    narrador "So it wouldn't look like I was angry."

# game/02_cap1_final_malo.rpy:359
translate english final_malo_beat_56ea6727:

    # narrador "Llegué a casa a una hora a la que no llegaba desde hace semanas."
    narrador "I got home at an hour I hadn't made it in weeks."

# game/02_cap1_final_malo.rpy:365
translate english final_malo_beat_4705a67f:

    # raiha "¡Hermanito! Llegaste temprano. ¡Todavía no hay curry!"
    raiha "[mc]! You're early. There's no curry yet!"

# game/02_cap1_final_malo.rpy:367
translate english final_malo_beat_b22745a1:

    # narrador "Se quedó callada al verme la cara."
    narrador "She went quiet when she saw my face."

# game/02_cap1_final_malo.rpy:372
translate english final_malo_beat_cce2cbe7:

    # raiha "Hermanito... ¿Te encuentras bien?"
    raiha "Big brother... are you okay?"

# game/02_cap1_final_malo.rpy:374
translate english final_malo_beat_bc3a37ef:

    # mc "Discúlpame, Raiha."
    mc "Sorry, Raiha."

# game/02_cap1_final_malo.rpy:376
translate english final_malo_beat_c8552e38:

    # mc "Me despidieron."
    mc "I got fired."

# game/02_cap1_final_malo.rpy:378
translate english final_malo_beat_e86723a7:

    # raiha "...¿Qué?"
    raiha "...What?"

# game/02_cap1_final_malo.rpy:380
translate english final_malo_beat_8c3621df:

    # isanari "¿Quién?"
    isanari "Who?"

# game/02_cap1_final_malo.rpy:382
translate english final_malo_beat_661b1a2f:

    # mc "Maruo. Hoy."
    mc "Maruo. Today."

# game/02_cap1_final_malo.rpy:384
translate english final_malo_beat_5163c721:

    # isanari "¿Y el mes? ¿Te pagó lo trabajado?"
    isanari "And the month? Did he pay for the work?"

# game/02_cap1_final_malo.rpy:386
translate english final_malo_beat_302f6a6f:

    # mc "Dijo que sí."
    mc "He said he would."

# game/02_cap1_final_malo.rpy:391
translate english final_malo_beat_ac4ae086:

    # raiha "¡Papá!"
    raiha "Dad!"

# game/02_cap1_final_malo.rpy:393
translate english final_malo_beat_7236e851:

    # raiha "¡Primero mírale la cara!"
    raiha "Look at his face first!"

# game/02_cap1_final_malo.rpy:395
translate english final_malo_beat_6976bd8e:

    # isanari "..."
    isanari "..."

# game/02_cap1_final_malo.rpy:397
translate english final_malo_beat_425c0e7f:

    # narrador "Mi papá intentó decir algo. No contestó."
    narrador "My dad tried to say something. He didn't answer."

# game/02_cap1_final_malo.rpy:399
translate english final_malo_beat_9d663b15:

    # narrador "Se acomodó las gafas oscuras, aunque era de noche."
    narrador "He adjusted his sunglasses, even though it was night."

# game/02_cap1_final_malo.rpy:401
translate english final_malo_beat_a5dcf9a0:

    # narrador "Como para no tener que mirarme."
    narrador "As if to avoid looking at me."

# game/02_cap1_final_malo.rpy:403
translate english final_malo_beat_e6d8398d:

    # isanari "Le di mi palabra a Maruo."
    isanari "I gave Maruo my word."

# game/02_cap1_final_malo.rpy:405
translate english final_malo_beat_3f933fc9:

    # isanari "Le dije que te tomarías esto en serio."
    isanari "I told him you'd take this seriously."

# game/02_cap1_final_malo.rpy:407
translate english final_malo_beat_97d149c7:

    # mc "Me lo tomé en serio."
    mc "I did take it seriously."

# game/02_cap1_final_malo.rpy:409
translate english final_malo_beat_cdbd5e65:

    # isanari "No lo suficiente."
    isanari "Not enough."

# game/02_cap1_final_malo.rpy:411
translate english final_malo_beat_37da3c60:

    # narrador "Lo dijo mirando la mesa. No supe si me lo decía a mí o a él mismo."
    narrador "He said it looking at the table. I couldn't tell if he was saying it to me or to himself."

# game/02_cap1_final_malo.rpy:416
translate english final_malo_beat_48270406:

    # raiha "Hermanito..."
    raiha "Big brother..."

# game/02_cap1_final_malo.rpy:418
translate english final_malo_beat_0f50575b:

    # mc "Todavía no era el examen, Raiha. Me despidieron antes."
    mc "It wasn't the exam yet, Raiha. They fired me before that."

# game/02_cap1_final_malo.rpy:420
translate english final_malo_beat_7e30b348:

    # raiha "¿Pero por qué?"
    raiha "But why?"

# game/02_cap1_final_malo.rpy:422
translate english final_malo_beat_497db232:

    # mc "Porque no hice nada. Dos semanas, y no hice nada."
    mc "Because I did nothing. Two weeks, and I did nothing."

# game/02_cap1_final_malo.rpy:424
translate english final_malo_beat_78d3f600:

    # narrador "Raiha no dijo que no fuera verdad."
    narrador "Raiha didn't say it wasn't true."

# game/02_cap1_final_malo.rpy:426
translate english final_malo_beat_ab86471e:

    # narrador "Eso me dolió más que si lo hubiera dicho."
    narrador "That hurt more than if she had."

# game/02_cap1_final_malo.rpy:440
translate english final_malo_beat_081a16b4:

    # narrador "Abrí la libreta por la página de los cinco nombres."
    narrador "I opened the notebook to the page with the five names."

# game/02_cap1_final_malo.rpy:442
translate english final_malo_beat_3f92301d:

    # narrador "Debajo de la línea estaba la frase de aquella noche."
    narrador "Under the line was the sentence from that night."

# game/02_cap1_final_malo.rpy:444
translate english final_malo_beat_885e5a13:

    # mc_pensamiento "«Voy a ir de una en una.»"
    mc_pensamiento "\"I'll go one at a time.\""

# game/02_cap1_final_malo.rpy:446
translate english final_malo_beat_f35f224c:

    # mc_pensamiento "Fui de una en una. Y las dos veces me equivoqué."
    mc_pensamiento "I went one at a time. And both times I got it wrong."

# game/02_cap1_final_malo.rpy:448
translate english final_malo_beat_28ffbabd:

    # mc_pensamiento "Ni siquiera llegué a la mitad de los treinta días."
    mc_pensamiento "I didn't even make it to the halfway point of the thirty days."

# game/02_cap1_final_malo.rpy:450
translate english final_malo_beat_1807dbdb:

    # mc_pensamiento "La deuda sigue exactamente donde estaba."
    mc_pensamiento "The debt is exactly where it was."

# game/02_cap1_final_malo.rpy:452
translate english final_malo_beat_b7c53dc0:

    # narrador "Cerré la libreta. Apagué la lámpara."
    narrador "I closed the notebook. Turned off the lamp."

# game/02_cap1_final_malo.rpy:454
translate english final_malo_beat_9a364f31:

    # narrador "No hubo ninguna frase que anotar esta vez."
    narrador "There was no sentence to write down this time."

# game/02_cap1_final_malo.rpy:456
translate english final_malo_beat_8382d8d0:

    # narrador "Todo terminó. En un fracaso."
    narrador "It all ended. In failure."

# game/02_cap1_final_malo.rpy:458
translate english final_malo_beat_73d5b856:

    # narrador "Y un despido temprano."
    narrador "And an early dismissal."

# game/02_cap1_final_malo.rpy:484
translate english final_malo_hub3_5dff51e7:

    # mc_pensamiento "Lunes. Primer día de exámenes."
    mc_pensamiento "Monday. First day of exams."

# game/02_cap1_final_malo.rpy:486
translate english final_malo_hub3_fe1ee0a6:

    # mc_pensamiento "Uno por día, toda la semana."
    mc_pensamiento "One per day, all week."

# game/02_cap1_final_malo.rpy:488
translate english final_malo_hub3_88f0cae3:

    # mc_pensamiento "Maruo dijo: «Al terminar la semana lo confirmo.»"
    mc_pensamiento "Maruo said: \"At the end of the week, I'll confirm.\""

# game/02_cap1_final_malo.rpy:490
translate english final_malo_hub3_64af8860:

    # mc_pensamiento "«Confirmar» significa que todavía existe un resultado que podría cambiarlo."
    mc_pensamiento "\"Confirm\" means there's still a result that could change things."

# game/02_cap1_final_malo.rpy:492
translate english final_malo_hub3_51788b1b:

    # mc_pensamiento "Es la única palabra a la que me estoy aferrando."
    mc_pensamiento "It's the only word I'm clinging to."

# game/02_cap1_final_malo.rpy:494
translate english final_malo_hub3_eb0d973f:

    # mc_pensamiento "Si aprueban, todo lo demás no importa."
    mc_pensamiento "If they pass, nothing else matters."

# game/02_cap1_final_malo.rpy:496
translate english final_malo_hub3_c9645b4d:

    # mc_pensamiento "Si no aprueban, hoy es mi último día como su tutor. Y lo sé."
    mc_pensamiento "If they don't, today is my last day as their tutor. And I know it."

# game/02_cap1_final_malo.rpy:498
translate english final_malo_hub3_886fb659:

    # mc_pensamiento "Cuatro semanas para esto. Y llego igual que cuando empecé."
    mc_pensamiento "Four weeks for this. And I show up the same as when I started."

# game/02_cap1_final_malo.rpy:518
translate english final_malo_hub3_37dec5d5:

    # narrador "Las cinco ya estaban en el aula."
    narrador "The five of them were already in the classroom."

# game/02_cap1_final_malo.rpy:520
translate english final_malo_hub3_9ca75a9a:

    # narrador "Nadie había abierto un libro."
    narrador "Nobody had opened a book."

# game/02_cap1_final_malo.rpy:522
translate english final_malo_hub3_deb1d582:

    # narrador "Lo habían abierto tanto estas semanas que ya no servía de nada abrirlo."
    narrador "They'd opened them so many times these weeks that opening them didn't help anymore."

# game/02_cap1_final_malo.rpy:524
translate english final_malo_hub3_6b0d08ca:

    # mc "Hola, chicas. Estamos en semana de exámenes."
    mc "Hi, girls. It's exam week."

# game/02_cap1_final_malo.rpy:526
translate english final_malo_hub3_431c5cca:

    # mc "Espero les vaya bien."
    mc "I hope it goes well for you."

# game/02_cap1_final_malo.rpy:528
translate english final_malo_hub3_8306d0d5:

    # mc_pensamiento "Nadie estaba emocionada, se veía venir."
    mc_pensamiento "Nobody was excited. You could see it coming."

# game/02_cap1_final_malo.rpy:530
translate english final_malo_hub3_28b809bb:

    # mc_pensamiento "Ellas saben que desperdiciamos todo este mes, y que no progresamos nada."
    mc_pensamiento "They know we wasted this whole month, and that we made no progress at all."

# game/02_cap1_final_malo.rpy:541
translate english final_malo_hub3_add01a93:

    # yotsuba "Buenos días, tutor."
    yotsuba "Good morning, tutor."

# game/02_cap1_final_malo.rpy:545
translate english final_malo_hub3_5a5a515a:

    # yotsuba "Buenos días, [mc]."
    yotsuba "Good morning, [mc]."

# game/02_cap1_final_malo.rpy:547
translate english final_malo_hub3_5d5311f2:

    # yotsuba "...Quería decirlo con más ganas. No me sale."
    yotsuba "...I wanted to say it with more spirit. It won't come out."

# game/02_cap1_final_malo.rpy:549
translate english final_malo_hub3_436bd93d:

    # yotsuba "Estudié las lecturas dos veces."
    yotsuba "I studied the readings twice."

# game/02_cap1_final_malo.rpy:551
translate english final_malo_hub3_5f0dd7d8:

    # yotsuba "Cuando cierro el libro, no recuerdo qué sentía nadie."
    yotsuba "When I close the book, I can't remember what anyone felt."

# game/02_cap1_final_malo.rpy:557
translate english final_malo_hub3_1e057efe:

    # ichika "Dormí cuatro horas."
    ichika "I slept four hours."

# game/02_cap1_final_malo.rpy:559
translate english final_malo_hub3_86c12df0:

    # ichika "Y las pasé con el papel de la audición, no con las fórmulas."
    ichika "And I spent them on the audition part, not on formulas."

# game/02_cap1_final_malo.rpy:561
translate english final_malo_hub3_9cee0571:

    # ichika "No me mires así. Ya sé que no era lo que tocaba."
    ichika "Don't look at me like that. I know it wasn't what I should've done."

# game/02_cap1_final_malo.rpy:567
translate english final_malo_hub3_f176e4d6:

    # miku "...Solo sé la mitad de lo que van a preguntar."
    miku "...I only know half of what they're going to ask."

# game/02_cap1_final_malo.rpy:569
translate english final_malo_hub3_c71e5b43:

    # miku "...Y no sé si esa mitad está bien."
    miku "...And I don't know if that half is right."

# game/02_cap1_final_malo.rpy:575
translate english final_malo_hub3_58976c3b:

    # itsuki "He estudiado más que nadie en esta aula. Cada noche."
    itsuki "I have studied more than anyone in this room. Every night."

# game/02_cap1_final_malo.rpy:577
translate english final_malo_hub3_f807640e:

    # itsuki "Y no sé si me sé una sola cosa."
    itsuki "And I don't know if I know a single thing."

# game/02_cap1_final_malo.rpy:579
translate english final_malo_hub3_928ca301:

    # itsuki "Quisiera poder culparte. Sería más fácil."
    itsuki "I wish I could blame you. It would be easier."

# game/02_cap1_final_malo.rpy:585
translate english final_malo_hub3_d106fcb5:

    # nino "Ya basta de rodeos."
    nino "Enough beating around the bush."

# game/02_cap1_final_malo.rpy:587
translate english final_malo_hub3_2b5157d5:

    # nino "Alguien tiene que decírtelo y me toca a mí."
    nino "Somebody has to tell you, and it's me."

# game/02_cap1_final_malo.rpy:589
translate english final_malo_hub3_7af44343:

    # nino "No aprendimos nada. Ni nos enseñaste, ni nosotras quisimos."
    nino "We didn't learn anything. You didn't teach us, and we didn't want to learn."

# game/02_cap1_final_malo.rpy:591
translate english final_malo_hub3_4932dc9c:

    # nino "Aunque no sea solo culpa tuya. Eso no cambia que no sirvió."
    nino "Even if it isn't only your fault. That doesn't change the fact that it didn't work."

# game/02_cap1_final_malo.rpy:599
translate english final_malo_hub3_94217926:

    # narrador "Me miraron las cinco. Esperando que les dijera algo."
    narrador "All five looked at me. Waiting for me to say something."

# game/02_cap1_final_malo.rpy:601
translate english final_malo_hub3_e457c486:

    # mc_pensamiento "No tenía nada que decirles que no fuera una mentira."
    mc_pensamiento "I had nothing to tell them that wasn't a lie."

# game/02_cap1_final_malo.rpy:603
translate english final_malo_hub3_d31ab163:

    # mc "Hagan lo que sepan."
    mc "Just do what you know."

# game/02_cap1_final_malo.rpy:605
translate english final_malo_hub3_c09d2f9b:

    # narrador "Lo dije y sonó a lo que era: una frase vacía e inútil."
    narrador "I said it, and it sounded like what it was: an empty, useless line."

# game/02_cap1_final_malo.rpy:629
translate english final_malo_hub3_835d1e81:

    # narrador "Mi pupitre estaba en la segunda fila. Ellas, repartidas delante y a los lados."
    narrador "My desk was in the second row. They were spread out in front of me and to the sides."

# game/02_cap1_final_malo.rpy:631
translate english final_malo_hub3_bd391be5:

    # narrador "Cada día, un examen. Cada día terminaba el mío antes de la mitad."
    narrador "One exam a day. Every day I finished mine before the halfway mark."

# game/02_cap1_final_malo.rpy:633
translate english final_malo_hub3_c2b7d841:

    # mc_pensamiento "Ahora venía lo peor: no tener nada que hacer más que mirar."
    mc_pensamiento "Now came the worst part: having nothing to do but watch."

# game/02_cap1_final_malo.rpy:635
translate english final_malo_hub3_a6ed7813:

    # profe "Pueden empezar."
    profe "You may begin."

# game/02_cap1_final_malo.rpy:643
translate english final_malo_hub3_296c2213:

    # narrador "Hoy, lunes."
    narrador "Today, Monday."

# game/02_cap1_final_malo.rpy:645
translate english final_malo_hub3_692862d6:

    # narrador "Examen de japonés."
    narrador "Japanese exam."

# game/02_cap1_final_malo.rpy:650
translate english final_malo_hub3_9fb97962:

    # narrador "Las cinco lo hacían a la vez; yo solo podía mirar a una."
    narrador "The five of them took it at the same time; I could only watch one."

# game/02_cap1_final_malo.rpy:652
translate english final_malo_hub3_274187e6:

    # mc_pensamiento "Yotsuba..."
    mc_pensamiento "Yotsuba..."

# game/02_cap1_final_malo.rpy:654
translate english final_malo_hub3_c899d52f:

    # narrador "Yotsuba no escribía. Tenía el lápiz quieto y la cabeza mirando a otros lados."
    narrador "Yotsuba wasn't writing. Her pencil was still and her head was turned elsewhere."

# game/02_cap1_final_malo.rpy:656
translate english final_malo_hub3_cc717f6d:

    # mc_pensamiento "No miraba su hoja."
    mc_pensamiento "She wasn't looking at her sheet."

# game/02_cap1_final_malo.rpy:658
translate english final_malo_hub3_9508e493:

    # mc_pensamiento "Miraba a Ichika. Después a Miku. Después a Itsuki."
    mc_pensamiento "She was looking at Ichika. Then Miku. Then Itsuki."

# game/02_cap1_final_malo.rpy:660
translate english final_malo_hub3_970dc112:

    # mc_pensamiento "Otra vez a Ichika."
    mc_pensamiento "Ichika again."

# game/02_cap1_final_malo.rpy:662
translate english final_malo_hub3_6c025991:

    # narrador "Cada vez que una de ellas parecía en problemas, ella se preocupaba un poco."
    narrador "Every time one of them looked like she was struggling, she worried a little more."

# game/02_cap1_final_malo.rpy:664
translate english final_malo_hub3_940c5dff:

    # mc_pensamiento "Es lo que mejor hace: leer a las demás."
    mc_pensamiento "It's what she does best: reading the others."

# game/02_cap1_final_malo.rpy:668
translate english final_malo_hub3_116eef85:

    # mc_pensamiento "Se lo dije una vez, en la pista. Una sola vez no bastó."
    mc_pensamiento "I told her that once, at the track. Once wasn't enough."

# game/02_cap1_final_malo.rpy:672
translate english final_malo_hub3_6469a435:

    # mc_pensamiento "Nadie le había dicho que eso también contaba. Yo tampoco."
    mc_pensamiento "Nobody had told her that counted too. Neither had I."

# game/02_cap1_final_malo.rpy:674
translate english final_malo_hub3_62ca4e78:

    # narrador "La pregunta uno preguntaba qué siente el protagonista cuando se queda solo."
    narrador "Question one asked what the main character feels when left alone."

# game/02_cap1_final_malo.rpy:676
translate english final_malo_hub3_c63ad062:

    # narrador "La hoja de Yotsuba tenía su nombre. Nada más."
    narrador "Yotsuba's sheet had her name on it. Nothing else."

# game/02_cap1_final_malo.rpy:678
translate english final_malo_hub3_f05b57ce:

    # mc_pensamiento "El mismo uno por ciento del primer día."
    mc_pensamiento "The same one percent as the first day."

# game/02_cap1_final_malo.rpy:682
translate english final_malo_hub3_8d696504:

    # mc_pensamiento "Le dije que su punto de partida no era cero."
    mc_pensamiento "I told her her starting point wasn't zero."

# game/02_cap1_final_malo.rpy:684
translate english final_malo_hub3_ed98db38:

    # mc_pensamiento "Y se quedó en el uno."
    mc_pensamiento "And she stayed at one."

# game/02_cap1_final_malo.rpy:688
translate english final_malo_hub3_07a1f649:

    # mc_pensamiento "Le dije que se concentrara en lo suyo."
    mc_pensamiento "I told her to focus on her own thing."

# game/02_cap1_final_malo.rpy:690
translate english final_malo_hub3_6e14bfea:

    # mc_pensamiento "Nunca le dije qué era lo suyo."
    mc_pensamiento "I never told her what her own thing was."

# game/02_cap1_final_malo.rpy:694
translate english final_malo_hub3_e0097fff:

    # mc_pensamiento "Aquel uno por ciento que pude ayudarle a aumentar, pero no lo hice."
    mc_pensamiento "That one percent I could have helped her raise, and I didn't."

# game/02_cap1_final_malo.rpy:701
translate english final_malo_hub3_d751567c:

    # narrador "Día martes."
    narrador "Tuesday."

# game/02_cap1_final_malo.rpy:703
translate english final_malo_hub3_420bfe47:

    # narrador "Examen de matemáticas."
    narrador "Math exam."

# game/02_cap1_final_malo.rpy:712
translate english final_malo_hub3_9fb97962_1:

    # narrador "Las cinco lo hacían a la vez; yo solo podía mirar a una."
    narrador "The five of them took it at the same time; I could only watch one."

# game/02_cap1_final_malo.rpy:714
translate english final_malo_hub3_b7a49c2a:

    # mc_pensamiento "Ichika..."
    mc_pensamiento "Ichika..."

# game/02_cap1_final_malo.rpy:716
translate english final_malo_hub3_faf8776c:

    # narrador "Ichika escribió su nombre y las dos primeras líneas."
    narrador "Ichika wrote her name and the first two lines."

# game/02_cap1_final_malo.rpy:718
translate english final_malo_hub3_c86e0d3d:

    # narrador "Después sacó algo doblado debajo de la hoja."
    narrador "Then she pulled something folded out from under the sheet."

# game/02_cap1_final_malo.rpy:720
translate english final_malo_hub3_cbdf9eff:

    # narrador "Un guion."
    narrador "A script."

# game/02_cap1_final_malo.rpy:722
translate english final_malo_hub3_74ebde43:

    # mc_pensamiento "Movía los labios sin sonido."
    mc_pensamiento "Her lips moved without a sound."

# game/02_cap1_final_malo.rpy:724
translate english final_malo_hub3_5613dc9b:

    # mc_pensamiento "Repetía una frase una y otra vez."
    mc_pensamiento "She repeated one line over and over."

# game/02_cap1_final_malo.rpy:726
translate english final_malo_hub3_327c2bfc:

    # mc_pensamiento "No era una fórmula. Era un papel que no es de este examen."
    mc_pensamiento "It wasn't a formula. It was a part that isn't from this exam."

# game/02_cap1_final_malo.rpy:728
translate english final_malo_hub3_d073ac6c:

    # narrador "Al rato apoyó la cabeza en el brazo y cerró los ojos."
    narrador "After a while she rested her head on her arm and closed her eyes."

# game/02_cap1_final_malo.rpy:730
translate english final_malo_hub3_6e20a4d4:

    # mc_pensamiento "Igual que el segundo día. La misma función."
    mc_pensamiento "Just like the second day. The same performance."

# game/02_cap1_final_malo.rpy:732
translate english final_malo_hub3_12b17fd7:

    # mc_pensamiento "Solo que esta vez la función no era para nadie."
    mc_pensamiento "Only this time the performance wasn't for anyone."

# game/02_cap1_final_malo.rpy:734
translate english final_malo_hub3_f8d0e10c:

    # profe "Nakano. Despierte."
    profe "Nakano. Wake up."

# game/02_cap1_final_malo.rpy:742
translate english final_malo_hub3_5b98e396:

    # ichika "Disculpe profesor."
    ichika "Sorry, sir."

# game/02_cap1_final_malo.rpy:744
translate english final_malo_hub3_a4fbcd6e:

    # ichika "¡Estaba pensando! Los matemáticos piensan con los ojos cerrados."
    ichika "I was thinking! Mathematicians think with their eyes closed."

# game/02_cap1_final_malo.rpy:746
translate english final_malo_hub3_984a9e56:

    # narrador "Nadie se rió. El profesor tampoco."
    narrador "Nobody laughed. Neither did the teacher."

# game/02_cap1_final_malo.rpy:748
translate english final_malo_hub3_ae414672:

    # profe "Se piensa con los ojos abiertos."
    profe "Thinking is done with your eyes open."

# game/02_cap1_final_malo.rpy:750
translate english final_malo_hub3_6b972ddb:

    # ichika "Lo siento..."
    ichika "I'm sorry..."

# game/02_cap1_final_malo.rpy:757
translate english final_malo_hub3_2f6caa38:

    # narrador "Día miércoles."
    narrador "Wednesday."

# game/02_cap1_final_malo.rpy:759
translate english final_malo_hub3_a9b17a07:

    # narrador "Examen de inglés."
    narrador "English exam."

# game/02_cap1_final_malo.rpy:768
translate english final_malo_hub3_9fb97962_2:

    # narrador "Las cinco lo hacían a la vez; yo solo podía mirar a una."
    narrador "The five of them took it at the same time; I could only watch one."

# game/02_cap1_final_malo.rpy:770
translate english final_malo_hub3_accc4180:

    # mc_pensamiento "Nino..."
    mc_pensamiento "Nino..."

# game/02_cap1_final_malo.rpy:772
translate english final_malo_hub3_c4f7caa2:

    # narrador "Nino terminó segunda, después de mí."
    narrador "Nino finished second, after me."

# game/02_cap1_final_malo.rpy:774
translate english final_malo_hub3_1c82d5b0:

    # narrador "Letra legible, sin tachones, sin levantar la vista."
    narrador "Legible handwriting, no cross-outs, never looking up."

# game/02_cap1_final_malo.rpy:776
translate english final_malo_hub3_86fefa7e:

