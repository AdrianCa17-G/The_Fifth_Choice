translate english final_malo_beat_a2a0683b:

    # nino "Papá lo despidió."
    nino "Dad fired him."

# game/02_cap1_final_malo.rpy:200
translate english final_malo_beat_4041e99c:

    # narrador "Nadie dijo nada. Del pasillo llegaba el ruido del edificio, muy lejos."
    narrador "Nobody said anything. From the hallway came the noise of the building, very far away."

# game/02_cap1_final_malo.rpy:206
translate english final_malo_beat_4d8083bf:

    # itsuki "...¿Hoy?"
    itsuki "...Today?"

# game/02_cap1_final_malo.rpy:212
translate english final_malo_beat_2fdbf8da:

    # nino "Hoy. Hace cinco minutos."
    nino "Today. Five minutes ago."

# game/02_cap1_final_malo.rpy:218
translate english final_malo_beat_7cf3bc9a:

    # ichika "Bueno... al menos fue rápido. ¿No?"
    ichika "Well... at least it was quick. Right?"

# game/02_cap1_final_malo.rpy:220
translate english final_malo_beat_7fb6f2f1:

    # narrador "Nadie se rió. Ni ella."
    narrador "Nobody laughed. Not even her."

# game/02_cap1_final_malo.rpy:225
translate english final_malo_beat_10891e10:

    # ichika "...Perdón. Es lo que hago cuando no sé qué decir."
    ichika "...Sorry. It's what I do when I don't know what to say."

# game/02_cap1_final_malo.rpy:227
translate english final_malo_beat_c3d20661:

    # ichika "No te voy a defender, [mc]. No sabría con qué."
    ichika "I'm not going to defend you, [mc]. I wouldn't know with what."

# game/02_cap1_final_malo.rpy:231
translate english final_malo_beat_bcf2bbe6:

    # ichika "Fuiste correcto conmigo. Como un padre."
    ichika "You were polite with me. Like a father."

# game/02_cap1_final_malo.rpy:233
translate english final_malo_beat_41fcd3c5:

    # ichika "Y yo te contesté como se contesta a un padre: sonriendo."
    ichika "And I answered you the way you answer a father: smiling."

# game/02_cap1_final_malo.rpy:235
translate english final_malo_beat_63410442:

    # ichika "No sirvió de nada."
    ichika "It didn't do any good."

# game/02_cap1_final_malo.rpy:242
translate english final_malo_beat_8d067f86:

    # yotsuba "Pero si él... él solo estaba..."
    yotsuba "But he... he was only..."

# game/02_cap1_final_malo.rpy:248
translate english final_malo_beat_e0b53ddf:

    # nino "Yotsuba."
    nino "Yotsuba."

# game/02_cap1_final_malo.rpy:254
translate english final_malo_beat_5ce3baf5:

    # yotsuba "...No dije nada."
    yotsuba "...I didn't say anything."

# game/02_cap1_final_malo.rpy:256
translate english final_malo_beat_1a1ef932:

    # narrador "Se quedó mirando el suelo, con las manos juntas delante."
    narrador "She stood looking at the floor, her hands clasped in front of her."

# game/02_cap1_final_malo.rpy:260
translate english final_malo_beat_7b8e15d8:

    # narrador "Después, me miró a mí."
    narrador "Then she looked at me."

# game/02_cap1_final_malo.rpy:265
translate english final_malo_beat_f28d09e2:

    # yotsuba "Me dijiste que me concentrara en correr."
    yotsuba "You told me to focus on running."

# game/02_cap1_final_malo.rpy:267
translate english final_malo_beat_1300f403:

    # yotsuba "Dejé de contar en voz alta. Pensé que así servía más."
    yotsuba "I stopped counting out loud. I thought that was more useful."

# game/02_cap1_final_malo.rpy:269
translate english final_malo_beat_5453fcd3:

    # yotsuba "Ahora no sé si servía de algo."
    yotsuba "Now I don't know if it was any use at all."

# game/02_cap1_final_malo.rpy:276
translate english final_malo_beat_36127a86:

    # miku "...Yo no pedí esto."
    miku "...I didn't ask for this."

# game/02_cap1_final_malo.rpy:278
translate english final_malo_beat_ae86b4a9:

    # miku "...Tampoco lo evité."
    miku "...I didn't prevent it, either."

# game/02_cap1_final_malo.rpy:280
translate english final_malo_beat_3a1a06af:

    # narrador "Se llevó las manos a los audífonos."
    narrador "She brought her hands up to her headphones."

