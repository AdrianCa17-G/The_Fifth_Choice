# game/02_cap1_final_malo.rpy:1466
translate english final_malo_hub3_a02ee6f0:

    # narrador "Entonces vio mi cara."
    narrador "Then she saw my face."

# game/02_cap1_final_malo.rpy:1468
translate english final_malo_hub3_45d83473:

    # narrador "Y se le apagó la sonrisa entera."
    narrador "And her whole smile went out."

# game/02_cap1_final_malo.rpy:1476
translate english final_malo_hub3_7b5cf030:

    # isanari "Maruo me llamó. Hace una hora."
    isanari "Maruo called me. An hour ago."

# game/02_cap1_final_malo.rpy:1478
translate english final_malo_hub3_b7a608d6:

    # raiha "¿Llamó por qué?"
    raiha "Called about what?"

# game/02_cap1_final_malo.rpy:1480
translate english final_malo_hub3_8c0b6581:

    # isanari "Díselo tú."
    isanari "You tell her."

# game/02_cap1_final_malo.rpy:1482
translate english final_malo_hub3_0fadd571:

    # mc "Me despidieron, Raiha."
    mc "I got fired, Raiha."

# game/02_cap1_final_malo.rpy:1487
translate english final_malo_hub3_e86723a7:

    # raiha "...¿Qué?"
    raiha "...What?"

# game/02_cap1_final_malo.rpy:1489
translate english final_malo_hub3_3d59976f:

    # mc "Cuatro reprobaron. Y yo... no pude hacer nada."
    mc "Four of them failed. And I... couldn't do anything."

# game/02_cap1_final_malo.rpy:1491
translate english final_malo_hub3_75268e7e:

    # mc "Tuve un mes. Y tuve una última oportunidad."
    mc "I had a month. And I had a last chance."

# game/02_cap1_final_malo.rpy:1493
translate english final_malo_hub3_9268d68f:

    # mc "Y no la aproveché."
    mc "And I didn't take it."

# game/02_cap1_final_malo.rpy:1495
translate english final_malo_hub3_ef87362e:

    # raiha "Pero dijiste que no eran tontas."
    raiha "But you said they weren't dumb."

# game/02_cap1_final_malo.rpy:1497
translate english final_malo_hub3_5b0484dd:

    # mc "Y no lo son."
    mc "They aren't."

# game/02_cap1_final_malo.rpy:1499
translate english final_malo_hub3_364cdd16:

    # raiha "Entonces no entiendo el problema."
    raiha "Then I don't understand the problem."

# game/02_cap1_final_malo.rpy:1501
translate english final_malo_hub3_81881d76:

    # narrador "Lo dijo igual que aquella noche."
    narrador "She said it just like that night."

# game/02_cap1_final_malo.rpy:1503
translate english final_malo_hub3_547acc47:

    # narrador "Solo que esta vez la voz le temblaba."
    narrador "Only this time her voice shook."

# game/02_cap1_final_malo.rpy:1505
translate english final_malo_hub3_b74d1a52:

    # isanari "Esa familia pagaba cinco veces la tarifa."
    isanari "That family paid five times the rate."

# game/02_cap1_final_malo.rpy:1507
translate english final_malo_hub3_77f518e2:

    # isanari "Cubría lo que ni tú ni yo cubrimos."
    isanari "It covered what neither you nor I could."

# game/02_cap1_final_malo.rpy:1509
translate english final_malo_hub3_541af1f5:

    # isanari "No te lo digo para hundirte."
    isanari "I'm not telling you this to sink you."

# game/02_cap1_final_malo.rpy:1511
translate english final_malo_hub3_a1e48e70:

    # isanari "Conté con eso. Y no tenía derecho a contar contigo para eso."
    isanari "I counted on it. And I had no right to count on you for it."

# game/02_cap1_final_malo.rpy:1513
translate english final_malo_hub3_1eecf46d:

    # raiha "Papá, déjalo."
    raiha "Dad, leave him alone."

# game/02_cap1_final_malo.rpy:1515
translate english final_malo_hub3_6976bd8e:

    # isanari "..."
    isanari "..."

# game/02_cap1_final_malo.rpy:1517
translate english final_malo_hub3_069529a2:

    # narrador "Mi padre se sentó. No dijo nada más."
    narrador "My father sat down. He said nothing more."

# game/02_cap1_final_malo.rpy:1519
translate english final_malo_hub3_a4e14056:

    # raiha "...No pasa nada, hermanito."
    raiha "...It's okay, big brother."

# game/02_cap1_final_malo.rpy:1521
translate english final_malo_hub3_a0c3bbe5:

    # raiha "Vamos a comer. El curry se enfría."
    raiha "Let's eat. The curry's getting cold."

# game/02_cap1_final_malo.rpy:1523
translate english final_malo_hub3_c03e43df:

    # narrador "Nos sentamos. El ambiente era de todo menos alegre."
    narrador "We sat down. The mood was anything but cheerful."

# game/02_cap1_final_malo.rpy:1525
translate english final_malo_hub3_08c5a4c2:

    # mc "Gracias por la comida."
    mc "Thanks for the food."

# game/02_cap1_final_malo.rpy:1527
translate english final_malo_hub3_b6abee57:

    # narrador "Lo dije por costumbre."
    narrador "I said it out of habit."

# game/02_cap1_final_malo.rpy:1529
translate english final_malo_hub3_7d4982c4:

    # narrador "Era la primera vez que no sentía nada al decirlo."
    narrador "It was the first time I felt nothing saying it."

# game/02_cap1_final_malo.rpy:1544
translate english final_malo_hub3_30c6ecd7:

    # narrador "Abrí la libreta. La página de los cinco nombres."
    narrador "I opened the notebook. The page with the five names."

# game/02_cap1_final_malo.rpy:1546
translate english final_malo_hub3_a5989fb9:

    # mc_pensamiento "«De frente y las cinco a la vez, pierdo siempre.»"
    mc_pensamiento "\"Head-on, all five at once, I always lose.\""

# game/02_cap1_final_malo.rpy:1548
translate english final_malo_hub3_aa5805a7:

    # mc_pensamiento "Fui de una en una. Y perdí igual."
    mc_pensamiento "I went one at a time. And I lost anyway."

# game/02_cap1_final_malo.rpy:1550
translate english final_malo_hub3_0793068e:

    # mc_pensamiento "Tres tardes que me dieron."
    mc_pensamiento "Three afternoons they gave me."

# game/02_cap1_final_malo.rpy:1552
translate english final_malo_hub3_54465ddb:

    # mc_pensamiento "Treinta días."
    mc_pensamiento "Thirty days."

# game/02_cap1_final_malo.rpy:1554
translate english final_malo_hub3_411bfc7f:

    # mc_pensamiento "Los usé todos. Y no cambié a ninguna."
    mc_pensamiento "I used them all. And I didn't change a single one of them."

# game/02_cap1_final_malo.rpy:1556
translate english final_malo_hub3_8dc656a6:

    # mc_pensamiento "Me permití el lujo de equivocarme."
    mc_pensamiento "I allowed myself the luxury of being wrong."

# game/02_cap1_final_malo.rpy:1558
translate english final_malo_hub3_c6fccb41:

    # mc_pensamiento "Y salió caro."
    mc_pensamiento "And it cost me."

# game/02_cap1_final_malo.rpy:1560
translate english final_malo_hub3_b7c53dc0:

    # narrador "Cerré la libreta. Apagué la lámpara."
    narrador "I closed the notebook. Turned off the lamp."

# game/02_cap1_final_malo.rpy:1562
translate english final_malo_hub3_b8481e11:

    # narrador "Y ahí terminó."
    narrador "And that was the end."

