    # mc "...¿Perdón?"
    mc "...Sorry?"

# game/02_cap1_final_malo.rpy:63
translate english final_malo_beat_5deedac5:

    # maruo "El contrato queda terminado. Tu padre cobrará lo trabajado hasta hoy."
    maruo "The contract is terminated. Your father will be paid for the work done up to today."

# game/02_cap1_final_malo.rpy:65
translate english final_malo_beat_a58623d6:

    # mc "Señor, todavía quedan semanas. Si me deja explicarle..."
    mc "Sir, there are still weeks left. If you'll let me explain..."

# game/02_cap1_final_malo.rpy:70
translate english final_malo_beat_e09981af:

    # maruo "No hay nada que explicar."
    maruo "There is nothing to explain."

# game/02_cap1_final_malo.rpy:72
translate english final_malo_beat_4d56fe6b:

    # maruo "Anoche revisé sus cuadernos. Los cinco."
    maruo "Last night I went through their notebooks. All five."

# game/02_cap1_final_malo.rpy:74
translate english final_malo_beat_e0e7fdc6:

    # maruo "Muchas tardes con mis hijas, y ninguna está más cerca de aprobar que el primer día."
    maruo "Many afternoons with my daughters, and not one is any closer to passing than on the first day."

# game/02_cap1_final_malo.rpy:76
translate english final_malo_beat_2f75211f:

    # maruo "Las condiciones las sabías desde el principio."
    maruo "You knew the conditions from the beginning."

# game/02_cap1_final_malo.rpy:78
translate english final_malo_beat_20a51be1:

    # mc "Por favor, solo un..."
    mc "Please, just one..."

# game/02_cap1_final_malo.rpy:80
translate english final_malo_beat_4bb30095:

    # maruo "No."
    maruo "No."

# game/02_cap1_final_malo.rpy:82
translate english final_malo_beat_5a7674e3:

    # narrador "No levantó la voz. Nunca la levanta."
    narrador "He didn't raise his voice. He never does."

# game/02_cap1_final_malo.rpy:84
translate english final_malo_beat_64083864:

    # narrador "Eso fue lo peor. Ni siquiera sonaba enfadado. Sonaba igual."
    narrador "That was the worst of it. He didn't even sound angry. He sounded the same as always."

# game/02_cap1_final_malo.rpy:86
translate english final_malo_beat_941b48aa:

    # narrador "Nino miraba entre los dos. Quiso decir algo."
    narrador "Nino looked between the two of us. She started to say something."

# game/02_cap1_final_malo.rpy:88
translate english final_malo_beat_a35dcbca:

    # narrador "Pero no lo dijo."
    narrador "But she didn't."

# game/02_cap1_final_malo.rpy:94
translate english final_malo_beat_f7d69bce:

    # narrador "Recogió la taza y salió de la cocina sin esperar respuesta."
    narrador "He picked up the cup and left the kitchen without waiting for an answer."

# game/02_cap1_final_malo.rpy:96
translate english final_malo_beat_09c9220c:

    # narrador "Dándonos la espalda a los dos por igual."
    narrador "His back to both of us alike."

# game/02_cap1_final_malo.rpy:98
translate english final_malo_beat_947de305:

    # mc_pensamiento "Lo que ella había pedido a gritos acababa de pasar sin que nadie gritara."
    mc_pensamiento "What she'd demanded at the top of her lungs had just happened, and nobody had shouted."

# game/02_cap1_final_malo.rpy:115
translate english final_malo_beat_7fbdb494:

    # nino "Me dijiste que ibas a durar."
    nino "You told me you'd last."

# game/02_cap1_final_malo.rpy:117
translate english final_malo_beat_5d06c2b7:

    # nino "..."
    nino "..."

# game/02_cap1_final_malo.rpy:119
translate english final_malo_beat_93797c46:

    # nino "Ya ves."
    nino "Guess not."

# game/02_cap1_final_malo.rpy:121
translate english final_malo_beat_2659053f:

    # narrador "Nino no se movió. Seguía con las manos apoyadas en la mesa."
    narrador "Nino didn't move. Her hands were still on the table."

# game/02_cap1_final_malo.rpy:123
translate english final_malo_beat_0fd279aa:

    # narrador "Hacía un minuto me quería fuera. Ahora me tenía fuera."
    narrador "A minute ago she wanted me out. Now she had me out."

# game/02_cap1_final_malo.rpy:125
translate english final_malo_beat_5d06c2b7_1:

    # nino "..."
    nino "..."

# game/02_cap1_final_malo.rpy:127
translate english final_malo_beat_6343bfa7:

    # nino "Bueno."
    nino "Well."

# game/02_cap1_final_malo.rpy:129
translate english final_malo_beat_8c80f31a:

    # mc "¿«Bueno»? ¿Y así nomás?"
    mc "\"Well\"? Just like that?"

# game/02_cap1_final_malo.rpy:131
translate english final_malo_beat_cb36eaec:

    # nino "Era lo que pedí. ¿Qué esperabas? ¿Que me pusiera a llorar por ti?"
    nino "It's what I asked for. What did you expect? For me to cry over you?"

# game/02_cap1_final_malo.rpy:133
translate english final_malo_beat_cf67458d:

    # narrador "Lo dijo con esa mirada fría, como siempre."
    narrador "She said it with that cold look, like always."

# game/02_cap1_final_malo.rpy:135
translate english final_malo_beat_87ab12d3:

    # narrador "Pero la frase le tardó medio segundo de más en salir."
    narrador "But the sentence took half a second too long to come out."

# game/02_cap1_final_malo.rpy:137
translate english final_malo_beat_6acac926:

    # nino "El último duró cuatro días. Tú aguantaste más."
    nino "The last one lasted four days. You held out longer."

# game/02_cap1_final_malo.rpy:139
translate english final_malo_beat_8606b6fe:

    # nino "No es un cumplido."
    nino "That's not a compliment."

# game/02_cap1_final_malo.rpy:141
translate english final_malo_beat_6beeff78:

    # nino "Aunque sí deberías sentirte orgulloso."
    nino "Though you should feel proud."

# game/02_cap1_final_malo.rpy:143
translate english final_malo_beat_d7b5dac3:

    # mc_pensamiento "Tenía que sentirse como ganar. Ella lo sabía. Yo lo sabía."
    mc_pensamiento "It should have felt like winning. She knew it. I knew it."

# game/02_cap1_final_malo.rpy:145
translate english final_malo_beat_6cd79e28:

    # mc_pensamiento "Y tenía la cara de quien consigue justo lo que pidió."
    mc_pensamiento "And she had the face of someone who got exactly what she asked for."

# game/02_cap1_final_malo.rpy:147
translate english final_malo_beat_26418847:

    # mc_pensamiento "Pero sin un sabor de victoria."
    mc_pensamiento "But without any taste of victory."

# game/02_cap1_final_malo.rpy:149
translate english final_malo_beat_2a629993:

    # nino "Es mejor así. Hoy. Antes de que se ilusionen más."
    nino "It's better this way. Today. Before they get their hopes up any more."

# game/02_cap1_final_malo.rpy:151
translate english final_malo_beat_dbb97551:

    # mc "Nino..."
    mc "Nino..."

# game/02_cap1_final_malo.rpy:153
translate english final_malo_beat_34e5e132:

    # nino "Y no me mires con esa cara de pena. No te va a servir de nada."
    nino "And don't look at me with that pitying face. It won't do you any good."

# game/02_cap1_final_malo.rpy:164
translate english final_malo_beat_c0f20a84:

    # narrador "No pasó ni un minuto."
    narrador "It didn't even take a minute."

# game/02_cap1_final_malo.rpy:166
translate english final_malo_beat_f4a0b558:

    # narrador "Las cuatro aparecieron por el pasillo casi a la vez."
    narrador "The four of them appeared down the hallway almost at once."

# game/02_cap1_final_malo.rpy:168
translate english final_malo_beat_51e9026d:

    # narrador "Con cara de haberse levantado de golpe."
    narrador "Looking like they'd jumped out of bed."

# game/02_cap1_final_malo.rpy:180
translate english final_malo_beat_9b3ea8d4:

    # yotsuba "¡Se oyó hasta la escalera!"
    yotsuba "We heard it all the way down the stairs!"

# game/02_cap1_final_malo.rpy:182
translate english final_malo_beat_4f95fdf7:

    # yotsuba "Y vimos a papá retirándose del edificio."
    yotsuba "And we saw Dad leaving the building."

# game/02_cap1_final_malo.rpy:184
translate english final_malo_beat_233c2856:

    # yotsuba "¿Quién gritaba? ¿Fue...?"
    yotsuba "Who was shouting? Was it...?"

# game/02_cap1_final_malo.rpy:186
translate english final_malo_beat_8e53c00b:

    # narrador "Se detuvo al verme la cara."
    narrador "She stopped when she saw my face."

# game/02_cap1_final_malo.rpy:192
translate english final_malo_beat_9e64fe75:

    # ichika "Dime que fue una de las discusiones de siempre, Nino."
    ichika "Tell me it was one of the usual fights, Nino."

