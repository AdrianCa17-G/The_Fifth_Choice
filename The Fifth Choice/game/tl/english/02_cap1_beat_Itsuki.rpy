# game/02_cap1_beat_Itsuki.rpy:40
translate english beat_Itsuki_5e0a65da:

    # narrador "Subí a la azotea a la hora del almuerzo, más por costumbre que por otra cosa."
    narrador "I went up to the rooftop at lunchtime, more out of habit than anything else."

# game/02_cap1_beat_Itsuki.rpy:42
translate english beat_Itsuki_c6b0d4be:

    # mc_pensamiento "Desde el primer día, es el único sitio del instituto donde nadie me pide nada."
    mc_pensamiento "Since day one, it's the only place in the school where nobody asks anything of me."

# game/02_cap1_beat_Itsuki.rpy:44
translate english beat_Itsuki_802abfda:

    # narrador "La puerta ya estaba abierta."
    narrador "The door was already open."

# game/02_cap1_beat_Itsuki.rpy:51
translate english beat_Itsuki_863d6f98:

    # mc_pensamiento "Ahí estaba. Con el cuaderno."
    mc_pensamiento "There she was. With the notebook."

# game/02_cap1_beat_Itsuki.rpy:53
translate english beat_Itsuki_630e85e9:

    # mc_pensamiento "El mismo cuaderno de ciencias que siempre lleva encima."
    mc_pensamiento "The same science notebook she always carries."

# game/02_cap1_beat_Itsuki.rpy:55
translate english beat_Itsuki_ed15eee3:

    # narrador "No lo estaba leyendo."
    narrador "She wasn't reading it."

# game/02_cap1_beat_Itsuki.rpy:57
translate english beat_Itsuki_7c58c637:

    # narrador "Lo tenía abierto en una página y la vista en otro lado."
    narrador "It was open to a page, and her eyes were somewhere else."

# game/02_cap1_beat_Itsuki.rpy:61
translate english beat_Itsuki_ba599415:

    # narrador "Desde la puerta alcancé a ver la página."
    narrador "From the door, I could just make out the page."

# game/02_cap1_beat_Itsuki.rpy:63
translate english beat_Itsuki_3b743265:

    # narrador "Un solo ejercicio, con un círculo a lápiz alrededor."
    narrador "One exercise, circled in pencil."

# game/02_cap1_beat_Itsuki.rpy:65
translate english beat_Itsuki_2fa95670:

    # narrador "Repasado tantas veces que había hundido el papel."
    narrador "Gone over so many times it had dented the paper."

# game/02_cap1_beat_Itsuki.rpy:67
translate english beat_Itsuki_f1bb5e95:

    # mc_pensamiento "Lo reconocí."
    mc_pensamiento "I recognized it."

# game/02_cap1_beat_Itsuki.rpy:69
translate english beat_Itsuki_232f2d80:

    # mc_pensamiento "Era el de la hoja de diagnóstico del primer día."
    mc_pensamiento "It was from the diagnostic sheet on day one."

# game/02_cap1_beat_Itsuki.rpy:71
translate english beat_Itsuki_51321563:

    # mc_pensamiento "El que la tuvo tres minutos atascada mientras yo le decía que no pensaba ayudarla."
    mc_pensamiento "The one that kept her stuck for three minutes while I told her I wasn't going to help."

# game/02_cap1_beat_Itsuki.rpy:73
translate english beat_Itsuki_ff705aa2:

    # mc_pensamiento "La primera vez que subí aquí, ella dijo que venía a tomar aire."
    mc_pensamiento "The first time I came up here, she said she'd come for some air."

# game/02_cap1_beat_Itsuki.rpy:75
translate english beat_Itsuki_8eb326b3:

    # mc_pensamiento "A alejarse de gente desagradable."
    mc_pensamiento "To get away from unpleasant people."

# game/02_cap1_beat_Itsuki.rpy:77
translate english beat_Itsuki_1cdee404:

    # mc_pensamiento "Esa gente desagradable era yo."
    mc_pensamiento "Those unpleasant people were me."

# game/02_cap1_beat_Itsuki.rpy:79
translate english beat_Itsuki_e888bbee:

    # mc_pensamiento "Y hoy trajo el cuaderno de todas formas, al mismo sitio del que dijo que venía a escapar."
    mc_pensamiento "And today she brought the notebook anyway, to the same place she said she came to escape."

# game/02_cap1_beat_Itsuki.rpy:81
translate english beat_Itsuki_beaafcb8:

    # mc_pensamiento "Sin nada de comer al lado."
    mc_pensamiento "With nothing to eat beside her."

# game/02_cap1_beat_Itsuki.rpy:83
translate english beat_Itsuki_75c8b022:

    # mc_pensamiento "Ya van varias veces que la veo así, en apenas unos días."
    mc_pensamiento "That's several times now I've seen her like this, in just a few days."

# game/02_cap1_beat_Itsuki.rpy:88
translate english beat_Itsuki_46b72098:

    # narrador "Me senté a un par de metros, sin decir nada todavía."
    narrador "I sat down a few feet away, not saying anything yet."

# game/02_cap1_beat_Itsuki.rpy:96
translate english beat_Itsuki_4259f17a:

    # itsuki "No te oí llegar."
    itsuki "I didn't hear you come in."

# game/02_cap1_beat_Itsuki.rpy:98
translate english beat_Itsuki_60f606b4:

    # mc "No hice ruido a propósito."
    mc "I kept quiet on purpose."

# game/02_cap1_beat_Itsuki.rpy:100
translate english beat_Itsuki_8f246bc9:

    # itsuki "Da igual. Ya estás aquí."
    itsuki "It doesn't matter. You're here now."

# game/02_cap1_beat_Itsuki.rpy:102
translate english beat_Itsuki_145e3603:

    # narrador "Lo dijo sin la hostilidad de siempre. Sonó más a un hecho que a una queja."
    narrador "She said it without her usual hostility. It sounded more like a fact than a complaint."

# game/02_cap1_beat_Itsuki.rpy:110
translate english beat_Itsuki_a6f9f702:

    # mc "Pensé que este sitio era donde no estudiabas."
    mc "I thought this was the place where you didn't study."

# game/02_cap1_beat_Itsuki.rpy:112
translate english beat_Itsuki_f78d82ec:

    # itsuki "Y lo era."
    itsuki "It was."

# game/02_cap1_beat_Itsuki.rpy:114
translate english beat_Itsuki_4ea5e07e:

    # narrador "Cerró el cuaderno, pero no lo guardó."
    narrador "She closed the notebook, but she didn't put it away."

# game/02_cap1_beat_Itsuki.rpy:116
translate english beat_Itsuki_e7e2150d:

    # narrador "Se quedó con la mano encima, como si todavía no hubiera decidido qué hacer con él."
    narrador "She kept her hand on top of it, as if she hadn't decided what to do with it yet."

# game/02_cap1_beat_Itsuki.rpy:118
translate english beat_Itsuki_e58c6a42:

    # itsuki "Ya no me queda ningún sitio que no lo sea."
    itsuki "I have no place left that isn't."

# game/02_cap1_beat_Itsuki.rpy:120
translate english beat_Itsuki_13ca1c1c:

    # narrador "Fue una frase corta. Más corta que las suyas de costumbre."
    narrador "It was a short sentence. Shorter than her usual ones."

# game/02_cap1_beat_Itsuki.rpy:122
translate english beat_Itsuki_022decdb:

    # mc_pensamiento "No se cortó a media idea. La terminó."
    mc_pensamiento "She didn't trail off mid-thought. She finished it."

# game/02_cap1_beat_Itsuki.rpy:124
translate english beat_Itsuki_53ca2ad6:

    # mc_pensamiento "Simplemente no tenía más que decir, y eso es distinto."
    mc_pensamiento "She just had nothing more to say, and that's different."

# game/02_cap1_beat_Itsuki.rpy:126
translate english beat_Itsuki_713904f1:

    # narrador "Extendí la mano hacia la mochila y saqué mi propio libro."
    narrador "I reached for my bag and pulled out a book of my own."

# game/02_cap1_beat_Itsuki.rpy:128
translate english beat_Itsuki_7707772d:

    # itsuki "¿Tú también?"
    itsuki "You too?"

# game/02_cap1_beat_Itsuki.rpy:130
translate english beat_Itsuki_3a800c32:

    # mc "Yo desde antes de que fuera tu tutor."
    mc "Since before I was your tutor."

# game/02_cap1_beat_Itsuki.rpy:132
translate english beat_Itsuki_9239f19c:

    # narrador "No dijo nada a eso. Pero tampoco volvió a abrir su cuaderno."
    narrador "She didn't answer that. But she didn't open her notebook again, either."

# game/02_cap1_beat_Itsuki.rpy:134
translate english beat_Itsuki_b15c6684:

    # mc "No hay mesa aquí arriba."
    mc "There's no table up here."

# game/02_cap1_beat_Itsuki.rpy:136
translate english beat_Itsuki_87b9593c:

    # itsuki "No hace falta mesa para tener un cuaderno abierto."
    itsuki "You don't need a table to have a notebook open."

# game/02_cap1_beat_Itsuki.rpy:138
translate english beat_Itsuki_f8c34236:

    # mc "Pero no lo tienes abierto para leerlo."
    mc "But you're not holding it open to read it."

# game/02_cap1_beat_Itsuki.rpy:140
translate english beat_Itsuki_97eba050:

    # itsuki "..."
    itsuki "..."

# game/02_cap1_beat_Itsuki.rpy:142
translate english beat_Itsuki_f4c87f5b:

    # narrador "No contestó."
    narrador "She didn't answer."

# game/02_cap1_beat_Itsuki.rpy:144
translate english beat_Itsuki_755b4911:

    # narrador "Cambió el cuaderno de posición sobre las rodillas."
    narrador "She shifted the notebook on her knees."

# game/02_cap1_beat_Itsuki.rpy:146
translate english beat_Itsuki_ee63a17c:

    # narrador "Como si reacomodarlo fuera, de algún modo, una respuesta."
    narrador "As if rearranging it were, somehow, an answer."

# game/02_cap1_beat_Itsuki.rpy:148
translate english beat_Itsuki_967f2777:

    # mc_pensamiento "Lo trajo por costumbre, no porque pensara usarlo."
    mc_pensamiento "She brought it out of habit, not because she meant to use it."

# game/02_cap1_beat_Itsuki.rpy:150
translate english beat_Itsuki_4904d129:

    # mc_pensamiento "Como quien ya no sabe estar en un sitio sin la excusa de tener algo que hacer ahí."
    mc_pensamiento "Like someone who no longer knows how to be anywhere without an excuse to be busy there."

# game/02_cap1_beat_Itsuki.rpy:155
translate english beat_Itsuki_85ebeff8:

    # narrador "Tenía las manos apoyadas sobre la tapa, quietas. Sin una sola mancha de tinta."
    narrador "Her hands rested on the cover, still. Not a single ink smudge."

# game/02_cap1_beat_Itsuki.rpy:157
translate english beat_Itsuki_61008e06:

    # mc_pensamiento "No había escrito nada en toda la mañana."
    mc_pensamiento "She hadn't written anything all morning."

# game/02_cap1_beat_Itsuki.rpy:159
translate english beat_Itsuki_15263854:

    # mc_pensamiento "Ella, que llena una hoja de tachones antes que nadie termine la primera línea."
    mc_pensamiento "Her, of all people, who crosses out half a page before anyone else finishes a line."

# game/02_cap1_beat_Itsuki.rpy:163
translate english beat_Itsuki_449555e5:

    # narrador "El viento seguía soplando igual que siempre aquí arriba."
    narrador "The wind kept blowing the way it always does up here."

# game/02_cap1_beat_Itsuki.rpy:165
translate english beat_Itsuki_b1eff768:

    # narrador "Pero por debajo de él comenzó a percibirse otra cosa..."
    narrador "But underneath it, something else began to come through..."

# game/02_cap1_beat_Itsuki.rpy:167
translate english beat_Itsuki_21e21582:

    # narrador "Un sonido tenue, casi imperceptible."
    narrador "A faint sound, barely noticeable."

# game/02_cap1_beat_Itsuki.rpy:169
translate english beat_Itsuki_e9a70ffb:

    # itsuki "¿Vas a preguntarme por qué lo traje?"
    itsuki "Are you going to ask me why I brought it?"

# game/02_cap1_beat_Itsuki.rpy:171
translate english beat_Itsuki_fca52711:

    # mc "No."
    mc "No."

# game/02_cap1_beat_Itsuki.rpy:173
translate english beat_Itsuki_bd67bfc5:

    # itsuki "...¿Por qué no?"
    itsuki "...Why not?"

# game/02_cap1_beat_Itsuki.rpy:175
translate english beat_Itsuki_46306375:

    # mc "Porque ya lo sé."
    mc "Because I already know."

# game/02_cap1_beat_Itsuki.rpy:177
translate english beat_Itsuki_c4e74035:

    # narrador "No contestó. Pero no volvió a preguntar tampoco."
    narrador "She didn't answer. But she didn't ask again, either."

# game/02_cap1_beat_Itsuki.rpy:187
translate english beat_Itsuki_dc6d25ea:

    # itsuki "Ya me ayudaste con el ejercicio el otro día."
    itsuki "You already helped me with that exercise the other day."

# game/02_cap1_beat_Itsuki.rpy:189
translate english beat_Itsuki_27f94400:

    # itsuki "No hace falta que sigas viniendo a comprobar cómo voy."
    itsuki "There's no need to keep coming around to check on me."

# game/02_cap1_beat_Itsuki.rpy:191
translate english beat_Itsuki_57a27eec:

    # mc "No vine a comprobar nada."
    mc "I didn't come to check on anything."

# game/02_cap1_beat_Itsuki.rpy:193
translate english beat_Itsuki_6e4031fc:

    # narrador "No pareció creérselo del todo."
    narrador "She didn't quite seem to believe it."

# game/02_cap1_beat_Itsuki.rpy:195
translate english beat_Itsuki_1d059b99:

    # narrador "Pero no insistió."
    narrador "But she didn't push."

# game/02_cap1_beat_Itsuki.rpy:202
translate english beat_Itsuki_3d291888:

    # itsuki "Ya me resolviste el ejercicio el otro día."
    itsuki "You already solved that exercise for me the other day."

# game/02_cap1_beat_Itsuki.rpy:204
translate english beat_Itsuki_27f94400_1:

    # itsuki "No hace falta que sigas viniendo a comprobar cómo voy."
    itsuki "There is no need to keep coming around to check on me."

# game/02_cap1_beat_Itsuki.rpy:206
translate english beat_Itsuki_57a27eec_1:

    # mc "No vine a comprobar nada."
    mc "I didn't come to check on anything."

# game/02_cap1_beat_Itsuki.rpy:208
translate english beat_Itsuki_6e4031fc_1:

    # narrador "No pareció creérselo del todo."
    narrador "She didn't quite seem to believe it."

# game/02_cap1_beat_Itsuki.rpy:210
translate english beat_Itsuki_1d059b99_1:

    # narrador "Pero no insistió."
    narrador "But she didn't push."

# game/02_cap1_beat_Itsuki.rpy:217
translate english beat_Itsuki_96879607:

    # itsuki "No voy a preguntarte cómo va tu juego."
    itsuki "I'm not going to ask how your little game is going."

# game/02_cap1_beat_Itsuki.rpy:219
translate english beat_Itsuki_291f4f89:

    # mc "No te lo iba a contar de todas formas."
    mc "I wasn't going to tell you anyway."

# game/02_cap1_beat_Itsuki.rpy:222
translate english beat_Itsuki_33136421:

    # narrador "Los dos volvimos a mirar al frente, cada uno con su propio libro cerrado sobre las piernas."
    narrador "We both went back to looking straight ahead, a closed book on each of our laps."

# game/02_cap1_beat_Itsuki.rpy:224
translate english beat_Itsuki_bdd9c04c:

    # mc_pensamiento "Pocos días, y esto ya es jornada completa. Para los dos."
    mc_pensamiento "A few days in, and this is already full-time. For both of us."

# game/02_cap1_beat_Itsuki.rpy:226
translate english beat_Itsuki_13832e89:

    # mc_pensamiento "Ella tampoco tiene dónde bajar la guardia."
    mc_pensamiento "She has nowhere to let her guard down, either."

# game/02_cap1_beat_Itsuki.rpy:228
translate english beat_Itsuki_7854f898:

    # mc_pensamiento "Yo tampoco."
    mc_pensamiento "Neither do I."

# game/02_cap1_beat_Itsuki.rpy:230
translate english beat_Itsuki_56c63c53:

    # narrador "Nos quedamos ahí un rato largo, sin abrir ninguno de los dos libros."
    narrador "We stayed there a good while, neither of us opening a book."

# game/02_cap1_beat_Itsuki.rpy:232
translate english beat_Itsuki_aece918b:

    # narrador "El viento se llevó una hoja suelta de mi cuaderno hasta la valla."
    narrador "The wind carried a loose page from my notebook over to the fence."

# game/02_cap1_beat_Itsuki.rpy:234
translate english beat_Itsuki_6af2582d:

    # narrador "Ninguno de los dos se levantó a buscarla."
    narrador "Neither of us got up to get it."

# game/02_cap1_beat_Itsuki.rpy:236
translate english beat_Itsuki_ea9ba80a:

    # mc_pensamiento "Antes de este trabajo me habría importado esa hoja."
    mc_pensamiento "Before this job, I'd have cared about that page."

# game/02_cap1_beat_Itsuki.rpy:238
translate english beat_Itsuki_023a873e:

    # mc_pensamiento "Ahora me importa más no moverme."
    mc_pensamiento "Now I care more about not moving."

# game/02_cap1_beat_Itsuki.rpy:240
translate english beat_Itsuki_0d7061bd:

    # narrador "Entonces sonó algo que no era el viento."
    narrador "Then came a sound that wasn't the wind."

# game/02_cap1_beat_Itsuki.rpy:249
translate english beat_Itsuki_cede3640:

    # itsuki "Eso no fue mi estómago."
    itsuki "That was not my stomach."

# game/02_cap1_beat_Itsuki.rpy:251
translate english beat_Itsuki_b2054ef5:

    # mc "No dije nada."
    mc "I didn't say anything."

# game/02_cap1_beat_Itsuki.rpy:253
translate english beat_Itsuki_0ffdd0d1:

    # itsuki "Lo ibas a decir."
    itsuki "You were about to."

# game/02_cap1_beat_Itsuki.rpy:255
translate english beat_Itsuki_7867a738:

    # narrador "Saqué la caja de almuerzo que Raiha me había preparado y la abrí entre los dos."
    narrador "I took out the lunch box Raiha had packed for me and opened it between us."

# game/02_cap1_beat_Itsuki.rpy:257
translate english beat_Itsuki_a247daad:

    # mc "Raiha siempre pone de más. Dice que estudio con el estómago vacío."
    mc "Raiha always packs extra. She says I study on an empty stomach."

# game/02_cap1_beat_Itsuki.rpy:262
translate english beat_Itsuki_b5aa53fc:

    # itsuki "No pienso aceptar comida de mi tutor."
    itsuki "I will not accept food from my tutor."

# game/02_cap1_beat_Itsuki.rpy:264
translate english beat_Itsuki_31d90bef:

    # narrador "Lo dijo mirando el arroz. Fijo. Sin parpadear."
    narrador "She said it staring at the rice. Unblinking."

# game/02_cap1_beat_Itsuki.rpy:266
translate english beat_Itsuki_86b1adc9:

    # mc "Entonces no es del tutor. Es de Raiha."
    mc "Then it's not from the tutor. It's from Raiha."

# game/02_cap1_beat_Itsuki.rpy:268
translate english beat_Itsuki_6f1289f0:

    # itsuki "...Un bocado. Y queda anotado como deuda."
    itsuki "...One bite. And it goes down as a debt."

# game/02_cap1_beat_Itsuki.rpy:270
translate english beat_Itsuki_3775289f:

    # narrador "Fueron cuatro bocados. Yo no dije nada. Ella tampoco lo anotó."
    narrador "It was four bites. I said nothing. She didn't write it down, either."

# game/02_cap1_beat_Itsuki.rpy:272
translate english beat_Itsuki_727df0a9:

    # mc_pensamiento "Desde el primer día no la había vuelto a ver comer."
    mc_pensamiento "I hadn't seen her eat once since the first day."

# game/02_cap1_beat_Itsuki.rpy:274
translate english beat_Itsuki_92abb248:

    # mc_pensamiento "Comía como si se le hubiera olvidado cuánto le gustaba."
    mc_pensamiento "She ate like she'd forgotten how much she liked it."

# game/02_cap1_beat_Itsuki.rpy:289
translate english beat_Itsuki_01d61a81:

    # mc_pensamiento "Ninguno de los dos va a romper el silencio. ¿En qué estoy pensando yo?" nointeract
    mc_pensamiento "Neither of us is going to break the silence. What am I thinking about?" nointeract

# game/02_cap1_beat_Itsuki.rpy:293
translate english beat_Itsuki_87bfaca1:

    # mc "Al menos ahí nadie me interrumpe."
    mc "At least nobody interrupts me there."

# game/02_cap1_beat_Itsuki.rpy:295
translate english beat_Itsuki_b9a00699:

    # itsuki "Qué imagen tan poco digna de un tutor."
    itsuki "Hardly a dignified look for a tutor."

# game/02_cap1_beat_Itsuki.rpy:297
translate english beat_Itsuki_a2e9a1d2:

    # mc "No dije que fuera a hacerlo. Dije que a este paso."
    mc "I didn't say I would. I said at this rate."

# game/02_cap1_beat_Itsuki.rpy:299
translate english beat_Itsuki_3f3e29b7:

    # itsuki "Viendo ese nivel de planificación tuyo..."
    itsuki "With planning like that..."

# game/02_cap1_beat_Itsuki.rpy:301
translate english beat_Itsuki_09f6d42f:

    # itsuki "No me extraña que no logres hacernos estudiar a todas."
    itsuki "No wonder you can't get all of us to study."

# game/02_cap1_beat_Itsuki.rpy:305
translate english beat_Itsuki_cad5bf8d:

    # mc "Y si lo hiciéramos, tampoco cambiaría nada."
    mc "And if we did, it wouldn't change anything."

# game/02_cap1_beat_Itsuki.rpy:307
translate english beat_Itsuki_8edd9f98:

    # itsuki "Habla por ti."
    itsuki "Speak for yourself."

# game/02_cap1_beat_Itsuki.rpy:309
translate english beat_Itsuki_71d25924:

    # itsuki "Yo sí me estoy esforzando en resolver estos ejercicios."
    itsuki "I am actually working on these exercises."

# game/02_cap1_beat_Itsuki.rpy:311
translate english beat_Itsuki_ac800804:

    # itsuki "En comparación contigo..."
    itsuki "Compared to you..."

# game/02_cap1_beat_Itsuki.rpy:313
translate english beat_Itsuki_fdfbd654:

    # mc "Tienes el cuaderno cerrado hace diez minutos."
    mc "Your notebook's been closed for ten minutes."

# game/02_cap1_beat_Itsuki.rpy:318
translate english beat_Itsuki_9b629e92:

    # itsuki "Estoy descansando la vista."
    itsuki "I'm resting my eyes."

# game/02_cap1_beat_Itsuki.rpy:320
translate english beat_Itsuki_30d3903b:

    # itsuki "Es distinto."
    itsuki "That's different."

# game/02_cap1_beat_Itsuki.rpy:324
translate english beat_Itsuki_4daf29fa:

    # mc "No todo necesita un análisis."
    mc "Not everything needs analyzing."

# game/02_cap1_beat_Itsuki.rpy:326
translate english beat_Itsuki_7d2483e6:

    # itsuki "Al menos en eso estamos de acuerdo."
    itsuki "At least we agree on that."

# game/02_cap1_beat_Itsuki.rpy:328
translate english beat_Itsuki_1e89364a:

    # mc "Al parecer es lo primero."
    mc "Apparently that's a first."

# game/02_cap1_beat_Itsuki.rpy:330
translate english beat_Itsuki_ee652f55:

    # itsuki "No te acostumbres."
    itsuki "Don't get used to it."

# game/02_cap1_beat_Itsuki.rpy:344
translate english beat_Itsuki_c148bcd7:

    # narrador "El timbre sonó antes de que ninguno de los dos volviera a abrir un libro."
    narrador "The bell rang before either of us opened a book again."

# game/02_cap1_beat_Itsuki.rpy:349
translate english beat_Itsuki_c50024f2:

    # itsuki "Se acabó el descanso."
    itsuki "The break is over."

# game/02_cap1_beat_Itsuki.rpy:351
translate english beat_Itsuki_3b5f8b66:

    # mc "Se acabó."
    mc "It is."

# game/02_cap1_beat_Itsuki.rpy:356
translate english beat_Itsuki_146b2424:

    # narrador "Se levantó primero."
    narrador "She got up first."

# game/02_cap1_beat_Itsuki.rpy:358
