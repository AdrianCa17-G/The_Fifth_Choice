# game/02_cap1_beat_casa.rpy:32
translate english beat_casa_28bc040b:

    # narrador "Llegué a casa más tarde de lo normal."
    narrador "I got home later than usual."

# game/02_cap1_beat_casa.rpy:34
translate english beat_casa_cc5319d1:

    # narrador "Otra vez."
    narrador "Again."

# game/02_cap1_beat_casa.rpy:36
translate english beat_casa_1058aa43:

    # narrador "El examen era al día siguiente."
    narrador "The exam was the next day."

# game/02_cap1_beat_casa.rpy:38
translate english beat_casa_ca66e571:

    # narrador "Faltaban horas, no días."
    narrador "Hours away, not days."

# game/02_cap1_beat_casa.rpy:42
translate english beat_casa_26ff33cd:

    # mc_pensamiento "Han pasado treinta días."
    mc_pensamiento "Thirty days have gone by."

# game/02_cap1_beat_casa.rpy:44
translate english beat_casa_6d6c3851:

    # mc_pensamiento "Contados desde la noche en que anoté los cinco nombres."
    mc_pensamiento "Counted from the night I wrote down the five names."

# game/02_cap1_beat_casa.rpy:46
translate english beat_casa_1db3baa2:

    # mc_pensamiento "Mañana sabré si sirvieron de algo."
    mc_pensamiento "Tomorrow I'll find out if they were any use."

# game/02_cap1_beat_casa.rpy:48
translate english beat_casa_5f60aa54:

    # narrador "Raiha estaba en la mesa, con su propio cuaderno abierto y la cena ya servida y fría."
    narrador "Raiha was at the table, her own notebook open and dinner already served and cold."

# game/02_cap1_beat_casa.rpy:53
translate english beat_casa_d9077e97:

    # raiha "¡Hermanito!"
    raiha "[mc]!"

# game/02_cap1_beat_casa.rpy:55
translate english beat_casa_5854804d:

    # raiha "Te guardé la cena, pero se enfrió como tres veces."
    raiha "I saved your dinner, but it went cold like three times."

# game/02_cap1_beat_casa.rpy:57
translate english beat_casa_619eb06c:

    # mc "Perdóname, Raiha."
    mc "Sorry, Raiha."

# game/02_cap1_beat_casa.rpy:59
translate english beat_casa_422f5e49:

    # mc "Se me hizo tarde."
    mc "I got held up."

# game/02_cap1_beat_casa.rpy:64
translate english beat_casa_80e67789:

    # raiha "Desde que eres tutor, siempre llegas tarde."
    raiha "Ever since you became a tutor, you're always late."

# game/02_cap1_beat_casa.rpy:66
translate english beat_casa_c17666ad:

    # narrador "No lo dijo con reproche. Lo dijo como quien ya lleva la cuenta."
    narrador "She didn't say it as a reproach. She said it like someone already keeping count."

# game/02_cap1_beat_casa.rpy:74
translate english beat_casa_a6c75f14:

    # narrador "Me senté a comer."
    narrador "I sat down to eat."

# game/02_cap1_beat_casa.rpy:76
translate english beat_casa_7ac1c507:

    # narrador "Raiha no cerró su cuaderno."
    narrador "Raiha didn't close her notebook."

# game/02_cap1_beat_casa.rpy:81
translate english beat_casa_570a8c02:

    # raiha "Hermanito, tengo un problema de matemáticas que no me sale."
    raiha "Big brother, there's a math problem I can't get."

# game/02_cap1_beat_casa.rpy:83
translate english beat_casa_c4eae25d:

    # mc "Muéstrame."
    mc "Show me."

# game/02_cap1_beat_casa.rpy:85
translate english beat_casa_8a093d47:

    # narrador "Lo dije con la boca todavía llena."
    narrador "I said it with my mouth still full."

# game/02_cap1_beat_casa.rpy:87
translate english beat_casa_859a0473:

    # narrador "No pensé en cómo lo dije."
    narrador "I didn't think about how I said it."

# game/02_cap1_beat_casa.rpy:89
translate english beat_casa_98ea9822:

    # narrador "Miré la hoja. El error estaba en el segundo paso."
    narrador "I looked at the sheet. The mistake was in the second step."

# game/02_cap1_beat_casa.rpy:91
translate english beat_casa_e29456ea:

    # mc "¿Revisaste esta línea?"
    mc "Did you check this line?"

# game/02_cap1_beat_casa.rpy:93
translate english beat_casa_c30e9ef5:

    # raiha "¿Cuál?"
    raiha "Which one?"

# game/02_cap1_beat_casa.rpy:95
translate english beat_casa_c276d614:

    # mc "Esta. No te la voy a resolver."
    mc "This one. I'm not going to solve it for you."

# game/02_cap1_beat_casa.rpy:97
translate english beat_casa_024521c9:

    # mc "Solo mira si el signo está bien."
    mc "Just see if the sign is right."

# game/02_cap1_beat_casa.rpy:99
translate english beat_casa_ba6d65d5:

    # narrador "Levantó la vista de la hoja antes de corregir."
    narrador "She looked up from the sheet before correcting it."

# game/02_cap1_beat_casa.rpy:104
translate english beat_casa_cc437ce5:

    # narrador "Dejó el lápiz sobre la mesa, despacio."
    narrador "She set the pencil down on the table, slowly."

# game/02_cap1_beat_casa.rpy:106
translate english beat_casa_15c469f9:

    # raiha "...Hablaste raro."
    raiha "...You sounded weird."

# game/02_cap1_beat_casa.rpy:108
translate english beat_casa_d4507d05:

    # mc "¿Raro cómo?"
    mc "Weird how?"

# game/02_cap1_beat_casa.rpy:110
translate english beat_casa_c70ed59c:

    # raiha "Como un profesor."
    raiha "Like a teacher."

# game/02_cap1_beat_casa.rpy:112
translate english beat_casa_5f698169:

    # raiha "Ni pareces mi hermano cuando dices esas cosas."
    raiha "You don't even sound like my brother when you say stuff like that."

# game/02_cap1_beat_casa.rpy:114
translate english beat_casa_710a763e:

    # narrador "Lo dijo sin mala intención."
    narrador "She said it without meaning anything by it."

# game/02_cap1_beat_casa.rpy:116
translate english beat_casa_c7ef3625:

    # narrador "Con la misma naturalidad con la que señala cualquier otra cosa."
    narrador "With the same ease she'd point out anything else."

# game/02_cap1_beat_casa.rpy:118
translate english beat_casa_318d8e11:

    # mc_pensamiento "No fue un chiste."
    mc_pensamiento "It wasn't a joke."

# game/02_cap1_beat_casa.rpy:120
translate english beat_casa_f1178a45:

    # mc_pensamiento "Se lo tomó como algo raro de verdad."
    mc_pensamiento "She took it as something truly strange."

# game/02_cap1_beat_casa.rpy:122
translate english beat_casa_ac6688d5:

    # mc_pensamiento "Llevo semanas diciéndoles a cinco personas «no te lo voy a resolver, solo mira si está bien»."
    mc_pensamiento "For weeks I've been telling five people \"I won't solve it for you, just check if it's right.\""

# game/02_cap1_beat_casa.rpy:124
translate english beat_casa_dd27313c:

    # mc_pensamiento "Lo he repetido tantas veces que ya no me sale de otra forma."
    mc_pensamiento "I've said it so many times it doesn't come out any other way now."

# game/02_cap1_beat_casa.rpy:126
translate english beat_casa_599a4449:

    # mc_pensamiento "Ni siquiera con ella."
    mc_pensamiento "Not even with her."

# game/02_cap1_beat_casa.rpy:128
translate english beat_casa_b30bee8e:

    # raiha "¿Estás bien?"
    raiha "Are you okay?"

# game/02_cap1_beat_casa.rpy:130
translate english beat_casa_55caf2a7:

    # mc "Estoy cansado. Nada más."
    mc "I'm tired. That's all."

# game/02_cap1_beat_casa.rpy:132
translate english beat_casa_8ba2b53e:

    # narrador "Volvió a mirar su hoja, ya sin el mismo ánimo de antes."
    narrador "She went back to her sheet, her spirits not what they'd been."

# game/02_cap1_beat_casa.rpy:134
translate english beat_casa_82622c66:

    # raiha "...Está bien el signo."
    raiha "...The sign is right."

# game/02_cap1_beat_casa.rpy:136
translate english beat_casa_35b344be:

    # mc "Entonces revisa el siguiente paso con la misma lógica."
    mc "Then check the next step with the same logic."

# game/02_cap1_beat_casa.rpy:138
translate english beat_casa_4333525f:

    # narrador "Lo dije otra vez con el mismo tono."
    narrador "I said it again in the same tone."

# game/02_cap1_beat_casa.rpy:140
translate english beat_casa_9b388ed9:

    # narrador "Esta vez lo noté yo también, medio segundo tarde."
    narrador "This time I noticed too, half a second late."

# game/02_cap1_beat_casa.rpy:142
translate english beat_casa_7f025518:

    # raiha "Ya me salía, hermanito."
    raiha "I was getting it already, big brother."

# game/02_cap1_beat_casa.rpy:144
translate english beat_casa_230d7ac8:

    # raiha "Solo quería que te sentaras conmigo un rato."
    raiha "I just wanted you to sit with me for a while."

# game/02_cap1_beat_casa.rpy:146
translate english beat_casa_d3ccffa0:

    # narrador "Cerró el cuaderno. Esta vez sí."
    narrador "She closed the notebook. For real this time."

# game/02_cap1_beat_casa.rpy:159
translate english beat_casa_034b5e14:

    # narrador "Mi padre entró cuando Raiha ya estaba guardando el cuaderno."
    narrador "My father came in when Raiha was already putting her notebook away."

# game/02_cap1_beat_casa.rpy:164
translate english beat_casa_9183a228:

    # isanari "Vaya [mc], te ves demasiado cansado."
    isanari "Whoa, [mc], you look way too tired."

# game/02_cap1_beat_casa.rpy:166
translate english beat_casa_0271ace4:

    # isanari "¿Cómo vas? ¿Todo marcha bien en tu trabajo?"
    isanari "How's it going? Everything okay with the job?"

# game/02_cap1_beat_casa.rpy:168
translate english beat_casa_aac89c6c:

    # mc "El examen es mañana."
    mc "The exam's tomorrow."

# game/02_cap1_beat_casa.rpy:170
translate english beat_casa_c0b49817:

    # isanari "¿El tuyo o el de ellas?"
    isanari "Yours or theirs?"

# game/02_cap1_beat_casa.rpy:172
translate english beat_casa_f4135908:

    # mc "El de ellas."
    mc "Theirs."

# game/02_cap1_beat_casa.rpy:174
translate english beat_casa_85a7eb1c:

    # mc "El mío ya lo rendí hace un mes, cuando dijiste que sí por mí."
    mc "Mine I took a month ago, when you said yes for me."

# game/02_cap1_beat_casa.rpy:179
translate english beat_casa_12b45cd6:

    # isanari "No suenes tan dramático."
    isanari "Don't sound so dramatic."

# game/02_cap1_beat_casa.rpy:181
translate english beat_casa_01bc4c4d:

    # isanari "Te va bien, ¿no? El dinero sigue entrando."
    isanari "It's going well for you, right? The money's still coming in."

# game/02_cap1_beat_casa.rpy:183
translate english beat_casa_b9b5690e:

    # narrador "No preguntó cómo estaba."
    narrador "He didn't ask how I was."

# game/02_cap1_beat_casa.rpy:185
translate english beat_casa_680aacae:

    # narrador "Preguntó si el dinero seguía llegando, en la misma frase."
    narrador "He asked whether the money was still coming, in the same breath."

# game/02_cap1_beat_casa.rpy:187
translate english beat_casa_b574a272:

    # mc_pensamiento "No es que me sorprenda."
    mc_pensamiento "It's not that it surprises me."

# game/02_cap1_beat_casa.rpy:189
translate english beat_casa_bfd414b4:

    # mc_pensamiento "Es que llevo un mes viéndolas a ellas cinco fingir que no les importo."
    mc_pensamiento "It's that I've spent a month watching the five of them pretend I don't matter to them."

# game/02_cap1_beat_casa.rpy:191
translate english beat_casa_eefd576f:

    # mc_pensamiento "Y se siente distinto verlo a él sin fingir nada."
    mc_pensamiento "And it feels different watching him not pretend at all."

# game/02_cap1_beat_casa.rpy:196
translate english beat_casa_ac4ae086:

    # raiha "¡Papá!"
    raiha "Dad!"

# game/02_cap1_beat_casa.rpy:198
translate english beat_casa_ac360412:

    # raiha "Pregúntale cómo está, no cuánto pagan."
    raiha "Ask him how he is, not how much they're paying."

# game/02_cap1_beat_casa.rpy:200
translate english beat_casa_7a173849:

    # isanari "Es la misma pregunta, Raiha."
    isanari "It's the same question, Raiha."

# game/02_cap1_beat_casa.rpy:202
translate english beat_casa_4afff12e:

    # isanari "Si le fuera mal, no seguirían pagando."
    isanari "If he were doing badly, they wouldn't keep paying."

# game/02_cap1_beat_casa.rpy:204
translate english beat_casa_4708b803:

    # narrador "Lo dijo sin maldad."
    narrador "He said it without malice."

# game/02_cap1_beat_casa.rpy:206
translate english beat_casa_a89ba614:

    # narrador "Con la misma lógica fría con la que arregla todo lo demás."
    narrador "With the same cold logic he uses to fix everything else."

# game/02_cap1_beat_casa.rpy:208
translate english beat_casa_74bf1fd6:

    # mc "Las cinco van a salir bien."
    mc "All five will pass."

# game/02_cap1_beat_casa.rpy:210
translate english beat_casa_0bc2ab0a:

    # isanari "Eso espero."
    isanari "I hope so."

# game/02_cap1_beat_casa.rpy:212
translate english beat_casa_83920833:

    # isanari "Cinco veces la tarifa no cae del cielo dos veces."
    isanari "Five times the rate doesn't fall from the sky twice."

# game/02_cap1_beat_casa.rpy:214
translate english beat_casa_5971cea6:

    # narrador "Se sirvió agua y volvió a su cuarto sin esperar respuesta."
    narrador "He poured himself some water and went back to his room without waiting for an answer."

# game/02_cap1_beat_casa.rpy:216
translate english beat_casa_8b547dbf:

    # narrador "En la puerta se detuvo, con la mano en el marco, como si fuera a decir algo más."
    narrador "At the door he stopped, hand on the frame, as if about to say something more."

# game/02_cap1_beat_casa.rpy:218
translate english beat_casa_4655db54:

    # narrador "No lo dijo."
    narrador "He didn't."

# game/02_cap1_beat_casa.rpy:225
translate english beat_casa_8005c086:

    # mc_pensamiento "No dijo suerte."
    mc_pensamiento "He didn't say good luck."

# game/02_cap1_beat_casa.rpy:227
translate english beat_casa_585b540c:

    # mc_pensamiento "No preguntó de qué se trataba el examen."
    mc_pensamiento "He didn't ask what the exam was about."

# game/02_cap1_beat_casa.rpy:229
translate english beat_casa_2e9b189f:

    # mc_pensamiento "Solo confirmó que el trato seguía en pie desde su lado."
    mc_pensamiento "He only confirmed that the deal still stood on his end."

# game/02_cap1_beat_casa.rpy:231
translate english beat_casa_11959dbd:

    # narrador "Raiha se quedó mirando la puerta de su cuarto un momento más de lo necesario."
    narrador "Raiha kept looking at his door a moment longer than she needed to."

# game/02_cap1_beat_casa.rpy:236
translate english beat_casa_685459be:

    # raiha "No le hagas caso."
    raiha "Don't pay attention to him."

# game/02_cap1_beat_casa.rpy:238
translate english beat_casa_2b2702f4:

    # mc "No le hago caso."
    mc "I'm not."

# game/02_cap1_beat_casa.rpy:240
translate english beat_casa_30d39d64:

    # narrador "Los dos sabíamos que no era del todo cierto."
    narrador "We both knew that wasn't entirely true."

# game/02_cap1_beat_casa.rpy:245
translate english beat_casa_80d560f1:

    # raiha "...A veces pones la misma cara que él."
    raiha "...Sometimes you make the same face he does."

# game/02_cap1_beat_casa.rpy:247
translate english beat_casa_e6b2a6dd:

    # raiha "La de estar haciendo cuentas."
    raiha "The one where you're doing the math."

# game/02_cap1_beat_casa.rpy:249
translate english beat_casa_26bb3e75:

    # mc_pensamiento "No le contesté. No sabía si era verdad."
    mc_pensamiento "I didn't answer. I didn't know if it was true."

# game/02_cap1_beat_casa.rpy:264
translate english beat_casa_6bc1941b:

    # narrador "Me encerré en mi cuarto antes de las diez."
    narrador "I shut myself in my room before ten."

# game/02_cap1_beat_casa.rpy:266
translate english beat_casa_382ff95f:

    # narrador "Saqué la libreta del cajón."
    narrador "I took the notebook out of the drawer."

# game/02_cap1_beat_casa.rpy:268
translate english beat_casa_c422c76a:

    # narrador "La misma de la primera noche."
    narrador "The same one from the first night."

# game/02_cap1_beat_casa.rpy:275
translate english beat_casa_0c3de59b:

    # mc_pensamiento "Cinco nombres, en columna, con una línea debajo."
    mc_pensamiento "Five names, in a column, with a line underneath."

# game/02_cap1_beat_casa.rpy:277
translate english beat_casa_160444a6:

    # mc_pensamiento "Treinta días después, la letra sigue siendo la misma."
    mc_pensamiento "Thirty days later, the handwriting is still the same."

# game/02_cap1_beat_casa.rpy:279
translate english beat_casa_e72ef923:

    # mc_pensamiento "Solo que ahora sé lo que cuesta cada nombre."
    mc_pensamiento "Only now I know what each name costs."

# game/02_cap1_beat_casa.rpy:281
translate english beat_casa_ab99ffd4:

    # narrador "Dejé la vista quieta un momento antes de cerrarla."
    narrador "I held my gaze there a moment before closing it."

# game/02_cap1_beat_casa.rpy:285
translate english beat_casa_1ee2fd11:

    # mc_pensamiento "No sé si mañana esto sigue siendo mi trabajo."
    mc_pensamiento "I don't know if tomorrow this is still my job."

# game/02_cap1_beat_casa.rpy:287
translate english beat_casa_196182ef:

    # mc_pensamiento "Ninguna aprobó todavía."
    mc_pensamiento "None of them has passed yet."

# game/02_cap1_beat_casa.rpy:289
translate english beat_casa_f81e4341:

    # mc_pensamiento "Y las cinco llegan a este último tramo por caminos que yo elegí."
    mc_pensamiento "And all five reach this last stretch by paths I chose."

# game/02_cap1_beat_casa.rpy:291
translate english beat_casa_e75a638a:

    # mc_pensamiento "Uno a uno, sin preguntarles si querían que fuera así."
    mc_pensamiento "One by one, without asking them if they wanted it this way."

# game/02_cap1_beat_casa.rpy:293
translate english beat_casa_d6898884:

    # mc_pensamiento "Si mañana me voy, me voy sabiendo exactamente por qué."
    mc_pensamiento "If I go tomorrow, I'll go knowing exactly why."

# game/02_cap1_beat_casa.rpy:295
translate english beat_casa_254a3808:

    # mc_pensamiento "Todo el peso de mis decisiones caerá mañana."
    mc_pensamiento "The full weight of my decisions lands tomorrow."

# game/02_cap1_beat_casa.rpy:323
translate english bcl_menu_6e7eb285:

    # mc_pensamiento "¿En qué nombre me detengo?" nointeract
    mc_pensamiento "Which name do I stop on?" nointeract

# game/02_cap1_beat_casa.rpy:372
translate english bcl_ichika_78006a06:

    # mc_pensamiento "Ichika fue la primera cara que vi en ese departamento."
    mc_pensamiento "Ichika was the first face I saw in that apartment."

# game/02_cap1_beat_casa.rpy:374
translate english bcl_ichika_57dea60d:

    # mc_pensamiento "Me abrió la puerta con una sonrisa fácil, como si llevara un rato esperándome."
    mc_pensamiento "She opened the door with an easy smile, as if she'd been waiting for me a while."

# game/02_cap1_beat_casa.rpy:376
translate english bcl_ichika_81179cc9:

    # mc_pensamiento "Pidió perdón por adelantado por el desorden, el ruido y todo lo que iba a ver."
    mc_pensamiento "She apologized in advance for the mess, the noise, and everything I was about to see."

# game/02_cap1_beat_casa.rpy:378
translate english bcl_ichika_60bbcaa4:

    # mc_pensamiento "Pensé que era cortesía. Era un aviso."
    mc_pensamiento "I thought it was politeness. It was a warning."

# game/02_cap1_beat_casa.rpy:380
translate english bcl_ichika_26a8d439:

    # mc_pensamiento "Al día siguiente fingió dormir para no contestar una hoja que ya habían decidido fallar."
    mc_pensamiento "The next day she faked sleep to avoid a sheet they'd all agreed to fail."

# game/02_cap1_beat_casa.rpy:382
translate english bcl_ichika_71e20d90:

    # mc_pensamiento "Dijo «coincidencia, somos hermanas» sin que le temblara nada."
    mc_pensamiento "She said \"coincidence, we're sisters\" without a flicker."

# game/02_cap1_beat_casa.rpy:384
translate english bcl_ichika_d4bcd53b:

    # mc_pensamiento "Mentía tan bien que casi daba gusto. Casi."
    mc_pensamiento "She lied so well it was almost a pleasure. Almost."

# game/02_cap1_beat_casa.rpy:388
translate english bcl_ichika_6d8a9f80:

    # mc_pensamiento "Por eso, al entrar al club de teatro, ya no me fiaba de ninguna de sus sonrisas."
    mc_pensamiento "So walking into the drama club, I no longer trusted any of her smiles."

# game/02_cap1_beat_casa.rpy:390
translate english bcl_ichika_2338bdf6:

    # mc_pensamiento "La encontré dormida en el suelo, con el guion resbalándole de la mano."
    mc_pensamiento "I found her asleep on the floor, the script slipping out of her hand."

# game/02_cap1_beat_casa.rpy:392
translate english bcl_ichika_a69bdbc7:

    # mc_pensamiento "A su lado, dos latas de energizante. Una de ellas, abollada."
    mc_pensamiento "Next to her, two cans of energy drink. One of them dented."

# game/02_cap1_beat_casa.rpy:394
translate english bcl_ichika_d89b6a17:

    # mc_pensamiento "Y un horario con tres columnas superpuestas y algo tachado que no quiso que leyera."
    mc_pensamiento "And a schedule with three overlapping columns and something crossed out she didn't want me to read."

# game/02_cap1_beat_casa.rpy:396
translate english bcl_ichika_cc537d41:

    # mc_pensamiento "Al despertar, durante medio segundo, no hubo actuación."
    mc_pensamiento "When she woke up, for half a second, there was no act."

# game/02_cap1_beat_casa.rpy:398
translate english bcl_ichika_aab04e95:

    # mc_pensamiento "Dijo «perdí la tarde entera» con una voz que no tenía dirección de escena."
    mc_pensamiento "She said \"I lost the whole afternoon\" in a voice with no stage direction."

# game/02_cap1_beat_casa.rpy:400
translate english bcl_ichika_6b06d1dd:

    # mc_pensamiento "Después volvió la sonrisa, y con ella el chiste del «descanso escénico»."
    mc_pensamiento "Then the smile came back, and with it the \"stage rest\" joke."

# game/02_cap1_beat_casa.rpy:404
translate english bcl_ichika_7a763a9c:

    # mc_pensamiento "No le seguí la broma. Me quedé callado, esperando."
    mc_pensamiento "I didn't play along. I stayed quiet, waiting."

# game/02_cap1_beat_casa.rpy:406
translate english bcl_ichika_4bee358e:

    # mc_pensamiento "Fue ella quien rompió el silencio: dijo que no sabía cuánto más podía seguir así."
    mc_pensamiento "She broke the silence herself: she said she didn't know how much longer she could go on like this."

# game/02_cap1_beat_casa.rpy:408
translate english bcl_ichika_c3252961:

    # mc_pensamiento "Las audiciones, las clases, fingir que puede con las dos."
    mc_pensamiento "The auditions, the classes, pretending she can handle both."

# game/02_cap1_beat_casa.rpy:410
translate english bcl_ichika_f4b089da:

    # mc_pensamiento "Y que a la audición del primer día no llegó. Se durmió en el tren."
    mc_pensamiento "And that she never made it to the first day's audition. She fell asleep on the train."

# game/02_cap1_beat_casa.rpy:412
translate english bcl_ichika_50e80e5a:

    # mc_pensamiento "No creo que me lo dijera a mí. Creo que se le escapó."
    mc_pensamiento "I don't think she meant to tell me. I think it slipped out."

# game/02_cap1_beat_casa.rpy:414
translate english bcl_ichika_44bca4e6:

    # mc_pensamiento "Al día siguiente me contó que había dormido siete horas y cuarto. Y que redondeaba hacia arriba."
    mc_pensamiento "The next day she told me she'd slept seven and a quarter hours. And that she rounded up."

# game/02_cap1_beat_casa.rpy:416
translate english bcl_ichika_028793da:

    # mc_pensamiento "Y que ya podía cuidarme ella a mí, si la dejaba."
    mc_pensamiento "And that she could take care of me now, if I let her."

# game/02_cap1_beat_casa.rpy:418
translate english bcl_ichika_d6d5ac2b:

    # mc_pensamiento "Nadie me había preguntado por mi sueño en años."
    mc_pensamiento "Nobody had asked about my sleep in years."

# game/02_cap1_beat_casa.rpy:422
translate english bcl_ichika_3471bf08:

    # mc_pensamiento "Le seguí la broma y acabamos inventando un dragón que lee contratos de audición."
    mc_pensamiento "I played along, and we ended up inventing a dragon who reads audition contracts."

# game/02_cap1_beat_casa.rpy:424
translate english bcl_ichika_e4fde5ac:

    # mc_pensamiento "Se rió de verdad. Fue un buen rato."
    mc_pensamiento "She laughed for real. It was a good while."

# game/02_cap1_beat_casa.rpy:426
translate english bcl_ichika_cc24bff4:

    # mc_pensamiento "Pero mientras hablábamos del dragón, las latas siguieron sin explicación."
    mc_pensamiento "But while we talked about the dragon, the cans stayed unexplained."

# game/02_cap1_beat_casa.rpy:428
translate english bcl_ichika_51e5f224:

    # mc_pensamiento "Al día siguiente bautizó al dragón «Contrato». Dice que es su mejor material."
    mc_pensamiento "The next day she named the dragon \"Contract.\" She says it's her best material."

# game/02_cap1_beat_casa.rpy:432
translate english bcl_ichika_8b765788:

    # mc_pensamiento "Le dije que si tenía energía para chistes, la tenía para estudiar."
    mc_pensamiento "I told her that if she had the energy for jokes, she had the energy to study."

# game/02_cap1_beat_casa.rpy:434
translate english bcl_ichika_7df1aaf7:

    # mc_pensamiento "No se enfadó. Contestó «tienes razón» sonriendo y guardó el guion sin doblarlo."
    mc_pensamiento "She didn't get angry. She said \"you're right,\" smiling, and put the script away without folding it."

# game/02_cap1_beat_casa.rpy:436
translate english bcl_ichika_8f8f30b5:

    # mc_pensamiento "Fue correcta conmigo. Eso, viniendo de ella, es peor que un portazo."
    mc_pensamiento "She was polite with me. Coming from her, that's worse than a slammed door."

# game/02_cap1_beat_casa.rpy:438
translate english bcl_ichika_eb5a4ce9:

    # mc_pensamiento "Al día siguiente la sonrisa llegó medio segundo tarde."
    mc_pensamiento "The next day the smile arrived half a second late."

# game/02_cap1_beat_casa.rpy:440
translate english bcl_ichika_77efec47:

    # mc_pensamiento "Me recibió con mi nombre y nada más."
    mc_pensamiento "She greeted me by name and nothing more."

# game/02_cap1_beat_casa.rpy:442
translate english bcl_ichika_0b47b198:

    # mc_pensamiento "Antes de irnos le llegó un mensaje: un papel nuevo en la obra de primavera."
    mc_pensamiento "Before we left she got a message: a new part in the spring play."

# game/02_cap1_beat_casa.rpy:444
translate english bcl_ichika_413d1aae:

    # mc_pensamiento "Dijo que sí sin pensarlo, con una agenda que ya no le cabía."
    mc_pensamiento "She said yes without thinking, with a schedule that no longer had room."

# game/02_cap1_beat_casa.rpy:446
translate english bcl_ichika_cb812c7a:

    # mc_pensamiento "Ni siquiera contestó el mensaje. Lo guardó, como guarda todo lo demás."
    mc_pensamiento "She didn't even answer the message. She stored it away, like everything else."

# game/02_cap1_beat_casa.rpy:450
translate english bcl_ichika_dbd63c04:

    # mc_pensamiento "Aun así, hay algo en ella que no encaja."
    mc_pensamiento "Even so, something about her doesn't fit."

# game/02_cap1_beat_casa.rpy:452
translate english bcl_ichika_e49d2560:

    # mc_pensamiento "No sabe cuántas horas durmió."
    mc_pensamiento "She doesn't know how many hours she slept."

# game/02_cap1_beat_casa.rpy:454
translate english bcl_ichika_efdf0a39:

    # mc_pensamiento "Pero sabe cuánto tarda un tren, cuánto la estación y cuánto cambiarse."
    mc_pensamiento "But she knows how long the train takes, how long the station, and how long to change."

# game/02_cap1_beat_casa.rpy:456
translate english bcl_ichika_5dc84379:

    # mc_pensamiento "Lo dijo de corrido, sin contar con los dedos. Y después lo llamó «ser organizada»."
    mc_pensamiento "She rattled it off, no counting on her fingers. And then called it \"being organized.\""

# game/02_cap1_beat_casa.rpy:458
translate english bcl_ichika_f225e95c:

    # mc_pensamiento "Una cabeza así no se improvisa. Y ella ni siquiera lo considera un talento."
    mc_pensamiento "A head like that isn't improvised. And she doesn't even count it as a talent."

# game/02_cap1_beat_casa.rpy:466
translate english bcl_ichika_39e0ffbc:

    # mc_pensamiento "A Ichika no fui a buscarla."
    mc_pensamiento "I didn't go looking for Ichika."

# game/02_cap1_beat_casa.rpy:468
translate english bcl_ichika_53f82ca3:

    # mc_pensamiento "La primera vez me abrió la puerta con una sonrisa fácil y una disculpa por adelantado."
    mc_pensamiento "The first time, she opened the door with an easy smile and an apology in advance."

# game/02_cap1_beat_casa.rpy:470
translate english bcl_ichika_9aa32e06:

    # mc_pensamiento "Al día siguiente me dijo que su audición había sido un éxito. No dijo de qué."
    mc_pensamiento "The next day she told me her audition had been a success. She didn't say for what."

# game/02_cap1_beat_casa.rpy:472
translate english bcl_ichika_f69b4bdc:

    # mc_pensamiento "Después fingió dormir para tapar una hoja que había contestado mal a propósito."
    mc_pensamiento "Then she faked sleep to cover a sheet she'd answered wrong on purpose."

# game/02_cap1_beat_casa.rpy:474
translate english bcl_ichika_694ec301:

    # mc_pensamiento "Desde entonces, cada vez que la veo, hay un chiste antes de que yo diga nada."
    mc_pensamiento "Since then, every time I see her, there's a joke before I can say a word."

# game/02_cap1_beat_casa.rpy:476
translate english bcl_ichika_baa93128:

    # mc_pensamiento "Cuando se enteró de que no la había elegido, soltó que había ensayado tres reacciones."
    mc_pensamiento "When she found out I hadn't picked her, she blurted out that she'd rehearsed three reactions."

# game/02_cap1_beat_casa.rpy:478
translate english bcl_ichika_35bbbdc5:

    # mc_pensamiento "Una graciosa, una dramática y una de «qué sorpresa, no te esperaba»."
    mc_pensamiento "A funny one, a dramatic one, and a \"what a surprise, I wasn't expecting you.\""

# game/02_cap1_beat_casa.rpy:480
translate english bcl_ichika_d8ed80e0:

    # mc_pensamiento "Luego dijo que eran todas actuación, y que no sabía si habría podido con otra cosa."
    mc_pensamiento "Then she said it was all acting, and that she didn't know if she could have handled anything else."

# game/02_cap1_beat_casa.rpy:482
translate english bcl_ichika_68584b70:

    # mc_pensamiento "Cuando sonríe, parece que se acomoda un disfraz."
    mc_pensamiento "When she smiles, it looks like she's adjusting a costume."

# game/02_cap1_beat_casa.rpy:484
translate english bcl_ichika_ab238ef0:

    # mc_pensamiento "No sé si sigue actuando o si dejó de hacerlo."
    mc_pensamiento "I can't tell if she's still acting or if she stopped."

# game/02_cap1_beat_casa.rpy:505
translate english bcl_nino_f98af9d1:

    # mc_pensamiento "Nino fue la segunda, y la primera en dejarme claro que sobraba."
    mc_pensamiento "Nino was the second, and the first to make it clear I was in the way."

# game/02_cap1_beat_casa.rpy:507
translate english bcl_nino_ed20ab6c:

    # mc_pensamiento "«¿A quién diablos le abriste la puerta?», dijo, sin saber siquiera mi nombre."
    mc_pensamiento "\"Who the heck did you just open the door for?\" she said, not even knowing my name."

# game/02_cap1_beat_casa.rpy:509
translate english bcl_nino_ee82f6ed:

    # mc_pensamiento "Me dio una semana. Después dijo que el último tutor había durado cuatro días."
    mc_pensamiento "She gave me a week. Then she said the last tutor had lasted four days."

# game/02_cap1_beat_casa.rpy:511
translate english bcl_nino_4c37a9dc:

    # mc_pensamiento "No lo dijo con rabia. Lo dijo como quien recita un dato que ya se sabe de memoria."
    mc_pensamiento "She didn't say it with anger. She said it like someone reciting a fact she knows by heart."

# game/02_cap1_beat_casa.rpy:513
translate english bcl_nino_970f2289:

    # mc_pensamiento "Al día siguiente organizó a las cinco para que contestaran igual de mal."
    mc_pensamiento "The next day she got all five of them to answer equally badly."

# game/02_cap1_beat_casa.rpy:515
translate english bcl_nino_b69b5ff3:

    # mc_pensamiento "Cinco hojas, seis errores idénticos y un informe listo para su padre."
    mc_pensamiento "Five sheets, six identical mistakes, and a report ready for her father."

# game/02_cap1_beat_casa.rpy:517
translate english bcl_nino_57493a12:

    # mc_pensamiento "Pero cuando leí una frase en inglés con mi peor acento, no pudo evitarlo."
    mc_pensamiento "But when I read an English sentence in my worst accent, she couldn't help herself."

# game/02_cap1_beat_casa.rpy:519
translate english bcl_nino_8323ffaa:

    # mc_pensamiento "Me corrigió. Molesta, en mitad de la discusión, sin pensarlo."
    mc_pensamiento "She corrected me. Annoyed, mid-argument, without thinking."

# game/02_cap1_beat_casa.rpy:521
translate english bcl_nino_9331753d:

    # mc_pensamiento "«Se pega, no se separa.» Nadie corrige por reflejo algo que no domina."
    mc_pensamiento "\"It links together, you don't chop it up.\" Nobody corrects by reflex what they haven't mastered."

# game/02_cap1_beat_casa.rpy:525
translate english bcl_nino_4bb0e332:

    # mc_pensamiento "La encontré en el pasillo de importados, comparando dos cajas de harina."
    mc_pensamiento "I found her in the imports aisle, comparing two boxes of flour."

# game/02_cap1_beat_casa.rpy:527
translate english bcl_nino_21fda992:

    # mc_pensamiento "Leía las etiquetas moviendo apenas los labios, como quien lee en su propia lengua."
    mc_pensamiento "She read the labels with her lips barely moving, like someone reading in her own language."

# game/02_cap1_beat_casa.rpy:529
translate english bcl_nino_ad3e4e34:

    # mc_pensamiento "Llevaba una tarjeta de receta escrita a mano, vieja, de alguien que no era ella."
    mc_pensamiento "She carried a handwritten recipe card, old, from someone who wasn't her."

# game/02_cap1_beat_casa.rpy:531
translate english bcl_nino_756c16d3:

    # mc_pensamiento "Lo leyó todo sin buscar una sola palabra. Y cuando intentó explicar cómo, se trabó."
    mc_pensamiento "She read all of it without looking up a single word. And when she tried to explain how, she stalled."

# game/02_cap1_beat_casa.rpy:533
translate english bcl_nino_c9c7bb09:

    # mc_pensamiento "«No es lo mismo leer que...» Y no terminó la frase."
    mc_pensamiento "\"Reading isn't the same as...\" And she didn't finish the sentence."

# game/02_cap1_beat_casa.rpy:535
translate english bcl_nino_660cf7b1:

    # mc_pensamiento "Luego, por una vez, habló de más: dijo que los tutores anteriores también sonreían el primer día."
    mc_pensamiento "Then, for once, she said too much: the earlier tutors smiled on the first day too."

# game/02_cap1_beat_casa.rpy:537
translate english bcl_nino_0dafda5e:

    # mc_pensamiento "Que sus hermanas se ilusionan cada vez, y que después les toca ver a alguien irse."
    mc_pensamiento "That her sisters get their hopes up every time, and then have to watch someone leave."

# game/02_cap1_beat_casa.rpy:539
translate english bcl_nino_e25f926f:

    # mc_pensamiento "No desconfía de mí. Desconfía del puesto."
    mc_pensamiento "She doesn't distrust me. She distrusts the position."

# game/02_cap1_beat_casa.rpy:543
translate english bcl_nino_a0c299e2:

    # mc_pensamiento "Le dije que tenía razón en desconfiar y que solo el tiempo lo demostraría."
    mc_pensamiento "I told her she was right not to trust me, and that only time would prove it."

# game/02_cap1_beat_casa.rpy:545
translate english bcl_nino_3e550729:

    # mc_pensamiento "Dijo que era la primera vez que alguien no le prometía nada."
    mc_pensamiento "She said it was the first time anyone hadn't promised her anything."

# game/02_cap1_beat_casa.rpy:547
translate english bcl_nino_2e19c30e:

    # mc_pensamiento "Eso no significa que confíe en mí. Lo dejó bien claro."
    mc_pensamiento "That doesn't mean she trusts me. She made that very clear."

# game/02_cap1_beat_casa.rpy:549
translate english bcl_nino_7352613b:

    # mc_pensamiento "Pero al día siguiente me ordenó comer algo antes de clases, y se le olvidó cruzar los brazos."
    mc_pensamiento "But the next day she ordered me to eat something before class, and forgot to cross her arms."

# game/02_cap1_beat_casa.rpy:553
translate english bcl_nino_00e01477:

    # mc_pensamiento "Le cargué una cesta sin decir nada y terminó caminando a mi lado sin discutirlo."
    mc_pensamiento "I carried her basket without a word, and she ended up walking beside me without arguing."

# game/02_cap1_beat_casa.rpy:555
translate english bcl_nino_5a34f4cd:

    # mc_pensamiento "«Esto no significa nada», dijo. Fue lo más parecido a un gracias que iba a sacarle."
    mc_pensamiento "\"This doesn't mean anything,\" she said. It was the closest thing to a thank-you I'd get out of her."

# game/02_cap1_beat_casa.rpy:559
translate english bcl_nino_a6bfa3c0:

    # mc_pensamiento "Le prometí que yo sí iba a durar."
    mc_pensamiento "I promised her I would last."

# game/02_cap1_beat_casa.rpy:561
translate english bcl_nino_94ba9a70:

    # mc_pensamiento "Se rió, pero no de gracia: eso mismo había dicho el que llegó antes que yo."
    mc_pensamiento "She laughed, but not because it was funny: the one before me had said exactly that."

# game/02_cap1_beat_casa.rpy:563
translate english bcl_nino_80af353e:

    # mc_pensamiento "Me dijo que anotara la fecha. Que cuando me fuera, me la iba a recordar."
    mc_pensamiento "She told me to write down the date. That when I left, she'd remind me of it."

# game/02_cap1_beat_casa.rpy:565
translate english bcl_nino_47259f82:

    # mc_pensamiento "Mientras la acompañaba a la salida, la llamó su padre."
    mc_pensamiento "While I walked her to the exit, her father called."

# game/02_cap1_beat_casa.rpy:567
translate english bcl_nino_fcb7020b:

    # mc_pensamiento "Ella dijo que el tutor nuevo aún no la convencía, y que no quería explicar por qué."
    mc_pensamiento "She said the new tutor hadn't convinced her yet, and that she didn't want to explain why."

# game/02_cap1_beat_casa.rpy:571
translate english bcl_nino_aca2d3b8:

    # mc_pensamiento "Y después llegó la cocina."
    mc_pensamiento "And then came the kitchen."

# game/02_cap1_beat_casa.rpy:573
translate english bcl_nino_fa424f1e:

    # mc_pensamiento "Entré al departamento y la oí pedirle a Maruo que me despidiera."
    mc_pensamiento "I walked into the apartment and heard her asking Maruo to fire me."

# game/02_cap1_beat_casa.rpy:575
translate english bcl_nino_bcbe8f8f:

    # mc_pensamiento "Es la única vez que la escuché gritarle a su padre."
    mc_pensamiento "It's the only time I've heard her shout at her father."

# game/02_cap1_beat_casa.rpy:577
translate english bcl_nino_a34cfc27:

    # mc_pensamiento "Dijo que no se trataba de mí, sino de que iba a durar lo mismo que los anteriores."
    mc_pensamiento "She said it wasn't about me, but about how I'd last as long as the others."

# game/02_cap1_beat_casa.rpy:579
translate english bcl_nino_4cbdff67:

    # mc_pensamiento "Que Ichika finge y Yotsuba se esfuerza el doble."
    mc_pensamiento "That Ichika pretends and Yotsuba works twice as hard."

# game/02_cap1_beat_casa.rpy:581
translate english bcl_nino_ecf40124:

    # mc_pensamiento "Que Miku se encierra más e Itsuki se lo toma personal."
    mc_pensamiento "That Miku shuts herself in more and Itsuki takes it personally."

# game/02_cap1_beat_casa.rpy:583
translate english bcl_nino_76d04cf5:

    # mc_pensamiento "Y que a ella le toca juntar los pedazos de las cuatro porque es la única que nunca se ilusionó."
    mc_pensamiento "And that she's stuck picking up the pieces for all four, since she's the only one who never hoped."

# game/02_cap1_beat_casa.rpy:585
translate english bcl_nino_6bf45a0d:

    # mc_pensamiento "«Alguien tiene que quedarse con la cabeza fría.»"
    mc_pensamiento "\"Someone has to keep a cool head.\""

# game/02_cap1_beat_casa.rpy:587
translate english bcl_nino_637efb45:

    # mc_pensamiento "Se detuvo con la taza a medio camino y dijo que no había dicho nada de eso."
    mc_pensamiento "She stopped with the cup halfway up and said she hadn't said any of that."

# game/02_cap1_beat_casa.rpy:589
translate english bcl_nino_169af1fa:

    # mc_pensamiento "Lo había dicho todo."
    mc_pensamiento "She had said all of it."

# game/02_cap1_beat_casa.rpy:593
translate english bcl_nino_3cf2b1d5:

    # mc_pensamiento "No fui a buscarla al centro comercial."
    mc_pensamiento "I didn't go looking for her at the mall."

# game/02_cap1_beat_casa.rpy:595
translate english bcl_nino_4355ab4f:

    # mc_pensamiento "Pero a Nino la conozco desde la primera puerta: «no vas a durar ni una semana»."
    mc_pensamiento "But I've known Nino since the first door: \"You won't last a week.\""

# game/02_cap1_beat_casa.rpy:597
translate english bcl_nino_9dcdfbd0:

    # mc_pensamiento "Desde el segundo día: organizó a las cinco para que fallaran juntas."
    mc_pensamiento "Since the second day: she got all five of them to fail together."

# game/02_cap1_beat_casa.rpy:599
translate english bcl_nino_a45df594:

    # mc_pensamiento "Aun así me corrigió un «had to» sin pensarlo, molesta, a mitad de discusión."
    mc_pensamiento "Even so, she corrected my \"had to\" without thinking, annoyed, mid-argument."

# game/02_cap1_beat_casa.rpy:601
translate english bcl_nino_be3e8373:

    # mc_pensamiento "Nadie corrige por reflejo algo que no domina."
    mc_pensamiento "Nobody corrects by reflex what they haven't mastered."

# game/02_cap1_beat_casa.rpy:603
translate english bcl_nino_4dff0169:

    # mc_pensamiento "Cuando supo que no la había buscado dijo que le daba igual."
    mc_pensamiento "When she found out I hadn't gone looking for her, she said she didn't care."

# game/02_cap1_beat_casa.rpy:605
translate english bcl_nino_3de974e1:

    # mc_pensamiento "Que ya me había visto en su casa de sobra."
    mc_pensamiento "That she'd seen more than enough of me at her house."

# game/02_cap1_beat_casa.rpy:607
translate english bcl_nino_513d9eee:

    # mc_pensamiento "Y que alguien tiene que ser la que no cambia, para que las demás tengan a dónde volver."
    mc_pensamiento "And that someone has to be the one who doesn't change, so the others have somewhere to come back to."

# game/02_cap1_beat_casa.rpy:609
translate english bcl_nino_9dac70af:

    # mc_pensamiento "Después vino la cocina. La oí pedirle a su padre que me echara."
    mc_pensamiento "Then came the kitchen. I heard her ask her father to throw me out."

# game/02_cap1_beat_casa.rpy:611
translate english bcl_nino_6e6c5b92:

    # mc_pensamiento "Gritó. Y después, sentada en la cocina, me explicó por qué."
    mc_pensamiento "She shouted. And afterward, sitting in the kitchen, she explained why."

# game/02_cap1_beat_casa.rpy:613
translate english bcl_nino_55e0412d:

    # mc_pensamiento "Habló de sus hermanas una por una, y de sí misma como la única que nunca se ilusionó."
    mc_pensamiento "She went through her sisters one by one, and herself as the only one who never got her hopes up."

# game/02_cap1_beat_casa.rpy:619
translate english bcl_nino_f2439391:

    # mc_pensamiento "Le pregunté quién juntaba los pedazos de ella."
    mc_pensamiento "I asked her who picks up her pieces."

# game/02_cap1_beat_casa.rpy:621
translate english bcl_nino_6c58d092:

    # mc_pensamiento "No supo qué contestar, y me puso a cortar cebollas."
    mc_pensamiento "She didn't know what to say, and put me to work cutting onions."

# game/02_cap1_beat_casa.rpy:623
translate english bcl_nino_66c5fd70:

    # mc_pensamiento "En toda la tarde no volvió a hablar de despedirme."
    mc_pensamiento "For the rest of the afternoon she never brought up firing me again."

# game/02_cap1_beat_casa.rpy:627
translate english bcl_nino_e3eb6d2d:

    # mc_pensamiento "No dije nada. Recogí su taza y la lavé en silencio."
    mc_pensamiento "I said nothing. I picked up her cup and washed it in silence."

# game/02_cap1_beat_casa.rpy:629
translate english bcl_nino_84b41d62:

    # mc_pensamiento "No me echó, pero tampoco me dejó quedarme de verdad."
    mc_pensamiento "She didn't throw me out, but she didn't really let me stay either."

# game/02_cap1_beat_casa.rpy:633
translate english bcl_nino_5a5ae598:

    # mc_pensamiento "Le dije que se ocupara de lo suyo y dejara de juntar los pedazos de las demás."
    mc_pensamiento "I told her to take care of her own and stop picking up everyone else's pieces."

# game/02_cap1_beat_casa.rpy:635
translate english bcl_nino_b183ea6c:

    # mc_pensamiento "Contestó que ahora entendía por qué su padre había firmado conmigo: hablamos el mismo idioma."
    mc_pensamiento "She answered that now she understood why her father had signed me: we speak the same language."

# game/02_cap1_beat_casa.rpy:637
translate english bcl_nino_576ad175:

    # mc_pensamiento "No supe si era un insulto o la descripción más exacta que me habían dado de esa casa."
    mc_pensamiento "I couldn't tell if it was an insult or the most accurate thing anyone's said about that house."

# game/02_cap1_beat_casa.rpy:639
translate english bcl_nino_f046863f:

    # mc_pensamiento "Entendí que no está enojada conmigo."
    mc_pensamiento "I understood she isn't angry at me."

# game/02_cap1_beat_casa.rpy:645
translate english bcl_nino_1080b057:

    # mc_pensamiento "Aunque lo que más se me quedó fue otra cosa."
    mc_pensamiento "Though what stuck with me most was something else."

# game/02_cap1_beat_casa.rpy:647
translate english bcl_nino_18973208:

    # mc_pensamiento "Lee de corrido un idioma que no es el suyo y corrige un error sin pensarlo."
    mc_pensamiento "She reads a language that isn't hers fluently and corrects a mistake without thinking."

# game/02_cap1_beat_casa.rpy:649
translate english bcl_nino_02d8974e:

    # mc_pensamiento "Lo único que no puede hacer es explicarlo en voz alta sin trabarse."
    mc_pensamiento "The only thing she can't do is explain it out loud without stalling."

# game/02_cap1_beat_casa.rpy:651
translate english bcl_nino_7f8e6c10:

    # mc_pensamiento "Ahí dentro hay mucho más de lo que deja ver."
    mc_pensamiento "There's a lot more in there than she lets on."

# game/02_cap1_beat_casa.rpy:659
translate english bcl_nino_d901e075:

    # mc_pensamiento "Con ella el ruido es una forma de cuidar a las otras."
    mc_pensamiento "With her, the noise is a way of looking after the others."

# game/02_cap1_beat_casa.rpy:680
translate english bcl_miku_e3e3fadb:

    # mc_pensamiento "Miku fue la tercera, y la que menos ruido hizo."
    mc_pensamiento "Miku was the third, and the one who made the least noise."

# game/02_cap1_beat_casa.rpy:682
translate english bcl_miku_3f8a0ac6:

    # mc_pensamiento "Estaba en el sofá, con unos audífonos azules colgando del cuello."
    mc_pensamiento "She was on the sofa, blue headphones hanging around her neck."

# game/02_cap1_beat_casa.rpy:684
translate english bcl_miku_c87a4f6c:

    # mc_pensamiento "Y un libro de estrategas del Sengoku."
    mc_pensamiento "And a book on Sengoku strategists."

# game/02_cap1_beat_casa.rpy:686
translate english bcl_miku_d496b275:

    # mc_pensamiento "Le pregunté si eso eran samuráis y duelos. Dijo «no, es logística» sin levantar la vista."
    mc_pensamiento "I asked if that meant samurai and duels. She said \"no, it's logistics\" without looking up."

# game/02_cap1_beat_casa.rpy:688
translate english bcl_miku_791e0a76:

    # mc_pensamiento "«Las batallas las gana quien mueve el arroz.» Y se escondió detrás del libro al darse cuenta."
    mc_pensamiento "\"Battles are won by whoever moves the rice.\" And she hid behind the book once she noticed."

# game/02_cap1_beat_casa.rpy:690
translate english bcl_miku_d97c2f14:

    # mc_pensamiento "Esa misma tarde, en la mesa, se subió los audífonos en cuanto saqué las hojas."
    mc_pensamiento "That same afternoon, at the table, she put her headphones on the moment I took out the sheets."

# game/02_cap1_beat_casa.rpy:692
translate english bcl_miku_213c94d3:

    # mc_pensamiento "Me borró del mapa sin decir una palabra."
    mc_pensamiento "She wiped me off the map without a word."

# game/02_cap1_beat_casa.rpy:694
translate english bcl_miku_36756f33:

    # mc_pensamiento "Al irse se detuvo en el pasillo y dijo «no fue idea mía». Y enseguida pidió perdón."
    mc_pensamiento "On her way out she stopped in the hallway and said \"it wasn't my idea.\" And immediately apologized."

# game/02_cap1_beat_casa.rpy:696
translate english bcl_miku_ab2e9ef1:

    # mc_pensamiento "En su hoja había una marca de goma debajo de la respuesta equivocada."
    mc_pensamiento "On her sheet there was an eraser mark under the wrong answer."

# game/02_cap1_beat_casa.rpy:698
translate english bcl_miku_51da46b8:

    # mc_pensamiento "Escribió la correcta primero. Y la borró."
    mc_pensamiento "She'd written the right one first. And erased it."

# game/02_cap1_beat_casa.rpy:700
translate english bcl_miku_05804292:

    # mc_pensamiento "Fue la única que entendió mi plan antes de que lo dijera: «quiere dividirnos»."
    mc_pensamiento "She was the only one who understood my plan before I said it: \"he wants to divide us.\""

# game/02_cap1_beat_casa.rpy:704
translate english bcl_miku_70606fec:

    # mc_pensamiento "En la biblioteca estaba al fondo, de espaldas a la puerta."
    mc_pensamiento "In the library she was at the back, her back to the door."

# game/02_cap1_beat_casa.rpy:706
translate english bcl_miku_5fc8045e:

    # mc_pensamiento "Cuatro libros que no eran del temario, apilados por tamaño y con los lomos alineados."
    mc_pensamiento "Four books that weren't on the syllabus, stacked by size, spines lined up."

# game/02_cap1_beat_casa.rpy:708
translate english bcl_miku_93483ee4:

    # mc_pensamiento "Los audífonos colgando, apagados. No los lleva para escuchar música."
    mc_pensamiento "Her headphones hanging there, off. She doesn't wear them to listen to music."

# game/02_cap1_beat_casa.rpy:710
translate english bcl_miku_dea1e18f:

    # mc_pensamiento "Los lleva ahí, listos, para el momento en que alguien se acerque."
    mc_pensamiento "She wears them there, ready, for the moment someone comes close."

# game/02_cap1_beat_casa.rpy:712
translate english bcl_miku_2945c748:

    # mc_pensamiento "Esa noche me había leído su libro hasta la página noventa y dos."
    mc_pensamiento "That night I'd read her book up to page ninety-two."

# game/02_cap1_beat_casa.rpy:714
translate english bcl_miku_dc984030:

    # mc_pensamiento "Se quedó mirando el ejemplar sobre la mesa."
    mc_pensamiento "She stared at the copy on the table."

# game/02_cap1_beat_casa.rpy:716
translate english bcl_miku_8008934b:

    # mc_pensamiento "Y, por primera vez, miró hacia fuera del libro."
    mc_pensamiento "And, for the first time, she looked out from behind the book."

# game/02_cap1_beat_casa.rpy:718
translate english bcl_miku_e08c3b47:

    # mc_pensamiento "Me contó lo de la sal de Takeda Shingen."
    mc_pensamiento "She told me about Takeda Shingen's salt."

# game/02_cap1_beat_casa.rpy:720
translate english bcl_miku_8417e017:

    # mc_pensamiento "Cómo los vecinos dejaron de vendérsela sin mover un soldado."
    mc_pensamiento "How the neighbors stopped selling it to him without a single soldier moving."

# game/02_cap1_beat_casa.rpy:722
translate english bcl_miku_4708f284:

    # mc_pensamiento "Hablaba más rápido, sin la pausa de siempre delante de cada frase."
    mc_pensamiento "She spoke faster, without her usual pause before every sentence."

# game/02_cap1_beat_casa.rpy:724
translate english bcl_miku_23088420:

    # mc_pensamiento "Y de golpe se oyó a sí misma y dijo «perdón, hablé mucho»."
    mc_pensamiento "And suddenly she heard herself and said \"sorry, I talked a lot.\""

# game/02_cap1_beat_casa.rpy:728
translate english bcl_miku_5dd6f352:

    # mc_pensamiento "Le hice una pregunta concreta y siguió contestando."
    mc_pensamiento "I asked her a specific question and she kept answering."

# game/02_cap1_beat_casa.rpy:730
translate english bcl_miku_f7d52c4b:

    # mc_pensamiento "Cuando fue a disculparse, la corté: eso no se disculpa."
    mc_pensamiento "When she went to apologize, I cut her off: you don't apologize for that."

# game/02_cap1_beat_casa.rpy:732
translate english bcl_miku_3da30f2a:

    # mc_pensamiento "Me dijo que lo de la sal estaba en la página ciento veinte."
    mc_pensamiento "She told me the salt part was on page one-twenty."

# game/02_cap1_beat_casa.rpy:734
translate english bcl_miku_48cda8da:

    # mc_pensamiento "Lo dijo despacio, como quien termina una cuenta."
    mc_pensamiento "She said it slowly, like someone finishing a sum."

# game/02_cap1_beat_casa.rpy:736
translate english bcl_miku_30af61b2:

    # mc_pensamiento "Al día siguiente me pidió que le avisara al llegar a esa página. Quería ver mi cara."
    mc_pensamiento "The next day she asked me to tell her when I reached that page. She wanted to see my face."

# game/02_cap1_beat_casa.rpy:740
translate english bcl_miku_4e1f443c:

    # mc_pensamiento "Le dije que se le daba bien. Contestó que solo lo había leído."
    mc_pensamiento "I told her she was good at it. She said she'd only read it."

# game/02_cap1_beat_casa.rpy:742
translate english bcl_miku_7f630f98:

    # mc_pensamiento "Era un halago, pero sonó a otra etiqueta más."
    mc_pensamiento "It was a compliment, but it sounded like one more label."

# game/02_cap1_beat_casa.rpy:744
translate english bcl_miku_f0871297:

    # mc_pensamiento "El libro le subió hasta media cara y ahí se quedó."
    mc_pensamiento "The book rose to cover half her face and stayed there."

# game/02_cap1_beat_casa.rpy:748
translate english bcl_miku_e57ab66e:

    # mc_pensamiento "Le dije que lo de la sal no entraba en el examen."
    mc_pensamiento "I told her the salt part wasn't on the exam."

# game/02_cap1_beat_casa.rpy:750
translate english bcl_miku_e8184be6:

    # mc_pensamiento "No protestó. Recogió sus libros, se subió los audífonos y esta vez sí sonaba la música."
    mc_pensamiento "She didn't protest. She gathered her books, put her headphones on, and this time there was music."

# game/02_cap1_beat_casa.rpy:752
translate english bcl_miku_3fa98e88:

    # mc_pensamiento "Dijo «hoy no»."
    mc_pensamiento "She said \"not today.\""

# game/02_cap1_beat_casa.rpy:754
translate english bcl_miku_d5cfd54e:

    # mc_pensamiento "Tenía razón en lo del examen, y aun así salí con la sensación de haber hecho algo mal."
    mc_pensamiento "She was right about the exam, and I still left feeling like I'd done something wrong."

# game/02_cap1_beat_casa.rpy:758
translate english bcl_miku_de0f189f:

    # mc_pensamiento "No le falta saber. Eso lo tengo claro."
    mc_pensamiento "She doesn't lack knowledge. That much is clear to me."

# game/02_cap1_beat_casa.rpy:760
translate english bcl_miku_6691328c:

    # mc_pensamiento "Sabe cómo se sostiene un lugar entero y por qué se cae."
    mc_pensamiento "She knows how a whole place holds together and why it falls."

# game/02_cap1_beat_casa.rpy:762
translate english bcl_miku_f814695f:

    # mc_pensamiento "Lo cuenta como si lo hubiera vivido."
    mc_pensamiento "She tells it like she lived it."

# game/02_cap1_beat_casa.rpy:764
translate english bcl_miku_5f9a09ee:

    # mc_pensamiento "Y después borra la respuesta antes de que alguien la lea."
    mc_pensamiento "And then she erases the answer before anyone can read it."

# game/02_cap1_beat_casa.rpy:772
translate english bcl_miku_f85d060d:

    # mc_pensamiento "A Miku no fui a buscarla a la biblioteca."
    mc_pensamiento "I didn't go looking for Miku at the library."

# game/02_cap1_beat_casa.rpy:774
translate english bcl_miku_6e7a4e48:

    # mc_pensamiento "Pero la recuerdo desde el sofá: los audífonos al cuello y la frase del arroz."
    mc_pensamiento "But I remember her from the sofa: headphones around her neck and the line about the rice."

# game/02_cap1_beat_casa.rpy:776
translate english bcl_miku_15a301bb:

    # mc_pensamiento "«Las batallas las gana quien mueve el arroz.» Y detrás del libro."
    mc_pensamiento "\"Battles are won by whoever moves the rice.\" And behind the book."

# game/02_cap1_beat_casa.rpy:778
translate english bcl_miku_97f0f9b7:

    # mc_pensamiento "En su hoja del segundo día, una respuesta correcta borrada a medias."
    mc_pensamiento "On her second-day sheet, a correct answer half erased."

# game/02_cap1_beat_casa.rpy:780
translate english bcl_miku_28a63fd7:

    # mc_pensamiento "Sabía la respuesta y no confió lo bastante en ella para dejarla ahí."
    mc_pensamiento "She knew the answer and didn't trust it enough to leave it there."

# game/02_cap1_beat_casa.rpy:782
translate english bcl_miku_787374f3:

    # mc_pensamiento "Fue la única que entendió mi plan antes de que lo dijera."
    mc_pensamiento "She was the only one who understood my plan before I said it."

# game/02_cap1_beat_casa.rpy:784
translate english bcl_miku_a42337fd:

    # mc_pensamiento "Después me dijo que así estuvo bien. Pero que habría acertado con el sitio."
    mc_pensamiento "Later she told me it had been fine that way. But that I'd have guessed the right place."

# game/02_cap1_beat_casa.rpy:786
translate english bcl_miku_e78b5650:

    # mc_pensamiento "Que hay una silla vacía enfrente de la suya."
    mc_pensamiento "That there's an empty chair across from hers."

# game/02_cap1_beat_casa.rpy:788
translate english bcl_miku_68edcc73:

    # mc_pensamiento "Y que dejó un libro abierto dos días, por si hacía falta una excusa."
    mc_pensamiento "And that she left a book open for two days, in case someone needed an excuse."

# game/02_cap1_beat_casa.rpy:790
translate english bcl_miku_d4ed348c:

    # mc_pensamiento "Dijo que no pasaba nada. Y pidió perdón por haber sonado triste."
    mc_pensamiento "She said it was nothing. And apologized for sounding sad."

# game/02_cap1_beat_casa.rpy:792
translate english bcl_miku_ea449114:

    # mc_pensamiento "Es todo un misterio. Y creo que es de las que saben esperar."
    mc_pensamiento "She's a complete mystery. And I think she's the kind who knows how to wait."

# game/02_cap1_beat_casa.rpy:813
translate english bcl_yotsuba_7da6879e:

    # mc_pensamiento "Yotsuba pasó por mi lado corriendo antes de que pudiera reaccionar."
    mc_pensamiento "Yotsuba ran past me before I could react."

# game/02_cap1_beat_casa.rpy:815
translate english bcl_yotsuba_21b9a470:

    # mc_pensamiento "Se frenó a medio metro, con una sonrisa que ocupaba media habitación."
    mc_pensamiento "She stopped a few feet away, with a smile that filled half the room."

# game/02_cap1_beat_casa.rpy:817
translate english bcl_yotsuba_092764fb:

    # mc_pensamiento "«¡Vas a hacerlo genial! ...¿Verdad?» Esa última palabra le salió medio tono más baja."
    mc_pensamiento "\"You're going to do great! ...Right?\" That last word came out half a tone lower."

# game/02_cap1_beat_casa.rpy:819
translate english bcl_yotsuba_44221391:

    # mc_pensamiento "Y se corrigió al instante: «¡Digo, claro que sí!»"
    mc_pensamiento "And she corrected herself at once: \"I mean, of course you will!\""

# game/02_cap1_beat_casa.rpy:821
translate english bcl_yotsuba_34b266d9:

    # mc_pensamiento "Esa primera tarde escribió su nombre en la hoja con un entusiasmo desmedido. Solo su nombre."
    mc_pensamiento "That first afternoon she wrote her name on the sheet with outsized enthusiasm. Just her name."

# game/02_cap1_beat_casa.rpy:823
translate english bcl_yotsuba_0258d507:

    # mc_pensamiento "Después pidió perdón unas diez veces por ver cómo las demás se iban."
    mc_pensamiento "Then she apologized about ten times for watching the others walk out."

# game/02_cap1_beat_casa.rpy:825
translate english bcl_yotsuba_f9b6ff1a:

    # mc_pensamiento "Al día siguiente intentó defenderme delante de Nino."
    mc_pensamiento "The next day she tried to defend me in front of Nino."

# game/02_cap1_beat_casa.rpy:827
translate english bcl_yotsuba_d2e53809:

    # mc_pensamiento "«Él solo está...» «Yotsuba.» «...No dije nada.»"
    mc_pensamiento "\"He's just...\" \"Yotsuba.\" \"...I didn't say anything.\""

# game/02_cap1_beat_casa.rpy:829
translate english bcl_yotsuba_6acb56f0:

    # mc_pensamiento "Se puso a alinear los bordes de su hoja, como si eso fuera una tarea."
    mc_pensamiento "She started lining up the edges of her sheet, like that was a task."

# game/02_cap1_beat_casa.rpy:833
translate english bcl_yotsuba_25a977ce:

    # mc_pensamiento "La encontré en la pista, mucho después de que el club se fuera a casa."
    mc_pensamiento "I found her at the track, long after the club had gone home."

# game/02_cap1_beat_casa.rpy:835
translate english bcl_yotsuba_9a3eb768:

    # mc_pensamiento "Contaba las vueltas en voz alta y se animaba sola."
    mc_pensamiento "She counted the laps out loud and cheered herself on."

# game/02_cap1_beat_casa.rpy:837
translate english bcl_yotsuba_eb59a1cc:

    # mc_pensamiento "Llevaba la cuenta anotada en la muñeca con rotulador. Si no, pierde el número."
    mc_pensamiento "She kept the count in marker on her wrist. Otherwise, she loses the number."

# game/02_cap1_beat_casa.rpy:839
translate english bcl_yotsuba_210624e1:

    # mc_pensamiento "Primero dijo veinticinco series. Después, treinta."
    mc_pensamiento "First she said twenty-five sets. Then thirty."

# game/02_cap1_beat_casa.rpy:841
translate english bcl_yotsuba_0247550a:

    # mc_pensamiento "Dijo que sus hermanas son mejores que ella en casi todo."
    mc_pensamiento "She said her sisters are better than her at almost everything."

# game/02_cap1_beat_casa.rpy:843
translate english bcl_yotsuba_070a0416:

    # mc_pensamiento "«Yo corro y animo.» Lo dijo sonriendo, como quien dice que va a llover."
    mc_pensamiento "\"I run and cheer.\" She said it smiling, like someone saying it's going to rain."

# game/02_cap1_beat_casa.rpy:847
translate english bcl_yotsuba_9dfda34a:

    # mc_pensamiento "Le conté lo que yo había notado."
    mc_pensamiento "I told her what I'd noticed."

# game/02_cap1_beat_casa.rpy:849
translate english bcl_yotsuba_821a3b62:

    # mc_pensamiento "Que supo que Nino no había dormido antes de que Nino dijera nada."
    mc_pensamiento "That she knew Nino hadn't slept before Nino said anything."

# game/02_cap1_beat_casa.rpy:851
translate english bcl_yotsuba_1b996351:

    # mc_pensamiento "Que sabía dónde dejaba Miku su libro, y que bajaba la voz cuando Ichika se dormía."
    mc_pensamiento "That she knew where Miku left her book, and lowered her voice when Ichika fell asleep."

# game/02_cap1_beat_casa.rpy:853
translate english bcl_yotsuba_0c531bc6:

    # mc_pensamiento "Le dije que su punto de partida no era cero. Que nunca lo había sido."
    mc_pensamiento "I told her her starting point wasn't zero. That it never had been."

# game/02_cap1_beat_casa.rpy:855
translate english bcl_yotsuba_91abd36c:

    # mc_pensamiento "En la vuelta veinticuatro siguió contando en voz alta. El tiempo se lo decía yo."
    mc_pensamiento "On lap twenty-four she kept counting out loud. I was the one calling her time."

# game/02_cap1_beat_casa.rpy:857
translate english bcl_yotsuba_f91f9a8a:

    # mc_pensamiento "Al día siguiente me escribió un «1» en la muñeca con un corazón torcido. Dijo que era una vuelta."
    mc_pensamiento "The next day she wrote a \"1\" on my wrist with a crooked heart. She said it was one lap."

# game/02_cap1_beat_casa.rpy:861
translate english bcl_yotsuba_b39ad384:

    # mc_pensamiento "Le tomé el tiempo: un minuto con diecisiete."
    mc_pensamiento "I timed her: one minute seventeen."

# game/02_cap1_beat_casa.rpy:863
translate english bcl_yotsuba_cb5d9f6f:

    # mc_pensamiento "Se rió, esquivó el tema y dijo que sus piernas le hablan en un idioma secreto."
    mc_pensamiento "She laughed, dodged the subject, and said her legs talk to her in a secret language."

# game/02_cap1_beat_casa.rpy:865
translate english bcl_yotsuba_9d915a39:

    # mc_pensamiento "No supe si la ayudé o solo la dejé correr."
    mc_pensamiento "I couldn't tell if I'd helped her or just let her run."

# game/02_cap1_beat_casa.rpy:869
translate english bcl_yotsuba_fcecdcf5:

    # mc_pensamiento "Le dije que se concentrara en correr."
    mc_pensamiento "I told her to focus on running."

# game/02_cap1_beat_casa.rpy:871
translate english bcl_yotsuba_ab10fb2a:

    # mc_pensamiento "Asintió con la misma sonrisa y dejó de contar en voz alta."
    mc_pensamiento "She nodded with the same smile and stopped counting out loud."

# game/02_cap1_beat_casa.rpy:873
translate english bcl_yotsuba_35e8422e:

    # mc_pensamiento "Al día siguiente me llamó «tutor», con el tono que se usa con un desconocido."
    mc_pensamiento "The next day she called me \"tutor,\" in the tone you use with a stranger."

# game/02_cap1_beat_casa.rpy:875
translate english bcl_yotsuba_628574a9:

    # mc_pensamiento "Le confirmé la única cosa de la que nadie debería haberla convencido."
    mc_pensamiento "I confirmed the one thing nobody should ever have convinced her of."

# game/02_cap1_beat_casa.rpy:877
translate english bcl_yotsuba_45f8b50a:

    # mc_pensamiento "Cuando me fui, ya había vuelto a la pista. No se despidió, ninguno de los dos lo hizo."
    mc_pensamiento "When I left, she'd already gone back to the track. She didn't say goodbye, and neither did I."

# game/02_cap1_beat_casa.rpy:881
translate english bcl_yotsuba_f500e5c0:

    # mc_pensamiento "Y sin embargo hay algo que sí lee, y lo lee mejor que yo."
    mc_pensamiento "And yet there's something she does read, and she reads it better than I do."

# game/02_cap1_beat_casa.rpy:883
translate english bcl_yotsuba_6992a909:

    # mc_pensamiento "Sabe quién no durmió, quién busca algo y quién necesita silencio, sin que se lo digan."
    mc_pensamiento "She knows who didn't sleep, who's looking for something, and who needs quiet, without being told."

# game/02_cap1_beat_casa.rpy:885
translate english bcl_yotsuba_61d9b41b:

    # mc_pensamiento "Lo hace con cinco personas a la vez, y ni siquiera lo cuenta como un mérito."
    mc_pensamiento "She does it with five people at once, and doesn't even count it as a merit."

# game/02_cap1_beat_casa.rpy:893
translate english bcl_yotsuba_53fd909b:

    # mc_pensamiento "A Yotsuba tampoco fui a buscarla."
    mc_pensamiento "I didn't go looking for Yotsuba either."

# game/02_cap1_beat_casa.rpy:895
translate english bcl_yotsuba_a0100973:

    # mc_pensamiento "La conocí corriendo hacia mí, con una sonrisa enorme y un «¿verdad?» medio tono más bajo."
    mc_pensamiento "I met her running toward me, with a huge smile and a \"right?\" half a tone lower."

# game/02_cap1_beat_casa.rpy:897
translate english bcl_yotsuba_ded79cf8:

    # mc_pensamiento "El primer día escribió su nombre en la hoja. Solo su nombre."
    mc_pensamiento "The first day she wrote her name on the sheet. Just her name."

# game/02_cap1_beat_casa.rpy:899
translate english bcl_yotsuba_762f6110:

    # mc_pensamiento "El segundo intentó defenderme y Nino la cortó."
    mc_pensamiento "The second day she tried to defend me and Nino cut her off."

# game/02_cap1_beat_casa.rpy:901
translate english bcl_yotsuba_2b889a37:

    # mc_pensamiento "Cuando le pedí perdón, me dijo de tres maneras distintas que no pasaba nada."
    mc_pensamiento "When I apologized, she told me three different ways that it was fine."

# game/02_cap1_beat_casa.rpy:903
translate english bcl_yotsuba_3f59a290:

    # mc_pensamiento "Pero entrenó quince minutos más cada tarde, por si yo iba. Los contó."
    mc_pensamiento "But she trained fifteen extra minutes every afternoon, in case I showed up. She counted them."

# game/02_cap1_beat_casa.rpy:905
translate english bcl_yotsuba_3086dbe7:

    # mc_pensamiento "«Si nadie me necesita, ¿para qué me sobra tanta energía?»"
    mc_pensamiento "\"If nobody needs me, why do I have so much energy left over?\""

# game/02_cap1_beat_casa.rpy:907
translate english bcl_yotsuba_4516e1c0:

    # mc_pensamiento "Se fue corriendo y, al doblar la esquina, bajó el ritmo."
    mc_pensamiento "She ran off and, rounding the corner, slowed down."

# game/02_cap1_beat_casa.rpy:909
translate english bcl_yotsuba_a3de6c14:

    # mc_pensamiento "Sigo sin saber qué hace cuando nadie la mira."
    mc_pensamiento "I still don't know what she does when nobody's watching."

# game/02_cap1_beat_casa.rpy:911
translate english bcl_yotsuba_6faaffe7:

    # mc_pensamiento "Solo la sonrisa que le pone a todo, incluso a lo que no debería sonreírse."
    mc_pensamiento "Only the smile she puts on everything, even things she shouldn't smile at."

# game/02_cap1_beat_casa.rpy:932
translate english bcl_itsuki_f796f532:

    # mc_pensamiento "A Itsuki la conocí antes de saber su nombre."
    mc_pensamiento "I met Itsuki before I knew her name."

# game/02_cap1_beat_casa.rpy:934
translate english bcl_itsuki_7fd9a9da:

    # mc_pensamiento "Estaba sentada en mi sitio, almorzando, y me pidió que le enseñara un poco."
    mc_pensamiento "She was sitting in my seat, eating lunch, and asked me to teach her a little."

# game/02_cap1_beat_casa.rpy:936
translate english bcl_itsuki_7f7fb01a:

    # mc_pensamiento "Le dije que no. Que aprender es un proceso personal."
    mc_pensamiento "I said no. That learning is a personal process."

# game/02_cap1_beat_casa.rpy:938
translate english bcl_itsuki_67602562:

    # mc_pensamiento "Me devolvió una frase que todavía recuerdo: arrogante y carente de empatía."
    mc_pensamiento "She threw a phrase back at me that I still remember: arrogant, with no empathy."

# game/02_cap1_beat_casa.rpy:940
translate english bcl_itsuki_be49ac21:

    # mc_pensamiento "Esa tarde nos cruzamos en la azotea. Nos quedamos en silencio, cada uno en un extremo del banco."
    mc_pensamiento "That afternoon we crossed paths on the rooftop. We sat in silence, each at one end of the bench."

# game/02_cap1_beat_casa.rpy:942
translate english bcl_itsuki_6c788b87:

    # mc_pensamiento "Y por la noche, en la puerta del departamento, descubrí que ella vivía ahí."
    mc_pensamiento "And that night, at the apartment door, I found out she lived there."

# game/02_cap1_beat_casa.rpy:944
translate english bcl_itsuki_569a71a7:

    # mc_pensamiento "Dijo que prefería reprobar todos los exámenes antes que recibir una sola clase mía."
    mc_pensamiento "She said she'd rather fail every exam than take a single lesson from me."

# game/02_cap1_beat_casa.rpy:946
translate english bcl_itsuki_302cf024:

    # mc_pensamiento "Hay algo de ese primer día que sigo sin saldar con ella."
    mc_pensamiento "There's something from that first day I still haven't settled with her."

# game/02_cap1_beat_casa.rpy:948
translate english bcl_itsuki_36cbf0a0:

    # mc_pensamiento "Al día siguiente me dejó mi asiento libre a propósito. Eso también era un mensaje."
    mc_pensamiento "The next day she left my seat free on purpose. That was a message too."

# game/02_cap1_beat_casa.rpy:950
translate english bcl_itsuki_e4a124db:

    # mc_pensamiento "Dijo que no pensaba estudiar conmigo."
    mc_pensamiento "She said she had no intention of studying with me."

# game/02_cap1_beat_casa.rpy:952
translate english bcl_itsuki_0b906a2d:

    # mc_pensamiento "Aun así, fue ella quien se inventó el juego de busca y encuentra."
    mc_pensamiento "Even so, she was the one who invented the hide-and-seek game."

# game/02_cap1_beat_casa.rpy:954
translate english bcl_itsuki_4a591b36:

    # mc_pensamiento "Y dijo que no pensaba esconderse. Que estaría donde siempre."
    mc_pensamiento "And she said she wouldn't hide. That she'd be where she always is."

# game/02_cap1_beat_casa.rpy:958
translate english bcl_itsuki_a4dc247f:

    # mc_pensamiento "Estaba en el aula vacía, con la luz entrando de lado."
    mc_pensamiento "She was in the empty classroom, the light coming in sideways."

# game/02_cap1_beat_casa.rpy:960
translate english bcl_itsuki_08da3a21:

    # mc_pensamiento "Tenía el lápiz levantado, quieto, y tres respuestas tachadas con la misma cifra al final."
    mc_pensamiento "Her pencil was raised, still, and three answers crossed out with the same figure at the end."

# game/02_cap1_beat_casa.rpy:962
translate english bcl_itsuki_3a4d1ffe:

    # mc_pensamiento "«El tiempo que hace falta», contestó. Y lo repitió palabra por palabra. Eso la delató."
    mc_pensamiento "\"As long as it takes,\" she answered. And she repeated it word for word. That gave her away."

# game/02_cap1_beat_casa.rpy:964
translate english bcl_itsuki_3400efa3:

    # mc_pensamiento "Dijo que las otras podían decir que no lo habían intentado. Que ella no tenía esa excusa."
    mc_pensamiento "She said the others could say they hadn't tried. That she didn't have that excuse."

# game/02_cap1_beat_casa.rpy:966
translate english bcl_itsuki_2b60dae9:

    # mc_pensamiento "Y enseguida: «olvida lo que dije»."
    mc_pensamiento "And right after: \"forget what I said.\""

# game/02_cap1_beat_casa.rpy:968
translate english bcl_itsuki_98f655d3:

    # mc_pensamiento "Se hundió sobre el cuaderno, y entendí por qué no le preguntaba a nadie."
    mc_pensamiento "She sank over the notebook, and I understood why she didn't ask anyone."

# game/02_cap1_beat_casa.rpy:970
translate english bcl_itsuki_895f0ba8:

    # mc_pensamiento "Preguntarle a sus hermanas era admitir algo. Preguntarme a mí, darme la razón."
    mc_pensamiento "Asking her sisters meant admitting something. Asking me, conceding the point."

# game/02_cap1_beat_casa.rpy:972
translate english bcl_itsuki_a17ac3c0:

    # mc_pensamiento "No era que no supiera resolverlo. Arrastraba el mismo error del medio sin tocarlo."
    mc_pensamiento "It wasn't that she couldn't solve it. She kept dragging the same mistake from the middle, untouched."

# game/02_cap1_beat_casa.rpy:976
translate english bcl_itsuki_7b4438d9:

    # mc_pensamiento "Le señalé el segundo paso, sin decirle qué estaba mal."
    mc_pensamiento "I pointed to the second step without telling her what was wrong."

# game/02_cap1_beat_casa.rpy:978
translate english bcl_itsuki_112cfc8b:

    # mc_pensamiento "Lo encontró ella sola: «la unidad no se cancela ahí»."
    mc_pensamiento "She found it herself: \"the unit doesn't cancel there.\""

# game/02_cap1_beat_casa.rpy:980
translate english bcl_itsuki_1b17f504:

    # mc_pensamiento "No me dio las gracias. Tampoco me pidió que me fuera."
    mc_pensamiento "She didn't thank me. She didn't tell me to leave, either."

# game/02_cap1_beat_casa.rpy:982
translate english bcl_itsuki_b7bd90f3:

    # mc_pensamiento "Al día siguiente me contó que había rehecho el ejercicio desde el principio."
    mc_pensamiento "The next day she told me she'd redone the exercise from the start."

# game/02_cap1_beat_casa.rpy:984
translate english bcl_itsuki_5bece3f0:

    # mc_pensamiento "Sin mirar la corrección."
    mc_pensamiento "Without looking at the correction."

# game/02_cap1_beat_casa.rpy:986
translate english bcl_itsuki_1825a9f8:

    # mc_pensamiento "Salió bien."
    mc_pensamiento "It came out right."

# game/02_cap1_beat_casa.rpy:990
translate english bcl_itsuki_dd97f49a:

    # mc_pensamiento "Le ofrecí revisarlo desde el principio y dijo que no antes de saber qué iba a explicarle."
    mc_pensamiento "I offered to go over it from the start and she said no before knowing what I'd explain."

# game/02_cap1_beat_casa.rpy:992
translate english bcl_itsuki_88850266:

    # mc_pensamiento "Cerró el cuaderno un centímetro, lo justo para rechazar la oferta."
    mc_pensamiento "She closed the notebook a centimeter, just enough to refuse the offer."

# game/02_cap1_beat_casa.rpy:994
translate english bcl_itsuki_8326a132:

    # mc_pensamiento "Al día siguiente dijo que todavía no necesitaba mi ayuda. Y que «todavía» era solo una expresión."
    mc_pensamiento "The next day she said she didn't need my help yet. And that \"yet\" was just a figure of speech."

# game/02_cap1_beat_casa.rpy:998
translate english bcl_itsuki_83d90008:

    # mc_pensamiento "Le quité el cuaderno y se lo resolví yo, de pie, con su propio lápiz."
    mc_pensamiento "I took the notebook and solved it for her, standing, with her own pencil."

# game/02_cap1_beat_casa.rpy:1000
translate english bcl_itsuki_45371e65:

    # mc_pensamiento "Rápido y correcto. Y le quité lo único que estaba defendiendo: hacerlo ella sola."
    mc_pensamiento "Fast and correct. And I took the one thing she was defending: doing it herself."

# game/02_cap1_beat_casa.rpy:1002
translate english bcl_itsuki_5f3d484a:

    # mc_pensamiento "Al día siguiente había rehecho todo el ejercicio debajo de mi solución, tachada."
    mc_pensamiento "The next day she'd redone the whole exercise under my solution, crossed out."

# game/02_cap1_beat_casa.rpy:1004
translate english bcl_itsuki_385f0c59:

    # mc_pensamiento "«Lo que hiciste ayer no cuenta. Quería que fuera mío.»"
    mc_pensamiento "\"What you did yesterday doesn't count. I wanted it to be mine.\""

# game/02_cap1_beat_casa.rpy:1008
translate english bcl_itsuki_77f8ab79:

    # mc_pensamiento "No fui a buscarla al aula."
    mc_pensamiento "I didn't go looking for her at the classroom."

# game/02_cap1_beat_casa.rpy:1010
translate english bcl_itsuki_e77fe70d:

    # mc_pensamiento "A Itsuki la conocí por un asiento, y ella a mí por arrogante. No le faltó razón."
    mc_pensamiento "I met Itsuki over a seat, and she met me as arrogant. She wasn't wrong."

# game/02_cap1_beat_casa.rpy:1012
translate english bcl_itsuki_4ebae3ec:

    # mc_pensamiento "Dijo que prefería reprobar todos los exámenes antes que recibir una clase mía."
    mc_pensamiento "She said she'd rather fail every exam than take a lesson from me."

# game/02_cap1_beat_casa.rpy:1014
translate english bcl_itsuki_0b906a2d_1:

    # mc_pensamiento "Aun así, fue ella quien se inventó el juego de busca y encuentra."
    mc_pensamiento "Even so, she was the one who invented the hide-and-seek game."

# game/02_cap1_beat_casa.rpy:1016
translate english bcl_itsuki_a399a037:

    # mc_pensamiento "Cuando supo que no la había ido a buscar, dijo que había ganado el juego."
    mc_pensamiento "When she found out I hadn't gone looking for her, she said she'd won the game."

# game/02_cap1_beat_casa.rpy:1018
translate english bcl_itsuki_05aec194:

    # mc_pensamiento "Que tener razón es lo único que siempre le sale bien."
    mc_pensamiento "That being right is the only thing she always does well."

# game/02_cap1_beat_casa.rpy:1020
translate english bcl_itsuki_39afc0d9:

    # mc_pensamiento "Y que, si hubiera ido, no me habría echado. No inmediatamente."
    mc_pensamiento "And that, if I had gone, she wouldn't have thrown me out. Not right away."

# game/02_cap1_beat_casa.rpy:1024
translate english bcl_itsuki_b2151d78:

    # mc_pensamiento "En la azotea la encontré con el cuaderno cerrado sobre las rodillas."
    mc_pensamiento "On the rooftop I found her with the notebook closed on her knees."

# game/02_cap1_beat_casa.rpy:1028
translate english bcl_itsuki_718a6603:

    # mc_pensamiento "Antes de que lo cerrara alcancé a ver la página: un ejercicio con un círculo a lápiz."
    mc_pensamiento "Before she closed it, I caught the page: an exercise circled in pencil."

# game/02_cap1_beat_casa.rpy:1030
translate english bcl_itsuki_dc1508c2:

    # mc_pensamiento "Repasado tantas veces que había hundido el papel. Era el de la hoja de diagnóstico del primer día."
    mc_pensamiento "Gone over so many times it had dented the paper. It was from day one's diagnostic sheet."

# game/02_cap1_beat_casa.rpy:1032
translate english bcl_itsuki_74d08632:

    # mc_pensamiento "Ya no le quedaba ningún sitio donde no tuviera que estudiar."
    mc_pensamiento "She had no place left where she didn't have to study."

# game/02_cap1_beat_casa.rpy:1034
translate english bcl_itsuki_5ba91cbd:

    # mc_pensamiento "Tenía las manos quietas sobre la tapa, sin una mancha de tinta."
    mc_pensamiento "Her hands rested on the cover, still, without a single ink smudge."

# game/02_cap1_beat_casa.rpy:1036
translate english bcl_itsuki_50f1ff71:

    # mc_pensamiento "Nos quedamos un rato largo sin abrir ninguno de los dos libros."
    mc_pensamiento "We stayed a good while without either of us opening a book."

# game/02_cap1_beat_casa.rpy:1038
translate english bcl_itsuki_88eb0e7f:

    # mc_pensamiento "Se me voló una hoja hasta la valla y ninguno fue a buscarla."
    mc_pensamiento "A page of mine blew off to the fence and neither of us went after it."

# game/02_cap1_beat_casa.rpy:1040
translate english bcl_itsuki_8b2096a2:

    # mc_pensamiento "Esas semanas la estaban gastando a ella tanto como a mí."
    mc_pensamiento "Those weeks were wearing her down as much as me."

# game/02_cap1_beat_casa.rpy:1046
translate english bcl_itsuki_dd17fee9:

    # mc_pensamiento "Y sigo dándole vueltas a lo mismo."
    mc_pensamiento "And I keep turning over the same thing."

# game/02_cap1_beat_casa.rpy:1048
translate english bcl_itsuki_be95fcf2:

    # mc_pensamiento "Plantea bien, un problema tras otro. El resto de su cuaderno no tenía un solo error."
    mc_pensamiento "She sets problems up well, one after another. The rest of her notebook had not a single mistake."

# game/02_cap1_beat_casa.rpy:1050
translate english bcl_itsuki_1dc10195:

    # mc_pensamiento "A veces le basta con que alguien le diga dónde mirar para ver todo lo demás."
    mc_pensamiento "Sometimes all she needs is for someone to tell her where to look, and she sees everything else."

# game/02_cap1_beat_casa.rpy:1052
translate english bcl_itsuki_00c3e2bd:

    # mc_pensamiento "Lo que le falta no es método. Tampoco es esfuerzo."
    mc_pensamiento "What she lacks isn't method. It isn't effort either."

# game/02_cap1_beat_casa.rpy:1060
translate english bcl_itsuki_579eb0a1:

    # mc_pensamiento "Lo que sea que le pase, no es falta de esfuerzo."
    mc_pensamiento "Whatever's going on with her, it isn't lack of effort."

# game/02_cap1_beat_casa.rpy:1062
translate english bcl_itsuki_9ee50288:

    # mc_pensamiento "Y no sé cómo ofrecerle ayuda sin que la tome como una derrota."
    mc_pensamiento "And I don't know how to offer help without her taking it as a defeat."

# game/02_cap1_beat_casa.rpy:1077
translate english beat_casa_cierre_e783900b:

    # narrador "Cerré la libreta y apagué la lámpara."
    narrador "I closed the notebook and turned off the lamp."

# game/02_cap1_beat_casa.rpy:1079
translate english beat_casa_cierre_386f4acc:

    # narrador "Desde el otro cuarto, todavía se oía a Raiha ordenando sus cosas para el día siguiente."
    narrador "From the next room, I could still hear Raiha getting her things ready for tomorrow."

# game/02_cap1_beat_casa.rpy:1081
translate english beat_casa_cierre_5b67ccf6:

    # narrador "Como si mañana fuera un día cualquiera."
    narrador "As if tomorrow were any other day."

# game/02_cap1_beat_casa.rpy:1083
translate english beat_casa_cierre_61a2c755:

    # mc_pensamiento "Para ella lo es."
    mc_pensamiento "For her, it is."

# game/02_cap1_beat_casa.rpy:1085
translate english beat_casa_cierre_a61902e8:

    # mc_pensamiento "Ojalá pudiera decir lo mismo."
    mc_pensamiento "I wish I could say the same."

# game/02_cap1_beat_casa.rpy:1087
translate english beat_casa_cierre_420d6e45:

    # narrador "Mañana será el examen."
    narrador "Tomorrow is the exam."

translate english strings:

    # game/02_cap1_beat_casa.rpy:341
    old "Cerrar la libreta."
    new "Shut the notebook."

