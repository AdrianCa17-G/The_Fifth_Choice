translate english bcl_yotsuba_210624e1:

    # mc_pensamiento "Primero dijo veinticinco series. Después, treinta."
    mc_pensamiento "Primero dijo veinticinco series. Después, treinta."

# game/02_cap1_beat_casa.rpy:841
translate english bcl_yotsuba_0247550a:

    # mc_pensamiento "Dijo que sus hermanas son mejores que ella en casi todo."
    mc_pensamiento "Dijo que sus hermanas son mejores que ella en casi todo."

# game/02_cap1_beat_casa.rpy:843
translate english bcl_yotsuba_070a0416:

    # mc_pensamiento "«Yo corro y animo.» Lo dijo sonriendo, como quien dice que va a llover."
    mc_pensamiento "«Yo corro y animo.» Lo dijo sonriendo, como quien dice que va a llover."

# game/02_cap1_beat_casa.rpy:847
translate english bcl_yotsuba_9dfda34a:

    # mc_pensamiento "Le conté lo que yo había notado."
    mc_pensamiento "Le conté lo que yo había notado."

# game/02_cap1_beat_casa.rpy:849
translate english bcl_yotsuba_821a3b62:

    # mc_pensamiento "Que supo que Nino no había dormido antes de que Nino dijera nada."
    mc_pensamiento "Que supo que Nino no había dormido antes de que Nino dijera nada."

# game/02_cap1_beat_casa.rpy:851
translate english bcl_yotsuba_1b996351:

    # mc_pensamiento "Que sabía dónde dejaba Miku su libro, y que bajaba la voz cuando Ichika se dormía."
    mc_pensamiento "Que sabía dónde dejaba Miku su libro, y que bajaba la voz cuando Ichika se dormía."

# game/02_cap1_beat_casa.rpy:853
translate english bcl_yotsuba_0c531bc6:

    # mc_pensamiento "Le dije que su punto de partida no era cero. Que nunca lo había sido."
    mc_pensamiento "Le dije que su punto de partida no era cero. Que nunca lo había sido."

# game/02_cap1_beat_casa.rpy:855
translate english bcl_yotsuba_91abd36c:

    # mc_pensamiento "En la vuelta veinticuatro siguió contando en voz alta. El tiempo se lo decía yo."
    mc_pensamiento "En la vuelta veinticuatro siguió contando en voz alta. El tiempo se lo decía yo."

# game/02_cap1_beat_casa.rpy:857
translate english bcl_yotsuba_f91f9a8a:

    # mc_pensamiento "Al día siguiente me escribió un «1» en la muñeca con un corazón torcido. Dijo que era una vuelta."
    mc_pensamiento "Al día siguiente me escribió un «1» en la muñeca con un corazón torcido. Dijo que era una vuelta."

# game/02_cap1_beat_casa.rpy:861
translate english bcl_yotsuba_b39ad384:

    # mc_pensamiento "Le tomé el tiempo: un minuto con diecisiete."
    mc_pensamiento "Le tomé el tiempo: un minuto con diecisiete."

# game/02_cap1_beat_casa.rpy:863
translate english bcl_yotsuba_cb5d9f6f:

    # mc_pensamiento "Se rió, esquivó el tema y dijo que sus piernas le hablan en un idioma secreto."
    mc_pensamiento "Se rió, esquivó el tema y dijo que sus piernas le hablan en un idioma secreto."

# game/02_cap1_beat_casa.rpy:865
translate english bcl_yotsuba_9d915a39:

    # mc_pensamiento "No supe si la ayudé o solo la dejé correr."
    mc_pensamiento "No supe si la ayudé o solo la dejé correr."

# game/02_cap1_beat_casa.rpy:869
translate english bcl_yotsuba_fcecdcf5:

    # mc_pensamiento "Le dije que se concentrara en correr."
    mc_pensamiento "Le dije que se concentrara en correr."

# game/02_cap1_beat_casa.rpy:871
translate english bcl_yotsuba_ab10fb2a:

    # mc_pensamiento "Asintió con la misma sonrisa y dejó de contar en voz alta."
    mc_pensamiento "Asintió con la misma sonrisa y dejó de contar en voz alta."

# game/02_cap1_beat_casa.rpy:873
translate english bcl_yotsuba_35e8422e:

    # mc_pensamiento "Al día siguiente me llamó «tutor», con el tono que se usa con un desconocido."
    mc_pensamiento "Al día siguiente me llamó «tutor», con el tono que se usa con un desconocido."

# game/02_cap1_beat_casa.rpy:875
translate english bcl_yotsuba_628574a9:

    # mc_pensamiento "Le confirmé la única cosa de la que nadie debería haberla convencido."
    mc_pensamiento "Le confirmé la única cosa de la que nadie debería haberla convencido."

# game/02_cap1_beat_casa.rpy:877
translate english bcl_yotsuba_45f8b50a:

    # mc_pensamiento "Cuando me fui, ya había vuelto a la pista. No se despidió, ninguno de los dos lo hizo."
    mc_pensamiento "Cuando me fui, ya había vuelto a la pista. No se despidió, ninguno de los dos lo hizo."

# game/02_cap1_beat_casa.rpy:881
translate english bcl_yotsuba_f500e5c0:

    # mc_pensamiento "Y sin embargo hay algo que sí lee, y lo lee mejor que yo."
    mc_pensamiento "Y sin embargo hay algo que sí lee, y lo lee mejor que yo."

# game/02_cap1_beat_casa.rpy:883
translate english bcl_yotsuba_6992a909:

    # mc_pensamiento "Sabe quién no durmió, quién busca algo y quién necesita silencio, sin que se lo digan."
    mc_pensamiento "Sabe quién no durmió, quién busca algo y quién necesita silencio, sin que se lo digan."

# game/02_cap1_beat_casa.rpy:885
translate english bcl_yotsuba_61d9b41b:

    # mc_pensamiento "Lo hace con cinco personas a la vez, y ni siquiera lo cuenta como un mérito."
    mc_pensamiento "Lo hace con cinco personas a la vez, y ni siquiera lo cuenta como un mérito."

# game/02_cap1_beat_casa.rpy:893
translate english bcl_yotsuba_53fd909b:

    # mc_pensamiento "A Yotsuba tampoco fui a buscarla."
    mc_pensamiento "A Yotsuba tampoco fui a buscarla."

# game/02_cap1_beat_casa.rpy:895
translate english bcl_yotsuba_a0100973:

    # mc_pensamiento "La conocí corriendo hacia mí, con una sonrisa enorme y un «¿verdad?» medio tono más bajo."
    mc_pensamiento "La conocí corriendo hacia mí, con una sonrisa enorme y un «¿verdad?» medio tono más bajo."

# game/02_cap1_beat_casa.rpy:897
translate english bcl_yotsuba_ded79cf8:

    # mc_pensamiento "El primer día escribió su nombre en la hoja. Solo su nombre."
    mc_pensamiento "El primer día escribió su nombre en la hoja. Solo su nombre."

# game/02_cap1_beat_casa.rpy:899
translate english bcl_yotsuba_762f6110:

    # mc_pensamiento "El segundo intentó defenderme y Nino la cortó."
    mc_pensamiento "El segundo intentó defenderme y Nino la cortó."

# game/02_cap1_beat_casa.rpy:901
translate english bcl_yotsuba_2b889a37:

    # mc_pensamiento "Cuando le pedí perdón, me dijo de tres maneras distintas que no pasaba nada."
    mc_pensamiento "Cuando le pedí perdón, me dijo de tres maneras distintas que no pasaba nada."

# game/02_cap1_beat_casa.rpy:903
translate english bcl_yotsuba_3f59a290:

    # mc_pensamiento "Pero entrenó quince minutos más cada tarde, por si yo iba. Los contó."
    mc_pensamiento "Pero entrenó quince minutos más cada tarde, por si yo iba. Los contó."

# game/02_cap1_beat_casa.rpy:905
translate english bcl_yotsuba_3086dbe7:

    # mc_pensamiento "«Si nadie me necesita, ¿para qué me sobra tanta energía?»"
    mc_pensamiento "«Si nadie me necesita, ¿para qué me sobra tanta energía?»"

# game/02_cap1_beat_casa.rpy:907
translate english bcl_yotsuba_4516e1c0:

    # mc_pensamiento "Se fue corriendo y, al doblar la esquina, bajó el ritmo."
    mc_pensamiento "Se fue corriendo y, al doblar la esquina, bajó el ritmo."

# game/02_cap1_beat_casa.rpy:909
translate english bcl_yotsuba_a3de6c14:

    # mc_pensamiento "Sigo sin saber qué hace cuando nadie la mira."
    mc_pensamiento "Sigo sin saber qué hace cuando nadie la mira."

# game/02_cap1_beat_casa.rpy:911
translate english bcl_yotsuba_6faaffe7:

    # mc_pensamiento "Solo la sonrisa que le pone a todo, incluso a lo que no debería sonreírse."
    mc_pensamiento "Solo la sonrisa que le pone a todo, incluso a lo que no debería sonreírse."

# game/02_cap1_beat_casa.rpy:932
translate english bcl_itsuki_f796f532:

    # mc_pensamiento "A Itsuki la conocí antes de saber su nombre."
    mc_pensamiento "A Itsuki la conocí antes de saber su nombre."

# game/02_cap1_beat_casa.rpy:934
translate english bcl_itsuki_7fd9a9da:

    # mc_pensamiento "Estaba sentada en mi sitio, almorzando, y me pidió que le enseñara un poco."
    mc_pensamiento "Estaba sentada en mi sitio, almorzando, y me pidió que le enseñara un poco."

# game/02_cap1_beat_casa.rpy:936
translate english bcl_itsuki_7f7fb01a:

    # mc_pensamiento "Le dije que no. Que aprender es un proceso personal."
    mc_pensamiento "Le dije que no. Que aprender es un proceso personal."

# game/02_cap1_beat_casa.rpy:938
translate english bcl_itsuki_67602562:

    # mc_pensamiento "Me devolvió una frase que todavía recuerdo: arrogante y carente de empatía."
    mc_pensamiento "Me devolvió una frase que todavía recuerdo: arrogante y carente de empatía."

# game/02_cap1_beat_casa.rpy:940
translate english bcl_itsuki_be49ac21:

    # mc_pensamiento "Esa tarde nos cruzamos en la azotea. Nos quedamos en silencio, cada uno en un extremo del banco."
    mc_pensamiento "Esa tarde nos cruzamos en la azotea. Nos quedamos en silencio, cada uno en un extremo del banco."

# game/02_cap1_beat_casa.rpy:942
translate english bcl_itsuki_6c788b87:

    # mc_pensamiento "Y por la noche, en la puerta del departamento, descubrí que ella vivía ahí."
    mc_pensamiento "Y por la noche, en la puerta del departamento, descubrí que ella vivía ahí."

# game/02_cap1_beat_casa.rpy:944
translate english bcl_itsuki_569a71a7:

    # mc_pensamiento "Dijo que prefería reprobar todos los exámenes antes que recibir una sola clase mía."
    mc_pensamiento "Dijo que prefería reprobar todos los exámenes antes que recibir una sola clase mía."

# game/02_cap1_beat_casa.rpy:946
translate english bcl_itsuki_302cf024:

    # mc_pensamiento "Hay algo de ese primer día que sigo sin saldar con ella."
    mc_pensamiento "Hay algo de ese primer día que sigo sin saldar con ella."

# game/02_cap1_beat_casa.rpy:948
translate english bcl_itsuki_36cbf0a0:

    # mc_pensamiento "Al día siguiente me dejó mi asiento libre a propósito. Eso también era un mensaje."
    mc_pensamiento "Al día siguiente me dejó mi asiento libre a propósito. Eso también era un mensaje."

# game/02_cap1_beat_casa.rpy:950
translate english bcl_itsuki_e4a124db:

    # mc_pensamiento "Dijo que no pensaba estudiar conmigo."
    mc_pensamiento "Dijo que no pensaba estudiar conmigo."

# game/02_cap1_beat_casa.rpy:952
translate english bcl_itsuki_0b906a2d:

    # mc_pensamiento "Aun así, fue ella quien se inventó el juego de busca y encuentra."
    mc_pensamiento "Aun así, fue ella quien se inventó el juego de busca y encuentra."

# game/02_cap1_beat_casa.rpy:954
translate english bcl_itsuki_4a591b36:

    # mc_pensamiento "Y dijo que no pensaba esconderse. Que estaría donde siempre."
    mc_pensamiento "Y dijo que no pensaba esconderse. Que estaría donde siempre."

# game/02_cap1_beat_casa.rpy:958
translate english bcl_itsuki_a4dc247f:

    # mc_pensamiento "Estaba en el aula vacía, con la luz entrando de lado."
    mc_pensamiento "Estaba en el aula vacía, con la luz entrando de lado."

# game/02_cap1_beat_casa.rpy:960
translate english bcl_itsuki_08da3a21:

    # mc_pensamiento "Tenía el lápiz levantado, quieto, y tres respuestas tachadas con la misma cifra al final."
    mc_pensamiento "Tenía el lápiz levantado, quieto, y tres respuestas tachadas con la misma cifra al final."

# game/02_cap1_beat_casa.rpy:962
translate english bcl_itsuki_3a4d1ffe:

    # mc_pensamiento "«El tiempo que hace falta», contestó. Y lo repitió palabra por palabra. Eso la delató."
    mc_pensamiento "«El tiempo que hace falta», contestó. Y lo repitió palabra por palabra. Eso la delató."

# game/02_cap1_beat_casa.rpy:964
translate english bcl_itsuki_3400efa3:

    # mc_pensamiento "Dijo que las otras podían decir que no lo habían intentado. Que ella no tenía esa excusa."
    mc_pensamiento "Dijo que las otras podían decir que no lo habían intentado. Que ella no tenía esa excusa."

# game/02_cap1_beat_casa.rpy:966
translate english bcl_itsuki_2b60dae9:

    # mc_pensamiento "Y enseguida: «olvida lo que dije»."
    mc_pensamiento "Y enseguida: «olvida lo que dije»."

# game/02_cap1_beat_casa.rpy:968
translate english bcl_itsuki_98f655d3:

    # mc_pensamiento "Se hundió sobre el cuaderno, y entendí por qué no le preguntaba a nadie."
    mc_pensamiento "Se hundió sobre el cuaderno, y entendí por qué no le preguntaba a nadie."

# game/02_cap1_beat_casa.rpy:970
translate english bcl_itsuki_895f0ba8:

    # mc_pensamiento "Preguntarle a sus hermanas era admitir algo. Preguntarme a mí, darme la razón."
    mc_pensamiento "Preguntarle a sus hermanas era admitir algo. Preguntarme a mí, darme la razón."

# game/02_cap1_beat_casa.rpy:972
translate english bcl_itsuki_a17ac3c0:

    # mc_pensamiento "No era que no supiera resolverlo. Arrastraba el mismo error del medio sin tocarlo."
    mc_pensamiento "No era que no supiera resolverlo. Arrastraba el mismo error del medio sin tocarlo."

# game/02_cap1_beat_casa.rpy:976
translate english bcl_itsuki_7b4438d9:

    # mc_pensamiento "Le señalé el segundo paso, sin decirle qué estaba mal."
    mc_pensamiento "Le señalé el segundo paso, sin decirle qué estaba mal."

# game/02_cap1_beat_casa.rpy:978
translate english bcl_itsuki_112cfc8b:

    # mc_pensamiento "Lo encontró ella sola: «la unidad no se cancela ahí»."
    mc_pensamiento "Lo encontró ella sola: «la unidad no se cancela ahí»."

# game/02_cap1_beat_casa.rpy:980
translate english bcl_itsuki_1b17f504:

    # mc_pensamiento "No me dio las gracias. Tampoco me pidió que me fuera."
    mc_pensamiento "No me dio las gracias. Tampoco me pidió que me fuera."

# game/02_cap1_beat_casa.rpy:982
translate english bcl_itsuki_b7bd90f3:

    # mc_pensamiento "Al día siguiente me contó que había rehecho el ejercicio desde el principio."
    mc_pensamiento "Al día siguiente me contó que había rehecho el ejercicio desde el principio."

# game/02_cap1_beat_casa.rpy:984
translate english bcl_itsuki_5bece3f0:

    # mc_pensamiento "Sin mirar la corrección."
    mc_pensamiento "Sin mirar la corrección."

# game/02_cap1_beat_casa.rpy:986
translate english bcl_itsuki_1825a9f8:

    # mc_pensamiento "Salió bien."
    mc_pensamiento "Salió bien."

# game/02_cap1_beat_casa.rpy:990
translate english bcl_itsuki_dd97f49a:

    # mc_pensamiento "Le ofrecí revisarlo desde el principio y dijo que no antes de saber qué iba a explicarle."
    mc_pensamiento "Le ofrecí revisarlo desde el principio y dijo que no antes de saber qué iba a explicarle."

# game/02_cap1_beat_casa.rpy:992
translate english bcl_itsuki_88850266:

    # mc_pensamiento "Cerró el cuaderno un centímetro, lo justo para rechazar la oferta."
    mc_pensamiento "Cerró el cuaderno un centímetro, lo justo para rechazar la oferta."

# game/02_cap1_beat_casa.rpy:994
translate english bcl_itsuki_8326a132:

    # mc_pensamiento "Al día siguiente dijo que todavía no necesitaba mi ayuda. Y que «todavía» era solo una expresión."
    mc_pensamiento "Al día siguiente dijo que todavía no necesitaba mi ayuda. Y que «todavía» era solo una expresión."

# game/02_cap1_beat_casa.rpy:998
translate english bcl_itsuki_83d90008:

    # mc_pensamiento "Le quité el cuaderno y se lo resolví yo, de pie, con su propio lápiz."
    mc_pensamiento "Le quité el cuaderno y se lo resolví yo, de pie, con su propio lápiz."

# game/02_cap1_beat_casa.rpy:1000
translate english bcl_itsuki_45371e65:

    # mc_pensamiento "Rápido y correcto. Y le quité lo único que estaba defendiendo: hacerlo ella sola."
    mc_pensamiento "Rápido y correcto. Y le quité lo único que estaba defendiendo: hacerlo ella sola."

# game/02_cap1_beat_casa.rpy:1002
translate english bcl_itsuki_5f3d484a:

    # mc_pensamiento "Al día siguiente había rehecho todo el ejercicio debajo de mi solución, tachada."
    mc_pensamiento "Al día siguiente había rehecho todo el ejercicio debajo de mi solución, tachada."

# game/02_cap1_beat_casa.rpy:1004
translate english bcl_itsuki_385f0c59:

    # mc_pensamiento "«Lo que hiciste ayer no cuenta. Quería que fuera mío.»"
    mc_pensamiento "«Lo que hiciste ayer no cuenta. Quería que fuera mío.»"

# game/02_cap1_beat_casa.rpy:1008
translate english bcl_itsuki_77f8ab79:

    # mc_pensamiento "No fui a buscarla al aula."
    mc_pensamiento "No fui a buscarla al aula."

# game/02_cap1_beat_casa.rpy:1010
translate english bcl_itsuki_e77fe70d:

    # mc_pensamiento "A Itsuki la conocí por un asiento, y ella a mí por arrogante. No le faltó razón."
    mc_pensamiento "A Itsuki la conocí por un asiento, y ella a mí por arrogante. No le faltó razón."

# game/02_cap1_beat_casa.rpy:1012
translate english bcl_itsuki_4ebae3ec:

    # mc_pensamiento "Dijo que prefería reprobar todos los exámenes antes que recibir una clase mía."
    mc_pensamiento "Dijo que prefería reprobar todos los exámenes antes que recibir una clase mía."

# game/02_cap1_beat_casa.rpy:1014
translate english bcl_itsuki_0b906a2d_1:

    # mc_pensamiento "Aun así, fue ella quien se inventó el juego de busca y encuentra."
    mc_pensamiento "Aun así, fue ella quien se inventó el juego de busca y encuentra."

# game/02_cap1_beat_casa.rpy:1016
translate english bcl_itsuki_a399a037:

    # mc_pensamiento "Cuando supo que no la había ido a buscar, dijo que había ganado el juego."
    mc_pensamiento "Cuando supo que no la había ido a buscar, dijo que había ganado el juego."

# game/02_cap1_beat_casa.rpy:1018
translate english bcl_itsuki_05aec194:

    # mc_pensamiento "Que tener razón es lo único que siempre le sale bien."
    mc_pensamiento "Que tener razón es lo único que siempre le sale bien."

# game/02_cap1_beat_casa.rpy:1020
translate english bcl_itsuki_39afc0d9:

    # mc_pensamiento "Y que, si hubiera ido, no me habría echado. No inmediatamente."
    mc_pensamiento "Y que, si hubiera ido, no me habría echado. No inmediatamente."

# game/02_cap1_beat_casa.rpy:1024
translate english bcl_itsuki_b2151d78:

    # mc_pensamiento "En la azotea la encontré con el cuaderno cerrado sobre las rodillas."
    mc_pensamiento "En la azotea la encontré con el cuaderno cerrado sobre las rodillas."

# game/02_cap1_beat_casa.rpy:1028
translate english bcl_itsuki_718a6603:

    # mc_pensamiento "Antes de que lo cerrara alcancé a ver la página: un ejercicio con un círculo a lápiz."
    mc_pensamiento "Antes de que lo cerrara alcancé a ver la página: un ejercicio con un círculo a lápiz."

# game/02_cap1_beat_casa.rpy:1030
translate english bcl_itsuki_dc1508c2:

    # mc_pensamiento "Repasado tantas veces que había hundido el papel. Era el de la hoja de diagnóstico del primer día."
    mc_pensamiento "Repasado tantas veces que había hundido el papel. Era el de la hoja de diagnóstico del primer día."

# game/02_cap1_beat_casa.rpy:1032
translate english bcl_itsuki_74d08632:

    # mc_pensamiento "Ya no le quedaba ningún sitio donde no tuviera que estudiar."
    mc_pensamiento "Ya no le quedaba ningún sitio donde no tuviera que estudiar."

# game/02_cap1_beat_casa.rpy:1034
translate english bcl_itsuki_5ba91cbd:

    # mc_pensamiento "Tenía las manos quietas sobre la tapa, sin una mancha de tinta."
    mc_pensamiento "Tenía las manos quietas sobre la tapa, sin una mancha de tinta."

# game/02_cap1_beat_casa.rpy:1036
translate english bcl_itsuki_50f1ff71:

    # mc_pensamiento "Nos quedamos un rato largo sin abrir ninguno de los dos libros."
    mc_pensamiento "Nos quedamos un rato largo sin abrir ninguno de los dos libros."

# game/02_cap1_beat_casa.rpy:1038
translate english bcl_itsuki_88eb0e7f:

    # mc_pensamiento "Se me voló una hoja hasta la valla y ninguno fue a buscarla."
    mc_pensamiento "Se me voló una hoja hasta la valla y ninguno fue a buscarla."

# game/02_cap1_beat_casa.rpy:1040
translate english bcl_itsuki_8b2096a2:

    # mc_pensamiento "Esas semanas la estaban gastando a ella tanto como a mí."
    mc_pensamiento "Esas semanas la estaban gastando a ella tanto como a mí."

# game/02_cap1_beat_casa.rpy:1046
translate english bcl_itsuki_dd17fee9:

    # mc_pensamiento "Y sigo dándole vueltas a lo mismo."
    mc_pensamiento "Y sigo dándole vueltas a lo mismo."

# game/02_cap1_beat_casa.rpy:1048
translate english bcl_itsuki_be95fcf2:

    # mc_pensamiento "Plantea bien, un problema tras otro. El resto de su cuaderno no tenía un solo error."
    mc_pensamiento "Plantea bien, un problema tras otro. El resto de su cuaderno no tenía un solo error."

# game/02_cap1_beat_casa.rpy:1050
translate english bcl_itsuki_1dc10195:

    # mc_pensamiento "A veces le basta con que alguien le diga dónde mirar para ver todo lo demás."
    mc_pensamiento "A veces le basta con que alguien le diga dónde mirar para ver todo lo demás."

# game/02_cap1_beat_casa.rpy:1052
translate english bcl_itsuki_00c3e2bd:

