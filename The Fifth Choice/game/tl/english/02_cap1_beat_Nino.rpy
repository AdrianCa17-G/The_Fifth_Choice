# game/02_cap1_beat_Nino.rpy:41
translate english beat_Nino_cc2baaa8:

    # narrador "Llegué al departamento a la hora de siempre."
    narrador "I got to the apartment at the usual time."

# game/02_cap1_beat_Nino.rpy:43
translate english beat_Nino_862ec854:

    # narrador "La puerta estaba entreabierta. Nadie la había cerrado del todo."
    narrador "The door was ajar. Nobody had closed it all the way."

# game/02_cap1_beat_Nino.rpy:50
translate english beat_Nino_84f379f5:

    # narrador "Antes de terminar de abrirla, escuché dos voces desde el fondo."
    narrador "Before I'd finished opening it, I heard two voices from the back."

# game/02_cap1_beat_Nino.rpy:52
translate english beat_Nino_384f1f71:

    # mc_pensamiento "Una era de Maruo."
    mc_pensamiento "One was Maruo's."

# game/02_cap1_beat_Nino.rpy:54
translate english beat_Nino_7b953433:

    # mc_pensamiento "Grave, pareja, sin subir nunca de tono."
    mc_pensamiento "Deep, even, never rising in pitch."

# game/02_cap1_beat_Nino.rpy:56
translate english beat_Nino_c6767dbc:

    # mc_pensamiento "La otra era de Nino."
    mc_pensamiento "The other was Nino's."

# game/02_cap1_beat_Nino.rpy:58
translate english beat_Nino_68a9ad52:

    # mc_pensamiento "Y esta sí sonaba alterada."
    mc_pensamiento "And this one sounded upset."

# game/02_cap1_beat_Nino.rpy:60
translate english beat_Nino_215344fe:

    # narrador "Me quedé en el umbral un segundo de más."
    narrador "I stayed in the doorway a second too long."

# game/02_cap1_beat_Nino.rpy:62
translate english beat_Nino_07397955:

    # mc_pensamiento "Podría abrir la puerta completamente y saludarlos."
    mc_pensamiento "I could open the door all the way and say hello."

# game/02_cap1_beat_Nino.rpy:64
translate english beat_Nino_3edd32c9:

    # mc_pensamiento "O podía escuchar primero y decidir después."
    mc_pensamiento "Or I could listen first and decide later."

# game/02_cap1_beat_Nino.rpy:66
translate english beat_Nino_cef24f59:

    # narrador "Elegí lo segundo."
    narrador "I chose the second."

# game/02_cap1_beat_Nino.rpy:79
translate english beat_Nino_4ecccbfb:

    # nino "...y no me importa lo que hayas firmado con él. Debes despedirlo."
    nino "...and I don't care what you signed with him. You have to fire him."

# game/02_cap1_beat_Nino.rpy:81
translate english beat_Nino_4bb30095:

    # maruo "No."
    maruo "No."

# game/02_cap1_beat_Nino.rpy:83
translate english beat_Nino_2f218bde:

    # nino "¡Es un tutor, no una sentencia de por vida!"
    nino "He's a tutor, not a life sentence!"

# game/02_cap1_beat_Nino.rpy:85
translate english beat_Nino_280aad02:

    # maruo "Es exactamente un contrato."
    maruo "It is exactly a contract."

# game/02_cap1_beat_Nino.rpy:87
translate english beat_Nino_245d18d3:

    # maruo "Y no lo voy a romper porque a ti no te guste su cara."
    maruo "And I will not break it because you don't like his face."

# game/02_cap1_beat_Nino.rpy:89
translate english beat_Nino_49bb3d8d:

    # narrador "Me acerqué lo suficiente para ver sin que me vieran a mí."
    narrador "I moved close enough to see without being seen."

# game/02_cap1_beat_Nino.rpy:91
translate english beat_Nino_69ad28d0:

    # mc_pensamiento "No es por mi cara. Es por algo que no tiene nada que ver conmigo."
    mc_pensamiento "It's not about my face. It's about something that has nothing to do with me."

# game/02_cap1_beat_Nino.rpy:93
translate english beat_Nino_c181f4dd:

    # nino "No se trata de su cara."
    nino "It's not about his face."

# game/02_cap1_beat_Nino.rpy:95
translate english beat_Nino_a4aa553a:

    # nino "Yotsuba ya le hizo un grupo de chat. Le puso «tutor» en el nombre."
    nino "Yotsuba already made him a group chat. She put \"tutor\" in the name."

# game/02_cap1_beat_Nino.rpy:97
translate english beat_Nino_b9883cf9:

    # nino "Me salí. Me volvió a meter antes de que llegara a casa."
    nino "I left. She added me back before I even got home."

# game/02_cap1_beat_Nino.rpy:99
translate english beat_Nino_e885bacf:

    # nino "Con tres signos de exclamación. Como si fuera una fiesta."
    nino "With three exclamation points. Like it's a party."

# game/02_cap1_beat_Nino.rpy:101
translate english beat_Nino_6276c849:

    # nino "Va a durar lo mismo que los anteriores."
    nino "He'll last about as long as the others did."

# game/02_cap1_beat_Nino.rpy:103
translate english beat_Nino_0017ea3c:

    # nino "Y ellas van a volver a creer que esta vez sí va a ser diferente."
    nino "And they'll believe all over again that this time will be different."

# game/02_cap1_beat_Nino.rpy:105
translate english beat_Nino_17ca596b:

    # nino "Ya empezaron. Ninguna se salió conmigo."
    nino "They've already started. Not one of them left the chat with me."

# game/02_cap1_beat_Nino.rpy:107
translate english beat_Nino_932e60f4:

    # maruo "Eso ya lo decidiré yo, cuando corresponda."
    maruo "I will decide that when the time comes."

# game/02_cap1_beat_Nino.rpy:109
translate english beat_Nino_249ae45a:

    # nino "¿Cuando corresponda? ¿Cuando ya estén ilusionadas las cuatro?"
    nino "When the time comes? When all four of them are already getting their hopes up?"

# game/02_cap1_beat_Nino.rpy:111
translate english beat_Nino_c55cbcfa:

    # nino "¡Tú nunca estás aquí para verlo!"
    nino "You're never here to see it!"

# game/02_cap1_beat_Nino.rpy:113
translate english beat_Nino_79d935d9:

    # narrador "Ahí sí subió la voz de verdad."
    narrador "That was when she really raised her voice."

# game/02_cap1_beat_Nino.rpy:115
translate english beat_Nino_4134feab:

    # narrador "La única vez que la escuché gritarle a su padre."
    narrador "The only time I'd ever heard her shout at her father."

# game/02_cap1_beat_Nino.rpy:117
translate english beat_Nino_90442538:

    # narrador "Maruo no contestó enseguida."
    narrador "Maruo didn't answer right away."

# game/02_cap1_beat_Nino.rpy:119
translate english beat_Nino_41609e02:

    # narrador "Bajó la vista a la taza, como si la respuesta estuviera en el fondo."
    narrador "He looked down at his cup, as if the answer were at the bottom of it."

# game/02_cap1_beat_Nino.rpy:141
translate english beat_Nino_ecf3ead5:

    # narrador "Fue entonces cuando Maruo levantó la vista y me encontró en la puerta."
    narrador "That was when Maruo looked up and found me in the doorway."

# game/02_cap1_beat_Nino.rpy:148
translate english beat_Nino_6325374d:

    # maruo "Ya que estás aquí, ahorrémonos el drama."
    maruo "Since you're here, let us spare ourselves the drama."

# game/02_cap1_beat_Nino.rpy:150
translate english beat_Nino_1243f142:

    # mc "Perdón, no venía con la intención de interrumpirlos."
    mc "Sorry. I didn't mean to interrupt."

# game/02_cap1_beat_Nino.rpy:152
translate english beat_Nino_826f9c06:

    # maruo "Ya nos interrumpiste con solo entrar."
    maruo "You interrupted us simply by walking in."

# game/02_cap1_beat_Nino.rpy:156
translate english beat_Nino_60e342d1:

    # narrador "Dejó la taza sobre la mesa, despacio, sin apurarse."
    narrador "He set the cup on the table, slowly, in no hurry."

# game/02_cap1_beat_Nino.rpy:158
translate english beat_Nino_36a51ff8:

    # maruo "Llevas más de una semana. Anoche revisé sus cuadernos."
    maruo "You have been here over a week. Last night I went through their notebooks."

# game/02_cap1_beat_Nino.rpy:160
translate english beat_Nino_afed1ae0:

    # maruo "No veo ningún cambio."
    maruo "I see no change."

# game/02_cap1_beat_Nino.rpy:162
translate english beat_Nino_c59de9ae:

    # mc "No voy a ponerle excusas, señor."
    mc "I won't make excuses, sir."

# game/02_cap1_beat_Nino.rpy:164
translate english beat_Nino_45a1802f:

    # mc "Solo le pido que me juzgue cuando toca: en los exámenes."
    mc "I only ask that you judge me when it counts: on the exams."

# game/02_cap1_beat_Nino.rpy:166
translate english beat_Nino_0d1494af:

    # mc "Faltan dos semanas."
    mc "There are two weeks left."

# game/02_cap1_beat_Nino.rpy:168
translate english beat_Nino_14f6ecea:

    # maruo "No te pedí un cronograma. Te pedí resultados."
    maruo "I did not ask for a schedule. I asked for results."

# game/02_cap1_beat_Nino.rpy:170
translate english beat_Nino_7cffa101:

    # narrador "Nino miraba entre los dos, sin intervenir por primera vez en toda la conversación."
    narrador "Nino looked between us, staying out of it for the first time in the whole conversation."

# game/02_cap1_beat_Nino.rpy:172
translate english beat_Nino_e4530e3e:

    # maruo "Las condiciones te las dije el primer día. Hoy te las digo por segunda vez."
    maruo "I told you the terms on the first day. Today I am telling you a second time."

# game/02_cap1_beat_Nino.rpy:174
translate english beat_Nino_ba9d6694:

    # maruo "Si una sola de mis hijas reprueba, se acabó. Ese día no hay discusión ni segunda oportunidad."
    maruo "If even one of my daughters fails, it is over. No discussion, no second chance."

# game/02_cap1_beat_Nino.rpy:176
translate english beat_Nino_06a71478:

    # maruo "No habrá una tercera."
    maruo "There will not be a third time."

# game/02_cap1_beat_Nino.rpy:178
translate english beat_Nino_4de4d099:

    # narrador "Lo dijo exactamente con el mismo tono que usó para cerrar la puerta esa primera noche."
    narrador "He said it in exactly the same tone he'd used to close the door that first night."

# game/02_cap1_beat_Nino.rpy:180
translate english beat_Nino_e0705995:

    # mc_pensamiento "No subió la voz ni una vez. No hacía falta."
    mc_pensamiento "He never raised his voice once. He didn't need to."

# game/02_cap1_beat_Nino.rpy:184
translate english beat_Nino_c524b12d:

    # narrador "Recogió la taza y salió de la cocina sin esperar respuesta, dándonos la espalda a los dos por igual."
    narrador "He took his cup and left the kitchen without waiting for an answer, his back to both of us alike."

# game/02_cap1_beat_Nino.rpy:191
translate english beat_Nino_07414a08:

    # mc_pensamiento "Esa era la última vez que lo iba a decir."
    mc_pensamiento "That was the last time he was going to say it."

# game/02_cap1_beat_Nino.rpy:193
translate english beat_Nino_c9229556:

    # mc_pensamiento "Y los dos lo sabíamos."
    mc_pensamiento "And we both knew it."

# game/02_cap1_beat_Nino.rpy:195
translate english beat_Nino_a2835eb6:

    # narrador "Nino seguía en la cocina. Había venido a pedir eso."
    narrador "Nino was still in the kitchen. This was what she'd come to ask for."

# game/02_cap1_beat_Nino.rpy:197
translate english beat_Nino_ba6a6bed:

    # narrador "Lo había conseguido a medias, y no tenía cara de haber ganado nada."
    narrador "She'd gotten it halfway, and she didn't look like she'd won anything."

# game/02_cap1_beat_Nino.rpy:203
translate english beat_Nino_5c11a7e9:

    # narrador "Maruo no llegó a notar que yo estaba en la puerta, o decidió no darse por enterado."
    narrador "Maruo either didn't notice me in the doorway or chose not to."

# game/02_cap1_beat_Nino.rpy:205
translate english beat_Nino_426e880b:

    # maruo "No he visto ningún motivo todavía para cambiar nada."
    maruo "I have yet to see a reason to change anything."

# game/02_cap1_beat_Nino.rpy:207
translate english beat_Nino_78d79b96:

    # nino "¡Ese es el problema! ¡Que nunca ves ningún motivo hasta que ya es tarde!"
    nino "That's the problem! You never see a reason until it's too late!"

# game/02_cap1_beat_Nino.rpy:209
translate english beat_Nino_2937a295:

    # maruo "Cuando lo sea, actuaré."
    maruo "When it is, I will act."

# game/02_cap1_beat_Nino.rpy:211
translate english beat_Nino_4490f16c:

    # maruo "Hasta entonces, esta conversación está cerrada."
    maruo "Until then, this conversation is closed."

# game/02_cap1_beat_Nino.rpy:213
translate english beat_Nino_a05acde1:

    # narrador "Vació el resto del café en el fregadero y salió de la cocina sin mirar a ninguno."
    narrador "He poured the rest of his coffee down the sink and left the kitchen without looking at either of us."

# game/02_cap1_beat_Nino.rpy:220
translate english beat_Nino_a08075c6:

    # mc_pensamiento "No dijo mi nombre en toda la conversación."
    mc_pensamiento "He didn't say my name once in the whole conversation."

# game/02_cap1_beat_Nino.rpy:222
translate english beat_Nino_b9ee12cf:

    # mc_pensamiento "Como si yo no fuera parte del problema que estaban discutiendo."
    mc_pensamiento "As if I weren't part of the problem they were arguing about."

# game/02_cap1_beat_Nino.rpy:224
translate english beat_Nino_dd255c4f:

    # narrador "Nino se quedó mirando el pasillo por donde se había ido su padre, todavía con los brazos cruzados."
    narrador "Nino stood staring down the hallway where her father had gone, arms still crossed."

# game/02_cap1_beat_Nino.rpy:229
translate english beat_Nino_8c1a7f46:

    # mc_pensamiento "Tengo que romper el hielo."
    mc_pensamiento "I have to break the ice."

# game/02_cap1_beat_Nino.rpy:231
translate english beat_Nino_4f95484b:

    # mc "Hola..."
    mc "Hi..."

# game/02_cap1_beat_Nino.rpy:233
translate english beat_Nino_807d3076:

    # mc "No me mires así. Vine a dar la clase, como siempre."
    mc "Don't look at me like that. I came to teach, like always."

# game/02_cap1_beat_Nino.rpy:235
translate english beat_Nino_a2f0861d:

    # mc "Hoy no pienso discutir. Puedes ahorrarte las quejas."
    mc "I'm not going to argue today. You can save the complaints."

# game/02_cap1_beat_Nino.rpy:240
translate english beat_Nino_4093ff85:

    # nino "No es un buen momento."
    nino "It's not a good time."

# game/02_cap1_beat_Nino.rpy:242
translate english beat_Nino_2c34cbe7:

    # mc "Ya lo noté."
    mc "I noticed."

# game/02_cap1_beat_Nino.rpy:250
translate english beat_Nino_330f5696:

    # narrador "Entré del todo a la cocina. Ella no se movió de donde estaba."
    narrador "I came all the way into the kitchen. She didn't move from where she stood."

# game/02_cap1_beat_Nino.rpy:254
translate english beat_Nino_92202cfd:

    # narrador "Dejó su propia taza sobre la mesa con más fuerza de la necesaria."
    narrador "She set her own cup on the table harder than she needed to."

# game/02_cap1_beat_Nino.rpy:256
translate english beat_Nino_14dac495:

    # narrador "El golpe sonó más alto que cualquier cosa que hubiera dicho."
    narrador "The thud was louder than anything she'd said."

# game/02_cap1_beat_Nino.rpy:258
translate english beat_Nino_3c92634a:

    # nino "Vas a preguntarme qué fue toda esta discusión."
    nino "You're going to ask me what all that was about."

# game/02_cap1_beat_Nino.rpy:260
translate english beat_Nino_7faf697c:

    # mc "No hace falta que me lo expliques."
    mc "You don't have to explain."

# game/02_cap1_beat_Nino.rpy:262
translate english beat_Nino_3da041b3:

    # mc "Escuché la mitad desde la puerta."
    mc "I heard half of it from the door."

# game/02_cap1_beat_Nino.rpy:264
translate english beat_Nino_378cde13:

    # nino "Entonces ya sabes lo que pienso de ti."
    nino "Then you already know what I think of you."

# game/02_cap1_beat_Nino.rpy:266
translate english beat_Nino_188f960e:

    # mc "Sé lo que le dijiste a tu padre."
    mc "I know what you told your father."

# game/02_cap1_beat_Nino.rpy:268
translate english beat_Nino_6a9d7622:

    # mc "No lo que piensas de mí. No es lo mismo."
    mc "Not what you think of me. That's not the same thing."

# game/02_cap1_beat_Nino.rpy:273
translate english beat_Nino_5227317f:

    # nino "Da igual."
    nino "Doesn't matter."

# game/02_cap1_beat_Nino.rpy:275
translate english beat_Nino_ab726b9a:

    # nino "El resultado es el mismo: quiero que te vayas."
    nino "The result is the same: I want you gone."

# game/02_cap1_beat_Nino.rpy:277
translate english beat_Nino_ecbb3eb3:

    # mc "Tu padre acaba de decir que no."
    mc "Your father just said no."

# game/02_cap1_beat_Nino.rpy:279
translate english beat_Nino_1160fc09:

    # nino "Mi padre no tiene que vivir con esto todos los días. Yo sí."
    nino "My father doesn't have to live with this every day. I do."

# game/02_cap1_beat_Nino.rpy:284
translate english beat_Nino_982d867f:

    # narrador "Se sentó en uno de los bancos de la cocina, de golpe."
    narrador "She dropped onto one of the kitchen stools."

# game/02_cap1_beat_Nino.rpy:286
translate english beat_Nino_ce240ea5:

    # narrador "Como si las piernas hubieran dejado de sostenerla el tiempo justo."
    narrador "As if her legs had given out, just for a moment."

# game/02_cap1_beat_Nino.rpy:288
translate english beat_Nino_4a727e2b:

    # nino "No es porque seas malo en esto."
    nino "It's not because you're bad at this."

# game/02_cap1_beat_Nino.rpy:290
translate english beat_Nino_77b8451c:

    # nino "Ni siquiera es porque me caigas mal, aunque me caes mal."
    nino "It's not even because I don't like you, though I don't."

# game/02_cap1_beat_Nino.rpy:292
translate english beat_Nino_9ebd1e6c:

    # nino "Es que ya vi esto pasar varias veces, y siempre fue igual."
    nino "It's that I've watched this happen before, and it always goes the same way."

# game/02_cap1_beat_Nino.rpy:294
translate english beat_Nino_e063175c:

    # nino "Ichika finge que no le importa hasta que le importa."
    nino "Ichika acts like she doesn't care until she does."

# game/02_cap1_beat_Nino.rpy:296
translate english beat_Nino_088ef33d:

    # nino "Yotsuba se esfuerza el doble para compensar algo que no puede compensar."
    nino "Yotsuba works twice as hard to make up for something she can't make up for."

# game/02_cap1_beat_Nino.rpy:298
translate english beat_Nino_d6e50c6a:

    # nino "Miku se encierra en su propia burbuja todavía más, y ya estaba bastante encerrada."
    nino "Miku shuts herself deeper into her bubble, and she was already pretty shut in."

# game/02_cap1_beat_Nino.rpy:300
translate english beat_Nino_f268aa05:

    # nino "E Itsuki... Itsuki se lo toma como si fuera personal, porque para ella todo lo es."
    nino "And Itsuki... Itsuki takes it personally, because for her everything is."

# game/02_cap1_beat_Nino.rpy:302
translate english beat_Nino_cf20459c:

    # narrador "Hablaba rápido, sin las pausas que suele dejar entre frase y frase."
    narrador "She was talking fast, without the pauses she usually leaves between sentences."

# game/02_cap1_beat_Nino.rpy:304
translate english beat_Nino_a07e76a6:

    # nino "Y cuando se van, a mí me toca juntar los pedazos de las cuatro."
    nino "And when they leave, I'm the one stuck picking up the pieces. All four sets."

# game/02_cap1_beat_Nino.rpy:306
translate english beat_Nino_0b85b5dc:

    # nino "Porque soy la única que no se ilusionó nunca."
    nino "Because I'm the only one who never got her hopes up."

# game/02_cap1_beat_Nino.rpy:308
translate english beat_Nino_09c50ccb:

    # nino "Cada vez que uno se va, quedamos un poco menos juntas. Y nadie lo nota."
    nino "Every time one of them goes, we end up a little less together. And nobody notices."

# game/02_cap1_beat_Nino.rpy:310
translate english beat_Nino_3888c4a9:

    # nino "Alguien tiene que quedarse con la cabeza fría."
    nino "Someone has to keep a cool head."

# game/02_cap1_beat_Nino.rpy:312
translate english beat_Nino_b40ed618:

    # nino "Siempre soy yo."
    nino "It's always me."

# game/02_cap1_beat_Nino.rpy:314
translate english beat_Nino_6d3ff4c9:

    # nino "Y estoy cansada de ser la única que ve venir el golpe antes de que llegue."
    nino "And I'm tired of being the only one who sees the blow coming before it lands."

# game/02_cap1_beat_Nino.rpy:316
translate english beat_Nino_5e647f54:

    # narrador "Se detuvo de golpe, con la taza a medio camino de la boca."
    narrador "She stopped short, the cup halfway to her mouth."

# game/02_cap1_beat_Nino.rpy:324
translate english beat_Nino_5d06c2b7:

    # nino "..."
    nino "..."

# game/02_cap1_beat_Nino.rpy:326
translate english beat_Nino_2afee028:

    # nino "No dije nada de esto."
    nino "I didn't say any of this."

# game/02_cap1_beat_Nino.rpy:328
translate english beat_Nino_cfba260d:

    # mc "Lo dijiste todo."
    mc "You said all of it."

# game/02_cap1_beat_Nino.rpy:330
translate english beat_Nino_f4c87f5b:

    # narrador "No contestó."
    narrador "She didn't answer."

# game/02_cap1_beat_Nino.rpy:332
translate english beat_Nino_ee44c432:

    # narrador "Bajó la taza sin haber bebido nada."
    narrador "She lowered the cup without having drunk anything."

# game/02_cap1_beat_Nino.rpy:334
translate english beat_Nino_fa811e19:

    # narrador "Al bajarla, la taza quedó encima de una tarjeta escrita a mano."
    narrador "When she did, it came down on top of a handwritten card."

# game/02_cap1_beat_Nino.rpy:336
translate english beat_Nino_9fff7446:

    # narrador "Tinta gastada, letra redonda. No era la suya."
    narrador "Faded ink, round handwriting. Not hers."

# game/02_cap1_beat_Nino.rpy:340
translate english beat_Nino_92535cc3:

    # mc_pensamiento "La misma tarjeta del súper."
    mc_pensamiento "The same card from the supermarket."

# game/02_cap1_beat_Nino.rpy:342
translate english beat_Nino_6bb0decb:

    # mc_pensamiento "Allí me contó lo de los tutores. Hoy, lo de ellas."
    mc_pensamiento "That's where she told me about the tutors. Today, about them."

# game/02_cap1_beat_Nino.rpy:344
translate english beat_Nino_88b6a7bb:

    # mc_pensamiento "Ahora tenía las dos mitades."
    mc_pensamiento "Now I had both halves."

# game/02_cap1_beat_Nino.rpy:346
translate english beat_Nino_2e315025:

    # mc_pensamiento "No está exagerando."
    mc_pensamiento "She isn't exaggerating."

# game/02_cap1_beat_Nino.rpy:348
translate english beat_Nino_3e247c31:

    # mc_pensamiento "No conmigo, al menos."
    mc_pensamiento "Not with me, at least."

# game/02_cap1_beat_Nino.rpy:350
translate english beat_Nino_da8eda53:

    # mc_pensamiento "Está describiendo un patrón que ya vio cumplirse varias veces."
    mc_pensamiento "She's describing a pattern she's watched play out more than once."

# game/02_cap1_beat_Nino.rpy:352
translate english beat_Nino_9b9bc1aa:

    # mc_pensamiento "Lo único que cambia cada vez es el nombre de quien se va."
    mc_pensamiento "The only thing that changes each time is the name of whoever leaves."

# game/02_cap1_beat_Nino.rpy:360
translate english beat_Nino_ec7b5a72:

    # narrador "Se puso de pie y se acomodó el uniforme."
    narrador "She stood up and straightened her uniform."

# game/02_cap1_beat_Nino.rpy:362
translate english beat_Nino_f36ae5e0:

    # narrador "Como quien intenta recomponer algo que ya se salió de su sitio."
    narrador "Like someone trying to put back something that's slipped out of place."

# game/02_cap1_beat_Nino.rpy:367
translate english beat_Nino_010bf62d:

    # nino "¿Y bien? ¿Vas a decir que esta vez es distinto?"
    nino "So? Are you going to tell me it's different this time?"

# game/02_cap1_beat_Nino.rpy:369
translate english beat_Nino_8dbce5bf:

    # mc_pensamiento "No hay una respuesta que la deje tranquila."
    mc_pensamiento "There's no answer that will settle her."

# game/02_cap1_beat_Nino.rpy:371
translate english beat_Nino_0c4370b6:

    # mc_pensamiento "Y quedarme callado también es responder."
    mc_pensamiento "And staying quiet is an answer too."

# game/02_cap1_beat_Nino.rpy:377
translate english beat_Nino_bf314bfb:

    # mc_pensamiento "Lo dijo todo. Ahora espera que yo diga algo." nointeract
    mc_pensamiento "She said it all. Now she's waiting for me to say something." nointeract

# game/02_cap1_beat_Nino.rpy:401
translate english nino_beat_m4a_8166f5fe:

    # mc "¿Y quién junta los tuyos?"
    mc "And who picks up yours?"

# game/02_cap1_beat_Nino.rpy:403
translate english nino_beat_m4a_6af29a87:

    # nino "...¿Qué?"
    nino "...What?"

# game/02_cap1_beat_Nino.rpy:405
translate english nino_beat_m4a_459f9dbf:

    # mc "Dijiste que te toca juntar los pedazos de las cuatro."
    mc "You said you're the one who picks up the pieces for all four of them."

# game/02_cap1_beat_Nino.rpy:407
translate english nino_beat_m4a_aeaee864:

    # mc "Pregunto quién junta los tuyos."
    mc "I'm asking who picks up yours."

# game/02_cap1_beat_Nino.rpy:409
translate english nino_beat_m4a_95d8ce88:

    # nino "Nadie. No hace falta."
    nino "No one. There's no need."

# game/02_cap1_beat_Nino.rpy:411
translate english nino_beat_m4a_d351103e:

    # mc "Hoy fuiste a pedirle a tu padre que me echara."
    mc "Today you went to ask your father to throw me out."

# game/02_cap1_beat_Nino.rpy:413
translate english nino_beat_m4a_86e3b91d:

    # mc "Sola. Sin que ninguna de ellas te lo pidiera."
    mc "Alone. Without any of them asking you to."

# game/02_cap1_beat_Nino.rpy:415
translate english nino_beat_m4a_e6eb059f:

    # mc "Eso no lo hace alguien con la cabeza fría."
    mc "Someone with a cool head doesn't do that."

# game/02_cap1_beat_Nino.rpy:417
translate english nino_beat_m4a_5135f7b4:

    # narrador "Abrió la boca para contestar y no le salió nada."
    narrador "She opened her mouth to answer and nothing came out."

# game/02_cap1_beat_Nino.rpy:422
translate english nino_beat_m4a_e8db1997:

    # nino "Lo hice porque—"
    nino "I did it because—"

# game/02_cap1_beat_Nino.rpy:424
translate english nino_beat_m4a_198ddfc6:

    # narrador "Se detuvo sola. No la presioné para que terminara."
    narrador "She stopped herself. I didn't push her to finish."

# game/02_cap1_beat_Nino.rpy:426
translate english nino_beat_m4a_dea94a4e:

    # nino "No es lo que piensas."
    nino "It's not what you think."

# game/02_cap1_beat_Nino.rpy:428
translate english nino_beat_m4a_c2ba2cd4:

    # mc "No pienso nada. Solo pregunté."
    mc "I don't think anything. I just asked."

# game/02_cap1_beat_Nino.rpy:430
translate english nino_beat_m4a_9876ea63:

    # narrador "Se quedó mirando la taza un rato largo."
    narrador "She stared at her cup for a long while."

# game/02_cap1_beat_Nino.rpy:435
translate english nino_beat_m4a_cc3d8559:

    # nino "Hay que hacer la cena. Son las 5."
    nino "Dinner needs making. It's 5 o'clock."

# game/02_cap1_beat_Nino.rpy:437
translate english nino_beat_m4a_5c602d0c:

    # mc "¿Y?"
    mc "So?"

# game/02_cap1_beat_Nino.rpy:442
translate english nino_beat_m4a_f4756851:

    # nino "Y no pienso cocinar con alguien mirándome."
    nino "So I'm not cooking with someone watching me."

# game/02_cap1_beat_Nino.rpy:444
translate english nino_beat_m4a_abc777be:

    # nino "Corta las cebollas. Finas."
    nino "Cut the onions. Thin."

# game/02_cap1_beat_Nino.rpy:446
translate english nino_beat_m4a_eba321c4:

    # mc "Está bien."
    mc "Okay."

# game/02_cap1_beat_Nino.rpy:448
translate english nino_beat_m4a_a07d557e:

    # nino "No es una invitación."
    nino "It's not an invitation."

# game/02_cap1_beat_Nino.rpy:450
translate english nino_beat_m4a_a48124da:

    # mc "Es una orden."
    mc "It's an order."

# game/02_cap1_beat_Nino.rpy:452
translate english nino_beat_m4a_3b1fe385:

    # nino "Exacto."
    nino "Exactly."

# game/02_cap1_beat_Nino.rpy:454
translate english nino_beat_m4a_75ebc646:

    # narrador "Me señaló la tabla con la barbilla, sin mirarme."
    narrador "She pointed at the cutting board with her chin, not looking at me."

# game/02_cap1_beat_Nino.rpy:456
translate english nino_beat_m4a_ffe24499:

    # narrador "Cortamos en silencio. En toda la tarde no volvió a hablar de despedirme."
    narrador "We chopped in silence. All afternoon, she never brought up firing me again."

# game/02_cap1_beat_Nino.rpy:458
translate english nino_beat_m4a_ff254d31:

    # narrador "Antes de ponerse con la olla, dejó un táper vacío junto a mi mochila."
    narrador "Before starting on the pot, she set an empty container down next to my bag."

# game/02_cap1_beat_Nino.rpy:460
translate english nino_beat_m4a_3c7aae4d:

    # nino "Eso es para ti. Lo que sobre."
    nino "That's for you. Whatever's left over."

# game/02_cap1_beat_Nino.rpy:462
translate english nino_beat_m4a_9bbd75b8:

    # mc "Todavía no ha sobrado nada."
    mc "Nothing's left over yet."

# game/02_cap1_beat_Nino.rpy:467
translate english nino_beat_m4a_f3aebfd7:

    # nino "...Va a sobrar."
    nino "...There will be."

# game/02_cap1_beat_Nino.rpy:469
translate english nino_beat_m4a_0a12d673:

    # narrador "Sobró. Exactamente lo que cabía en el táper."
    narrador "There was. Exactly as much as fit in the container."

# game/02_cap1_beat_Nino.rpy:471
translate english nino_beat_m4a_556a3ee1:

    # mc_pensamiento "No le di las gracias. Me pareció que, si lo hacía, lo iba a tirar."
    mc_pensamiento "I didn't thank her. I figured if I did, she'd throw it out."

# game/02_cap1_beat_Nino.rpy:476
translate english nino_beat_m4a_e01af13d:

    # mc_pensamiento "No me dejó entrar. Me dio una tarea."
    mc_pensamiento "She didn't let me in. She gave me a job."

# game/02_cap1_beat_Nino.rpy:478
translate english nino_beat_m4a_7c7b8b85:

    # mc_pensamiento "Con ella, eso es casi lo mismo."
    mc_pensamiento "With her, that's almost the same thing."

# game/02_cap1_beat_Nino.rpy:491
translate english nino_beat_m4b_82570eb3:

    # narrador "No dije nada."
    narrador "I said nothing."

# game/02_cap1_beat_Nino.rpy:493
translate english nino_beat_m4b_619d0e49:

    # narrador "Rodeé la mesa y recogí la taza que había dejado a medio terminar."
    narrador "I walked around the table and picked up the cup she'd left unfinished."

# game/02_cap1_beat_Nino.rpy:498
translate english nino_beat_m4b_7c7205b2:

    # nino "¿Qué haces?"
    nino "What are you doing?"

# game/02_cap1_beat_Nino.rpy:500
translate english nino_beat_m4b_8e831ee9:

    # mc "Llevarla al fregadero."
    mc "Taking it to the sink."

# game/02_cap1_beat_Nino.rpy:502
translate english nino_beat_m4b_8f6da307:

    # mc "No hacía falta que la reventaras contra la mesa."
    mc "You didn't have to slam it into the table."

# game/02_cap1_beat_Nino.rpy:504
translate english nino_beat_m4b_28920fba:

    # nino "No la reventé."
    nino "I didn't slam it."

# game/02_cap1_beat_Nino.rpy:506
translate english nino_beat_m4b_7c729c3d:

    # mc "Sonó como si lo hubieras hecho."
    mc "It sounded like you did."

# game/02_cap1_beat_Nino.rpy:508
translate english nino_beat_m4b_6208a3ce:

    # narrador "No contestó a eso."
    narrador "She didn't answer that."

# game/02_cap1_beat_Nino.rpy:510
translate english nino_beat_m4b_6451fe11:

    # narrador "Se quedó apoyada contra la mesa."
    narrador "She stayed leaning against the table."

# game/02_cap1_beat_Nino.rpy:512
translate english nino_beat_m4b_6694c783:

    # narrador "Con los brazos cruzados otra vez, pero menos tensos que antes."
    narrador "Arms crossed again, but less tense than before."

# game/02_cap1_beat_Nino.rpy:517
translate english nino_beat_m4b_74f2ae67:

    # nino "No esperaba que te quedaras después de escuchar eso."
    nino "I didn't think you'd stay after hearing all that."

# game/02_cap1_beat_Nino.rpy:519
translate english nino_beat_m4b_41d470ed:

    # mc "¿Preferías que me fuera?"
    mc "Would you rather I left?"

# game/02_cap1_beat_Nino.rpy:521
translate english nino_beat_m4b_a7d4d544:

    # nino "No dije eso tampoco."
    nino "I didn't say that either."

# game/02_cap1_beat_Nino.rpy:523
translate english nino_beat_m4b_e15abf41:

    # narrador "Terminé de lavar la taza en silencio."
    narrador "I finished washing the cup in silence."

# game/02_cap1_beat_Nino.rpy:525
translate english nino_beat_m4b_99ec5a33:

    # narrador "Ella no se movió de su sitio, pero tampoco volvió a sacar el tema con su padre."
    narrador "She didn't leave her spot, but she didn't bring up her father again, either."

# game/02_cap1_beat_Nino.rpy:527
translate english nino_beat_m4b_773ce22b:

    # mc_pensamiento "No dijo nada más de lo que pensaba."
    mc_pensamiento "She didn't say anything more about what she was thinking."

# game/02_cap1_beat_Nino.rpy:529
translate english nino_beat_m4b_339ded3b:

    # mc_pensamiento "Y yo tampoco le pregunté."
    mc_pensamiento "And I didn't ask."

# game/02_cap1_beat_Nino.rpy:542
translate english nino_beat_m4c_c44dced5:

    # mc "Entonces deja de juntar los pedazos de las demás y ocúpate de los tuyos."
    mc "Then stop picking up everyone else's pieces and take care of your own."

# game/02_cap1_beat_Nino.rpy:544
translate english nino_beat_m4c_67d14333:

    # narrador "Lo dije pensando que la iba a hacer reaccionar."
    narrador "I said it thinking it would make her react."

# game/02_cap1_beat_Nino.rpy:546
translate english nino_beat_m4c_a1037331:

    # narrador "Reaccionó, pero no como esperaba."
    narrador "She did react, just not the way I expected."

# game/02_cap1_beat_Nino.rpy:551
translate english nino_beat_m4c_5d06c2b7:

    # nino "..."
    nino "..."

# game/02_cap1_beat_Nino.rpy:553
translate english nino_beat_m4c_d5baa7b7:

    # nino "Genial."
    nino "Great."

# game/02_cap1_beat_Nino.rpy:555
translate english nino_beat_m4c_95f328de:

    # nino "Dos semanas aquí y ya sabes exactamente qué decirme para que me calle."
    nino "Two weeks here and you already know exactly what to say to shut me up."

# game/02_cap1_beat_Nino.rpy:557
translate english nino_beat_m4c_177cab84:

    # mc "No dije que te callaras."
    mc "I didn't say to shut up."

# game/02_cap1_beat_Nino.rpy:559
translate english nino_beat_m4c_f33fecca:

    # nino "Dijiste que me ocupara de lo mío. Es la forma elegante de lo mismo."
    nino "You said to take care of my own. That's just the polite way of saying the same thing."

# game/02_cap1_beat_Nino.rpy:561
translate english nino_beat_m4c_a65aec1d:

    # narrador "Recogió su taza ella misma, sin dejar que me acercara."
    narrador "She picked up her own cup, not letting me get close."

# game/02_cap1_beat_Nino.rpy:563
translate english nino_beat_m4c_8825864b:

    # nino "Ahora entiendo por qué mi padre firmó contigo. Hablan el mismo idioma."
    nino "Now I get why my father signed you. You two speak the same language."

# game/02_cap1_beat_Nino.rpy:565
translate english nino_beat_m4c_a17ce448:

    # mc_pensamiento "No sé si eso es un insulto o la descripción más precisa que me ha dado."
    mc_pensamiento "I can't tell if that's an insult or the most accurate description anyone's given me."

# game/02_cap1_beat_Nino.rpy:567
translate english nino_beat_m4c_e375bfcf:

    # narrador "Se fue a su habitación sin volver a mirarme, con la taza todavía en la mano."
    narrador "She went to her room without looking at me again, the cup still in her hand."

# game/02_cap1_beat_Nino.rpy:569
translate english nino_beat_m4c_d9e324e9:

    # mc_pensamiento "Le hablé como le habla Maruo."
    mc_pensamiento "I talked to her the way Maruo talks to her."

# game/02_cap1_beat_Nino.rpy:571
translate english nino_beat_m4c_ff22d9f1:

    # mc_pensamiento "Y ella me contestó como le contesta a Maruo: yéndose."
    mc_pensamiento "And she answered the way she answers Maruo: by walking away."

# game/02_cap1_beat_Nino.rpy:588
translate english nino_beat_m5_aa16b953:

    # narrador "Me quedé un rato más en la cocina, solo, con el ruido del edificio de fondo."
    narrador "I stayed in the kitchen a while longer, alone, with the building's noises in the background."

# game/02_cap1_beat_Nino.rpy:590
translate english nino_beat_m5_68f0cd67:

    # mc_pensamiento "Vino a pedir que me fuera."
    mc_pensamiento "She came to get me sent away."

# game/02_cap1_beat_Nino.rpy:592
translate english nino_beat_m5_964e3b9b:

    # mc_pensamiento "Su padre dijo que no."
    mc_pensamiento "Her father said no."

# game/02_cap1_beat_Nino.rpy:594
translate english nino_beat_m5_645f50cf:

    # mc_pensamiento "Y aun así, el que se quedó dando explicaciones fui yo."
    mc_pensamiento "And still, I'm the one left giving explanations."

# game/02_cap1_beat_Nino.rpy:598
translate english nino_beat_m5_fcd8f28f:

    # mc_pensamiento "Maruo no va a repetir esa advertencia una tercera vez."
    mc_pensamiento "Maruo won't repeat that warning a third time."

# game/02_cap1_beat_Nino.rpy:600
translate english nino_beat_m5_046e9231:

    # mc_pensamiento "La próxima vez que hable de esto, no va a ser una advertencia."
    mc_pensamiento "The next time he brings this up, it won't be a warning."

# game/02_cap1_beat_Nino.rpy:602
translate english nino_beat_m5_3a005cf7:

    # mc_pensamiento "Será un despido asegurado."
    mc_pensamiento "It'll be a guaranteed dismissal."

# game/02_cap1_beat_Nino.rpy:606
translate english nino_beat_m5_454be720:

    # mc_pensamiento "Hoy fue a pelear sola y no le dijo a nadie."
    mc_pensamiento "Today she went to fight alone and told no one."

# game/02_cap1_beat_Nino.rpy:608
translate english nino_beat_m5_68cae4ea:

    # mc_pensamiento "Me puse a cortar cebollas y no volvió a hablar de despedirme."
    mc_pensamiento "I started cutting onions and she never brought up firing me again."

# game/02_cap1_beat_Nino.rpy:610
translate english nino_beat_m5_609871c2:

    # mc_pensamiento "Mi pregunta se quedó sin respuesta, y ella sabe que sigue ahí."
    mc_pensamiento "My question went unanswered, and she knows it's still out there."

# game/02_cap1_beat_Nino.rpy:614
translate english nino_beat_m5_43518715:

    # mc_pensamiento "La taza quedó en el escurridor y ella no volvió a mirarla."
    mc_pensamiento "The cup stayed in the drying rack and she never looked at it again."

# game/02_cap1_beat_Nino.rpy:616
translate english nino_beat_m5_fd2ab357:

    # mc_pensamiento "No me echó. Tampoco me dejó quedarme de verdad."
    mc_pensamiento "She didn't throw me out. She didn't really let me stay, either."

# game/02_cap1_beat_Nino.rpy:618
translate english nino_beat_m5_e2fe11d3:

    # mc_pensamiento "Hoy el silencio fue el único acuerdo que cabía entre los dos."
    mc_pensamiento "Today, silence was the only agreement that fit between the two of us."

# game/02_cap1_beat_Nino.rpy:622
translate english nino_beat_m5_7abdd6a1:

    # mc_pensamiento "Maruo cerró la conversación sin alzar la voz."
    mc_pensamiento "Maruo closed the conversation without raising his voice."

# game/02_cap1_beat_Nino.rpy:624
translate english nino_beat_m5_1fd4a4b2:

    # mc_pensamiento "Yo cerré la mía igual, una hora después y en la misma cocina."
    mc_pensamiento "I closed mine the same way, an hour later in the same kitchen."

# game/02_cap1_beat_Nino.rpy:626
translate english nino_beat_m5_f9a7b19f:

    # mc_pensamiento "Ella tuvo que ver la misma puerta cerrarse dos veces en una tarde."
    mc_pensamiento "She had to watch the same door close twice in one afternoon."

