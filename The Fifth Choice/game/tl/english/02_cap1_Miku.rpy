    miku "And that there was still salt in there anyway."

# game/02_cap1_Miku.rpy:309
translate english hub_Miku_85814a37:

    # miku "Alguien se la vendió."
    miku "Somebody sold it to them."

# game/02_cap1_Miku.rpy:311
translate english hub_Miku_67bd53c3:

    # miku "Y a mí eso me parece mucho más—"
    miku "And to me that seems a lot more—"

# game/02_cap1_Miku.rpy:318
translate english hub_Miku_2869e2a8:

    # narrador "Se paró en mitad de la palabra."
    narrador "She stopped in the middle of a word."

# game/02_cap1_Miku.rpy:320
translate english hub_Miku_2f08b67b:

    # narrador "Creo que se oyó."
    narrador "I think she heard it."

# game/02_cap1_Miku.rpy:322
translate english hub_Miku_cd3d67c8:

    # narrador "Fue eso: se oyó a sí misma hablando en voz alta durante un minuto entero."
    narrador "That was it: she'd heard herself talking out loud for a whole minute."

# game/02_cap1_Miku.rpy:324
translate english hub_Miku_5058e8da_4:

    # miku "..."
    miku "..."

# game/02_cap1_Miku.rpy:326
translate english hub_Miku_eb4263c5:

    # miku "...Perdón. Hablé mucho."
    miku "...Sorry. I talked a lot."

# game/02_cap1_Miku.rpy:328
translate english hub_Miku_7b7b9ffc:

    # mc "¿Por qué perdón?"
    mc "Why sorry?"

# game/02_cap1_Miku.rpy:330
translate english hub_Miku_92336fe0:

    # miku "...La gente pone una cara. Cuando hablo de esto."
    miku "...People make a face. When I talk about this."

# game/02_cap1_Miku.rpy:332
translate english hub_Miku_2d25235f:

    # mc "¿Qué cara?"
    mc "What face?"

# game/02_cap1_Miku.rpy:334
translate english hub_Miku_ce512acc:

    # miku "...La de esperar a que termine."
    miku "...The one where they wait for me to finish."

# game/02_cap1_Miku.rpy:339
translate english hub_Miku_34131564:

    # narrador "Y volvió a abrir el libro por donde tenía el dedo."
    narrador "And she opened the book again, right where her finger was."

# game/02_cap1_Miku.rpy:348
translate english hub_Miku_54502864:

    # mc_pensamiento "Tercera vez."
    mc_pensamiento "Third time."

# game/02_cap1_Miku.rpy:350
translate english hub_Miku_75174b79:

    # mc_pensamiento "Tercera vez que dice algo que nadie le pidió. Y otra vez, el perdón detrás."
    mc_pensamiento "Third time she's said something nobody asked for. And the apology right behind it, again."

# game/02_cap1_Miku.rpy:352
translate english hub_Miku_68b114ec:

    # mc_pensamiento "Nadie le enseñó a callarse. Se lo fueron enseñando las caras de los demás."
    mc_pensamiento "Nobody taught her to be quiet. Other people's faces did, one at a time."

# game/02_cap1_Miku.rpy:360
translate english hub_Miku_57a39a85:

    # mc_pensamiento "Ya subió el libro. Si no digo nada, no vuelve a bajarlo." nointeract
    mc_pensamiento "She's already raised the book. If I say nothing, it won't come back down." nointeract

# game/02_cap1_Miku.rpy:380
translate english miku_m4a_2bdf5374:

    # mc "¿Cuánto tardaba la sal en llegar desde el mar hasta allá?"
    mc "How long did it take the salt to get there from the sea?"

# game/02_cap1_Miku.rpy:385
translate english miku_m4a_77c3dfa3:

    # miku "...¿Qué?"
    miku "...What?"

# game/02_cap1_Miku.rpy:387
translate english miku_m4a_28d728ac:

    # mc "Es una pregunta."
    mc "It's a question."

# game/02_cap1_Miku.rpy:389
translate english miku_m4a_80f17ab0:

    # mc "Montaña, carga a lomo de animal, hace quinientos años. Cuánto tardaba."
    mc "Mountains, loaded on pack animals, five hundred years ago. How long did it take?"

# game/02_cap1_Miku.rpy:391
translate english miku_m4a_d89e10ed:

    # miku "...Diez días. Doce si llovía."
    miku "...Ten days. Twelve if it rained."

# game/02_cap1_Miku.rpy:393
translate english miku_m4a_fc787988:

    # mc "¿Y cuánto aguantaban ellos sin sal?"
    mc "And how long could they last without salt?"

# game/02_cap1_Miku.rpy:398
translate english miku_m4a_283bd44d:

    # miku "Depende de la época del año. En verano, con el pescado, casi nada."
    miku "Depends on the time of year. In summer, with fish, hardly any time."

# game/02_cap1_Miku.rpy:400
translate english miku_m4a_8ee853dd:

    # miku "Por eso quitarles el acceso a la sal no era una amenaza para más adelante, era de ese mismo mes."
    miku "So cutting off their salt wasn't a threat for later, it was for that same month."

# game/02_cap1_Miku.rpy:402
translate english miku_m4a_cbcb41f7:

    # miku "Eso es lo que a la gente se le esca—"
    miku "That's what people over—"

# game/02_cap1_Miku.rpy:407
translate english miku_m4a_6afbd7dc:

    # narrador "Se detuvo otra vez. Pero esta vez se detuvo distinto."
    narrador "She stopped again. But this time it was different."

# game/02_cap1_Miku.rpy:409
translate english miku_m4a_2fe1dc42:

    # narrador "Se detuvo mirándome a mí, no al libro."
    narrador "She stopped looking at me, not at the book."

# game/02_cap1_Miku.rpy:411
translate english miku_m4a_4e6d0084:

    # miku "...Per—"
    miku "...Sor—"

# game/02_cap1_Miku.rpy:413
translate english miku_m4a_fca52711:

    # mc "No."
    mc "Don't."

# game/02_cap1_Miku.rpy:415
translate english miku_m4a_5058e8da:

    # miku "..."
    miku "..."

# game/02_cap1_Miku.rpy:417
translate english miku_m4a_82fa21d2:

    # mc "Estabas contestando una pregunta que te hice yo. Eso no se disculpa."
    mc "You were answering a question I asked. You don't apologize for that."

# game/02_cap1_Miku.rpy:419
translate english miku_m4a_d7097891:

    # narrador "No dijo nada. Se le puso el libro a media altura, sin llegar a subirlo del todo."
    narrador "She said nothing. The book hung at half height, not quite going back up."

# game/02_cap1_Miku.rpy:421
translate english miku_m4a_2ef9ed9f:

    # narrador "Y entonces miró el ejemplar que yo había dejado sobre la mesa."
    narrador "And then she looked at the copy I'd left on the table."

# game/02_cap1_Miku.rpy:426
translate english miku_m4a_2fc1468d:

    # miku "...Dijiste que llegaste a la página noventa."
    miku "...You said you got to page ninety."

# game/02_cap1_Miku.rpy:428
translate english miku_m4a_4a7f7da3:

    # mc "Noventa y dos."
    mc "Ninety-two."

# game/02_cap1_Miku.rpy:430
translate english miku_m4a_435d662f:

    # miku "...Lo de la sal está en la ciento veinte."
    miku "...The salt part is on one-twenty."

# game/02_cap1_Miku.rpy:435
translate english miku_m4a_ab305321:

    # narrador "Lo dijo despacio, como quien termina una cuenta."
    narrador "She said it slowly, like someone finishing a sum."

# game/02_cap1_Miku.rpy:437
translate english miku_m4a_5c585618:

    # mc_pensamiento "Ahí estaba lo que acababa de entender."
    mc_pensamiento "That's what I'd just realized."

# game/02_cap1_Miku.rpy:439
translate english miku_m4a_a5f9b32d:

    # mc_pensamiento "No que yo supiera de esto."
    mc_pensamiento "It wasn't that I knew about this."

# game/02_cap1_Miku.rpy:441
translate english miku_m4a_d497cd25:

    # mc_pensamiento "Justo lo contrario: que no sabía nada, y que aun así me había pasado la noche en ello."
    mc_pensamiento "It was the opposite: I knew nothing, and I'd still spent the whole night on it."

# game/02_cap1_Miku.rpy:443
translate english miku_m4a_92b924c1:

    # mc "Voy a llegar a la ciento veinte."
    mc "I'm going to get to one-twenty."

# game/02_cap1_Miku.rpy:445
translate english miku_m4a_a74f9916:

    # mc "Lo que acabas de contarme son tres preguntas del examen."
    mc "What you just told me is three exam questions."

# game/02_cap1_Miku.rpy:447
translate english miku_m4a_c728fc46:

    # mc "Rutas de comercio, cómo se sostenía una provincia y por qué acabó unificándose el país."
    mc "Trade routes, how a province held together, and why the country ended up unified."

# game/02_cap1_Miku.rpy:449
translate english miku_m4a_109d6408:

    # mc "No te falta la materia. "
    mc "You're not missing the subject."

# game/02_cap1_Miku.rpy:451
translate english miku_m4a_2c21bd94:

    # mc "Te falta creer que lo que sabes cuenta como saber."
    mc "You're missing the belief that what you know counts as knowing."

# game/02_cap1_Miku.rpy:456
translate english miku_m4a_581d7ca4:

    # miku "...No es lo mismo."
    miku "...It's not the same."

# game/02_cap1_Miku.rpy:458
translate english miku_m4a_7f5c37c1:

    # mc "Es exactamente lo mismo, y lo vas a comprobar en el examen."
    mc "It's exactly the same, and you'll see it on the exam."

# game/02_cap1_Miku.rpy:463
translate english miku_m4a_3b9b3896:

    # narrador "No me contestó."
    narrador "She didn't answer."

# game/02_cap1_Miku.rpy:465
translate english miku_m4a_bc66cd14:

    # narrador "Pero cuando me levanté, el libro seguía a media altura y no había vuelto a subir."
    narrador "But when I got up, the book was still at half height and hadn't gone back up."

# game/02_cap1_Miku.rpy:479
translate english miku_m4b_2ef8f245:

    # mc "Se te da bien esto."
    mc "You're good at this."

# game/02_cap1_Miku.rpy:484
translate english miku_m4b_1301842d:

    # miku "...No se me da bien. Solo lo he leído."
    miku "...I'm not good. I've just read it."

# game/02_cap1_Miku.rpy:486
translate english miku_m4b_6329da37:

    # mc "Que es más de lo que ha hecho nadie en tu casa."
    mc "Which is more than anyone at your house has done."

# game/02_cap1_Miku.rpy:491
translate english miku_m4b_7f40ddcc:

    # miku "...Eso no es difícil."
    miku "...That's not hard."

# game/02_cap1_Miku.rpy:496
translate english miku_m4b_00d116b5:

    # narrador "Lo dijo sin ninguna gracia, como quien cierra una puerta con educación."
    narrador "She said it with no humor at all, the way you politely close a door."

# game/02_cap1_Miku.rpy:498
translate english miku_m4b_e69e3b87:

    # mc_pensamiento "Le acabo de poner una nota."
    mc_pensamiento "I just gave her a grade."

# game/02_cap1_Miku.rpy:500
translate english miku_m4b_cf7cb543:

    # mc_pensamiento "Y una nota es otra forma de decirle que ya puede dejar de hablar."
    mc_pensamiento "And a grade is another way of telling her she can stop talking."

# game/02_cap1_Miku.rpy:502
translate english miku_m4b_77871b40:

    # narrador "El libro le subió hasta media cara, y ahí se quedó."
    narrador "The book rose to half her face, and stayed there."

# game/02_cap1_Miku.rpy:516
translate english miku_m4c_cdcb843f:

    # mc "Nada de eso entra en el examen."
    mc "None of that is on the exam."

# game/02_cap1_Miku.rpy:518
translate english miku_m4c_cfb9be98:

    # mc "Unificación de Japón, tres temas, y ninguno pregunta por la sal."
    mc "Unification of Japan, three topics, and none of them asks about salt."

# game/02_cap1_Miku.rpy:520
translate english miku_m4c_c7158ec8:

    # mc "Si vas a dedicarle una hora a algo, que sea a lo que te van a preguntar."
    mc "If you're going to spend an hour on something, make it what they'll ask you."

# game/02_cap1_Miku.rpy:522
translate english miku_m4c_6d725350:

    # narrador "No protestó. No se defendió."
    narrador "She didn't protest. She didn't defend herself."

# game/02_cap1_Miku.rpy:524
translate english miku_m4c_e20bfc3f:

    # narrador "Asintió una vez, muy despacio, como si le hubieran confirmado algo que ya sospechaba."
    narrador "She nodded once, very slowly, as if I'd confirmed something she already suspected."

# game/02_cap1_Miku.rpy:529
translate english miku_m4c_78db6ee4:

    # miku "...Ya lo sé."
    miku "...I know."

# game/02_cap1_Miku.rpy:531
translate english miku_m4c_642df493:

    # narrador "Miró un segundo el ejemplar que yo había dejado sobre la mesa, y después apartó la vista."
    narrador "She looked for a second at the copy I'd left on the table, then looked away."

# game/02_cap1_Miku.rpy:533
translate english miku_m4c_061a3acf:

    # mc "Entonces empecemos por el tema uno."
    mc "Then let's start with topic one."

# game/02_cap1_Miku.rpy:535
translate english miku_m4c_15b75411:

    # miku "...Hoy no."
    miku "...Not today."

# game/02_cap1_Miku.rpy:543
translate english miku_m4c_3d7a7cd3:

    # narrador "Recogió los cuatro libros, los apiló y se subió los audífonos."
    narrador "She gathered her four books, stacked them, and put on her headphones."

# game/02_cap1_Miku.rpy:545
translate english miku_m4c_4afc7490:

    # narrador "Y esta vez, desde donde yo estaba, se oía la música."
    narrador "And this time, from where I sat, I could hear the music."

# game/02_cap1_Miku.rpy:547
translate english miku_m4c_6cd18920:

    # mc_pensamiento "..."
    mc_pensamiento "..."

# game/02_cap1_Miku.rpy:549
translate english miku_m4c_47ff497f:

    # mc_pensamiento "Antes no sonaban."
    mc_pensamiento "They hadn't been playing before."

# game/02_cap1_Miku.rpy:569
translate english miku_m5_7e631855:

    # narrador "Salí de la biblioteca cuando estaban apagando las luces de la segunda planta."
    narrador "I left the library as they were turning off the lights on the second floor."

# game/02_cap1_Miku.rpy:573
translate english miku_m5_0b0d3d19:

    # narrador "Su silla llevaba una hora vacía. Mal puesta, como la dejó al irse."
    narrador "Her chair had been empty for an hour. Pushed out crooked, the way she left it."

# game/02_cap1_Miku.rpy:577
translate english miku_m5_03231460:

    # narrador "Miku bajó conmigo. En la puerta nos despedimos."
    narrador "Miku walked down with me. We said goodbye at the door."

# game/02_cap1_Miku.rpy:579
translate english miku_m5_e9dbfcbb:

    # mc_pensamiento "Una de cinco. Y esta sabía mucho de lo que yo no."
    mc_pensamiento "One of five. And this one knew a lot about things I don't."

# game/02_cap1_Miku.rpy:581
translate english miku_m5_47430c21:

    # mc_pensamiento "Quedan [tiempo_restante!t]."
    mc_pensamiento "[tiempo_restante!t] left."

# game/02_cap1_Miku.rpy:586
translate english miku_m5_1a0d9191:

    # mc_pensamiento "Miku no es callada."
    mc_pensamiento "Miku isn't quiet."

# game/02_cap1_Miku.rpy:588
translate english miku_m5_efc91d3c:

    # mc_pensamiento "Está callada, que no es lo mismo."
    mc_pensamiento "She's silent, which isn't the same thing."

# game/02_cap1_Miku.rpy:590
translate english miku_m5_f2b2e87b:

    # mc_pensamiento "Hoy me habló durante un minuto seguido sin que tuviera que pedírselo."
    mc_pensamiento "Today she talked to me for a full minute without my having to ask."

# game/02_cap1_Miku.rpy:592
translate english miku_m5_439218a8:

    # mc_pensamiento "Eso, en esa casa, es un récord."
    mc_pensamiento "In that house, that's a record."

# game/02_cap1_Miku.rpy:596
translate english miku_m5_f710ef04:

    # mc_pensamiento "Le dije lo que odia escuchar."
    mc_pensamiento "I told her what she hates to hear."

# game/02_cap1_Miku.rpy:598
translate english miku_m5_4450bd74:

    # mc_pensamiento "No se defendió."
    mc_pensamiento "She didn't defend herself."

# game/02_cap1_Miku.rpy:600
translate english miku_m5_a6a93d27:

    # mc_pensamiento "Dijo tres frases y volvió a esconderse."
    mc_pensamiento "She said three sentences and went back into hiding."

# game/02_cap1_Miku.rpy:602
translate english miku_m5_efe77f72:

    # mc_pensamiento "No sé si perdí algo, pero desde luego no gané nada."
    mc_pensamiento "I don't know if I lost something, but I definitely didn't gain anything."

# game/02_cap1_Miku.rpy:606
translate english miku_m5_b95f54a1:

    # mc_pensamiento "Tenía razón en lo del examen."
    mc_pensamiento "I was right about the exam."

# game/02_cap1_Miku.rpy:608
translate english miku_m5_f5864c42:

    # mc_pensamiento "La sal no viene en el temario. Lo comprobé dos veces."
    mc_pensamiento "Salt isn't on the syllabus. I checked twice."

# game/02_cap1_Miku.rpy:610
translate english miku_m5_e85109e3:

    # mc_pensamiento "Hice bien al decirle que estudiara lo que realmente le iban a preguntar."
    mc_pensamiento "I was right to tell her to study what they'll actually ask."

# game/02_cap1_Miku.rpy:612
translate english miku_m5_53747958:

    # mc_pensamiento "Lo raro es que llevo toda la tarde con la sensación de haber hecho algo mal teniendo razón."
    mc_pensamiento "The weird part is I've felt all afternoon like I did something wrong while being right."

translate english strings:

    # game/02_cap1_Miku.rpy:356
    old "¿Qué le dirás a Miku?"
    new "What will you say to Miku?"

    # game/02_cap1_Miku.rpy:356
    old "Habló un minuto entero de lo que ama. Y después pidió perdón."
    new "She spoke for a full minute about what she loves, then apologized."

    # game/02_cap1_Miku.rpy:362
    old "Preguntarle cuánto tardaba la sal en llegar."
    new "Ask her how long the salt took to arrive."

    # game/02_cap1_Miku.rpy:365
    old "Decirle que se le da bien. Es la verdad."
    new "Tell her she's good at this. It's true."

    # game/02_cap1_Miku.rpy:368
    old "Lo de la sal no entra en el examen."
    new "The salt stuff isn't on the exam."

