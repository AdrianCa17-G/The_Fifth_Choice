translate english itsuki_m4b_e622e7a5:

    # narrador "No del todo."
    narrador "Not all the way."

# game/02_cap1_Itsuki.rpy:404
translate english itsuki_m4b_7184a8b4:

    # narrador "Lo suficiente para que entendiera que la oferta ya estaba rechazada."
    narrador "Just enough for me to understand the offer was already rejected."

# game/02_cap1_Itsuki.rpy:406
translate english itsuki_m4b_eba321c4:

    # mc "Está bien."
    mc "Okay."

# game/02_cap1_Itsuki.rpy:408
translate english itsuki_m4b_fccf80a8:

    # itsuki "Bien."
    itsuki "Fine."

# game/02_cap1_Itsuki.rpy:413
translate english itsuki_m4b_e4e537e5:

    # narrador "Me quedé un momento más de lo necesario, esperando algo que no llegó."
    narrador "I stood there a moment longer than necessary, waiting for something that didn't come."

# game/02_cap1_Itsuki.rpy:415
translate english itsuki_m4b_122b068a:

    # narrador "Fui a buscar mi cuaderno."
    narrador "I went to get my notebook."

# game/02_cap1_Itsuki.rpy:417
translate english itsuki_m4b_b0b7a4bd:

    # mc_pensamiento "No dijo que no supiera."
    mc_pensamiento "She didn't say she didn't know."

# game/02_cap1_Itsuki.rpy:419
translate english itsuki_m4b_bb14e82b:

    # mc_pensamiento "Dijo que no quería que se lo explicara."
    mc_pensamiento "She said she didn't want me to explain it."

# game/02_cap1_Itsuki.rpy:421
translate english itsuki_m4b_1c33b547:

    # mc_pensamiento "Con ella eso puede ser lo mismo o lo contrario."
    mc_pensamiento "With her, that can mean the same thing or the opposite."

# game/02_cap1_Itsuki.rpy:423
translate english itsuki_m4b_97408441:

    # mc_pensamiento "Hoy no lo voy a averiguar."
    mc_pensamiento "I'm not going to find out today."

# game/02_cap1_Itsuki.rpy:425
translate english itsuki_m4b_6ebd9b03:

    # narrador "Cuando volví a pasar por su pupitre, seguía en el mismo ejercicio."
    narrador "When I passed her desk again, she was still on the same exercise."

# game/02_cap1_Itsuki.rpy:427
translate english itsuki_m4b_fedcf42f:

    # narrador "La misma línea. Sin tacharla todavía."
    narrador "The same line. Not crossed out yet."

# game/02_cap1_Itsuki.rpy:440
translate english itsuki_m4c_3f45d690:

    # narrador "Estiré la mano hacia el cuaderno antes de que pudiera contestar."
    narrador "I reached for the notebook before she could answer."

# game/02_cap1_Itsuki.rpy:445
translate english itsuki_m4c_74d74e4e:

    # itsuki "¿Qué haces?"
    itsuki "What are you doing?"

# game/02_cap1_Itsuki.rpy:447
translate english itsuki_m4c_9f49060e:

    # mc "Ahorrarte tiempo."
    mc "Saving you time."

# game/02_cap1_Itsuki.rpy:449
translate english itsuki_m4c_550e7a57:

    # mc "El error está en el segundo paso, la conversión."
    mc "The error is in the second step, the conversion."

# game/02_cap1_Itsuki.rpy:453
translate english itsuki_m4c_ac60c476:

    # narrador "Lo resolví ahí mismo, de pie, con su propio lápiz."
    narrador "I solved it right there, standing, with her own pencil."

# game/02_cap1_Itsuki.rpy:455
translate english itsuki_m4c_ded9335b:

    # narrador "Le devolví el cuaderno con el ejercicio terminado."
    narrador "I handed the notebook back with the exercise finished."

# game/02_cap1_Itsuki.rpy:460
translate english itsuki_m4c_97eba050:

    # itsuki "..."
    itsuki "..."

# game/02_cap1_Itsuki.rpy:462
translate english itsuki_m4c_74543b48:

    # mc "Listo. El resultado es ese."
    mc "Done. That's the result."

# game/02_cap1_Itsuki.rpy:464
translate english itsuki_m4c_b7838e65:

    # itsuki "Ya lo veo."
    itsuki "So I see."

# game/02_cap1_Itsuki.rpy:453
translate english itsuki_m4c_43288477:

    # narrador "Ni me dio las gracias ni discutió."
    narrador "She didn't thank me, and she didn't argue."

# game/02_cap1_Itsuki.rpy:473
translate english itsuki_m4c_2cbd2252:

    # mc_pensamiento "Se lo resolví bien."
    mc_pensamiento "I solved it for her, and I solved it right."

# game/02_cap1_Itsuki.rpy:475
translate english itsuki_m4c_95eee588:

    # mc_pensamiento "Rápido, correcto, sin margen de error."
    mc_pensamiento "Fast, correct, no margin for error."

# game/02_cap1_Itsuki.rpy:477
translate english itsuki_m4c_d170fdef:

    # mc_pensamiento "Y le quité la única cosa que estaba defendiendo."
    mc_pensamiento "And I took away the one thing she was defending."

# game/02_cap1_Itsuki.rpy:461
translate english itsuki_m4c_a5fb30c9:

    # mc_pensamiento "Hacerlo ella sola."
    mc_pensamiento "Doing it on her own."

# game/02_cap1_Itsuki.rpy:486
translate english itsuki_m4c_68e0ff4c:

    # itsuki "Puedes irte. Ya tengo lo que necesitaba."
    itsuki "You may go. I already have what I needed."

# game/02_cap1_Itsuki.rpy:491
translate english itsuki_m4c_8b24d6c8:

    # narrador "Cerró el cuaderno del todo esta vez, con las dos manos."
    narrador "She closed the notebook all the way this time, with both hands."

# game/02_cap1_Itsuki.rpy:493
translate english itsuki_m4c_806183d4:

    # narrador "No volvió a levantar la vista."
    narrador "She didn't look up again."

# game/02_cap1_Itsuki.rpy:512
translate english itsuki_m5_1d3f66a8:

    # narrador "Salí del aula cuando ya casi no quedaba luz de ventana."
    narrador "I left the classroom when there was almost no window light left."

# game/02_cap1_Itsuki.rpy:514
translate english itsuki_m5_93089b9c:

    # narrador "Ella seguía en su pupitre."
    narrador "She was still at her desk."

# game/02_cap1_Itsuki.rpy:516
translate english itsuki_m5_7d85ac5f:

    # mc_pensamiento "Una de las cinco. Y esta no pidió nada."
    mc_pensamiento "One of the five. And this one didn't ask for anything."

# game/02_cap1_Itsuki.rpy:518
translate english itsuki_m5_47430c21:

    # mc_pensamiento "Quedan [tiempo_restante!t]."
    mc_pensamiento "[tiempo_restante!tc] left."

# game/02_cap1_Itsuki.rpy:522
translate english itsuki_m5_0597ee2a:

    # mc_pensamiento "No me dio las gracias. No esperaba que lo hiciera."
    mc_pensamiento "She didn't thank me. I didn't expect her to."

# game/02_cap1_Itsuki.rpy:524
translate english itsuki_m5_13c319bb:

    # mc_pensamiento "Pero tampoco me dijo que me fuera."
    mc_pensamiento "But she didn't tell me to leave, either."

# game/02_cap1_Itsuki.rpy:506
translate english itsuki_m5_b2bfe659:

    # mc_pensamiento "Con ella, eso cuenta más que un gracias."
    mc_pensamiento "With her, that counts for more than a thank-you."

# game/02_cap1_Itsuki.rpy:530
translate english itsuki_m5_d0557763:

    # mc_pensamiento "Rechazó la ayuda antes de saber qué era."
    mc_pensamiento "She turned down the help before knowing what it was."

# game/02_cap1_Itsuki.rpy:532
translate english itsuki_m5_8b82e923:

    # mc_pensamiento "Puede que no confíe en mí."
    mc_pensamiento "Maybe she doesn't trust me."

# game/02_cap1_Itsuki.rpy:534
translate english itsuki_m5_cc6cdf16:

    # mc_pensamiento "O puede que no confíe en que nadie la ayude sin cobrárselo después."
    mc_pensamiento "Or maybe she doesn't trust that anyone helps her without making her pay for it later."

# game/02_cap1_Itsuki.rpy:538
translate english itsuki_m5_ee3f9fd1:

    # mc_pensamiento "Se lo resolví bien y rápido. Ni siquiera protestó."
    mc_pensamiento "I solved it for her, fast and right. She didn't even protest."

# game/02_cap1_Itsuki.rpy:540
translate english itsuki_m5_6c1e5394:

    # mc_pensamiento "Eso debería sentirse como ganar."
    mc_pensamiento "That should feel like winning."

# game/02_cap1_Itsuki.rpy:542
translate english itsuki_m5_82a162ad:

    # mc_pensamiento "No se siente así."
    mc_pensamiento "It doesn't."

