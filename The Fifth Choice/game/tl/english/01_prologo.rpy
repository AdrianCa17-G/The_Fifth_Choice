translate english prologo_91cee4ee:

    # mc "Aun así, poner de acuerdo a las cinco no va a ser nada fácil."
    mc "Even so, getting all five of them to agree isn't going to be easy."

# game/01_prologo.rpy:1071
translate english prologo_904cc317:

    # maruo "No me interesan las dificultades, [mc]. Solo los resultados."
    maruo "I am not interested in difficulties, [mc]. Only results."

# game/01_prologo.rpy:1073
translate english prologo_801bd468:

    # maruo "Tienen exámenes pronto."
    maruo "They have exams soon."

# game/01_prologo.rpy:1075
translate english prologo_250f901a:

    # maruo "Si una sola de ellas reprueba, estás despedido en ese mismo instante."
    maruo "If even one of them fails, you are fired on the spot."

# game/01_prologo.rpy:1079
translate english prologo_37f019fa:

    # mc "...Entendido."
    mc "...Understood."

# game/01_prologo.rpy:1086
translate english prologo_da72c2d2:

    # narrador "Se dio la vuelta y se fue, cerrando la puerta con calma."
    narrador "He turned and left, closing the door calmly."

# game/01_prologo.rpy:1088
translate english prologo_55be39d4:

    # narrador "La calma de quien ya dio una orden y no acepta réplicas."
    narrador "The calm of someone who has given an order and accepts no replies."

# game/01_prologo.rpy:1094
translate english prologo_5b83343b:

    # narrador "El 'click' de la cerradura retumbó en toda la casa."
    narrador "The \"click\" of the lock echoed through the whole house."

# game/01_prologo.rpy:1096
translate english prologo_d4340e75:

