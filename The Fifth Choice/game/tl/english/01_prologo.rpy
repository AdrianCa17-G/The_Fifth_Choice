    # mc_pensamiento "Raiha no va a cenar mejor porque yo les caiga bien."
    mc_pensamiento "Raiha won't eat any better because they like me."

# game/01_prologo.rpy:1108
translate english prologo_4a37bee9_1:

    # mc_pensamiento "Da igual la actitud que tengan."
    mc_pensamiento "It doesn't matter what attitude they have."

# game/01_prologo.rpy:1110
translate english prologo_b5d7145d:

    # mc_pensamiento "Dije que lo haría, y no dejo nada a medias."
    mc_pensamiento "I said I'd do it, and I don't leave things half-done."

# game/01_prologo.rpy:1114
translate english prologo_4a37bee9_2:

    # mc_pensamiento "Da igual la actitud que tengan."
    mc_pensamiento "It doesn't matter what attitude they have."

