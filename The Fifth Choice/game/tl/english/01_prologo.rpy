translate english prologo_d98a0867:

    # mc_pensamiento "Estoy aquí por el dinero."
    mc_pensamiento "I'm here for the money."

# game/01_prologo.rpy:1119
translate english prologo_5df63da5:

    # narrador "Caminé hasta la mesa del centro, solté la mochila y saqué mi material sin pedir permiso."
    narrador "I walked to the middle table, dropped my bag and took out my materials without asking permission."

# game/01_prologo.rpy:1121
translate english prologo_9f1f29c1:

    # narrador "Coloqué cinco cuadernos sobre la mesa."
    narrador "I set five notebooks on the table."

# game/01_prologo.rpy:1123
translate english prologo_47e23082:

    # narrador "Cinco lápices."
    narrador "Five pencils."

# game/01_prologo.rpy:1127
translate english prologo_e5da1275:

    # narrador "Una hoja con un diagnóstico rápido de veinte preguntas."
    narrador "A sheet with a quick twenty-question diagnostic."

# game/01_prologo.rpy:1134
translate english prologo_60378c33:

    # mc "Bien. Vamos a empezar por lo básico."
    mc "All right. Let's start with the basics."

# game/01_prologo.rpy:1136
translate english prologo_ef7a6298:

    # mc "Necesito saber qué tanto saben... o qué tanto no saben."
    mc "I need to know how much you know... or how much you don't."

# game/01_prologo.rpy:1138
translate english prologo_c035d399:

    # ichika "Aww... ¿De verdad tenemos que hacer esto ahora?"
    ichika "Aww... Do we really have to do this right now?"

# game/01_prologo.rpy:1140
translate english prologo_8a1cdaf6:

    # ichika "Tengo una audición mañana y apenas pude dormir tres horas."
    ichika "I have an audition tomorrow and I barely got three hours of sleep."

# game/01_prologo.rpy:1142
translate english prologo_9da1a29c:

    # mc "Tu audición es mañana. La hoja es para hoy."
    mc "Your audition is tomorrow. The sheet is for today."

# game/01_prologo.rpy:1144
translate english prologo_893cd822:

    # narrador "Ichika soltó una sonrisa perezosa y recostó la cabeza en el respaldo del sillón."
    narrador "Ichika flashed a lazy smile and leaned her head against the back of the armchair."

# game/01_prologo.rpy:1146
translate english prologo_c9cafe6b:

    # narrador "Cerró los ojos al instante."
    narrador "She closed her eyes instantly."

# game/01_prologo.rpy:1148
translate english prologo_505ddd5d:

    # narrador "Miku tomó el lápiz, leyó la primera pregunta y lo volvió a dejar."
    narrador "Miku picked up the pencil, read the first question and put it back down."

# game/01_prologo.rpy:1150
translate english prologo_0a93b1f0:

    # narrador "Se subió los audífonos y me borró del mapa por completo."
    narrador "She pulled up her headphones and erased me from the map completely."

# game/01_prologo.rpy:1152
translate english prologo_8d1b4ee0:

    # mc_pensamiento "Dos fuera en menos de diez segundos. Excelente récord."
    mc_pensamiento "Two out in under ten seconds. Excellent record."

# game/01_prologo.rpy:1154
translate english prologo_9688d682:

    # yotsuba "¡Listo! ¡Terminé la primera parte!"
    yotsuba "Done! I finished the first part!"

# game/01_prologo.rpy:1156
translate english prologo_457bffa8:

    # narrador "Yotsuba escribió su nombre en la hoja con un entusiasmo desmedido."
    narrador "Yotsuba wrote her name on the sheet with outsized enthusiasm."

# game/01_prologo.rpy:1158
translate english prologo_50066d20:

    # narrador "Solo su nombre..."
    narrador "Only her name..."

# game/01_prologo.rpy:1160
translate english prologo_93e49cfe:

    # mc "Escribiste tu nombre. Eso es un uno por ciento de la hoja."
    mc "You wrote your name. That's one percent of the sheet."

# game/01_prologo.rpy:1162
translate english prologo_a3493a7a:

    # yotsuba "¡Pero un uno por ciento bien hecho! ¡Poco a poco se llega lejos!"
    yotsuba "But one percent done right! A little at a time gets you far!"

# game/01_prologo.rpy:1164
translate english prologo_b48db87f:

    # narrador "Itsuki, por su parte, era la única que de verdad estaba intentando responder..."
    narrador "Itsuki, for her part, was the only one actually trying to answer..."

# game/01_prologo.rpy:1166
translate english prologo_7a066091:

    # narrador "Aunque llevaba tres minutos atascada en el mismo problema."
    narrador "Though she'd been stuck on the same problem for three minutes."

# game/01_prologo.rpy:1168
translate english prologo_4e04e1a8:

    # itsuki "Ni se te ocurra decirme la respuesta. Puedo resolverlo sola."
    itsuki "Do not even think of telling me the answer. I can solve it myself."

# game/01_prologo.rpy:1170
translate english prologo_719cd929:

    # mc "Tranquila, no tenía ninguna intención de ayudarte."
    mc "Relax, I had no intention of helping you."

# game/01_prologo.rpy:1172
translate english prologo_b43ce03f:

    # itsuki "Perfecto. Sigue así."
    itsuki "Perfect. Keep it that way."

# game/01_prologo.rpy:1174
translate english prologo_d28e290c:

    # narrador "Y Nino ni siquiera tocó la hoja sobre la mesa."
    narrador "And Nino didn't even touch the sheet on the table."

# game/01_prologo.rpy:1176
translate english prologo_eb223b6b:

    # narrador "Se quedó mirándome con los brazos cruzados."
    narrador "She just stared at me with her arms crossed."

# game/01_prologo.rpy:1178
translate english prologo_098eb388:

    # nino "Yo no voy a hacer esa basura."
    nino "I'm not doing that garbage."

# game/01_prologo.rpy:1180
translate english prologo_46ab550d:

    # mc "Te digo que es una prueba de diagnóstico. No un examen de Harvard."
    mc "I'm telling you, it's a diagnostic test. Not a Harvard exam."

# game/01_prologo.rpy:1182
translate english prologo_a0ca06eb:

    # nino "Y yo te estoy diciendo que me da igual lo que sea."
    nino "And I'm telling you I don't care what it is."

# game/01_prologo.rpy:1184
translate english prologo_dfaa5937:

    # nino "No pienso gastar un solo segundo en esto."
    nino "I'm not spending a single second on this."

# game/01_prologo.rpy:1186
translate english prologo_585820d6:

    # nino "Un extraño dándome órdenes en mi propia casa... eso sí que no lo pienso tolerar."
    nino "A stranger giving me orders in my own house? Not happening."

# game/01_prologo.rpy:1192
translate english prologo_9128fae9:

    # narrador "Agarró su hoja sin tocar el lápiz y se retiró a su habitación, cerrando la puerta con fuerza."
    narrador "She snatched her sheet, left the pencil alone and stormed off to her room, slamming the door."

# game/01_prologo.rpy:1194
translate english prologo_45681e35:

    # narrador "Su salida fue solo el detonante de un fracaso que ya se veía venir."
    narrador "Her exit just set off a collapse that had been coming all along."

# game/01_prologo.rpy:1199
translate english prologo_468dfc46:

    # narrador "Ichika se puso de pie bostezando."
    narrador "Ichika stood up yawning."

# game/01_prologo.rpy:1201
translate english prologo_7e1f911b:

    # narrador "Alegó que el estrés le arruinaría la piel para su audición de mañana."
    narrador "She claimed stress would ruin her skin before tomorrow's audition."

# game/01_prologo.rpy:1205
translate english prologo_3f161c5d:

    # narrador "Miku ni se molestó en dar explicaciones."
    narrador "Miku didn't bother with explanations."

# game/01_prologo.rpy:1207
translate english prologo_d3c3ec05:

    # narrador "Simplemente se ajustó los audífonos y se marchó a su habitación en completo silencio."
    narrador "She simply adjusted her headphones and went to her room in complete silence."

# game/01_prologo.rpy:1211
translate english prologo_e3b27ef3:

    # narrador "Yotsuba, aplastada por la culpa de ver a las demás irse, me pidió perdón unas diez veces."
    narrador "Yotsuba, crushed by guilt at seeing the others leave, apologized to me about ten times."

# game/01_prologo.rpy:1213
translate english prologo_a1f377e5:

    # narrador "Con reverencias. Y salió huyendo a su cuarto, prometiendo «estudiar el doble mañana»."
    narrador "With bows. Then she fled to her room, promising to \"study twice as hard tomorrow.\""

# game/01_prologo.rpy:1217
translate english prologo_02b95112:

    # narrador "En menos de diez minutos, la mesa quedó vacía."
    narrador "In less than ten minutes, the table was empty."

# game/01_prologo.rpy:1219
translate english prologo_8632bb4a:

    # narrador "Bueno, casi vacía."
    narrador "Well, almost empty."

# game/01_prologo.rpy:1221
translate english prologo_7e168485:

    # narrador "Solo quedó Itsuki, que se levantó lentamente y decidió dirigirme la palabra."
    narrador "Only Itsuki was left. She rose slowly and decided to speak to me."

# game/01_prologo.rpy:1226
translate english prologo_92a8ed42:

    # itsuki "...Esto no va a funcionar, ¿sabes?"
    itsuki "...This isn't going to work, you know."

# game/01_prologo.rpy:1228
translate english prologo_57497922:

    # mc "Te seré sincero: me quedó bastante claro desde los dos primeros minutos."
    mc "Honestly, I figured that out in the first two minutes."

# game/01_prologo.rpy:1230
translate english prologo_c4b41ed7:

    # itsuki "Y aun así vas a volver mañana."
    itsuki "And yet you're coming back tomorrow."

# game/01_prologo.rpy:1232
translate english prologo_b4a76e62:

    # mc "Sí, voy a volver mañana."
    mc "Yes. I'm coming back tomorrow."

# game/01_prologo.rpy:1234
translate english prologo_750bb7bf:

    # itsuki "¿Por qué aún no te rindes?"
    itsuki "Why haven't you given up yet?"

# game/01_prologo.rpy:1239
translate english prologo_fad74b59:

    # mc_pensamiento "¿Por qué no me rindo?" nointeract
    mc_pensamiento "Why don't I give up?" nointeract

# game/01_prologo.rpy:1243
translate english prologo_a2ceb214:

    # mc "Porque me pagan."
    mc "Because it pays."

# game/01_prologo.rpy:1249
translate english prologo_34660c5f:

    # itsuki "Qué actitud tan desagradable."
    itsuki "What an unpleasant attitude."

# game/01_prologo.rpy:1251
translate english prologo_eb51a126:

    # mc "Es la verdad."
    mc "It's the truth."

# game/01_prologo.rpy:1253
translate english prologo_e1523ee9:

    # itsuki "...Al menos eres honesto, por horrible que suene."
    itsuki "...At least you're honest, however awful that sounds."

# game/01_prologo.rpy:1257
translate english prologo_6a9496e1:

    # mc "Porque nunca he dejado un problema sin resolver."
    mc "Because I've never left a problem unsolved."

# game/01_prologo.rpy:1263
translate english prologo_9de89850:

    # itsuki "Mis hermanas y yo no somos un problema de matemáticas."
    itsuki "My sisters and I are not a math problem."

# game/01_prologo.rpy:1265
translate english prologo_0789f591:

    # mc "Todavía no sé lo que son."
    mc "I don't know what you are yet."

# game/01_prologo.rpy:1269
translate english prologo_9b6b9021:

    # narrador "No dije nada. Recogí los cuadernos uno por uno."
    narrador "I said nothing. I picked up the notebooks one by one."

# game/01_prologo.rpy:1271
translate english prologo_02d6a0f7:

    # itsuki "...Entendido. Haz lo que quieras."
    itsuki "...Understood. Do whatever you want."

# game/01_prologo.rpy:1273
translate english prologo_10b95e3f:

    # narrador "No sé qué fue lo que interpretó, pero no volvió a insistir."
    narrador "I don't know what she read into it, but she didn't press the matter again."

# game/01_prologo.rpy:1282
translate english prologo_65b62bc6:

    # narrador "Salí del edificio pasadas las 9. La ciudad estaba fría y el trayecto a casa era largo."
    narrador "I left the building past 9. The city was cold and the trip home was long."

# game/01_prologo.rpy:1287
translate english prologo_89a8a491:

    # narrador "En el comedor quedaba una sola luz encendida."
    narrador "In the dining room, a single light was still on."

# game/01_prologo.rpy:1292
translate english prologo_5e09954b:

    # raiha "¡Hermanito! ¡Por fin!"
    raiha "[mc]! Finally!"

# game/01_prologo.rpy:1294
translate english prologo_eccdda0e:

    # raiha "Papá me mandó a dormir, pero no le hice caso."
    raiha "Dad sent me to bed, but I didn't listen."

# game/01_prologo.rpy:1296
translate english prologo_e4e159d0:

    # mc "Son más de las 9, Raiha."
    mc "It's after 9, Raiha."

# game/01_prologo.rpy:1298
translate english prologo_1979280a:

    # raiha "¡Ya sé qué hora es! Por eso te estaba esperando."
    raiha "I know what time it is! That's why I was waiting for you!"

# game/01_prologo.rpy:1303
translate english prologo_92e123f5:

    # raiha "¿Y esa cara? Traes cara de haber perdido."
    raiha "And what's with that face? You look like you lost."

# game/01_prologo.rpy:1305
translate english prologo_8cf5af2e:

    # mc "Una chica se sentó en mi asiento a almorzar. Discutimos."
    mc "A girl sat in my seat to eat lunch. We argued."

# game/01_prologo.rpy:1307
translate english prologo_20124430:

    # mc "Y resulta que es una de mis alumnas."
    mc "And it turns out she's one of my students."

# game/01_prologo.rpy:1309
translate english prologo_75e57038:

    # raiha "¿Y quién ganó?"
    raiha "And who won?"

# game/01_prologo.rpy:1311
translate english prologo_accb93ac:

    # mc "Nadie. Por eso traigo esta cara."
    mc "Nobody. That's why I'm making this face."

# game/01_prologo.rpy:1316
translate english prologo_a87659e0:

    # raiha "Mañana le ganas. ¡Tú siempre sacas el primer lugar!"
    raiha "Beat her tomorrow! You always take first place!"

# game/01_prologo.rpy:1321
translate english prologo_ee01d93a:

    # narrador "Se fue a su cuarto sin esperar a que le contestara."
    narrador "She went off to her room without waiting for my answer."

# game/01_prologo.rpy:1323
translate english prologo_b691f933:

    # narrador "Me había esperado despierta solo para eso."
    narrador "She'd stayed up waiting for me just for that."

# game/01_prologo.rpy:1328
translate english prologo_ccd7cb49:

    # mc_pensamiento "Cinco alumnas. Cero interés."
    mc_pensamiento "Five students. Zero interest."

# game/01_prologo.rpy:1330
translate english prologo_be922a1f:

    # mc_pensamiento "Ninguna de ellas quiere esto. Ninguna me quiere ahí."
    mc_pensamiento "None of them wants this. None of them wants me there."

# game/01_prologo.rpy:1332
translate english prologo_eb8193f8:

    # mc_pensamiento "Y hay una palabra rondándome la cabeza desde que crucé esa puerta:"
    mc_pensamiento "And one word has been rattling around in my head since I crossed that door:"

# game/01_prologo.rpy:1334
translate english prologo_313658da:

    # mc_pensamiento "Despedido."
    mc_pensamiento "Fired."

# game/01_prologo.rpy:1336
translate english prologo_9b08131e:

    # narrador "Debería haberme sentido derrotado. Lo raro es que no lo estaba."
    narrador "I should have felt defeated. The strange thing is, I didn't."

# game/01_prologo.rpy:1341
translate english prologo_e8e8cd42:

    # mc_pensamiento "Bien. Que sea difícil."
    mc_pensamiento "Fine. Let it be hard."

# game/01_prologo.rpy:1343
translate english prologo_6ab2e41e:

    # mc_pensamiento "A mí nunca me han regalado nada."
    mc_pensamiento "Nobody has ever handed me anything."

# game/01_prologo.rpy:1345
translate english prologo_1d3ca93c:

    # narrador "Abrí mi libreta, anoté los cinco nombres y tracé una línea debajo."
    narrador "I opened my notebook, wrote down the five names and drew a line beneath them."

# game/01_prologo.rpy:1347
translate english prologo_31edcee4:

    # narrador "Mañana empezaría la verdadera batalla."
    narrador "Tomorrow the real battle would begin."

# game/01_prologo.rpy:1349
translate english prologo_946ed5c8:

    # narrador "Apagué la lámpara del escritorio y me acosté."
    narrador "I switched off the desk lamp and lay down."

# game/01_prologo.rpy:1354
translate english prologo_46690a51:

    # narrador "Así empezó todo."
    narrador "That's how it all began."

# game/01_prologo.rpy:1356
translate english prologo_fe41d510:

    # narrador "Y no, no tenía ni la más remota idea de en qué me estaba metiendo."
    narrador "And no, I had no idea what I was getting myself into."

