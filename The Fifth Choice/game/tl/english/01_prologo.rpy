# game/01_prologo.rpy:63
translate english prologo_13fe8e7a:

    # narrador "Hay dos clases de personas en este mundo."
    narrador "There are two kinds of people in this world."

# game/01_prologo.rpy:65
translate english prologo_e2b506a5:

    # narrador "Las que pueden permitirse el lujo de equivocarse."
    narrador "The ones who can afford to be wrong."

# game/01_prologo.rpy:67
translate english prologo_53f29ec3:

    # narrador "Y las que no."
    narrador "And the ones who can't."

# game/01_prologo.rpy:69
translate english prologo_2b8eb266:

    # mc_pensamiento "Yo pertenezco a la segunda."
    mc_pensamiento "I belong to the second kind."

# game/01_prologo.rpy:76
translate english prologo_9d86e401:

    # mc_pensamiento "Mi madre murió cuando yo era pequeño."
    mc_pensamiento "My mother died when I was little."

# game/01_prologo.rpy:78
translate english prologo_6475cece:

    # mc_pensamiento "El restaurante que abrió con mi padre cerró poco después. La deuda no cerró con él."
    mc_pensamiento "The restaurant my parents opened closed soon after. The debt didn't close with it."

# game/01_prologo.rpy:80
translate english prologo_6ca985c3:

    # mc_pensamiento "Mi padre hace fotos por encargo: bodas, graduaciones, lo que salga."
    mc_pensamiento "My father takes photos for hire: weddings, graduations, whatever comes up."

# game/01_prologo.rpy:82
translate english prologo_87f24cdc:

    # mc_pensamiento "Él trabaja y yo estudio. Los dos, hasta el cansancio."
    mc_pensamiento "He works and I study. Both of us, until we drop."

# game/01_prologo.rpy:84
translate english prologo_5120e485:

    # mc_pensamiento "(Aunque a veces eso no es suficiente para cubrir esta deuda...)"
    mc_pensamiento "(Though sometimes even that isn't enough to cover this debt...)"

# game/01_prologo.rpy:86
translate english prologo_61dfff7b:

    # mc_pensamiento "Luego está Raiha, que, sin lugar a dudas, merece un futuro mejor que esta pobreza."
    mc_pensamiento "And then there's Raiha, who deserves a better future than this. No question."

# game/01_prologo.rpy:88
translate english prologo_067610ba:

    # mc_pensamiento "Por eso estudio."
    mc_pensamiento "That's why I study."

# game/01_prologo.rpy:90
translate english prologo_a5ee6bda:

    # mc_pensamiento "No por vocación o por esas cosas bonitas que dicen los profesores en las ceremonias de ingreso."
    mc_pensamiento "Not out of passion, or whatever they tell you at entrance ceremonies."

# game/01_prologo.rpy:92
translate english prologo_8f60f29f:

    # mc_pensamiento "Estudio porque las notas son lo único que puedo controlar."
    mc_pensamiento "I study because grades are the only thing I can control."

# game/01_prologo.rpy:97
translate english prologo_f11f2bd9:

    # mc_pensamiento "Esta pila de libros es la única herramienta que tengo para cambiar nuestra realidad."
    mc_pensamiento "This stack of books is the only tool I have to change our situation."

# game/01_prologo.rpy:99
translate english prologo_c0f406b4:

    # mc_pensamiento "Logré el primer puesto en el examen nacional. Otra vez."
    mc_pensamiento "I took first place on the national exam. Again."

# game/01_prologo.rpy:101
translate english prologo_323874ec:

    # mc_pensamiento "No es como que me alegre, eso no llenará la nevera."
    mc_pensamiento "It's not like I'm happy about it. It won't fill the fridge."

# game/01_prologo.rpy:103
translate english prologo_e7b66fca:

    # narrador "De repente, una voz infantil interrumpió mis pensamientos intrusivos."
    narrador "Then a little voice cut through my thoughts."

# game/01_prologo.rpy:105
translate english prologo_40cdc0a1:

    # raiha "¡Hermanito! ¡Baja a cenar de una vez!"
    raiha "[mc]! Come down for dinner already!"

# game/01_prologo.rpy:107
translate english prologo_96f92b83:

    # mc "Dame un segundo, Raiha, ya mismo termino la tarea."
    mc "Give me a second, Raiha. I'm almost done with my homework."

# game/01_prologo.rpy:109
translate english prologo_cc5096a3:

    # raiha "¡Llevas media hora con el mismo 'segundo'! ¡Y el curry no va a durar caliente para siempre!"
    raiha "You've been saying \"a second\" for half an hour! And the curry won't stay hot forever!"

# game/01_prologo.rpy:111
translate english prologo_c073fe57:

    # mc_pensamiento "(¿Curry? ¿Hoy no tocaba solo sopa de miso...?)"
    mc_pensamiento "(Curry? Wasn't tonight just miso soup...?)"

# game/01_prologo.rpy:113
translate english prologo_8f568cb5:

    # mc "Está bien... Ya voy."
    mc "Okay... I'm coming."

# game/01_prologo.rpy:115
translate english prologo_3ddc874f:

    # mc_pensamiento "Raiha. Mi hermana pequeña."
    mc_pensamiento "Raiha. My little sister."

# game/01_prologo.rpy:117
translate english prologo_a9fb71d7:

    # mc_pensamiento "La única persona en esta casa que sigue creyendo que las cosas pueden salir bien."
    mc_pensamiento "The only person in this house who still believes things can work out."

# game/01_prologo.rpy:119
translate english prologo_4bcf9c42:

    # mc_pensamiento "Y la única razón por la que no me he rendido todavía."
    mc_pensamiento "And the only reason I haven't given up yet."

# game/01_prologo.rpy:126
translate english prologo_6a65ab78:

    # mc "Hoy es una noche especial. ¡Raiha preparó curry!"
    mc "Tonight's a special night. Raiha made curry!"

# game/01_prologo.rpy:128
translate english prologo_5f9fd976:

    # mc_pensamiento "Para mucha gente, la cena es solo la cena."
    mc_pensamiento "For a lot of people, dinner is just dinner."

# game/01_prologo.rpy:130
translate english prologo_0ea7ab85:

    # mc_pensamiento "En esta casa es el único rato del día en que nadie hace cuentas."
    mc_pensamiento "In this house, it's the only part of the day when nobody does the math."

# game/01_prologo.rpy:132
translate english prologo_7dd3e132:

    # narrador "Ya en la mesa, devoré el plato en cuestión de segundos."
    narrador "At the table, I wolfed it down in seconds."

# game/01_prologo.rpy:137
translate english prologo_3169b299:

    # mc "¡Gracias por la comida!"
    mc "Thanks for the food!"

# game/01_prologo.rpy:139
translate english prologo_506cde3f:

    # raiha "Hermanito, hoy en la escuela dijeron que los hermanos mayores tienen que dar el ejemplo."
    raiha "Big brother, at school today they said older siblings have to set an example."

# game/01_prologo.rpy:141
translate english prologo_6ffee215:

    # mc "¿En serio? Supongo que yo soy un ejemplo perfecto para ti... ¿no?"
    mc "Really? I guess I'm the perfect example for you... right?"

# game/01_prologo.rpy:146
translate english prologo_c5fa1fc0:

    # raiha "¡Claro! El ejemplo de alguien que estudia todo el día y no duerme nada."
    raiha "Of course! The example of someone who studies all day and never sleeps."

# game/01_prologo.rpy:148
translate english prologo_b5931cef:

    # mc "La parte de dormir es negociable."
    mc "The sleeping part is negotiable."

# game/01_prologo.rpy:150
translate english prologo_d61f09f0:

    # raiha "¡No lo es! ¡Cuidar tu salud durmiendo bien también es importante!"
    raiha "It's not! Taking care of your health by sleeping well matters too!"

# game/01_prologo.rpy:155
translate english prologo_0104dad0:

    # raiha "...Anoche también te escuché pasar páginas a las 3."
    raiha "...I heard you turning pages at 3 last night, too."

# game/01_prologo.rpy:157
translate english prologo_2c0a1e35:

    # narrador "Lo dijo sin gritar, que en ella era prácticamente un susurro."
    narrador "She said it without shouting, which for her was practically a whisper."

# game/01_prologo.rpy:159
translate english prologo_f7473115:

    # mc_pensamiento "Se lo tomó tan en serio que casi me sentí culpable. Casi."
    mc_pensamiento "She took it so seriously I almost felt guilty. Almost."

# game/01_prologo.rpy:169
translate english prologo_b531d1dc:

    # narrador "De repente, mi padre, Isanari, entró en el comedor y dejó caer un papel sobre la mesa."
    narrador "Then my father, Isanari, walked into the dining room and dropped a paper on the table."

# game/01_prologo.rpy:177
translate english prologo_59c8b7e6:

    # isanari "[mc], tengo un trabajo para ti."
    isanari "[mc], I've got a job for you."

# game/01_prologo.rpy:179
translate english prologo_c319e7e8:

    # mc "¿Un trabajo? ¿De qué tipo?"
    mc "A job? What kind?"

# game/01_prologo.rpy:181
translate english prologo_85cec063:

    # isanari "Uno legal, antes de que pongas esa cara."
    isanari "A legal one, so lose that look."

# game/01_prologo.rpy:183
translate english prologo_5268c18b:

    # isanari "Un viejo amigo del instituto busca un tutor privado para su familia."
    isanari "An old friend from high school is looking for a private tutor for his family."

# game/01_prologo.rpy:185
translate english prologo_af3f74dc:

    # mc "¿Tutor privado?... Creo que esta vez paso."
    mc "A private tutor?... I think I'll pass this time."

# game/01_prologo.rpy:187
translate english prologo_c41d5931:

    # mc "No me llama la atención y tampoco soy del tipo que sabe enseñarle a los demás."
    mc "It doesn't interest me, and I'm not the type who knows how to teach others."

# game/01_prologo.rpy:189
translate english prologo_3f63a0d4:

    # isanari "En eso tienes un punto, pero lo que sí te va a interesar es saber el pago."
    isanari "Fair point. But you'll want to hear about the pay."

# game/01_prologo.rpy:193
translate english prologo_168a19e4:

    # mc_pensamiento "Al escuchar la palabra 'pago', puse la mayor atención posible."
    mc_pensamiento "At the word \"pay,\" I gave him my full attention."

# game/01_prologo.rpy:195
translate english prologo_d52d7491:

    # mc_pensamiento "(No es como que crea que el dinero lo es todo, pero en esta situación en la que nos encontramos...)"
    mc_pensamiento "(It's not like I think money is everything, but in the situation we're in...)"

# game/01_prologo.rpy:197
translate english prologo_75d9ba81:

    # mc "¿De cuánto estamos hablando?"
    mc "How much are we talking about?"

# game/01_prologo.rpy:201
translate english prologo_b6fade41:

    # isanari "Cinco veces la tarifa normal de un tutor."
    isanari "Five times the going rate for a tutor."

# game/01_prologo.rpy:203
translate english prologo_0c5eb183:

    # narrador "Hubo un silencio breve."
    narrador "There was a brief silence."

# game/01_prologo.rpy:205
translate english prologo_b43000e9:

    # narrador "El tipo de silencio que delata a alguien que ya aceptó la propuesta en su mente."
    narrador "The kind of silence that gives away someone who's already said yes in their head."

# game/01_prologo.rpy:207
translate english prologo_2798abd1:

    # mc "...Entiendo. ¿Tienes más detalles?"
    mc "...I see. Do you have more details?"

# game/01_prologo.rpy:209
translate english prologo_e5b6dbd1:

    # isanari "Es una familia adinerada. Un solo domicilio y clases particulares hasta la graduación."
    isanari "It's a wealthy family. One address, and private lessons until graduation."

# game/01_prologo.rpy:211
translate english prologo_566e7764:

    # mc_pensamiento "Suena demasiado perfecto... Seguro debe haber una trampa."
    mc_pensamiento "Sounds too perfect... There must be a catch."

# game/01_prologo.rpy:213
translate english prologo_f0ff8817:

    # mc "¿Y el truco?"
    mc "And the catch?"

# game/01_prologo.rpy:215
translate english prologo_5184b20c:

    # isanari "¿Por qué asumes que hay un truco?"
    isanari "Why do you assume there's a catch?"

# game/01_prologo.rpy:217
translate english prologo_52f773a3:

    # mc "Porque nadie paga cinco veces más por algo que se consigue por una."
    mc "Because nobody pays five times more for something you can get for one."

# game/01_prologo.rpy:222
translate english prologo_f0fbb484:

    # narrador "Mi padre sonrió. Aquello significaba que el truco existía."
    narrador "My father smiled. That meant the catch existed."

# game/01_prologo.rpy:224
translate english prologo_4f556a77:

    # narrador "Y que habría que descubrirlo por las buenas o por las malas."
    narrador "And that we'd have to find it, the easy way or the hard way."

# game/01_prologo.rpy:226
translate english prologo_fa56306c:

    # isanari "Detalles menores. Ya los verás."
    isanari "Minor details. You'll see."

# game/01_prologo.rpy:228
translate english prologo_3973ed9c:

    # mc "Los detalles menores son los que arruinan los cálculos."
    mc "It's the minor details that ruin the math."

# game/01_prologo.rpy:230
translate english prologo_e7c0927d:

    # isanari "Entonces trátalo como un examen sorpresa. Se te dan bien."
    isanari "Then treat it like a pop quiz. You're good at those."

# game/01_prologo.rpy:232
translate english prologo_094d2707:

    # mc_pensamiento "Sabe exactamente qué tecla tocar. Siempre lo ha sabido."
    mc_pensamiento "He knows exactly which button to push. He always has."

# game/01_prologo.rpy:234
translate english prologo_da0272f9:

    # mc_pensamiento "Y siempre la toca cuando necesita algo de mí."
    mc_pensamiento "And he always pushes it when he needs something from me."

# game/01_prologo.rpy:239
translate english prologo_e4a846da:

    # raiha "¡Hermanito, deberías aceptar!"
    raiha "[mc], you should say yes!"

# game/01_prologo.rpy:241
translate english prologo_48273306:

    # raiha "¡Así podrías estudiar tranquilo sin andar contando cada cosa que compramos!"
    raiha "That way you could study in peace without counting every single thing we buy!"

# game/01_prologo.rpy:243
translate english prologo_b73b23b5:

    # mc "Me lo pensaré, Raiha."
    mc "I'll think about it, Raiha."

# game/01_prologo.rpy:247
translate english prologo_f75472bc:

    # mc_pensamiento "«Cada cosa que compramos». Lo dijo en plural."
    mc_pensamiento "\"Every single thing we buy.\" She said \"we.\""

# game/01_prologo.rpy:249
translate english prologo_c25f9ee6:

    # mc_pensamiento "Ella también hace las cuentas. Nunca le pedí que las hiciera."
    mc_pensamiento "She does the math too. I never asked her to."

# game/01_prologo.rpy:251
translate english prologo_532324bd:

    # mc_pensamiento "No es el trabajo de mis sueños, pero..."
    mc_pensamiento "It's not the job of my dreams, but..."

# game/01_prologo.rpy:253
translate english prologo_c261d184:

    # mc_pensamiento "Voy a decir que sí. Lo que no tengo tan claro es por qué."
    mc_pensamiento "I'm going to say yes. What I'm less sure of is why."

# game/01_prologo.rpy:258
translate english prologo_30d14a70:

    # mc_pensamiento "¿Qué es lo que me empuja, de verdad?" nointeract
    mc_pensamiento "What's really pushing me?" nointeract

# game/01_prologo.rpy:264
translate english prologo_f014e1da:

    # mc_pensamiento "No voy a fingir nobleza. Aceptaré por el dinero, y punto."
    mc_pensamiento "I won't pretend to be noble. I'll take it for the money, period."

# game/01_prologo.rpy:266
translate english prologo_7a536940:

    # mc_pensamiento "Las buenas intenciones no pagan las facturas."
    mc_pensamiento "Good intentions don't pay the bills."

# game/01_prologo.rpy:272
translate english prologo_9b4670df:

    # mc_pensamiento "Raiha ya hace cuentas a su edad."
    mc_pensamiento "Raiha already does the math at her age."

# game/01_prologo.rpy:274
translate english prologo_5b66d214:

    # mc_pensamiento "Si alguien tiene que hacerlas en esta casa, que sea yo."
    mc_pensamiento "If someone in this house has to do it, it should be me."

# game/01_prologo.rpy:280
translate english prologo_e9dea1b1:

    # mc_pensamiento "Nunca he abandonado un problema a medio resolver."
    mc_pensamiento "I've never abandoned a problem half-solved."

# game/01_prologo.rpy:282
translate english prologo_5da02c42:

    # mc_pensamiento "Y este no será la excepción."
    mc_pensamiento "And this one won't be the exception."

# game/01_prologo.rpy:285
translate english prologo_6d3afb3f:

    # mc "Está bien. Lo haré."
    mc "Fine. I'll do it."

# game/01_prologo.rpy:289
translate english prologo_46063860:

    # isanari "Sabía que entrarías en razón."
    isanari "I knew you'd see reason."

# game/01_prologo.rpy:291
translate english prologo_56bb4b17:

    # isanari "Mejor así. Ya le había dicho a Maruo que sí."
    isanari "Better this way. I'd already told Maruo yes."

# game/01_prologo.rpy:293
translate english prologo_2aa8ef48:

    # mc "¿Antes de preguntarme?"
    mc "Before asking me?"

# game/01_prologo.rpy:295
translate english prologo_6267c0d7:

    # isanari "Te pregunté. Solo que después."
    isanari "I did ask you. Just afterward."

# game/01_prologo.rpy:299
translate english prologo_c4ba5177:

    # mc_pensamiento "Enseñar a otros no es lo mío... pero dada nuestra situación, no puedo darme el lujo de rechazarlo."
    mc_pensamiento "Teaching others isn't my thing... but given our situation, I can't afford to turn it down."

# game/01_prologo.rpy:313
translate english prologo_01997652:

    # narrador "A la mañana siguiente llegué al instituto antes que casi nadie."
    narrador "The next morning I got to school before almost anyone."

# game/01_prologo.rpy:315
translate english prologo_1550b31a:

    # mc_pensamiento "Prefiero esta hora, cuando los pasillos todavía están vacíos."
    mc_pensamiento "I prefer this hour, when the hallways are still empty."

# game/01_prologo.rpy:317
translate english prologo_fa04d70b:

    # mc_pensamiento "Es el único rato del día en que este sitio no me echa nada en cara."
    mc_pensamiento "It's the only time of day this place doesn't rub anything in my face."

# game/01_prologo.rpy:319
translate english prologo_2aa44cb1:

    # mc_pensamiento "Que los demás sí pueden permitirse estar tranquilos."
    mc_pensamiento "Like the fact that everyone else can afford to relax."

# game/01_prologo.rpy:323
translate english prologo_b279ef73:

    # mc_pensamiento "(Cierto... hoy entregan los resultados de los exámenes de práctica. Iré al salón)."
    mc_pensamiento "(Right... today they hand back the practice exam results. I'll head to the classroom.)"

# game/01_prologo.rpy:328
translate english prologo_14ef0c51:

    # profe "[mc], enhorabuena por el examen de práctica. Otra vez el primer lugar."
    profe "[mc], congratulations on the practice exam. First place again."

# game/01_prologo.rpy:330
translate english prologo_e667e549:

    # mc "Gracias, profesor. Solo mantengo el nivel."
    mc "Thank you, sir. I'm just keeping up my level."

# game/01_prologo.rpy:332
translate english prologo_4f3e3424:

    # profe "Con estas notas, no me cabe duda de que te espera un gran futuro."
    profe "With grades like these, I have no doubt a great future awaits you."

# game/01_prologo.rpy:334
translate english prologo_e88b1bcc:

    # mc_pensamiento "(Palabras bonitas. Lástima que el futuro no pague las facturas de hoy)."
    mc_pensamiento "(Nice words. Too bad the future doesn't pay today's bills.)"

# game/01_prologo.rpy:339
translate english prologo_70dfdaee:

    # narrador "Con mi examen perfecto en mano, fui a buscar mi asiento habitual."
    narrador "With my perfect exam in hand, I went to find my usual seat."

# game/01_prologo.rpy:341
translate english prologo_309a9aa5:

    # mc_pensamiento "Mi rincón habitual."
    mc_pensamiento "My usual corner."

# game/01_prologo.rpy:343
translate english prologo_f5d8115b:

    # mc_pensamiento "El único lugar de esta aula donde podía concentrarme sin escuchar tonterías."
    mc_pensamiento "The only spot in this classroom where I could concentrate without hearing nonsense."

# game/01_prologo.rpy:345
translate english prologo_997793e4:

    # mc_pensamiento "Sin embargo, mi sitio..."
    mc_pensamiento "But my seat..."

# game/01_prologo.rpy:352
translate english prologo_895227c7:

    # mc_pensamiento "¡Estaba ocupado!"
    mc_pensamiento "It was taken!"

# game/01_prologo.rpy:354
translate english prologo_ca2b947c:

    # mc_pensamiento "¿Quién se cree que es para tomar mi lugar?"
    mc_pensamiento "Who does she think she is, taking my spot?"

# game/01_prologo.rpy:356
translate english prologo_8cf60adc:

    # mc_pensamiento "¿Y encima se pone a comer tranquilamente en mi puesto?"
    mc_pensamiento "And on top of that, she's calmly eating at my desk?"

# game/01_prologo.rpy:358
translate english prologo_254715bf:

    # mc "Perdona. Estás en mi asiento."
    mc "Excuse me. You're in my seat."

# game/01_prologo.rpy:360
translate english prologo_8d1432da:

    # mc_pensamiento "Tenía una ligera cara de preocupación."
    mc_pensamiento "She looked slightly worried."

# game/01_prologo.rpy:362
translate english prologo_774f912c:

    # mc_pensamiento "Como si cargara con un problema, o los exámenes le hubieran salido fatal."
    mc_pensamiento "Like she was carrying a problem, or her exams had gone terribly."

# game/01_prologo.rpy:364
translate english prologo_4fb83fb8:

    # itsuki_inicio "*Munch...* ¿Mm? Ah... tú debes ser [mc]."
    itsuki_inicio "*Munch...* Hm? Oh... you must be [mc]."

# game/01_prologo.rpy:366
translate english prologo_0ffe885a:

    # narrador "Sostuvo los palillos a mitad de camino y fijó su mirada en la hoja de examen que llevaba en la mano."
    narrador "She froze with her chopsticks halfway up, eyes on the exam in my hand."

# game/01_prologo.rpy:374
translate english prologo_859337e5:

    # itsuki_inicio "Escuché al profesor diciendo que tu examen fue de cien puntos."
    itsuki_inicio "I heard the teacher say your exam was a hundred points."

# game/01_prologo.rpy:376
translate english prologo_7211ff3a:

    # itsuki_inicio "Además, dijo que eras el mejor de la clase."
    itsuki_inicio "He also said you were the best in the class."

# game/01_prologo.rpy:378
translate english prologo_c6923755:

    # itsuki_inicio "Verás, acabo de transferirme y las materias aquí son más difíciles..."
    itsuki_inicio "See, I just transferred, and the subjects here are harder..."

# game/01_prologo.rpy:380
translate english prologo_b1966c3f:

    # itsuki_inicio "Así que..."
    itsuki_inicio "So..."

# game/01_prologo.rpy:382
translate english prologo_cda064ac:

    # itsuki_inicio "¿Podrías enseñarme un poco? Te lo agradecería mucho."
    itsuki_inicio "Could you teach me a little? I'd really appreciate it."

# game/01_prologo.rpy:384
translate english prologo_fca52711:

    # mc "No."
    mc "No."

# game/01_prologo.rpy:389
translate english prologo_fe6f1ed8:

    # itsuki_inicio "¡¿Eh?! ¡Ni siquiera te lo pensaste!"
    itsuki_inicio "Huh?! You didn't even think about it!"

# game/01_prologo.rpy:391
translate english prologo_7ec2e211:

    # itsuki_inicio "¡Solo te pido algo de orientación mientras almuerzo!"
    itsuki_inicio "I'm only asking for a little guidance while I eat lunch!"

# game/01_prologo.rpy:393
translate english prologo_67abb878:

    # mc "Aprender es un proceso personal."
    mc "Learning is a personal process."

# game/01_prologo.rpy:395
translate english prologo_c3fb7f53:

    # mc "Invertir mi tiempo para explicar cosas básicas no tiene sentido para mí."
    mc "Wasting my time explaining basics makes no sense to me."

# game/01_prologo.rpy:397
translate english prologo_59971692:

    # mc "Para eso están los profesores."
    mc "That's what teachers are for."

# game/01_prologo.rpy:399
translate english prologo_b3f998e3:

    # mc "Ahora, si me disculpas, necesito mi asiento."
    mc "Now, if you'll excuse me, I need my seat."

# game/01_prologo.rpy:401
translate english prologo_abbe121d:

    # itsuki_inicio "..."
    itsuki_inicio "..."

# game/01_prologo.rpy:410
translate english prologo_7eb053a6:

    # narrador "La chica apretó los dientes y masticó el último bocado a la fuerza."
    narrador "The girl clenched her teeth and forced down her last bite."

# game/01_prologo.rpy:412
translate english prologo_930d5600:

    # narrador "Después se levantó en silencio."
    narrador "Then she stood up in silence."

# game/01_prologo.rpy:414
translate english prologo_c58a502e:

    # itsuki_inicio "Está bien. No te necesito."
    itsuki_inicio "Fine. I do not need you."

# game/01_prologo.rpy:416
translate english prologo_92327a49:

    # itsuki_inicio "Ingenuamente pensé que el mejor alumno de la clase sería alguien más amable."
    itsuki_inicio "I naively thought the best student in the class would be someone kinder."

# game/01_prologo.rpy:418
translate english prologo_5fe51928:

    # itsuki_inicio "Pero solo demostraste ser una persona arrogante y carente de empatía."
    itsuki_inicio "But all you've proven is that you're an arrogant person with no empathy."

# game/01_prologo.rpy:424
translate english prologo_6123d893:

    # narrador "Recogió sus cosas rápidamente y abandonó el aula sin ocultar su indignación."
    narrador "She gathered her things and stormed out, making no effort to hide her indignation."

# game/01_prologo.rpy:426
translate english prologo_6cd18920:

    # mc_pensamiento "..."
    mc_pensamiento "..."

# game/01_prologo.rpy:428
translate english prologo_bef22048:

    # mc_pensamiento "Tal vez fui un poco duro..."
    mc_pensamiento "Maybe I was a little harsh..."

# game/01_prologo.rpy:430
translate english prologo_22b466e3:

    # mc_pensamiento "Sin embargo..."
    mc_pensamiento "Still..."

# game/01_prologo.rpy:432
translate english prologo_4da989d0:

    # mc_pensamiento "Enseñar a otros no viene en el examen final."
    mc_pensamiento "Teaching others isn't on the final exam."

# game/01_prologo.rpy:434
translate english prologo_2bef1c7d:

    # mc_pensamiento "No gano nada haciéndolo gratis."
    mc_pensamiento "I gain nothing from doing it for free."

# game/01_prologo.rpy:446
translate english prologo_1f9007ed:

    # narrador "Cuando por fin terminaron las clases, subí a la azotea a despejarme un poco."
    narrador "When classes finally ended, I went up to the rooftop to clear my head."

# game/01_prologo.rpy:448
translate english prologo_5a45c005:

    # mc_pensamiento "No quería admitirlo."
    mc_pensamiento "I didn't want to admit it."

# game/01_prologo.rpy:450
translate english prologo_fc1100d8:

    # mc_pensamiento "Pero haber sido tan tajante con la chica nueva me dejó un mal sabor de boca el resto del día."
    mc_pensamiento "But being so blunt with the new girl left a bad taste in my mouth for the rest of the day."

# game/01_prologo.rpy:452
translate english prologo_9b59f880:

    # narrador "Mientras reflexionaba, mi momento de tranquilidad duró poco."
    narrador "My moment of peace didn't last long."

# game/01_prologo.rpy:454
translate english prologo_b8ee38f9:

    # narrador "Apenas diez minutos después, la puerta de la azotea se abrió."
    narrador "Barely ten minutes later, the rooftop door opened."

# game/01_prologo.rpy:459
translate english prologo_abbe121d_1:

    # itsuki_inicio "..."
    itsuki_inicio "..."

# game/01_prologo.rpy:461
translate english prologo_2b35b6fe:

    # mc "..."
    mc "..."

# game/01_prologo.rpy:463
translate english prologo_34153bb4:

    # itsuki_inicio "¿Otra vez tú?"
    itsuki_inicio "You again?"

# game/01_prologo.rpy:468
translate english prologo_0ff65e5e:

    # itsuki_inicio "Ni se te ocurra pensar que te vine a buscar."
    itsuki_inicio "Don't you dare think I came looking for you."

# game/01_prologo.rpy:470
translate english prologo_1edce0f6:

    # itsuki_inicio "Ni siquiera sabía que estabas aquí."
    itsuki_inicio "I didn't even know you were here."

# game/01_prologo.rpy:472
translate english prologo_b6cf1c7e:

    # mc "Tranquila, no me creo tan importante."
    mc "Relax, I don't think I'm that important."

# game/01_prologo.rpy:474
translate english prologo_0fcadc1e:

    # mc "Aunque parece que hoy no me sale una bien."
    mc "Though it seems I can't get anything right today."

# game/01_prologo.rpy:476
translate english prologo_ba965039:

    # itsuki_inicio "Si tanto te molesta cruzarte conmigo, puedes irte."
    itsuki_inicio "If running into me bothers you so much, you can leave."

# game/01_prologo.rpy:478
translate english prologo_80d4c323:

    # itsuki_inicio "Yo solo vine a tomar aire... y a alejarme de gente desagradable."
    itsuki_inicio "I only came up for some air... and to get away from unpleasant people."

# game/01_prologo.rpy:480
translate english prologo_8fa165d6:

    # mc_pensamiento "Perfecto. La azotea acaba de volverse el lugar más tenso del instituto."
    mc_pensamiento "Perfect. The rooftop just became the tensest place in the whole school."

# game/01_prologo.rpy:482
translate english prologo_0d78195c:

    # mc_pensamiento "(Esto se está volviendo ridículamente incómodo...)"
    mc_pensamiento "(This is getting ridiculously awkward...)"

# game/01_prologo.rpy:487
translate english prologo_da840b62:

    # mc_pensamiento "Uno de los dos va a tener que romper esto. O ninguno." nointeract
    mc_pensamiento "One of us is going to have to break this. Or neither." nointeract

# game/01_prologo.rpy:491
translate english prologo_ecff0fe7:

    # narrador "Saqué mis apuntes de la mochila y dejé que el silencio hiciera su trabajo."
    narrador "I took my notes out of my bag and let the silence do its work."

# game/01_prologo.rpy:496
translate english prologo_5e8dcb77:

    # itsuki_inicio "...¿En serio vas a seguir estudiando incluso al terminar las clases?"
    itsuki_inicio "...Are you seriously going to keep studying even after school's over?"

# game/01_prologo.rpy:498
translate english prologo_d8df815f:

    # mc "El temario del próximo examen no se va a repasar solo."
    mc "The material for the next exam won't review itself."

# game/01_prologo.rpy:500
translate english prologo_7fc02c75:

    # itsuki_inicio "Qué persona tan agotadora."
    itsuki_inicio "What an exhausting person."

# game/01_prologo.rpy:502
translate english prologo_1cc94e4d:

    # mc "Me lo dicen bastante."
    mc "I get told that a lot."

# game/01_prologo.rpy:504
translate english prologo_0be6c983:

    # itsuki_inicio "No me extraña en lo absoluto."
    itsuki_inicio "That does not surprise me in the least."

# game/01_prologo.rpy:508
translate english prologo_1f1b7f22:

    # narrador "La chica dejó escapar un pequeño suspiro y se cruzó de brazos, mirando al horizonte."
    narrador "The girl let out a small sigh and crossed her arms, staring at the horizon."

# game/01_prologo.rpy:513
translate english prologo_6cf753ba:

    # mc "Si te sirve de algo, no fui desagradable por gusto. Solo soy celoso de mi tiempo."
    mc "For what it's worth, I wasn't unpleasant for fun. I'm just protective of my time."

# game/01_prologo.rpy:515
translate english prologo_b70415b5:

    # itsuki_inicio "Eso no quita que hayas sido un grosero."
    itsuki_inicio "That doesn't change the fact that you were rude."

# game/01_prologo.rpy:517
translate english prologo_88db5e8a:

    # mc "Tal vez, pero es la verdad."
    mc "Maybe, but it's the truth."

# game/01_prologo.rpy:519
translate english prologo_abbe121d_2:

    # itsuki_inicio "..."
    itsuki_inicio "..."

# game/01_prologo.rpy:521
translate english prologo_82728a80:

    # itsuki_inicio "Al menos eres honesto..."
    itsuki_inicio "At least you're honest..."

# game/01_prologo.rpy:523
translate english prologo_1545626a:

    # mc "Fingir cortesía sería un gasto innecesario de energía."
    mc "Faking politeness would be a waste of energy."

# game/01_prologo.rpy:529
translate english prologo_5b1ff7e5:

    # mc_pensamiento "Permanecimos en silencio con la luz del atardecer, cada uno en un extremo del banco."
    mc_pensamiento "We sat in silence in the evening light, each at one end of the bench."

# game/01_prologo.rpy:531
translate english prologo_c899e238:

    # mc_pensamiento "Como dos países que firman una tregua sin reconocerse."
    mc_pensamiento "Like two countries signing a truce without recognizing each other."

# game/01_prologo.rpy:533
translate english prologo_9f8c92d7:

    # mc_pensamiento "Ella sabía mi nombre por el profesor."
    mc_pensamiento "She knew my name from the teacher."

# game/01_prologo.rpy:535
translate english prologo_3c5f8e87:

    # mc_pensamiento "Yo no sabía el suyo, y no lo pregunté."
    mc_pensamiento "I didn't know hers, and I didn't ask."

# game/01_prologo.rpy:542
translate english prologo_fd72bb7e:

    # narrador "Yo no sospechaba lo mucho que aquello terminaría importando."
    narrador "I had no idea how much that would end up mattering."

# game/01_prologo.rpy:548
translate english prologo_dc0e498a:

    # narrador "Al bajar de la azotea y recoger mi mochila, revisé el teléfono."
    narrador "After leaving the rooftop and grabbing my bag, I checked my phone."

# game/01_prologo.rpy:550
translate english prologo_e900e8e9:

    # mc_pensamiento "Tenía un mensaje de mi padre con una dirección y una instrucción clara:"
    mc_pensamiento "There was a message from my father with an address and a clear instruction:"

# game/01_prologo.rpy:552
translate english prologo_1b018e9d:

    # narrador "'Ve hoy al salir de clases. Saluda a Maruo de mi parte. Y no pongas esa cara'."
    narrador "'Go this afternoon, after class. Say hi to Maruo for me. And don't make that face.'"

# game/01_prologo.rpy:554
translate english prologo_7396299d:

    # mc_pensamiento "Acepté el trabajo sin dudarlo, pero no imaginaba a dónde me mandaba."
    mc_pensamiento "I'd accepted the job without hesitation, but I had no idea where he was sending me."

# game/01_prologo.rpy:561
translate english prologo_d57e9f97:

    # narrador "La dirección que me dio correspondía a un edificio que solo había visto de lejos."
    narrador "The address he gave me belonged to a building I'd only ever seen from a distance."

# game/01_prologo.rpy:563
translate english prologo_9672073d:

    # mc_pensamiento "El tipo de zona donde la gente no mira los precios."
    mc_pensamiento "The kind of neighborhood where people don't look at prices."

# game/01_prologo.rpy:565
translate english prologo_d3a5c601:

    # mc_pensamiento "Y donde el conserje te mide de arriba abajo solo por pasar cerca."
    mc_pensamiento "And where the doorman sizes you up from head to toe just for walking past."

# game/01_prologo.rpy:567
translate english prologo_4a0bb473:

    # mc_pensamiento "(Bien... pongamos orden a esto antes de tocar la puerta)."
    mc_pensamiento "(Okay... let's get this organized before I knock on the door.)"

# game/01_prologo.rpy:572
translate english prologo_a0701383:

    # mc_pensamiento "Un alumno. Nivel probablemente bajo."
    mc_pensamiento "One student. Level probably low."

# game/01_prologo.rpy:574
translate english prologo_ff4fe0fd:

    # mc_pensamiento "Priorizar las materias con más peso para el examen."
    mc_pensamiento "Prioritize the subjects with the most weight on the exam."

# game/01_prologo.rpy:576
translate english prologo_a271e662:

    # mc_pensamiento "Tres meses para estabilizar hábitos. Seis para ver resultados reales."
    mc_pensamiento "Three months to settle habits. Six to see real results."

# game/01_prologo.rpy:578
translate english prologo_4339ef5c:

    # mc_pensamiento "Nada que no haya resuelto antes en papel."
    mc_pensamiento "Nothing I haven't already solved on paper."

# game/01_prologo.rpy:580
translate english prologo_21ee2fc7:

    # narrador "Es curioso lo tranquilo que uno puede estar cuando no sabe a lo que se enfrenta."
    narrador "It's funny how calm you can be when you don't know what you're up against."

# game/01_prologo.rpy:582
translate english prologo_c8e620b7:

    # mc_pensamiento "Piso alto. Puerta doble de madera fina. El tipo de lugar que impone silencio solo con verlo."
    mc_pensamiento "High floor. Double door of thin wood. The kind of place that demands silence at a glance."

# game/01_prologo.rpy:586
translate english prologo_4d64b739:

    # narrador "Toqué la puerta con cuidado y, tras unos segundos, escuché una voz desde dentro."
    narrador "I knocked carefully and, after a few seconds, heard a voice from inside."

# game/01_prologo.rpy:588
translate english prologo_b83176d3:

    # voz "—¡Adelante! Puedes pasar."
    voz "—Come in! Go right ahead."

# game/01_prologo.rpy:597
translate english prologo_eba06ebe:

    # mc_pensamiento "Muy bien... empecemos."
    mc_pensamiento "All right... let's begin."

# game/01_prologo.rpy:599
translate english prologo_e60421db:

    # mc_pensamiento "Cero distracciones. Presentación, evaluación rápida y horario. Diez minutos máximo."
    mc_pensamiento "Zero distractions. Introduction, quick assessment, schedule. Ten minutes, tops."

# game/01_prologo.rpy:603
translate english prologo_97e28a16:

    # narrador "Apenas puse la mano sobre el pomo, la puerta se abrió desde el otro lado..."
    narrador "The moment I put my hand on the knob, the door opened from the other side..."

# game/01_prologo.rpy:616
translate english prologo_e442f589:

    # narrador "Apareció una chica de sonrisa fácil."
    narrador "A girl with an easy smile appeared."

# game/01_prologo.rpy:618
translate english prologo_ee280c4b:

    # narrador "Sostenía la perilla como si llevara un buen rato esperando al otro lado."
    narrador "She held the knob as if she'd been waiting on the other side for a good while."

# game/01_prologo.rpy:622
translate english prologo_58a7993f:

    # ichika "¡Ah! Tú debes ser el nuevo tutor. Pasa, pasa."
    ichika "Ah! You must be the new tutor. Come in, come in."

# game/01_prologo.rpy:624
translate english prologo_cc1642b9:

    # mc "[mc]. Vengo por el empleo."
    mc "[mc]. I'm here about the job."

# game/01_prologo.rpy:626
translate english prologo_c7927050:

    # ichika "Ichika. La mayor... aunque entre nosotras eso no sirva de mucho."
    ichika "Ichika. The eldest... though among us that doesn't count for much."

# game/01_prologo.rpy:628
translate english prologo_1d838d89:

    # mc_pensamiento "¿La mayor?"
    mc_pensamiento "The eldest?"

# game/01_prologo.rpy:630
translate english prologo_52d48da4:

    # ichika "Una disculpa por adelantado por el desorden. Y por el ruido."
    ichika "Sorry in advance for the mess. And the noise."

# game/01_prologo.rpy:632
translate english prologo_1f9186ae:

    # ichika "Bueno, mejor dicho, por todo lo que vas a ver en los próximos minutos."
    ichika "Actually, make that sorry for everything you're about to see in the next few minutes."

# game/01_prologo.rpy:634
translate english prologo_db92eae3:

    # mc "Esa clase de advertencias suelen ser de todo menos tranquilizadoras."
    mc "That kind of warning never reassures anyone."

# game/01_prologo.rpy:636
translate english prologo_ae1a897f:

    # ichika "Tranquilo, entra, no mordemos... bueno, al menos la mayoría de nosotras no."
    ichika "Relax, come in, we don't bite... well, at least most of us don't."

# game/01_prologo.rpy:638
translate english prologo_4ef3769e:

    # narrador "Entré. El pasillo era más largo de lo que esperaba."
    narrador "I went in. The hallway was longer than I expected."

# game/01_prologo.rpy:640
translate english prologo_c71a2aa8:

    # narrador "Y no estaba desierto."
    narrador "And it wasn't empty."

# game/01_prologo.rpy:647
translate english prologo_6d1204cd:

    # nino "Ichika. ¿A quién diablos le abriste la puerta?"
    nino "Ichika. Who the heck did you just open the door for?"

# game/01_prologo.rpy:649
translate english prologo_dfb241f3:

    # ichika "Al tutor, Nino. Ya te lo había avisado hoy en la mañana."
    ichika "The tutor, Nino. I already told you this morning."

# game/01_prologo.rpy:651
translate english prologo_73b8a5bd:

    # nino "Y yo te dije que era una pérdida de tiempo."
    nino "And I told you it was a waste of time."

# game/01_prologo.rpy:653
translate english prologo_967e457e:

    # narrador "Solo entonces desvió su mirada hacia mí, evaluándome de pies a cabeza con desdén."
    narrador "Only then did she turn her gaze to me, sizing me up from head to toe with disdain."

# game/01_prologo.rpy:655
translate english prologo_4559de87:

    # nino "No vas a durar ni una semana."
    nino "You won't last a week."

# game/01_prologo.rpy:657
translate english prologo_00146479:

    # mc "Tampoco es que me hayas dado la oportunidad de presentarme..."
    mc "You haven't exactly given me the chance to introduce myself..."

# game/01_prologo.rpy:659
translate english prologo_47846701:

    # mc "Nino, ¿cierto?"
    mc "Nino, right?"

# game/01_prologo.rpy:661
translate english prologo_6ac18f54:

    # nino "A ti no te importa cómo me llamo. Vete."
    nino "My name is none of your business. Get out."

# game/01_prologo.rpy:663
translate english prologo_7e1447b6:

    # mc "¿Cuántos tutores han pasado antes que yo?"
    mc "How many tutors have come before me?"

# game/01_prologo.rpy:665
translate english prologo_990d8e81:

    # nino "Los suficientes como para saber cómo termina esto."
    nino "Enough to know how this ends."

# game/01_prologo.rpy:670
translate english prologo_fc1c9ec8:

    # mc_pensamiento "Gemelas, entonces. Bien... eso explica el sueldo ridículamente alto."
    mc_pensamiento "Twins, then. Fine... that explains the absurdly high pay."

# game/01_prologo.rpy:672
translate english prologo_8578e8de:

    # mc_pensamiento "...O tal vez no."
    mc_pensamiento "...Or maybe not."

# game/01_prologo.rpy:679
translate english prologo_360f4a62:

    # narrador "En el sofá, una tercera chica —la misma cara, otra vez— leía con los audífonos colgando del cuello."
    narrador "On the couch, a third girl—same face, again—was reading with her headphones hanging around her neck."

# game/01_prologo.rpy:681
translate english prologo_ea253e4e:

    # mc_pensamiento "Tres. Son tres."
    mc_pensamiento "Three. That's three."

# game/01_prologo.rpy:683
translate english prologo_bce7a67b:

    # mc_pensamiento "Si esto sigue así, voy a empezar a pensar que tengo un problema en la vista..."
    mc_pensamiento "If this keeps up, I'm going to start thinking something's wrong with my eyes..."

# game/01_prologo.rpy:685
translate english prologo_5656e54e:

    # mc_pensamiento "...o que mi padre me metió en un psiquiátrico."
    mc_pensamiento "...or that my father checked me into a psych ward."

# game/01_prologo.rpy:687
translate english prologo_16d2a51b:

    # narrador "Me acerqué un poco, intentando averiguar con quién diablos se supone que debía hablar."
    narrador "I stepped a little closer, trying to work out who on earth I was supposed to talk to."

# game/01_prologo.rpy:689
translate english prologo_02994377:

    # mc "¿Tú también eres...?"
    mc "Are you also...?"

# game/01_prologo.rpy:691
translate english prologo_b0b79945:

    # narrador "Levantó la vista antes de que terminara la pregunta."
    narrador "She looked up before I finished the question."

# game/01_prologo.rpy:693
translate english prologo_3b0eebb3:

    # narrador "No con molestia: con la cautela de quien preferiría no haber sido vista."
    narrador "Not annoyed: wary, like someone who'd rather not have been seen."

# game/01_prologo.rpy:695
translate english prologo_bf6c6bd4:

    # narrador "Cerró el libro contra el pecho, como si lo hubiera atrapado leyendo algo que no debía."
    narrador "She pressed the book to her chest, as if I'd caught her reading something she shouldn't."

# game/01_prologo.rpy:697
translate english prologo_509e941c:

    # miku "...Miku."
    miku "...Miku."

# game/01_prologo.rpy:699
translate english prologo_8f02e081:

    # narrador "Nada más. Volvió a bajar la mirada, aunque el libro siguió cerrado un rato largo."
    narrador "Nothing more. She lowered her eyes again, though the book stayed closed for a long while."

# game/01_prologo.rpy:701
translate english prologo_0d7c3af1:

    # narrador "Alcancé a leer el título antes de que lo apartara de su vista."
    narrador "I managed to read the title before she moved it out of my sight."

# game/01_prologo.rpy:703
translate english prologo_6cc78629:

    # narrador "Trataba sobre estrategas del período Sengoku."
    narrador "It was about strategists of the Sengoku period."

# game/01_prologo.rpy:705
translate english prologo_ee57cd37:

    # mc "¿Sengoku? Eso son samuráis y duelos, ¿no?"
    mc "Sengoku? That's samurai and duels, right?"

# game/01_prologo.rpy:707
translate english prologo_01b2dba5:

    # miku "...No. Es logística."
    miku "...No. It's logistics."

# game/01_prologo.rpy:709
translate english prologo_a592dad1:

    # narrador "Lo dijo sin levantar la vista, pero sin pensarlo."
    narrador "She said it without looking up, but without having to think."

# game/01_prologo.rpy:711
translate english prologo_ba5a0e30:

    # narrador "Como si la respuesta llevara horas esperando su turno."
    narrador "As if the answer had been waiting its turn for hours."

# game/01_prologo.rpy:713
translate english prologo_3735cb33:

    # miku "Las batallas las gana quien mueve el arroz. No quien mueve la espada."
    miku "Battles are won by whoever moves the rice. Not whoever moves the sword."

# game/01_prologo.rpy:715
