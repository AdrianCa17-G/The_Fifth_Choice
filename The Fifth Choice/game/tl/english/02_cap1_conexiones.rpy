translate english reaccion_nino_4c297fe7:

    # mc "Ni siquiera dije nada."
    mc "I didn't even say anything."

# game/02_cap1_conexiones.rpy:228
translate english reaccion_nino_7dc78043:

    # nino "Ya, pero ibas a decirlo."
    nino "Yeah, but you were going to."

# game/02_cap1_conexiones.rpy:230
translate english reaccion_nino_5dcc4830:

    # nino "«Yo sí voy a durar.»"
    nino "\"I'm going to last.\""

# game/02_cap1_conexiones.rpy:232
translate english reaccion_nino_ef62825c:

    # nino "Qué gracioso."
    nino "How funny."

# game/02_cap1_conexiones.rpy:234
translate english reaccion_nino_5d7dac6c:

