translate english reaccion_miku_2b37e937:

    # miku "Como dijiste."
    miku "Like you said."

# game/02_cap1_conexiones.rpy:348
translate english reaccion_miku_62dc8e3a:

    # narrador "No hubo reproche."
    narrador "There was no reproach."

# game/02_cap1_conexiones.rpy:350
translate english reaccion_miku_703b612e:

    # narrador "Eso fue lo peor: lo dijo como quien acepta un reglamento."
    narrador "That was the worst part: she said it like someone accepting a rulebook."

# game/02_cap1_conexiones.rpy:371
translate english reaccion_yotsuba_7167a37b:

    # yotsuba "¡Buenos días, [mc]!"
    yotsuba "Good morning, [mc]!"

# game/02_cap1_conexiones.rpy:373
translate english reaccion_yotsuba_8b9276d7:

    # yotsuba "¡Hoy correré menos de treinta vueltas!"
    yotsuba "Today I'm running fewer than thirty laps!"

# game/02_cap1_conexiones.rpy:375
translate english reaccion_yotsuba_0230b34f:

    # mc "¿Cuántas?"
    mc "How many?"

# game/02_cap1_conexiones.rpy:377
translate english reaccion_yotsuba_e9280c10:

    # yotsuba "¡Veinticinco! ¡Es un número perfecto!"
    yotsuba "Twenty-five! It's a perfect number!"

# game/02_cap1_conexiones.rpy:379
translate english reaccion_yotsuba_99bb57a4:

    # mc "No lo es."
    mc "It isn't."

# game/02_cap1_conexiones.rpy:381
translate english reaccion_yotsuba_8e91fd32:

    # yotsuba "¡Para mí sí!"
    yotsuba "It is for me!"

# game/02_cap1_conexiones.rpy:386
translate english reaccion_yotsuba_9008b83a:

    # yotsuba "...Ayer dijiste que mi punto de partida no era cero."
    yotsuba "...Yesterday you said my starting point wasn't zero."

# game/02_cap1_conexiones.rpy:388
translate english reaccion_yotsuba_25549f71:

    # yotsuba "Anoche no pude dejar de pensarlo."
    yotsuba "I couldn't stop thinking about it last night."

# game/02_cap1_conexiones.rpy:390
translate english reaccion_yotsuba_90e5a41f:

    # yotsuba "Nadie me había dicho algo así sin pedirme que sonriera."
    yotsuba "Nobody ever said something like that to me without asking me to smile."

# game/02_cap1_conexiones.rpy:395
translate english reaccion_yotsuba_b945681a:

    # yotsuba "Bueno."
    yotsuba "Okay."

# game/02_cap1_conexiones.rpy:397
translate english reaccion_yotsuba_7941c26e:

    # yotsuba "¡Dame la mano!"
    yotsuba "Give me your hand!"

# game/02_cap1_conexiones.rpy:399
translate english reaccion_yotsuba_4d64f53a:

    # narrador "Sacó el rotulador y escribió en mi muñeca antes de que pudiera decir que no."
    narrador "She pulled out her marker and wrote on my wrist before I could say no."

# game/02_cap1_conexiones.rpy:401
translate english reaccion_yotsuba_96f675a2:

    # yotsuba "¡Listo! ¡Ahora tú también llevas la cuenta!"
    yotsuba "Done! Now you're keeping count too!"

# game/02_cap1_conexiones.rpy:403
translate english reaccion_yotsuba_dff792f7:

    # mc_pensamiento "Decía «1». Con un corazón torcido al lado."
    mc_pensamiento "It said \"1.\" With a crooked heart next to it."

# game/02_cap1_conexiones.rpy:408
translate english reaccion_yotsuba_dec8ae13:

    # yotsuba "¡No es un corazón! ¡Es... una vuelta!"
    yotsuba "It's not a heart! It's... a lap!"

# game/02_cap1_conexiones.rpy:418
translate english reaccion_yotsuba_c62e3e9f:

    # yotsuba "¡Mira! ¡Un minuto con catorce!"
    yotsuba "Look! One minute fourteen!"

# game/02_cap1_conexiones.rpy:420
translate english reaccion_yotsuba_bc2da795:

    # narrador "Levantó el brazo: lo había anotado en la muñeca con rotulador, otra vez."
    narrador "She held up her arm: she'd written it on her wrist in marker again."

# game/02_cap1_conexiones.rpy:422
translate english reaccion_yotsuba_f52b9d46:

    # mc "Tienes que dejar de escribirte en el brazo."
    mc "You have to stop writing on your arm."

# game/02_cap1_conexiones.rpy:424
translate english reaccion_yotsuba_be9eeb7e:

    # yotsuba "¡Es mi cuaderno oficial!"
    yotsuba "It's my official notebook!"

# game/02_cap1_conexiones.rpy:434
translate english reaccion_yotsuba_63518038:

    # yotsuba "¡Buenos días, tutor!"
    yotsuba "Good morning, tutor!"

# game/02_cap1_conexiones.rpy:436
translate english reaccion_yotsuba_43adb64d:

    # yotsuba "¡Hoy voy a concentrarme en correr!"
    yotsuba "Today I'm going to focus on running!"

# game/02_cap1_conexiones.rpy:438
translate english reaccion_yotsuba_61218af2:

    # narrador "Me llamó «tutor» con el tono que se usa con un desconocido."
    narrador "She called me \"tutor\" in the tone you use with a stranger."

# game/02_cap1_conexiones.rpy:440
translate english reaccion_yotsuba_d6f8cb83:

    # mc "Yotsuba, ayer yo..."
    mc "Yotsuba, yesterday I..."

# game/02_cap1_conexiones.rpy:445
translate english reaccion_yotsuba_739d4288:

    # yotsuba "¡Tenías razón! ¡Correr es lo mío!"
    yotsuba "You were right! Running is my thing!"

# game/02_cap1_conexiones.rpy:447
translate english reaccion_yotsuba_ecc4d136:

    # yotsuba "...Hoy serán cuarenta vueltas. ¡Cuarenta!"
    yotsuba "...Today it'll be forty laps. Forty!"

# game/02_cap1_conexiones.rpy:452
translate english reaccion_yotsuba_5a70587c:

    # narrador "Lo anotó en la muñeca. No me miró mientras lo hacía."
    narrador "She wrote it on her wrist. She didn't look at me while she did."

# game/02_cap1_conexiones.rpy:474
