    # narrador "Entró con los audífonos puestos y sonando."
    narrador "She walked in with her headphones on and playing."

# game/02_cap1_conexiones.rpy:336
translate english reaccion_miku_866f482e:

    # mc "Buenos días, Miku."
    mc "Good morning, Miku."

