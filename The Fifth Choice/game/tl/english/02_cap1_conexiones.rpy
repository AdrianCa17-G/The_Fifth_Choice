translate english reaccion_nino_98e28bbe:

    # narrador "Pasó a mi lado sin rozarme. Ni siquiera con el hombro."
    narrador "She walked past me without touching me. Not even with a shoulder."

# game/02_cap1_conexiones.rpy:262
