    # nino "¡No! Es que si te desmayas, nos echan la culpa."
    nino "No! If you pass out, we'll get the blame."

# game/02_cap1_conexiones.rpy:185
translate english reaccion_nino_89485906:

    # nino "...Anoche pensé en lo que dijiste."
    nino "...I thought about what you said last night."

# game/02_cap1_conexiones.rpy:187
translate english reaccion_nino_1b535985:

    # nino "Que no ibas a prometer nada."
    nino "That you weren't going to promise anything."

# game/02_cap1_conexiones.rpy:189
translate english reaccion_nino_b00fe854:

    # nino "Nadie me había hablado así. Sin intentar caerme bien."
    nino "Nobody's ever talked to me like that. Without trying to get me to like them."

# game/02_cap1_conexiones.rpy:194
translate english reaccion_nino_28d3c23e:

    # nino "Eso no significa que confíe en ti."
    nino "That doesn't mean I trust you."

# game/02_cap1_conexiones.rpy:196
translate english reaccion_nino_de77e27c:

    # nino "No te hagas ideas."
    nino "Don't get any ideas."

# game/02_cap1_conexiones.rpy:201
translate english reaccion_nino_a3a7fc07:

    # narrador "Se fue rápido. Pero esta vez se le olvidó cruzar los brazos."
    narrador "She left quickly. But this time she forgot to cross her arms."

# game/02_cap1_conexiones.rpy:208
translate english reaccion_nino_b878b08a:

    # nino "Lo que pasó sigue sin significar nada."
    nino "What happened still doesn't mean anything."

# game/02_cap1_conexiones.rpy:210
translate english reaccion_nino_e4922f61:

    # mc "No dije que significara algo."
    mc "I never said it did."

# game/02_cap1_conexiones.rpy:212
translate english reaccion_nino_9322a745:

    # nino "Y que quede así."
    nino "And let's keep it that way."

# game/02_cap1_conexiones.rpy:217
translate english reaccion_nino_23d17817:

    # narrador "Pero se tomó la molestia de buscarme solo para decirlo."
    narrador "But she'd gone out of her way to find me just to say it."

# game/02_cap1_conexiones.rpy:224
translate english reaccion_nino_69b551eb:

