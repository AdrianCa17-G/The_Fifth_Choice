    # narrador "Lo dijo con el libro a media cara."
    narrador "She said it with her book covering half her face."

# game/02_cap1_conexiones.rpy:325
translate english reaccion_miku_79453dac:

    # mc "Buenos días."
    mc "Good morning."

# game/02_cap1_conexiones.rpy:327
