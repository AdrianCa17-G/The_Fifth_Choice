    # itsuki "...Buenos días."
    itsuki "...Good morning."

# game/02_cap1_conexiones.rpy:476
translate english reaccion_itsuki_79453dac:

    # mc "Buenos días."
    mc "Good morning."

# game/02_cap1_conexiones.rpy:478
translate english reaccion_itsuki_46deb8d1:

    # itsuki "Ayer me viste equivocarme. No va a ser costumbre."
    itsuki "You saw me get it wrong yesterday. It won't become a habit."

# game/02_cap1_conexiones.rpy:480
translate english reaccion_itsuki_0144c226:

    # itsuki "Corrijo rápido. Es lo único que se me da bien."
    itsuki "I correct fast. It's the one thing I'm good at."

# game/02_cap1_conexiones.rpy:482
translate english reaccion_itsuki_7283e3a0:

    # mc "No es lo único."
    mc "It's not the only thing."

# game/02_cap1_conexiones.rpy:487
translate english reaccion_itsuki_04658f07:

    # itsuki "...No digas cosas así. Sin avisar."
    itsuki "...Don't say things like that. Without warning."

# game/02_cap1_conexiones.rpy:489
translate english reaccion_itsuki_cab5bbc2:

    # narrador "Se quedó callada un momento, con la mano sobre el cuaderno."
    narrador "She was quiet for a moment, one hand on her notebook."

# game/02_cap1_conexiones.rpy:491
translate english reaccion_itsuki_90f131cd:

    # itsuki "Anoche rehice el ejercicio."
    itsuki "Last night I redid the exercise."

# game/02_cap1_conexiones.rpy:493
translate english reaccion_itsuki_d4b90035:

    # itsuki "Desde el principio. Sin mirar la corrección."
    itsuki "From the beginning. Without looking at the correction."

# game/02_cap1_conexiones.rpy:495
translate english reaccion_itsuki_5c602d0c:

    # mc "¿Y?"
    mc "And?"

# game/02_cap1_conexiones.rpy:497
translate english reaccion_itsuki_e5d201ee:

    # itsuki "...Salió bien."
    itsuki "...It came out right."

# game/02_cap1_conexiones.rpy:499
translate english reaccion_itsuki_9612f0ba:

    # itsuki "Lo logré sola. Del todo."
    itsuki "I did it myself. All of it."

# game/02_cap1_conexiones.rpy:504
translate english reaccion_itsuki_0754b2f7:

    # itsuki "No te lo cuento para que me felicites."
    itsuki "I'm not telling you so you'll congratulate me."

# game/02_cap1_conexiones.rpy:506
translate english reaccion_itsuki_bb696691:

    # mc "No iba a felicitarte."
    mc "I wasn't going to congratulate you."

# game/02_cap1_conexiones.rpy:508
translate english reaccion_itsuki_3739e1bc:

    # itsuki "Bien. Porque solo era una conversión."
    itsuki "Good. Because it was only a conversion."

# game/02_cap1_conexiones.rpy:510
translate english reaccion_itsuki_f61eb085:

    # mc "Era un error que llevabas tres intentos arrastrando."
    mc "It was a mistake you'd been dragging along for three attempts."

# game/02_cap1_conexiones.rpy:512
translate english reaccion_itsuki_8d527c6b:

    # itsuki "...Lo sé."
    itsuki "...I know."

# game/02_cap1_conexiones.rpy:517
translate english reaccion_itsuki_f4c2e2eb:

    # narrador "No me miró. Pero tampoco giró la silla hacia la ventana."
    narrador "She didn't look at me. But she didn't turn her chair toward the window either."

# game/02_cap1_conexiones.rpy:519
translate english reaccion_itsuki_f715f641:

    # mc_pensamiento "Para ella, decirme que lo había hecho sola ya era una forma de darme las gracias."
    mc_pensamiento "For her, telling me she'd done it alone was already a way of thanking me."

# game/02_cap1_conexiones.rpy:526
translate english reaccion_itsuki_896713de:

    # itsuki "Sigo sin necesitar tu ayuda."
    itsuki "I still don't need your help."

# game/02_cap1_conexiones.rpy:528
translate english reaccion_itsuki_13e90643:

    # mc "No ofrecí ninguna."
    mc "I didn't offer any."

# game/02_cap1_conexiones.rpy:530
translate english reaccion_itsuki_6630a0c8:

    # itsuki "Lo estabas pensando."
    itsuki "You were thinking it."

# game/02_cap1_conexiones.rpy:532
translate english reaccion_itsuki_6e25c3d3:

    # mc "¿Cómo lo sabes?"
    mc "How do you know?"

# game/02_cap1_conexiones.rpy:534
translate english reaccion_itsuki_331e89d5:

    # itsuki "Porque te quedaste mirando mi cuaderno más tiempo del necesario."
    itsuki "Because you stared at my notebook longer than necessary."

# game/02_cap1_conexiones.rpy:536
translate english reaccion_itsuki_4ca2764c:

    # itsuki "Tienes la costumbre de mirar como si fueras a corregir."
    itsuki "You have a habit of looking as though you're about to correct something."

# game/02_cap1_conexiones.rpy:538
translate english reaccion_itsuki_884f8aa9:

    # mc "Es mi trabajo."
    mc "It's my job."

# game/02_cap1_conexiones.rpy:540
translate english reaccion_itsuki_ef41d19e:

    # itsuki "Sí. Y es una costumbre desagradable."
    itsuki "Yes. And it's an unpleasant habit."

# game/02_cap1_conexiones.rpy:545
translate english reaccion_itsuki_78959eef:

    # itsuki "...Todavía."
    itsuki "...Yet."

# game/02_cap1_conexiones.rpy:547
translate english reaccion_itsuki_8ab797c7:

    # mc "¿Todavía qué?"
    mc "Yet what?"

# game/02_cap1_conexiones.rpy:549
translate english reaccion_itsuki_c84647c5:

    # itsuki "Todavía no necesito tu ayuda."
    itsuki "I don't need your help yet."

# game/02_cap1_conexiones.rpy:551
translate english reaccion_itsuki_d7f32e0a:

    # itsuki "Es una expresión. No es una promesa."
    itsuki "It's a figure of speech. Not a promise."

# game/02_cap1_conexiones.rpy:556
translate english reaccion_itsuki_252caefd:

    # itsuki "Y no me mires así."
    itsuki "And don't look at me like that."

# game/02_cap1_conexiones.rpy:561
translate english reaccion_itsuki_0fb63c15:

    # narrador "Cerró el cuaderno antes de que pudiera ver en qué línea se había quedado."
    narrador "She closed the notebook before I could see which line she'd stopped at."

# game/02_cap1_conexiones.rpy:568
translate english reaccion_itsuki_3e6ac25e:

    # narrador "Su mochila estaba sobre mi pupitre."
    narrador "Her backpack was on my desk."

# game/02_cap1_conexiones.rpy:570
translate english reaccion_itsuki_14a4c4a6:

    # narrador "Encima, el cuaderno de ciencias, abierto en la misma página de ayer."
    narrador "On top, the science notebook, open to the same page as yesterday."

# game/02_cap1_conexiones.rpy:572
translate english reaccion_itsuki_c684a409:

    # mc "Itsuki, ese es mi..."
    mc "Itsuki, that's my..."

# game/02_cap1_conexiones.rpy:574
translate english reaccion_itsuki_48ecc13f:

    # itsuki "Lo sé."
    itsuki "I know."

# game/02_cap1_conexiones.rpy:576
translate english reaccion_itsuki_8694a84c:

    # narrador "Mi solución seguía ahí, con una raya diagonal encima."
    narrador "My solution was still there, with a diagonal line through it."

# game/02_cap1_conexiones.rpy:578
translate english reaccion_itsuki_4c24b037:

    # narrador "Debajo, ella había rehecho el ejercicio entero, con su letra apretada."
    narrador "Underneath, she'd redone the whole exercise in her cramped handwriting."

# game/02_cap1_conexiones.rpy:580
translate english reaccion_itsuki_6f8a4a07:

    # mc "Lo rehiciste."
    mc "You redid it."

# game/02_cap1_conexiones.rpy:582
translate english reaccion_itsuki_99a54052:

    # itsuki "Anoche. Sola."
    itsuki "Last night. By myself."

# game/02_cap1_conexiones.rpy:584
translate english reaccion_itsuki_091f0e1a:

    # itsuki "Lo que hiciste ayer no cuenta. Quería que fuera mío."
    itsuki "What you did yesterday doesn't count. I wanted it to be mine."

# game/02_cap1_conexiones.rpy:586
translate english reaccion_itsuki_a40aaf0b:

    # mc "Itsuki..."
    mc "Itsuki..."

# game/02_cap1_conexiones.rpy:588
translate english reaccion_itsuki_51eb2b46:

    # itsuki "No me lo agradezcas ni me lo reproches."
    itsuki "Don't thank me for it, and don't blame me for it."

# game/02_cap1_conexiones.rpy:590
translate english reaccion_itsuki_9a3c3da7:

    # itsuki "No quiero ninguna de las dos cosas."
    itsuki "I don't want either one."

# game/02_cap1_conexiones.rpy:592
translate english reaccion_itsuki_6f741c06:

    # itsuki "Ya tengo lo que necesitaba de ti. Eso fue todo."
    itsuki "I already have what I needed from you. That's all."

# game/02_cap1_conexiones.rpy:597
translate english reaccion_itsuki_4b7bacb3:

    # narrador "Tuve que sentarme en el último pupitre."
    narrador "I had to sit at the last desk."

# game/02_cap1_conexiones.rpy:599
translate english reaccion_itsuki_899650e5:

    # mc_pensamiento "Le había quitado la respuesta."
    mc_pensamiento "I'd taken her answer away."

# game/02_cap1_conexiones.rpy:601
translate english reaccion_itsuki_f980a872:

    # mc_pensamiento "Ella me la devolvía a su manera: tachada."
    mc_pensamiento "She was handing it back in her own way: crossed out."

# game/02_cap1_conexiones.rpy:625
translate english queja_ichika_2d4cde37:

    # ichika "Oye, [mc]. Tengo una queja formal."
    ichika "Hey, [mc]. I have a formal complaint."

# game/02_cap1_conexiones.rpy:627
translate english queja_ichika_1ba3c8bf:

    # mc "Hola, Ichika. Te escucho."
    mc "Hi, Ichika. I'm listening."

# game/02_cap1_conexiones.rpy:629
translate english queja_ichika_9cdba6a6:

    # ichika "Tres tardes. Tres. Y ninguna fue mía."
    ichika "Three afternoons. Three. And none of them were mine."

# game/02_cap1_conexiones.rpy:631
translate english queja_ichika_bf104405:

    # mc "No me alcanzó el tiempo."
    mc "I ran out of time."

# game/02_cap1_conexiones.rpy:633
translate english queja_ichika_0592bec9:

    # ichika "Qué cruel. Me siento como la actriz que se quedó sin papel."
    ichika "How cruel. I feel like the actress who lost the part."

# game/02_cap1_conexiones.rpy:635
translate english queja_ichika_a7bc1729:

    # mc "Esto no es un casting, Ichika."
    mc "This isn't a casting call, Ichika."

# game/02_cap1_conexiones.rpy:637
translate english queja_ichika_67f469ee:

    # ichika "Todo es un casting, [mc]."
    ichika "Everything's a casting call, [mc]."

# game/02_cap1_conexiones.rpy:642
translate english queja_ichika_0e5472ed:

    # ichika "...Estaba tan segura de que me ibas a elegir que ni preparé plan B."
    ichika "...I was so sure you'd pick me I didn't even prepare a plan B."

# game/02_cap1_conexiones.rpy:644
translate english queja_ichika_d9c198c1:

    # ichika "Ensayé tres formas de reaccionar cuando me encontraras."
    ichika "I rehearsed three ways to react when you found me."

# game/02_cap1_conexiones.rpy:646
translate english queja_ichika_d25c4940:

    # ichika "Una graciosa, una dramática y una de «qué sorpresa, no te esperaba»."
    ichika "A funny one, a dramatic one, and a \"what a surprise, I wasn't expecting you\" one."

# game/02_cap1_conexiones.rpy:648
translate english queja_ichika_4f2d4319:

    # mc "¿Y cuál habrías usado?"
    mc "And which would you have used?"

# game/02_cap1_conexiones.rpy:650
translate english queja_ichika_d1fe1541:

    # ichika "...No lo sé."
    ichika "...I don't know."

# game/02_cap1_conexiones.rpy:652
translate english queja_ichika_e2784923:

    # ichika "Son todas actuación. Y no sé si habría podido con otra cosa."
    ichika "They're all acting. And I'm not sure I could have managed anything else."

# game/02_cap1_conexiones.rpy:654
translate english queja_ichika_7d4eacb1:

    # mc "Lo siento, Ichika."
    mc "I'm sorry, Ichika."

# game/02_cap1_conexiones.rpy:659
translate english queja_ichika_118f4d9e:

    # ichika "¡Ay, no! ¡No me pidas perdón, que me da vergüenza ajena!"
    ichika "Oh, no! Don't apologize, I'll die of secondhand embarrassment!"

# game/02_cap1_conexiones.rpy:661
translate english queja_ichika_e757a19d:

    # ichika "¡Era un chiste! ¡Soy una artista, siempre estoy espléndida!"
    ichika "It was a joke! I'm an artist, I'm always splendid!"

# game/02_cap1_conexiones.rpy:666
translate english queja_ichika_827a9b01:

    # ichika "...Pero la próxima vez, no tardes tanto."
    ichika "...But next time, don't take so long."

# game/02_cap1_conexiones.rpy:668
translate english queja_ichika_be468d92:

    # ichika "Estas cosas se agradecen. Aunque no lo parezca."
    ichika "These things are appreciated. Even if it doesn't look like it."

# game/02_cap1_conexiones.rpy:673
translate english queja_ichika_b5b953c9:

    # narrador "Se fue con la sonrisa puesta."
    narrador "She left with her smile still on."

# game/02_cap1_conexiones.rpy:675
translate english queja_ichika_9cf2eb82:

    # narrador "Se la vi acomodar por el pasillo, como quien se ajusta un disfraz."
    narrador "I watched her settle it into place down the hallway, like someone straightening a costume."

# game/02_cap1_conexiones.rpy:689
translate english queja_nino_1f721745:

    # nino "Ni creas que me molesta."
    nino "Don't think it bothers me."

# game/02_cap1_conexiones.rpy:691
translate english queja_nino_b2054ef5:

    # mc "No dije nada."
    mc "I didn't say anything."

# game/02_cap1_conexiones.rpy:693
translate english queja_nino_dae772dc:

    # nino "Ya, pero tenías cara de «a ella no la busqué»."
    nino "Yeah, but you had that \"I didn't go looking for her\" look on your face."

# game/02_cap1_conexiones.rpy:695
translate english queja_nino_f2d6ccaf:

    # mc "Solo tenía tres tardes."
    mc "I only had three afternoons."

# game/02_cap1_conexiones.rpy:697
translate english queja_nino_04073c11:

    # nino "Me da exactamente igual."
    nino "I couldn't care less."

# game/02_cap1_conexiones.rpy:702
translate english queja_nino_9e5c26f8:

    # nino "Además, ya te vi en mi casa más de lo que quería."
    nino "Besides, I've already seen you at my place more than I wanted to."

# game/02_cap1_conexiones.rpy:704
translate english queja_nino_d98384c0:

    # nino "Eso cuenta como visita. Por desgracia."
    nino "That counts as a visit. Unfortunately."

# game/02_cap1_conexiones.rpy:706
translate english queja_nino_7cb8b689:

    # mc "¿Eso fue un «me hubiera gustado»?"
    mc "Was that a \"wish you'd come\"?"

# game/02_cap1_conexiones.rpy:708
translate english queja_nino_4073aa39:

    # nino "¡NO! ¡Fue un «qué alivio»!"
    nino "NO! That was a \"what a relief\"!"

# game/02_cap1_conexiones.rpy:713
translate english queja_nino_25d6d6d4:

    # nino "...Mira. No esperaba nada."
    nino "...Look. I didn't expect anything."

# game/02_cap1_conexiones.rpy:715
translate english queja_nino_3494ccc3:

    # nino "Esa es la ventaja de no esperar: nadie te decepciona."
    nino "That's the upside of not expecting anything: nobody lets you down."

# game/02_cap1_conexiones.rpy:717
translate english queja_nino_6b7659d0:

    # nino "Pero las que sí fuiste a ver llegaron distintas a casa."
    nino "But the ones you did go see came home different."

# game/02_cap1_conexiones.rpy:719
translate english queja_nino_5f2be1ef:

    # mc "¿Distintas cómo?"
    mc "Different how?"

# game/02_cap1_conexiones.rpy:721
translate english queja_nino_6522518a:

    # nino "Distintas. No te digo si mejor o peor."
    nino "Different. I'm not saying better or worse."

# game/02_cap1_conexiones.rpy:723
translate english queja_nino_2756b91d:

    # nino "Pero alguien tiene que ser la que no cambia."
    nino "But somebody has to be the one who doesn't change."

# game/02_cap1_conexiones.rpy:725
translate english queja_nino_3bafeaf9:

    # nino "Para que las demás tengan a dónde volver."
    nino "So the others have somewhere to come back to."

# game/02_cap1_conexiones.rpy:730
translate english queja_nino_e3ac8a5a:

    # nino "...Eso no significa que quisiera que vinieras. Que quede claro."
    nino "...That doesn't mean I wanted you to come. Let's be clear."

# game/02_cap1_conexiones.rpy:732
translate english queja_nino_45e4d005:

    # mc "Queda clarísimo."
    mc "Crystal clear."

# game/02_cap1_conexiones.rpy:734
translate english queja_nino_1b421292:

    # nino "¡Y deja de poner esa cara de culpa! ¡No era una queja!"
    nino "And stop making that guilty face! It wasn't a complaint!"

# game/02_cap1_conexiones.rpy:739
translate english queja_nino_42d4f1f7:

    # narrador "Se fue antes de que pudiera contestarle, con el paso apretado de quien dijo más de la cuenta."
    narrador "She left before I could answer, her steps tight, like someone who'd said more than she meant to."

# game/02_cap1_conexiones.rpy:756
translate english queja_miku_f0045840:

    # miku "...No me buscaste."
    miku "...You didn't look for me."

# game/02_cap1_conexiones.rpy:758
translate english queja_miku_afa15b83:

    # mc "Tenía tres tardes."
    mc "I only had three afternoons."

# game/02_cap1_conexiones.rpy:760
translate english queja_miku_970ca85c:

    # miku "...Ya sé."
    miku "...I know."

# game/02_cap1_conexiones.rpy:762
translate english queja_miku_0e54282c:

    # miku "...Así estuvo bien. Estuve tranquila."
    miku "...It was fine. I was calm."

# game/02_cap1_conexiones.rpy:764
translate english queja_miku_2bce1464:

    # miku "...Pero habrías acertado, por cierto."
    miku "...But you would have gotten it right, by the way."

# game/02_cap1_conexiones.rpy:766
translate english queja_miku_bbd09602:

    # mc "¿Con el sitio?"
    mc "The spot?"

# game/02_cap1_conexiones.rpy:768
translate english queja_miku_6702bd04:

    # miku "...Con el sitio."
    miku "...The spot."

# game/02_cap1_conexiones.rpy:770
translate english queja_miku_20a40419:

    # miku "...Hay una silla enfrente de la mía. Siempre está vacía."
    miku "...There's a chair across from mine. It's always empty."

# game/02_cap1_conexiones.rpy:772
translate english queja_miku_ca3780b8:

    # narrador "Lo dijo mirando el libro. Pero esta vez no lo subió hasta media cara."
    narrador "She said it looking at her book. But this time she didn't raise it to cover half her face."

# game/02_cap1_conexiones.rpy:777
translate english queja_miku_5ee7aa8a:

    # miku "...Dejé el libro abierto en la misma página dos días."
    miku "...I left the book open to the same page for two days."

# game/02_cap1_conexiones.rpy:779
translate english queja_miku_5a3a1c8e:

    # miku "...Por si hacía falta una excusa."
    miku "...In case I needed an excuse."

# game/02_cap1_conexiones.rpy:781
translate english queja_miku_9b2cffcf:

    # mc "¿Una excusa para qué?"
    mc "An excuse for what?"

# game/02_cap1_conexiones.rpy:783
translate english queja_miku_15c784ed:

    # miku "...Para hablar. Si alguien se sentaba."
    miku "...To talk. If someone sat down."

# game/02_cap1_conexiones.rpy:785
translate english queja_miku_011d5b90:

    # miku "...Nadie lo hizo. No pasa nada."
    miku "...Nobody did. It's fine."

# game/02_cap1_conexiones.rpy:787
translate english queja_miku_d3bc9b96:

    # mc "Lo siento, Miku."
    mc "I'm sorry, Miku."

# game/02_cap1_conexiones.rpy:789
translate english queja_miku_46f4e2f8:

    # miku "...No lo sientas. Soy buena esperando."
    miku "...Don't be. I'm good at waiting."

# game/02_cap1_conexiones.rpy:791
translate english queja_miku_8e3c3fc5:

    # miku "...Perdón. Eso sonó triste. No era la idea."
    miku "...Sorry. That sounded sad. That wasn't the idea."

# game/02_cap1_conexiones.rpy:796
translate english queja_miku_5171db1a:

    # narrador "Se subió el libro hasta media cara. Esta vez sí."
    narrador "She pulled the book up over half her face. This time she did."

# game/02_cap1_conexiones.rpy:813
translate english queja_yotsuba_46514d0d:

    # yotsuba "¡No pasa nada! ¡De verdad!"
    yotsuba "It's okay! Really!"

# game/02_cap1_conexiones.rpy:815
translate english queja_yotsuba_652306a9:

    # yotsuba "¡Tres tardes no alcanzan para cinco! ¡Eso lo entiende cualquiera!"
    yotsuba "Three afternoons aren't enough for five! Anyone can see that!"

# game/02_cap1_conexiones.rpy:817
translate english queja_yotsuba_e1afadae:

    # mc "Yotsuba..."
    mc "Yotsuba..."

# game/02_cap1_conexiones.rpy:819
translate english queja_yotsuba_217f6046:

    # yotsuba "¡Te lo digo en serio!"
    yotsuba "I mean it!"

# game/02_cap1_conexiones.rpy:824
translate english queja_yotsuba_2655884a:

    # yotsuba "...Aunque estuve entrenando por si venías."
    yotsuba "...Although I did train in case you came."

# game/02_cap1_conexiones.rpy:826
translate english queja_yotsuba_a2d65b2c:

    # yotsuba "Me quedé quince minutos más cada tarde. Los conté."
    yotsuba "I stayed fifteen extra minutes every afternoon. I counted."

# game/02_cap1_conexiones.rpy:828
translate english queja_yotsuba_fc0ffaf6:

    # yotsuba "Cronometré dos vueltas de más. Por si acaso."
    yotsuba "I timed two extra laps. Just in case."

# game/02_cap1_conexiones.rpy:830
translate english queja_yotsuba_9a87d34e:

    # mc "Lo siento."
    mc "I'm sorry."

# game/02_cap1_conexiones.rpy:832
translate english queja_yotsuba_5dac8aef:

    # yotsuba "No lo sientas. Es que pensé que a lo mejor te hacía falta alguien que te animara."
    yotsuba "Don't be. I just thought you might need someone to cheer you on."

# game/02_cap1_conexiones.rpy:834
translate english queja_yotsuba_46ad4975:

    # yotsuba "Y si nadie me necesita, ¿para qué me sobra tanta energía?"
    yotsuba "And if nobody needs me, what's all this extra energy for?"

# game/02_cap1_conexiones.rpy:839
translate english queja_yotsuba_38b6516c:

    # yotsuba "¡Pero no importa! ¡Me sobra, así que la reparto!"
    yotsuba "But it doesn't matter! I've got extra, so I share it!"

# game/02_cap1_conexiones.rpy:841
translate english queja_yotsuba_76e1850a:

    # yotsuba "¡Y para la próxima vez ya tengo tres vueltas de ventaja!"
    yotsuba "And next time I'm already three laps ahead!"

# game/02_cap1_conexiones.rpy:843
translate english queja_yotsuba_32a416fe:

    # mc "Dijiste dos."
    mc "You said two."

# game/02_cap1_conexiones.rpy:845
translate english queja_yotsuba_cbf2bbab:

    # yotsuba "¡La tercera la corro ahora mismo!"
    yotsuba "I'm running the third one right now!"

# game/02_cap1_conexiones.rpy:850
translate english queja_yotsuba_2bb6b22d:

    # narrador "Se fue corriendo, con la sonrisa puesta."
    narrador "She ran off, smile still on."

# game/02_cap1_conexiones.rpy:852
translate english queja_yotsuba_c913a46c:

    # narrador "Pero al doblar la esquina bajó el ritmo y siguió caminando."
    narrador "But around the corner she slowed down and kept walking."

# game/02_cap1_conexiones.rpy:866
translate english queja_itsuki_758a709a:

    # itsuki "Dije que no me iba a esconder. Y no lo hice."
    itsuki "I said I wouldn't hide. And I didn't."

# game/02_cap1_conexiones.rpy:868
translate english queja_itsuki_3d78fb56:

    # mc "Lo sé. Te encontré en la azotea."
    mc "I know. I found you on the rooftop."

# game/02_cap1_conexiones.rpy:870
translate english queja_itsuki_b8759b8a:

    # itsuki "Eso no cuenta. Subiste por costumbre, no por buscarme."
    itsuki "That doesn't count. You went up out of habit, not to look for me."

# game/02_cap1_conexiones.rpy:872
translate english queja_itsuki_dc8bb2c0:

    # mc "...Es verdad."
    mc "...True."

# game/02_cap1_conexiones.rpy:874
translate english queja_itsuki_d6edce34:

    # itsuki "Entonces gané el juego."
    itsuki "Then I won the game."

# game/02_cap1_conexiones.rpy:876
translate english queja_itsuki_9ac526f8:

    # mc "¿Y qué ganas?"
    mc "And what do you win?"

# game/02_cap1_conexiones.rpy:878
translate english queja_itsuki_0e9b9593:

    # itsuki "Tener razón. Es lo único que siempre me sale bien."
    itsuki "Being right. It's the one thing I always get right."

# game/02_cap1_conexiones.rpy:883
translate english queja_itsuki_2fc345d2:

    # itsuki "No te rías."
    itsuki "Don't laugh."

# game/02_cap1_conexiones.rpy:885
translate english queja_itsuki_5e1b0b6c:

    # mc "No me estoy riendo."
    mc "I'm not laughing."

# game/02_cap1_conexiones.rpy:887
translate english queja_itsuki_f86d718e:

    # itsuki "Se te nota en la voz."
    itsuki "I can hear it in your voice."

# game/02_cap1_conexiones.rpy:892
translate english queja_itsuki_41a387f4:

    # itsuki "...Tampoco esperaba que me buscaras."
    itsuki "...I didn't expect you to look for me, either."

# game/02_cap1_conexiones.rpy:894
translate english queja_itsuki_c8ab1241:

    # itsuki "Yo no iba a pedírtelo. Pedirlo habría sido..."
    itsuki "I wasn't going to ask you to. Asking would have been..."

# game/02_cap1_conexiones.rpy:896
translate english queja_itsuki_52acdbee:

    # narrador "Se detuvo. Una oración de Itsuki sin cerrar era como ver a alguien tropezar en terreno plano."
    narrador "She stopped. An unfinished sentence from Itsuki was like watching someone trip on flat ground."

# game/02_cap1_conexiones.rpy:898
translate english queja_itsuki_4966a73e:

    # mc "¿Habría sido qué?"
    mc "Would have been what?"

# game/02_cap1_conexiones.rpy:900
translate english queja_itsuki_d3feb8c2:

    # itsuki "Nada. Una tontería."
    itsuki "Nothing. Something silly."

# game/02_cap1_conexiones.rpy:905
translate english queja_itsuki_adcff12d:

    # itsuki "Solo digo que, si hubieras venido, no te habría echado."
    itsuki "I'm only saying that if you had come, I wouldn't have thrown you out."

# game/02_cap1_conexiones.rpy:907
translate english queja_itsuki_c3f630c7:

    # mc "¿No?"
    mc "No?"

# game/02_cap1_conexiones.rpy:909
translate english queja_itsuki_8c9930a8:

    # itsuki "No inmediatamente."
    itsuki "Not immediately."

# game/02_cap1_conexiones.rpy:911
translate english queja_itsuki_146606f2:

    # itsuki "Y no lo apuntes en ningún sitio."
    itsuki "And don't write that down anywhere."

# game/02_cap1_conexiones.rpy:938
translate english cap1_interconexion_1_14a98fb8:

    # narrador "Llegué al instituto temprano, como siempre."
    narrador "I got to school early, like always."

# game/02_cap1_conexiones.rpy:942
translate english cap1_interconexion_1_72fdf694:

    # mc_pensamiento "Pero esta vez llegaba con un plan."
    mc_pensamiento "But this time I came with a plan."

# game/02_cap1_conexiones.rpy:944
translate english cap1_interconexion_1_714eae7e:

    # mc_pensamiento "Ir de una en una. Es la única forma de hacerlas estudiar."
    mc_pensamiento "One at a time. It's the only way to get them to study."

# game/02_cap1_conexiones.rpy:946
translate english cap1_interconexion_1_34d88442:

    # mc_pensamiento "No será fácil, pero puedo lograrlo."
    mc_pensamiento "It won't be easy, but I can do it."

# game/02_cap1_conexiones.rpy:951
translate english cap1_interconexion_1_ba6f422b:

    # narrador "En la hora de descanso las encontré a las cinco juntas."
    narrador "At the break, I found all five of them together."

# game/02_cap1_conexiones.rpy:953
translate english cap1_interconexion_1_a5410405:

    # mc_pensamiento "No venía a obligarlas a estudiar todas juntas. Eso ya sé que no funciona."
    mc_pensamiento "I hadn't come to force them to study together. I already know that doesn't work."

# game/02_cap1_conexiones.rpy:955
translate english cap1_interconexion_1_cb4373f1:

    # mc_pensamiento "Venía a comprobar si los lugares que mencionó Raiha eran de verdad los suyos."
    mc_pensamiento "I'd come to check whether the places Raiha mentioned were really theirs."

# game/02_cap1_conexiones.rpy:957
translate english cap1_interconexion_1_216e46ad:

    # mc_pensamiento "Así podría ir por ellas de una en una."
    mc_pensamiento "That way I could go after them one at a time."

# game/02_cap1_conexiones.rpy:959
translate english cap1_interconexion_1_f87bd4d9:

    # mc_pensamiento "Juntas son un muro. Por separado, quizá no."
    mc_pensamiento "Together, they're a wall. Separately, maybe not."

# game/02_cap1_conexiones.rpy:970
translate english cap1_interconexion_1_8b7ebfa1:

    # mc "Buenas tardes."
    mc "Good afternoon."

# game/02_cap1_conexiones.rpy:972
translate english cap1_interconexion_1_627a8b9f:

    # mc "Veo que siguen igual de desorganizadas que siempre."
    mc "I see you're as disorganized as ever."

# game/02_cap1_conexiones.rpy:974
translate english cap1_interconexion_1_bfd5fb9a:

    # mc "Tenemos mucho que repasar hoy."
    mc "We've got a lot to review today."

# game/02_cap1_conexiones.rpy:976
translate english cap1_interconexion_1_7bb1114b:

    # mc_pensamiento "Las saludé de la mejor manera posible."
    mc_pensamiento "I greeted them as well as I could."

# game/02_cap1_conexiones.rpy:978
translate english cap1_interconexion_1_1f0bd841:

    # mc_pensamiento "Eso creo..."
    mc_pensamiento "I think..."

# game/02_cap1_conexiones.rpy:987
translate english cap1_interconexion_1_b443b672:

    # nino "¿Otra vez con tus tonterías de que vamos a estudiar?"
    nino "More of your nonsense about us studying?"

# game/02_cap1_conexiones.rpy:989
translate english cap1_interconexion_1_b4707f8d:

    # nino "No creas que hoy será diferente."
    nino "Don't think today will be any different."

# game/02_cap1_conexiones.rpy:991
translate english cap1_interconexion_1_e70bbf20:

    # nino "Hoy será el tercer día y tu tercer fracaso."
    nino "Today's day three, and your third failure."

# game/02_cap1_conexiones.rpy:993
translate english cap1_interconexion_1_04152690:

    # mc_pensamiento "Nino, la de siempre. Habla por todas."
    mc_pensamiento "Nino, as usual. Speaking for everyone."

# game/02_cap1_conexiones.rpy:995
translate english cap1_interconexion_1_6c6d55e4:

    # mc_pensamiento "Las otras cuatro solo la escuchaban."
    mc_pensamiento "The other four just listened."

# game/02_cap1_conexiones.rpy:997
translate english cap1_interconexion_1_68678dde:

    # mc "No te voy a dar la razón."
    mc "I'm not going to say you're right."

# game/02_cap1_conexiones.rpy:999
translate english cap1_interconexion_1_b5252f0a:

    # mc "Pero sí es difícil hacerlas estudiar a las cinco a la vez."
    mc "But it is hard to get all five of you to study at once."

# game/02_cap1_conexiones.rpy:1001
translate english cap1_interconexion_1_355e212e:

    # nino "¿Y entonces?"
    nino "So then what?"

# game/02_cap1_conexiones.rpy:1003
translate english cap1_interconexion_1_f6943c38:

    # mc "Tengo otro método. Uno más efectivo contra ustedes."
    mc "I have another method. One that works better on you."

# game/02_cap1_conexiones.rpy:1009
translate english cap1_interconexion_1_06026c92:

    # yotsuba "¿Un método efectivo? ¡Guau!"
    yotsuba "A method that works? Wow!"

# game/02_cap1_conexiones.rpy:1011
translate english cap1_interconexion_1_6ca7e38e:

    # yotsuba "¿Y qué es? ¡Quiero saberlo! ¡Quiero saberlo!"
    yotsuba "What is it? I want to know! I want to know!"

# game/02_cap1_conexiones.rpy:1017
translate english cap1_interconexion_1_a2f4548e:

    # ichika "Vaya, resulta que además de cerebrito eres un estratega."
    ichika "Well, well. So on top of being a brainiac, you're a strategist."

# game/02_cap1_conexiones.rpy:1023
translate english cap1_interconexion_1_dab0341f:

    # itsuki "Supongo que consiste en hacernos estudiar de día y de noche."
    itsuki "I suppose it involves making us study day and night."

# game/02_cap1_conexiones.rpy:1029
translate english cap1_interconexion_1_5058e8da:

    # miku "..."
    miku "..."

# game/02_cap1_conexiones.rpy:1035
translate english cap1_interconexion_1_a9bb3851:

    # nino "No se preocupen, chicas. Su gran método es renunciar y largarse de nuestras vidas."
    nino "Don't worry, girls. His big method is to quit and get out of our lives."

# game/02_cap1_conexiones.rpy:1037
translate english cap1_interconexion_1_a116739f:

    # nino "Y aunque no lo creas... esta vez sí te apoyaré."
    nino "And believe it or not... this time I'll actually support you."

# game/02_cap1_conexiones.rpy:1043
translate english cap1_interconexion_1_8d389b22:

    # yotsuba "¡Nino! Seguro no es eso. Él solo—"
    yotsuba "Nino! I'm sure that's not it. He just—"

# game/02_cap1_conexiones.rpy:1049
translate english cap1_interconexion_1_e0b53ddf:

    # nino "Yotsuba."
    nino "Yotsuba."

# game/02_cap1_conexiones.rpy:1055
translate english cap1_interconexion_1_6a10f258:

    # yotsuba "...¡Digo! ¡Nada! ¡Era una broma!"
    yotsuba "...I mean! Nothing! I was kidding!"

# game/02_cap1_conexiones.rpy:1060
translate english cap1_interconexion_1_89feba31:

    # mc_pensamiento "Igual que ayer. A Nino le basta con decir su nombre."
    mc_pensamiento "Same as yesterday. Nino only has to say her name."

# game/02_cap1_conexiones.rpy:1062
translate english cap1_interconexion_1_6b930b55:

    # mc "Para ponerlo en marcha solo necesito que me respondan una pregunta."
    mc "To get it started, I just need you to answer one question."

# game/02_cap1_conexiones.rpy:1064
translate english cap1_interconexion_1_7baa885d:

    # mc_pensamiento "Se quedaron calladas. Eso casi nunca pasa."
    mc_pensamiento "They went quiet. That almost never happens."

# game/02_cap1_conexiones.rpy:1073
translate english cap1_interconexion_1_7414a36a:

    # quintillizas "¿Qué?"
    quintillizas "What?"

# game/02_cap1_conexiones.rpy:1075
translate english cap1_interconexion_1_c79ce27a:

    # mc "¿Dónde pasan las tardes después de clases?"
    mc "Where do you spend your afternoons after class?"

# game/02_cap1_conexiones.rpy:1077
translate english cap1_interconexion_1_bb01eac0:

    # mc "Sé que no siempre están juntas."
    mc "I know you're not always together."

# game/02_cap1_conexiones.rpy:1079
translate english cap1_interconexion_1_45808b95:

    # mc "Aunque sean iguales, sus rutinas y pasatiempos no lo son."
    mc "You may look alike, but your routines and hobbies aren't the same."

# game/02_cap1_conexiones.rpy:1088
translate english cap1_interconexion_1_528bd4fd:

    # miku "...Quiere dividirnos."
    miku "...He wants to split us up."

# game/02_cap1_conexiones.rpy:1093
translate english cap1_interconexion_1_43f6e314:

    # mc_pensamiento "Fue la única que lo entendió. Y fue la que menos habló."
    mc_pensamiento "She was the only one who got it. And the one who spoke the least."

# game/02_cap1_conexiones.rpy:1095
translate english cap1_interconexion_1_82a5bd51:

    # mc_pensamiento "Me miraron entre sorprendidas y divertidas."
    mc_pensamiento "They looked at me, somewhere between surprised and amused."

# game/02_cap1_conexiones.rpy:1100
translate english cap1_interconexion_1_194e1214:

    # ichika "Ay, [mc]. ¿Para qué quieres saberlo?"
    ichika "Aw, [mc]. Why do you want to know?"

# game/02_cap1_conexiones.rpy:1102
translate english cap1_interconexion_1_725ae4a2:

    # ichika "¿Acaso planeas una cita con cada una?"
    ichika "Are you planning a date with each of us?"

# game/02_cap1_conexiones.rpy:1104
translate english cap1_interconexion_1_a108e3b6:

    # ichika "No sabía que tenías ese lado."
    ichika "I didn't know you had that side."

# game/02_cap1_conexiones.rpy:1106
translate english cap1_interconexion_1_5a44d394:

    # mc "No es eso. Pero..."
    mc "It's not that. But..."

# game/02_cap1_conexiones.rpy:1112
translate english cap1_interconexion_1_cee36c6e:

    # nino "¿Y a ti qué te importa dónde pasamos la tarde?"
    nino "And why do you care where we spend our afternoons?"

# game/02_cap1_conexiones.rpy:1114
translate english cap1_interconexion_1_cc8a887a:

    # nino "Ya oíste a Miku. Quiere separarnos, una por una."
    nino "You heard Miku. He wants to separate us, one by one."

# game/02_cap1_conexiones.rpy:1116
translate english cap1_interconexion_1_3030b75b:

    # nino "Somos cinco. Ninguna te lo va a decir."
    nino "There are five of us. None of us is going to tell you."

# game/02_cap1_conexiones.rpy:1118
translate english cap1_interconexion_1_c8a9c2bf:

    # mc "Ya lo suponía."
    mc "I figured."

# game/02_cap1_conexiones.rpy:1124
translate english cap1_interconexion_1_6cc4aeca:

    # itsuki "Al contrario. Que lo averigüe él."
    itsuki "On the contrary. Let him find out himself."

# game/02_cap1_conexiones.rpy:1126
translate english cap1_interconexion_1_fd0726aa:

    # mc "¿Eh?"
    mc "Huh?"

# game/02_cap1_conexiones.rpy:1128
translate english cap1_interconexion_1_fbb6e20c:

    # itsuki "El profesor dice que eres el mejor alumno de la clase."
    itsuki "The teacher says you're the best student in the class."

# game/02_cap1_conexiones.rpy:1130
translate english cap1_interconexion_1_3133a2a0:

    # itsuki "Entonces resuelve esto: dónde pasa la tarde cada una."
    itsuki "So solve this: where each of us spends the afternoon."

# game/02_cap1_conexiones.rpy:1132
translate english cap1_interconexion_1_ddff1c10:

    # itsuki "Un juego de busca y encuentra. Al estilo quintillizas."
    itsuki "A game of hide-and-seek. Quintuplet style."

# game/02_cap1_conexiones.rpy:1138
translate english cap1_interconexion_1_2292b02a:

    # yotsuba "¿Estilo quintillizas? ¡Hurra! ¡Yo quiero jugar!"
    yotsuba "Quintuplet style? Hooray! I want to play!"

# game/02_cap1_conexiones.rpy:1144
translate english cap1_interconexion_1_7c28da2b:

    # miku "...Itsuki. Eso es justo lo que él quería."
    miku "...Itsuki. That's exactly what he wanted."

# game/02_cap1_conexiones.rpy:1150
translate english cap1_interconexion_1_840fa643:

    # itsuki "No. Él quería que se lo dijéramos. Yo le propongo que lo descubra."
    itsuki "No. He wanted us to tell him. I'm proposing he figure it out himself."

# game/02_cap1_conexiones.rpy:1152
translate english cap1_interconexion_1_80c35131:

    # itsuki "Si se equivoca de sitio, pierde la tarde. Es justo."
    itsuki "If he picks the wrong place, he loses the afternoon. Fair is fair."

# game/02_cap1_conexiones.rpy:1154
translate english cap1_interconexion_1_4e87b8f8:

    # mc "¿Me estás retando?"
    mc "Are you challenging me?"

# game/02_cap1_conexiones.rpy:1156
translate english cap1_interconexion_1_01d164cb:

    # itsuki "Te estoy evaluando. Como tú a nosotras con tu hoja."
    itsuki "I'm grading you. Just like you graded us with your sheet."

# game/02_cap1_conexiones.rpy:1161
translate english cap1_interconexion_1_ef1dee19:

    # mc_pensamiento "No era una broma. Era una revancha por la hoja de diagnóstico."
    mc_pensamiento "It wasn't a joke. It was payback for the diagnostic sheet."

# game/02_cap1_conexiones.rpy:1163
translate english cap1_interconexion_1_6a1c48e4:

    # mc_pensamiento "Pero en parte es mi culpa: fui yo quien preguntó."
    mc_pensamiento "But part of it is my fault: I'm the one who asked."

# game/02_cap1_conexiones.rpy:1165
translate english cap1_interconexion_1_bbe8c282:

    # mc_pensamiento "La parte buena es que cada una sí tiene su sitio."
    mc_pensamiento "The good part is that each of them does have her own spot."

# game/02_cap1_conexiones.rpy:1167
translate english cap1_interconexion_1_48dc1b94:

    # mc_pensamiento "Además, ya tengo la lista de Raiha."
    mc_pensamiento "Besides, I already have Raiha's list."

# game/02_cap1_conexiones.rpy:1169
translate english cap1_interconexion_1_3867f175:

    # mc "Me parece bien, Itsuki. Acepto tu juego."
    mc "Sounds good, Itsuki. I accept your game."

# game/02_cap1_conexiones.rpy:1171
translate english cap1_interconexion_1_7dfdc6cf:

    # mc "Sin querer me acabas de ayudar con mi plan. Bien hecho."
    mc "You just helped me with my plan without meaning to. Well done."

# game/02_cap1_conexiones.rpy:1176
translate english cap1_interconexion_1_d87aa23b:

    # itsuki "No me felicites. Solo te estoy complicando las cosas."
    itsuki "Don't congratulate me. I'm only making things harder for you."

# game/02_cap1_conexiones.rpy:1178
translate english cap1_interconexion_1_8dc633ff:

    # itsuki "No podrás pasar toda la tarde con cada una. El tiempo es corto."
    itsuki "You won't be able to spend a whole afternoon with each of us. Time is short."

# game/02_cap1_conexiones.rpy:1180
translate english cap1_interconexion_1_cddaa5e6:

    # itsuki "Y lo sabes."
    itsuki "And you know it."

# game/02_cap1_conexiones.rpy:1182
translate english cap1_interconexion_1_9c612dd8:

    # mc_pensamiento "Tenía razón."
    mc_pensamiento "She was right."

# game/02_cap1_conexiones.rpy:1184
translate english cap1_interconexion_1_d853c219:

    # mc_pensamiento "Entre el instituto y el trabajo, solo me quedarán tres tardes libres."
    mc_pensamiento "Between school and work, I'd only have three free afternoons left."

# game/02_cap1_conexiones.rpy:1186
translate english cap1_interconexion_1_8e0f3d8c:

    # mc_pensamiento "Tres tardes. Cinco hermanas."
    mc_pensamiento "Three afternoons. Five sisters."

# game/02_cap1_conexiones.rpy:1188
translate english cap1_interconexion_1_2a58dfc6:

    # mc "Iré de una en una, ya lo dije."
    mc "I'll go one at a time, like I said."

# game/02_cap1_conexiones.rpy:1194
translate english cap1_interconexion_1_7a9c9d3c:

    # ichika "¿Entonces pasarás la tarde con tu quintilliza favorita?"
    ichika "So you'll spend the afternoon with your favorite quintuplet?"

# game/02_cap1_conexiones.rpy:1196
translate english cap1_interconexion_1_955e2140:

    # ichika "Seguro me eliges a mí. Soy la más bonita de todas."
    ichika "You'll definitely pick me. I'm the prettiest one."

# game/02_cap1_conexiones.rpy:1198
translate english cap1_interconexion_1_0f221fa4:

    # mc "Tienen la misma cara."
    mc "You all have the same face."

# game/02_cap1_conexiones.rpy:1200
translate english cap1_interconexion_1_0fd172eb:

    # ichika "Detalles."
    ichika "Details."

# game/02_cap1_conexiones.rpy:1206
translate english cap1_interconexion_1_bf58b73c:

    # nino "Ichika, no te rebajes. ¿Quién querría estar con ese nerd?"
    nino "Ichika, don't lower yourself. Who'd want to spend time with that nerd?"

# game/02_cap1_conexiones.rpy:1212
translate english cap1_interconexion_1_e0ed9b9b:

    # yotsuba "¿Y elegirás a la que quieras conocer mejor? ¿O no?"
    yotsuba "And will you pick the one you want to get to know best? Or not?"

# game/02_cap1_conexiones.rpy:1218
translate english cap1_interconexion_1_9e347d3f:

    # miku "...No te preocupes por mí."
    miku "...Don't worry about me."

# game/02_cap1_conexiones.rpy:1220
translate english cap1_interconexion_1_a73fcccd:

    # miku "...Yo estoy bien sola."
    miku "...I'm fine on my own."

# game/02_cap1_conexiones.rpy:1222
translate english cap1_interconexion_1_4a54b356:

    # narrador "Se subió los audífonos antes de que pudiera contestar."
    narrador "She pulled her headphones up before I could answer."

# game/02_cap1_conexiones.rpy:1224
translate english cap1_interconexion_1_10e1df39:

    # narrador "Ichika, sin mirarla, le bajó un audífono con un dedo."
    narrador "Ichika, without looking at her, tugged one headphone down with a finger."

# game/02_cap1_conexiones.rpy:1226
translate english cap1_interconexion_1_980c2270:

    # narrador "Miku se lo volvió a subir. Parecía un juego viejo entre ellas."
    narrador "Miku put it back up. It looked like an old game between them."

# game/02_cap1_conexiones.rpy:1232
translate english cap1_interconexion_1_76a17314:

    # itsuki "Yo no pienso esconderme. Estaré donde siempre."
    itsuki "I'm not going to hide. I'll be where I always am."

# game/02_cap1_conexiones.rpy:1238
translate english cap1_interconexion_1_1732b5ac:

    # nino "Treinta días, tutor. A ver a cuántas logras encontrar."
    nino "Thirty days, tutor. Let's see how many of us you find."

# game/02_cap1_conexiones.rpy:1248
translate english cap1_interconexion_1_4591049b:

    # narrador "Se fueron sin esperar respuesta."
    narrador "They left without waiting for an answer."

# game/02_cap1_conexiones.rpy:1250
translate english cap1_interconexion_1_9361285d:

    # narrador "Yotsuba fue la única que miró atrás antes de salir."
    narrador "Yotsuba was the only one who looked back before going out."

# game/02_cap1_conexiones.rpy:1252
translate english cap1_interconexion_1_eee3fd38:

    # narrador "Y solo Itsuki tardó un poco más en salir."
    narrador "And only Itsuki took a little longer to leave."

# game/02_cap1_conexiones.rpy:1257
translate english cap1_interconexion_1_b46d9b35:

    # narrador "El aula quedó en silencio."
    narrador "The classroom went quiet."

# game/02_cap1_conexiones.rpy:1265
translate english cap1_interconexion_1_c3130788:

    # narrador "Terminadas las clases, me quedé un rato en el aula."
    narrador "After classes ended, I stayed in the classroom for a while."

# game/02_cap1_conexiones.rpy:1267
translate english cap1_interconexion_1_aaebad49:

    # mc_pensamiento "Tres tardes libres. Cinco nombres."
    mc_pensamiento "Three free afternoons. Five names."

# game/02_cap1_conexiones.rpy:1269
translate english cap1_interconexion_1_76711b5b:

    # mc_pensamiento "Y ya sé dónde buscar a cada una."
    mc_pensamiento "And I already know where to look for each one."

# game/02_cap1_conexiones.rpy:1271
translate english cap1_interconexion_1_5e5cccef:

    # mc_pensamiento "No voy a llegar a todas. Eso también lo sé."
    mc_pensamiento "I won't reach all of them. I know that, too."

# game/02_cap1_conexiones.rpy:1273
translate english cap1_interconexion_1_e644e71f:

    # mc_pensamiento "Empiezo hoy."
    mc_pensamiento "I start today."

# game/02_cap1_conexiones.rpy:1298
translate english cap1_interconexion_2_3b8cf7a2:

    # narrador "Llegué a mi habitación."
    narrador "I got to my room."

# game/02_cap1_conexiones.rpy:1300
translate english cap1_interconexion_2_49186f5c:

    # narrador "No abrí la libreta. Ya sabía lo que decía."
    narrador "I didn't open the notebook. I already knew what it said."

# game/02_cap1_conexiones.rpy:1304
translate english cap1_interconexion_2_c6d46ed3:

    # mc_pensamiento "Dormí mejor de lo que esperaba."
    mc_pensamiento "I slept better than I expected."

# game/02_cap1_conexiones.rpy:1306
translate english cap1_interconexion_2_78461abd:

    # mc_pensamiento "Con [nombre_h!t] algo se movió esta tarde. Poco, pero se movió."
    mc_pensamiento "Something shifted with [nombre_h!t] this afternoon. Not much, but it shifted."

# game/02_cap1_conexiones.rpy:1308
translate english cap1_interconexion_2_504206c7:

    # mc_pensamiento "Por algún lado se empieza."
    mc_pensamiento "You start somewhere."

# game/02_cap1_conexiones.rpy:1312
translate english cap1_interconexion_2_3df0a699:

    # mc_pensamiento "Dormí. No sé si eso es buena o mala señal."
    mc_pensamiento "I slept. I don't know if that's a good sign or a bad one."

# game/02_cap1_conexiones.rpy:1314
translate english cap1_interconexion_2_e8a577ae:

    # mc_pensamiento "Con [nombre_h!t] la tarde pasó sin que nada saliera mal."
    mc_pensamiento "The afternoon with [nombre_h!t] went by without anything going wrong."

# game/02_cap1_conexiones.rpy:1316
translate english cap1_interconexion_2_2eb59cba:

    # mc_pensamiento "Tampoco salió nada que valga la pena anotar."
    mc_pensamiento "Nothing worth writing down came out of it, either."

# game/02_cap1_conexiones.rpy:1320
translate english cap1_interconexion_2_0563640f:

    # mc_pensamiento "Me costó dormir."
    mc_pensamiento "It was hard to fall asleep."

# game/02_cap1_conexiones.rpy:1322
translate english cap1_interconexion_2_363d6fa0:

    # mc_pensamiento "Repasé lo que le dije a [nombre_h!t] más veces de las que voy a admitir."
    mc_pensamiento "I replayed what I said to [nombre_h!t] more times than I'll admit."

# game/02_cap1_conexiones.rpy:1324
translate english cap1_interconexion_2_40d69a80:

    # mc_pensamiento "Tenía razón. Eso no hacía que sonara mejor."
    mc_pensamiento "I was right. That didn't make it sound any better."

# game/02_cap1_conexiones.rpy:1336
translate english cap1_interconexion_2_6846f078:

    # narrador "A la mañana siguiente, Raiha ya se había despertado."
    narrador "The next morning, Raiha was already up."

# game/02_cap1_conexiones.rpy:1338
translate english cap1_interconexion_2_759bc9de:

    # narrador "Me llamó al comedor muy alegre."
    narrador "She called me to the dining room, all cheerful."

# game/02_cap1_conexiones.rpy:1340
translate english cap1_interconexion_2_e2d911c5:

    # narrador "Esa energía me recordaba a alguien. No supe a quién."
    narrador "That energy reminded me of someone. I couldn't think who."

# game/02_cap1_conexiones.rpy:1345
translate english cap1_interconexion_2_2cb5ec09:

    # raiha "¡Buenos días, hermanito!"
    raiha "Good morning, [mc]!"

# game/02_cap1_conexiones.rpy:1347
translate english cap1_interconexion_2_1297602f:

    # raiha "¿Qué quieres de desayuno? ¡Tienes que decidirlo ya!"
    raiha "What do you want for breakfast? You have to decide now!"

# game/02_cap1_conexiones.rpy:1351
translate english cap1_interconexion_2_63bcc12f:

    # mc_pensamiento "¿Qué le pido?" nointeract
    mc_pensamiento "What do I tell her?" nointeract

# game/02_cap1_conexiones.rpy:1355
translate english cap1_interconexion_2_9dda3103:

    # mc "Lo que sea, menos curry."
    mc "Anything but curry."

# game/02_cap1_conexiones.rpy:1360
translate english cap1_interconexion_2_47501e0a:

    # raiha "¡El curry es amor líquido, hermanito!"
    raiha "Curry is liquid love, big brother!"

# game/02_cap1_conexiones.rpy:1362
translate english cap1_interconexion_2_f34110c4:

    # mc "A esta hora de la mañana, el amor líquido es una apuesta."
    mc "This early in the morning, liquid love is a gamble."

# game/02_cap1_conexiones.rpy:1366
translate english cap1_interconexion_2_6d9919e6:

    # mc "Café en un tupper. Y listo."
    mc "Tupperware coffee. Done."

# game/02_cap1_conexiones.rpy:1368
translate english cap1_interconexion_2_f06e8aec:

    # raiha "¡No! ¡Hay arroz, tortilla y un pulpito de salchicha!"
    raiha "No! There's rice, omelet, and a little sausage octopus!"

# game/02_cap1_conexiones.rpy:1370
translate english cap1_interconexion_2_4d8ee7a6:

    # mc "¿Los pulpitos no se negocian?"
    mc "The little octopus isn't negotiable?"

# game/02_cap1_conexiones.rpy:1375
translate english cap1_interconexion_2_5e277792:

    # raiha "¡Nunca!"
    raiha "Never!"

# game/02_cap1_conexiones.rpy:1379
translate english cap1_interconexion_2_da054cfc:

    # mc "Nada. Con estas ojeras ya voy servido."
    mc "Nothing. I'm running on eye bags."

# game/02_cap1_conexiones.rpy:1384
translate english cap1_interconexion_2_49580c03:

    # raiha "...Voy a prepararte doble porción."
    raiha "...I'm making you a double portion."

# game/02_cap1_conexiones.rpy:1386
translate english cap1_interconexion_2_2d01493b:

    # raiha "¡Desayunar también es importante! ¡Lo dijo la maestra!"
    raiha "Breakfast matters too! Teacher said so!"

# game/02_cap1_conexiones.rpy:1388
translate english cap1_interconexion_2_4304f925:

    # narrador "Lo dijo con el tono de quien ya tomó una decisión por los dos."
    narrador "She said it like someone who'd already made the decision for both of us."

# game/02_cap1_conexiones.rpy:1393
translate english cap1_interconexion_2_23f80cef:

    # raiha "¡Y no lo dejes olvidado en la mochila como la última vez!"
    raiha "And don't forget it in your bag like last time!"

# game/02_cap1_conexiones.rpy:1395
translate english cap1_interconexion_2_018ee1fb:

    # mc "Prometido."
    mc "Promise."

# game/02_cap1_conexiones.rpy:1397
translate english cap1_interconexion_2_c6d27d26:

    # narrador "Me lo entregó envuelto en un pañuelo, con el nudo más apretado que he visto en mi vida."
    narrador "She handed it over wrapped in a cloth, tied in the tightest knot I've ever seen."

# game/02_cap1_conexiones.rpy:1402
translate english cap1_interconexion_2_4e9327ad:

    # narrador "Salí de casa y fui al instituto."
    narrador "I left the house and went to school."

# game/02_cap1_conexiones.rpy:1418
translate english cap1_interconexion_2_2c2e26a2:

    # narrador "Llegué al instituto con el almuerzo de Raiha en la mochila y la cabeza todavía en lo de ayer."
    narrador "I got to school with Raiha's lunch in my bag and my head still on yesterday."

# game/02_cap1_conexiones.rpy:1420
translate english cap1_interconexion_2_e5c2116f:

    # narrador "En el aula, algunas ya estaban en sus pupitres y otras entraban de a una."
    narrador "Some of them were already at their desks; others were trickling in one by one."

# game/02_cap1_conexiones.rpy:1422
translate english cap1_interconexion_2_868fa8fb:

    # narrador "Itsuki ya estaba en su pupitre, con el cuaderno de ciencias abierto."
    narrador "Itsuki was already at her desk, science notebook open."

# game/02_cap1_conexiones.rpy:1424
translate english cap1_interconexion_2_c08f775c:

    # narrador "De repente, [nombre_h!t] se me cruzó en el camino."
    narrador "Out of nowhere, [nombre_h!t] stepped into my path."

# game/02_cap1_conexiones.rpy:1445
translate english cap1_interconexion_2_9f9f1e50:

    # nino "¿Qué le hiciste a [nombre_h!t]?"
    nino "What did you do to [nombre_h!t]?"

# game/02_cap1_conexiones.rpy:1447
translate english cap1_interconexion_2_16a9db4d:

    # nino "No paró de decir tu nombre anoche."
    nino "She kept saying your name all night."

# game/02_cap1_conexiones.rpy:1449
translate english cap1_interconexion_2_0a7143db:

    # nino "Tu nombre, lo genial que la pasaron, como la hiciste sentir."
    nino "Your name, what a great time they had, how you made her feel."

# game/02_cap1_conexiones.rpy:1451
translate english cap1_interconexion_2_adb6de60:

    # nino "¿Qué es lo que pretendes con [nombre_h!t]?"
    nino "What are you after with [nombre_h!t]?"

# game/02_cap1_conexiones.rpy:1453
translate english cap1_interconexion_2_ffa96970:

    # mc "No es lo que piensas, Nino."
    mc "It's not what you think, Nino."

# game/02_cap1_conexiones.rpy:1455
translate english cap1_interconexion_2_2fe83078:

    # mc "Solo cumplí lo que les dije de mi método."
    mc "I just did what I told you about my method."

# game/02_cap1_conexiones.rpy:1460
translate english cap1_interconexion_2_df3ae5a9:

    # nino "¿Pasaste la tarde a solas con ella?"
    nino "You spent the afternoon alone with her?"

# game/02_cap1_conexiones.rpy:1462
translate english cap1_interconexion_2_5d1ffaf1:

    # mc "Sí. Era parte del método."
    mc "Yes. It was part of the method."

# game/02_cap1_conexiones.rpy:1464
translate english cap1_interconexion_2_2db458a9:

    # nino "Ya. El método."
    nino "Right. The method."

# game/02_cap1_conexiones.rpy:1469
translate english cap1_interconexion_2_864cfa95:

    # nino "...¿Y por qué no me buscaste a mí primero?"
    nino "...And why didn't you come find me first?"

# game/02_cap1_conexiones.rpy:1471
translate english cap1_interconexion_2_ed764bae:

    # mc "...¿Qué?"
    mc "...What?"

# game/02_cap1_conexiones.rpy:1473
translate english cap1_interconexion_2_cf39649a:

    # nino "¡Nada!"
    nino "Nothing!"

# game/02_cap1_conexiones.rpy:1475
translate english cap1_interconexion_2_76eda96c:

    # nino "Que si te vas a llevar a mis hermanas de una en una, primero se me avisa."
    nino "I mean, if you're going to take my sisters one at a time, you tell me first."

# game/02_cap1_conexiones.rpy:1477
translate english cap1_interconexion_2_1ef1a716:

    # nino "Yo organizo esta casa. Las cosas pasan por mí."
    nino "I run this house. Things go through me."

# game/02_cap1_conexiones.rpy:1479
translate english cap1_interconexion_2_4a602f09:

    # mc "¿Te molesta no haber sido la primera?"
    mc "Does it bother you that you weren't first?"

# game/02_cap1_conexiones.rpy:1481
translate english cap1_interconexion_2_5d4e5361:

    # nino "¡Me molesta que hagas planes con mis hermanas, tonto!"
    nino "It bothers me that you're making plans with my sisters, idiot!"

# game/02_cap1_conexiones.rpy:1486
translate english cap1_interconexion_2_59a5e422:

    # nino "[nombre_h!t] es mi hermana."
    nino "[nombre_h!t] is my sister."

# game/02_cap1_conexiones.rpy:1488
translate english cap1_interconexion_2_0c332c9f:

    # nino "Si le haces daño, te las vas a ver conmigo."
    nino "If you hurt her, you'll have to deal with me."

# game/02_cap1_conexiones.rpy:1490
translate english cap1_interconexion_2_62c10e36:

    # nino "No me importa con cuál pases las tardes."
    nino "I don't care which one you spend your afternoons with."

# game/02_cap1_conexiones.rpy:1492
translate english cap1_interconexion_2_f2822430:

    # nino "Me importa que no se ilusione."
    nino "I care that she doesn't get her hopes up."

# game/02_cap1_conexiones.rpy:1494
translate english cap1_interconexion_2_8d6f5a0c:

    # nino "Y que quede claro: sigo diciendo que no vas a durar."
    nino "And let's be clear: I still say you won't last."

# game/02_cap1_conexiones.rpy:1496
translate english cap1_interconexion_2_db1b6cd1:

    # narrador "Se fue rápido, con la cara girada hacia el pasillo."
    narrador "She left fast, her face turned toward the hallway."

# game/02_cap1_conexiones.rpy:1501
translate english cap1_interconexion_2_f0d4f881:

    # mc_pensamiento "No pude ver si estaba roja."
    mc_pensamiento "I couldn't tell if it was red."

# game/02_cap1_conexiones.rpy:1503
translate english cap1_interconexion_2_80219083:

    # mc_pensamiento "La excusa le llegó un segundo tarde. La pregunta, no."
    mc_pensamiento "The excuse arrived a second late. The question didn't."

# game/02_cap1_conexiones.rpy:1510
translate english cap1_interconexion_2_07da98d6:

    # nino "Oye, tú."
    nino "Hey, you."

# game/02_cap1_conexiones.rpy:1512
translate english cap1_interconexion_2_af5e3bb7:

    # nino "Anoche [nombre_h!t] llegó igual que se fue."
    nino "[nombre_h!t] came home last night the same way she left."

# game/02_cap1_conexiones.rpy:1514
translate english cap1_interconexion_2_7704d28b:

    # nino "Ni contenta ni dolida. Como si no hubiera pasado nada."
    nino "Not happy, not hurt. Like nothing happened."

# game/02_cap1_conexiones.rpy:1516
translate english cap1_interconexion_2_f5826188:

    # mc "Es que no pasó nada."
    mc "That's because nothing happened."

# game/02_cap1_conexiones.rpy:1518
translate english cap1_interconexion_2_e1345dfa:

    # nino "Bien. Es lo único que te reconozco: no armas escándalo."
    nino "Good. It's the one thing I'll give you: you don't make a scene."

# game/02_cap1_conexiones.rpy:1520
translate english cap1_interconexion_2_e4054b59:

    # nino "No te lo tomes como un halago."
    nino "Don't take that as a compliment."

# game/02_cap1_conexiones.rpy:1522
translate english cap1_interconexion_2_d619331f:

    # mc "No lo hice."
    mc "I didn't."

# game/02_cap1_conexiones.rpy:1527
translate english cap1_interconexion_2_3972f2ab:

    # nino "...Pero sí. Me tranquiliza."
    nino "...But yeah. It's a relief."

# game/02_cap1_conexiones.rpy:1529
translate english cap1_interconexion_2_8a755b43:

    # nino "Los que entran haciendo ruido son los que más rápido se van."
    nino "The ones who come in making noise are the first to leave."

# game/02_cap1_conexiones.rpy:1534
translate english cap1_interconexion_2_7fe5e839:

    # narrador "Se fue con la misma cara con la que llegó."
    narrador "She left with the same face she came with."

# game/02_cap1_conexiones.rpy:1536
translate english cap1_interconexion_2_da058dd7:

    # mc_pensamiento "Tardé un segundo en entender que eso también era un cumplido."
    mc_pensamiento "It took me a second to realize that was a compliment, too."

# game/02_cap1_conexiones.rpy:1547
translate english cap1_interconexion_2_766825ec:

    # nino "Oye tú."
    nino "Hey, you."

# game/02_cap1_conexiones.rpy:1549
translate english cap1_interconexion_2_92cfd824:

    # narrador "Nino no gritó. Eso fue lo primero que me asustó."
    narrador "Nino didn't yell. That was the first thing that scared me."

# game/02_cap1_conexiones.rpy:1551
translate english cap1_interconexion_2_a33b2f74:

    # nino "Anoche vi a [nombre_h!t] muy mal, como si alguien la hubiera humillado."
    nino "Last night [nombre_h!t] looked awful, like someone had humiliated her."

# game/02_cap1_conexiones.rpy:1553
translate english cap1_interconexion_2_d19ae7f7:

    # nino "Se encerró en su cuarto con una mirada perdida."
    nino "She shut herself in her room with a faraway look."

# game/02_cap1_conexiones.rpy:1555
translate english cap1_interconexion_2_b9ed6417:

    # nino "Toqué su puerta para ver cómo estaba."
    nino "I knocked on her door to see how she was."

# game/02_cap1_conexiones.rpy:1557
translate english cap1_interconexion_2_1cb51305:

    # nino "Dijo que estaba bien. Lo dijo tres veces."
    nino "She said she was fine. She said it three times."

# game/02_cap1_conexiones.rpy:1559
translate english cap1_interconexion_2_59b728d1:

    # nino "Nadie dice «estoy bien» tres veces si lo está."
    nino "Nobody says \"I'm fine\" three times if they are."

# game/02_cap1_conexiones.rpy:1561
translate english cap1_interconexion_2_5a3e8e21:

    # mc "No fue mi intención..."
    mc "I didn't mean to..."

# game/02_cap1_conexiones.rpy:1563
translate english cap1_interconexion_2_8a19a1f9:

    # nino "Nunca lo es."
    nino "You never do."

# game/02_cap1_conexiones.rpy:1565
translate english cap1_interconexion_2_35f8065d:

    # nino "Te dije que ibas a hacerles daño. No pensé que tardarías tan poco."
    nino "I told you you'd hurt them. I just didn't think it'd happen this fast."

# game/02_cap1_conexiones.rpy:1567
translate english cap1_interconexion_2_be43eb3d:

    # mc_pensamiento "No estaba enojada. Estaba decepcionada."
    mc_pensamiento "She wasn't angry. She was disappointed."

# game/02_cap1_conexiones.rpy:1569
translate english cap1_interconexion_2_284225ca:

    # mc_pensamiento "Y eso dolía mucho más que un grito."
    mc_pensamiento "And that hurt a lot more than yelling."

# game/02_cap1_conexiones.rpy:1571
translate english cap1_interconexion_2_d7cd1064:

    # nino "Hoy no la saludes."
    nino "Don't say hi to her today."

# game/02_cap1_conexiones.rpy:1573
translate english cap1_interconexion_2_ebd03b60:

    # nino "No le expliques nada. Déjala."
    nino "Don't explain anything. Leave her alone."

# game/02_cap1_conexiones.rpy:1578
translate english cap1_interconexion_2_c61d7eae:

    # narrador "Se fue sin mirarme. No hubo insultos, porque no hacía falta."
    narrador "She left without looking at me. No insults. She didn't need any."

# game/02_cap1_conexiones.rpy:1580
translate english cap1_interconexion_2_d7512319:

    # mc_pensamiento "Quise decir que me arrepentía."
    mc_pensamiento "I wanted to say I was sorry."

# game/02_cap1_conexiones.rpy:1582
translate english cap1_interconexion_2_41832b8e:

    # mc_pensamiento "Pero no sabía si tenía derecho a decirlo en voz alta."
    mc_pensamiento "But I didn't know if I had the right to say it out loud."

# game/02_cap1_conexiones.rpy:1591
translate english cap1_interconexion_2_bd543fd2:

    # narrador "Las clases terminaron rápidamente."
    narrador "Classes went by quickly."

# game/02_cap1_conexiones.rpy:1597
translate english cap1_interconexion_2_51f53929:

    # narrador "El timbre del almuerzo sonó y el aula se vació en segundos."
    narrador "The lunch bell rang and the classroom emptied in seconds."

# game/02_cap1_conexiones.rpy:1599
translate english cap1_interconexion_2_93239c10:

    # narrador "Itsuki fue la primera en levantarse."
    narrador "Itsuki was the first to get up."

# game/02_cap1_conexiones.rpy:1601
translate english cap1_interconexion_2_6008c15a:

    # narrador "Tomó el cuaderno de ciencias. No tomó nada más."
    narrador "She took her science notebook. Nothing else."

# game/02_cap1_conexiones.rpy:1603
translate english cap1_interconexion_2_524a83c4:

    # narrador "Ninguna bolsa de almuerzo. Ninguna caja."
    narrador "No lunch bag. No lunch box."

# game/02_cap1_conexiones.rpy:1605
translate english cap1_interconexion_2_d1d76538:

    # mc_pensamiento "No hacía falta preguntar adónde iba."
    mc_pensamiento "No need to ask where she was going."

# game/02_cap1_conexiones.rpy:1607
translate english cap1_interconexion_2_8073c99d:

    # mc_pensamiento "Solo hay un sitio al que se sube por esas escaleras."
    mc_pensamiento "Those stairs only lead to one place."

# game/02_cap1_conexiones.rpy:1637
translate english cap1_interconexion_3_b22d50e1:

    # narrador "Entré a mi habitación y saqué mi copia de la hoja de diagnóstico del primer día."
    narrador "I went to my room and took out my copy of the diagnostic sheet from the first day."

# game/02_cap1_conexiones.rpy:1639
translate english cap1_interconexion_3_9e18c22a:

    # mc_pensamiento "Busqué el ejercicio que Itsuki tenía rodeado en el cuaderno."
    mc_pensamiento "I looked for the exercise Itsuki had circled in her notebook."

# game/02_cap1_conexiones.rpy:1641
translate english cap1_interconexion_3_3a591cc4:

    # mc_pensamiento "No era difícil. Un paso de conversión, nada más."
    mc_pensamiento "It wasn't hard. One conversion step, nothing more."

# game/02_cap1_conexiones.rpy:1643
translate english cap1_interconexion_3_7b217acb:

    # mc_pensamiento "Y llevaba días repasándolo sin ver dónde se le torcía."
    mc_pensamiento "And she'd been going over it for days without seeing where it went wrong."

# game/02_cap1_conexiones.rpy:1645
translate english cap1_interconexion_3_12d17ddf:

    # mc_pensamiento "Eso no es falta de esfuerzo."
    mc_pensamiento "That isn't a lack of effort."

# game/02_cap1_conexiones.rpy:1647
translate english cap1_interconexion_3_7c500f90:

    # mc_pensamiento "Es que nadie le ha dicho dónde mirar. Y ella no va a pedirlo."
    mc_pensamiento "It's that nobody's told her where to look. And she won't ask."

# game/02_cap1_conexiones.rpy:1651
translate english cap1_interconexion_3_29925c6c:

    # narrador "Entré a mi habitación y volví a pensar en lo de la azotea."
    narrador "I went to my room and thought about the rooftop again."

# game/02_cap1_conexiones.rpy:1653
translate english cap1_interconexion_3_ae9ba0bc:

    # mc_pensamiento "En el aula se atascó y se encerró sobre el cuaderno."
    mc_pensamiento "In class she got stuck and hunched over her notebook."

# game/02_cap1_conexiones.rpy:1655
translate english cap1_interconexion_3_74624351:

    # mc_pensamiento "En la azotea ni siquiera lo abrió."
    mc_pensamiento "On the rooftop she didn't even open it."

# game/02_cap1_conexiones.rpy:1657
translate english cap1_interconexion_3_32f1396a:

    # mc_pensamiento "No sé cuál de las dos cosas me preocupa más."
    mc_pensamiento "I don't know which of the two worries me more."

# game/02_cap1_conexiones.rpy:1659
translate english cap1_interconexion_3_c11f9854:

    # mc_pensamiento "Y el mes ya empezó a correr."
    mc_pensamiento "And the month is already running."

# game/02_cap1_conexiones.rpy:1666
translate english cap1_interconexion_3_ffca3e12:

    # narrador "Mi padre asomó la cabeza. Venía de fotografiar una boda y todavía olía a pastel."
    narrador "My father poked his head in. He'd just come from shooting a wedding and still smelled like cake."

# game/02_cap1_conexiones.rpy:1668
translate english cap1_interconexion_3_e496c1f1:

    # isanari "¿Sigues vivo? Maruo dice que todavía no te han echado."
    isanari "Still alive? Maruo says they haven't kicked you out yet."

# game/02_cap1_conexiones.rpy:1670
translate english cap1_interconexion_3_dfb108ad:

    # isanari "Con sus hijas, eso ya es récord."
    isanari "With his daughters, that's already a record."

# game/02_cap1_conexiones.rpy:1672
translate english cap1_interconexion_3_c8750a58:

    # mc "¿Hablas con él?"
    mc "You talk to him?"

# game/02_cap1_conexiones.rpy:1674
translate english cap1_interconexion_3_a5a375ce:

    # isanari "Desde el instituto. Él era el primero de la clase."
    isanari "Since high school. He was top of the class."

# game/02_cap1_conexiones.rpy:1676
translate english cap1_interconexion_3_91760561:

    # isanari "Yo era el problema de la clase."
    isanari "I was the class problem."

# game/02_cap1_conexiones.rpy:1678
translate english cap1_interconexion_3_113e7ecc:

    # mc "Eso explica muchas cosas."
    mc "That explains a lot."

# game/02_cap1_conexiones.rpy:1680
translate english cap1_interconexion_3_d5223a48:

    # isanari "Explica que nos debamos favores. Él a mí, uno. Yo a él, todos los demás."
    isanari "It explains why we owe each other favors. Him to me, one. Me to him, all the rest."

# game/02_cap1_conexiones.rpy:1682
translate english cap1_interconexion_3_da991d01:

    # isanari "¿Y? ¿Cuál de las cinco te odia menos?"
    isanari "So? Which of the five hates you least?"

# game/02_cap1_conexiones.rpy:1684
translate english cap1_interconexion_3_c9df3ff4:

    # mc "Depende del día."
    mc "Depends on the day."

# game/02_cap1_conexiones.rpy:1686
translate english cap1_interconexion_3_fb7d437d:

    # isanari "Entonces vas bien. Tu madre me odió un año entero."
    isanari "Then you're doing fine. Your mother hated me for a whole year."

# game/02_cap1_conexiones.rpy:1688
translate english cap1_interconexion_3_d6eceb00:

    # narrador "Lo dijo sonriendo. Casi nunca la nombra así, de pasada."
    narrador "He said it smiling. He almost never brings her up like that, in passing."

# game/02_cap1_conexiones.rpy:1693
translate english cap1_interconexion_3_0ad21552:

    # isanari "Le dije a Maruo que eras terco. Que no sabes rendirte."
    isanari "I told Maruo you're stubborn. That you don't know how to give up."

# game/02_cap1_conexiones.rpy:1695
translate english cap1_interconexion_3_894de16d:

    # isanari "Lo tomó como un elogio. No me hagas quedar de mentiroso."
    isanari "He took it as a compliment. Don't make me a liar."

# game/02_cap1_conexiones.rpy:1697
translate english cap1_interconexion_3_4d243876:

    # mc "¿Eso fue un elogio?"
    mc "Was that a compliment?"

# game/02_cap1_conexiones.rpy:1699
translate english cap1_interconexion_3_d63da369:

    # isanari "Fue una advertencia. Para los dos."
    isanari "It was a warning. For both of us."

# game/02_cap1_conexiones.rpy:1704
translate english cap1_interconexion_3_7c89a101:

    # mc_pensamiento "Antes de cerrar, miró la libreta abierta sobre mi escritorio. No preguntó nada."
    mc_pensamiento "Before closing the door, he glanced at the notebook open on my desk. He didn't ask anything."

# game/02_cap1_conexiones.rpy:1706
translate english cap1_interconexion_3_fa8751b3:

    # mc_pensamiento "Nunca pregunta. Pero esta vez miró."
    mc_pensamiento "He never asks. But this time he looked."

# game/02_cap1_conexiones.rpy:1715
translate english cap1_interconexion_3_6b126fe2:

    # narrador "Los días siguientes se me fueron entre clases, las tutorías y sueño atrasado."
    narrador "The next few days disappeared into classes, tutoring, and lost sleep."

# game/02_cap1_conexiones.rpy:1717
translate english cap1_interconexion_3_86a714a7:

    # narrador "Para cuando levanté la cabeza, habían pasado diez días."
    narrador "By the time I looked up, ten days had gone by."

# game/02_cap1_conexiones.rpy:1740
translate english cap1_interconexion_3_b43ef6eb:

    # narrador "Las cinco ya estaban en el aula cuando entré."
    narrador "All five were already in the classroom when I walked in."

# game/02_cap1_conexiones.rpy:1751
translate english cap1_interconexion_3_c47683db:

    # yotsuba "¡Buenos días, tutor! ¡Tienes cara de cansado!"
    yotsuba "Good morning, tutor! You look tired!"

# game/02_cap1_conexiones.rpy:1753
translate english cap1_interconexion_3_78b52b08:

    # mc "Gracias, Yotsuba."
    mc "Thanks, Yotsuba."

# game/02_cap1_conexiones.rpy:1755
translate english cap1_interconexion_3_b49abc18:

    # yotsuba "¡De nada!"
    yotsuba "You're welcome!"

# game/02_cap1_conexiones.rpy:1757
translate english cap1_interconexion_3_9c0e4e4f:

    # narrador "Lo dijo mirando la pizarra."
    narrador "She said it looking at the board."

# game/02_cap1_conexiones.rpy:1761
translate english cap1_interconexion_3_2eac33d2:

    # yotsuba "¡[mc]! ¿Cómo estás? ¡Tienes cara de haber peleado con un oso!"
    yotsuba "[mc]! How are you? You look like you fought a bear!"

# game/02_cap1_conexiones.rpy:1763
translate english cap1_interconexion_3_78b52b08_1:

    # mc "Gracias, Yotsuba."
    mc "Thanks, Yotsuba."

# game/02_cap1_conexiones.rpy:1765
translate english cap1_interconexion_3_c9f01d65:

    # yotsuba "¡Es un cumplido! ¡Los osos son fuertes!"
    yotsuba "It's a compliment! Bears are strong!"

# game/02_cap1_conexiones.rpy:1771
translate english cap1_interconexion_3_80bb3e68:

    # ichika "Pregunta seria, [mc]: ¿cuántas horas llevas sin dormir bien?"
    ichika "Serious question, [mc]: how many hours has it been since you slept properly?"

# game/02_cap1_conexiones.rpy:1773
translate english cap1_interconexion_3_bd94d743:

    # mc "He dormido bien. Las suficientes."
    mc "I've slept fine. Enough."

# game/02_cap1_conexiones.rpy:1775
translate english cap1_interconexion_3_1b2c2d4d:

    # mc "Cuidar de cinco bebés no es nada fácil."
    mc "Looking after five babies isn't easy."

# game/02_cap1_conexiones.rpy:1777
translate english cap1_interconexion_3_714049ca:

    # ichika "Eso lo diría alguien que no duerme."
    ichika "That's what someone who doesn't sleep would say."

# game/02_cap1_conexiones.rpy:1781
translate english cap1_interconexion_3_13bbbe46:

    # ichika "Y «las suficientes» no es un número. Me lo enseñó un tutor muy terco."
    ichika "And \"enough\" isn't a number. A very stubborn tutor taught me that."

# game/02_cap1_conexiones.rpy:1785
translate english cap1_interconexion_3_b4c8f8ee:

    # ichika "Qué tutor más terco."
    ichika "What a stubborn tutor."

# game/02_cap1_conexiones.rpy:1791
translate english cap1_interconexion_3_83656b85:

    # miku "...Tienes ojeras."
    miku "...You have dark circles."

# game/02_cap1_conexiones.rpy:1793
translate english cap1_interconexion_3_6850c7f4:

    # mc "Ya me lo dijeron."
    mc "So I've heard."

# game/02_cap1_conexiones.rpy:1795
translate english cap1_interconexion_3_44fe9fbc:

    # miku "...Es verdad igual."
    miku "...It's still true."

# game/02_cap1_conexiones.rpy:1801
translate english cap1_interconexion_3_aaf445ed:

    # nino "Van casi diez días. Y seguimos igual."
    nino "Almost ten days now. And nothing's changed."

# game/02_cap1_conexiones.rpy:1803
translate english cap1_interconexion_3_ae67ebfd:

    # mc "No seguimos igual."
    mc "Things have changed."

# game/02_cap1_conexiones.rpy:1805
translate english cap1_interconexion_3_e2b705e5:

    # nino "Cuéntamelo cuando haya algo que contar."
    nino "Tell me when there's something to tell."

# game/02_cap1_conexiones.rpy:1817
translate english cap1_interconexion_3_202f32a9:

    # narrador "Yotsuba me miró la muñeca."
    narrador "Yotsuba looked at my wrist."

# game/02_cap1_conexiones.rpy:1819
translate english cap1_interconexion_3_fd0ea5b8:

    # narrador "El «1» seguía ahí, a medio borrar."
    narrador "The \"1\" was still there, half rubbed out."

# game/02_cap1_conexiones.rpy:1821
translate english cap1_interconexion_3_157e4ae3:

    # narrador "Sonrió como quien comprueba un resultado."
    narrador "She smiled like someone checking a result."

# game/02_cap1_conexiones.rpy:1825
translate english cap1_interconexion_3_62668801:

    # narrador "Yotsuba levantó el brazo desde su sitio: otro tiempo anotado en la muñeca."
    narrador "Yotsuba held her arm up from her seat: another time scribbled on her wrist."

# game/02_cap1_conexiones.rpy:1829
translate english cap1_interconexion_3_30394fd9:

    # narrador "Después volvió a su sitio y se puso a ordenar la mochila. No me miró más."
    narrador "Then she turned back to her bag and started sorting it. She didn't look at me again."

# game/02_cap1_conexiones.rpy:1837
translate english cap1_interconexion_3_aa9757b6:

    # narrador "Nino me buscó con la mirada. La apartó antes de que la pillara."
    narrador "Nino looked for me. She looked away before I could catch her."

# game/02_cap1_conexiones.rpy:1841
translate english cap1_interconexion_3_0faba329:

    # narrador "[nombre_h!t] me buscó con la mirada desde su sitio y sonrió, apenas."
    narrador "[nombre_h!t] looked for me from her seat and smiled, barely."

# game/02_cap1_conexiones.rpy:1845
translate english cap1_interconexion_3_8f58be97:

    # narrador "[nombre_h!t] me saludó con un gesto corto. Nada más, nada menos."
    narrador "[nombre_h!t] gave me a short nod. Nothing more, nothing less."

# game/02_cap1_conexiones.rpy:1849
translate english cap1_interconexion_3_44ae0bf6:

    # narrador "[nombre_h!t] se puso a ordenar su mochila cuando pasé por su lado."
    narrador "[nombre_h!t] started sorting her bag when I walked past."

# game/02_cap1_conexiones.rpy:1857
translate english cap1_interconexion_3_b3df9cbb:

    # narrador "Itsuki seguía en su pupitre, con el cuaderno abierto en la misma página."
    narrador "Itsuki was still at her desk, notebook open to the same page."

# game/02_cap1_conexiones.rpy:1861
translate english cap1_interconexion_3_5bc33b84:

    # narrador "Itsuki seguía en su pupitre, con el cuaderno de ciencias cerrado."
    narrador "Itsuki was still at her desk, her science notebook closed."

# game/02_cap1_conexiones.rpy:1866
translate english cap1_interconexion_3_d33b287a:

    # itsuki "El juego sigue."
    itsuki "The game's still on."

# game/02_cap1_conexiones.rpy:1868
translate english cap1_interconexion_3_50d8828a:

    # mc "Lo sé."
    mc "I know."

# game/02_cap1_conexiones.rpy:1870
translate english cap1_interconexion_3_57599b99:

    # itsuki "No me importa a quién elijas."
    itsuki "I don't care who you pick."

# game/02_cap1_conexiones.rpy:1872
translate english cap1_interconexion_3_a16cb3a1:

    # itsuki "Solo digo que el reloj no espera."
    itsuki "I'm only saying the clock doesn't wait."

# game/02_cap1_conexiones.rpy:1874
translate english cap1_interconexion_3_274ae7cf:

    # itsuki "Y cada uno lo sabe."
    itsuki "And everyone knows it."

# game/02_cap1_conexiones.rpy:1883
translate english cap1_interconexion_3_31e49dd2:

    # mc_pensamiento "Todas se marcharon, esperando que yo dé el siguiente paso."
    mc_pensamiento "They all left, waiting for me to make the next move."

# game/02_cap1_conexiones.rpy:1893
translate english cap1_interconexion_3_ad2caf02:

    # mc_pensamiento "Itsuki tenía razón. Siempre la tiene cuando habla así."
    mc_pensamiento "Itsuki was right. She always is when she talks like that."

# game/02_cap1_conexiones.rpy:1895
translate english cap1_interconexion_3_2bc359c9:

    # mc_pensamiento "Dos tardes libres. Cuatro hermanas por alcanzar."
    mc_pensamiento "Two free afternoons. Four sisters left to reach."

# game/02_cap1_conexiones.rpy:1897
translate english cap1_interconexion_3_1c7fd4ec:

    # mc_pensamiento "Cada tarde que le brindo a una es una tarde que no tienen las demás."
    mc_pensamiento "Every afternoon I give one of them is an afternoon the others don't get."

# game/02_cap1_conexiones.rpy:1899
translate english cap1_interconexion_3_7e31de5a:

    # mc "Bien. A ver a quién busco hoy."
    mc "Okay. Let's see who I go looking for today."

# game/02_cap1_conexiones.rpy:1925
translate english cap1_interconexion_4_3c22b34c:

    # narrador "Entré a mi habitación y me quedé un rato con la luz apagada."
    narrador "I went into my room and stayed a while with the light off."

# game/02_cap1_conexiones.rpy:1929
translate english cap1_interconexion_4_ca2252d0:

    # mc_pensamiento "Esta vez no tuve que repasar nada antes de dormirme."
    mc_pensamiento "This time I didn't have to replay anything before falling asleep."

# game/02_cap1_conexiones.rpy:1931
translate english cap1_interconexion_4_fe4162cb:

    # mc_pensamiento "Con [nombre_h!t] encontré por dónde entrar."
    mc_pensamiento "With [nombre_h!t], I found a way in."

# game/02_cap1_conexiones.rpy:1933
translate english cap1_interconexion_4_9fe10580:

    # mc_pensamiento "No sé si sabré hacerlo otra vez. Con la siguiente, la puerta será otra."
    mc_pensamiento "I don't know if I can do it again. With the next one, the door will be different."

# game/02_cap1_conexiones.rpy:1937
translate english cap1_interconexion_4_8672dc3f:

    # mc_pensamiento "Dormí a ratos."
    mc_pensamiento "I slept in snatches."

# game/02_cap1_conexiones.rpy:1939
translate english cap1_interconexion_4_324d256b:

    # mc_pensamiento "Con [nombre_h!t] no gané nada. Tampoco perdí nada."
    mc_pensamiento "I didn't gain anything with [nombre_h!t]. I didn't lose anything, either."

# game/02_cap1_conexiones.rpy:1941
translate english cap1_interconexion_4_bbf469a2:

    # mc_pensamiento "Con ellas, eso ya es un resultado. No sé si bueno."
    mc_pensamiento "With them, that counts as a result. I don't know if it's a good one."

# game/02_cap1_conexiones.rpy:1945
translate english cap1_interconexion_4_f59ade1e:

    # mc_pensamiento "Otra noche dándole vueltas a lo mismo."
    mc_pensamiento "Another night going over the same thing."

# game/02_cap1_conexiones.rpy:1947
translate english cap1_interconexion_4_f7ee22bb:

    # mc_pensamiento "A [nombre_h!t] le dije lo que me pareció correcto."
    mc_pensamiento "I told [nombre_h!t] what seemed right to me."

# game/02_cap1_conexiones.rpy:1949
translate english cap1_interconexion_4_7e8000bb:

    # mc_pensamiento "Correcto no es lo mismo que útil. Lo estoy aprendiendo tarde."
    mc_pensamiento "Right isn't the same as useful. I'm learning that late."

# game/02_cap1_conexiones.rpy:1952
translate english cap1_interconexion_4_f0cba07e:

    # mc_pensamiento "Dos de cinco. Y el calendario seguía corriendo."
    mc_pensamiento "Two out of five. And the calendar kept running."

# game/02_cap1_conexiones.rpy:1963
translate english cap1_interconexion_4_0c86a748:

    # narrador "De camino al instituto, la cabeza no me dejaba en paz."
    narrador "On the way to school, my head wouldn't leave me alone."

# game/02_cap1_conexiones.rpy:1965
translate english cap1_interconexion_4_b7594b72:

    # mc_pensamiento "No sé si es por mi falta de sueño."
    mc_pensamiento "I don't know if it's the lack of sleep."

# game/02_cap1_conexiones.rpy:1967
translate english cap1_interconexion_4_0a766f00:

    # mc_pensamiento "O por todos los días que llevo aguantando a esas cinco."
    mc_pensamiento "Or all the days I've spent putting up with those five."

# game/02_cap1_conexiones.rpy:1971
translate english cap1_interconexion_4_229c36bd:

    # mc_pensamiento "Cuatro cuadras hasta el instituto. Y la cabeza que no se calla." nointeract
    mc_pensamiento "Four blocks to school. And my head won't shut up." nointeract

# game/02_cap1_conexiones.rpy:1975
translate english cap1_interconexion_4_bcb4c330:

    # mc_pensamiento "Eso es peligroso."
    mc_pensamiento "That's dangerous."

# game/02_cap1_conexiones.rpy:1977
translate english cap1_interconexion_4_042da6ee:

    # mc_pensamiento "Raiha ya me lo dijo. Debo cuidar mi salud."
    mc_pensamiento "Raiha already told me. I need to look after my health."

# game/02_cap1_conexiones.rpy:1979
translate english cap1_interconexion_4_f8816c79:

    # mc_pensamiento "Pero con este cronograma, es imposible."
    mc_pensamiento "But with this schedule, it's impossible."

# game/02_cap1_conexiones.rpy:1981
translate english cap1_interconexion_4_44b3695d:

    # mc_pensamiento "Lo peor es que ya no se siente raro."
    mc_pensamiento "The worst part is it doesn't feel strange anymore."

# game/02_cap1_conexiones.rpy:1985
translate english cap1_interconexion_4_7f819599:

    # mc_pensamiento "Seguro lo tienen. Seguro tiene un nombre ridículo."
    mc_pensamiento "They must have one. It must have a ridiculous name."

# game/02_cap1_conexiones.rpy:1987
translate english cap1_interconexion_4_81a1b2a8:

    # mc_pensamiento "Seguro me andan humillando de la peor manera posible."
    mc_pensamiento "They're probably humiliating me in the worst way possible."

# game/02_cap1_conexiones.rpy:1989
translate english cap1_interconexion_4_0362d995:

    # mc_pensamiento "O inventándome apodos tontos."
    mc_pensamiento "Or coming up with dumb nicknames for me."

# game/02_cap1_conexiones.rpy:1991
translate english cap1_interconexion_4_fffe4534:

    # mc_pensamiento "Solo espero no lo publiquen en algún lado."
    mc_pensamiento "I just hope they don't post it anywhere."

# game/02_cap1_conexiones.rpy:1995
translate english cap1_interconexion_4_8051d02e:

    # mc_pensamiento "Me concedí cuatro cuadras de silencio."
    mc_pensamiento "I gave myself four blocks of silence."

# game/02_cap1_conexiones.rpy:1997
translate english cap1_interconexion_4_d4600924:

    # mc_pensamiento "Con mi agenda, es casi un lujo."
    mc_pensamiento "With my schedule, that's almost a luxury."

# game/02_cap1_conexiones.rpy:2008
translate english cap1_interconexion_4_e5c2116f:

    # narrador "En el aula, algunas ya estaban en sus pupitres y otras entraban de a una."
    narrador "Some of them were already at their desks; others were trickling in one by one."

# game/02_cap1_conexiones.rpy:2010
translate english cap1_interconexion_4_c08f775c:

    # narrador "De repente, [nombre_h!t] se me cruzó en el camino."
    narrador "Out of nowhere, [nombre_h!t] stepped into my path."

# game/02_cap1_conexiones.rpy:2033
translate english cap1_interconexion_4_b1526bae:

    # yotsuba "¡Tutor! ¡Ven un momento!"
    yotsuba "Tutor! Come here a second!"

# game/02_cap1_conexiones.rpy:2037
translate english cap1_interconexion_4_894e9a89:

    # yotsuba "¡[mc]! ¡Ven un momento!"
    yotsuba "[mc]! Come here a second!"

# game/02_cap1_conexiones.rpy:2039
translate english cap1_interconexion_4_416078c5:

    # yotsuba "¡Es un secreto! ¡Rápido!"
    yotsuba "It's a secret! Hurry!"

# game/02_cap1_conexiones.rpy:2041
translate english cap1_interconexion_4_5ececab6:

    # yotsuba "[nombre_h!t] se quedó despierta hasta tarde."
    yotsuba "[nombre_h!t] stayed up late."

# game/02_cap1_conexiones.rpy:2043
translate english cap1_interconexion_4_8e74d151:

    # yotsuba "No estaba estudiando. Estaba como... pensando con una sonrisa."
    yotsuba "She wasn't studying. She was, like... thinking with a smile."

# game/02_cap1_conexiones.rpy:2047
translate english cap1_interconexion_4_ef8a5295:

    # yotsuba "¡Yo sé distinguir! Alguien me dijo que eso cuenta."
    yotsuba "I can tell the difference! Somebody told me that counts."

# game/02_cap1_conexiones.rpy:2051
translate english cap1_interconexion_4_c564721c:

    # yotsuba "¡Yo sé distinguir! ...Bueno, eso lo nota cualquiera."
    yotsuba "I can tell the difference! ...Okay, anyone could notice that."

# game/02_cap1_conexiones.rpy:2053
translate english cap1_interconexion_4_25ee420d:

    # mc "¿Qué quieres decir?"
    mc "What do you mean?"

# game/02_cap1_conexiones.rpy:2055
translate english cap1_interconexion_4_4890d4fe:

    # yotsuba "Que lo que le dijiste, o lo que hiciste, le dejó algo bueno por dentro."
    yotsuba "That whatever you said, or did, left something good inside her."

# game/02_cap1_conexiones.rpy:2057
translate english cap1_interconexion_4_4389cf42:

    # yotsuba "Gracias por no rendirte con ella. ¡Es todo!"
    yotsuba "Thanks for not giving up on her. That's all!"

# game/02_cap1_conexiones.rpy:2061
translate english cap1_interconexion_4_dbd24b8e:

    # narrador "Antes de irse me miró la muñeca. El «1» ya casi no se veía."
    narrador "Before leaving she looked at my wrist. The \"1\" was almost gone."

# game/02_cap1_conexiones.rpy:2063
translate english cap1_interconexion_4_afb2bff9:

    # narrador "No dijo nada de eso. Se fue dando saltitos, igual que siempre."
    narrador "She didn't say anything about it. She skipped off, same as always."

# game/02_cap1_conexiones.rpy:2075
translate english cap1_interconexion_4_452e637b:

    # yotsuba "¡Tutor! [nombre_h!t] está igual que siempre."
    yotsuba "Tutor! [nombre_h!t] is the same as ever."

# game/02_cap1_conexiones.rpy:2079
translate english cap1_interconexion_4_11774129:

    # yotsuba "¡[mc]! [nombre_h!t] está igual que siempre."
    yotsuba "[mc]! [nombre_h!t] is the same as ever."

# game/02_cap1_conexiones.rpy:2081
translate english cap1_interconexion_4_a74c6d59:

    # yotsuba "¡Y eso está bien! ¡A veces igual es lo mejor que se puede pedir!"
    yotsuba "And that's good! Sometimes the same is the best you can ask for!"

# game/02_cap1_conexiones.rpy:2083
translate english cap1_interconexion_4_e51d9344:

    # narrador "Lo dijo sonriendo. Pero la sonrisa tardó en llegar a sus ojos."
    narrador "She said it smiling. But the smile took a while to reach her eyes."

# game/02_cap1_conexiones.rpy:2088
translate english cap1_interconexion_4_2a90e30e:

    # yotsuba "...Es que no sé si le sirvió o no. Y eso me da un poco de cosa."
    yotsuba "...It's just, I can't tell if it helped her or not. And that bugs me a little."

# game/02_cap1_conexiones.rpy:2090
translate english cap1_interconexion_4_b3961c59:

    # mc "¿Por qué?"
    mc "Why?"

# game/02_cap1_conexiones.rpy:2092
translate english cap1_interconexion_4_e1a11e1e:

    # yotsuba "Porque yo siempre sé. Y esta vez, no."
    yotsuba "Because I always know. And this time, I don't."

# game/02_cap1_conexiones.rpy:2104
translate english cap1_interconexion_4_7761fe61:

    # yotsuba "Tutor. ¿Tienes un minuto?"
    yotsuba "Tutor. Got a minute?"

# game/02_cap1_conexiones.rpy:2108
translate english cap1_interconexion_4_272683a7:

    # yotsuba "[mc]. ¿Tienes un minuto?"
    yotsuba "[mc]. Got a minute?"

# game/02_cap1_conexiones.rpy:2110
translate english cap1_interconexion_4_611d979e:

    # narrador "Lo dijo sin levantar la voz. Sin sonrisa."
    narrador "She said it without raising her voice. Without a smile."

# game/02_cap1_conexiones.rpy:2112
translate english cap1_interconexion_4_3e1d7331:

    # narrador "En el aula, delante de todas, era la primera vez que la veía así."
    narrador "In the classroom, in front of everyone, it was the first time I'd seen her like this."

# game/02_cap1_conexiones.rpy:2114
translate english cap1_interconexion_4_0b262548:

    # yotsuba "[nombre_h!t] no durmió bien. Se le nota en cómo sostiene el lápiz."
    yotsuba "[nombre_h!t] didn't sleep well. You can tell by how she's holding her pencil."

# game/02_cap1_conexiones.rpy:2116
translate english cap1_interconexion_4_541e188f:

    # yotsuba "Yo la conozco, y tal vez lo que le dijiste... le dolió."
    yotsuba "I know her, and maybe what you said... hurt her."

# game/02_cap1_conexiones.rpy:2118
translate english cap1_interconexion_4_90dc535e:

    # yotsuba "No te lo digo para que te sientas mal."
    yotsuba "I'm not telling you so you'll feel bad."

# game/02_cap1_conexiones.rpy:2120
translate english cap1_interconexion_4_fdcd6e76:

    # yotsuba "Te lo digo porque ella nunca lo va a decir."
    yotsuba "I'm telling you because she'll never say it."

# game/02_cap1_conexiones.rpy:2122
translate english cap1_interconexion_4_9c808ccb:

    # mc_pensamiento "Me dolió más que un reproche."
    mc_pensamiento "That stung more than a scolding would have."

# game/02_cap1_conexiones.rpy:2124
translate english cap1_interconexion_4_de659e7a:

    # mc_pensamiento "Yotsuba nunca reprocha: solo informa."
    mc_pensamiento "Yotsuba never scolds. She just reports."

# game/02_cap1_conexiones.rpy:2126
translate english cap1_interconexion_4_331901a2:

    # yotsuba "Arréglalo. Por favor."
    yotsuba "Fix it. Please."

# game/02_cap1_conexiones.rpy:2146
translate english cap1_interconexion_4_f035498d:

    # miku "Hola, [mc]."
    miku "Hi, [mc]."

# game/02_cap1_conexiones.rpy:2148
translate english cap1_interconexion_4_ad7b9d46:

    # narrador "Me saludó sin pausa antes de la primera palabra."
    narrador "She greeted me without the usual pause before the first word."

# game/02_cap1_conexiones.rpy:2150
translate english cap1_interconexion_4_c383d435:

    # narrador "Eso ya era un cambio."
    narrador "That was already a change."

# game/02_cap1_conexiones.rpy:2154
translate english cap1_interconexion_4_a86abf7f:

    # miku "...Hola, [mc]."
    miku "...Hi, [mc]."

# game/02_cap1_conexiones.rpy:2156
translate english cap1_interconexion_4_7c97d59f:

    # miku "...Tienes un número escrito en la muñeca."
    miku "...You have a number written on your wrist."

# game/02_cap1_conexiones.rpy:2158
translate english cap1_interconexion_4_81a73623:

    # miku "...Un uno. Con algo al lado. Torcido."
    miku "...A one. With something next to it. Crooked."

# game/02_cap1_conexiones.rpy:2160
translate english cap1_interconexion_4_3b2082ca:

    # mc "Es largo de explicar."
    mc "Long story."

# game/02_cap1_conexiones.rpy:2162
translate english cap1_interconexion_4_d01770c6:

    # miku "...Anoche oí a Yotsuba a través de la pared. Decía números dormida."
    miku "...Last night I heard Yotsuba through the wall. She was saying numbers in her sleep."

# game/02_cap1_conexiones.rpy:2164
translate english cap1_interconexion_4_7686a756:

    # miku "...Y sonreía."
    miku "...And smiling."

# game/02_cap1_conexiones.rpy:2169
translate english cap1_interconexion_4_f9117a4a:

    # miku "...Hoy tú tienes uno en el brazo."
    miku "...Today you have one on your arm."

# game/02_cap1_conexiones.rpy:2171
translate english cap1_interconexion_4_fb28faf5:

    # miku "...No creo que sea casualidad."
    miku "...I don't think that's a coincidence."

# game/02_cap1_conexiones.rpy:2173
translate english cap1_interconexion_4_8a71abfb:

    # miku "...Está más rara de lo normal. Pero contenta."
    miku "...She's weirder than usual. But happy."

# game/02_cap1_conexiones.rpy:2175
translate english cap1_interconexion_4_fb00e969:

    # miku "...Eso casi no pasa."
    miku "...That hardly ever happens."

# game/02_cap1_conexiones.rpy:2177
translate english cap1_interconexion_4_6e7b3533:

    # mc "Me alegra."
    mc "I'm glad."

# game/02_cap1_conexiones.rpy:2182
translate english cap1_interconexion_4_63ff33ab:

    # miku "...No es por ti."
    miku "...It's not because of you."

# game/02_cap1_conexiones.rpy:2184
translate english cap1_interconexion_4_c6f13d0e:

    # miku "...Bueno. Un poco."
    miku "...Well. A little."

# game/02_cap1_conexiones.rpy:2188
translate english cap1_interconexion_4_39ba438f:

    # miku "...A ella le dejaste un número."
    miku "...You left her with a number."

# game/02_cap1_conexiones.rpy:2190
translate english cap1_interconexion_4_96d490c6:

    # miku "...A mí me debes una página."
    miku "...You owe me a page."

# game/02_cap1_conexiones.rpy:2192
translate english cap1_interconexion_4_c96179a9:

    # narrador "No sonó a reproche. Sonó a algo que llevaba un rato pensando."
    narrador "It didn't sound like a reproach. It sounded like something she'd been thinking about for a while."

# game/02_cap1_conexiones.rpy:2202
translate english cap1_interconexion_4_439ee237:

    # miku "...Buenos días, [mc]."
    miku "...Good morning, [mc]."

# game/02_cap1_conexiones.rpy:2204
translate english cap1_interconexion_4_dcafd669:

    # narrador "Lo dijo mirándome una vez. Después volvió al libro."
    narrador "She said it looking at me once. Then she went back to her book."

# game/02_cap1_conexiones.rpy:2206
translate english cap1_interconexion_4_364de503:

    # miku "...Yotsuba llegó anoche a la hora de siempre."
    miku "...Yotsuba got home at the usual time last night."

# game/02_cap1_conexiones.rpy:2208
translate english cap1_interconexion_4_e19bbf2c:

    # miku "...Cenó dos platos. Hizo ruido. Normal."
    miku "...She ate two plates. Made noise. Normal."

# game/02_cap1_conexiones.rpy:2210
translate english cap1_interconexion_4_88a8a0d0:

    # miku "...Tenía números escritos en el brazo. Como siempre."
    miku "...She had numbers written on her arm. Like always."

# game/02_cap1_conexiones.rpy:2212
translate english cap1_interconexion_4_6ef92eb6:

    # miku "...Pero esta vez se los quedó mirando un buen rato antes de lavárselos."
    miku "...But this time she stared at them for a good while before washing them off."

# game/02_cap1_conexiones.rpy:2214
translate english cap1_interconexion_4_2fe105d3:

    # mc "¿Y qué significa eso?"
    mc "And what does that mean?"

# game/02_cap1_conexiones.rpy:2216
translate english cap1_interconexion_4_c9fd3864:

    # miku "...No sé. No es mi sección."
    miku "...I don't know. It's not my section."

# game/02_cap1_conexiones.rpy:2218
translate english cap1_interconexion_4_0e06458b:

    # miku "...Ayer te tocaba tu juego, ¿no? ...Solo pregunto."
    miku "...Yesterday was one of your afternoons, right? ...Just asking."

# game/02_cap1_conexiones.rpy:2225
translate english cap1_interconexion_4_b2bb9404:

    # narrador "Tenía los audífonos a medias: una oreja libre y la otra no."
    narrador "She had her headphones half on: one ear free, the other not."

# game/02_cap1_conexiones.rpy:2230
translate english cap1_interconexion_4_f1a7b3fc:

    # miku "...Hola."
    miku "...Hi."

# game/02_cap1_conexiones.rpy:2232
translate english cap1_interconexion_4_b7c6b103:

    # mc "Hola, Miku."
    mc "Hi, Miku."

# game/02_cap1_conexiones.rpy:2234
translate english cap1_interconexion_4_8877e7a4:

    # miku "...Yotsuba llegó tarde anoche. Con el brazo lleno de rotulador."
    miku "...Yotsuba got home late last night. Arm covered in marker."

# game/02_cap1_conexiones.rpy:2236
translate english cap1_interconexion_4_88a4594f:

    # miku "...No se lo lavó. Se acostó con él."
    miku "...She didn't wash it off. She went to bed with it on."

# game/02_cap1_conexiones.rpy:2238
translate english cap1_interconexion_4_f18ab57f:

    # miku "...No hizo ruido en toda la cena."
    miku "...She didn't make a sound all through dinner."

# game/02_cap1_conexiones.rpy:2240
translate english cap1_interconexion_4_9dc2c8c9:

    # miku "...Yotsuba siempre hace ruido. Aunque nadie se lo pida."
    miku "...Yotsuba always makes noise. Even when nobody asks her to."

# game/02_cap1_conexiones.rpy:2242
translate english cap1_interconexion_4_e0bfb754:

    # narrador "Lo dijo mirando el libro. Pero las páginas no se movían."
    narrador "She said it looking at her book. But the pages weren't turning."

# game/02_cap1_conexiones.rpy:2244
translate english cap1_interconexion_4_5fed8868:

    # miku "...No sé si fuiste tú. Ayer te tocaba tu juego."
    miku "...I don't know if it was you. Yesterday was one of your afternoons."

# game/02_cap1_conexiones.rpy:2246
translate english cap1_interconexion_4_ae4dccd9:

    # miku "...Pero si fuiste tú, no lo dejes así."
    miku "...But if it was you, don't leave it like that."

# game/02_cap1_conexiones.rpy:2260
translate english cap1_interconexion_4_3c474827:

    # narrador "El resto de la mañana pasó entre apuntes y miradas de reojo."
    narrador "The rest of the morning went by in notes and sideways glances."

# game/02_cap1_conexiones.rpy:2262
translate english cap1_interconexion_4_679a4c28:

    # narrador "Terminadas las clases, noté que el pupitre de Nino estaba vacío."
    narrador "When classes ended, I noticed Nino's desk was empty."

# game/02_cap1_conexiones.rpy:2266
translate english cap1_interconexion_4_e4e42332:

    # narrador "Su mochila ya no estaba."
    narrador "Her bag was gone."

# game/02_cap1_conexiones.rpy:2274
translate english cap1_interconexion_4_6e8dceb4:

    # narrador "Las otras cuatro seguían ahí."
    narrador "The other four were still there."

# game/02_cap1_conexiones.rpy:2276
translate english cap1_interconexion_4_c69a3877:

    # narrador "El hueco entre Ichika y Miku se notaba más que cualquier cosa que dijeran."
    narrador "The gap between Ichika and Miku stood out more than anything they said."

# game/02_cap1_conexiones.rpy:2278
translate english cap1_interconexion_4_f19c45ec:

    # mc "Disculpen, chicas."
    mc "Excuse me, girls."

# game/02_cap1_conexiones.rpy:2280
translate english cap1_interconexion_4_476957d0:

    # mc "¿Alguien sabe dónde está Nino?"
    mc "Does anyone know where Nino is?"

# game/02_cap1_conexiones.rpy:2288
translate english cap1_interconexion_4_7b8d1988:

    # ichika "Te ves muy preocupado por Nino, ¿no, [mc]?"
    ichika "You seem awfully worried about Nino, huh, [mc]?"

# game/02_cap1_conexiones.rpy:2290
translate english cap1_interconexion_4_d49165f8:

    # ichika "¿Acaso hay algo entre ustedes dos?"
    ichika "Is there something going on between you two?"

# game/02_cap1_conexiones.rpy:2294
translate english cap1_interconexion_4_87a477f1:

    # narrador "Lo preguntó en broma. Pero se quedó esperando la respuesta un segundo de más."
    narrador "She asked it as a joke. But she waited for the answer a second too long."

# game/02_cap1_conexiones.rpy:2296
translate english cap1_interconexion_4_845facf9:

    # mc "Ve al grano, Ichika."
    mc "Get to the point, Ichika."

# game/02_cap1_conexiones.rpy:2301
translate english cap1_interconexion_4_70881c8f:

    # ichika "Pues salió de manera apresurada."
    ichika "Well, she left in a hurry."

# game/02_cap1_conexiones.rpy:2303
translate english cap1_interconexion_4_b1932f75:

    # ichika "Con el celular en la mano y esa cara que ya conoces."
    ichika "Phone in hand, with that look you already know."

# game/02_cap1_conexiones.rpy:2305
translate english cap1_interconexion_4_ee399da7:

    # ichika "Dijo que iba a hablar de algo urgente con nuestro papá."
    ichika "She said she was going to talk to our dad about something urgent."

# game/02_cap1_conexiones.rpy:2307
translate english cap1_interconexion_4_77907a47:

    # ichika "Si a la noche no ha vuelto, la llamo yo. A mí siempre me contesta."
    ichika "If she's not back tonight, I'll call her. She always picks up for me."

# game/02_cap1_conexiones.rpy:2309
translate english cap1_interconexion_4_3cb4325a:

    # ichika "...Al tercer intento. Pero me contesta."
    ichika "...On the third try. But she picks up."

# game/02_cap1_conexiones.rpy:2315
translate english cap1_interconexion_4_d2e1dfbe:

    # yotsuba "¡Seguro se reunirán en nuestra casa!"
    yotsuba "They're probably meeting at our place!"

# game/02_cap1_conexiones.rpy:2317
translate english cap1_interconexion_4_7e69e35d:

    # yotsuba "Ya sé. ¡Nos planean hacer una cena sorpresa!"
    yotsuba "I know! They're planning a surprise dinner for us!"

# game/02_cap1_conexiones.rpy:2322
translate english cap1_interconexion_4_3dbec2ee:

    # yotsuba "...Aunque cuando sale así, es porque es un asunto serio."
    yotsuba "...Although when she storms off like that, it means something serious."

# game/02_cap1_conexiones.rpy:2328
translate english cap1_interconexion_4_011dcce6:

    # miku "...Miró el celular y se quedó quieta."
    miku "...She looked at her phone and went still."

# game/02_cap1_conexiones.rpy:2330
translate english cap1_interconexion_4_dc532a68:

    # miku "...Nino nunca se queda quieta."
    miku "...Nino never goes still."

# game/02_cap1_conexiones.rpy:2336
translate english cap1_interconexion_4_11601e0d:

    # yotsuba "...Puede que sea culpa mía."
    yotsuba "...Maybe it's my fault."

# game/02_cap1_conexiones.rpy:2338
translate english cap1_interconexion_4_9c2ee829:

    # yotsuba "Esta mañana armé un grupo de chat. Las cinco... y tú."
    yotsuba "This morning I made a group chat. The five of us... and you."

# game/02_cap1_conexiones.rpy:2340
translate english cap1_interconexion_4_b4cbe453:

    # yotsuba "Le puse «¡Equipo Quintillizas + Tutor!»."
    yotsuba "I named it \"Team Quintuplets + Tutor!\""

# game/02_cap1_conexiones.rpy:2342
translate english cap1_interconexion_4_16bbc85d:

    # yotsuba "Nino lo leyó y se fue."
    yotsuba "Nino read it and left."

# game/02_cap1_conexiones.rpy:2344
translate english cap1_interconexion_4_2a3de0fc:

    # narrador "Saqué el celular."
    narrador "I took out my phone."

# game/02_cap1_conexiones.rpy:2348
translate english cap1_interconexion_4_9676bfff:

    # narrador "Era verdad. Ahí estaba: un grupo nuevo, y mi número al final."
    narrador "It was true. There it was: a new group, and my number at the end."

# game/02_cap1_conexiones.rpy:2350
translate english cap1_interconexion_4_799a15b7:

    # mc_pensamiento "No era un grupo para burlarse de mí."
    mc_pensamiento "It wasn't a group made to make fun of me."

# game/02_cap1_conexiones.rpy:2352
translate english cap1_interconexion_4_e8f178f6:

    # mc_pensamiento "Era peor: me incluía."
    mc_pensamiento "It was worse: it included me."

# game/02_cap1_conexiones.rpy:2361
translate english cap1_interconexion_4_06bec85a:

    # itsuki "Nino no se va sin avisar. Es un hecho."
    itsuki "Nino doesn't leave without telling anyone. That's a fact."

# game/02_cap1_conexiones.rpy:2363
translate english cap1_interconexion_4_0cf6d4f7:

    # itsuki "Si se fue, tiene un motivo."
    itsuki "If she left, she has a reason."

# game/02_cap1_conexiones.rpy:2365
translate english cap1_interconexion_4_5ef00515:

    # itsuki "No es asunto tuyo. Pero tampoco es casualidad."
    itsuki "It's not your business. But it isn't a coincidence, either."

# game/02_cap1_conexiones.rpy:2367
translate english cap1_interconexion_4_4c4a805c:

    # itsuki "Y la hipótesis más probable eres tú."
    itsuki "And the most likely hypothesis is you."

# game/02_cap1_conexiones.rpy:2372
translate english cap1_interconexion_4_e5a8d4dd:

    # narrador "Nadie dijo nada más."
    narrador "Nobody said anything else."

# game/02_cap1_conexiones.rpy:2374
translate english cap1_interconexion_4_f8835cc3:

    # narrador "Las cuatro me miraron, y las cuatro apartaron la vista casi al mismo tiempo."
    narrador "All four of them looked at me, and all four looked away at almost the same moment."

# game/02_cap1_conexiones.rpy:2382
translate english cap1_interconexion_4_c65ead32:

    # mc_pensamiento "Nino no era de las que se iban sin avisar."
    mc_pensamiento "Nino wasn't the type to leave without telling anyone."

# game/02_cap1_conexiones.rpy:2384
translate english cap1_interconexion_4_21465703:

    # mc_pensamiento "Y menos sin dejarme una frase hiriente de despedida."
    mc_pensamiento "And certainly not without leaving me a cutting parting remark."

# game/02_cap1_conexiones.rpy:2386
translate english cap1_interconexion_4_f02ea8fa:

    # mc_pensamiento "Las cuatro lo habían notado. Cada una a su manera."
    mc_pensamiento "All four had noticed. Each in her own way."

# game/02_cap1_conexiones.rpy:2388
translate english cap1_interconexion_4_fbf5dd89:

    # mc_pensamiento "Como dijo Yotsuba, debe estar en su casa con Maruo."
    mc_pensamiento "Like Yotsuba said, she must be home with Maruo."

# game/02_cap1_conexiones.rpy:2390
translate english cap1_interconexion_4_bba0c283:

    # mc_pensamiento "Tengo el presentimiento de que esta tarde va a ser más larga de lo normal."
    mc_pensamiento "I have a feeling this afternoon is going to be longer than usual."

# game/02_cap1_conexiones.rpy:2421
translate english cap1_interconexion_5_e4145c7d:

    # narrador "Llegué a casa y fui directamente a mi cuarto."
    narrador "I got home and went straight to my room."

# game/02_cap1_conexiones.rpy:2423
translate english cap1_interconexion_5_cbd975c3:

    # mc_pensamiento "Me quedé pensando en la discusión que hubo entre Nino y su padre."
    mc_pensamiento "I kept thinking about the argument between Nino and her father."

# game/02_cap1_conexiones.rpy:2425
translate english cap1_interconexion_5_029169f5:

    # mc_pensamiento "Y en lo que le dije yo después."
    mc_pensamiento "And what I said to her afterward."

# game/02_cap1_conexiones.rpy:2429
translate english cap1_interconexion_5_63f04799:

    # mc_pensamiento "Creo que terminamos en buenas condiciones."
    mc_pensamiento "I think we ended on decent terms."

# game/02_cap1_conexiones.rpy:2431
translate english cap1_interconexion_5_c80bf177:

    # mc_pensamiento "Aun así, no dejaba de darle vueltas a lo que le solté a Nino en la cocina."
    mc_pensamiento "Still, I couldn't stop turning over what I'd blurted out to Nino in the kitchen."

# game/02_cap1_conexiones.rpy:2433
translate english cap1_interconexion_5_c6e26eb3:

    # mc_pensamiento "Se quedó en silencio... pero tampoco me devolvió la pregunta."
    mc_pensamiento "She went quiet... but she didn't throw the question back at me, either."

# game/02_cap1_conexiones.rpy:2437
translate english cap1_interconexion_5_4e4baa8e:

    # mc_pensamiento "Al final solo lavé una taza y ya."
    mc_pensamiento "In the end I just washed a cup, and that was it."

# game/02_cap1_conexiones.rpy:2439
translate english cap1_interconexion_5_a8c9c411:

    # mc_pensamiento "Ninguno dijo nada que valiera la pena."
    mc_pensamiento "Neither of us said anything worth saying."

# game/02_cap1_conexiones.rpy:2441
translate english cap1_interconexion_5_b3b7e9cb:

    # mc_pensamiento "Supongo que a veces el silencio es lo único que cabe entre dos personas."
    mc_pensamiento "I guess sometimes silence is the only thing that fits between two people."

# game/02_cap1_conexiones.rpy:2445
translate english cap1_interconexion_5_1f301da6:

    # mc_pensamiento "Y lo que no debí haberle dicho."
    mc_pensamiento "And what I shouldn't have said to her."

# game/02_cap1_conexiones.rpy:2447
translate english cap1_interconexion_5_27a8bb27:

    # mc_pensamiento "La frase que le tiré a Nino sonaba increíble en mi cabeza."
    mc_pensamiento "The line I threw at Nino sounded great in my head."

# game/02_cap1_conexiones.rpy:2449
translate english cap1_interconexion_5_e200a069:

    # mc_pensamiento "En su cocina fue un desastre."
    mc_pensamiento "In her kitchen it was a disaster."

# game/02_cap1_conexiones.rpy:2451
translate english cap1_interconexion_5_3823885b:

    # mc_pensamiento "Y ya no había forma de echarse atrás."
    mc_pensamiento "And there was no way to take it back."

# game/02_cap1_conexiones.rpy:2455
translate english cap1_interconexion_5_2929260d:

    # mc_pensamiento "Pero lo peor de todo es lo que me dijo Maruo."
    mc_pensamiento "But the worst part was what Maruo told me."

# game/02_cap1_conexiones.rpy:2457
translate english cap1_interconexion_5_00efff6b:

    # mc_pensamiento "«Se acabó. Ese día no hay discusión ni segunda oportunidad.»"
    mc_pensamiento "\"It is over. On that day there is no discussion and no second chance.\""

# game/02_cap1_conexiones.rpy:2459
translate english cap1_interconexion_5_e1eaa35c:

    # mc_pensamiento "Maruo no es de los que repiten las cosas. Su voz me seguía zumbando en la cabeza."
    mc_pensamiento "Maruo isn't the type to repeat himself. His voice kept ringing in my head."

# game/02_cap1_conexiones.rpy:2463
translate english cap1_interconexion_5_359644ba:

    # mc_pensamiento "El lado positivo es que Maruo parece seguir confiando en mí."
    mc_pensamiento "The bright side is that Maruo still seems to trust me."

# game/02_cap1_conexiones.rpy:2465
translate english cap1_interconexion_5_0b32692e:

    # mc_pensamiento "No había soltado nada nuevo. Pero el reloj no para."
    mc_pensamiento "He hadn't said anything new. But the clock doesn't stop."

# game/02_cap1_conexiones.rpy:2473
translate english cap1_interconexion_5_eb042592:

    # raiha "Hermanito, llegó esto. Lo dejo aquí, ¿sí?"
    raiha "Big brother, this came. I'll leave it here, okay?"

# game/02_cap1_conexiones.rpy:2475
translate english cap1_interconexion_5_8f08c970:

    # narrador "Un sobre del banco. Lo dejó boca abajo en mi escritorio, como si así pesara menos."
    narrador "A bank envelope. She set it face down on my desk, as if that would make it weigh less."

# game/02_cap1_conexiones.rpy:2477
translate english cap1_interconexion_5_307dc3c9:

    # mc "Es para papá."
    mc "That's for Dad."

# game/02_cap1_conexiones.rpy:2482
translate english cap1_interconexion_5_53a4dcaa:

    # raiha "Ya sé. Pero cuando abre esos, se pone serio toda la noche."
    raiha "I know. But when he opens those, he's serious all night."

# game/02_cap1_conexiones.rpy:2484
translate english cap1_interconexion_5_2b1c8cb0:

    # raiha "Tú también. Pero tú por lo menos te comes la cena."
    raiha "So are you. But at least you eat your dinner."

# game/02_cap1_conexiones.rpy:2486
translate english cap1_interconexion_5_1869323c:

    # narrador "En la otra mano llevaba una hoja doblada."
    narrador "In her other hand she had a folded sheet of paper."

# game/02_cap1_conexiones.rpy:2488
translate english cap1_interconexion_5_3aee05a3:

    # mc "¿Y eso?"
    mc "What's that?"

# game/02_cap1_conexiones.rpy:2493
translate english cap1_interconexion_5_dd05e366:

    # raiha "Nada. Una excursión de la escuela. Al acuario."
    raiha "Nothing. A school trip. To the aquarium."

# game/02_cap1_conexiones.rpy:2495
translate english cap1_interconexion_5_28c4f023:

    # raiha "No voy a ir. Los peces son aburridos."
    raiha "I'm not going. Fish are boring."

# game/02_cap1_conexiones.rpy:2497
translate english cap1_interconexion_5_1c8fc49b:

    # mc "Te encantan los peces."
    mc "You love fish."

# game/02_cap1_conexiones.rpy:2499
translate english cap1_interconexion_5_4eeed3d5:

    # raiha "¡Me encantaban! Ya soy grande."
    raiha "I used to! I'm big now."

# game/02_cap1_conexiones.rpy:2504
translate english cap1_interconexion_5_f4c580bc:

    # raiha "¡Buenas noches, hermanito!"
    raiha "Good night, [mc]!"

# game/02_cap1_conexiones.rpy:2509
translate english cap1_interconexion_5_aa916f23:

    # mc_pensamiento "Antes de salir dobló la hoja una vez más. Para que no se viera el precio."
    mc_pensamiento "Before leaving, she folded the sheet once more. So the price wouldn't show."

# game/02_cap1_conexiones.rpy:2511
translate english cap1_interconexion_5_6e5b6877:

    # mc_pensamiento "Yo hacía lo mismo a su edad. No sabía que ella también."
    mc_pensamiento "I used to do the same at her age. I didn't know she did too."

# game/02_cap1_conexiones.rpy:2513
translate english cap1_interconexion_5_cb8fd8ec:

    # narrador "Esperé a oír su puerta y bajé con el sobre."
    narrador "I waited until I heard her door, then went downstairs with the envelope."

# game/02_cap1_conexiones.rpy:2518
translate english cap1_interconexion_5_313c9421:

    # narrador "Mi padre estaba en la mesa, con la cámara desarmada sobre un trapo."
    narrador "My father was at the table, his camera in pieces on a rag."

# game/02_cap1_conexiones.rpy:2523
translate english cap1_interconexion_5_271eba2c:

    # narrador "Le dejé el sobre al lado. Lo miró sin tocarlo."
    narrador "I set the envelope beside him. He looked at it without touching it."

# game/02_cap1_conexiones.rpy:2528
translate english cap1_interconexion_5_fd61bbca:

    # isanari "Otra carta de amor del banco. Me escriben más que tu madre cuando éramos novios."
    isanari "Another love letter from the bank. They write me more than your mother did when we were dating."

# game/02_cap1_conexiones.rpy:2530
translate english cap1_interconexion_5_2f162686:

    # mc "Raiha dice que cuando abres esos te pones serio toda la noche."
    mc "Raiha says when you open those, you're serious all night."

# game/02_cap1_conexiones.rpy:2532
translate english cap1_interconexion_5_2f945a19:

    # isanari "Raiha exagera."
    isanari "Raiha exaggerates."

# game/02_cap1_conexiones.rpy:2534
translate english cap1_interconexion_5_191a8e4c:

    # narrador "Lo abrió. Leyó la primera línea y lo volvió a doblar."
    narrador "He opened it. Read the first line and folded it back up."

# game/02_cap1_conexiones.rpy:2536
translate english cap1_interconexion_5_c8701baa:

    # narrador "Se quedó callado tanto rato que terminé sentándome enfrente."
    narrador "He stayed quiet so long I ended up sitting down across from him."

# game/02_cap1_conexiones.rpy:2538
translate english cap1_interconexion_5_e0341768:

    # isanari "El restaurante era el sueño de tu madre."
    isanari "The restaurant was your mother's dream."

# game/02_cap1_conexiones.rpy:2540
translate english cap1_interconexion_5_7add355d:

    # isanari "Los papeles del préstamo los firmé yo. Sonriendo."
    isanari "I signed the loan papers. Smiling."

# game/02_cap1_conexiones.rpy:2542
translate english cap1_interconexion_5_9792c1e1:

    # isanari "Con ella al lado, no se me ocurrió que podía salir mal."
    isanari "With her beside me, it never occurred to me that it could go wrong."

# game/02_cap1_conexiones.rpy:2544
translate english cap1_interconexion_5_88460131:

    # mc "Nadie podía saberlo."
    mc "Nobody could have known."

# game/02_cap1_conexiones.rpy:2546
translate english cap1_interconexion_5_f00becb2:

    # isanari "Yo era el adulto. Me tocaba saberlo."
    isanari "I was the adult. It was my job to know."

# game/02_cap1_conexiones.rpy:2548
translate english cap1_interconexion_5_87460380:

    # narrador "Dejó el lente encima del sobre, como un pisapapeles."
    narrador "He set the camera lens on top of the envelope like a paperweight."

# game/02_cap1_conexiones.rpy:2550
translate english cap1_interconexion_5_118e6d11:

    # isanari "Ella quería que estudiaras para que tengas un buen futuro."
    isanari "She wanted you to study so you'd have a good future."

# game/02_cap1_conexiones.rpy:2552
translate english cap1_interconexion_5_c433b419:

    # isanari "No para pagar lo que firmé yo."
    isanari "Not to pay for what I signed."

# game/02_cap1_conexiones.rpy:2554
translate english cap1_interconexion_5_bb34d454:

    # isanari "Y aun así te traje este trabajo."
    isanari "And still I brought you this job."

# game/02_cap1_conexiones.rpy:2556
translate english cap1_interconexion_5_35d7b6f4:

    # mc "Lo acepté yo."
    mc "I'm the one who took it."

# game/02_cap1_conexiones.rpy:2558
translate english cap1_interconexion_5_dddfc1ec:

    # isanari "Después de que yo dijera que sí."
    isanari "After I said yes."

# game/02_cap1_conexiones.rpy:2560
translate english cap1_interconexion_5_9b3a9269:

    # isanari "No me quites la culpa. Es lo único que me sobra."
    isanari "Don't take the blame away from me. It's the only thing I've got to spare."

# game/02_cap1_conexiones.rpy:2565
translate english cap1_interconexion_5_2fce6d55:

    # isanari "Bueno. Suficiente drama por hoy."
    isanari "Anyway. Enough drama for today."

# game/02_cap1_conexiones.rpy:2567
translate english cap1_interconexion_5_60ac0963:

    # isanari "Anda a dormir. Todavía te quedan cinco por enseñar."
    isanari "Go to bed. You've still got five to teach."

# game/02_cap1_conexiones.rpy:2572
translate english cap1_interconexion_5_52f72a6b:

    # mc_pensamiento "Raiha tenía razón. Se ponía serio con esos sobres."
    mc_pensamiento "Raiha was right. He did get serious over those envelopes."

# game/02_cap1_conexiones.rpy:2574
translate english cap1_interconexion_5_1b3eeeff:

    # mc_pensamiento "Solo que nunca delante de nosotros."
    mc_pensamiento "Just never in front of us."

# game/02_cap1_conexiones.rpy:2581
translate english cap1_interconexion_5_77c2520a:

    # narrador "Pasadas las once, me sonó el teléfono. En la pantalla decía «Maruo»."
    narrador "A little after eleven, my phone rang. The screen said \"Maruo.\""

# game/02_cap1_conexiones.rpy:2583
translate english cap1_interconexion_5_22b8942e:

    # mc "¿Diga?"
    mc "Hello?"

# game/02_cap1_conexiones.rpy:2585
translate english cap1_interconexion_5_c09410c7:

    # maruo "¿Te desperté?"
    maruo "Did I wake you?"

# game/02_cap1_conexiones.rpy:2587
translate english cap1_interconexion_5_d4ea9aa3:

    # mc "No, señor."
    mc "No, sir."

# game/02_cap1_conexiones.rpy:2589
translate english cap1_interconexion_5_d712d384:

    # narrador "De fondo se oía una megafonía. Llamaban al doctor Nakano a la tercera planta."
    narrador "A PA system droned in the background. They were paging Dr. Nakano to the third floor."

# game/02_cap1_conexiones.rpy:2591
translate english cap1_interconexion_5_e5a2ba62:

    # maruo "Esta tarde estuviste en la cocina."
    maruo "You were in the kitchen this afternoon."

# game/02_cap1_conexiones.rpy:2593
translate english cap1_interconexion_5_349c2774:

    # mc "No era mi intención escuchar."
    mc "I didn't mean to listen in."

# game/02_cap1_conexiones.rpy:2595
translate english cap1_interconexion_5_e422a729:

    # maruo "No te llamo por eso."
    maruo "That is not why I am calling."

# game/02_cap1_conexiones.rpy:2599
translate english cap1_interconexion_5_bfbb6f77:

    # maruo "Lo que te dije ahí sigue en pie. No lo repito."
    maruo "What I told you there still stands. I will not repeat it."

# game/02_cap1_conexiones.rpy:2601
translate english cap1_interconexion_5_2f41efd2:

    # maruo "Cuando te fuiste, ¿mis hijas habían cenado?"
    maruo "When you left, had my daughters eaten?"

# game/02_cap1_conexiones.rpy:2603
translate english cap1_interconexion_5_cf97645b:

    # mc_pensamiento "De todas las preguntas posibles, era la última que esperaba."
    mc_pensamiento "Of all the possible questions, it was the last one I expected."

# game/02_cap1_conexiones.rpy:2607
translate english cap1_interconexion_5_71c41bff:

    # mc "Nino estaba cocinando. Le ayudé con las cebollas."
    mc "Nino was cooking. I helped her with the onions."

# game/02_cap1_conexiones.rpy:2609
translate english cap1_interconexion_5_6c5f8cc7:

    # narrador "Hubo un silencio largo. La megafonía volvió a llamarlo."
    narrador "A long silence. The PA called for him again."

# game/02_cap1_conexiones.rpy:2611
translate english cap1_interconexion_5_cbc9835d:

    # maruo "...Entiendo."
    maruo "...I see."

# game/02_cap1_conexiones.rpy:2615
translate english cap1_interconexion_5_3b1bb190:

    # mc "No lo sé, señor. Me fui antes."
    mc "I don't know, sir. I left before that."

# game/02_cap1_conexiones.rpy:2617
translate english cap1_interconexion_5_5314f221:

    # maruo "Ya."
    maruo "Right."

# game/02_cap1_conexiones.rpy:2619
translate english cap1_interconexion_5_fd935a1d:

    # maruo "Es todo. Buenas noches, [mc]."
    maruo "That is all. Good night, [mc]."

# game/02_cap1_conexiones.rpy:2621
translate english cap1_interconexion_5_61ad566e:

    # narrador "Colgó antes de que pudiera contestarle."
    narrador "He hung up before I could answer."

# game/02_cap1_conexiones.rpy:2623
translate english cap1_interconexion_5_3023b774:

    # mc_pensamiento "Me llamó desde un hospital, a las once, para preguntar si sus hijas habían cenado."
    mc_pensamiento "He called me from a hospital, at eleven, to ask whether his daughters had eaten."

# game/02_cap1_conexiones.rpy:2625
translate english cap1_interconexion_5_e6631429:

    # mc_pensamiento "No parecía un hombre que no quisiera estar en casa."
    mc_pensamiento "He didn't sound like a man who didn't want to be home."

# game/02_cap1_conexiones.rpy:2627
translate english cap1_interconexion_5_fdcb8e3b:

    # mc_pensamiento "Parecía uno que no sabía cómo volver."
    mc_pensamiento "He sounded like one who didn't know how to get back."

# game/02_cap1_conexiones.rpy:2629
translate english cap1_interconexion_5_fe6f9721:

    # mc_pensamiento "Solo me quedaba una última tarde libre."
    mc_pensamiento "I only had one free afternoon left."

# game/02_cap1_conexiones.rpy:2638
translate english cap1_interconexion_5_6bedbabb:

    # narrador "Los días siguientes se me pasaron volando."
    narrador "The next few days flew by."

# game/02_cap1_conexiones.rpy:2640
translate english cap1_interconexion_5_021043aa:

    # narrador "Cuando quise acordarme, los exámenes estaban respirándome en la nuca."
    narrador "Before I knew it, the exams were breathing down my neck."

# game/02_cap1_conexiones.rpy:2651
translate english cap1_interconexion_5_14a98fb8:

    # narrador "Llegué al instituto temprano, como siempre."
    narrador "I got to school early, like always."

# game/02_cap1_conexiones.rpy:2653
translate english cap1_interconexion_5_69786bcd:

    # narrador "En la entrada del instituto acababan de clavar el cartel con los horarios de los exámenes."
    narrador "They'd just pinned up the exam schedule at the school entrance."

# game/02_cap1_conexiones.rpy:2655
translate english cap1_interconexion_5_8391fa67:

    # narrador "Cinco asignaturas. Cinco fechas. Y cero margen de error."
    narrador "Five subjects. Five dates. And zero margin for error."

# game/02_cap1_conexiones.rpy:2661
translate english cap1_interconexion_5_c7636a7a:

    # mc_pensamiento "Cinco fechas en un papel. Y yo aquí parado." nointeract
    mc_pensamiento "Five dates on a sheet of paper. And me standing here." nointeract

# game/02_cap1_conexiones.rpy:2665
translate english cap1_interconexion_5_fba84040:

    # mc_pensamiento "Obviamente no cambió nada."
    mc_pensamiento "Obviously, nothing changed."

# game/02_cap1_conexiones.rpy:2667
translate english cap1_interconexion_5_0af8db3b:

    # mc_pensamiento "Las fechas de los exámenes nunca se retrasan cuando de verdad te hace falta."
    mc_pensamiento "Exam dates never get pushed back when you actually need them to."

# game/02_cap1_conexiones.rpy:2669
translate english cap1_interconexion_5_e1fc9644:

    # mc_pensamiento "Lo que más me preocupa es cómo saldrán esas cinco."
    mc_pensamiento "What worries me most is how those five will do."

# game/02_cap1_conexiones.rpy:2673
translate english cap1_interconexion_5_e6548c3f:

    # mc_pensamiento "Contando con los dedos da la sensación de que queda menos."
    mc_pensamiento "Counting on my fingers makes it feel like there's less time left."

# game/02_cap1_conexiones.rpy:2675
translate english cap1_interconexion_5_90d7da78:

    # mc_pensamiento "Mirando el calendario da igual: la cuenta asusta igual."
    mc_pensamiento "Checking the calendar doesn't help: the count is just as scary."

# game/02_cap1_conexiones.rpy:2677
translate english cap1_interconexion_5_fe467f48:

    # mc_pensamiento "No por mí, sino por ellas."
    mc_pensamiento "Not for me. For them."

# game/02_cap1_conexiones.rpy:2681
translate english cap1_interconexion_5_1948dc62:

    # mc_pensamiento "Intenté poner cara de poca preocupación frente al reflejo de la ventana."
    mc_pensamiento "I tried to look unworried in the window's reflection."

# game/02_cap1_conexiones.rpy:2683
translate english cap1_interconexion_5_48b7bfd4:

    # mc_pensamiento "No me lo creía ni yo."
    mc_pensamiento "I didn't even buy it myself."

# game/02_cap1_conexiones.rpy:2685
translate english cap1_interconexion_5_e5e031a3:

    # mc_pensamiento "Esa semana sí es importante, no puedo andar con juegos."
    mc_pensamiento "This week matters. I can't be playing games."

# game/02_cap1_conexiones.rpy:2694
translate english cap1_interconexion_5_502b1bfb:

    # narrador "Las cinco ya estaban en sus sitios."
    narrador "All five were already in their seats."

# game/02_cap1_conexiones.rpy:2696
translate english cap1_interconexion_5_f5a730e4:

    # narrador "Raro en ellas. El peso de los exámenes ya se les notaba."
    narrador "Unusual for them. The weight of the exams was already showing."

# game/02_cap1_conexiones.rpy:2700
translate english cap1_interconexion_5_c3fa7d18:

    # mc_pensamiento "Iré a saludarlas y a decirles que saquen sus libros."
    mc_pensamiento "I'll go say hi and tell them to take out their books."

# game/02_cap1_conexiones.rpy:2702
translate english cap1_interconexion_5_a76bc738:

    # narrador "Antes de llegar, una de ellas se me cruzó en el camino."
    narrador "Before I got there, one of them stepped into my path."

# game/02_cap1_conexiones.rpy:2704
translate english cap1_interconexion_5_f34fa2db:

    # mc_pensamiento "Ya sabía quién era antes de verle la cara. Solo una se me cruza así."
    mc_pensamiento "I knew who it was before seeing her face. Only one of them cuts me off like that."

# game/02_cap1_conexiones.rpy:2713
translate english cap1_interconexion_5_a28e0eab:

    # mc "Nino. Saca tus libros, que ya mismo son los exámenes."
    mc "Nino. Get your books out, the exams are right around the corner."

# game/02_cap1_conexiones.rpy:2718
translate english cap1_interconexion_5_df3376e0:

    # nino "No me mires así."
    nino "Don't look at me like that."

# game/02_cap1_conexiones.rpy:2720
translate english cap1_interconexion_5_ba654ddf:

    # mc "No estoy mirando nada."
    mc "I'm not looking at anything."

# game/02_cap1_conexiones.rpy:2722
translate english cap1_interconexion_5_f8df03ce:

    # nino "Sí lo haces. Con esa cara de «sé algo de ti»."
    nino "Yes, you are. With that \"I know something about you\" face."

# game/02_cap1_conexiones.rpy:2724
translate english cap1_interconexion_5_93edb413:

    # nino "Y no sabes nada."
    nino "And you don't know anything."

# game/02_cap1_conexiones.rpy:2726
translate english cap1_interconexion_5_1a707e16:

    # mc "Sé que las cebollas las corté finas."
    mc "I know I cut the onions thin."

# game/02_cap1_conexiones.rpy:2731
translate english cap1_interconexion_5_a245b543:

    # nino "...Gruesas. Las cortaste gruesas."
    nino "...Thick. You cut them thick."

# game/02_cap1_conexiones.rpy:2733
translate english cap1_interconexion_5_7eec0378:

    # mc "Pero no te quejaste."
    mc "But you didn't complain."

# game/02_cap1_conexiones.rpy:2738
translate english cap1_interconexion_5_083d74f9:

    # nino "Lo de aquel día no fue una invitación. Que quede claro."
    nino "What happened that day wasn't an invitation. Let's be clear."

# game/02_cap1_conexiones.rpy:2740
translate english cap1_interconexion_5_c42ed6db:

    # mc "Lo sé. Fue una orden."
    mc "I know. It was an order."

# game/02_cap1_conexiones.rpy:2742
translate english cap1_interconexion_5_3b1fe385:

    # nino "Exacto."
    nino "Exactly."

# game/02_cap1_conexiones.rpy:2747
translate english cap1_interconexion_5_00014055:

    # nino "Solo... hoy no me preguntes nada."
    nino "Just... don't ask me anything today."

# game/02_cap1_conexiones.rpy:2749
translate english cap1_interconexion_5_5776ef9c:

    # nino "Si me preguntas, no voy a saber qué contestar."
    nino "If you ask, I won't know what to say."

# game/02_cap1_conexiones.rpy:2754
translate english cap1_interconexion_5_12f63035:

    # narrador "No sonó a reproche. Más bien sonó a un ruego disfrazado de orden."
    narrador "It didn't sound like a reproach. More like a plea dressed up as an order."

# game/02_cap1_conexiones.rpy:2761
translate english cap1_interconexion_5_be896031:

    # nino "Te aviso que sigo sin tener ganas de hablar de aquello."
    nino "Fair warning: I still don't feel like talking about that."

# game/02_cap1_conexiones.rpy:2763
translate english cap1_interconexion_5_6fde286a:

    # mc "Tampoco iba a preguntar."
    mc "I wasn't going to ask."

# game/02_cap1_conexiones.rpy:2765
translate english cap1_interconexion_5_07fb638a:

    # nino "Más te vale."
    nino "You'd better not."

# game/02_cap1_conexiones.rpy:2767
translate english cap1_interconexion_5_ef3c0499:

    # narrador "Se quedó mirando su cuaderno cerrado. Tardó en volver a hablar."
    narrador "She stared at her closed notebook. It took her a while to speak again."

# game/02_cap1_conexiones.rpy:2772
translate english cap1_interconexion_5_c65502db:

    # nino "...Lavaste mi taza."
    nino "...You washed my cup."

# game/02_cap1_conexiones.rpy:2774
translate english cap1_interconexion_5_0a6231f1:

    # mc "Era una taza."
    mc "It was a cup."

# game/02_cap1_conexiones.rpy:2776
translate english cap1_interconexion_5_fdb6212f:

    # nino "Era mi taza. Nadie toca mi taza."
    nino "It was my cup. Nobody touches my cup."

# game/02_cap1_conexiones.rpy:2778
translate english cap1_interconexion_5_c0a7eadb:

    # nino "No lo vuelvas a hacer."
    nino "Don't do it again."

# game/02_cap1_conexiones.rpy:2783
translate english cap1_interconexion_5_a4daf1c3:

    # nino "...O sea. Haz lo que quieras."
    nino "...I mean. Do what you want."

# game/02_cap1_conexiones.rpy:2788
translate english cap1_interconexion_5_7bf7df2a:

    # narrador "Fue lo más parecido a un «gracias» que iba a sacarle."
    narrador "It was the closest thing to a \"thank you\" I was going to get out of her."

# game/02_cap1_conexiones.rpy:2792
translate english cap1_interconexion_5_dbb97551:

    # mc "Nino..."
    mc "Nino..."

# game/02_cap1_conexiones.rpy:2794
translate english cap1_interconexion_5_1000075e:

    # narrador "No contestó. No giró la cabeza ni para ignorarme."
    narrador "She didn't answer. She didn't even turn her head to ignore me."

# game/02_cap1_conexiones.rpy:2796
translate english cap1_interconexion_5_45f2a0f3:

    # mc "Lo que te dije en la cocina..."
    mc "What I said to you in the kitchen..."

# game/02_cap1_conexiones.rpy:2801
translate english cap1_interconexion_5_0bc5741c:

    # nino "No lo repitas."
    nino "Don't repeat it."

# game/02_cap1_conexiones.rpy:2803
translate english cap1_interconexion_5_2af1bbb5:

    # nino "Tenías razón en una cosa: tengo que ocuparme de lo mío."
    nino "You were right about one thing: I need to take care of my own business."

# game/02_cap1_conexiones.rpy:2805
translate english cap1_interconexion_5_2c9c8456:

    # nino "Y eso voy a hacer. Empezando por no hablarte."
    nino "And that's what I'll do. Starting with not talking to you."

# game/02_cap1_conexiones.rpy:2810
translate english cap1_interconexion_5_7babfdfd:

    # narrador "Lo dijo sin elevar la voz."
    narrador "She said it without raising her voice."

# game/02_cap1_conexiones.rpy:2812
translate english cap1_interconexion_5_ba0b3264:

    # narrador "Con la misma calma que su padre."
    narrador "With the same calm as her father."

# game/02_cap1_conexiones.rpy:2814
translate english cap1_interconexion_5_5c833cea:

    # mc_pensamiento "Esa calma no era suya. La había heredado."
    mc_pensamiento "That calm wasn't hers. She'd inherited it."

# game/02_cap1_conexiones.rpy:2816
translate english cap1_interconexion_5_605534fd:

    # mc_pensamiento "Y yo se la había hecho usar."
    mc_pensamiento "And I'd made her use it."

# game/02_cap1_conexiones.rpy:2831
translate english cap1_interconexion_5_fec64cf2:

    # narrador "Las otras cuatro fueron llegando de a una. Esta vez nadie hizo ruido."
    narrador "The other four trickled in one by one. This time nobody made any noise."

# game/02_cap1_conexiones.rpy:2833
translate english cap1_interconexion_5_99f61bf4:

    # narrador "Las saludé y fui directo al grano en lo que debía decirles."
    narrador "I greeted them and got straight to the point."

# game/02_cap1_conexiones.rpy:2837
translate english cap1_interconexion_5_ebea290d:

    # mc "Muy bien, escuchen: los exámenes están a la vuelta de la esquina."
    mc "All right, listen up: the exams are right around the corner."

# game/02_cap1_conexiones.rpy:2839
translate english cap1_interconexion_5_2fc0a77c:

    # mc "Hemos estudiado mucho en estas semanas, así que no se atrevan a reprobar."
    mc "We've studied hard these past weeks, so don't you dare fail."

# game/02_cap1_conexiones.rpy:2841
translate english cap1_interconexion_5_bd1e5461:

    # mc "Arruinarían mi reputación como tutor. Y mi trabajo."
    mc "You'd ruin my reputation as a tutor. And my job."

# game/02_cap1_conexiones.rpy:2843
translate english cap1_interconexion_5_5b9358f2:

    # mc "Confío en que aprobarán..."
    mc "I'm trusting you'll pass..."

# game/02_cap1_conexiones.rpy:2845
translate english cap1_interconexion_5_d072d50f:

    # mc_pensamiento "Me quedaron viendo con cara de preocupación."
    mc_pensamiento "They stared back at me, worried."

# game/02_cap1_conexiones.rpy:2847
translate english cap1_interconexion_5_562fd63c:

    # mc_pensamiento "Parece que están nerviosas por el inicio de los exámenes."
    mc_pensamiento "Looks like they're nervous about the exams starting."

# game/02_cap1_conexiones.rpy:2849
translate english cap1_interconexion_5_12558cff:

    # mc "¿Se encuentran bien todas? ¿No están nerviosas?"
    mc "Is everyone okay? You're not nervous?"

# game/02_cap1_conexiones.rpy:2860
translate english cap1_interconexion_5_f3db32f0:

    # yotsuba "¡Eh, nosotras estamos súper tranquilas! ¡Para nada nerviosas!"
    yotsuba "Hey, we're super calm! Not nervous at all!"

# game/02_cap1_conexiones.rpy:2862
translate english cap1_interconexion_5_b8240593:

    # mc "Yotsuba, estás sosteniendo tu lápiz al revés."
    mc "Yotsuba, you're holding your pencil backwards."

# game/02_cap1_conexiones.rpy:2864
translate english cap1_interconexion_5_8a7b3189:

    # yotsuba "¡Es una técnica! ¡Para aliviar los nervios!"
    yotsuba "It's a technique! For calming the nerves!"

# game/02_cap1_conexiones.rpy:2869
translate english cap1_interconexion_5_6c2c914e:

    # yotsuba "...Bueno. Si te soy sincera..."
    yotsuba "...Okay. If I'm being honest..."

# game/02_cap1_conexiones.rpy:2871
translate english cap1_interconexion_5_606b4184:

    # yotsuba "Creo que estoy un poco más nerviosa que las demás."
    yotsuba "I think I'm a little more nervous than the rest."

# game/02_cap1_conexiones.rpy:2873
translate english cap1_interconexion_5_e7dbb03b:

    # yotsuba "Es que si alguna de nosotras reprueba, se acaba todo."
    yotsuba "It's just that if any of us fails, it's all over."

# game/02_cap1_conexiones.rpy:2875
translate english cap1_interconexion_5_561fede4:

    # yotsuba "¡Pero no va a pasar! ¡Digo... creo que no va a pasar!"
    yotsuba "But it won't happen! I mean... I think it won't happen!"

# game/02_cap1_conexiones.rpy:2879
translate english cap1_interconexion_5_16e31fe5:

    # yotsuba "Porque las demás confían en ti."
    yotsuba "Because the others trust you."

# game/02_cap1_conexiones.rpy:2881
translate english cap1_interconexion_5_6bded300:

    # mc_pensamiento "Las demás. Ella no se contó."
    mc_pensamiento "The others. She didn't count herself."

# game/02_cap1_conexiones.rpy:2885
translate english cap1_interconexion_5_ff42a4c8:

    # yotsuba "Porque todas confiamos en ti."
    yotsuba "Because we all trust you."

# game/02_cap1_conexiones.rpy:2887
translate english cap1_interconexion_5_ecc91360:

    # mc "Voy a estar ahí. Eso sí lo puedo decir."
    mc "I'll be there. That much I can say."

# game/02_cap1_conexiones.rpy:2892
translate english cap1_interconexion_5_e91c96f0:

    # yotsuba "...¡Eso sí lo acepto!"
    yotsuba "...That I'll take!"

# game/02_cap1_conexiones.rpy:2902
translate english cap1_interconexion_5_75e3b91b:

    # miku "...Son cinco materias de examen."
    miku "...There are five exam subjects."

# game/02_cap1_conexiones.rpy:2904
translate english cap1_interconexion_5_9fc1bc93:

    # mc "Ya lo sé."
    mc "I know."

# game/02_cap1_conexiones.rpy:2906
translate english cap1_interconexion_5_ef289c43:

    # miku "...Y nosotras somos cinco."
    miku "...And there are five of us."

# game/02_cap1_conexiones.rpy:2908
translate english cap1_interconexion_5_c83802f0:

    # mc_pensamiento "No sé si lo soltó por soltar, pero la frase se me quedó dando vueltas."
    mc_pensamiento "I don't know if she just said it to say something, but the line stuck with me."

# game/02_cap1_conexiones.rpy:2914
translate english cap1_interconexion_5_e2c58176:

    # yotsuba "¡Una materia para cada una! ¡Como un equipo de relevos!"
    yotsuba "One subject each! Like a relay team!"

# game/02_cap1_conexiones.rpy:2920
translate english cap1_interconexion_5_44bfaf4a:

    # miku "...Eso quise decir."
    miku "...That's what I meant."

# game/02_cap1_conexiones.rpy:2927
translate english cap1_interconexion_5_29f30d71:

    # miku "...Perd—"
    miku "...Sor—"

# game/02_cap1_conexiones.rpy:2929
translate english cap1_interconexion_5_4639b051:

    # narrador "Se cortó sola. Me miró, como esperando que la cortara yo."
    narrador "She cut herself off. She looked at me like she was waiting for me to do it."

# game/02_cap1_conexiones.rpy:2931
translate english cap1_interconexion_5_c2ea0d66:

    # mc "Ya sabes lo que te voy a decir."
    mc "You know what I'm going to say."

# game/02_cap1_conexiones.rpy:2933
translate english cap1_interconexion_5_a762e66e:

    # miku "...Que eso no se disculpa."
    miku "...That you don't apologize for that."

# game/02_cap1_conexiones.rpy:2938
translate english cap1_interconexion_5_e6126bd3:

    # narrador "Lo repitió como una lección que todavía no se cree. Pero la repitió."
    narrador "She repeated it like a lesson she didn't quite believe yet. But she repeated it."

# game/02_cap1_conexiones.rpy:2945
translate english cap1_interconexion_5_8915b74b:

    # miku "...Perdón. Pienso cosas raras cuando hay examen."
    miku "...Sorry. I think weird things when there's an exam."

# game/02_cap1_conexiones.rpy:2947
translate english cap1_interconexion_5_420f26e2:

    # mc "No tienes que disculparte."
    mc "You don't have to apologize."

# game/02_cap1_conexiones.rpy:2949
translate english cap1_interconexion_5_a5f054e5:

    # miku "...Está bien."
    miku "...Okay."

# game/02_cap1_conexiones.rpy:2954
translate english cap1_interconexion_5_f022d3cb:

    # narrador "Lo dijo como quien oye una frase en otro idioma y asiente por educación."
    narrador "She said it like someone hearing a sentence in another language and nodding to be polite."

# game/02_cap1_conexiones.rpy:2958
translate english cap1_interconexion_5_539c14c1:

    # narrador "Itsuki ni se molestó en levantar los ojos del cuaderno."
    narrador "Itsuki didn't even bother lifting her eyes from her notebook."

# game/02_cap1_conexiones.rpy:2960
translate english cap1_interconexion_5_94d833d2:

    # narrador "Y eso que esta vez ni siquiera lo iba leyendo."
    narrador "And this time she wasn't even reading it."

# game/02_cap1_conexiones.rpy:2965
translate english cap1_interconexion_5_fdfe8143:

    # mc "Itsuki."
    mc "Itsuki."

# game/02_cap1_conexiones.rpy:2967
translate english cap1_interconexion_5_280264b1:

    # itsuki "Estoy repasando."
    itsuki "I'm reviewing."

# game/02_cap1_conexiones.rpy:2969
translate english cap1_interconexion_5_8973cf39:

    # mc "Llevabas diez minutos en la misma página."
    mc "You've been on the same page for ten minutes."

# game/02_cap1_conexiones.rpy:2971
translate english cap1_interconexion_5_41160765:

    # itsuki "Estoy repasando con profundidad."
    itsuki "I'm reviewing in depth."

# game/02_cap1_conexiones.rpy:2975
translate english cap1_interconexion_5_ab6b4c4c:

    # itsuki "Los temas ya me los sé. Eso no es lo que me preocupa."
    itsuki "I already know the material. That's not what worries me."

# game/02_cap1_conexiones.rpy:2977
translate english cap1_interconexion_5_7b72d11d:

    # itsuki "Me preocupa llegar el día del examen y que no salgan."
    itsuki "What worries me is reaching exam day and blanking."

# game/02_cap1_conexiones.rpy:2979
translate english cap1_interconexion_5_1a8e03ca:

    # mc "Saldrán. Confía en ti."
    mc "It'll come. Trust yourself."

# game/02_cap1_conexiones.rpy:2981
translate english cap1_interconexion_5_3b6e3900:

    # itsuki "No te pedí que lo dijeras."
    itsuki "I didn't ask you to say that."

# game/02_cap1_conexiones.rpy:2986
translate english cap1_interconexion_5_d810f3ca:

    # narrador "No dio las gracias. Pero tampoco me pidió que me callara."
    narrador "She didn't say thanks. But she didn't tell me to be quiet, either."

# game/02_cap1_conexiones.rpy:2993
translate english cap1_interconexion_5_8e298c11:

    # itsuki "Y no hace falta que te preocupes por mí."
    itsuki "And you don't need to worry about me."

# game/02_cap1_conexiones.rpy:2995
translate english cap1_interconexion_5_926f7a07:

    # itsuki "Yo siempre llego preparada."
    itsuki "I always show up prepared."

# game/02_cap1_conexiones.rpy:2997
translate english cap1_interconexion_5_50d8828a:

    # mc "Lo sé."
    mc "I know."

# game/02_cap1_conexiones.rpy:2999
translate english cap1_interconexion_5_e0244ac7:

    # itsuki "Entonces deja de mirarme el cuaderno."
    itsuki "Then stop looking at my notebook."

# game/02_cap1_conexiones.rpy:3001
translate english cap1_interconexion_5_d243c367:

    # itsuki "Y quita esa cara de querer intrometerte."
    itsuki "And drop that look like you're about to meddle."

# game/02_cap1_conexiones.rpy:3006
translate english cap1_interconexion_5_f957b81b:

    # narrador "Lo cerró con las dos manos. Y siguió sin mirarme."
    narrador "She closed it with both hands. And still didn't look at me."

# game/02_cap1_conexiones.rpy:3013
translate english cap1_interconexion_5_3e79844e:

    # ichika "Hoy es tu última tarde libre, ¿no?"
    ichika "Today's your last free afternoon, right?"

# game/02_cap1_conexiones.rpy:3015
translate english cap1_interconexion_5_494a6419:

    # mc "Sí."
    mc "Yes."

# game/02_cap1_conexiones.rpy:3017
translate english cap1_interconexion_5_06bac02e:

    # ichika "Pues piénsatelo bien."
    ichika "Then think it over carefully."

# game/02_cap1_conexiones.rpy:3022
translate english cap1_interconexion_5_3541821d:

    # ichika "...Y no te lo digo por mí."
    ichika "...And I'm not saying that for my sake."

# game/02_cap1_conexiones.rpy:3024
translate english cap1_interconexion_5_8ce7497d:

    # ichika "Te lo digo porque después ya no hay vuelta atrás."
    ichika "I'm saying it because after this there's no going back."

# game/02_cap1_conexiones.rpy:3031
translate english cap1_interconexion_5_9efddc9b:

    # ichika "Iba a decirte que estoy bien."
    ichika "I was going to tell you I'm fine."

# game/02_cap1_conexiones.rpy:3033
translate english cap1_interconexion_5_20eac0bf:

    # ichika "Contigo ya no me sale."
    ichika "With you, it just doesn't come out anymore."

# game/02_cap1_conexiones.rpy:3035
translate english cap1_interconexion_5_f8b2502b:

    # narrador "Lo dijo bajito. Sin chiste detrás."
    narrador "She said it softly. No joke behind it."

# game/02_cap1_conexiones.rpy:3040
translate english cap1_interconexion_5_be8699f6:

    # ichika "Solo... elige a quien de verdad lo necesite."
    ichika "Just... pick whoever really needs it."

# game/02_cap1_conexiones.rpy:3042
translate english cap1_interconexion_5_d013c589:

    # ichika "No a la que mejor lo disimule."
    ichika "Not whoever hides it best."

# game/02_cap1_conexiones.rpy:3044
translate english cap1_interconexion_5_69d9386e:

    # ichika "Todas te necesitan. A su manera."
    ichika "We all need you. In our own way."

# game/02_cap1_conexiones.rpy:3046
translate english cap1_interconexion_5_ef6ccbaa:

    # ichika "Aunque no lo creas."
    ichika "Even if you don't believe it."

# game/02_cap1_conexiones.rpy:3053
translate english cap1_interconexion_5_66faf172:

    # ichika "Yo estoy bien. Que conste."
    ichika "I'm fine. For the record."

# game/02_cap1_conexiones.rpy:3055
translate english cap1_interconexion_5_cd015748:

    # mc_pensamiento "No era la primera en esa casa que me decía «estoy bien» sin sonar convencida."
    mc_pensamiento "She wasn't the first one in that house to tell me \"I'm fine\" without sounding convinced."

# game/02_cap1_conexiones.rpy:3060
translate english cap1_interconexion_5_be8699f6_1:

    # ichika "Solo... elige a quien de verdad lo necesite."
    ichika "Just... pick whoever really needs it."

# game/02_cap1_conexiones.rpy:3062
translate english cap1_interconexion_5_d013c589_1:

    # ichika "No a la que mejor lo disimule."
    ichika "Not whoever hides it best."

# game/02_cap1_conexiones.rpy:3064
translate english cap1_interconexion_5_69d9386e_1:

    # ichika "Todas te necesitan. A su manera."
    ichika "We all need you. In our own way."

# game/02_cap1_conexiones.rpy:3066
translate english cap1_interconexion_5_ef6ccbaa_1:

    # ichika "Aunque no lo creas."
    ichika "Even if you don't believe it."

# game/02_cap1_conexiones.rpy:3068
translate english cap1_interconexion_5_be8699f6_2:

    # ichika "Solo... elige a quien de verdad lo necesite."
    ichika "Just... pick whoever really needs it."

# game/02_cap1_conexiones.rpy:3070
translate english cap1_interconexion_5_d013c589_2:

    # ichika "No a la que mejor lo disimule."
    ichika "Not whoever hides it best."

# game/02_cap1_conexiones.rpy:3072
translate english cap1_interconexion_5_69d9386e_2:

    # ichika "Todas te necesitan. A su manera."
    ichika "We all need you. In our own way."

# game/02_cap1_conexiones.rpy:3074
translate english cap1_interconexion_5_ef6ccbaa_2:

    # ichika "Aunque no lo creas."
    ichika "Even if you don't believe it."

# game/02_cap1_conexiones.rpy:3081
translate english cap1_interconexion_5_12541c90:

    # ichika "Yo ya sé que no me vas a elegir a mí."
    ichika "I already know you won't pick me."

# game/02_cap1_conexiones.rpy:3083
translate english cap1_interconexion_5_016cf2c5:

    # ichika "¡Me da igual! ¡Soy la favorita de todos modos!"
    ichika "I don't care! I'm everyone's favorite anyway!"

# game/02_cap1_conexiones.rpy:3088
translate english cap1_interconexion_5_00963a5e:

    # ichika "...Es broma. Más o menos."
    ichika "...Kidding. Sort of."

# game/02_cap1_conexiones.rpy:3097
translate english cap1_interconexion_5_4fc03767:

    # mc "Muy bien. Sigan repasando como hasta ahora."
    mc "All right. Keep reviewing like you have been."

# game/02_cap1_conexiones.rpy:3099
translate english cap1_interconexion_5_42eff1ee:

    # mc "Todo irá bien, les aseguro."
    mc "It'll all be fine, I promise."

# game/02_cap1_conexiones.rpy:3108
translate english cap1_interconexion_5_91928090:

    # quintillizas "Adiós."
    quintillizas "Bye."

# game/02_cap1_conexiones.rpy:3110
translate english cap1_interconexion_5_cbacadbd:

    # narrador "Todas se fueron."
    narrador "They all left."

# game/02_cap1_conexiones.rpy:3123
translate english cap1_interconexion_5_3293671f:

    # narrador "El aula se quedó vacía de golpe."
    narrador "The classroom emptied all at once."

# game/02_cap1_conexiones.rpy:3125
translate english cap1_interconexion_5_da7f2f01:

    # narrador "Solo quedó el tic-tac del reloj, que hasta ahora nunca había oído."
    narrador "All that was left was the ticking of the clock, which I'd never noticed before."

# game/02_cap1_conexiones.rpy:3127
translate english cap1_interconexion_5_d4e3469e:

    # narrador "Al rato, salí yo también."
    narrador "After a while, I left too."

# game/02_cap1_conexiones.rpy:3134
translate english cap1_interconexion_5_8a1e758b:

    # mc_pensamiento "Tres nombres sin visitar. Una sola tarde."
    mc_pensamiento "Three names I hadn't visited. One afternoon."

# game/02_cap1_conexiones.rpy:3138
translate english cap1_interconexion_5_e651f754:

    # mc_pensamiento "Ichika me pidió que eligiera a quien de verdad lo necesite."
    mc_pensamiento "Ichika asked me to pick whoever really needs it."

# game/02_cap1_conexiones.rpy:3140
translate english cap1_interconexion_5_0f6c6ea8:

    # mc_pensamiento "No a la que mejor lo disimule."
    mc_pensamiento "Not the one who hides it best."

# game/02_cap1_conexiones.rpy:3144
translate english cap1_interconexion_5_1cfd18e2:

    # mc_pensamiento "Ichika dijo que ya sabía que no la iba a elegir."
    mc_pensamiento "Ichika said she already knew I wouldn't pick her."

# game/02_cap1_conexiones.rpy:3146
translate english cap1_interconexion_5_f03c005e:

    # mc_pensamiento "Lo dijo en broma. Más o menos."
    mc_pensamiento "She said it as a joke. Sort of."

# game/02_cap1_conexiones.rpy:3150
translate english cap1_interconexion_5_291c39fb:

    # mc_pensamiento "Y Maruo no va a darme otra oportunidad."
    mc_pensamiento "And Maruo isn't going to give me another chance."

# game/02_cap1_conexiones.rpy:3152
translate english cap1_interconexion_5_532e55ed:

    # mc_pensamiento "Si me equivoco, no habrá segunda vez."
    mc_pensamiento "If I get it wrong, there won't be a second time."

# game/02_cap1_conexiones.rpy:3156
translate english cap1_interconexion_5_3c0fc883:

    # mc_pensamiento "Maruo sigue confiando en mí."
    mc_pensamiento "Maruo still trusts me."

# game/02_cap1_conexiones.rpy:3158
translate english cap1_interconexion_5_6daef2b0:

    # mc_pensamiento "Pero la confianza también se acaba."
    mc_pensamiento "But trust runs out, too."

# game/02_cap1_conexiones.rpy:3160
translate english cap1_interconexion_5_b82fd808:

    # mc_pensamiento "Las otras dos se van a quedar esperando."
    mc_pensamiento "The other two will be left waiting."

# game/02_cap1_conexiones.rpy:3162
translate english cap1_interconexion_5_14f08cdd:

    # mc_pensamiento "Eso también lo elijo yo."
    mc_pensamiento "That's my choice, too."

# game/02_cap1_conexiones.rpy:3207
translate english cap1_interconexion_6_e29c8c40:

    # narrador "Llegué a mi habitación y fui directamente a mi escritorio."
    narrador "I got to my room and went straight to my desk."

# game/02_cap1_conexiones.rpy:3209
translate english cap1_interconexion_6_f5b0f01a:

    # narrador "Agarré la libreta y la abrí por primera vez en semanas."
    narrador "I grabbed the notebook and opened it for the first time in weeks."

# game/02_cap1_conexiones.rpy:3211
translate english cap1_interconexion_6_dfd06a4f:

    # mc_pensamiento "Cinco nombres con tres tardes ya gastadas."
    mc_pensamiento "Five names, three afternoons already spent."

# game/02_cap1_conexiones.rpy:3213
translate english cap1_interconexion_6_8b121cdd:

    # mc_pensamiento "Y el lunes empiezan los exámenes."
    mc_pensamiento "And the exams start Monday."

# game/02_cap1_conexiones.rpy:3217
translate english cap1_interconexion_6_de994cb5:

    # mc_pensamiento "Con [nombre_h!t], la última tarde salió mejor de lo que esperaba."
    mc_pensamiento "The last afternoon with [nombre_h!t] went better than I expected."

# game/02_cap1_conexiones.rpy:3219
translate english cap1_interconexion_6_5407a410:

    # mc_pensamiento "Puede que hoy hasta duerma."
    mc_pensamiento "Maybe I'll even sleep tonight."

# game/02_cap1_conexiones.rpy:3221
translate english cap1_interconexion_6_3c7fa4a3:

    # mc_pensamiento "Con ellas, que algo salga bien siempre me asusta un poco."
    mc_pensamiento "With them, when something goes well, it always scares me a little."

# game/02_cap1_conexiones.rpy:3225
translate english cap1_interconexion_6_e4f3bd87:

    # mc_pensamiento "No sé si dormiré."
    mc_pensamiento "I don't know if I'll sleep."

# game/02_cap1_conexiones.rpy:3227
translate english cap1_interconexion_6_ed71c05d:

    # mc_pensamiento "Con [nombre_h!t], la última tarde no sumó ni restó."
    mc_pensamiento "The last afternoon with [nombre_h!t] didn't add or subtract anything."

# game/02_cap1_conexiones.rpy:3229
translate english cap1_interconexion_6_4892cf3c:

    # mc_pensamiento "Y con el tiempo contado, eso ya es una forma de perder."
    mc_pensamiento "And with time running out, that's already a way of losing."

# game/02_cap1_conexiones.rpy:3233
translate english cap1_interconexion_6_190abd47:

    # mc_pensamiento "Esta última tarde me pesaba."
    mc_pensamiento "That last afternoon weighed on me."

# game/02_cap1_conexiones.rpy:3235
translate english cap1_interconexion_6_a50ce15f:

    # mc_pensamiento "Me va a costar dormir."
    mc_pensamiento "It's going to be hard to sleep."

# game/02_cap1_conexiones.rpy:3237
translate english cap1_interconexion_6_6a9afc65:

    # mc_pensamiento "Tenía una sola tarde, y la usé para decirle eso a [nombre_h!t]."
    mc_pensamiento "I had one afternoon, and I used it to say that to [nombre_h!t]."

# game/02_cap1_conexiones.rpy:3239
translate english cap1_interconexion_6_edae77f9:

    # mc_pensamiento "Seguía oyendo mi propia voz diciendo lo que dije."
    mc_pensamiento "I kept hearing my own voice saying what I said."

# game/02_cap1_conexiones.rpy:3243
translate english cap1_interconexion_6_3b550a94:

    # mc_pensamiento "Y mi última oportunidad la desperdicié."
    mc_pensamiento "And I wasted my last chance."

# game/02_cap1_conexiones.rpy:3245
translate english cap1_interconexion_6_a9782a81:

    # mc_pensamiento "Sabía que algo se había roto con Maruo. Lo que no sabía era cuánto."
    mc_pensamiento "I knew something had broken with Maruo. What I didn't know was how badly."

# game/02_cap1_conexiones.rpy:3247
translate english cap1_interconexion_6_59f0c7ff:

    # mc_pensamiento "Lo sabré después de los exámenes."
    mc_pensamiento "I'd find out after the exams."

# game/02_cap1_conexiones.rpy:3249
translate english cap1_interconexion_6_a220126b:

    # mc_pensamiento "Cuando vea reprobar a sus hijas."
    mc_pensamiento "When I watch his daughters fail."

# game/02_cap1_conexiones.rpy:3251
translate english cap1_interconexion_6_966e103a:

    # mc_pensamiento "Desde mi pupitre, sin poder decir nada."
    mc_pensamiento "From my desk, unable to say a word."

# game/02_cap1_conexiones.rpy:3253
translate english cap1_interconexion_6_4679d847:

    # mc_pensamiento "No quiero ni imaginar la cara que pondrán Raiha y mi padre."
    mc_pensamiento "I don't even want to imagine the faces Raiha and my father will make."

# game/02_cap1_conexiones.rpy:3257
translate english cap1_interconexion_6_d7143402:

    # mc_pensamiento "La advertencia de Maruo seguía en pie."
    mc_pensamiento "Maruo's warning still stood."

# game/02_cap1_conexiones.rpy:3259
translate english cap1_interconexion_6_615cbe23:

    # mc_pensamiento "Pero esta vez, por los pelos, le había ganado."
    mc_pensamiento "But this time, by a hair, I'd beaten it."

# game/02_cap1_conexiones.rpy:3261
translate english cap1_interconexion_6_20fb25f9:

    # mc_pensamiento "Parece que sí habrá trabajo para el siguiente mes."
    mc_pensamiento "Looks like there'll be work next month after all."

# game/02_cap1_conexiones.rpy:3268
translate english cap1_interconexion_6_21ee4899:

    # mc_pensamiento "Mañana es viernes."
    mc_pensamiento "Tomorrow's Friday."

# game/02_cap1_conexiones.rpy:3270
translate english cap1_interconexion_6_19793afa:

    # mc_pensamiento "El último día antes de la semana de exámenes."
    mc_pensamiento "The last day before exam week."

# game/02_cap1_conexiones.rpy:3272
translate english cap1_interconexion_6_e892e575:

    # mc_pensamiento "Hablaré con las chicas y les daré un mensaje de aliento."
    mc_pensamiento "I'll talk to the girls and give them a pep talk."

# game/02_cap1_conexiones.rpy:3274
translate english cap1_interconexion_6_b2f00d9b:

    # mc_pensamiento "No soy muy bueno animando a gente."
    mc_pensamiento "I'm not good at cheering people up."

# game/02_cap1_conexiones.rpy:3276
translate english cap1_interconexion_6_5ae8a594:

    # mc_pensamiento "Pero mañana daré mi mejor esfuerzo."
    mc_pensamiento "But tomorrow I'll give it my best."

# game/02_cap1_conexiones.rpy:3287
translate english cap1_interconexion_6_b62ccdfb:

    # narrador "Viernes. El instituto olía distinto: a papel subrayado y estudiantes preocupados."
    narrador "Friday. The school smelled different: like highlighted paper and worried students."

# game/02_cap1_conexiones.rpy:3289
translate english cap1_interconexion_6_5dc916ab:

    # narrador "Hasta los alumnos que nunca estudian tenían un cuaderno abierto."
    narrador "Even the students who never study had a notebook open."

# game/02_cap1_conexiones.rpy:3291
translate english cap1_interconexion_6_566cc354:

    # narrador "La tensión se sentía hasta en los rincones del instituto."
    narrador "You could feel the tension in every corner of the school."

# game/02_cap1_conexiones.rpy:3293
translate english cap1_interconexion_6_5fc1b353:

    # narrador "Y yo no podía ser la excepción."
    narrador "And I was no exception."

# game/02_cap1_conexiones.rpy:3297
translate english cap1_interconexion_6_ef5f02a8:

    # mc_pensamiento "Mis exámenes no me quitan el sueño."
    mc_pensamiento "My exams don't keep me up at night."

# game/02_cap1_conexiones.rpy:3299
translate english cap1_interconexion_6_08e08537:

    # mc_pensamiento "Los suyos, sí."
    mc_pensamiento "Theirs do."

# game/02_cap1_conexiones.rpy:3301
translate english cap1_interconexion_6_1a3b9cab:

    # mc_pensamiento "Mejor voy al aula."
    mc_pensamiento "Better head to the classroom."

# game/02_cap1_conexiones.rpy:3306
translate english cap1_interconexion_6_2413c4e6:

    # narrador "En el aula nadie hablaba de otra cosa más que de los exámenes."
    narrador "In the classroom, nobody talked about anything but the exams."

# game/02_cap1_conexiones.rpy:3308
translate english cap1_interconexion_6_230f8a10:

    # narrador "Y las Nakano, menos."
    narrador "And the Nakanos least of all."

# game/02_cap1_conexiones.rpy:3310
translate english cap1_interconexion_6_c08f775c:

    # narrador "De repente, [nombre_h!t] se me cruzó en el camino."
    narrador "Out of nowhere, [nombre_h!t] stepped into my path."

# game/02_cap1_conexiones.rpy:3317
translate english cap1_interconexion_6_480744a7:

    # narrador "A media mañana me alcanzaron, las dos únicas quintillizas."
    narrador "Mid-morning, the only two sisters left caught up with me."

# game/02_cap1_conexiones.rpy:3319
translate english cap1_interconexion_6_2d29bcca:

    # narrador "A las que no había ido a buscar."
    narrador "The two I hadn't gone looking for."

# game/02_cap1_conexiones.rpy:3349
translate english cap1_interconexion_6_022ef673:

    # narrador "Faltaba la cereza del pastel."
    narrador "All that was missing was the cherry on top."

# game/02_cap1_conexiones.rpy:3351
translate english cap1_interconexion_6_a0b933c8:

    # narrador "Y la puso la que había empezado el juego. Con su frialdad de siempre."
    narrador "And it came from the one who started the game. With her usual coolness."

# game/02_cap1_conexiones.rpy:3362
translate english cap1_interconexion_6_f9ed82c5:

    # itsuki "El juego se acabó hoy."
    itsuki "The game ends today."

# game/02_cap1_conexiones.rpy:3364
translate english cap1_interconexion_6_4ac3e07b:

    # mc "¿Ya?"
    mc "Already?"

# game/02_cap1_conexiones.rpy:3366
translate english cap1_interconexion_6_b0f8f4f6:

    # itsuki "Era la última tarde libre. No quedan más."
    itsuki "That was the last free afternoon. There are no more."

# game/02_cap1_conexiones.rpy:3368
translate english cap1_interconexion_6_ffdaed10:

    # mc "Ya lo sabía, señora obvia."
    mc "I know that, Captain Obvious."

# game/02_cap1_conexiones.rpy:3370
translate english cap1_interconexion_6_7bda1083:

    # itsuki "Te dije que no alcanzarías para todas. Tres de cinco."
    itsuki "I told you that you wouldn't reach all of us. Three out of five."

# game/02_cap1_conexiones.rpy:3372
translate english cap1_interconexion_6_d2dd9d5f:

    # itsuki "El trabajo resultó más pesado de lo que creías."
    itsuki "The job turned out heavier than you thought."

# game/02_cap1_conexiones.rpy:3374
translate english cap1_interconexion_6_50d8828a:

    # mc "Lo sé."
    mc "I know."

# game/02_cap1_conexiones.rpy:3380
translate english cap1_interconexion_6_055a5bb9:

    # yotsuba "¡Pero tres de cinco es más de la mitad! ¡Es un sesenta por ciento!"
    yotsuba "But three out of five is more than half! That's sixty percent!"

# game/02_cap1_conexiones.rpy:3382
translate english cap1_interconexion_6_3eee98fa:

    # yotsuba "¡Un sesenta es un buen número!"
    yotsuba "Sixty is a great number!"

# game/02_cap1_conexiones.rpy:3388
translate english cap1_interconexion_6_c3f9ed4d:

    # itsuki "Es un aprobado a medias, Yotsuba."
    itsuki "It's a barely-passing grade, Yotsuba."

# game/02_cap1_conexiones.rpy:3390
translate english cap1_interconexion_6_e59adc18:

    # itsuki "Hay algo de esfuerzo, pero no lo suficiente."
    itsuki "There's some effort, but not enough."

# game/02_cap1_conexiones.rpy:3396
translate english cap1_interconexion_6_ff87fe90:

    # ichika "Y el pobre tutor corriendo detrás de nosotras todo el mes."
    ichika "And poor tutor, running after us all month."

# game/02_cap1_conexiones.rpy:3400
translate english cap1_interconexion_6_182aa232:

    # ichika "Qué romántico."
    ichika "How romantic."

# game/02_cap1_conexiones.rpy:3402
translate english cap1_interconexion_6_4ecb6adc:

    # ichika "A mí me encontró dormida en el suelo."
    ichika "He found me asleep on the floor."

# game/02_cap1_conexiones.rpy:3406
translate english cap1_interconexion_6_182aa232_1:

    # ichika "Qué romántico."
    ichika "How romantic."

# game/02_cap1_conexiones.rpy:3408
translate english cap1_interconexion_6_9e956335:

    # ichika "Casi me dan ganas de haberme dejado encontrar."
    ichika "I almost wish I'd let myself be found."

# game/02_cap1_conexiones.rpy:3410
translate english cap1_interconexion_6_b7dafb17:

    # mc "Fue mi trabajo."
    mc "It was my job."

# game/02_cap1_conexiones.rpy:3412
translate english cap1_interconexion_6_9dcd460c:

    # mc "No tenía otras intenciones."
    mc "I had no other intentions."

# game/02_cap1_conexiones.rpy:3414
translate english cap1_interconexion_6_c5e00067:

    # ichika "Ya, ya. Trabajo."
    ichika "Sure, sure. Work."

# game/02_cap1_conexiones.rpy:3416
translate english cap1_interconexion_6_9387cf32:

    # ichika "Como tú digas."
    ichika "Whatever you say."

# game/02_cap1_conexiones.rpy:3422
translate english cap1_interconexion_6_435cdb8c:

    # nino "Dejen de hacerlo parecer una hazaña."
    nino "Stop making it sound like some great feat."

# game/02_cap1_conexiones.rpy:3424
translate english cap1_interconexion_6_fb8aeb1c:

    # nino "Solo fue un tipo yendo de aquí para allá."
    nino "It was just some guy running back and forth."

# game/02_cap1_conexiones.rpy:3426
translate english cap1_interconexion_6_dec2abf0:

    # nino "Nada relevante."
    nino "Nothing special."

# game/02_cap1_conexiones.rpy:3430
translate english cap1_interconexion_6_a8370f4e:

    # nino "...Pero pensándolo bien."
    nino "...But come to think of it."

# game/02_cap1_conexiones.rpy:3432
translate english cap1_interconexion_6_1cd560ad:

    # nino "...Hasta ahora no fue el peor tutor que hemos tenido."
    nino "...So far, he hasn't been the worst tutor we've had."

# game/02_cap1_conexiones.rpy:3434
translate english cap1_interconexion_6_ca31f8c6:

    # mc "Gracias, Nino, por el cumplido."
    mc "Thanks for the compliment, Nino."

# game/02_cap1_conexiones.rpy:3436
translate english cap1_interconexion_6_ce20d29c:

    # mc "Viniendo de ti, es porque en verdad hice un buen trabajo."
    mc "Coming from you, it means I really did a good job."

# game/02_cap1_conexiones.rpy:3438
translate english cap1_interconexion_6_4326f4e2:

    # narrador "Se volteó con la cara sonrojada."
    narrador "She turned away, her face flushed."

# game/02_cap1_conexiones.rpy:3443
translate english cap1_interconexion_6_cc98f57b:

    # nino "Idiota."
    nino "Idiot."

# game/02_cap1_conexiones.rpy:3445
translate english cap1_interconexion_6_d4cb08c7:

    # nino "Que quede claro que eso no es un cumplido."
    nino "And to be clear, that wasn't a compliment."

# game/02_cap1_conexiones.rpy:3447
translate english cap1_interconexion_6_6f194521:

    # nino "Era tu trabajo, tu obligación, nada más."
    nino "It was your job, your obligation, nothing more."

# game/02_cap1_conexiones.rpy:3451
translate english cap1_interconexion_6_35036d86:

    # nino "Y todavía falta ver si sirvió de algo."
    nino "And we still have to see if it did any good."

# game/02_cap1_conexiones.rpy:3453
translate english cap1_interconexion_6_bc07b2f8:

    # mc "Si sirvió, no lo dudes."
    mc "It did, don't doubt it."

# game/02_cap1_conexiones.rpy:3455
translate english cap1_interconexion_6_8ae195cf:

    # nino "Ya lo veremos en la semana de exámenes."
    nino "We'll see during exam week."

# game/02_cap1_conexiones.rpy:3461
translate english cap1_interconexion_6_099b09b4:

    # nino "Y, siendo sincera, tampoco es que haya servido de mucho."
    nino "And honestly, it hasn't done much anyway."

# game/02_cap1_conexiones.rpy:3463
translate english cap1_interconexion_6_6a71606d:

    # nino "Solo has empeorado las cosas."
    nino "All you've done is make things worse."

# game/02_cap1_conexiones.rpy:3465
translate english cap1_interconexion_6_9bb161ce:

    # nino "Todas lo sabemos."
    nino "We all know it."

# game/02_cap1_conexiones.rpy:3467
translate english cap1_interconexion_6_c468032b:

    # mc_pensamiento "No le discutí, tiene razón."
    mc_pensamiento "I didn't argue. She's right."

# game/02_cap1_conexiones.rpy:3469
translate english cap1_interconexion_6_ac99b2f2:

    # mc_pensamiento "Parece que solo fui a perder el tiempo."
    mc_pensamiento "Looks like I just wasted my time."

# game/02_cap1_conexiones.rpy:3475
translate english cap1_interconexion_6_7666077a:

    # miku "...Entonces ya no hay dónde esconderse."
    miku "...So there's nowhere left to hide."

# game/02_cap1_conexiones.rpy:3477
translate english cap1_interconexion_6_180427cd:

    # mc "No era esa la idea."
    mc "That wasn't the idea."

# game/02_cap1_conexiones.rpy:3479
translate english cap1_interconexion_6_78db6ee4:

    # miku "...Ya lo sé."
    miku "...I know."

# game/02_cap1_conexiones.rpy:3481
translate english cap1_interconexion_6_8ec6e798:

    # miku "...Pero suena a eso."
    miku "...But it sounds like it."

# game/02_cap1_conexiones.rpy:3487
translate english cap1_interconexion_6_a92f9e03:

    # itsuki "Por lo tanto, hoy no queda nada que adivinar."
    itsuki "Therefore, there's nothing left to guess today."

# game/02_cap1_conexiones.rpy:3489
translate english cap1_interconexion_6_35d52dc8:

    # itsuki "Esta tarde se estudia en casa."
    itsuki "This afternoon we study at home."

# game/02_cap1_conexiones.rpy:3491
translate english cap1_interconexion_6_9deb55fb:

    # itsuki "Las cinco. Sin rincones secretos."
    itsuki "All five of us. No secret corners."

# game/02_cap1_conexiones.rpy:3493
translate english cap1_interconexion_6_e0bbdbd3:

    # itsuki "La última sesión de estudio. Sin rodeos."
    itsuki "The last study session. No detours."

# game/02_cap1_conexiones.rpy:3499
translate english cap1_interconexion_6_2bf2b714:

    # nino "¿Y quién te nombró jefa?"
    nino "And who made you boss?"

# game/02_cap1_conexiones.rpy:3505
translate english cap1_interconexion_6_44580b59:

    # itsuki "Nadie. Pero alguien tiene que decirlo."
    itsuki "Nobody. But someone has to say it."

# game/02_cap1_conexiones.rpy:3507
translate english cap1_interconexion_6_30361ca5:

    # itsuki "Y todas pensábamos lo mismo. No hace falta votarlo."
    itsuki "And we were all thinking the same thing. No need to vote."

# game/02_cap1_conexiones.rpy:3509
translate english cap1_interconexion_6_ceb4f0b3:

    # itsuki "Somos quintillizas después de todo."
    itsuki "We're quintuplets, after all."

# game/02_cap1_conexiones.rpy:3514
translate english cap1_interconexion_6_dc776fa4:

    # narrador "Nino abrió la boca para discutir. Y la cerró."
    narrador "Nino opened her mouth to argue. And closed it."

# game/02_cap1_conexiones.rpy:3516
translate english cap1_interconexion_6_008835de:

    # narrador "Eso, con ella, ya era una señal."
    narrador "With her, that was already a sign."

# game/02_cap1_conexiones.rpy:3523
translate english cap1_interconexion_6_8d464183:

    # yotsuba "¡Va a salir bien! ¡Lo presiento!"
    yotsuba "It's going to go well! I can feel it!"

# game/02_cap1_conexiones.rpy:3525
translate english cap1_interconexion_6_8eadd401:

    # yotsuba "¡[mc] ha hecho un buen trabajo con sus tutorías!"
    yotsuba "[mc] did a great job with the tutoring!"

# game/02_cap1_conexiones.rpy:3530
translate english cap1_interconexion_6_de97f8a7:

    # yotsuba "En verdad te lo agradecemos mucho."
    yotsuba "We really do appreciate it. A lot."

# game/02_cap1_conexiones.rpy:3536
translate english cap1_interconexion_6_0d78a20d:

    # itsuki "No te emociones tanto. Todavía no aprobamos nada."
    itsuki "Don't get so excited. We haven't passed anything yet."

# game/02_cap1_conexiones.rpy:3538
translate english cap1_interconexion_6_131fe0a0:

    # itsuki "En la semana de exámenes se lo agradeceremos, si se lo merece."
    itsuki "We'll thank him during exam week, if he earns it."

# game/02_cap1_conexiones.rpy:3543
translate english cap1_interconexion_6_eb2669d2:

    # mc_pensamiento "Era la primera vez que un «va a salir bien» no sonaba a deseo, sino a plan."
    mc_pensamiento "It was the first time a \"it'll go well\" sounded like a plan instead of a wish."

# game/02_cap1_conexiones.rpy:3550
translate english cap1_interconexion_6_d647101c:

    # itsuki "Aprovecha la tarde. No va a haber otra."
    itsuki "Make the most of the afternoon. There won't be another."

# game/02_cap1_conexiones.rpy:3556
translate english cap1_interconexion_6_6fdf2563:

    # miku "...Yo me quedo hasta tarde."
    miku "...I'm staying late."

# game/02_cap1_conexiones.rpy:3558
translate english cap1_interconexion_6_3c5c455c:

    # mc "¿En serio?"
    mc "Really?"

# game/02_cap1_conexiones.rpy:3560
translate english cap1_interconexion_6_6b93a961:

    # miku "...Si no tengo que hablar mucho."
    miku "...If I don't have to talk much."

# game/02_cap1_conexiones.rpy:3570
translate english cap1_interconexion_6_4ea3ff14:

    # itsuki "Y procura no empeorarlo."
    itsuki "And try not to make it worse."

# game/02_cap1_conexiones.rpy:3575
translate english cap1_interconexion_6_6ce34949:

    # narrador "Nadie se rió. Ni siquiera Ichika."
    narrador "Nobody laughed. Not even Ichika."

# game/02_cap1_conexiones.rpy:3577
translate english cap1_interconexion_6_8b07fcb7:

    # mc_pensamiento "Cuando Ichika no rellena un silencio con un chiste, ese silencio es molestia."
    mc_pensamiento "When Ichika doesn't fill a silence with a joke, that silence means she's annoyed."

# game/02_cap1_conexiones.rpy:3579
translate english cap1_interconexion_6_774f8cb1:

    # mc_pensamiento "Saben que lo arruiné."
    mc_pensamiento "They know I blew it."

# game/02_cap1_conexiones.rpy:3581
translate english cap1_interconexion_6_3a56aa9a:

    # mc_pensamiento "Pero no me lo quieren decir de manera directa."
    mc_pensamiento "But they don't want to say it to my face."

# game/02_cap1_conexiones.rpy:3605
translate english cap1_interconexion_6_3252fe7a:

    # narrador "En la entrada había un par de zapatos de hombre."
    narrador "There was a pair of men's shoes by the door."

# game/02_cap1_conexiones.rpy:3607
translate english cap1_interconexion_6_e7489d06:

    # narrador "Negros, alineados con cuidado."
    narrador "Black, lined up carefully."

# game/02_cap1_conexiones.rpy:3609
translate english cap1_interconexion_6_d0fdf0e5:

    # mc_pensamiento "Un mes viniendo todos los días."
    mc_pensamiento "A month of coming here every day."

# game/02_cap1_conexiones.rpy:3611
translate english cap1_interconexion_6_45223d33:

    # mc_pensamiento "Era la primera vez que los veía a esta hora."
    mc_pensamiento "It was the first time I'd seen them at this hour."

# game/02_cap1_conexiones.rpy:3613
translate english cap1_interconexion_6_9d6611c0:

    # narrador "Esa tarde estudiamos en el departamento."
    narrador "That afternoon we studied at the apartment."

# game/02_cap1_conexiones.rpy:3615
translate english cap1_interconexion_6_f7f0e3c4:

    # narrador "Las cinco estaban juntas, como había pedido Itsuki."
    narrador "All five were together, as Itsuki had asked."

# game/02_cap1_conexiones.rpy:3617
translate english cap1_interconexion_6_e86ba673:

    # narrador "Finalmente vi el resultado de nuestros estudios."
    narrador "I finally saw the result of all our studying."

# game/02_cap1_conexiones.rpy:3626
translate english cap1_interconexion_6_9967e280:

    # narrador "Hacía un mes, esta mesa era un campo de batalla."
    narrador "A month ago, this table was a battlefield."

# game/02_cap1_conexiones.rpy:3628
translate english cap1_interconexion_6_5b8561ad:

    # narrador "Hoy no tuve que decir «saquen los cuadernos»."
    narrador "Today I didn't have to say \"take out your notebooks.\""

# game/02_cap1_conexiones.rpy:3630
translate english cap1_interconexion_6_b0e0ce92:

    # narrador "Ya estaban abiertos."
    narrador "They were already open."

# game/02_cap1_conexiones.rpy:3632
translate english cap1_interconexion_6_8d4ba724:

    # narrador "Yotsuba subrayaba con tres colores a la vez."
    narrador "Yotsuba was highlighting in three colors at once."

# game/02_cap1_conexiones.rpy:3634
translate english cap1_interconexion_6_17562f0a:

    # narrador "No sé si sabía qué estaba subrayando, pero lo hacía con muchísimo entusiasmo."
    narrador "I don't know if she knew what she was highlighting, but she did it with a ton of enthusiasm."

# game/02_cap1_conexiones.rpy:3636
translate english cap1_interconexion_6_b27a0c6d:

    # narrador "Ichika repasaba en voz baja, con los ojos abiertos."
    narrador "Ichika was reviewing under her breath, eyes open."

# game/02_cap1_conexiones.rpy:3638
translate english cap1_interconexion_6_d535f295:

    # narrador "Sin siquiera dormirse en medio de la sesión. Un récord."
    narrador "She hadn't even dozed off mid-session. A record."

# game/02_cap1_conexiones.rpy:3640
translate english cap1_interconexion_6_e3a98f42:

    # narrador "Nino e Itsuki comparaban respuestas en voz baja, codo con codo, sin mirarse."
    narrador "Nino and Itsuki were comparing answers in low voices, elbow to elbow, not looking at each other."

# game/02_cap1_conexiones.rpy:3642
translate english cap1_interconexion_6_8517036b:

    # narrador "Como quien negocia una tregua."
    narrador "Like people negotiating a truce."

# game/02_cap1_conexiones.rpy:3644
translate english cap1_interconexion_6_7d5178a0:

    # narrador "Miku tenía los audífonos colgados del cuello. Sin tocarlos."
    narrador "Miku had her headphones hanging around her neck. Untouched."

# game/02_cap1_conexiones.rpy:3646
translate english cap1_interconexion_6_d4235706:

    # narrador "Ya no estaba en su burbuja, esta vez era diferente."
    narrador "She wasn't in her bubble anymore. This time was different."

# game/02_cap1_conexiones.rpy:3648
translate english cap1_interconexion_6_8b7b3d50:

    # narrador "Itsuki tenía el cuaderno abierto de verdad."
    narrador "Itsuki had her notebook actually open."

# game/02_cap1_conexiones.rpy:3650
translate english cap1_interconexion_6_371c9430:

    # narrador "Esta vez sí lo estaba leyendo."
    narrador "This time she was really reading it."

# game/02_cap1_conexiones.rpy:3652
translate english cap1_interconexion_6_3e3501bd:

    # mc_pensamiento "Cinco cuadernos, cinco lápices y cero fracasos."
    mc_pensamiento "Five notebooks, five pencils, and zero failures."

# game/02_cap1_conexiones.rpy:3654
translate english cap1_interconexion_6_0eb2a01b:

    # mc_pensamiento "Un mes atrás, esto era imposible."
    mc_pensamiento "A month ago, this was impossible."

# game/02_cap1_conexiones.rpy:3656
translate english cap1_interconexion_6_92e42659:

    # mc_pensamiento "Y ni siquiera supe en qué momento dejó de serlo."
    mc_pensamiento "And I never even noticed when it stopped being so."

# game/02_cap1_conexiones.rpy:3658
translate english cap1_interconexion_6_80bb3c1c:

    # mc_pensamiento "No sé cómo les irá."
    mc_pensamiento "I don't know how they'll do."

# game/02_cap1_conexiones.rpy:3660
translate english cap1_interconexion_6_afcc39b4:

    # mc_pensamiento "Por primera vez, tengo motivos para pensar que bien."
    mc_pensamiento "For the first time, I have reason to think it'll go well."

# game/02_cap1_conexiones.rpy:3662
translate english cap1_interconexion_6_17ec1501:

    # mc_pensamiento "De eso estoy seguro."
    mc_pensamiento "I'm sure of that."

# game/02_cap1_conexiones.rpy:3671
translate english cap1_interconexion_6_063b1d84:

    # narrador "Desde la puerta parecía la misma escena del primer día."
    narrador "From the doorway it looked like the same scene as the first day."

# game/02_cap1_conexiones.rpy:3673
translate english cap1_interconexion_6_e787653e:

    # narrador "Hasta que me fijé en los detalles: nadie se había ido a su cuarto."
    narrador "Until I noticed the details: nobody had gone off to her room."

# game/02_cap1_conexiones.rpy:3675
translate english cap1_interconexion_6_7f9a83d5:

    # narrador "Ichika cabeceaba entre fórmula y fórmula. Pero se despertaba sola y volvía a empezar."
    narrador "Ichika nodded off between formulas. But she woke herself up and started again."

# game/02_cap1_conexiones.rpy:3677
translate english cap1_interconexion_6_b3a1dd62:

    # narrador "Miku tenía los audífonos colgados del cuello."
    narrador "Miku had her headphones hanging around her neck."

# game/02_cap1_conexiones.rpy:3679
translate english cap1_interconexion_6_72481a27:

    # narrador "Y la mano lejos de ellos. Para ella, eso era un avance enorme."
    narrador "And her hand nowhere near them. For her, that was huge progress."

# game/02_cap1_conexiones.rpy:3681
translate english cap1_interconexion_6_5962b179:

    # narrador "Nino hacía como que no estaba, pero se enteraba de todo y corregía a media voz."
    narrador "Nino acted like she wasn't there, but she caught everything and corrected under her breath."

# game/02_cap1_conexiones.rpy:3683
translate english cap1_interconexion_6_b1656827:

    # narrador "Yotsuba intentaba concentrarse. Se le notaba en lo fuerte que apretaba el lápiz."
    narrador "Yotsuba was trying to concentrate. You could tell by how hard she gripped her pencil."

# game/02_cap1_conexiones.rpy:3685
translate english cap1_interconexion_6_e5072491:

    # narrador "Itsuki estudiaba a su ritmo, sin pedirle nada a nadie."
    narrador "Itsuki studied at her own pace, asking nothing of anyone."

# game/02_cap1_conexiones.rpy:3687
translate english cap1_interconexion_6_767d16fd:

    # mc_pensamiento "No era la mesa de hace un mes. Pero tampoco la que necesitaba."
    mc_pensamiento "It wasn't the table from a month ago. But it wasn't the one I needed, either."

# game/02_cap1_conexiones.rpy:3689
translate english cap1_interconexion_6_9d48b0a0:

    # mc_pensamiento "Me hacía falta una tarde más para arreglarlo. Y ya no tenía tardes."
    mc_pensamiento "I needed one more afternoon to fix it. And I had no afternoons left."

# game/02_cap1_conexiones.rpy:3691
translate english cap1_interconexion_6_c21b9600:

    # mc_pensamiento "Ahora solo queda esperar."
    mc_pensamiento "Now all that's left is waiting."

# game/02_cap1_conexiones.rpy:3693
translate english cap1_interconexion_6_9bedd82a:

    # mc_pensamiento "Y no sé si después de esa semana seguiré teniendo este trabajo."
    mc_pensamiento "And I don't know if I'll still have this job after that week."

# game/02_cap1_conexiones.rpy:3702
translate english cap1_interconexion_6_b7df658a:

    # narrador "Era casi la misma imagen del primer día."
    narrador "It was almost the same picture as the first day."

# game/02_cap1_conexiones.rpy:3704
translate english cap1_interconexion_6_414da71f:

    # narrador "Con una diferencia: ahora sabía lo que estaba viendo."
    narrador "With one difference: now I knew what I was looking at."

# game/02_cap1_conexiones.rpy:3706
translate english cap1_interconexion_6_9f50c221:

    # narrador "Ichika, con la cabeza en el respaldo y los ojos cerrados."
    narrador "Ichika, head against the backrest, eyes closed."

# game/02_cap1_conexiones.rpy:3708
translate english cap1_interconexion_6_2641f889:

    # narrador "Esta vez no parecía fingir."
    narrador "This time she didn't seem to be faking."

# game/02_cap1_conexiones.rpy:3710
translate english cap1_interconexion_6_4b6d877a:

    # narrador "Miku, con los audífonos puestos y sonando."
    narrador "Miku, headphones on and playing."

# game/02_cap1_conexiones.rpy:3712
translate english cap1_interconexion_6_357a806b:

    # narrador "Nino, con los brazos cruzados y la hoja en blanco, mirándome como si yo fuera el problema."
    narrador "Nino, arms crossed, her sheet blank, glaring at me like I was the problem."

# game/02_cap1_conexiones.rpy:3714
translate english cap1_interconexion_6_3c258839:

    # narrador "Yotsuba sonreía enorme sobre una hoja casi vacía."
    narrador "Yotsuba grinned wide over a nearly empty sheet."

# game/02_cap1_conexiones.rpy:3716
translate english cap1_interconexion_6_7905446f:

    # narrador "Itsuki, encorvada sobre su hoja, atascada en el mismo problema."
    narrador "Itsuki, hunched over her sheet, stuck on the same problem."

# game/02_cap1_conexiones.rpy:3718
translate english cap1_interconexion_6_13daf980:

    # mc_pensamiento "Un mes de trabajo y la mesa seguía igual de vacía."
    mc_pensamiento "A month of work and the table was just as empty."

# game/02_cap1_conexiones.rpy:3720
translate english cap1_interconexion_6_325638c5:

    # mc_pensamiento "Y esta vez no podía culpar a nadie más que a mí."
    mc_pensamiento "And this time I couldn't blame anyone but myself."

# game/02_cap1_conexiones.rpy:3722
translate english cap1_interconexion_6_344ab5f2:

    # mc_pensamiento "Si después de la semana de exámenes me despiden, será justo."
    mc_pensamiento "If they fire me after exam week, it'll be fair."

# game/02_cap1_conexiones.rpy:3737
translate english cap1_interconexion_6_bb8d9543:

    # narrador "Maruo apareció en la puerta del departamento."
    narrador "Maruo appeared in the apartment doorway."

# game/02_cap1_conexiones.rpy:3739
translate english cap1_interconexion_6_fbb79513:

    # narrador "Los zapatos de la entrada eran suyos."
    narrador "The shoes by the door were his."

# game/02_cap1_conexiones.rpy:3741
translate english cap1_interconexion_6_cbe82050:

    # maruo "Vine a ver cómo iba el estudio."
    maruo "I came to see how the studying is going."

# game/02_cap1_conexiones.rpy:3743
translate english cap1_interconexion_6_bada0e27:

    # narrador "Miró la mesa. Miró a sus hijas. Después me miró a mí."
    narrador "He looked at the table. At his daughters. Then at me."

# game/02_cap1_conexiones.rpy:3747
translate english cap1_interconexion_6_064bf1d6:

    # maruo "Ya vi suficiente."
    maruo "I have seen enough."

# game/02_cap1_conexiones.rpy:3749
translate english cap1_interconexion_6_e47f68a8:

    # mc "Señor, todavía quedan..."
    mc "Sir, there's still..."

# game/02_cap1_conexiones.rpy:3751
translate english cap1_interconexion_6_1efac3cb:

    # maruo "Al terminar la semana lo confirmo."
    maruo "I will confirm it at the end of the week."

# game/02_cap1_conexiones.rpy:3753
translate english cap1_interconexion_6_83aada09:

    # narrador "No repitió la advertencia. Ya no era una advertencia."
    narrador "He didn't repeat the warning. It wasn't a warning anymore."

# game/02_cap1_conexiones.rpy:3755
translate english cap1_interconexion_6_18ba129f:

    # narrador "Se fue sin esperar respuesta."
    narrador "He left without waiting for an answer."

# game/02_cap1_conexiones.rpy:3759
translate english cap1_interconexion_6_c3660936:

    # narrador "Cerró con la calma de siempre."
    narrador "He shut the door with his usual calm."

# game/02_cap1_conexiones.rpy:3761
translate english cap1_interconexion_6_9514a6ae:

    # mc_pensamiento "Lo peor no era la amenaza. Era que sonaba a algo ya decidido."
    mc_pensamiento "The worst part wasn't the threat. It was how it sounded like something already decided."

# game/02_cap1_conexiones.rpy:3763
translate english cap1_interconexion_6_36e688d8:

    # mc_pensamiento "Mi destino ya estaba sellado."
    mc_pensamiento "My fate was sealed."

# game/02_cap1_conexiones.rpy:3767
translate english cap1_interconexion_6_13bf9935:

    # maruo "En la cocina te dije que esta era tu última oportunidad."
    maruo "In the kitchen I told you this was your last chance."

# game/02_cap1_conexiones.rpy:3769
translate english cap1_interconexion_6_b5607ee9:

    # mc "Lo recuerdo."
    mc "I remember."

# game/02_cap1_conexiones.rpy:3771
translate english cap1_interconexion_6_c5e53baf:

    # maruo "Veo que no la desperdiciaste."
    maruo "I see you did not waste it."

# game/02_cap1_conexiones.rpy:3773
translate english cap1_interconexion_6_837cbc27:

    # narrador "No sonrió. Maruo no sonríe."
    narrador "He didn't smile. Maruo doesn't smile."

# game/02_cap1_conexiones.rpy:3775
translate english cap1_interconexion_6_056b0cdd:

    # narrador "Pero tardó un segundo de más en irse."
    narrador "But he took a second too long to leave."

# game/02_cap1_conexiones.rpy:3777
translate english cap1_interconexion_6_6c64f57a:

    # maruo "No te confíes. Los exámenes empiezan la siguiente semana."
    maruo "Do not get overconfident. The exams start next week."

# game/02_cap1_conexiones.rpy:3781
translate english cap1_interconexion_6_c3660936_1:

    # narrador "Cerró con la calma de siempre."
    narrador "He shut the door with his usual calm."

# game/02_cap1_conexiones.rpy:3783
translate english cap1_interconexion_6_a3f362bc:

    # mc_pensamiento "Viniendo de él, eso casi era un aplauso."
    mc_pensamiento "Coming from him, that was practically applause."

# game/02_cap1_conexiones.rpy:3785
translate english cap1_interconexion_6_af6371f7:

    # mc_pensamiento "Aún me queda mi última oportunidad."
    mc_pensamiento "I still have my last chance."

# game/02_cap1_conexiones.rpy:3799
translate english cap1_interconexion_6_2c844846:

    # mc_pensamiento "Maruo no apareció esa tarde."
    mc_pensamiento "Maruo didn't show up that afternoon."

# game/02_cap1_conexiones.rpy:3801
translate english cap1_interconexion_6_1c83cd7d:

    # mc_pensamiento "Con la mesa así, ni falta hacía."
    mc_pensamiento "With the table like that, he didn't need to."

# game/02_cap1_conexiones.rpy:3803
translate english cap1_interconexion_6_cd724de1:

    # mc_pensamiento "Pero cuando me fui, sus zapatos seguían en la entrada."
    mc_pensamiento "But when I left, his shoes were still by the door."

# game/02_cap1_conexiones.rpy:3805
translate english cap1_interconexion_6_d44413c6:

    # mc_pensamiento "No sé a qué hora llegó. No sé cuánto escuchó."
    mc_pensamiento "I don't know when he got there. I don't know how much he heard."

# game/02_cap1_conexiones.rpy:3807
translate english cap1_interconexion_6_628e6243:

    # mc_pensamiento "Solo sé que no interrumpió."
    mc_pensamiento "I only know he didn't interrupt."

# game/02_cap1_conexiones.rpy:3811
translate english cap1_interconexion_6_2c844846_1:

    # mc_pensamiento "Maruo no apareció esa tarde."
    mc_pensamiento "Maruo didn't show up that afternoon."

# game/02_cap1_conexiones.rpy:3813
translate english cap1_interconexion_6_25868131:

    # mc_pensamiento "Con él, no saber si eso es buena o mala señal ya es costumbre."
    mc_pensamiento "With him, not knowing whether that's a good or bad sign is par for the course."

# game/02_cap1_conexiones.rpy:3815
translate english cap1_interconexion_6_177b570f:

    # mc_pensamiento "Aunque sus zapatos seguían en la entrada cuando me fui."
    mc_pensamiento "Though his shoes were still by the door when I left."

# game/02_cap1_conexiones.rpy:3817
translate english cap1_interconexion_6_6987988c:

    # mc_pensamiento "Tal vez aparezca cuando terminen los exámenes. Con su último mensaje para mí."
    mc_pensamiento "Maybe he'll turn up when the exams are over. With his final message for me."

# game/02_cap1_conexiones.rpy:3819
translate english cap1_interconexion_6_aa067f33:

    # mc_pensamiento "Ojalá no llegue ese día."
    mc_pensamiento "I hope that day never comes."

# game/02_cap1_conexiones.rpy:3824
translate english cap1_interconexion_6_ddf2c1a3:

    # narrador "Terminamos pasadas las seis. Nadie quería ser la primera en irse."
    narrador "We finished a little after six. Nobody wanted to be the first to leave."

# game/02_cap1_conexiones.rpy:3826
translate english cap1_interconexion_6_af707b41:

    # narrador "Yotsuba llevaba diez minutos diciendo que era su última pregunta."
    narrador "Yotsuba had been saying it was her last question for ten minutes."

# game/02_cap1_conexiones.rpy:3828
translate english cap1_interconexion_6_18fd948a:

    # yotsuba "¡Una más! ¡Pero esta sí es la última! ¡Palabra de atleta!"
    yotsuba "One more! But this one's really the last! Athlete's honor!"

# game/02_cap1_conexiones.rpy:3830
translate english cap1_interconexion_6_6f210dc7:

    # mc "Esa ya la dijiste tres veces."
    mc "You've said that three times already."

# game/02_cap1_conexiones.rpy:3832
translate english cap1_interconexion_6_ff00c164:

    # yotsuba "¡Y las tres iba en serio!"
    yotsuba "And I meant it all three times!"

# game/02_cap1_conexiones.rpy:3834
translate english cap1_interconexion_6_09bf44ca:

    # narrador "Ichika se estiró y soltó un bostezo de verdad. No de actuación."
    narrador "Ichika stretched and let out a real yawn. Not an act."

# game/02_cap1_conexiones.rpy:3836
translate english cap1_interconexion_6_2870129f:

    # narrador "Y, por primera vez, no dijo que el estrés le arruinaba la piel."
    narrador "And for the first time, she didn't claim stress was ruining her skin."

# game/02_cap1_conexiones.rpy:3838
translate english cap1_interconexion_6_6b21f1a9:

    # narrador "Nino e Itsuki seguían comparando respuestas. Ya no discutían. Se corregían."
    narrador "Nino and Itsuki were still comparing answers. They'd stopped arguing. They corrected each other."

# game/02_cap1_conexiones.rpy:3840
translate english cap1_interconexion_6_ba7a7b4c:

    # nino "Tu tercer paso estaba bien. La que no lo había entendido era yo."
    nino "Your third step was right. I was the one who didn't get it."

# game/02_cap1_conexiones.rpy:3842
translate english cap1_interconexion_6_739f11a5:

    # itsuki "...Gracias."
    itsuki "...Thank you."

# game/02_cap1_conexiones.rpy:3844
translate english cap1_interconexion_6_a23f018b:

    # narrador "Lo dijo tan bajito que Nino fingió no oírlo."
    narrador "She said it so quietly Nino pretended not to hear."

# game/02_cap1_conexiones.rpy:3846
translate english cap1_interconexion_6_f7020fa3:

    # narrador "Miku fue la última en guardar el libro. Antes de irse se detuvo en la puerta."
    narrador "Miku was the last to put her book away. Before leaving, she paused at the door."

# game/02_cap1_conexiones.rpy:3848
translate english cap1_interconexion_6_997d7fc7:

    # miku "...Fue una buena tarde."
    miku "...That was a good afternoon."

# game/02_cap1_conexiones.rpy:3850
translate english cap1_interconexion_6_3348a18d:

    # mc "Lo fue."
    mc "It was."

# game/02_cap1_conexiones.rpy:3852
translate english cap1_interconexion_6_50fa95c7:

    # narrador "Lo dijo sin subirse los audífonos. Y sin pedir perdón después."
    narrador "She said it without pulling her headphones up. And without apologizing afterward."

# game/02_cap1_conexiones.rpy:3854
translate english cap1_interconexion_6_b4867af8:

    # mc_pensamiento "Parecía que, por fin, me habían aceptado como su tutor."
    mc_pensamiento "It seemed they'd finally accepted me as their tutor."

# game/02_cap1_conexiones.rpy:3856
translate english cap1_interconexion_6_32181c3f:

    # mc_pensamiento "O, al menos, habían dejado de intentar echarme."
    mc_pensamiento "Or at least they'd stopped trying to throw me out."

# game/02_cap1_conexiones.rpy:3858
translate english cap1_interconexion_6_b3a3b561:

    # mc_pensamiento "Un mes atrás habría pagado por una tarde así. Y no habría creído que existía."
    mc_pensamiento "A month ago I'd have paid for an afternoon like this. And I wouldn't have believed it existed."

# game/02_cap1_conexiones.rpy:3862
translate english cap1_interconexion_6_3bcd8959:

    # narrador "Terminamos pasadas las seis. Nadie se fue corriendo, pero nadie se quedó de más."
    narrador "We finished a little after six. Nobody ran out, but nobody lingered either."

# game/02_cap1_conexiones.rpy:3864
translate english cap1_interconexion_6_812a5994:

    # narrador "Ichika recogió sus cosas todavía medio dormida y se despidió con la mano. Sin chiste."
    narrador "Ichika gathered her things, still half asleep, and waved goodbye. No joke."

# game/02_cap1_conexiones.rpy:3866
translate english cap1_interconexion_6_1d5e6281:

    # narrador "En ella, una despedida sin chiste ya era noticia."
    narrador "For her, a goodbye without a joke was news."

# game/02_cap1_conexiones.rpy:3868
translate english cap1_interconexion_6_bcc064b5:

    # narrador "Nino se fue sin decirme nada."
    narrador "Nino left without saying anything to me."

# game/02_cap1_conexiones.rpy:3870
translate english cap1_interconexion_6_4ffd00dc:

    # narrador "Pero la hoja de Yotsuba, que había quedado sobre la mesa, tenía tres correcciones con su letra."
    narrador "But Yotsuba's sheet, left on the table, had three corrections in Nino's handwriting."

# game/02_cap1_conexiones.rpy:3872
translate english cap1_interconexion_6_8657e07d:

    # yotsuba "¡Mañana seguiremos! ¡Y será mejor!"
    yotsuba "We'll keep going tomorrow! And it'll be better!"

# game/02_cap1_conexiones.rpy:3874
translate english cap1_interconexion_6_a1be46cc:

    # narrador "Lo dijo guardando lápices más tiempo del necesario, esperando que alguien le contestara."
    narrador "She said it while putting away pencils for longer than necessary, waiting for someone to answer."

# game/02_cap1_conexiones.rpy:3876
translate english cap1_interconexion_6_7d0f5309:

    # mc "Mañana seguiremos."
    mc "We'll keep going tomorrow."

# game/02_cap1_conexiones.rpy:3878
translate english cap1_interconexion_6_c7d3b801:

    # narrador "Itsuki cerró el cuaderno y dijo que le quedaba algo por repasar sola."
    narrador "Itsuki closed her notebook and said she had something left to review alone."

# game/02_cap1_conexiones.rpy:3880
translate english cap1_interconexion_6_e4b90508:

    # narrador "No me pidió ayuda. Tampoco me pidió que me fuera."
    narrador "She didn't ask for help. She didn't ask me to leave, either."

# game/02_cap1_conexiones.rpy:3882
translate english cap1_interconexion_6_5d005e68:

    # miku "...Hasta mañana."
    miku "...See you tomorrow."

# game/02_cap1_conexiones.rpy:3884
translate english cap1_interconexion_6_4d06f82a:

    # narrador "Dos palabras, dichas desde la puerta, sin subirse los audífonos. Un avance enorme."
    narrador "A few words, said from the doorway, without pulling her headphones up. Huge progress."

# game/02_cap1_conexiones.rpy:3886
translate english cap1_interconexion_6_5289a195:

    # mc_pensamiento "No fue un aplauso. Pero tampoco fue el portazo del primer día."
    mc_pensamiento "It wasn't applause. But it wasn't the slammed door of the first day, either."

# game/02_cap1_conexiones.rpy:3888
translate english cap1_interconexion_6_8582650c:

    # mc_pensamiento "Con ellas, eso ya es mucho."
    mc_pensamiento "With them, that's already a lot."

# game/02_cap1_conexiones.rpy:3890
translate english cap1_interconexion_6_6ea7c148:

    # mc_pensamiento "Lo que no sabía era si sería suficiente para que aprueben los exámenes."
    mc_pensamiento "What I didn't know was whether it would be enough to pass the exams."

# game/02_cap1_conexiones.rpy:3892
translate english cap1_interconexion_6_c39a0182:

    # mc_pensamiento "No lo sé."
    mc_pensamiento "I don't know."

# game/02_cap1_conexiones.rpy:3896
translate english cap1_interconexion_6_f39c2417:

    # narrador "Terminamos pasadas las seis. Se fueron saliendo de a una, sin despedirse del todo."
    narrador "We finished a little after six. They left one by one, never quite saying goodbye."

# game/02_cap1_conexiones.rpy:3898
translate english cap1_interconexion_6_bf5c1869:

    # narrador "Ichika se despertó cuando ya nadie la miraba."
    narrador "Ichika woke up when nobody was looking anymore."

# game/02_cap1_conexiones.rpy:3900
translate english cap1_interconexion_6_ca2b3580:

    # narrador "Se frotó la cara y dijo «mañana me pongo al día»."
    narrador "She rubbed her face and said, \"I'll catch up tomorrow.\""

# game/02_cap1_conexiones.rpy:3902
translate english cap1_interconexion_6_bd2e9301:

    # narrador "Sin gracia. Sin guiño. Como quien lo repite desde hace semanas."
    narrador "No flair. No wink. Like someone who's been saying it for weeks."

# game/02_cap1_conexiones.rpy:3904
translate english cap1_interconexion_6_f48aab32:

    # narrador "Miku salió con los audífonos puestos y sonando."
    narrador "Miku left with her headphones on and playing."

# game/02_cap1_conexiones.rpy:3906
translate english cap1_interconexion_6_ace83179:

    # narrador "Me miró una vez, de reojo, y no dijo nada."
    narrador "She glanced at me once, sideways, and said nothing."

# game/02_cap1_conexiones.rpy:3908
translate english cap1_interconexion_6_cb8cb3c1:

    # narrador "Nino pasó a mi lado con la hoja en blanco, doblada en cuatro."
    narrador "Nino walked past me with her blank sheet, folded in four."

# game/02_cap1_conexiones.rpy:3910
translate english cap1_interconexion_6_a1f47aee:

    # narrador "No la dejó sobre la mesa. Se la llevó, como quien guarda una prueba."
    narrador "She didn't leave it on the table. She took it, like someone keeping evidence."

# game/02_cap1_conexiones.rpy:3912
translate english cap1_interconexion_6_4360b091:

    # yotsuba "¡Mañana lo hago mejor! ¡Lo prometo!"
    yotsuba "I'll do better tomorrow! I promise!"

# game/02_cap1_conexiones.rpy:3914
translate english cap1_interconexion_6_371037a1:

    # narrador "Lo dijo sonriendo. Con la hoja casi vacía todavía en la mano."
    narrador "She said it smiling. The nearly empty sheet still in her hand."

# game/02_cap1_conexiones.rpy:3916
translate english cap1_interconexion_6_9d5af914:

    # narrador "Ya no sabía si me lo decía a mí o se lo decía a ella."
    narrador "I couldn't tell anymore if she was saying it to me or to herself."

# game/02_cap1_conexiones.rpy:3918
translate english cap1_interconexion_6_c11aee52:

    # narrador "Itsuki fue la última. Seguía mirando el mismo problema. Cerró el cuaderno despacio."
    narrador "Itsuki was last. Still staring at the same problem. She closed her notebook slowly."

# game/02_cap1_conexiones.rpy:3920
translate english cap1_interconexion_6_fee3c319:

    # itsuki "Hasta mañana."
    itsuki "Until tomorrow."

# game/02_cap1_conexiones.rpy:3922
translate english cap1_interconexion_6_5c632bc0:

    # narrador "Dos palabras, sin una pizca de rencor. Y sin una sola de calidez."
    narrador "Two words, without a trace of resentment. And without a trace of warmth."

# game/02_cap1_conexiones.rpy:3924
translate english cap1_interconexion_6_8c3b762a:

    # mc_pensamiento "Nada ha cambiado desde el primer día."
    mc_pensamiento "Nothing has changed since the first day."

# game/02_cap1_conexiones.rpy:3926
translate english cap1_interconexion_6_7431ae82:

    # mc_pensamiento "O más bien yo no las he hecho cambiar."
    mc_pensamiento "Or rather, I haven't made them change."

# game/02_cap1_conexiones.rpy:3928
translate english cap1_interconexion_6_cf2d2182:

    # mc_pensamiento "Era un fracaso que se veía venir."
    mc_pensamiento "It was a failure you could see coming."

# game/02_cap1_conexiones.rpy:3939
translate english cap1_interconexion_6_25c2bdf7:

    # narrador "Sábado."
    narrador "Saturday."

# game/02_cap1_conexiones.rpy:3941
translate english cap1_interconexion_6_a53e6450:

    # narrador "Sin clases, sin tutorías. Solo tiempo para pensar."
    narrador "No classes, no tutoring. Just time to think."

# game/02_cap1_conexiones.rpy:3948
translate english cap1_interconexion_6_99be1521:

    # narrador "Pasé el día mirando el chat del grupo."
    narrador "I spent the day staring at the group chat."

# game/02_cap1_conexiones.rpy:3952
translate english cap1_interconexion_6_b27f53ff:

    # mc_pensamiento "Les mandaré un mensaje de motivación."
    mc_pensamiento "I'll send them a motivational message."

# game/02_cap1_conexiones.rpy:3954
translate english cap1_interconexion_6_863f7a5f:

    # mc_pensamiento "No sé qué decirles. Cualquier cosa va a sonar a póster motivacional."
    mc_pensamiento "I don't know what to say. Anything will sound like a motivational poster."

# game/02_cap1_conexiones.rpy:3965
translate english cap1_interconexion_6_012cbaa0:

    # mc_pensamiento "Lo escribí, lo borré y lo volví a escribir."
    mc_pensamiento "I wrote it, deleted it, and wrote it again."

# game/02_cap1_conexiones.rpy:3967
translate english cap1_interconexion_6_c8fae95f:

    # mc_pensamiento "Sigo sintiendo que escribí un mensaje humillante."
    mc_pensamiento "I still feel like I wrote something humiliating."

# game/02_cap1_conexiones.rpy:3973
translate english cap1_interconexion_6_77e657b5:

    # mc_pensamiento "Lo mandé antes de arrepentirme."
    mc_pensamiento "I sent it before I could regret it."

# game/02_cap1_conexiones.rpy:3975
translate english cap1_interconexion_6_8986e60c:

    # mc_pensamiento "Acabo de firmar mi sentencia de humillación."
    mc_pensamiento "I've just sentenced myself to humiliation."

# game/02_cap1_conexiones.rpy:3981
translate english cap1_interconexion_6_f98e5879:

    # mc_pensamiento "Mitad broma, mitad cierto."
    mc_pensamiento "Half joke, half true."

# game/02_cap1_conexiones.rpy:3987
translate english cap1_interconexion_6_41e62b02:

    # mc_pensamiento "Cuatro segundos. Ni había soltado el celular."
    mc_pensamiento "Four seconds. I hadn't even put the phone down."

# game/02_cap1_conexiones.rpy:3991
translate english cap1_interconexion_6_7347389d:

    # mc_pensamiento "Once signos de exclamación. Los conté."
    mc_pensamiento "Eleven exclamation points. I counted."

# game/02_cap1_conexiones.rpy:3995
translate english cap1_interconexion_6_37c31c9f:

    # mc_pensamiento "Lo escribió la que siempre se queda con la culpa de las cinco."
    mc_pensamiento "It was written by the one who always takes the blame for all five."

# game/02_cap1_conexiones.rpy:3997
translate english cap1_interconexion_6_9606e0ce:

    # mc_pensamiento "A ella nadie se lo dice."
    mc_pensamiento "Nobody ever says that to her."

# game/02_cap1_conexiones.rpy:4001
translate english cap1_interconexion_6_847a4ea1:

    # mc_pensamiento "Cuatro respuestas en un minuto. Hace un mes ni abrían el chat."
    mc_pensamiento "Four replies in a minute. A month ago they wouldn't even open the chat."

# game/02_cap1_conexiones.rpy:4003
translate english cap1_interconexion_6_498d4651:

    # mc_pensamiento "Pensé que me iban a humillar, pero resultó lo contrario."
    mc_pensamiento "I thought they'd humiliate me, but it turned out the opposite."

# game/02_cap1_conexiones.rpy:4005
translate english cap1_interconexion_6_fbe25d3a:

    # mc_pensamiento "Me agradecieron y todo."
    mc_pensamiento "They even thanked me."

# game/02_cap1_conexiones.rpy:4009
translate english cap1_interconexion_6_43d60343:

    # narrador "Miku e Itsuki lo dejaron en visto."
    narrador "Miku and Itsuki left it on read."

# game/02_cap1_conexiones.rpy:4011
translate english cap1_interconexion_6_2e6065a8:

    # mc_pensamiento "Visto no es lo mismo que ignorado. Eso me dije."
    mc_pensamiento "\"Read\" isn't the same as ignored. That's what I told myself."

# game/02_cap1_conexiones.rpy:4015
translate english cap1_interconexion_6_1306e22b:

    # narrador "Las otras cuatro lo dejaron en visto."
    narrador "The other four left it on read."

# game/02_cap1_conexiones.rpy:4017
translate english cap1_interconexion_6_db3e3b98:

    # mc_pensamiento "Un «visto» también es una respuesta."
    mc_pensamiento "A \"read\" is also a reply."

# game/02_cap1_conexiones.rpy:4019
translate english cap1_interconexion_6_1180b0f9:

    # mc_pensamiento "Solo que no es la que uno quiere."
    mc_pensamiento "Just not the one you want."

# game/02_cap1_conexiones.rpy:4021
translate english cap1_interconexion_6_1f70072b:

    # mc_pensamiento "Ni siquiera se tomaron la molestia en contestarme."
    mc_pensamiento "They didn't even bother to answer me."

# game/02_cap1_conexiones.rpy:4023
translate english cap1_interconexion_6_2ea1de83:

    # mc_pensamiento "Bueno, no es que me sorprenda, están completamente decepcionadas de mí."
    mc_pensamiento "Well, I'm not surprised. They're completely disappointed in me."

# game/02_cap1_conexiones.rpy:4037
translate english cap1_interconexion_6_0896fa9a:

    # narrador "Domingo."
    narrador "Sunday."

# game/02_cap1_conexiones.rpy:4039
translate english cap1_interconexion_6_6fda3b22:

    # narrador "Pasé el día repasando papeles que ya sabía de memoria."
    narrador "I spent the day going over papers I already knew by heart."

# game/02_cap1_conexiones.rpy:4046
translate english cap1_interconexion_6_64d39d1a:

    # narrador "Pasadas las ocho salí del departamento, después de dejarles las últimas hojas de repaso."
    narrador "After eight I left the apartment, having dropped off the last review sheets."

# game/02_cap1_conexiones.rpy:4048
translate english cap1_interconexion_6_3ce8736b:

    # narrador "El pasillo tenía cinco puertas. Debajo de cada una, una raya de luz."
    narrador "The hallway had five doors. Under each one, a line of light."

# game/02_cap1_conexiones.rpy:4054
translate english cap1_interconexion_6_07413052:

    # narrador "Cinco puertas. Cinco rayas de luz. Ninguna dormía."
    narrador "Five doors. Five lines of light. None of them were sleeping."

# game/02_cap1_conexiones.rpy:4056
translate english cap1_interconexion_6_e78f86ae:

    # mc_pensamiento "Hacía un mes, cada puerta cerrada era un portazo."
    mc_pensamiento "A month ago, every closed door was a slam."

# game/02_cap1_conexiones.rpy:4058
translate english cap1_interconexion_6_7619d3eb:

    # mc_pensamiento "Esa noche estaban cerradas por la misma razón."
    mc_pensamiento "That night they were all closed for the same reason."

# game/02_cap1_conexiones.rpy:4064
translate english cap1_interconexion_6_922be737:

    # narrador "Cinco puertas. Tres rayas de luz."
    narrador "Five doors. Three lines of light."

# game/02_cap1_conexiones.rpy:4066
translate english cap1_interconexion_6_5a0cf286:

    # narrador "Las otras dos, a oscuras. No sé si dormían o fingían."
    narrador "The other two, dark. I couldn't tell if they were asleep or pretending."

# game/02_cap1_conexiones.rpy:4070
translate english cap1_interconexion_6_ad4c0f80:

    # narrador "Cinco puertas. Una sola raya de luz, al fondo."
    narrador "Five doors. Just one line of light, at the end."

# game/02_cap1_conexiones.rpy:4072
translate english cap1_interconexion_6_8f3ea392:

    # mc_pensamiento "No supe si me preocupaba más la luz encendida o las que no lo estaban."
    mc_pensamiento "I couldn't tell what worried me more: the light that was on, or the ones that weren't."

# game/02_cap1_conexiones.rpy:4076
translate english cap1_interconexion_6_dac7d50b:

    # mc_pensamiento "Y si Maruo cumplía lo que dijo, quizá ni siquiera estaría ahí para ver cómo les iba."
    mc_pensamiento "And if Maruo followed through on what he said, I might not even be there to see how they did."

# game/02_cap1_conexiones.rpy:4078
translate english cap1_interconexion_6_039094c6:

    # mc_pensamiento "Toda la vida estudié porque las notas eran lo único que podía controlar."
    mc_pensamiento "All my life I studied because grades were the only thing I could control."

# game/02_cap1_conexiones.rpy:4080
translate english cap1_interconexion_6_66a89db3:

    # mc_pensamiento "Esa noche, por primera vez, la nota que más me importaba no era la mía."
    mc_pensamiento "That night, for the first time, the grade I cared about most wasn't mine."

# game/02_cap1_conexiones.rpy:4082
translate english cap1_interconexion_6_8195b307:

    # mc_pensamiento "Y no había nada que pudiera hacer para controlarla."
    mc_pensamiento "And there was nothing I could do to control it."

# game/02_cap1_conexiones.rpy:4084
translate english cap1_interconexion_6_f9d327ee:

    # narrador "Bajé las escaleras sin mirar atrás. Si miraba, no iba a poder irme."
    narrador "I went down the stairs without looking back. If I looked, I wouldn't be able to leave."

